////////////////////////////////////////////////////////////////////////////////
// Форма списка регистра ЭАрМ_УКД_Входящий.
//
// Корректировочные документы (УКД) лежат отдельно от реестра УПД и в его
// списке не показываются. Каждая УКД связывается с исходной УПД
// (ИдентификаторОснования) и применяется к её строкам при сверке с приходом
// Далиона - см. ЭАрМ_КорректировкиУПД.
//
// Красная строка - исходная УПД в реестре не найдена, сверять не с чем.
// Зелёная - УПД с учётом корректировок сошлась с приходом, либо УКД уже
// отправлена. Подписанная отмечается галочкой «Подписан», без отдельного цвета.
// Утверждение УКД идёт через очередь ЭАрМ_ОжидаемыеПодтвержденияЭДО.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЭлементПорядка = Список.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных("Дата");
	ЭлементПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
	ЭлементПорядка.Использование = Истина;

	ДобавитьОформлениеСтроки("Список.ИдентификаторОснования", "",
		Новый Цвет(255, 224, 224), Новый Цвет(140, 0, 0));
	ДобавитьОформлениеСтроки("Список.РасхожденийНет", Истина,
		Новый Цвет(220, 255, 220), Новый Цвет(0, 100, 0));

	// Отправленная («Утвержден») зелёная и перекрывает цвет сверки.
	// Подписанная строку не красит: галочка в колонке «Подписан»
	ЭАрМ_УтверждениеСБИС.НастроитьОформлениеСтатусовПодписания(УсловноеОформление, "Список", Ложь, Ложь, Истина);

КонецПроцедуры

// Пока идёт загрузка (регламентный обмен, приём пакетов, тест) - строка над
// списком: что идёт и сколько загружено и сверено. Кончилась - строка прячется,
// список перечитывается один раз.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПроверитьХодЗагрузки();
	ПодключитьОбработчикОжидания("ПроверитьХодЗагрузки", 3, Ложь);

КонецПроцедуры

#КонецОбласти

#Область ХодЗагрузки

&НаКлиенте
Процедура ПроверитьХодЗагрузки() Экспорт

	Ход = ХодЗагрузкиНаСервере();
	Если Ход.Идет Тогда
		ХодЗагрузки = Ход.Текст;
		Элементы.ХодЗагрузкиПоле.Видимость = Истина;
		Возврат;
	КонецЕсли;

	Если Элементы.ХодЗагрузкиПоле.Видимость Тогда
		// Загрузка только что кончилась - показать её результат
		Элементы.ХодЗагрузкиПоле.Видимость = Ложь;
		ХодЗагрузки = "";
		Элементы.Список.Обновить();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ХодЗагрузкиНаСервере()

	Попытка
		Возврат ЭАрМ_КорректировкиУПД.ХодЗагрузкиРеестров();
	Исключение
		// Ход - подсказка: сбой его чтения работе со списком не мешает, но виден
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "Реестр УКД: ход загрузки", ОшибкаИсключения);
		Возврат Новый Структура("Идет, Текст", Истина,
			"Ход загрузки не прочитан: " + ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения));
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ОбработчикиКомандФормы

// Сверка исходной УПД с учётом всех её корректировок с приходом Далиона.
// Цепочка пересверяется сразу, отметки «Расхождений нет» обновляются.
//
&НаКлиенте
Процедура СверкаСУПД(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите корректировку в списке'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Сверка корректировки...'"));
	ТекстСверки = СверкаСУПДНаСервере(Идентификатор);
	Состояние();

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстСверки);
	ТекстовыйДокумент.Показать(НСтр("ru = 'Сверка УКД: УПД до и после корректировки, приход Далиона'"));

	Элементы.Список.Обновить();

КонецПроцедуры

// Ищет исходную УПД заново: номер и дата исправляемого документа, ИНН. Нет
// в реестре - ищет в СБИС по номеру за 180 дней и загружает с товарами.
//
&НаКлиенте
Процедура СвязатьСУПД(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите корректировку в списке'"));
		Возврат;
	КонецЕсли;

	ИдентификаторУПД = СвязатьСУПДНаСервере(Идентификатор);

	Если ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		СообщитьПользователю(НСтр("ru = 'Корректировка связана с исходной УПД, цепочка отправлена на сверку'"));
	Иначе
		СообщитьПользователю(НСтр("ru = 'Исходная УПД не найдена ни в реестре, ни во входящих СБИС за 180 дней. Причина - в «Сверка с УПД».'"));
	КонецЕсли;

	Элементы.Список.Обновить();

КонецПроцедуры

// Раскрывает GTIN строк и коды маркировки корректировки.
//
&НаКлиенте
Процедура КодыМаркировки(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите корректировку в списке'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'СБИС: чтение кодов маркировки...'"));
	ТекстОтчета = КодыМаркировкиНаСервере(Идентификатор);
	Состояние();

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстОтчета);
	ТекстовыйДокумент.Показать(НСтр("ru = 'Коды маркировки и GTIN'"));

КонецПроцедуры

// Скачивает XML УКД из СБИС и открывает его во внешней программе.
//
&НаКлиенте
Процедура ОткрытьФайл(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите корректировку в списке'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'СБИС: скачивание файла УКД...'"));
	Файл = ФайлКорректировкиНаСервере(Идентификатор, УникальныйИдентификатор);
	Состояние();

	Если НЕ Файл.Успех Тогда
		СообщитьПользователю(НСтр("ru = 'Файл УКД не получен: '") + Файл.Ошибка);
		Возврат;
	КонецЕсли;

	Обработчик = Новый ОписаниеОповещения("ОткрытьФайлПослеПолученияКаталога", ЭтотОбъект, Файл);
	НачатьПолучениеКаталогаВременныхФайлов(Обработчик);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция СверкаСУПДНаСервере(Идентификатор)

	Возврат ЭАрМ_КорректировкиУПД.ОтчетСверки(Идентификатор);

КонецФункции

&НаСервереБезКонтекста
Функция СвязатьСУПДНаСервере(Идентификатор)

	Возврат ЭАрМ_КорректировкиУПД.СвязатьСОснованием(Идентификатор, Истина, Истина);

КонецФункции

&НаСервереБезКонтекста
Функция КодыМаркировкиНаСервере(Идентификатор)

	Возврат ЭАрМ_КодыМаркировки.ОтчетУПД(Идентификатор);

КонецФункции

&НаСервереБезКонтекста
Функция ФайлКорректировкиНаСервере(Идентификатор, ИдентификаторФормы)

	Файл = ЭАрМ_КорректировкиУПД.ФайлКорректировки(Идентификатор);

	Результат = Новый Структура("Успех, Ошибка, Имя, Адрес", Файл.Успех, Файл.Ошибка, Файл.Имя, "");
	Если Файл.Успех Тогда
		Результат.Адрес = ПоместитьВоВременноеХранилище(Файл.Данные, ИдентификаторФормы);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Красит всю строку списка, когда поле равно значению.
//
&НаСервере
Процедура ДобавитьОформлениеСтроки(ИмяПоля, Значение, ЦветФона, ЦветТекста)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("Список");
	ПолеОформления.Использование = Истина;

	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Значение;
	Отбор.Использование  = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайлПослеПолученияКаталога(КаталогВременныхФайлов, Файл) Экспорт

	ПутьКФайлу = КаталогВременныхФайлов + Файл.Имя;

	Обработчик = Новый ОписаниеОповещения("ОткрытьФайлПослеСохранения", ЭтотОбъект, ПутьКФайлу);
	НачатьПолучениеФайлаССервера(Обработчик, Файл.Адрес, ПутьКФайлу);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайлПослеСохранения(ПолученныйФайл, ПутьКФайлу) Экспорт

	НачатьЗапускПриложения(Новый ОписаниеОповещения("ОткрытьФайлПослеЗапуска", ЭтотОбъект), ПутьКФайлу);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайлПослеЗапуска(КодВозврата, ДополнительныеПараметры) Экспорт

	// Результат запуска не важен: файл уже сохранён во временный каталог

КонецПроцедуры

&НаКлиенте
Функция ИдентификаторТекущейСтроки()

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ТекущиеДанные.ИдентификаторСБИС;

КонецФункции

&НаКлиенте
Процедура СообщитьПользователю(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
