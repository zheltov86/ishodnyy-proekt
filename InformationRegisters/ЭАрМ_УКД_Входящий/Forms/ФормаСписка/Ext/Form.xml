	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	УКД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	УКД.Номер КАК Номер,
	УКД.Дата КАК Дата,
	УКД.Контрагент КАК Контрагент,
	УКД.ИННКонтрагента КАК ИННКонтрагента,
	УКД.НомерОснования КАК НомерОснования,
	УКД.ДатаОснования КАК ДатаОснования,
	УКД.ИдентификаторОснования КАК ИдентификаторОснования,
	УКД.РасхожденийНет КАК РасхожденийНет,
	УКД.ТекстСверки КАК ТекстСверки,
	УКД.СтатусПодписания КАК СтатусПодписания,
	УКД.Утверждено КАК Утверждено,
	УКД.Подписано КАК Подписано,
	УКД.Состояние КАК Состояние,
	УКД.КодСостояния КАК КодСостояния,
	УКД.ДатаЗагрузки КАК ДатаЗагрузки,
	УКД.ОтправленоВБух КАК ОтправленоВБух,
	УКД.ДокументБух КАК ДокументБух,
	УКД.ПроведенВБух КАК ПроведенВБух,
	ВЫБОР
		КОГДА УКД.КодСостояния В ("19", "20", "21", "22")
				ИЛИ УКД.КодСостояния = ""
					И (УКД.Состояние ПОДОБНО "Аннулирован%"
						ИЛИ УКД.Состояние ПОДОБНО "Удален%"
						ИЛИ УКД.Состояние ПОДОБНО "Отозван%")
			ТОГДА "Аннулирована в СБИС - в сверке не участвует"
		КОГДА УКД.КодСостояния = "27"
				ИЛИ УКД.КодСостояния = ""
					И УКД.Состояние ПОДОБНО "Ожидает аннулирования%"
			ТОГДА "Аннулирование не решено - решите в СБИС"
		КОГДА УКД.ИдентификаторОснования = ""
				ИЛИ УПД.ИдентификаторСБИС ЕСТЬ NULL
			ТОГДА "Исходная УПД не найдена"
		КОГДА УПД.КодСостояния В ("19", "20", "21", "22")
				ИЛИ УПД.КодСостояния = ""
					И (УПД.Состояние ПОДОБНО "Аннулирован%"
						ИЛИ УПД.Состояние ПОДОБНО "Удален%"
						ИЛИ УПД.Состояние ПОДОБНО "Отозван%")
			ТОГДА "Исходная УПД аннулирована"
		КОГДА УКД.Подписано
			ТОГДА "Подписана"
		КОГДА УКД.СтатусПодписания = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Утвержден)
			ТОГДА "Утверждена"
		КОГДА НЕ УКД.ИдентификаторОснования В
					(ВЫБРАТЬ
						Цепочка.ИдентификаторУПД
					ИЗ
						РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
					ГДЕ
						НЕ Цепочка.ИдентификаторПоступления = "")
			ТОГДА "Нет приходной Далиона"
		КОГДА УПД.СтатусПодписания = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.НетВозвратаДалиона)
			ТОГДА "УКД есть, нет возврата из Далиона"
		КОГДА УПД.РасхожденийНет
			ТОГДА "Сошлась с приходной"
		КОГДА ПОДСТРОКА(УПД.ТекстСверки, 1, 1) = ""
			ТОГДА "Не сверена"
		ИНАЧЕ "Расхождение с приходной"
	КОНЕЦ КАК СтатусУКД
ИЗ
	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
		ПО УКД.ИдентификаторОснования = УПД.ИдентификаторСБИС</QueryText>
				<MainTable>InformationRegister.ЭАрМ_УКД_Входящий</MainTable>
				<ListSettings>
