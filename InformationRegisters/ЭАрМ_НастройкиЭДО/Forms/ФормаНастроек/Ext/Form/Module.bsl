////////////////////////////////////////////////////////////////////////////////
// Форма настроек обмена ЭДО - форма списка регистра ЭАрМ_НастройкиЭДО.
//
// Заменяет форму "Настройка" внешней обработки: та писала параметры FTP
// в ХранилищеОбщихНастроек и знала только о них, а реквизиты подключения
// к СБИС жили прямо в тексте модуля.
//
// Проверки читают настройки из регистра, а не из полей формы, поэтому каждая
// команда сначала записывает то, что набрано, и только потом проверяет.
//
// Состав полей повторяет ЭАрМ_НастройкиСервер.ОписаниеНастроек(): добавляя
// настройку, заводите её сначала там.
////////////////////////////////////////////////////////////////////////////////

// Фоновый «Тест приёма и сверки»: задание, адрес результата, начало, сколько идёт
&НаКлиенте
Перем ЗаданиеТеста, АдресТеста, НачалоТеста, СекундТеста, ЛимитТеста;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьСписокПодписантов();
	ЗаполнитьПоляИзНастроек();
	// Монитор выключен - не спрашиваем: недоступный сервер задержал бы открытие формы
	Если Монитор_Включен Тогда
		ЗаполнитьСписокПапокМонитора();
	КонецЕсли;
	Заголовок = СтрШаблон(НСтр("ru = 'Настройки ЭДО (версия расширения %1)'"), ЭАрМ_НастройкиСервер.ВерсияРасширения());
	// Админка: по умолчанию журнал обмена чистится старше месяца, свежий остаётся
	ОчисткаЖурнала_По = НачалоДня(ТекущаяДатаСеанса()) - 31 * 86400;

КонецПроцедуры

// Список выбора «Подписант по умолчанию» - заполненные подписанты настроек.
//
&НаСервере
Процедура ЗаполнитьСписокПодписантов()

	СписокВыбора = Элементы.ПодписантПоУмолчанию.СписокВыбора;
	СписокВыбора.Очистить();
	СписокВыбора.Добавить(0, НСтр("ru = 'Спрашивать при подписании'"));
	Для Каждого Подписант Из ЭАрМ_ПанельУправленияЭДОСервер.ПодписантыСБИС() Цикл
		СписокВыбора.Добавить(Подписант.Номер, Подписант.Представление);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Сохраняет настройки.
//
&НаКлиенте
Процедура ЗаписатьНастройки(Команда)

	ЗаписатьНаСервере();

КонецПроцедуры

// Трасса приёма и журнал обмена за последние часы - в текстовые файлы папки
// «error» папки пакетов Далиона (ЭАрМ_ПриемПакетовДалион.ВыгрузитьЛогиВПапку).
//
&НаКлиенте
Процедура ВыгрузитьЛоги(Команда)

	СтатусПроверки = ВыгрузитьЛогиНаСервере(Логи_Часов);

КонецПроцедуры

// Сохранённые настройки - в текстовый файл папки «setting» папки пакетов Далиона,
// пароли и секреты звёздочками (ЭАрМ_НастройкиСервер.ВыгрузитьНастройкиВПапку).
//
&НаКлиенте
Процедура ВыгрузитьНастройки(Команда)

	СтатусПроверки = ВыгрузитьНастройкиНаСервере();

КонецПроцедуры

// Сохраняет настройки и показывает данные подписантов и сертификатов:
// кому выдан, ИНН, издатель, срок, отпечаток.
//
&НаКлиенте
Процедура ПодписантыИСертификаты(Команда)

	ЗаписатьНаСервере();
	ЭАрМ_ПанельУправленияЭДОКлиент.ПоказатьПодписантовИСертификаты();

КонецПроцедуры

// Сохраняет настройки и проверяет, отвечает ли СБИС.
//
&НаКлиенте
Процедура ПроверитьСБИС(Команда)

	ЗаписатьНаСервере();

	Состояние(НСтр("ru = 'Проверка подключения к СБИС...'"));
	ПроверитьСБИСНаСервере();
	Состояние();

КонецПроцедуры

// Сохраняет настройки и проверяет доступность FTP.
//
&НаКлиенте
Процедура ПроверитьFTP(Команда)

	ЗаписатьНаСервере();

	Состояние(НСтр("ru = 'Проверка подключения к FTP...'"));
	ПроверитьFTPНаСервере();
	Состояние();

КонецПроцедуры

// Сохраняет настройки и спрашивает Монитор папок: отвечает ли, очередь, папки и их Id.
//
&НаКлиенте
Процедура ПроверитьМонитор(Команда)

	ЗаписатьНаСервере();

	Состояние(НСтр("ru = 'Проверка подключения к Монитору папок...'"));
	СтатусПроверки = ПроверитьМониторНаСервере();
	Состояние();

КонецПроцедуры

// Сохраняет настройки и запускает сеанс обмена, не дожидаясь расписания.
//
&НаКлиенте
Процедура ВыполнитьОбменСейчас(Команда)

	ЗаписатьНаСервере();

	Состояние(НСтр("ru = 'Обмен с СБИС...'"));
	ВыполнитьОбменНаСервере();
	Состояние();

КонецПроцедуры

// Подменю «Регистры»: список регистра, имя - в имени команды после
// «ОткрытьРегистр_». В разделе регистров нет, все открываются отсюда; у регистра
// без своей формы списка откроется автоматическая.
//
&НаКлиенте
Процедура ОткрытьРегистр(Команда)

	ИмяРегистра = Сред(Команда.Имя, СтрДлина("ОткрытьРегистр_") + 1);
	ОткрытьФорму("РегистрСведений." + ИмяРегистра + ".ФормаСписка", , ЭтаФорма);

КонецПроцедуры

// Открывает пересверку номенклатуры: неверные пары строк УПД и прихода,
// ручные пары и дубли штрихкодов поставщиков.
//
&НаКлиенте
Процедура ПересверкаНоменклатуры(Команда)

	ОткрытьФорму("Обработка.ЭАрМ_ПересверкаНоменклатуры.Форма.Форма", , ЭтаФорма);

КонецПроцедуры


// Единый тест приёма и сверки. «Сколько поставок» больше 0 - в новой подпапке
// создаются УПД и УКД по всем сценариям, «С расхождениями, %» - доля поставок с
// расхождением; 0 - тест по своим XML УПД из папки поля. Дальше УПД в реестр, рядом
// заказ и приходная Далиона, полный проход приёма по папке, итог по каждой поставке.
//
// Тест идёт фоновым заданием: форма не висит, раз в 2 с показывает текущий шаг, а
// если задание идёт дольше ЭАрМ_ТестУпаковок.СекундДоСнятияТеста() - снимает его
// и пишет, на каком шаге стояло.
//
&НаКлиенте
Процедура ТестСверки(Команда)

	ЗапуститьТестКлиент(ТестСверки_Количество, ТестСверки_ПроцентРасхождений);

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьТестКлиент(Количество, ПроцентРасхождений)

	Если ЗначениеЗаполнено(ЗаданиеТеста) Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Тест приёма и сверки уже идёт - дождитесь его.'"));
		Возврат;
	КонецЕсли;
	Если ПроцентРасхождений > 100 Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Процент поставок с расхождениями - от 0 до 100.'"));
		Возврат;
	КонецЕсли;

	Запуск = ЗапуститьТестНаСервере(ТестСверки_Папка, УникальныйИдентификатор, Количество, ПроцентРасхождений);
	Если ЗначениеЗаполнено(Запуск.Ошибка) Тогда
		СтатусПроверки = Запуск.Ошибка;
		Возврат;
	КонецЕсли;

	ЗаданиеТеста = Запуск.Задание;
	АдресТеста = Запуск.Адрес;
	НачалоТеста = Запуск.Начало;
	СекундТеста = 0;
	ЛимитТеста = Запуск.Лимит;
	СтатусПроверки = ?(Количество > 0, СтрШаблон(НСтр("ru = 'Тест приёма и сверки запущен: поставок %1, с расхождениями %2 процентов...'"),
		Количество, ПроцентРасхождений), НСтр("ru = 'Тест приёма и сверки запущен по XML из папки...'"));
	ПодключитьОбработчикОжидания("ПроверитьТестСверки", 2, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьТестСверки()

	СекундТеста = СекундТеста + 2;
	СостояниеТеста = СостояниеТестаНаСервере(ЗаданиеТеста, НачалоТеста);

	Если СостояниеТеста.Состояние = "Активно" Тогда
		Если СекундТеста < ЛимитТеста Тогда
			// Этап, сколько обработано и чего (по базе), последний шаг трассы
			СтатусПроверки = СтрШаблон(НСтр("ru = 'Тест идёт %1 с (будет снят через %2 с).
				|%3
				|Сейчас: %4'"), СекундТеста, ЛимитТеста - СекундТеста, СостояниеТеста.Прогресс, СостояниеТеста.Сейчас);
			Возврат;
		КонецЕсли;
		ОтключитьОбработчикОжидания("ПроверитьТестСверки");
		СтатусПроверки = СнятьТестНаСервере(ЗаданиеТеста, НачалоТеста, СекундТеста);
		ЗаданиеТеста = Неопределено;
		ПоказатьПредупреждение( , СтатусПроверки);
		Возврат;
	КонецЕсли;

	ОтключитьОбработчикОжидания("ПроверитьТестСверки");
	ЗаданиеТеста = Неопределено;

	Если СостояниеТеста.Состояние = "Завершено" Тогда
		Протокол = ПолучитьИзВременногоХранилища(АдресТеста);
		СтатусПроверки = ?(ТипЗнч(Протокол) = Тип("Строка"), Протокол,
			НСтр("ru = 'Тест завершён, протокол не получен - см. ТрассаПриема.log'"));
	Иначе
		СтатусПроверки = СтрШаблон(НСтр("ru = 'Тест прерван (%1) через %2 с.
			|%3
			|Последний шаг: %4'"), СостояниеТеста.Состояние, СекундТеста, СостояниеТеста.Ошибка, СостояниеТеста.Сейчас);
		ПоказатьПредупреждение( , СтатусПроверки);
	КонецЕсли;

КонецПроцедуры

// Удаляет файлы из папок archive папки пакетов Далиона - после подтверждения.
//
&НаКлиенте
Процедура ОчиститьАрхив(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("ОчиститьАрхивЗавершение", ЭтотОбъект),
		НСтр("ru = 'Удалить все файлы из папок archive (архив принятых пакетов Далиона)? Файлы уже обработаны, но вернуть их будет нельзя.'"),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьАрхивЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Очистка архива...'"));
	СтатусПроверки = ОчиститьАрхивНаСервере();
	Состояние();

КонецПроцедуры

// Админка: сколько записей журнала обмена ЭДО в периоде - без удаления.
//
&НаКлиенте
Процедура ПодсчитатьЗаписиЖурнала(Команда)

	ЗаписиПериода = ЗаписиЖурналаОбменаНаСервере(ОчисткаЖурнала_С, ОчисткаЖурнала_По);
	Если ЗначениеЗаполнено(ЗаписиПериода.Ошибка) Тогда
		СтатусПроверки = ЗаписиПериода.Ошибка;
	Иначе
		СтатусПроверки = СтрШаблон(НСтр("ru = 'Журнал обмена ЭДО %1: записей - %2.'"),
			ЗаписиПериода.Период, ЗаписиПериода.Количество);
	КонецЕсли;

КонецПроцедуры

// Админка: очистка журнала обмена ЭДО за период. Сначала считает записи
// периода и спрашивает, удалять ли именно их; без ответа «Да» ничего не удаляется.
//
&НаКлиенте
Процедура ОчиститьЖурналОбмена(Команда)

	ЗаписиПериода = ЗаписиЖурналаОбменаНаСервере(ОчисткаЖурнала_С, ОчисткаЖурнала_По);
	Если ЗначениеЗаполнено(ЗаписиПериода.Ошибка) Тогда
		СтатусПроверки = ЗаписиПериода.Ошибка;
		Возврат;
	КонецЕсли;

	Если ЗаписиПериода.Количество = 0 Тогда
		СтатусПроверки = СтрШаблон(НСтр("ru = 'Журнал обмена ЭДО %1: записей нет, удалять нечего.'"),
			ЗаписиПериода.Период);
		Возврат;
	КонецЕсли;

	// Удаляется тот период, о котором спросили
	ПараметрыОчистки = Новый Структура("НачалоПериода, КонецПериода", ОчисткаЖурнала_С, ОчисткаЖурнала_По);
	ПоказатьВопрос(Новый ОписаниеОповещения("ОчиститьЖурналОбменаЗавершение", ЭтотОбъект, ПараметрыОчистки),
		СтрШаблон(НСтр("ru = 'Удалить из журнала обмена ЭДО записи %1 - %2 шт.? Вернуть их будет нельзя.'"),
			ЗаписиПериода.Период, ЗаписиПериода.Количество),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЖурналОбменаЗавершение(Результат, ПараметрыОчистки) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		СтатусПроверки = НСтр("ru = 'Очистка журнала обмена ЭДО отменена, ничего не удалено.'");
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Очистка журнала обмена ЭДО...'"));
	СтатусПроверки = ОчиститьЖурналОбменаНаСервере(ПараметрыОчистки.НачалоПериода, ПараметрыОчистки.КонецПериода);
	Состояние();
	ПоказатьПредупреждение(, СтатусПроверки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Раскладывает сохранённые настройки по реквизитам формы.
//
&НаСервере
Процедура ЗаполнитьПоляИзНастроек()

	Настройки = ЭАрМ_НастройкиСервер.ПолучитьВсеНастройки();
	ИменаРеквизитов = ИменаРеквизитовФормы();

	Для Каждого ОписаниеНастройки Из ЭАрМ_НастройкиСервер.ОписаниеНастроек() Цикл

		Если ОписаниеНастройки.Раздел = "Служебное" Тогда
			Продолжить;
		КонецЕсли;

		Если ИменаРеквизитов.Получить(ОписаниеНастройки.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЭтаФорма[ОписаниеНастройки.Ключ] = Настройки[ОписаниеНастройки.Ключ];

	КонецЦикла;

	ДатаПоследнегоОбмена = Настройки.ДатаПоследнегоОбмена;

КонецПроцедуры

// Собирает настройки из реквизитов формы и сохраняет их.
//
&НаСервере
Процедура ЗаписатьНаСервере()

	Сохраняемые = Новый Структура;
	ИменаРеквизитов = ИменаРеквизитовФормы();

	Для Каждого ОписаниеНастройки Из ЭАрМ_НастройкиСервер.ОписаниеНастроек() Цикл

		Если ОписаниеНастройки.Раздел = "Служебное" Тогда
			Продолжить;
		КонецЕсли;

		Если ИменаРеквизитов.Получить(ОписаниеНастройки.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЗначениеПоля = ЭтаФорма[ОписаниеНастройки.Ключ];

		Если ТипЗнч(ЗначениеПоля) = Тип("Строка") Тогда
			ЗначениеПоля = СокрЛП(ЗначениеПоля);
		КонецЕсли;

		Сохраняемые.Вставить(ОписаниеНастройки.Ключ, ЗначениеПоля);

	КонецЦикла;

	ЭАрМ_НастройкиСервер.СохранитьВсеНастройки(Сохраняемые);
	// Флажок «Обработка событий через очередь» читают подписки (повторно используемое значение)
	ОбновитьПовторноИспользуемыеЗначения();

	// Регламенты «Применение пакетов» и «Сверка с БП»: расписание, если ещё пустое
	Попытка
		ЭАрМ_СтатусыМонитора.ПроверитьРасписания();
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "Настройки: расписание регламентов монитора", ИнформацияОбОшибке());
	КонецПопытки;

	// Перечитываем: в полях окажется ровно то, что сохранено,
	// включая подставленные умолчания
	ЗаполнитьПоляИзНастроек();

	Если ОтключитьФоновыеЗадания Тогда
		СтатусПроверки = НСтр("ru = 'Настройки сохранены. Фоновые задания ЭДО отключены.'");
	Иначе
		СтатусПроверки = НСтр("ru = 'Настройки сохранены'");
	КонецЕсли;

КонецПроцедуры

// Проверяет подключение к СБИС.
//
&НаСервере
Процедура ПроверитьСБИСНаСервере()

	РезультатПроверки = ЭАрМ_РегламентныйОбменЭДО.ПроверитьПодключениеКСБИС();

	Если РезультатПроверки.Успех Тогда
		СтатусПроверки = РезультатПроверки.Сообщение;
	Иначе
		СтатусПроверки = СтрШаблон(НСтр("ru = 'СБИС: %1'"), РезультатПроверки.Ошибка);
	КонецЕсли;

КонецПроцедуры

// Проверяет подключение к FTP.
//
&НаСервере
Процедура ПроверитьFTPНаСервере()

	РезультатПроверки = ЭАрМ_ОбщийМодульОбмен.ПроверитьПодключениеFTP();

	Если РезультатПроверки.Успех Тогда
		СтатусПроверки = СтрШаблон(
			НСтр("ru = 'FTP доступен. Каталог %1, файлов: %2'"),
			РезультатПроверки.Каталог, РезультатПроверки.ФайловВКаталоге);
	Иначе
		СтатусПроверки = СтрШаблон(НСтр("ru = 'FTP: %1'"), РезультатПроверки.Ошибка);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПроверитьМониторНаСервере()

	ЗаполнитьСписокПапокМонитора();
	Возврат ЭАрМ_МониторПапок.ПроверитьПодключение().Текст;

КонецФункции

// Список выбора «Папка в мониторе»: Id и путь папок монитора вместо ручного ввода Id.
//
&НаСервере
Процедура ЗаполнитьСписокПапокМонитора()

	СписокВыбора = Элементы.Монитор_ИдПапки.СписокВыбора;
	СписокВыбора.Очистить();
	СписокВыбора.Добавить(0, НСтр("ru = '0 - все папки монитора'"));
	Для Каждого ПапкаМонитора Из ЭАрМ_МониторПапок.Папки() Цикл
		СписокВыбора.Добавить(ПапкаМонитора.Id, СтрШаблон("%1 - %2 (%3)%4", Формат(ПапкаМонитора.Id, "ЧГ=0"),
			ПапкаМонитора.Name, ПапкаМонитора.Path, ?(ПапкаМонитора.Enabled, "", НСтр("ru = ', выключена'"))));
	КонецЦикла;

КонецПроцедуры

// Запускает сеанс обмена вручную.
//
&НаСервере
Процедура ВыполнитьОбменНаСервере()

	Итоги = ЭАрМ_РегламентныйОбменЭДО.ВыполнитьОбмен();

	СтатусПроверки = СтрСоединить(Итоги.Сообщения, Символы.ПС);

	ЗаполнитьПоляИзНастроек();

КонецПроцедуры

// Имена реквизитов формы.
//
// Поля формы заводятся вручную, а состав настроек живёт в общем модуле:
// настройка, которой не завели поле, просто не показывается и не сохраняется,
// а не роняет форму.
//
&НаСервере
Функция ИменаРеквизитовФормы()

	Результат = Новый Соответствие;

	Для Каждого РеквизитФормы Из ПолучитьРеквизиты() Цикл
		Результат.Вставить(РеквизитФормы.Имя, Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

