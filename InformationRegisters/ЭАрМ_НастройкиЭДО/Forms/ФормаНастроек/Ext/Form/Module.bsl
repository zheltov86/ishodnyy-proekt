&НаСервереБезКонтекста
Функция ВыгрузитьЛогиНаСервере(Знач Часов)

	// Часы запоминаем сразу, как поля теста
	ЭАрМ_НастройкиСервер.СохранитьНастройку("Логи_Часов", Часов);
	Попытка
		Возврат ЭАрМ_ПриемПакетовДалион.ВыгрузитьЛогиВПапку(Часов);
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "Выгрузка логов в папку error", ОшибкаИсключения);
		Возврат "Логи не выгружены: " + ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения);
	КонецПопытки;

КонецФункции

