#КонецОбласти

#Область ОтправкаИРегламенты

// ============================================================================
// ВКЛАДКА «ОТПРАВКА И РЕГЛАМЕНТЫ» (20.10.2026)
// ============================================================================
// Отправка неотправленного в СБИС (регламент ЭАрМ_ОтправкаОчередиСБИС): флажок,
// как часто, сколько за раз; кнопка «Отправить неотправленное сейчас» с ходом раз
// в 2 секунды (как тест приёма и сверки) - какая пачка, какой документ, что сейчас.
// Ниже - все регламентные задания расширения: включено, каждые N минут, последний
// запуск и итог, «Запустить сейчас».

// Флажок меняют здесь - запоминаем этот компьютер: при подписи на клиенте
// подписывает тот компьютер, где флажок включили.
//
&НаКлиенте
Процедура Отправка_ВключенаПриИзменении(Элемент)

	КомпьютерКлиента = ИмяКомпьютера();

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьНеотправленноеСейчас(Команда)

	Если ЗначениеЗаполнено(ЗаданиеОтправки) Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Отправка уже идёт - её ход виден на вкладке.'"));
		Возврат;
	КонецЕсли;

	// Сначала то, что набрано: размер пачки и флажок действуют уже на этот запуск
	ЗаписатьНаСервере();
	Запуск = ЗапуститьОтправкуНаСервере();
	Если ЗначениеЗаполнено(Запуск.Ошибка) Тогда
		Отправка_Ход = Запуск.Ошибка + Символы.ПС + Отправка_Ход;
		Возврат;
	КонецЕсли;

	ЗаданиеОтправки = Запуск.Задание;
	СекундОтправки = 0;
	Отправка_Ход = НСтр("ru = 'Отправка запущена...'");
	ПодключитьОбработчикОжидания("ПроверитьОтправку", 2, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтправку()

	СекундОтправки = СекундОтправки + 2;
	Состояние = СостояниеОтправкиНаСервере(ЗаданиеОтправки);

	Если Состояние.Состояние = "Активно" И СекундОтправки < 3600 Тогда
		Отправка_Ход = СтрШаблон(НСтр("ru = 'Идёт %1 с.'"), СекундОтправки) + Символы.ПС + Состояние.Текст;
		Возврат;
	КонецЕсли;

	ОтключитьОбработчикОжидания("ПроверитьОтправку");
	ЗаданиеОтправки = Неопределено;
	Отправка_Ход = ?(Состояние.Состояние = "Активно",
		НСтр("ru = 'Отправка идёт больше часа - форма перестала следить, ход - кнопкой «Обновить».'") + Символы.ПС, "")
		+ Состояние.Текст;
	ОбновитьРегламентныеЗаданияНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтправку(Команда)

	ОбновитьРегламентныеЗаданияНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьЗаданиеСейчас(Команда)

	ТекущиеДанные = Элементы.РегламентныеЗадания.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Выберите задание в таблице.'"));
		Возврат;
	КонецЕсли;

	// Отправка неотправленного - своей кнопкой, с ходом
	Если ТекущиеДанные.Имя = "ЭАрМ_ОтправкаОчередиСБИС" Тогда
		ОтправитьНеотправленноеСейчас(Неопределено);
		Возврат;
	КонецЕсли;

	СтатусПроверки = ЗапуститьЗаданиеНаСервере(ТекущиеДанные.Имя);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтправкуИЗадания()

	Отправка_Включена = ЭАрМ_ПанельУправленияЭДОСервер.АвтоотправкаВключена();
	Отправка_ВключенаБыло = Отправка_Включена;
	ОбновитьРегламентныеЗаданияНаСервере();

КонецПроцедуры

// Пояснение, ход и таблица заданий - без флажка и полей (их значения не трогаем).
//
&НаСервере
Процедура ОбновитьРегламентныеЗаданияНаСервере()

	Попытка
		Отправка_Подпись = ЭАрМ_ОбработкаПодтвержденийЭДО.ОписаниеОтправкиПоРасписанию();
	Исключение
		Отправка_Подпись = НСтр("ru = 'Как настроена отправка - не прочитано: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Отправка_Ход = ЭАрМ_ОбработкаПодтвержденийЭДО.ТекстХодаОтправки();

	РегламентныеЗадания.Очистить();
	Попытка
		Для Каждого Задание Из ЭАрМ_ПанельУправленияЭДОСервер.РегламентныеЗаданияРасширения() Цикл
			Строка = РегламентныеЗадания.Добавить();
			ЗаполнитьЗначенияСвойств(Строка, Задание);
			Строка.ВключеноБыло = Строка.Включено;
			Строка.КаждыеМинутБыло = Строка.КаждыеМинут;
		КонецЦикла;
	Исключение
		СтатусПроверки = НСтр("ru = 'Регламентные задания не прочитаны: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// После записи настроек: флажок отправки (только если его поменяли здесь - иначе
// значение, прочитанное при открытии формы, затёрло бы включение из реестра УПД),
// расписание отправки по интервалу и изменённые строки заданий.
//
// Возвращаемое значение:
//   Строка - что изменено в заданиях или почему не записано
//
&НаСервере
Функция ЗаписатьОтправкуИЗадания()

	Итог = Новый Массив;
	Если Отправка_Включена <> Отправка_ВключенаБыло Тогда
		ЭАрМ_ПанельУправленияЭДОСервер.УстановитьАвтоотправку(Отправка_Включена, КомпьютерКлиента,
			НСтр("ru = 'форма настроек ЭДО, вкладка «Отправка и регламенты»'"));
		Отправка_ВключенаБыло = Отправка_Включена;
		Итог.Добавить(?(Отправка_Включена, НСтр("ru = 'Отправка неотправленного включена'"),
			НСтр("ru = 'Отправка неотправленного выключена'")));
	КонецЕсли;

	// Интервал - сразу в расписание регламента отправки
	Попытка
		ЭАрМ_ОбработкаПодтвержденийЭДО.ПроверитьРасписаниеОтправкиОчереди();
	Исключение
		Итог.Добавить(НСтр("ru = 'Расписание отправки не записано: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Изменения = Новый Массив;
	Для Каждого Строка Из РегламентныеЗадания Цикл
		Если Строка.Включено <> Строка.ВключеноБыло ИЛИ Строка.КаждыеМинут <> Строка.КаждыеМинутБыло Тогда
			Изменения.Добавить(Новый Структура("Имя, Включено, КаждыеМинут", Строка.Имя, Строка.Включено, Строка.КаждыеМинут));
		КонецЕсли;
	КонецЦикла;
	Если Изменения.Количество() > 0 Тогда
		Попытка
			Записано = ЭАрМ_ПанельУправленияЭДОСервер.ЗаписатьРегламентныеЗадания(Изменения);
			Если ЗначениеЗаполнено(Записано) Тогда
				Итог.Добавить(Записано);
			КонецЕсли;
		Исключение
			Итог.Добавить(НСтр("ru = 'Регламентные задания не записаны: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	ОбновитьРегламентныеЗаданияНаСервере();
	Возврат СтрСоединить(Итог, Символы.ПС);

КонецФункции

