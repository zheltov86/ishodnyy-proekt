&НаСервереБезКонтекста
Функция ЗапуститьТестНаСервере(Знач Папка, ИдентификаторФормы, Количество, ПроцентРасхождений)

	// Поля теста запоминаем сразу: чтобы не вводить их каждый раз, «Записать настройки» не нужно
	Папка = СокрЛП(Папка);
	Если ЗначениеЗаполнено(Папка) Тогда
		ЭАрМ_НастройкиСервер.СохранитьНастройку("ТестСверки_Папка", Папка);
	КонецЕсли;
	ЭАрМ_НастройкиСервер.СохранитьНастройку("ТестСверки_Количество", Количество);
	ЭАрМ_НастройкиСервер.СохранитьНастройку("ТестСверки_ПроцентРасхождений", ПроцентРасхождений);

	Запуск = ЭАрМ_ТестУпаковок.ЗапуститьФоновыйТест(Папка, ИдентификаторФормы, Количество, ПроцентРасхождений);
	Запуск.Вставить("Лимит", ЭАрМ_ТестУпаковок.СекундДоСнятияТеста(?(Количество > 0, Количество, 10)));
	Возврат Запуск;

