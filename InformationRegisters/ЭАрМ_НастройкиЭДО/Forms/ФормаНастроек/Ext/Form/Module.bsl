// Удаление всего, что создал тест приёма и сверки, - после подтверждения.
//
&НаКлиенте
Процедура УдалитьТестовыеДанные(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("УдалитьТестовыеДанныеЗавершение", ЭтотОбъект),
		НСтр("ru = 'Удалить все тестовые данные: УПД и ЭТрН «ТЕСТ…», пакеты, цепочки, сверку и документы тестовых заказов и приходных, штрихкоды тестового поставщика? Настоящие документы не затрагиваются.'"),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьТестовыеДанныеЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Удаление тестовых данных...'"));
	СтатусПроверки = УдалитьТестовыеДанныеНаСервере();
	Состояние();

КонецПроцедуры

