Функция ВыгрузитьНастройкиНаСервере()

	Попытка
		Возврат ЭАрМ_НастройкиСервер.ВыгрузитьНастройкиВПапку();
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "Выгрузка настроек в папку setting", ОшибкаИсключения);
		Возврат "Настройки не выгружены: " + ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения);
