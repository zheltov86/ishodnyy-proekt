#Область ОчисткаЛогов

// Админка: очистка логов старше N дней - трасса приёма и файлы логов
// (ЭАрМ_ПанельУправленияЭДОСервер.ЛогиДляОчистки / ОчиститьЛоги). Сначала
// показывает, что удалится, и спрашивает; без ответа «Да» ничего не удаляется.

&НаКлиенте
Процедура ПодсчитатьЛоги(Команда)

	Логи = ЛогиДляОчисткиНаСервере(ОчисткаЛогов_Дней);
	СтатусПроверки = ?(ЗначениеЗаполнено(Логи.Ошибка), Логи.Ошибка, Логи.Текст);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЛоги(Команда)

	Логи = ЛогиДляОчисткиНаСервере(ОчисткаЛогов_Дней);
	Если ЗначениеЗаполнено(Логи.Ошибка) Тогда
		СтатусПроверки = Логи.Ошибка;
		Возврат;
	КонецЕсли;
	Если Логи.Записей + Логи.Файлов = 0 И НЕ ЗначениеЗаполнено(Логи.Ротация) Тогда
		СтатусПроверки = Логи.Текст + Символы.ПС + НСтр("ru = 'Удалять нечего.'");
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("ОчиститьЛогиЗавершение", ЭтотОбъект, Новый Структура("Дней", ОчисткаЛогов_Дней)),
		Логи.Текст + Символы.ПС + НСтр("ru = 'Удалить? Вернуть будет нельзя.'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЛогиЗавершение(Результат, Параметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		СтатусПроверки = НСтр("ru = 'Очистка логов отменена, ничего не удалено.'");
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Очистка логов...'"));
	СтатусПроверки = ОчиститьЛогиНаСервере(Параметры.Дней);
	Состояние();
	ПоказатьПредупреждение( , СтатусПроверки);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЛогиДляОчисткиНаСервере(Знач Дней)

	Логи = ЭАрМ_ПанельУправленияЭДОСервер.ЛогиДляОчистки(Дней);
	Возврат Новый Структура("Записей, Файлов, Ротация, Текст, Ошибка", Логи.Записей, Логи.Файлов, Логи.Ротация, Логи.Текст, Логи.Ошибка);

КонецФункции

// Вызывается только из ответа «Да» на вопрос с тем, что удалится, - отсюда Подтверждено.
//
&НаСервереБезКонтекста
Функция ОчиститьЛогиНаСервере(Знач Дней)

	Попытка
		Возврат ЭАрМ_ПанельУправленияЭДОСервер.ОчиститьЛоги(Дней, Истина);
	Исключение
		Возврат НСтр("ru = 'Логи не очищены: '") + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

#КонецОбласти
