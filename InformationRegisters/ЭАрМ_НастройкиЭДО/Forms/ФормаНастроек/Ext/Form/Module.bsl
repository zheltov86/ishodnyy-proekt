// Вызывается только из ответа «Да» на вопрос с числом записей - отсюда Подтверждено.
//
&НаСервереБезКонтекста
Функция ОчиститьЖурналОбменаНаСервере(Знач НачалоПериода, Знач КонецПериода)

	Попытка
		Возврат ЭАрМ_ПанельУправленияЭДОСервер.ОчиститьЖурналОбмена(НачалоПериода, КонецПериода, Истина).Результат;
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ОчисткаЖурналаОбмена", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ОшибкаИсключения));
		Возврат НСтр("ru = 'Журнал обмена ЭДО не очищен: '") + ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения);
	КонецПопытки;

КонецФункции

