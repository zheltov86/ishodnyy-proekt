////////////////////////////////////////////////////////////////////////////////
// Список ЭАрМ_ШтрихкодыПоставщиков. Загрузка JSON со штрихкодами.
// Понимает товары/Товары, items, goods и пакеты Далиона data.goods / data.items.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДобавитьКомандуСписка("СоздатьНоменклатуруУТ",
		НСтр("ru = 'Создать номенклатуру УТ'"),
		НСтр("ru = 'Выделенные строки: выбрать вид номенклатуры и создать карточку в УТ'"));
	ДобавитьКомандуСписка("ВыбратьВидНоменклатуры",
		НСтр("ru = 'Выбрать вид номенклатуры'"),
		НСтр("ru = 'Выделенные строки: выбрать вид номенклатуры для создаваемых карточек УТ'"));
	ДобавитьКомандуСписка("СвязатьСНоменклатуройДалиона",
		НСтр("ru = 'Связать с номенклатурой Далиона'"),
		НСтр("ru = 'Выбранная строка: найти и выбрать номенклатуру Далиона, связать с ней'"));
	ДобавитьКомандуСписка("ПредпросмотрЗаписи",
		НСтр("ru = 'Предпросмотр записи'"),
		НСтр("ru = 'Показать, что будет записано в регистр штрихкодов, и какие штрихкоды есть у номенклатуры в УПД'"));

КонецПроцедуры

&НаСервере
Процедура ДобавитьКомандуСписка(ИмяКоманды, Заголовок, Подсказка)

	Если Команды.Найти(ИмяКоманды) = Неопределено Тогда
		Команда = Команды.Добавить(ИмяКоманды);
		Команда.Действие = ИмяКоманды;
		Команда.Заголовок = Заголовок;
		Команда.Подсказка = Подсказка;
	КонецЕсли;

	Для Каждого Панель Из СтрРазделить("СписокКоманднаяПанель,СписокКонтекстноеМеню", ",") Цикл
		ИмяКнопки = Панель + ИмяКоманды;
		Если Элементы.Найти(ИмяКнопки) = Неопределено Тогда
			Кнопка = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), Элементы[Панель]);
			Кнопка.ИмяКоманды = ИмяКоманды;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Файл штрихкодов";
	Диалог.Фильтр = "Все файлы (*.*)|*.*";
	Диалог.МножественныйВыбор = Ложь;

	Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораФайлаШтрихкодов", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзПапки(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Папка";

	Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораПапкиШтрихкодов", ЭтотОбъект));

КонецПроцедуры

// Товары, которые к нам поступили, но которых нет в регистре: берутся из
// реестра товаров (итог сверки цепочек), без дублей.
//
&НаКлиенте
Процедура ЗагрузитьИзСверки(Команда)

	ПоказатьИтогЗагрузки(ЗагрузитьИзСверкиНаСервере());

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВУТПроверить(Команда)

	ПоказатьИтогЗагрузки(ПеренестиВУТНаСервере(Истина));

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВУТ(Команда)

	Штрихкоды = Новый Массив;
	Для Каждого Ключ Из Элементы.Список.ВыделенныеСтроки Цикл
		Данные = Элементы.Список.ДанныеСтроки(Ключ);
		Если Данные <> Неопределено И ЗначениеЗаполнено(Данные.Штрихкод)
			И Штрихкоды.Найти(Данные.Штрихкод) = Неопределено Тогда
			Штрихкоды.Добавить(Данные.Штрихкод);
		КонецЕсли;
	КонецЦикла;

	Если Штрихкоды.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите строки, которые нужно перенести в УТ'"));
		Возврат;
	КонецЕсли;

	Варианты = Новый СписокЗначений;
	Варианты.Добавить("Связать", НСтр("ru = 'Связать номенклатуру (существующие связи не менять)'"));
	Варианты.Добавить("Перезаписать", НСтр("ru = 'Изменить связь и перезаписать все данные, создать номенклатуру'"));

	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПеренестиВУТВариантВыбран", ЭтотОбъект, Штрихкоды),
		Варианты, Элементы.Список);

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВУТВариантВыбран(ВыбранноеЗначение, Штрихкоды) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Перезаписывать = (ВыбранноеЗначение.Значение = "Перезаписать");
	ПоказатьИтогЗагрузки(ПеренестиВУТНаСервере(Ложь, Перезаписывать, Штрихкоды));

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуруУТ(Команда)

	Строки = Новый Массив;
	БезШтрихкода = Новый Массив;
	Для Каждого Ключ Из Элементы.Список.ВыделенныеСтроки Цикл
		Данные = Элементы.Список.ДанныеСтроки(Ключ);
		Если Данные = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Данные.Штрихкод) Тогда
			БезШтрихкода.Добавить(?(ЗначениеЗаполнено(Данные.НоменклатураДалион),
				Данные.НоменклатураДалион, Данные.НаименованиеПоставщика));
			Продолжить;
		КонецЕсли;
		Строки.Добавить(Новый Структура("Наименование, Штрихкод, ВидУИД",
			?(ЗначениеЗаполнено(Данные.НоменклатураДалион), Данные.НоменклатураДалион, Данные.НаименованиеПоставщика),
			Данные.Штрихкод,
			?(Данные.Свойство("ВидНоменклатуры"), СокрЛП(Данные.ВидНоменклатуры), "")));
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, ?(БезШтрихкода.Количество() > 0,
			НСтр("ru = 'У выделенных строк нет штрихкода - карточку УТ без штрихкода не создаём'"),
			НСтр("ru = 'Выделите строки, для которых нужно создать номенклатуру'")));
		Возврат;
	КонецЕсли;

	Товары = ТоварыДляСоздания(Строки);
	ПоказатьВопрос(Новый ОписаниеОповещения("СоздатьНоменклатуруСвязьВыбрана", ЭтотОбъект,
			Новый Структура("Товары, БезШтрихкода", Товары, БезШтрихкода)),
		НСтр("ru = 'Связать номенклатуру с поставщиком (запись в «Номенклатуру контрагентов»)?
		|«Нет» - только карточка УТ со штрихкодом.'"),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуруСвязьВыбрана(Ответ, Контекст) Экспорт

	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	Связывать = (Ответ = КодВозвратаДиалога.Да);
	Для Каждого Товар Из Контекст.Товары Цикл
		Товар.Вставить("СвязыватьСПоставщиком", Связывать);
	КонецЦикла;

	ОткрытьФорму("Обработка.ЭАрМ_ПанельУправленияЭДО.Форма.ФормаВыборВидовНоменклатуры",
		Новый Структура("Товары", Контекст.Товары), ЭтаФорма, , , ,
		Новый ОписаниеОповещения("СоздатьНоменклатуруВидыВыбраны", ЭтотОбъект, Контекст),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуруВидыВыбраны(ВидыТоваров, Контекст) Экспорт

	Если ВидыТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Создание номенклатуры...'"));
	Текст = СоздатьНоменклатуруНаСервере(Контекст.Товары, ВидыТоваров);
	Состояние();

	Если Контекст.БезШтрихкода.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрШаблон(НСтр("ru = 'Пропущены без штрихкода: %1'"),
			СтрСоединить(Контекст.БезШтрихкода, "; "));
	КонецЕсли;
	ПоказатьПредупреждение(, Текст, , НСтр("ru = 'Создание номенклатуры'"));
	Элементы.Список.Обновить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеВыбораФайлаШтрихкодов(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Путь = ПервыйВыбранныйПуть(ВыбранныеФайлы);
	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат;
	КонецЕсли;

	ПоказатьИтогЗагрузки(ЗагрузитьИзПутиНаСервере(Путь));

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПапкиШтрихкодов(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Путь = ПервыйВыбранныйПуть(ВыбранныеФайлы);
	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат;
	КонецЕсли;

	ПоказатьИтогЗагрузки(ЗагрузитьИзПапкиНаСервере(Путь));

КонецПроцедуры

&НаКлиенте
Функция ПервыйВыбранныйПуть(ВыбранныеФайлы)

	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(ВыбранныеФайлы) = Тип("Строка") Тогда
		Возврат ВыбранныеФайлы;
	КонецЕсли;

	Если ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат ВыбранныеФайлы[0];

КонецФункции

&НаКлиенте
Процедура ПоказатьИтогЗагрузки(Текст)

	Элементы.Список.Обновить();
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗагрузитьИзПутиНаСервере(ПутьКФайлу)

	Возврат ТекстИтогаЗагрузки(ЭАрМ_СверкаТоваровЦепочки.ЗагрузитьШтрихкодыИзПути(ПутьКФайлу));

КонецФункции

&НаСервереБезКонтекста
Функция ЗагрузитьИзПапкиНаСервере(ПутьКПапке)

	Возврат ТекстИтогаЗагрузки(ЭАрМ_СверкаТоваровЦепочки.ЗагрузитьШтрихкодыИзПапки(ПутьКПапке));

КонецФункции

&НаСервереБезКонтекста
Функция ЗагрузитьИзСверкиНаСервере()

	Итоги = ЭАрМ_СверкаТоваровЦепочки.ЗагрузитьШтрихкодыИзРеестраТоваров();
	ИтогиУПД = ЭАрМ_СверкаТоваровЦепочки.ДобавитьШтрихкодыИзУПД();

	Возврат СтрШаблон("Строк сверки с приходом: %1. Добавлено: %2, уже было в регистре: %3, без штрихкода: %4."
		+ Символы.ПС + "Штрихкодов из УПД: %5. Добавлено: %6, уже было в регистре: %7.",
		Итоги.Линий, Итоги.Добавлено, Итоги.УжеЕсть, Итоги.БезШтрихкода,
		ИтогиУПД.Строк, ИтогиУПД.Добавлено, ИтогиУПД.УжеЕсть);

КонецФункции

&НаСервереБезКонтекста
Функция ТекстИтогаЗагрузки(Итоги)

	Текст = СтрШаблон("Файлов %1, загружено %2, пропущено %3, ошибок %4.",
		Итоги.Файлов, Итоги.Загружено, Итоги.Пропущено, Итоги.Ошибок);
	Если Итоги.Сообщения.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрСоединить(Итоги.Сообщения, Символы.ПС);
	КонецЕсли;

	Возврат Текст;

КонецФункции

&НаСервереБезКонтекста
Функция ПеренестиВУТНаСервере(ТолькоПроверка, Перезаписывать = Ложь, Штрихкоды = Неопределено)

	Итог = ЭАрМ_НоменклатураПоставщиковУТ.ПеренестиВНоменклатуруКонтрагентов(ТолькоПроверка, "", Перезаписывать, Штрихкоды);

	// СтрШаблон принимает не больше 10 подстановок - итог собирается из двух строк
	Текст = СтрШаблон("%1: строк %2, создано %3, обновлено %4, уже было %5, расхождений %6, нет в УТ %7, контрагент не создан %8, без кода %9, ошибок %10.",
		?(ТолькоПроверка, "Проверка", "Перенос"), Итог.Строк, Итог.Создано, Итог.Обновлено, Итог.УжеЕсть,
		Итог.Расхождений, Итог.НетВУТ, Итог.НетПартнера, Итог.БезКода, Итог.Ошибок);
	Текст = Текст + Символы.ПС + СтрШаблон("%1: карточек номенклатуры УТ - %2, контрагентов (с партнёром) - %3, договоров - %4.",
		?(ТолькоПроверка, "Будет создано", "Создано"), Итог.Карточек, Итог.Контрагентов, Итог.Договоров);
	Если Итог.Сообщения.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрСоединить(Итог.Сообщения, Символы.ПС);
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Товары для окна видов: наименование, штрихкод, категория по названию.
&НаСервереБезКонтекста
Функция ТоварыДляСоздания(Строки)

	Товары = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Товар = Новый Структура("Наименование, Штрихкод, Категория",
			Строка.Наименование, Строка.Штрихкод,
			ЭАрМ_КатегорииТоваров.КатегорияТовара(Строка.Наименование));
		Если Строка.Свойство("ВидУИД") И ЗначениеЗаполнено(Строка.ВидУИД) Тогда
			Товар.Вставить("ВидУИД", Строка.ВидУИД);
		КонецЕсли;
		Товары.Добавить(Товар);
	КонецЦикла;
	Возврат Товары;

КонецФункции

&НаСервереБезКонтекста
Функция СоздатьНоменклатуруНаСервере(Товары, ВидыТоваров)

	Возврат ЭАрМ_КатегорииТоваров.СоздатьНоменклатуруСВидами(Товары, ВидыТоваров);

КонецФункции

#КонецОбласти

#Область СвязьСНоменклатуройДалиона

// Выбранную строку регистра связать с номенклатурой Далиона, выбранной вручную
// (поиск по названию). Нужно, когда одинаковые по названию товары с разными
// штрихкодами нельзя автоматически связать с одной номенклатурой.
&НаКлиенте
Процедура СвязатьСНоменклатуройДалиона(Команда)

	Данные = Элементы.Список.ТекущиеДанные;
	Если Данные = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Данные.Штрихкод) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите строку со штрихкодом, которую нужно связать с номенклатурой Далиона'"));
		Возврат;
	КонецЕсли;

	Контекст = Новый Структура("Штрихкод, НаименованиеПоставщика, НоменклатураДалион",
		Данные.Штрихкод,
		?(Данные.Свойство("НаименованиеПоставщика"), Данные.НаименованиеПоставщика, ""),
		?(Данные.Свойство("НоменклатураДалион"), Данные.НоменклатураДалион, ""));

	ПоказатьВводСтроки(Новый ОписаниеОповещения("СвязатьДалионПоискВведен", ЭтотОбъект, Контекст),
		Контекст.НоменклатураДалион,
		СтрШаблон(НСтр("ru = 'Строка: %1 (%2). Найти номенклатуру Далиона (часть названия; пусто - все)'"),
			Контекст.НаименованиеПоставщика, Контекст.Штрихкод),
		100, Истина);

КонецПроцедуры

&НаКлиенте
Процедура СвязатьДалионПоискВведен(ТекстПоиска, Контекст) Экспорт

	Если ТекстПоиска = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Варианты = ДалионНоменклатурыДляВыбораНаСервере(СокрЛП(ТекстПоиска));
	Если Варианты.Количество() = 0 Тогда
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Номенклатура Далиона по поиску «%1» не найдена'"), СокрЛП(ТекстПоиска)));
		Возврат;
	КонецЕсли;

	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("СвязатьДалионВыбрана", ЭтотОбъект, Контекст),
		Варианты, Элементы.Список);

КонецПроцедуры

&НаКлиенте
Процедура СвязатьДалионВыбрана(ВыбранныйЭлемент, Контекст) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Выбор = ВыбранныйЭлемент.Значение; // Структура: УИД, НоменклатураДалион, КодНоменклатурыДалион
	Текст = СвязатьСНоменклатуройДалионаНаСервере(Контекст.Штрихкод, Выбор.УИД,
		Выбор.НоменклатураДалион, Выбор.КодНоменклатурыДалион);

	Если ПустаяСтрока(Текст) Тогда
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Строка %1 связана с номенклатурой Далиона «%2»'"),
			Контекст.Штрихкод, Выбор.НоменклатураДалион));
	Иначе
		ПоказатьПредупреждение(, Текст);
	КонецЕсли;
	Элементы.Список.Обновить();

КонецПроцедуры

// Список номенклатур Далиона для выбора: уникальные по идентификатору, с поиском
// по названию. Возвращает СписокЗначений: значение - Структура
// (УИД, НоменклатураДалион, КодНоменклатурыДалион), представление - название.
&НаСервереБезКонтекста
Функция ДалионНоменклатурыДляВыбораНаСервере(Поиск)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Штрихкоды.ИдентификаторНоменклатурыДалион КАК УИД,
	|	Штрихкоды.НоменклатураДалион КАК НоменклатураДалион,
	|	Штрихкоды.КодНоменклатурыДалион КАК КодНоменклатурыДалион
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.ИдентификаторНоменклатурыДалион <> """"
	|	И (НЕ &ЕстьПоиск
	|			ИЛИ Штрихкоды.НоменклатураДалион ПОДОБНО &Шаблон)
	|УПОРЯДОЧИТЬ ПО
	|	НоменклатураДалион";
	Запрос.УстановитьПараметр("ЕстьПоиск", ЗначениеЗаполнено(Поиск));
	Запрос.УстановитьПараметр("Шаблон", "%" + Поиск + "%");

	Варианты = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Значение = Новый Структура("УИД, НоменклатураДалион, КодНоменклатурыДалион",
			СокрЛП(Выборка.УИД), СокрЛП(Выборка.НоменклатураДалион), СокрЛП(Выборка.КодНоменклатурыДалион));
		Варианты.Добавить(Значение, Выборка.НоменклатураДалион);
	КонецЦикла;
	Варианты.СортироватьПоПредставлению();

	Возврат Варианты;

КонецФункции

&НаСервереБезКонтекста
Функция СвязатьСНоменклатуройДалионаНаСервере(Штрихкод, УИД, Номенклатура, Код)

	Набор = РегистрыСведений.ЭАрМ_ШтрихкодыПоставщиков.СоздатьНаборЗаписей();
	Набор.Отбор.Штрихкод.Установить(Штрихкод);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Строка с этим штрихкодом не найдена в регистре'");
	КонецЕсли;

	Для Каждого Запись Из Набор Цикл
		Запись.НоменклатураДалион = Номенклатура;
		Запись.КодНоменклатурыДалион = Код;
		Запись.ИдентификаторНоменклатурыДалион = УИД;
	КонецЦикла;
	Набор.Записать();

	Возврат "";

КонецФункции

#КонецОбласти

#Область ПредпросмотрЗаписи

// Предпросмотр записи: что будет записано в регистр штрихкодов поставщиков и
// какие штрихкоды уже есть у этой номенклатуры в УПД.
&НаКлиенте
Процедура ПредпросмотрЗаписи(Команда)

	Текст = ПредпросмотрЗаписиНаСервере();
	ПоказатьПредупреждение(, Текст, , НСтр("ru = 'Предпросмотр записи в регистр штрихкодов'"));
	Элементы.Список.Обновить();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредпросмотрЗаписиНаСервере()

	ИтогРеестра = ЭАрМ_СверкаТоваровЦепочки.ЗагрузитьШтрихкодыИзРеестраТоваров(Истина);
	ИтогУПД     = ЭАрМ_СверкаТоваровЦепочки.ДобавитьШтрихкодыИзУПД("", Истина);

	ШтрихкодыУПД = ШтрихкодыУПДПоНаименованию();

	Тексты = Новый Массив;
	Тексты.Добавить(СтрШаблон(НСтр("ru = 'Будет записано строк: %1 (из реестра товаров %2, из УПД %3). Уже в регистре: реестр %4, УПД %5.'"),
		ИтогРеестра.Предпросмотр.Количество() + ИтогУПД.Предпросмотр.Количество(),
		ИтогРеестра.Предпросмотр.Количество(), ИтогУПД.Предпросмотр.Количество(),
		ИтогРеестра.УжеЕсть, ИтогУПД.УжеЕсть));

	Для Каждого Описание Из ИтогРеестра.Предпросмотр Цикл
		Тексты.Добавить(СтрокаПредпросмотра(Описание, ШтрихкодыУПД));
	КонецЦикла;
	Для Каждого Описание Из ИтогУПД.Предпросмотр Цикл
		Тексты.Добавить(СтрокаПредпросмотра(Описание, ШтрихкодыУПД));
	КонецЦикла;

	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

// Одна строка предпросмотра: штрихкод, наименование и штрихкоды этой
// номенклатуры в УПД.
&НаСервереБезКонтекста
Функция СтрокаПредпросмотра(Описание, ШтрихкодыУПД)

	Текст = СокрЛП(Описание.Штрихкод) + " | " + СокрЛП(Описание.НаименованиеПоставщика);
	Штрихкоды = ШтрихкодыУПД.Получить(ВРег(СокрЛП(Описание.НаименованиеПоставщика)));
	Если Штрихкоды <> Неопределено И Штрихкоды.Количество() > 0 Тогда
		Текст = Текст + " | УПД: " + СтрСоединить(Штрихкоды, ", ");
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Штрихкоды строк УПД по наименованию (ключ - верхний регистр наименования).
&НаСервереБезКонтекста
Функция ШтрихкодыУПДПоНаименованию()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Наименование КАК Наименование,
	|	Товары.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИсточникТоваров = ""УПД""
	|	И Товары.Штрихкод <> """"";

	Соответствие = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = ВРег(СокрЛП(Выборка.Наименование));
		Список = Соответствие.Получить(Ключ);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Соответствие.Вставить(Ключ, Список);
		КонецЕсли;
		Код = СокрЛП(Выборка.Штрихкод);
		Если Список.Найти(Код) = Неопределено Тогда
			Список.Добавить(Код);
		КонецЕсли;
	КонецЦикла;
	Возврат Соответствие;

КонецФункции

#КонецОбласти

#Область ВыборВидаНоменклатуры

// Выбрать вид номенклатуры для выделенных строк регистра: открывает выбор вида,
// выбранный УИД сохраняется в реквизит «ВидНоменклатуры» строк.
&НаКлиенте
Процедура ВыбратьВидНоменклатуры(Команда)

	Штрихкоды = Новый Массив;
	Для Каждого Ключ Из Элементы.Список.ВыделенныеСтроки Цикл
		Данные = Элементы.Список.ДанныеСтроки(Ключ);
		Если Данные <> Неопределено И ЗначениеЗаполнено(Данные.Штрихкод)
			И Штрихкоды.Найти(Данные.Штрихкод) = Неопределено Тогда
			Штрихкоды.Добавить(Данные.Штрихкод);
		КонецЕсли;
	КонецЦикла;

	Если Штрихкоды.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите строки, для которых нужно выбрать вид номенклатуры'"));
		Возврат;
	КонецЕсли;

	ПараметрыВыбора = Новый Структура("РежимВыбора, ЗакрыватьПриВыборе", Истина, Истина);
	ОткрытьФорму("Справочник.ВидыНоменклатуры.ФормаВыбора", ПараметрыВыбора, ЭтаФорма, , , ,
		Новый ОписаниеОповещения("ВидНоменклатурыВыбран", ЭтотОбъект, Штрихкоды),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ВидНоменклатурыВыбран(ВыбранноеЗначение, Штрихкоды) Экспорт

	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;

	Описание = ОписаниеВидаНаСервере(ВыбранноеЗначение);
	Если Описание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Описание.ЭтоГруппа Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите вид номенклатуры, а не группу видов'"));
		Возврат;
	КонецЕсли;

	ЗаписатьВидНоменклатурыНаСервере(Штрихкоды, Описание.УИД);
	ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Вид «%1» поставлен выделенным строкам (%2)'"),
		Описание.Представление, Штрихкоды.Количество()));
	Элементы.Список.Обновить();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОписаниеВидаНаСервере(Ссылка)

	Возврат ЭАрМ_КатегорииТоваров.ОписаниеСсылки(Ссылка);

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьВидНоменклатурыНаСервере(Штрихкоды, УИД)

	Набор = РегистрыСведений.ЭАрМ_ШтрихкодыПоставщиков.СоздатьНаборЗаписей();
	Набор.Отбор.Штрихкод.Установить(Штрихкоды);
	Набор.Прочитать();
	Для Каждого Запись Из Набор Цикл
		Запись.ВидНоменклатуры = УИД;
	КонецЦикла;
	Набор.Записать();

КонецПроцедуры

#КонецОбласти
