
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ Параметры.Свойство("ИдентификаторУПД") ИЛИ НЕ ЗначениеЗаполнено(Параметры.ИдентификаторУПД) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ИдентификаторУПД = Параметры.ИдентификаторУПД;
	Подбор = ЭАрМ_ЦепочкаЗакупки.ПриходныеДляВыбораУПД(ИдентификаторУПД);
	Номер = Подбор.Номер;
	Дней = Подбор.Дней;
	Заголовок = Подбор.Представление;
	Элементы.Пояснение.Заголовок = СтрШаблон(
		НСтр("ru = '%1. Накладные этого поставщика с тем же номером и датой плюс-минус дней.'"),
		Подбор.Представление);
	ЗаполнитьТаблицу(Подбор);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПриходныеНаСервере()

	Подбор = ЭАрМ_ЦепочкаЗакупки.ПриходныеДляВыбораУПД(ИдентификаторУПД, Дней, Номер);
	ЗаполнитьТаблицу(Подбор);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицу(Подбор)

	Приходные.Очистить();
	ИдентификаторТекущей = Неопределено;

	Для Каждого СтрокаПодбора Из Подбор.Строки Цикл
		НоваяСтрока = Приходные.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПодбора);
		Если СтрокаПодбора.Текущая Тогда
			ИдентификаторТекущей = НоваяСтрока.ПолучитьИдентификатор();
		КонецЕсли;
	КонецЦикла;

	Если ИдентификаторТекущей <> Неопределено Тогда
		Элементы.Приходные.ТекущаяСтрока = ИдентификаторТекущей;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НомерПриИзменении(Элемент)

	ЗаполнитьПриходныеНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДнейПриИзменении(Элемент)

	ЗаполнитьПриходныеНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)

	ТекущиеДанные = Элементы.Приходные.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите приходную в списке'"));
		Возврат;
	КонецЕсли;

	Закрыть(Новый Структура("ИдентификаторУПД, ИдентификаторЗаказа, ИдентификаторПоступления",
		ИдентификаторУПД, ТекущиеДанные.ИдентификаторЗаказа, ТекущиеДанные.ИдентификаторПоступления));

КонецПроцедуры

&НаКлиенте
Процедура ПриходныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Выбрать(Неопределено);

КонецПроцедуры
