&НаСервереБезКонтекста
Функция ИдентификаторЭТрНТекущейУПДНаСервере(ИдентификаторУПД)

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторУПД;
	МенеджерЗаписи.Прочитать();

	НомерУПД = "";
	КлючиСвязи = "";
	Если МенеджерЗаписи.Выбран() Тогда
		НомерУПД = МенеджерЗаписи.Номер;
		КлючиСвязи = МенеджерЗаписи.КлючиСвязи;
	КонецЕсли;

	НайденнаяЭТрН = ЭАрМ_РегламентныйОбменЭДО.НайтиЭТрНДляУПД(
		ИдентификаторУПД, НомерУПД, КлючиСвязи);

	Возврат НайденнаяЭТрН.Идентификатор;

КонецФункции

// УКД выбранной УПД, которые ещё не ушли в СБИС.
//
// Возвращаемое значение:
//   Массив из Структура - Идентификатор, Представление
//
&НаСервереБезКонтекста
Функция КорректировкиДляОтправкиНаСервере(ИдентификаторУПД)

	Результат = Новый Массив;
	Статусы = Перечисления.ЭАрМ_СтатусыПодписанияЭДО;

	Для Каждого ИдентификаторУКД Из ЭАрМ_КорректировкиУПД.КорректировкиУПД(ИдентификаторУПД) Цикл

		Запись = РегистрыСведений.ЭАрМ_УКД_Входящий.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторСБИС = ИдентификаторУКД;
		Запись.Прочитать();
		Если НЕ Запись.Выбран()
			ИЛИ Запись.Подписано
			ИЛИ Запись.Утверждено
			ИЛИ Запись.СтатусПодписания = Статусы.Подписан Тогда
			Продолжить;
		КонецЕсли;

		Представление = СтрШаблон(НСтр("ru = 'УКД %1 от %2'"),
			СокрЛП(Запись.Номер), Формат(Запись.Дата, "ДЛФ=D"));
		Результат.Добавить(Новый Структура("Идентификатор, Представление",
			ИдентификаторУКД, Представление));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// «К отправке» и строка очереди, без запуска отправки: подписывает кнопка.
// Пустая строка - УКД можно подписывать.
//
&НаСервереБезКонтекста
Функция ПодготовитьУКДКПодписиНаСервере(ИдентификаторУКД)

	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(ИдентификаторУКД);
	Итог = ЭАрМ_ОбработкаПодтвержденийЭДО.ПоставитьНаУтверждение("УКД", Идентификаторы, Ложь);
	Если Итог.Ошибки.Количество() > 0 Тогда
		Возврат Итог.Ошибки[0];
	КонецЕсли;

	Возврат "";

