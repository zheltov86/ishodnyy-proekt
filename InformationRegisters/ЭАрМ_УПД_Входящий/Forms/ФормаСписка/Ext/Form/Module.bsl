// Штрихкоды выбранной УПД и её приходной накладной Далиона - в регистр
// штрихкодов поставщиков: собственные GTIN строк УПД (из XML и кодов
// маркировки) и все товары прихода со штрихкодами и номенклатурой Далиона.
// Затем штрихкоды строкам УПД назначаются заново, цепочка пересверяется, и
// дерево строится снова. Ничего не удаляет: уже лежащие записи не дублируются.
//
&НаКлиенте
Процедура ШтрихкодыВРегистр(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите УПД в списке'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Штрихкоды в регистр...'"));
	Текст = ШтрихкодыВРегистрНаСервере(Идентификатор);
	Состояние();

	ЦепочкаПостроенаДля = Неопределено;
	ОбновитьЦепочкуДокументов();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Штрихкоды поставщиков'"), , Текст);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ШтрихкодыВРегистрНаСервере(ИдентификаторУПД)

	Части = Новый Массив;

	ИзУПД = ЭАрМ_СверкаТоваровЦепочки.ДобавитьШтрихкодыИзУПД(ИдентификаторУПД);
	Части.Добавить(СтрШаблон(НСтр("ru = 'Из УПД: добавлено %1, уже было %2'"),
		ИзУПД.Добавлено, ИзУПД.УжеЕсть));

	Цепочка = ЭАрМ_ЦепочкаЗакупки.ЦепочкаПоУПД(ИдентификаторУПД);
	Если Цепочка = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Цепочка.ИдентификаторПоступления) Тогда
		Части.Добавить(НСтр("ru = 'приходной Далиона у УПД нет'"));
		Возврат СтрСоединить(Части, "; ");
	КонецЕсли;

	Объект = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ПриходнаяНакладная", Цепочка.ИдентификаторПоступления);
	Товары = ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "goods"));
	Если Товары.Количество() > 0 Тогда
		ЭАрМ_СверкаТоваровЦепочки.ЗагрузитьШтрихкодыИзСтрок(Товары,
			Цепочка.ИННПоставщика, Цепочка.Поставщик, "ПоступлениеДалион");
	КонецЕсли;
	Части.Добавить(СтрШаблон(НСтр("ru = 'из приходной Далиона: товаров %1'"), Товары.Количество()));

	ЭАрМ_СверкаТоваровЦепочки.НазначитьШтрихкоды(ИдентификаторУПД, Цепочка.ИННПоставщика);
	Попытка
		ЭАрМ_СверкаТоваровЦепочки.СверитьЦепочку(Цепочка.ИдентификаторЗаказа, Цепочка.ИдентификаторПоступления);
		Части.Добавить(НСтр("ru = 'цепочка пересверена'"));
	Исключение
		Части.Добавить(СтрШаблон(НСтр("ru = 'пересверка не удалась: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	Возврат СтрСоединить(Части, "; ");

КонецФункции

// Флажок «Автоотправка в СБИС»: та же настройка, что в форме «Ожидают отправки».
//
&НаКлиенте
Процедура АвтоПодписанияПриИзменении(Элемент)

	ЭАрМ_ПанельУправленияЭДОСервер.УстановитьАвтоотправку(АвтоПодписания, ИмяКомпьютера());

	Если АвтоПодписания И НЕ АвтоотправкаУЗадания() Тогда
		ЗапуститьАвтоотправку();
	Иначе
		ОстановитьАвтоотправку();
	КонецЕсли;

КонецПроцедуры

#Область Автоотправка

// Автоотправка из реестра: сошедшиеся УПД и УКД («Готов к утверждению»)
// становятся «К отправке», встают в «Ожидают отправки» и оттуда уходят в СБИС
// пачками по 5 - всё фоновыми заданиями, форма не висит; после пачки список
// перечитывается и строки меняют цвет. Цепочка - ЭАрМ_ПанельУправленияЭДОКлиент,
// общая с формой очереди; если открыты обе формы, пачку ведёт одна.
// Подписывает подписант рабочего места (выбирается в «Ожидают отправки»).
//
&НаКлиенте
Процедура ЗапуститьАвтоотправку()

	АвтоСостояние = ЭАрМ_ПанельУправленияЭДОКлиент.НовоеСостояниеАвтоотправки(ЭтотОбъект,
		Новый ОписаниеОповещения("АвтоПачкаЗавершена", ЭтотОбъект));
	ЭАрМ_ПанельУправленияЭДОКлиент.ВыбратьПодписантаАвтоотправки(АвтоСостояние,
		Новый ОписаниеОповещения("АвтоотправкаПодписантВыбран", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура АвтоотправкаПодписантВыбран(НомерПодписанта, ДополнительныеПараметры) Экспорт

	Если НомерПодписанта = Неопределено Тогда
		АвтоПодписания = Ложь;
		ЭАрМ_ПанельУправленияЭДОСервер.УстановитьАвтоотправку(Ложь);
		ПоказатьОповещениеПользователя(НСтр("ru = 'Автоотправка в СБИС выключена'"), ,
			НСтр("ru = 'Подписант не выбран'"));
		Возврат;
	КонецЕсли;

	ОтключитьОбработчикОжидания("Подключаемый_Автоотправка");
	Если ОчередьСобытийВключена = Истина Тогда
		// Отдельного минутного таймера нет: автоотправка идёт в общем опросе
		// изменений реестра. Первая пачка - сразу, коротким одноразовым таймером
		ПодключитьОбработчикОжидания("Подключаемый_АвтоотправкаСейчас", 0.8, Истина);
	Иначе
		ПодключитьОбработчикОжидания("Подключаемый_Автоотправка", 60);
		ПодключитьОбработчикОжидания("Подключаемый_АвтоотправкаСейчас", 2, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьАвтоотправку()

	ОтключитьОбработчикОжидания("Подключаемый_Автоотправка");
	ОтключитьОбработчикОжидания("Подключаемый_АвтоотправкаСейчас");

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_АвтоотправкаСейчас()

	Подключаемый_Автоотправка();

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_Автоотправка()

	// Ручное подписание кнопкой идёт - автоотправка ждёт
	Если НЕ АвтоПодписания ИЛИ ИдётФоновоеУтверждение = Истина ИЛИ ПодписаниеСБИС <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЭАрМ_ПанельУправленияЭДОКлиент.ЗапуститьАвтоПачку(АвтоСостояние);

КонецПроцедуры

// Пачка закончилась - список перечитывается, строки меняют статус и цвет.
//
&НаКлиенте
Процедура АвтоПачкаЗавершена(Итог, ДополнительныеПараметры) Экспорт

	ПоследнийСнимок = "";
	ПеречитатьСписокРеестра();

	Если ЗначениеЗаполнено(Итог.Текст) Тогда
		ЭАрМ_ПанельУправленияЭДОКлиент.ПоказатьИтогОтправкиСБИС(Итог.Текст);
	КонецЕсли;

	Если Итог.Отправлено И АвтоПодписания Тогда
		// В режиме очереди событий - короткий одноразовый таймер (следующая пачка сразу)
		ПодключитьОбработчикОжидания("Подключаемый_АвтоотправкаСейчас",
			?(ОчередьСобытийВключена = Истина, 0.8, 5), Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура Подключаемый_ОбновитьРеестрУПД()

	// Снимок: один запрос = статистика + хеш. Список перечитываем только
	// если реестр реально изменился и пользователь не листает таблицу.
	Снимок = СнимокРеестраУПД(ДатаУПДС, ДатаУПДПо);

	ПервыйСнимок = НЕ ЗначениеЗаполнено(ПоследнийСнимок);

	Если Снимок.Хеш <> ПоследнийСнимок Тогда
		ПоследнийСнимок = Снимок.Хеш;
		ОбновитьСтатистикуУПДИзСнимка(Снимок.Статистика);
		КэшСтатистикиВремя = ТекущаяДата();
		Если НЕ ПервыйСнимок Тогда
			ЗапланироватьОбновлениеСписка();
		КонецЕсли;
	ИначеЕсли КэшСтатистикиВремя = Неопределено
		ИЛИ ТекущаяДата() - КэшСтатистикиВремя >= 60 Тогда
		ОбновитьСтатистикуУПДИзСнимка(Снимок.Статистика);
		КэшСтатистикиВремя = ТекущаяДата();
	КонецЕсли;

КонецПроцедуры

// Ставит одноразовый перечит списка: схлопывает пачку изменений и ждёт,
// пока пользователь перестанет листать. Во время догрузки товаров список
// не трогаем - применим после разморозки.
//
&НаКлиенте
Процедура ЗапланироватьОбновлениеСписка()

	ЕстьОтложенноеОбновление = Истина;

	Если ИдётЗагрузкаРеестра = Истина Тогда
		Возврат;
	КонецЕсли;

	ОтключитьОбработчикОжидания("Подключаемый_ПрименитьОтложенноеОбновлениеСписка");
	ПодключитьОбработчикОжидания("Подключаемый_ПрименитьОтложенноеОбновлениеСписка", 0.8, Истина);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПрименитьОтложенноеОбновлениеСписка()

	Если ИдётЗагрузкаРеестра = Истина Тогда
		Возврат;
	КонецЕсли;

	Если ПользовательРаботаетСоСписком() Тогда
		ПодключитьОбработчикОжидания("Подключаемый_ПрименитьОтложенноеОбновлениеСписка", 0.8, Истина);
		Возврат;
	КонецЕсли;

	ЕстьОтложенноеОбновление = Ложь;
	ПеречитатьСписокРеестра();

КонецПроцедуры

&НаКлиенте
Функция ПользовательРаботаетСоСписком()

	Если ПоследнееДействиеСоСписком = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТекущаяДата() - ПоследнееДействиеСоСписком < 2;

КонецФункции

&НаКлиенте
Процедура ПеречитатьСписокРеестра()

	ТекущаяСтрока = Элементы.Список.ТекущаяСтрока;
	ИдётПрограммноеОбновлениеСписка = Истина;
	Попытка
		Элементы.Список.Обновить();
		Если ТекущаяСтрока <> Неопределено Тогда
			Элементы.Список.ТекущаяСтрока = ТекущаяСтрока;
		КонецЕсли;
	Исключение
		ИдётПрограммноеОбновлениеСписка = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	ИдётПрограммноеОбновлениеСписка = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ЗаморозитьАвтообновлениеСписка()

	ИдётЗагрузкаРеестра = Истина;
	Элементы.Список.ОбновлениеПриИзмененииДанных = ОбновлениеПриИзмененииДанных.НеОбновлять;

КонецПроцедуры

&НаКлиенте
Процедура РазморозитьАвтообновлениеСписка(ОбновитьСписок = Истина)

	ИдётЗагрузкаРеестра = Ложь;
	Элементы.Список.ОбновлениеПриИзмененииДанных = ОбновлениеПриИзмененииДанных.НеОбновлять;

	Если ОбновитьСписок И ЕстьОтложенноеОбновление = Истина Тогда
		ЗапланироватьОбновлениеСписка();
	Иначе
		ЕстьОтложенноеОбновление = Ложь;
	КонецЕсли;

КонецПроцедуры

// Строка над таблицей УПД: всего, подписано, ждут подписи в СБИС, к отправке,
// с расхождениями — из заранее рассчитанного снимка. Отдельный COUNT(*) не
// делает: данные уже есть в структуре СнимокРеестраУПД.
//
&НаКлиенте
Процедура ОбновитьСтатистикуУПДИзСнимка(Итоги)

	Части = Новый Массив;
	Части.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'УПД: всего '")));
	Части.Добавить(Новый ФорматированнаяСтрока(Формат(Итоги.Всего, "ЧН=0; ЧГ=0"), Новый Шрифт(, , Истина)));

	ДобавитьПоказательСтатистики(Части, НСтр("ru = 'подписано'"), Итоги.Подписано, Новый Цвет(0, 128, 0));
	ДобавитьПоказательСтатистики(Части, НСтр("ru = 'ждут подписи'"), Итоги.ЖдутПодписи, Новый Цвет(184, 134, 11));
	ДобавитьПоказательСтатистики(Части, НСтр("ru = 'к отправке'"), Итоги.КОтправке, Новый Цвет(0, 70, 170));
	ДобавитьПоказательСтатистики(Части, НСтр("ru = 'с расхождениями'"), Итоги.СРасхождениями, Новый Цвет(200, 0, 0));

	// Аннулированные, ждущие аннулирования и УКД (в том числе возвратные)
	Закрыто = СчетчикиЗакрытыхИУКДНаСервере(ДатаУПДС, ДатаУПДПо);
	ДобавитьПоказательСтатистики(Части, НСтр("ru = 'аннулировано'"), Закрыто.Аннулировано, Новый Цвет(140, 140, 140));
	ДобавитьПоказательСтатистики(Части, НСтр("ru = 'ждут аннулирования'"), Закрыто.ЖдутАннулирования, Новый Цвет(200, 100, 0));
	ДобавитьПоказательСтатистики(Части, НСтр("ru = 'УКД'"), Закрыто.УКД, Новый Цвет(0, 70, 170));
	ДобавитьПоказательСтатистики(Части, НСтр("ru = 'из них возвратных'"), Закрыто.Возвратных, Новый Цвет(0, 70, 170));

	Элементы.СтатистикаУПД.Заголовок = Новый ФорматированнаяСтрока(Части);

КонецПроцедуры

// Счётчики по периоду: аннулированные и ждущие аннулирования УПД, УКД и возвратные из них.
//
&НаСервереБезКонтекста
Функция СчетчикиЗакрытыхИУКДНаСервере(ДатаС, ДатаПо)

	Итог = Новый Структура("Аннулировано, ЖдутАннулирования, УКД, Возвратных", 0, 0, 0, 0);

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(ВЫБОР
		|		КОГДА УПД.КодСостояния В (""19"", ""20"", ""21"", ""22"")
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ) КАК Аннулировано,
		|	СУММА(ВЫБОР
		|		КОГДА УПД.КодСостояния = ""27""
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ) КАК ЖдутАннулирования
		|ИЗ
		|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
		|ГДЕ
		|	(&БезНачала ИЛИ УПД.Дата >= &ДатаС)
		|	И (&БезКонца ИЛИ УПД.Дата <= &ДатаПо)";
		Запрос.УстановитьПараметр("БезНачала", НЕ ЗначениеЗаполнено(ДатаС));
		Запрос.УстановитьПараметр("ДатаС", НачалоДня(ДатаС));
		Запрос.УстановитьПараметр("БезКонца", НЕ ЗначениеЗаполнено(ДатаПо));
		Запрос.УстановитьПараметр("ДатаПо", КонецДня(ДатаПо));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Итог.Аннулировано = ?(ТипЗнч(Выборка.Аннулировано) = Тип("Число"), Выборка.Аннулировано, 0);
			Итог.ЖдутАннулирования = ?(ТипЗнч(Выборка.ЖдутАннулирования) = Тип("Число"), Выборка.ЖдутАннулирования, 0);
		КонецЕсли;

		Корректировки = ЭАрМ_КорректировкиУПД.СчетчикиКорректировок(ДатаС, ДатаПо);
		Итог.УКД = Корректировки.Всего;
		Итог.Возвратных = Корректировки.Возвратных;
	Исключение
		ЗаписьЖурналаРегистрации("ЭАрМ.СтатистикаУПД", УровеньЖурналаРегистрации.Предупреждение,,,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Обратная совместимость: вызывается из ОбновитьСписокИЦепочку.
// Делает отдельный снимок и обновляет статистику.
//
&НаКлиенте
Процедура ОбновитьСтатистикуУПД()

	Снимок = СнимокРеестраУПД(ДатаУПДС, ДатаУПДПо);
	ПоследнийСнимок = Снимок.Хеш;
	КэшСтатистикиВремя = ТекущаяДата();
	ОбновитьСтатистикуУПДИзСнимка(Снимок.Статистика);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПоказательСтатистики(Части, Название, Значение, Цвет)

	Части.Добавить(Новый ФорматированнаяСтрока(" · " + Название + " "));
	Части.Добавить(Новый ФорматированнаяСтрока(Формат(Значение, "ЧН=0; ЧГ=0"),
		Новый Шрифт(, , Истина), ?(Значение > 0, Цвет, Неопределено)));

КонецПроцедуры

// Показатели реестра УПД. Подписано - подпись видна в СБИС; ждут подписи -
// утверждение ушло, подписи ещё нет; к отправке - отмечены «К отправке», но
// ещё не утверждены; с расхождениями - не сошлись с приходом и не подписаны.
//
&НаСервереБезКонтекста
Функция СтатистикаУПДНаСервере(ДатаС, ДатаПо)

	Итоги = Новый Структура("Всего, Подписано, ЖдутПодписи, КОтправке, СРасхождениями", 0, 0, 0, 0, 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Всего,
	|	СУММА(ВЫБОР
	|			КОГДА УПД.Подписано
	|					ИЛИ УПД.СтатусПодписания = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Подписано,
	|	СУММА(ВЫБОР
	|			КОГДА УПД.Утверждено
	|					И НЕ УПД.Подписано
	|					И УПД.СтатусПодписания <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ЖдутПодписи,
	|	СУММА(ВЫБОР
	|			КОГДА УПД.КОтправке
	|					И НЕ УПД.Утверждено
	|					И НЕ УПД.Подписано
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КОтправке,
	|	СУММА(ВЫБОР
	|			КОГДА НЕ УПД.РасхожденийНет
	|					И УПД.ТекстСверки <> """"
	|					И НЕ УПД.Подписано
	|					И УПД.СтатусПодписания <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СРасхождениями
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	(&НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ УПД.Дата >= &НачалоПериода)
	|	И (&КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ УПД.Дата <= &КонецПериода)";
	Запрос.УстановитьПараметр("НачалоПериода",
		?(ЗначениеЗаполнено(ДатаС), НачалоДня(ДатаС), Дата(1, 1, 1)));
	Запрос.УстановитьПараметр("КонецПериода",
		?(ЗначениеЗаполнено(ДатаПо), КонецДня(ДатаПо), Дата(1, 1, 1)));

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Для Каждого Имя Из СтрРазделить("Всего,Подписано,ЖдутПодписи,КОтправке,СРасхождениями", ",") Цикл
				Значение = Выборка[Имя];
				Итоги[Имя] = ?(Значение = Null, 0, Значение);
			КонецЦикла;
		КонецЕсли;
	Исключение
		// Статистика - подсказка; реестр без неё работает.
		// Логируем, чтобы при смене схемы регистра ошибка была видна.
		ЗаписьЖурналаРегистрации("ЭАрМ.СтатистикаУПД",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось рассчитать статистику реестра УПД: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Итоги;

КонецФункции

// Возвращает статистику И хеш снимка реестра за один вызов.
// Хеш = счётчики + дата комментария. ДатаЗагрузки и ДатаСводки не входят:
// фоновая догрузка товаров иначе меняла снимок и дёргала таблицу.
//
&НаСервереБезКонтекста
Функция СнимокРеестраУПД(ДатаС, ДатаПо)

	Результат = Новый Структура;
	Результат.Вставить("Статистика", Новый Структура("Всего,Подписано,ЖдутПодписи,КОтправке,СРасхождениями", 0,0,0,0,0));
	Результат.Вставить("Хеш", "");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Всего,
	|	СУММА(ВЫБОР
	|			КОГДА УПД.Подписано
	|					ИЛИ УПД.СтатусПодписания = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Подписано,
	|	СУММА(ВЫБОР
	|			КОГДА УПД.Утверждено
	|					И НЕ УПД.Подписано
	|					И УПД.СтатусПодписания <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ЖдутПодписи,
	|	СУММА(ВЫБОР
	|			КОГДА УПД.КОтправке
	|					И НЕ УПД.Утверждено
	|					И НЕ УПД.Подписано
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КОтправке,
	|	СУММА(ВЫБОР
	|			КОГДА НЕ УПД.РасхожденийНет
	|					И УПД.ТекстСверки <> """"
	|					И НЕ УПД.Подписано
	|					И УПД.СтатусПодписания <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СРасхождениями,
	|	СУММА(ВЫБОР
	|			КОГДА УПД.РасхожденийНет
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Сошлось,
	|	ЕСТЬNULL(МАКСИМУМ(УПД.КомментарийДата), ДАТАВРЕМЯ(1, 1, 1)) КАК ПоследнийКомментарий
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	(&НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ УПД.Дата >= &НачалоПериода)
	|	И (&КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ УПД.Дата <= &КонецПериода)";
	Запрос.УстановитьПараметр("НачалоПериода",
		?(ЗначениеЗаполнено(ДатаС), НачалоДня(ДатаС), Дата(1, 1, 1)));
	Запрос.УстановитьПараметр("КонецПериода",
		?(ЗначениеЗаполнено(ДатаПо), КонецДня(ДатаПо), Дата(1, 1, 1)));

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Статистика = Результат.Статистика;
			Для Каждого Имя Из СтрРазделить("Всего,Подписано,ЖдутПодписи,КОтправке,СРасхождениями", ",") Цикл
				Значение = Выборка[Имя];
				Статистика[Имя] = ?(Значение = Null, 0, Значение);
			КонецЦикла;
			// Счётчики состава реестра. ДатаЗагрузки и ДатаСводки не входят:
			// фоновая догрузка товаров пишет сводку по каждому документу
			// и иначе меняла хеш и дёргала таблицу.
			// Сошлось входит в хеш отдельно: строка зеленеет по «Расхождений нет»,
			// а счётчик расхождений при этом не меняется и список не перечитывался
			Сошлось = ?(Выборка.Сошлось = Null, 0, Выборка.Сошлось);
			Результат.Хеш = СтрШаблон("%1|%2|%3|%4|%5|%6|%7",
				Статистика.Всего, Статистика.Подписано, Статистика.ЖдутПодписи,
				Статистика.КОтправке, Статистика.СРасхождениями, Сошлось,
				Формат(Выборка.ПоследнийКомментарий, "ДФ=yyyyMMddHHmmss"));
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЭАрМ.СтатистикаУПД",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось рассчитать снимок реестра УПД: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ЗапуститьАвтообновлениеРеестра()

	Если ИдётАвтообновлениеРеестра = Истина Тогда
		Возврат;
	КонецЕсли;

	Если ПоследняяАвтосверка <> Неопределено
		И ТекущаяДата() - ПоследняяАвтосверка < 60 Тогда
		Возврат;
	КонецЕсли;
	ПоследняяАвтосверка = ТекущаяДата();

	Операция = ЗапуститьАвтосверкуНаСервере(УникальныйИдентификатор, ДатаУПДС, ДатаУПДПо);
	Если Операция = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИдётАвтообновлениеРеестра = Истина;

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Ложь;
	ПараметрыОжидания.ВыводитьСообщения = Ложь;

	Попытка
		ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция,
			Новый ОписаниеОповещения("АвтообновлениеРеестраЗавершено", ЭтотОбъект),
			ПараметрыОжидания);
	Исключение
		ИдётАвтообновлениеРеестра = Ложь;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура АвтообновлениеРеестраЗавершено(Результат, ДополнительныеПараметры) Экспорт

	ИдётАвтообновлениеРеестра = Ложь;

	// Список не перечитываем: результат автосверки подтянет фолбэк снимка
	// (120 с), а лишний Обновить() дёргал список, пока в нём выбирали строку.

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Перечитывает из СБИС только текущую УПД: шапку и её XML с товарами.
// Весь реестр за 3 дня забирает регламент.
//
&НаКлиенте
Процедура ПолучитьУПД(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите УПД в списке'"));
		Возврат;
	КонецЕсли;

	ЗаморозитьАвтообновлениеСписка();

	Попытка

		Состояние(НСтр("ru = 'УПД: обращение к СБИС...'"));
		ИтогЗагрузки = ЗагрузитьУПДТочечноНаСервере(Идентификатор);
		Состояние();

		Если НЕ ИтогЗагрузки.Успех Тогда
			РазморозитьАвтообновлениеСписка();
			СообщитьПользователю(ИтогЗагрузки.Ошибка);
			Возврат;
		КонецЕсли;

		ЗапрошенныеТоварыУПД = Новый Соответствие;
		ОбновитьСписокИЦепочку(Истина);
		СообщитьПользователю(ИтогЗагрузки.Сообщение);
		РазморозитьАвтообновлениеСписка();

	Исключение
		РазморозитьАвтообновлениеСписка();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Читает приходные накладные Далиона из папки обмена.
//
// Файлы result_receipts_*.json Далион кладёт в папку сам, а разбирает их
// регламентное задание. Команда нужна, чтобы перечитать папку сейчас и
// сразу увидеть приход в цепочке выбранного документа.
//
&НаКлиенте
Процедура ПолучитьНакладныеДалион(Команда)

	Состояние(НСтр("ru = 'Приходные накладные: чтение папки обмена...'"));
	ИтогЧтения = ЗабратьНакладныеДалионНаСервере();
	Состояние();

	СообщитьПользователю(ИтогЧтения);

	ОбновитьСписокИЦепочку(Истина);

КонецПроцедуры

// Контекстное меню строки: запрашивает у Далиона приходную накладную с номером
// выбранной УПД (по номеру и ИНН контрагента, без выбора периода).
//
&НаКлиенте
Процедура ПолучитьПриходнуюПоНомеру(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите УПД в списке'"));
		Возврат;
	КонецЕсли;

	СообщитьПользователю(ПолучитьПриходнуюПоНомеруНаСервере(Идентификатор));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПриходнуюПоНомеруНаСервере(ИдентификаторУПД)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.ИННКонтрагента КАК ИННКонтрагента
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.ИдентификаторСБИС = &ИдентификаторСБИС";
	Запрос.УстановитьПараметр("ИдентификаторСБИС", ИдентификаторУПД);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() ИЛИ НЕ ЗначениеЗаполнено(СокрЛП(Выборка.Номер)) Тогда
		Возврат НСтр("ru = 'У выбранной УПД нет номера - запрос не отправлен'");
	КонецЕсли;

	Результат = ЭАрМ_ЗапросыДалион.ЗапроситьПриходнуюПоНомеру(
		СокрЛП(Выборка.Номер), СокрЛП(Выборка.ИННКонтрагента), Выборка.Дата);

	Если НЕ Результат.Успех Тогда
		Возврат НСтр("ru = 'Запрос не отправлен: '") + Результат.Ошибка;
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Запрос приходной накладной №%1 отправлен в Далион. Ответ придёт регламентом; чтобы получить сразу, нажмите «Накладные Далиона».'"),
		СокрЛП(Выборка.Номер));

КонецФункции

// Выделенные УПД: запрашивает у Далиона договоры их поставщиков (по ИНН).
// Срок оплаты договора нужен для колонки «Дата оплаты» и для создания
// документа в БП. Ответ придёт обычным приёмом пакетов Далиона.
//
&НаКлиенте
Процедура ЗапроситьДоговорДалион(Команда)

	Идентификаторы = ВыделенныеИдентификаторы();
	Если Идентификаторы.Количество() = 0 Тогда
		СообщитьПользователю(НСтр("ru = 'Выделите УПД в списке'"));
		Возврат;
	КонецЕсли;

	СообщитьПользователю(ЗапроситьДоговорДалионНаСервере(Идентификаторы));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗапроситьДоговорДалионНаСервере(ИдентификаторыУПД)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УПД.ИННКонтрагента КАК ИННКонтрагента
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.ИдентификаторСБИС В (&ИдентификаторыУПД)";
	Запрос.УстановитьПараметр("ИдентификаторыУПД", ИдентификаторыУПД);

	ИННы = Новый Массив;
	БезИНН = 0;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(СокрЛП(Выборка.ИННКонтрагента)) Тогда
			ИННы.Добавить(СокрЛП(Выборка.ИННКонтрагента));
		Иначе
			БезИНН = БезИНН + 1;
		КонецЕсли;
	КонецЦикла;

	Результат = ЭАрМ_ЗапросыДалион.ЗапроситьДоговорыПоИНН(ИННы);

	Если НЕ Результат.Успех Тогда
		Возврат НСтр("ru = 'Запрос договоров не отправлен: '") + Результат.Ошибка;
	КонецЕсли;

	Итог = СтрШаблон(НСтр("ru = 'Запрос договоров отправлен в Далион: поставщиков %1 (ИНН %2). Ответ придёт регламентом приёма пакетов, затем в колонке «Дата оплаты» появятся даты.'"),
		Результат.ИННы.Количество(), СтрСоединить(Результат.ИННы, ", "));
	Если БезИНН > 0 Тогда
		Итог = Итог + Символы.ПС + СтрШаблон(НСтр("ru = 'УПД без ИНН поставщика пропущено: %1'"), БезИНН);
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Строка УПД: форма подбора приходной поверх списка. Номер - номер УПД,
// дата - плюс-минус дней. После выбора сразу сверка.
//
&НаКлиенте
Процедура ИзменитьПриходную(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите УПД в списке'"));
		Возврат;
	КонецЕсли;

	ОткрытьФорму("РегистрСведений.ЭАрМ_УПД_Входящий.Форма.ФормаВыбораПриходной",
		Новый Структура("ИдентификаторУПД", Идентификатор),
		ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ПриходнаяДляСменыВыбрана", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПриходнаяДляСменыВыбрана(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Сверка с выбранной приходной...'"));
	Текст = СменитьПриходнуюНаСервере(Результат.ИдентификаторУПД,
		Результат.ИдентификаторЗаказа, Результат.ИдентификаторПоступления);
	Состояние();

	ЦепочкаПостроенаДля = Неопределено;
	ОбновитьСписокИЦепочку(Истина);
	СообщитьПользователю(Текст);

КонецПроцедуры

&НаСервереБезКонтекста
Функция СменитьПриходнуюНаСервере(ИдентификаторУПД, ИдентификаторЗаказа, ИдентификаторПоступления)

	Возврат ЭАрМ_ЦепочкаЗакупки.СменитьПриходнуюУПД(ИдентификаторУПД, ИдентификаторЗаказа,
		ИдентификаторПоступления);

КонецФункции

// Ищет в СБИС УПД для приходных Далиона, у которых в цепочке её нет.
//
// Открывает окно выбора периода (по умолчанию те же 3 дня, что у реестра)
// и ищет УПД для приходных, поступивших в этом периоде. Реестр УПД регламент
// читает только за последние дни, а эта команда добирает УПД адресно,
// по входящему номеру приходной.
//
&НаКлиенте
Процедура ДозапроситьУПД(Команда)

	КонецПериода = КонецДня(ТекущаяДата());
	Глубина = ГлубинаРеестраДней();

	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Период = Новый СтандартныйПериод(НачалоДня(КонецПериода) - Глубина * 86400, КонецПериода);
	Диалог.Показать(Новый ОписаниеОповещения("ДозапроситьУПДПериодВыбран", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ДозапроситьУПДПериодВыбран(Период, ДополнительныеПараметры) Экспорт

	Если Период = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'УПД к приходным: поиск в СБИС...'"));
	ИтогЗапроса = ДозапроситьУПДНаСервере(Период.ДатаНачала, Период.ДатаОкончания);
	Состояние();

	СообщитьПользователю(ИтогЗапроса);

	ОбновитьСписокИЦепочку(Истина);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ДозапроситьУПДНаСервере(ДатаС, ДатаПо)

	Итог = ЭАрМ_ЦепочкаЗакупки.ДозапроситьУПДДляПриходов(
		ДатаС, ДатаПо, ЭАрМ_НастройкиСервер.НастройкиЦепочки());

	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Возврат Итог.Ошибка;
	КонецЕсли;

	Текст = СтрШаблон(НСтр("ru = 'Приходных без УПД: %1. Загружено УПД: %2, не найдено: %3, уже в реестре: %4, без входящего номера: %5'"),
		Итог.Отобрано, Итог.Загружено, Итог.НеНайдено, Итог.УжеВРеестре, Итог.БезНомера);

	Если Итог.Осталось > 0 Тогда
		Текст = Текст + Символы.ПС + СтрШаблон(
			НСтр("ru = 'Не вошло в этот проход: %1 номеров, повторите команду'"), Итог.Осталось);
	КонецЕсли;

	Если Итог.Сбоев > 0 Тогда
		Текст = Текст + Символы.ПС + СтрШаблон(
			НСтр("ru = 'Не проверено из-за сбоя запроса к СБИС: %1 номеров, повторите команду'"), Итог.Сбоев);
	КонецЕсли;

	Для Каждого Сообщение Из Итог.Сообщения Цикл
		Текст = Текст + Символы.ПС + Сообщение;
	КонецЦикла;

	Возврат Текст;

КонецФункции

// Запрашивает реестр УПД из СБИС за выбранный период.
//
// Регламент читает реестр только за последние 3 дня. Команда забирает за любой
// период: реестр - постранично, товары - фоновым заданием, как при обычной
// загрузке. Общий предел глубины обмена (3 дня) не меняется.
//
&НаКлиенте
Процедура ЗапроситьРеестрЗаПериод(Команда)

	КонецПериода = КонецДня(ТекущаяДата());

	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Период = Новый СтандартныйПериод(НачалоДня(КонецПериода) - ГлубинаРеестраДней() * 86400, КонецПериода);
	Диалог.Показать(Новый ОписаниеОповещения("ЗапроситьРеестрЗаПериодВыбран", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьРеестрЗаПериодВыбран(Период, ДополнительныеПараметры) Экспорт

	Если Период = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаморозитьАвтообновлениеСписка();

	Попытка

		Состояние(НСтр("ru = 'Реестр УПД за период: запрос в СБИС...'"));
		Итог = ЗагрузитьРеестрНаСервере(УникальныйИдентификатор,
			Период.ДатаНачала, Период.ДатаОкончания);
		Состояние();

		Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
			РазморозитьАвтообновлениеСписка();
			СообщитьПользователю(Итог.Ошибка);
			Возврат;
		КонецЕсли;

		СообщитьПользователю(СтрШаблон(НСтр("ru = 'За %1 - %2: %3'"),
			Формат(Период.ДатаНачала, "ДЛФ=D"), Формат(Период.ДатаОкончания, "ДЛФ=D"), Итог.Сообщение));
		ОбновитьСписокИЦепочку(Истина);

		Если Итог.Операция = Неопределено Тогда
			РазморозитьАвтообновлениеСписка();
			Возврат;
		КонецЕсли;

		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		ПараметрыОжидания.ВыводитьПрогрессВыполнения = Ложь;
		ПараметрыОжидания.ВыводитьСообщения = Ложь;
		ДлительныеОперацииКлиент.ОжидатьЗавершение(Итог.Операция,
			Новый ОписаниеОповещения("ЗагрузкаТоваровЗавершена", ЭтотОбъект), ПараметрыОжидания);

	Исключение
		РазморозитьАвтообновлениеСписка();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ГлубинаРеестраДней()

	Возврат ЭАрМ_НастройкиСервер.МаксимальнаяГлубинаДней();

КонецФункции

// Смотрит приходные в папке archive и ищет к ним УПД.
//
// Загрузка из архива идёт только при включённой настройке «Получение старых
// документов из архива». Уникальные приходные без УПД запрашиваются в СБИС
// по одной, и только если дата приходной попадает в окно реестра (3 дня).
// Дальше связи и сверка те же, что у регламента: цвет строки реестра
// ставит обычное оформление (зелёная — сошлось, красная — расхождение).
//
&НаКлиенте
Процедура ПросмотретьАрхив(Команда)

	Состояние(НСтр("ru = 'Архив: приходные и УПД...'"));
	ИтогАрхива = ПросмотретьАрхивНаСервере();
	Состояние();

	СообщитьПользователю(ИтогАрхива);
	ОбновитьСписокИЦепочку(Истина);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПросмотретьАрхивНаСервере()

	Итог = ЭАрМ_ЦепочкаЗакупки.ПросмотретьАрхивИСвестиУПД();

	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Возврат Итог.Ошибка;
	КонецЕсли;

	Текст = СтрШаблон(НСтр("ru = 'Архив: файлов %1, уникальных приходных %2. УПД уже была: %3. Запрошено в СБИС за %4 дн.: загружено %5, не найдено %6, вне периода %7.'"),
		Итог.Файлов, Итог.Уникальных, Итог.УжеБылаУПД, Итог.ГлубинаДней,
		Итог.Загружено, Итог.НеНайдено, Итог.ВнеПериода);
	Текст = Текст + Символы.ПС + СтрШаблон(
		НСтр("ru = 'После сверки: сошлось %1, расхождение %2, без УПД %3, без сверки %4.'"),
		Итог.Сошлось, Итог.Расхождение, Итог.БезУПД, Итог.БезСверки);

	Если Итог.Осталось > 0 Тогда
		Текст = Текст + Символы.ПС + СтрШаблон(
			НСтр("ru = 'Не вошло в этот проход: %1 номеров, повторите команду'"), Итог.Осталось);
	КонецЕсли;

	Для Каждого Сообщение Из Итог.Сообщения Цикл
		Текст = Текст + Символы.ПС + Сообщение;
	КонецЦикла;

	Возврат Текст;

КонецФункции

// Ручной тестовый запрос пломбы по выбранной УПД. Автомат сверки и подписи
// не требуется: в Далион уходит setSeal по uid приходной из цепочки.
//
&НаКлиенте
Процедура УстановитьПломбуТест(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите УПД в списке'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Запрос пломбы в Далион...'"));
	ОтветПломбы = УстановитьПломбуТестНаСервере(Идентификатор);
	Состояние();

	СообщитьПользователю(ОтветПломбы);
	ОбновитьСписокИЦепочку();

КонецПроцедуры

// Показывает, что СБИС знает о текущей УПД, и при желании готовит действие.
//
// Команда диагностическая. Подписание по API идёт двумя шагами: сначала
// СБИС.ПодготовитьДействие - сервер формирует служебные вложения и титул
// ответа и возвращает их список, потом СБИС.ВыполнитьДействие с сертификатом
// и файлом подписи. Состав этапов и действий зависит от документа и учётной
// записи, поэтому обвязку пишем по живому ответу, а не по догадке.
//
// По умолчанию команда только читает документ. Подготовка запрашивается лишь
// с явно названным действием: этот вызов не подписывает и не отправляет, но
// пересоздаёт на стороне СБИС служебные вложения и титул ответа, а угадывать
// за пользователя, какое действие пересобрать, команда не должна.
//
&НаКлиенте
Процедура ПодготовитьДействиеСБИС(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите документ в списке'"));
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПодготовитьДействиеСБИСЗавершение", ЭтотОбъект,
		Новый Структура("Идентификатор", Идентификатор));

	ПоказатьВводСтроки(ОписаниеОповещения, "",
		НСтр("ru = 'Действие для подготовки. Пустая строка - только прочитать документ'"));

КонецПроцедуры

// Читает документ, а действие подготавливает, только если его назвали.
//
&НаКлиенте
Процедура ПодготовитьДействиеСБИСЗавершение(ДействиеЭтапа, ДополнительныеПараметры) Экспорт

	Если ДействиеЭтапа = Неопределено Тогда
		// Пользователь отказался от ввода
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Обращение к СБИС...'"));
	ОтветСБИС = ПодготовитьДействиеНаСервере(
		ДополнительныеПараметры.Идентификатор, СокрЛП(ДействиеЭтапа));
	Состояние();

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ОтветСБИС);
	ТекстовыйДокумент.Показать(НСтр("ru = 'СБИС: документ и действия'"));

КонецПроцедуры

// Подписывает вложения действия и отправляет подписи в СБИС.
//
// Действие необратимо: после ВыполнитьДействие титул покупателя уходит
// поставщику, поэтому команда сначала спрашивает подтверждение.
//
// Подписание идёт на клиенте: закрытый ключ лежит у пользователя, а не на
// сервере. Отсюда цепочка асинхронных шагов - менеджер криптографии,
// сертификат, затем по подписи на каждое вложение.
//
&НаКлиенте
Процедура ПодписатьИУтвердитьСБИС(Команда)

	НачатьПодписаниеДокумента("УПД", ИдентификаторТекущейСтроки());

КонецПроцедуры

// Подписывает УКД выбранной УПД тем же механизмом, что и «Отправить УПД».
// Несколько корректировок - сначала выбор, какую отправить.
//
&НаКлиенте
Процедура ОтправитьУКД(Команда)

	ИдентификаторУПД = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите документ в списке'"));
		Возврат;
	КонецЕсли;

	Корректировки = КорректировкиДляОтправкиНаСервере(ИдентификаторУПД);
	Если Корректировки.Количество() = 0 Тогда
		СообщитьПользователю(НСтр("ru = 'У выбранной УПД нет УКД, которую можно отправить'"));
		Возврат;
	КонецЕсли;

	Если Корректировки.Количество() = 1 Тогда
		НачатьОтправкуУКД(Корректировки[0].Идентификатор);
		Возврат;
	КонецЕсли;

	СписокВыбора = Новый СписокЗначений;
	Для Каждого Корректировка Из Корректировки Цикл
		СписокВыбора.Добавить(Корректировка.Идентификатор, Корректировка.Представление);
	КонецЦикла;

	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("УКДДляОтправкиВыбрана", ЭтотОбъект),
		СписокВыбора, Элементы.ОтправитьУКДКнопка);

КонецПроцедуры

&НаКлиенте
Процедура УКДДляОтправкиВыбрана(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НачатьОтправкуУКД(ВыбранныйЭлемент.Значение);

КонецПроцедуры

// Ставит «К отправке», если корректировку уже можно утверждать, и открывает
// ту же подпись, что у УПД. Очередь сама документ не уносит: подписывает
// эта форма.
//
&НаКлиенте
Процедура НачатьОтправкуУКД(ИдентификаторУКД)

	Ошибка = ПодготовитьУКДКПодписиНаСервере(ИдентификаторУКД);
	Если ЗначениеЗаполнено(Ошибка) Тогда
		СообщитьПользователю(Ошибка);
		Возврат;
	КонецЕсли;

	НачатьПодписаниеДокумента("УКД", ИдентификаторУКД);

КонецПроцедуры

// Подписывает связанную ЭТрН выбранной УПД тем же механизмом, что и реестр
// ЭТрН. После отправки колонка «ЭТрН» здесь и строка в реестре ЭТрН зеленеют.
//
&НаКлиенте
Процедура ОтправитьЭТрН(Команда)

	ИдентификаторУПД = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите документ в списке'"));
		Возврат;
	КонецЕсли;

	ИдентификаторЭТрН = ИдентификаторЭТрНТекущейУПДНаСервере(ИдентификаторУПД);
	Если НЕ ЗначениеЗаполнено(ИдентификаторЭТрН) Тогда
		СообщитьПользователю(НСтр("ru = 'У выбранной УПД нет связанной ЭТрН'"));
		Возврат;
	КонецЕсли;

	НачатьПодписаниеДокумента("ЭТрН", ИдентификаторЭТрН);

КонецПроцедуры

&НаКлиенте
Процедура НачатьПодписаниеДокумента(Реестр, Идентификатор)

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите документ в списке'"));
		Возврат;
	КонецЕсли;

	ТекстЗапрета = ЗапретУтвержденияНаСервере(Реестр, Идентификатор);
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		СообщитьПользователю(ТекстЗапрета);
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПодписатьИУтвердитьПодтверждение", ЭтотОбъект,
		Новый Структура("Реестр, Идентификатор", Реестр, Идентификатор));

	ПоказатьВопрос(ОписаниеОповещения, ТекстВопросаПодписания(Реестр),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Функция ТекстВопросаПодписания(Реестр)

	Если Реестр = "ЭТрН" Тогда
		Возврат НСтр("ru = 'Подписать ЭТрН как «Получен» - груз принят полностью - и отправить в СБИС? Отменить это будет нельзя. Если груз пришёл не весь или с браком, оформите «Получен частично» или «Не принят» в СБИС.'");
	КонецЕсли;

	Если Реестр = "УКД" Тогда
		Возврат НСтр("ru = 'Подписать выбранную УКД и отправить утверждение в СБИС? Отменить это будет нельзя.'");
	КонецЕсли;

	Возврат НСтр("ru = 'Подписать выбранную УПД и отправить утверждение в СБИС? Отменить это будет нельзя.'");

КонецФункции

// Ответ на вопрос о подписании.
//
&НаКлиенте
Процедура ПодписатьИУтвердитьПодтверждение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	// Подписантов в настройках может быть два - спрашиваем, кто подписывает
	ЭАрМ_ПанельУправленияЭДОКлиент.ВыбратьПодписанта(
		Новый ОписаниеОповещения("ПодписантДляПодписанияВыбран", ЭтотОбъект, ДополнительныеПараметры));

КонецПроцедуры

// Подписант выбран - готовим действие в СБИС его сертификатом.
//
&НаКлиенте
Процедура ПодписантДляПодписанияВыбран(НомерПодписанта, ДополнительныеПараметры) Экспорт

	Если НомерПодписанта = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ИдётФоновоеУтверждение = Истина Тогда
		СообщитьПользователю(НСтр("ru = 'Утверждение предыдущего документа ещё идёт - дождитесь его'"));
		Возврат;
	КонецЕсли;

	// Подготовка в СБИС - фоновым заданием: форма не висит, пока СБИС отвечает
	ПараметрыФункции = Новый Массив;
	ПараметрыФункции.Добавить(ДополнительныеПараметры.Реестр);
	ПараметрыФункции.Добавить(ДополнительныеПараметры.Идентификатор);
	ПараметрыФункции.Добавить(НомерПодписанта);
	Операция = ЗапуститьУтверждениеВФоне(УникальныйИдентификатор,
		"ЭАрМ_УтверждениеСБИС.ПодготовитьПодписание", ПараметрыФункции);
	Если ТипЗнч(Операция) = Тип("Строка") Тогда
		СообщитьПользователю(Операция);
		Возврат;
	КонецЕсли;

	ИдётФоновоеУтверждение = Истина;
	ОжидатьФоновоеУтверждение(Операция, "ПодготовкаПодписанияЗавершена",
		НСтр("ru = 'СБИС: подготовка действия'"), , Истина);

КонецПроцедуры

// Подготовка в СБИС закончилась - подписываем вложения на клиенте.
//
&НаКлиенте
Процедура ПодготовкаПодписанияЗавершена(Результат, ДополнительныеПараметры) Экспорт

	ИдётФоновоеУтверждение = Ложь;

	ТекстОшибки = "";
	Подготовка = РезультатФоновогоУтверждения(Результат, ТекстОшибки);
	Если Подготовка = Неопределено Тогда
		СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;

	Если НЕ Подготовка.Успех Тогда
		СообщитьПользователю(Подготовка.Ошибка);
		Возврат;
	КонецЕсли;

	ПодписаниеСБИС = Подготовка;
	ПодписаниеСБИС.Вставить("Индекс", 0);

	// Сертификат берём первым: по нему менеджер криптографии выберет нужную
	// программу. Без этого он создаётся первой попавшейся, и подписание
	// ГОСТ-сертификатом падает на "неизвестном алгоритме криптографии"
	ЭлектроннаяПодписьКлиент.ПолучитьСертификатПоОтпечатку(
		Новый ОписаниеОповещения("ПодписаниеСертификатПолучен", ЭтотОбъект),
		ПодписаниеСБИС.ОтпечатокBase64, Истина);

КонецПроцедуры

// Менеджер криптографии получен.
//
&НаКлиенте
Процедура ПодписаниеМенеджерПолучен(МенеджерКриптографии, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(МенеджерКриптографии) <> Тип("МенеджерКриптографии") Тогда
		ПрерватьПодписаниеСБИС(СтрШаблон(НСтр(
			"ru = 'Не удалось создать менеджер криптографии для этого сертификата: %1'"),
			?(ТипЗнч(МенеджерКриптографии) = Тип("Строка"), МенеджерКриптографии,
				НСтр("ru = 'проверьте, установлена ли нужная программа криптографии'"))));
		Возврат;
	КонецЕсли;

	ПодписаниеСБИС.Вставить("Менеджер", МенеджерКриптографии);
	ПодписатьСледующееВложениеСБИС();

КонецПроцедуры

// Сертификат найден в личном хранилище.
//
&НаКлиенте
Процедура ПодписаниеСертификатПолучен(Сертификат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Сертификат) <> Тип("СертификатКриптографии") Тогда
		ПрерватьПодписаниеСБИС(СтрШаблон(НСтр(
			"ru = 'Сертификат с отпечатком %1 не найден в личном хранилище этого компьютера.'"),
			ПодписаниеСБИС.Отпечаток));
		Возврат;
	КонецЕсли;

	// Проверка перед отправкой: просроченным или ещё не вступившим в силу
	// сертификатом не подписываем - СБИС такой титул не примет, а поставщик
	// получит отказ уже после того, как документ ушёл
	ТекстСрока = ОшибкаСрокаСертификата(Сертификат);
	Если ЗначениеЗаполнено(ТекстСрока) Тогда
		ПрерватьПодписаниеСБИС(ТекстСрока);
		Возврат;
	КонецЕсли;

	ПодписаниеСБИС.Вставить("Сертификат", Сертификат);

	// Данные сертификата в DER: по ним подсистема определит программу
	// криптографии, которой он выписан
	ЭлектроннаяПодписьКлиент.СоздатьМенеджерКриптографии(
		Новый ОписаниеОповещения("ПодписаниеМенеджерПолучен", ЭтотОбъект),
		"Подписание", Истина, Сертификат.Выгрузить());

КонецПроцедуры

// Подписывает очередное вложение либо переходит к отправке.
//
&НаКлиенте
Процедура ПодписатьСледующееВложениеСБИС()

	Если ПодписаниеСБИС.Индекс >= ПодписаниеСБИС.Вложения.Количество() Тогда
		ОтправитьПодписиСБИС();
		Возврат;
	КонецЕсли;

	Вложение = ПодписаниеСБИС.Вложения[ПодписаниеСБИС.Индекс];

	Состояние(СтрШаблон(НСтр("ru = 'Подписание: %1'"), Вложение.Имя));

	// Метод менеджера криптографии называется НачатьПодписывание,
	// НачатьПодписание у него нет
	// Обработчик ошибки: без него сбой подписи оставлял ПодписаниеСБИС
	// заполненным, и автоотправка формы больше не запускалась
	ПодписаниеСБИС.Менеджер.НачатьПодписывание(
		Новый ОписаниеОповещения("ВложениеПодписаноСБИС", ЭтотОбъект, ,
			"ВложениеНеПодписаноСБИС", ЭтотОбъект),
		Вложение.Данные, ПодписаниеСБИС.Сертификат);

КонецПроцедуры

&НаКлиенте
Процедура ВложениеНеПодписаноСБИС(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	СтандартнаяОбработка = Ложь;
	ПрерватьПодписаниеСБИС(НСтр("ru = 'Ошибка подписи: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке));

КонецПроцедуры

// Подпись одного вложения готова.
//
&НаКлиенте
Процедура ВложениеПодписаноСБИС(ДанныеПодписи, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(ДанныеПодписи) <> Тип("ДвоичныеДанные") Тогда
		ПрерватьПодписаниеСБИС(НСтр("ru = 'Подписание прервано'"));
		Возврат;
	КонецЕсли;

	Вложение = ПодписаниеСБИС.Вложения[ПодписаниеСБИС.Индекс];
	Вложение.Подпись = ДанныеПодписи;

	// Подпись проверяется до отправки: битая подпись (не тот сертификат,
	// сбой программы криптографии) ушла бы в СБИС и вернулась отказом
	Состояние(СтрШаблон(НСтр("ru = 'Проверка подписи: %1'"), Вложение.Имя));
	ПодписаниеСБИС.Менеджер.НачатьПроверкуПодписи(
		Новый ОписаниеОповещения("ПодписьВложенияПроверенаСБИС", ЭтотОбъект, ,
			"ПодписьВложенияНеПроверенаСБИС", ЭтотОбъект),
		Вложение.Данные, ДанныеПодписи);

КонецПроцедуры

// Подпись вложения прошла проверку - к следующему вложению.
//
&НаКлиенте
Процедура ПодписьВложенияПроверенаСБИС(СертификатПодписи, ДополнительныеПараметры) Экспорт

	Если ПодписаниеСБИС = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПодписаниеСБИС.Индекс = ПодписаниеСБИС.Индекс + 1;
	ПодписатьСледующееВложениеСБИС();

КонецПроцедуры

// Подпись вложения не прошла проверку - в СБИС ничего не отправляем.
//
&НаКлиенте
Процедура ПодписьВложенияНеПроверенаСБИС(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	СтандартнаяОбработка = Ложь;

	ИмяВложения = "";
	Если ПодписаниеСБИС <> Неопределено
		И ПодписаниеСБИС.Индекс < ПодписаниеСБИС.Вложения.Количество() Тогда
		ИмяВложения = ПодписаниеСБИС.Вложения[ПодписаниеСБИС.Индекс].Имя;
	КонецЕсли;

	ПрерватьПодписаниеСБИС(СтрШаблон(НСтр(
		"ru = 'Подпись вложения %1 не прошла проверку, в СБИС ничего не отправлено: %2'"),
		ИмяВложения, КраткоеПредставлениеОшибки(ИнформацияОбОшибке)));

КонецПроцедуры

// Владелец сертификата для сообщения: CN субъекта, если он есть.
//
&НаКлиенте
Функция ВладелецСертификата(Сертификат)

	Субъект = Сертификат.Субъект;
	Если ТипЗнч(Субъект) = Тип("Структура") И Субъект.Свойство("CN") Тогда
		Возврат Субъект.CN;
	КонецЕсли;

	Возврат НСтр("ru = 'владелец не указан'");

КонецФункции

// Текст ошибки, если сертификат сейчас не действует; пустая строка - действует.
//
&НаКлиенте
Функция ОшибкаСрокаСертификата(Сертификат)

	Сейчас = ОбщегоНазначенияКлиент.ДатаСеанса();

	Если ЗначениеЗаполнено(Сертификат.ДатаОкончания) И Сертификат.ДатаОкончания < Сейчас Тогда
		Возврат СтрШаблон(НСтр("ru = 'Срок действия сертификата подписи истёк %1 (%2). Подписание остановлено, в СБИС ничего не отправлено.'"),
			Формат(Сертификат.ДатаОкончания, "ДЛФ=D"), ВладелецСертификата(Сертификат));
	КонецЕсли;

	Если ЗначениеЗаполнено(Сертификат.ДатаНачала) И Сертификат.ДатаНачала > Сейчас Тогда
		Возврат СтрШаблон(НСтр("ru = 'Сертификат подписи начнёт действовать только %1 (%2). Подписание остановлено.'"),
			Формат(Сертификат.ДатаНачала, "ДЛФ=D"), ВладелецСертификата(Сертификат));
	КонецЕсли;

	Возврат "";

КонецФункции

// Отправляет подписи в СБИС и показывает ответ.
//
&НаКлиенте
Процедура ОтправитьПодписиСБИС()

	// На сервер уходит только то, что он умеет принять. Сертификат
	// криптографии и менеджер между клиентом и сервером не передаются.
	// Файлы вложений нужны, если титул грузополучателя дозаполнили до подписи.
	ДанныеОтправки = Новый Структура;
	ДанныеОтправки.Вставить("Реестр",        ?(ПодписаниеСБИС.Свойство("Реестр"),
		ПодписаниеСБИС.Реестр, "УПД"));
	ДанныеОтправки.Вставить("Идентификатор", ПодписаниеСБИС.Идентификатор);
	ДанныеОтправки.Вставить("Этап",          ПодписаниеСБИС.Этап);
	ДанныеОтправки.Вставить("Действие",      ПодписаниеСБИС.Действие);
	ДанныеОтправки.Вставить("НомерПодписанта", ?(ПодписаниеСБИС.Свойство("НомерПодписанта"),
		ПодписаниеСБИС.НомерПодписанта, 1));

	ВложенияОтправки = Новый Массив;

	Для Каждого Вложение Из ПодписаниеСБИС.Вложения Цикл
		ВложениеОтправки = Новый Структура("Идентификатор, Имя, Подпись",
			Вложение.Идентификатор, Вложение.Имя, Вложение.Подпись);
		Если Вложение.Свойство("ФайлЗаменён") И Вложение.ФайлЗаменён Тогда
			ВложениеОтправки.Вставить("Данные", Вложение.Данные);
			ВложениеОтправки.Вставить("ФайлЗаменён", Истина);
		КонецЕсли;
		ВложенияОтправки.Добавить(ВложениеОтправки);
	КонецЦикла;

	ДанныеОтправки.Вставить("Вложения", ВложенияОтправки);

	ПодписаниеСБИС = Неопределено;

	// Отправка подписей в СБИС - фоновым заданием, форма не висит
	ПараметрыФункции = Новый Массив;
	ПараметрыФункции.Добавить(ДанныеОтправки.Реестр);
	ПараметрыФункции.Добавить(ДанныеОтправки);
	Операция = ЗапуститьУтверждениеВФоне(УникальныйИдентификатор,
		"ЭАрМ_УтверждениеСБИС.ВыполнитьДействиеСПроверкой", ПараметрыФункции);
	Если ТипЗнч(Операция) = Тип("Строка") Тогда
		СообщитьПользователю(Операция);
		Возврат;
	КонецЕсли;

	ИдётФоновоеУтверждение = Истина;
	ОжидатьФоновоеУтверждение(Операция, "ОтправкаПодписейЗавершена",
		НСтр("ru = 'СБИС: отправка подписей'"), ДанныеОтправки.Реестр);

КонецПроцедуры

// Подписи отправлены - отчёт СБИС и обновлённый список.
//
&НаКлиенте
Процедура ОтправкаПодписейЗавершена(Результат, Реестр) Экспорт

	ИдётФоновоеУтверждение = Ложь;

	ТекстОшибки = "";
	ОтветСБИС = РезультатФоновогоУтверждения(Результат, ТекстОшибки);
	Если ОтветСБИС = Неопределено Тогда
		ОтветСБИС = ТекстОшибки;
	КонецЕсли;

	ЗаголовокОтчёта = НСтр("ru = 'СБИС: утверждение'");
	Если Реестр = "ЭТрН" Тогда
		ЗаголовокОтчёта = НСтр("ru = 'СБИС: утверждение ЭТрН'");
	КонецЕсли;

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(Строка(ОтветСБИС));
	ТекстовыйДокумент.Показать(ЗаголовокОтчёта);

	ОбновитьСписокИЦепочку();

КонецПроцедуры

// Запускает функцию ЭАрМ_УтверждениеСБИС фоновым заданием.
//
// Возвращаемое значение:
//   Структура - длительная операция БСП; Строка - почему не запустилась
//
&НаСервереБезКонтекста
Функция ЗапуститьУтверждениеВФоне(ИдентификаторФормы, ИмяФункции, ПараметрыФункции)

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'СБИС: утверждение из реестра УПД'");
	ПараметрыВыполнения.СРасширениямиБазыДанных = Истина;
	// Ключ по действию и составу документов: второй клик по тем же документам
	// (из этой или другой формы) не запустит второе задание, разные - можно
	ПараметрыВыполнения.КлючФоновогоЗадания = ЭАрМ_ПанельУправленияЭДОСервер.КлючФоновогоЗаданияСБИС(
		ИмяФункции, ПараметрыФункции[0]);

	Попытка
		Если ПараметрыФункции.Количество() = 2 Тогда
			Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ИмяФункции,
				ПараметрыФункции[0], ПараметрыФункции[1]);
		КонецЕсли;
		Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ИмяФункции,
			ПараметрыФункции[0], ПараметрыФункции[1], ПараметрыФункции[2]);
	Исключение
		Возврат СтрШаблон(НСтр("ru = 'Фоновое задание СБИС не запущено: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

// Ждёт фоновое задание. Без окна ожидания форма остаётся рабочей, ход виден
// в строке состояния. С окном (СОкном) - окно БСП с кнопкой «Отмена»:
// только для подготовки, когда в СБИС ещё ничего не ушло и отмена
// безопасна. Отправку подписей не отменяем - часть могла уже уйти.
//
&НаКлиенте
Процедура ОжидатьФоновоеУтверждение(Операция, ИмяОбработчика, ТекстСообщения, ДополнительныеПараметры = Неопределено,
	СОкном = Ложь)

	Состояние(ТекстСообщения + "...");

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = ТекстСообщения;
	ПараметрыОжидания.ВыводитьОкноОжидания = СОкном;

	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция,
		Новый ОписаниеОповещения(ИмяОбработчика, ЭтотОбъект, ДополнительныеПараметры),
		ПараметрыОжидания);

КонецПроцедуры

// Результат фонового задания; Неопределено - задание упало или ожидание
// отменили, причина - в ТекстОшибки.
//
&НаКлиенте
Функция РезультатФоновогоУтверждения(Результат, ТекстОшибки)

	Состояние();

	Если Результат = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Ожидание ответа СБИС отменено'");
		Возврат Неопределено;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		ТекстОшибки = Результат.КраткоеПредставлениеОшибки;
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПолучитьИзВременногоХранилища(Результат.АдресРезультата);

КонецФункции

// Прекращает подписание, не оставляя за собой состояния.
//
&НаКлиенте
Процедура ПрерватьПодписаниеСБИС(ТекстОшибки)

	ПодписаниеСБИС = Неопределено;
	Состояние();
	СообщитьПользователю(ТекстОшибки);

КонецПроцедуры

// Сверка УПД или корректировки (УКД) с приходом Далиона: значения УПД до и
// после корректировки, приход и что не сошлось. Цепочка пересверяется сразу,
// отметки «Расхождений нет» обновляются.
//
&НаКлиенте
Процедура СверкаКорректировки(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите документ в списке'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Сверка с приходом Далиона...'"));
	ТекстСверки = СверкаКорректировкиНаСервере(Идентификатор);
	Состояние();

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстСверки);
	ТекстовыйДокумент.Показать(НСтр("ru = 'Сверка УПД и корректировок с приходом Далиона'"));

	ПоследнийСнимок = "";
	КэшСтатистикиВремя = Неопределено;
	ПеречитатьСписокРеестра();

КонецПроцедуры

// Раскрывает GTIN строк и коды маркировки УПД: Честный знак, SSCC, марки ЕГАИС.
// Документ перечитывается из СБИС, чтобы показать разбор кода, а не только
// сырые значения из регистра товаров.
//
&НаКлиенте
Процедура КодыМаркировки(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите документ в списке'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'СБИС: чтение кодов маркировки...'"));
	ТекстОтчета = КодыМаркировкиНаСервере(Идентификатор);
	Состояние();

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстОтчета);
	ТекстовыйДокумент.Показать(НСтр("ru = 'Коды маркировки и GTIN'"));

КонецПроцедуры

// Пересчитывает признак алкоголя строк текущей УПД, обновляет дерево и
// показывает строки-алкоголь и то, чего не хватает для ЕГАИС.
//
&НаКлиенте
Процедура АлкогольЕГАИС(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите документ в списке'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Алкоголь ЕГАИС: пересчёт строк УПД...'"));
	ТекстОтчета = АлкогольЕГАИСНаСервере(Идентификатор);
	Состояние();

	ОбновитьЦепочкуДокументов();

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстОтчета);
	ТекстовыйДокумент.Показать(НСтр("ru = 'Алкоголь ЕГАИС'"));

КонецПроцедуры

&НаКлиенте
Процедура ГрафикЦен(Команда)

	ОткрытьФорму("РегистрСведений.ЭАрМ_СверкаТоваровЦепочки.Форма.ФормаГрафикаЦен");

КонецПроцедуры

// Показывает сертификаты, доступные для подписания на этом компьютере.
//
// Нужна, когда подписание не находит сертификат по отпечатку из настроек.
// Отпечаток выводится в двух видах: шестнадцатеричном, как его показывают
// СБИС и КриптоПро, и в Base64 - именно по нему ищет БСП.
//
&НаКлиенте
Процедура ПоказатьСертификатыПодписи(Команда)

	// Кому выдан, издатель, срок, ИНН, отпечаток - по всем сертификатам
	// компьютера и по обоим подписантам из настроек
	ЭАрМ_ПанельУправленияЭДОКлиент.ПоказатьПодписантовИСертификаты();

КонецПроцедуры

// Отпечатки получены, показываем список.
//
&НаКлиенте
Процедура СертификатыПодписиПолучены(Результат, ДополнительныеПараметры) Экспорт

	Состояние();

	Отпечатки = Неопределено;
	ОшибкаКлиента = "";
	ОшибкаСервера = "";

	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("Отпечатки", Отпечатки);
		Результат.Свойство("ОшибкаПолученияСертификатовНаКлиенте", ОшибкаКлиента);
		Результат.Свойство("ОшибкаПолученияСертификатовНаСервере", ОшибкаСервера);
	КонецЕсли;

	// Со включённой подсистемой БСП список пустым не бывает: если он пуст
	// и ошибок нет, смотреть надо не на хранилище, а на саму подсистему
	ПодписиВключены = Ложь;
	Попытка
		ПодписиВключены = ЭлектроннаяПодписьКлиент.ИспользоватьЭлектронныеПодписи();
	Исключение
		// Подсистемы может не быть вовсе - тогда считаем её выключенной
	КонецПопытки;

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ОтчётПоСертификатам(
		Отпечатки, ОшибкаКлиента, ОшибкаСервера, ПодписиВключены));
	ТекстовыйДокумент.Показать(НСтр("ru = 'Сертификаты подписи'"));

КонецПроцедуры

// Собирает отчёт по доступным сертификатам одним вызовом сервера.
//
// Параметры:
//   Отпечатки - Соответствие - ключ отпечаток в Base64, значение источник
//             - Неопределено - хранилище прочитать не удалось
//   ОшибкаКлиента, ОшибкаСервера - Строка - что сказала подсистема подписи
//   ПодписиВключены - Булево - включена ли подсистема электронной подписи
//
// Возвращаемое значение:
//   Строка - текст для показа пользователю
//
&НаСервереБезКонтекста
Функция ОтчётПоСертификатам(Отпечатки, ОшибкаКлиента, ОшибкаСервера, ПодписиВключены)

	Подписант = ЭАрМ_НастройкиСервер.ПодписантСБИС();

	ЧастиОтчёта = Новый Массив;

	Если ЗначениеЗаполнено(Подписант.Отпечаток) Тогда
		ЧастиОтчёта.Добавить(СтрШаблон(
			НСтр("ru = 'Отпечаток из настроек ЭДО: %1'"), Подписант.Отпечаток));
		ЧастиОтчёта.Добавить(СтрШаблон(
			НСтр("ru = 'Он же в Base64, по нему идёт поиск: %1'"),
			ОтпечатокВBase64(Подписант.Отпечаток)));
	Иначе
		ЧастиОтчёта.Добавить(НСтр("ru = 'Отпечаток в настройках ЭДО не заполнен'"));
	КонецЕсли;

	Если ЗначениеЗаполнено(ОшибкаКлиента) Тогда
		ЧастиОтчёта.Добавить("");
		ЧастиОтчёта.Добавить(СтрШаблон(
			НСтр("ru = 'Ошибка чтения на компьютере: %1'"), ОшибкаКлиента));
	КонецЕсли;

	Если ЗначениеЗаполнено(ОшибкаСервера) Тогда
		ЧастиОтчёта.Добавить("");
		ЧастиОтчёта.Добавить(СтрШаблон(
			НСтр("ru = 'Ошибка чтения на сервере: %1'"), ОшибкаСервера));
	КонецЕсли;

	ЧастиОтчёта.Добавить("");
	ЧастиОтчёта.Добавить(СтрШаблон(
		НСтр("ru = 'Подсистема электронной подписи включена: %1'"),
		?(ПодписиВключены, НСтр("ru = 'да'"), НСтр("ru = 'нет'"))));
	ЧастиОтчёта.Добавить("");

	Если ТипЗнч(Отпечатки) <> Тип("Соответствие") ИЛИ Отпечатки.Количество() = 0 Тогда

		Если НЕ ПодписиВключены Тогда
			ЧастиОтчёта.Добавить(НСтр(
				"ru = 'Список пуст, потому что подсистема выключена. Включите её: Администрирование, Общие настройки, Электронная подпись и шифрование.'"));
		Иначе
			ЧастиОтчёта.Добавить(НСтр(
				"ru = 'Сертификатов с закрытым ключом не найдено ни на компьютере, ни на сервере, ни в сервисе.'"));
			ЧастиОтчёта.Добавить("");
			ЧастиОтчёта.Добавить(НСтр(
				"ru = 'Здесь перечислены только сертификаты с закрытым ключом: подписать другими нельзя. Сертификат, добавленный в список 1С, в этот перечень не попадёт, если ключа к нему нет или он установлен под другой учётной записью Windows.'"));
		КонецЕсли;

		Возврат СтрСоединить(ЧастиОтчёта, Символы.ПС);
	КонецЕсли;

	ЧастиОтчёта.Добавить(НСтр("ru = '=== Личные сертификаты ==='"));

	Для Каждого КлючИЗначение Из Отпечатки Цикл
		ЧастиОтчёта.Добавить(СтрШаблон(НСтр("ru = '%1 | Base64: %2 | источник: %3'"),
			ОтпечатокИзBase64(КлючИЗначение.Ключ),
			КлючИЗначение.Ключ,
			Строка(КлючИЗначение.Значение)));
	КонецЦикла;

	Возврат СтрСоединить(ЧастиОтчёта, Символы.ПС);

КонецФункции

// Обратный перевод Base64 в шестнадцатеричный вид - для чтения глазами.
//
&НаСервереБезКонтекста
Функция ОтпечатокИзBase64(ОтпечатокBase64)

	Попытка
		Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(
			Base64Значение(ОтпечатокBase64));
	Исключение
		Возврат НСтр("ru = 'не разобрался'");
	КонецПопытки;

	ЦифрыHex = "0123456789ABCDEF";
	ЧастиОтпечатка = Новый Массив;

	Для Позиция = 0 По Буфер.Размер - 1 Цикл
		Байт = Буфер.Получить(Позиция);
		ЧастиОтпечатка.Добавить(Сред(ЦифрыHex, Цел(Байт / 16) + 1, 1));
		ЧастиОтпечатка.Добавить(Сред(ЦифрыHex, Байт % 16 + 1, 1));
	КонецЦикла;

	Возврат СтрСоединить(ЧастиОтпечатка, "");

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Перестраивает цепочку по выбранному документу: УПД -> её товары ->
// связанная ЭТрН -> приход Далиона. Карточка УПД по клику открывается
// отдельно (СписокВыбор).
//
&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	// Перечит списка (снимок, подпись, сводка) не пересобирает таблицу товаров:
	// иначе она сбрасывалась, пока в ней работали
	Если ИдётПрограммноеОбновлениеСписка = Истина Тогда
		Возврат;
	КонецЕсли;

	ПоследнееДействиеСоСписком = ТекущаяДата();

	// С задержкой: при листании стрелками дерево строится для строки, на
	// которой остановились, а не для каждой промежуточной
	ОтключитьОбработчикОжидания("Подключаемый_ОбновитьЦепочкуПоСтроке");
	ПодключитьОбработчикОжидания("Подключаемый_ОбновитьЦепочкуПоСтроке", 0.3, Истина);

КонецПроцедуры

// Дерево перестраивается, только если выбрана другая УПД. Перечитывание
// списка ту же УПД заново не строит; кнопки формы перестраивают дерево
// сами через ОбновитьЦепочкуДокументов.
//
&НаКлиенте
Процедура Подключаемый_ОбновитьЦепочкуПоСтроке()

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) ИЛИ Идентификатор = ЦепочкаПостроенаДля Тогда
		Возврат;
	КонецЕсли;

	ОбновитьЦепочкуДокументов(Истина);

КонецПроцедуры

// Раз в 5 минут перечитывает товары выбранной УПД. Между этим таблица
// статическая: список реестра её не пересобирает.
//
&НаКлиенте
Процедура Подключаемый_ОбновитьТаблицуТоваров()

	Если НЕ ЗначениеЗаполнено(ИдентификаторТекущейСтроки()) Тогда
		Возврат;
	КонецЕсли;

	ЦепочкаПостроенаДля = Неопределено;
	ОбновитьЦепочкуДокументов();

КонецПроцедуры

// Клик по «К отправке» ставит или снимает утверждение. По остальным колонкам
// карточка УПД открывается поверх списка, не уводя фокус в отдельное окно.
//
&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если Поле = Элементы.КОтправке Тогда

		ДанныеСтроки = Элементы.Список.ДанныеСтроки(ВыбраннаяСтрока);
		Если ДанныеСтроки = Неопределено Тогда
			Возврат;
		КонецЕсли;

		Если ДанныеСтроки.КОтправке Тогда
			Ошибка = СнятьСУтвержденияНаСервере(ДанныеСтроки.ИдентификаторСБИС);
			СообщитьПользователю(?(ЗначениеЗаполнено(Ошибка), Ошибка,
				НСтр("ru = 'УПД снята с утверждения и убрана из очереди'")));
		Иначе
			Идентификаторы = Новый Массив;
			Идентификаторы.Добавить(ДанныеСтроки.ИдентификаторСБИС);
			СообщитьОПостановкеНаУтверждение(ПоставитьНаУтверждениеНаСервере(Идентификаторы));
		КонецЕсли;

		ПеречитатьСписокРеестра();
		Возврат;

	КонецЕсли;

	ОткрытьКарточкуУПДПоверх(ВыбраннаяСтрока);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточкуУПДПоверх(ВыбраннаяСтрока)

	КлючЗаписи = ВыбраннаяСтрока;
	Если ТипЗнч(КлючЗаписи) = Тип("Массив") Тогда
		Если КлючЗаписи.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		КлючЗаписи = КлючЗаписи[0];
	КонецЕсли;

	Если КлючЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОткрытьФорму("РегистрСведений.ЭАрМ_УПД_Входящий.Форма.ФормаЗаписи",
		Новый Структура("Ключ", КлючЗаписи), ЭтотОбъект, Строка(КлючЗаписи), , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// В дереве цепочки редактируется «Пара в приходе» у строки без пары и
// статус в «Расхождении» у товара УПД.
//
&НаКлиенте
Процедура ЦепочкаДокументовПередНачаломИзменения(Элемент, Отказ)

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если Элемент.ТекущийЭлемент = Элементы.ЦепочкаДокументовСвереноВручную Тогда
		Если ТекущиеДанные = Неопределено
			ИЛИ НЕ СтрНачинаетсяС(ТекущиеДанные.Документ, НСтр("ru = 'Товар УПД'")) Тогда
			Отказ = Истина;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Элемент.ТекущийЭлемент = Элементы.ЦепочкаДокументовРасхождение Тогда
		Если ТекущиеДанные = Неопределено
			ИЛИ НЕ СтрНачинаетсяС(ТекущиеДанные.Документ, НСтр("ru = 'Товар УПД'")) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		ТекстРасхожденияДоВыбора = ТекущиеДанные.Расхождение;
		Возврат;
	КонецЕсли;

	// Галочка «Есть в УТ» - ручное решение: менять можно у любой строки товара,
	// и у строки без штрихкода тоже: штрихкод подберётся по паре и регистрам
	Если Элемент.ТекущийЭлемент = Элементы.ЦепочкаДокументовЕстьВУТ Тогда
		Если ТекущиеДанные = Неопределено
			ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.Номенклатура)
			ИЛИ НЕ СтрНачинаетсяС(ТекущиеДанные.Документ, НСтр("ru = 'Товар'")) Тогда
			Отказ = Истина;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// Пара - строке без пары, а строке товара УПД с расхождением - ещё одна пара:
	// так собирается набор (коробка из нескольких товаров прихода). Строке УПД,
	// которой нет в УТ, пару можно выбрать всегда: так ей находится штрихкод Далиона
	Если ТекущиеДанные = Неопределено
		ИЛИ НЕ (ТекущиеДанные.БезПары
			ИЛИ СтрНачинаетсяС(ТекущиеДанные.Документ, НСтр("ru = 'Товар УПД'"))
				И (ТекущиеДанные.Расходится ИЛИ НЕ ТекущиеДанные.ЕстьВУТ)) Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

// Галочка «Проверено» у товара УПД - то же, что статус «Сверено вручную»:
// при установке спрашивается комментарий «почему», при снятии цепочка
// пересверяется. Значение в таблице меняется только после ответа сервера.
//
&НаКлиенте
Процедура ЦепочкаДокументовСвереноВручнуюПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ЦепочкаДокументов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Поставлена = ТекущиеДанные.СвереноВручную;
	ТекущиеДанные.СвереноВручную = НЕ Поставлена;

	Если НЕ ЗначениеЗаполнено(ИдентификаторТекущейСтроки())
		ИЛИ НЕ СтрНачинаетсяС(ТекущиеДанные.Документ, НСтр("ru = 'Товар УПД'"))
		ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.Позиции) Тогда
		СообщитьПользователю(НСтр("ru = 'Галочка ставится на строке товара УПД'"));
		Возврат;
	КонецЕсли;

	ТекстРасхожденияДоВыбора = ТекущиеДанные.Расхождение;
	Данные = Новый Структура("ИдентификаторУПД, Позиции, Наименование, ИдентификаторСтроки",
		ИдентификаторТекущейСтроки(), ТекущиеДанные.Позиции, ТекущиеДанные.Номенклатура,
		ТекущиеДанные.ПолучитьИдентификатор());

	Если НЕ Поставлена Тогда
		СнятьСверкуСтрокиЗавершение(КодВозвратаДиалога.Да, Данные);
		Возврат;
	КонецЕсли;

	Если НЕ ТекущиеДанные.Расходится И НЕ ТекущиеДанные.БезПары
		И НЕ ЗначениеЗаполнено(ТекстРасхожденияДоВыбора) Тогда
		СообщитьПользователю(НСтр("ru = 'Строка и так сверена с приходом'"));
		Возврат;
	КонецЕсли;

	ПоказатьВводСтроки(Новый ОписаниеОповещения("СвереноСтрокаВручнуюКомментарийВведен", ЭтотОбъект, Данные),
		"", СтрШаблон(НСтр("ru = 'Сверено вручную: %1 - почему?'"), ТекущиеДанные.Номенклатура), 300, Истина);

КонецПроцедуры

// Строке УПД выбрали строку прихода Далиона. После подтверждения пара ложится
// в регистр штрихкодов поставщиков (ЭАрМ_СверкаТоваровЦепочки.
// СвязатьСтрокуУПДСПриходом), цепочка пересверяется, дерево перестраивается.
//
&НаКлиенте
Процедура ЦепочкаДокументовПараПриходаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ЦепочкаДокументов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		ИЛИ НЕ (ТекущиеДанные.БезПары ИЛИ ТекущиеДанные.Расходится ИЛИ НЕ ТекущиеДанные.ЕстьВУТ)
		ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.ПараПрихода) Тогда
		Возврат;
	КонецЕсли;

	СтрокаФакта = СтрокаПриходаПоВарианту(ТекущиеДанные.ПараПрихода);
	Если СтрокаФакта = Неопределено Тогда
		ТекущиеДанные.ПараПрихода = "";
		СообщитьПользователю(НСтр("ru = 'Строка прихода не найдена в дереве - обновите цепочку'"));
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СтрокаФакта.ШтрихкодыСтроки)
		И НЕ ЗначениеЗаполнено(ТекущиеДанные.ШтрихкодыСтроки) Тогда
		ТекущиеДанные.ПараПрихода = "";
		СообщитьПользователю(НСтр("ru = 'Ни у строки прихода, ни у строки УПД нет штрихкода - связать по штрихкоду нельзя'"));
		Возврат;
	КонецЕсли;

	// Выбор только запоминается: пары записываются кнопкой «Сохранить пары и
	// создать номенклатуру» - можно выбрать несколько и сохранить разом
	ТекущиеДанные.НоменклатураДалион = СтрокаФакта.Номенклатура;
	ТекущиеДанные.ПараОжидает = Истина;
	СообщитьПользователю(СтрШаблон(НСтр("ru = '«%1» -> «%2»: выбрано. Нажмите «Сохранить пары и создать номенклатуру».'"),
		ТекущиеДанные.Номенклатура, СтрокаФакта.Номенклатура));

КонецПроцедуры

// Записывает выбранные пары, пересверяет цепочку и создаёт в УТ номенклатуру товаров
// прихода, которой там нет: наименование Далиона, вид - в окне, данные - из УПД.
//
&НаКлиенте
Процедура СохранитьПары(Команда)

	Пары = Новый Массив;
	СобратьВыбранныеПары(ЦепочкаДокументов.ПолучитьЭлементы(), Пары);
	Если Пары.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Пары не выбраны: в колонке «Пара в приходе» выберите строку прихода для товара УПД'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Запись пар и пересверка цепочки...'"));
	Итог = СохранитьПарыНаСервере(ИдентификаторТекущейСтроки(), Пары);
	Состояние();

	ЦепочкаПостроенаДля = Неопределено;
	ОбновитьЦепочкуДокументов();
	Элементы.Список.Обновить();

	Если Итог.Товары.Количество() = 0 Тогда
		ПоказатьПредупреждение(, Итог.Текст, , НСтр("ru = 'Пары сохранены'"));
		Возврат;
	КонецЕсли;

	СообщитьПользователю(Итог.Текст);
	ОткрытьФорму("Обработка.ЭАрМ_ПанельУправленияЭДО.Форма.ФормаВыборВидовНоменклатуры",
		Новый Структура("Товары", Итог.Товары), ЭтаФорма, , , ,
		Новый ОписаниеОповещения("СоздатьНоменклатуруПослеПары", ЭтотОбъект, Итог.Товары),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура СобратьВыбранныеПары(Строки, Пары)

	Для Каждого Строка Из Строки Цикл
		Если Строка.ПараОжидает И ЗначениеЗаполнено(Строка.ПараПрихода) Тогда
			СтрокаФакта = СтрокаПриходаПоВарианту(Строка.ПараПрихода);
			Если СтрокаФакта <> Неопределено Тогда
				Пары.Добавить(Новый Структура("СтрокаУПД, СтрокаПрихода",
					Новый Структура("Наименование, КодТовараПоставщика, Штрихкоды, Количество",
						Строка.Номенклатура, Строка.КодПоставщика, Строка.ШтрихкодыСтроки,
						?(ТипЗнч(Строка.Количество) = Тип("Число"), Строка.Количество, 0)),
					Новый Структура("Наименование, Штрихкоды, КлючиНоменклатуры, Количество",
						СтрокаФакта.Номенклатура, СтрокаФакта.ШтрихкодыСтроки, СтрокаФакта.КлючиНоменклатуры,
						СтрокаФакта.Количество)));
			КонецЕсли;
		КонецЕсли;
		СобратьВыбранныеПары(Строка.ПолучитьЭлементы(), Пары);
	КонецЦикла;

КонецПроцедуры

// Возвращаемое значение:
//   Структура - Текст (итог записи пар), Товары (Массив - товары прихода без карточки УТ)
//
&НаСервереБезКонтекста
Функция СохранитьПарыНаСервере(ИдентификаторУПД, Пары)

	Тексты = Новый Массив;
	Товары = Новый Массив;
	Штрихкоды = Новый Соответствие;

	Для Каждого Пара Из Пары Цикл
		Итог = СвязатьПаруПриходаНаСервере(ИдентификаторУПД, Пара.СтрокаУПД, Пара.СтрокаПрихода);
		Тексты.Добавить(Итог.Текст);
		Если НЕ Итог.Успех Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Товар Из ЭАрМ_КатегорииТоваров.ТоварыБезКарточкиУТ(Пара.СтрокаПрихода.Наименование,
			Пара.СтрокаПрихода.Штрихкоды) Цикл
			Если Штрихкоды.Получить(Товар.Штрихкод) = Неопределено Тогда
				Штрихкоды.Вставить(Товар.Штрихкод, Истина);
				Товары.Добавить(Товар);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Новый Структура("Текст, Товары", СтрСоединить(Тексты, Символы.ПС), Товары);

КонецФункции

&НаКлиенте
Процедура СвязатьПаруПриходаЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		СтрокаДерева = ЦепочкаДокументов.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);
		Если СтрокаДерева <> Неопределено Тогда
			СтрокаДерева.ПараПрихода = "";
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Запись пары и пересверка цепочки...'"));
	Итог = СвязатьПаруПриходаНаСервере(ИдентификаторТекущейСтроки(),
		ДополнительныеПараметры.СтрокаУПД, ДополнительныеПараметры.СтрокаПрихода);
	Состояние();

	СообщитьПользователю(Итог.Текст);

	// Дерево - заново, мимо кэша формы; строка списка - по новому итогу
	// сверки («Расхождений нет» в реестре): без обновления списка её цвет
	// оставался прежним до автообновления
	ЦепочкаПостроенаДля = Неопределено;
	ОбновитьЦепочкуДокументов();
	Элементы.Список.Обновить();

	// Пара записана, а товара прихода нет в УТ - создаём номенклатуру: наименование
	// Далиона, вид - в окне, остальное - из документов
	Если Итог.Успех Тогда
		Товары = ТоварыБезКарточкиУТНаСервере(ДополнительныеПараметры.СтрокаПрихода.Наименование,
			ДополнительныеПараметры.СтрокаПрихода.Штрихкоды);
		Если Товары.Количество() > 0 Тогда
			ОткрытьФорму("Обработка.ЭАрМ_ПанельУправленияЭДО.Форма.ФормаВыборВидовНоменклатуры",
				Новый Структура("Товары", Товары), ЭтаФорма, , , ,
				Новый ОписаниеОповещения("СоздатьНоменклатуруПослеПары", ЭтотОбъект, Товары),
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуруПослеПары(ВидыТоваров, Товары) Экспорт

	Если ВидыТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Создание номенклатуры...'"));
	Текст = СоздатьНоменклатуруСВидамиНаСервере(Товары, ВидыТоваров);
	Состояние();
	ПоказатьПредупреждение(, Текст, , НСтр("ru = 'Создание номенклатуры'"));

	// После создания пересверяем цепочку: галочки «Есть в УТ» и цвета строк обновятся
	ЦепочкаПостроенаДля = Неопределено;
	ОбновитьЦепочкуДокументов();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуруУТ(Команда)

	Строки = Новый Массив;
	Выбрано = Ложь;
	Для Каждого Ключ Из Элементы.ЦепочкаДокументов.ВыделенныеСтроки Цикл
		Строка = ЦепочкаДокументов.НайтиПоИдентификатору(Ключ);
		Если Строка <> Неопределено Тогда
			Выбрано = Истина;
		КонецЕсли;
		ДобавитьСтрокуДляСоздания(Строки, Строка);
	КонецЦикла;

	// Ничего не выделено - берём текущую строку товара
	Если Строки.Количество() = 0 Тогда
		ДобавитьСтрокуДляСоздания(Строки, Элементы.ЦепочкаДокументов.ТекущиеДанные);
	КонецЕсли;

	Товары = ТоварыДляСозданияНаСервере(Строки);
	Если Товары.Количество() = 0 Тогда
		Если Выбрано ИЛИ Элементы.ЦепочкаДокументов.ТекущиеДанные <> Неопределено Тогда
			// Возможно, карточка уже создана, а дерево не обновилось - пересверяем
			ЦепочкаПостроенаДля = Неопределено;
			ОбновитьЦепочкуДокументов();
			ПоказатьПредупреждение(, НСтр("ru = 'Номенклатура УТ по выбранной строке уже создана, либо штрихкод не найден ни в строке, ни в паре Далиона, ни в регистрах. Выберите «Пару в приходе» строке. Дерево обновлено.'"));
		Иначе
			ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку товара в таблице товаров УПД'"));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("СоздатьНоменклатуруСвязьВыбрана", ЭтотОбъект, Товары),
		НСтр("ru = 'Связать номенклатуру с поставщиком (запись в «Номенклатуру контрагентов»)?
		|«Нет» - только карточка УТ со штрихкодом.'"),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);

КонецПроцедуры

// Строка товара для создания: пропускает, если уже есть в УТ, нет штрихкода или
// это не строка товара (шапка документа).
&НаКлиенте
Процедура ДобавитьСтрокуДляСоздания(Строки, Строка)

	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Строка.ЕстьВУТ Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
		Возврат;
	КонецЕсли;

	// Наименование - Далиона, если пара выбрана (так создаёт и «Сохранить пары»)
	Наименование = Строка.Номенклатура;
	Штрихкоды = Строка.ШтрихкодыСтроки;
	Если НЕ ЗначениеЗаполнено(Штрихкоды) Тогда
		// Штрихкода в строке нет: берём у пары Далиона, затем из регистров
		// «Пары номенклатуры по имени» и «Очередь создания номенклатуры»
		СтрокаПрихода = ?(ЗначениеЗаполнено(Строка.ПараПрихода),
			СтрокаПриходаПоВарианту(Строка.ПараПрихода), Неопределено);
		Если СтрокаПрихода = Неопределено И ЗначениеЗаполнено(Строка.ИндексПрихода) Тогда
			Индекс = Число(Строка.ИндексПрихода);
			Если Индекс >= 0 И Индекс < ПриходДалиона.Количество() Тогда
				СтрокаПрихода = Новый Структура("Номенклатура, ШтрихкодыСтроки",
					ПриходДалиона[Индекс].Номенклатура, ПриходДалиона[Индекс].ШтрихкодыСтроки);
			КонецЕсли;
		КонецЕсли;
		Если СтрокаПрихода <> Неопределено И ЗначениеЗаполнено(СтрокаПрихода.ШтрихкодыСтроки) Тогда
			Штрихкоды = СтрокаПрихода.ШтрихкодыСтроки;
			Наименование = СтрокаПрихода.Номенклатура;
		Иначе
			Штрихкоды = ШтрихкодПоИмениИзРегистров(Строка.Номенклатура);
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Штрихкоды) Тогда
		Возврат;
	КонецЕсли;
	Строки.Добавить(Новый Структура("Наименование, Штрихкоды", Наименование, Штрихкоды));

КонецПроцедуры

// Штрихкод товара без штрихкода в УПД по именам, которые уже запомнил обмен:
// «Пары номенклатуры по имени» (наименование УПД -> Далион) и очередь создания
// номенклатуры (данные Далиона).
//
&НаСервереБезКонтекста
Функция ШтрихкодПоИмениИзРегистров(Наименование)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", СокрЛП(Наименование));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пары.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПарыНоменклатурыПоИмени КАК Пары
	|ГДЕ
	|	Пары.НаименованиеЭДО = &Наименование
	|	И Пары.Штрихкод <> """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Очередь.Штрихкод
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОчередьСозданияНоменклатуры КАК Очередь
	|ГДЕ
	|	Очередь.НаименованиеДалион = &Наименование
	|	И Очередь.Штрихкод <> """"";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.Штрихкод);
	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиенте
Процедура СоздатьНоменклатуруСвязьВыбрана(Ответ, Товары) Экспорт

	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	Связывать = (Ответ = КодВозвратаДиалога.Да);
	Для Каждого Товар Из Товары Цикл
		Товар.Вставить("СвязыватьСПоставщиком", Связывать);
	КонецЦикла;

	ОткрытьФорму("Обработка.ЭАрМ_ПанельУправленияЭДО.Форма.ФормаВыборВидовНоменклатуры",
		Новый Структура("Товары", Товары), ЭтаФорма, , , ,
		Новый ОписаниеОповещения("СоздатьНоменклатуруВидыВыбраны", ЭтотОбъект, Товары),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуруВидыВыбраны(ВидыТоваров, Товары) Экспорт

	Если ВидыТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Создание номенклатуры...'"));
	Текст = СоздатьНоменклатуруСВидамиНаСервере(Товары, ВидыТоваров);
	Состояние();
	ПоказатьПредупреждение(, Текст, , НСтр("ru = 'Создание номенклатуры'"));

	ЦепочкаПостроенаДля = Неопределено;
	ОбновитьЦепочкуДокументов();
	Элементы.Список.Обновить();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТоварыДляСозданияНаСервере(Строки)

	Товары = Новый Массив;
	Штрихкоды = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Для Каждого Товар Из ЭАрМ_КатегорииТоваров.ТоварыБезКарточкиУТ(Строка.Наименование, Строка.Штрихкоды) Цикл
			Если Штрихкоды.Получить(Товар.Штрихкод) = Неопределено Тогда
				Штрихкоды.Вставить(Товар.Штрихкод, Истина);
				Товары.Добавить(Товар);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Товары;

КонецФункции

