КонецПроцедуры

#КонецОбласти

#Область ПроверкаЭП

// Проверка электронной подписи без отправки: настройки подписанта,
// сертификат в личном хранилище, срок действия, ИНН владельца, программа
// криптографии, тестовая подпись и её проверка, можно ли отправлять текущую
// УПД. Подписывается тестовая строка, а не документ; в СБИС ничего не уходит.
// Итог - окно с отчётом по пунктам.
//
&НаКлиенте
Процедура ПроверитьЭП(Команда)

	// Подписантов может быть два - проверяем того, кого выберут
	ЭАрМ_ПанельУправленияЭДОКлиент.ВыбратьПодписанта(
		Новый ОписаниеОповещения("ПроверкаЭППодписантВыбран", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаЭППодписантВыбран(НомерПодписанта, ДополнительныеПараметры) Экспорт

	Если НомерПодписанта = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторУПД = ИдентификаторТекущейСтроки();

	Состояние(НСтр("ru = 'Проверка ЭП: настройки подписанта...'"));
	Данные = ДанныеПроверкиЭПНаСервере(ИдентификаторУПД, НомерПодписанта);
	Состояние();

	ПроверкаЭП = Новый Структура;
	ПроверкаЭП.Вставить("Строки", Новый Массив);
	ПроверкаЭП.Вставить("Ошибок", 0);
	ПроверкаЭП.Вставить("Данные", Данные);

	ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'Проверка электронной подписи, подписант %1'"), НомерПодписанта)
		+ " - " + Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДЛФ=DT"), Неопределено);
	ДобавитьСтрокуПроверкиЭП("", Неопределено);

	Подписант = Данные.Подписант;
	ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'Отпечаток в настройках: %1'"),
		?(ЗначениеЗаполнено(Подписант.Отпечаток), Подписант.Отпечаток, НСтр("ru = 'не заполнен'"))),
		ЗначениеЗаполнено(Подписант.Отпечаток));
	ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'ФИО подписанта: %1'"),
		?(ЗначениеЗаполнено(Подписант.ФИО), Подписант.ФИО, НСтр("ru = 'не заполнено'"))),
		ЗначениеЗаполнено(Подписант.ФИО));
	ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'ИНН подписанта: %1'"),
		?(ЗначениеЗаполнено(Подписант.ИНН), Подписант.ИНН, НСтр("ru = 'не заполнен'"))),
		ЗначениеЗаполнено(Подписант.ИНН));
	Если ЗначениеЗаполнено(Подписант.Должность) Тогда
		ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'Должность: %1'"), Подписант.Должность), Неопределено);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Данные.ОтпечатокBase64) Тогда
		ДобавитьСтрокуПроверкиЭП(НСтр("ru = 'Отпечаток не распознан: нужен шестнадцатеричный, только цифры и A-F'"), Ложь);
		ПоказатьОтчётПроверкиЭП();
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Проверка ЭП: поиск сертификата...'"));
	Попытка
		ЭлектроннаяПодписьКлиент.ПолучитьСертификатПоОтпечатку(
			Новый ОписаниеОповещения("ПроверкаЭПСертификатПолучен", ЭтотОбъект),
			Данные.ОтпечатокBase64, Истина);
	Исключение
		ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'Хранилище сертификатов не прочитано: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())), Ложь);
		ПоказатьОтчётПроверкиЭП();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаЭПСертификатПолучен(Сертификат, ДополнительныеПараметры) Экспорт

	Состояние();

	Если ТипЗнч(Сертификат) <> Тип("СертификатКриптографии") Тогда
		ДобавитьСтрокуПроверкиЭП(НСтр("ru = 'Сертификат с этим отпечатком не найден в личном хранилище этого компьютера'")
			+ ?(ТипЗнч(Сертификат) = Тип("Строка") И ЗначениеЗаполнено(Сертификат), ": " + Сертификат, ""), Ложь);
		ДобавитьСтрокуПроверкиЭП(НСтр("ru = 'Список сертификатов компьютера - кнопка «Сертификаты подписи»'"), Неопределено);
		ПоказатьОтчётПроверкиЭП();
		Возврат;
	КонецЕсли;

	ПроверкаЭП.Вставить("Сертификат", Сертификат);

	ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'Сертификат найден: %1'"),
		ВладелецСертификата(Сертификат)), Истина);
	ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'Издатель: %1'"),
		ИмяИзОписания(Сертификат.Издатель)), Неопределено);
	ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'Действует: с %1 по %2'"),
		Формат(Сертификат.ДатаНачала, "ДЛФ=D"), Формат(Сертификат.ДатаОкончания, "ДЛФ=D")), Неопределено);

	ТекстСрока = ОшибкаСрокаСертификата(Сертификат);
	Если ЗначениеЗаполнено(ТекстСрока) Тогда
		ДобавитьСтрокуПроверкиЭП(ТекстСрока, Ложь);
	Иначе
		ДнейОсталось = Цел((Сертификат.ДатаОкончания - ОбщегоНазначенияКлиент.ДатаСеанса()) / 86400);
		Если ДнейОсталось < 14 Тогда
			ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'Сертификат действует, но осталось дней: %1 - закажите новый'"),
				ДнейОсталось), Неопределено);
		Иначе
			ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'Срок действия в порядке, осталось дней: %1'"),
				ДнейОсталось), Истина);
		КонецЕсли;
	КонецЕсли;

	ИННСертификата = ИННВладельцаСертификата(Сертификат);
	ИНННастроек = ПроверкаЭП.Данные.Подписант.ИНН;
	Если ЗначениеЗаполнено(ИННСертификата) И ЗначениеЗаполнено(ИНННастроек) Тогда
		Совпадает = СтрНайти(ИННСертификата, ИНННастроек) > 0;
		ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'ИНН в сертификате: %1 - %2'"), ИННСертификата,
			?(Совпадает, НСтр("ru = 'совпадает с настройками'"),
				НСтр("ru = 'НЕ совпадает с ИНН подписанта в настройках'"))), Совпадает);
	КонецЕсли;

	Состояние(НСтр("ru = 'Проверка ЭП: программа криптографии...'"));
	ЭлектроннаяПодписьКлиент.СоздатьМенеджерКриптографии(
		Новый ОписаниеОповещения("ПроверкаЭПМенеджерПолучен", ЭтотОбъект),
		"Подписание", Ложь, Сертификат.Выгрузить());

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаЭПМенеджерПолучен(МенеджерКриптографии, ДополнительныеПараметры) Экспорт

	Состояние();

	Если ТипЗнч(МенеджерКриптографии) <> Тип("МенеджерКриптографии") Тогда
		ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'Программа криптографии для сертификата не запустилась: %1'"),
			?(ТипЗнч(МенеджерКриптографии) = Тип("Строка"), МенеджерКриптографии,
				НСтр("ru = 'проверьте, установлен ли КриптоПро CSP'"))), Ложь);
		ПоказатьОтчётПроверкиЭП();
		Возврат;
	КонецЕсли;

	ДобавитьСтрокуПроверкиЭП(НСтр("ru = 'Программа криптографии работает'"), Истина);

	ПроверкаЭП.Вставить("Менеджер", МенеджерКриптографии);
	ПроверкаЭП.Вставить("ТестовыеДанные", ПолучитьДвоичныеДанныеИзСтроки(
		"Проверка ЭП АРМ ЭДО " + Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=yyyyMMddHHmmss")));

	Состояние(НСтр("ru = 'Проверка ЭП: тестовая подпись...'"));
	МенеджерКриптографии.НачатьПодписывание(
		Новый ОписаниеОповещения("ПроверкаЭППодписано", ЭтотОбъект, ,
			"ПроверкаЭПОшибкаПодписи", ЭтотОбъект),
		ПроверкаЭП.ТестовыеДанные, ПроверкаЭП.Сертификат);

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаЭППодписано(Подпись, ДополнительныеПараметры) Экспорт

	Состояние();

	Если ТипЗнч(Подпись) <> Тип("ДвоичныеДанные") Тогда
		ДобавитьСтрокуПроверкиЭП(НСтр("ru = 'Тестовая подпись не получена (подписание отменено?)'"), Ложь);
		ПоказатьОтчётПроверкиЭП();
		Возврат;
	КонецЕсли;

	ДобавитьСтрокуПроверкиЭП(НСтр("ru = 'Тестовая подпись создана'"), Истина);

	Состояние(НСтр("ru = 'Проверка ЭП: проверка подписи...'"));
	ПроверкаЭП.Менеджер.НачатьПроверкуПодписи(
		Новый ОписаниеОповещения("ПроверкаЭППодписьВерна", ЭтотОбъект, ,
			"ПроверкаЭППодписьНеВерна", ЭтотОбъект),
		ПроверкаЭП.ТестовыеДанные, Подпись);

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаЭПОшибкаПодписи(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	СтандартнаяОбработка = Ложь;
	Состояние();
	ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'Подписать не удалось: %1'"),
		КраткоеПредставлениеОшибки(ИнформацияОбОшибке)), Ложь);
	ПоказатьОтчётПроверкиЭП();

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаЭППодписьВерна(СертификатПодписи, ДополнительныеПараметры) Экспорт

	Состояние();
	ДобавитьСтрокуПроверкиЭП(НСтр("ru = 'Подпись проверена - верна'"), Истина);
	ПоказатьОтчётПроверкиЭП();

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаЭППодписьНеВерна(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	СтандартнаяОбработка = Ложь;
	Состояние();
	ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'Подпись не прошла проверку: %1'"),
		КраткоеПредставлениеОшибки(ИнформацияОбОшибке)), Ложь);
	ПоказатьОтчётПроверкиЭП();

КонецПроцедуры

// Строка отчёта: Истина - «[OK]», Ложь - «[ОШИБКА]», Неопределено - без отметки.
//
&НаКлиенте
Процедура ДобавитьСтрокуПроверкиЭП(Текст, Успех)

	Если Успех = Истина Тогда
		Отметка = "[OK]      ";
	ИначеЕсли Успех = Ложь Тогда
		Отметка = "[ОШИБКА]  ";
		ПроверкаЭП.Ошибок = ПроверкаЭП.Ошибок + 1;
	Иначе
		Отметка = ?(ЗначениеЗаполнено(Текст), "          ", "");
	КонецЕсли;

	ПроверкаЭП.Строки.Добавить(Отметка + Текст);

КонецПроцедуры

// Добавляет проверку текущей УПД и СБИС и показывает окно с отчётом.
//
&НаКлиенте
Процедура ПоказатьОтчётПроверкиЭП()

	Состояние();

	Данные = ПроверкаЭП.Данные;
	ДобавитьСтрокуПроверкиЭП("", Неопределено);
	Если ЗначениеЗаполнено(Данные.НомерУПД) Тогда
		ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'Текущая УПД № %1:'"), Данные.НомерУПД), Неопределено);
		Если ЗначениеЗаполнено(Данные.ЗапретУПД) Тогда
			ДобавитьСтрокуПроверкиЭП(Данные.ЗапретУПД, Ложь);
		Иначе
			ДобавитьСтрокуПроверкиЭП(НСтр("ru = 'УПД можно отправлять: сверка, «К отправке» и итоговая сумма в порядке'"), Истина);
		КонецЕсли;
	КонецЕсли;

	ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'Авторизация в СБИС: %1'"),
		?(Данные.СессияСБИС, НСтр("ru = 'есть'"), НСтр("ru = 'не удалась'"))), Данные.СессияСБИС);

	ДобавитьСтрокуПроверкиЭП("", Неопределено);
	Если ПроверкаЭП.Ошибок = 0 Тогда
		ДобавитьСтрокуПроверкиЭП(НСтр("ru = 'ИТОГ: всё в порядке, подписывать и отправлять можно'"), Неопределено);
	Иначе
		ДобавитьСтрокуПроверкиЭП(СтрШаблон(НСтр("ru = 'ИТОГ: ошибок %1 - исправьте их до отправки'"),
			ПроверкаЭП.Ошибок), Неопределено);
	КонецЕсли;

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(СтрСоединить(ПроверкаЭП.Строки, Символы.ПС));
	ТекстовыйДокумент.Показать(НСтр("ru = 'Проверка электронной подписи'"));

	ПроверкаЭП = Неопределено;

КонецПроцедуры

// ИНН владельца из субъекта сертификата.
//
&НаКлиенте
Функция ИННВладельцаСертификата(Сертификат)

	Субъект = Сертификат.Субъект;
	Если ТипЗнч(Субъект) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого Имя Из СтрРазделить("ИНН,INN,ИННЮЛ,INNLE", ",") Цикл
		Если Субъект.Свойство(Имя) И ЗначениеЗаполнено(Субъект[Имя]) Тогда
			Возврат СокрЛП(Субъект[Имя]);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// CN из описания субъекта или издателя сертификата.
//
&НаКлиенте
Функция ИмяИзОписания(Описание)

	Если ТипЗнч(Описание) = Тип("Структура") И Описание.Свойство("CN") Тогда
		Возврат Описание.CN;
	КонецЕсли;

	Возврат НСтр("ru = 'не указан'");

КонецФункции

&НаСервереБезКонтекста
Функция ДанныеПроверкиЭПНаСервере(ИдентификаторУПД, НомерПодписанта = 1)

	Результат = Новый Структура("Подписант, ОтпечатокBase64, НомерУПД, ЗапретУПД, СессияСБИС",
		ЭАрМ_НастройкиСервер.ПодписантСБИС(НомерПодписанта), "", "", "", Ложь);

	Если ЗначениеЗаполнено(Результат.Подписант.Отпечаток) Тогда
		Результат.ОтпечатокBase64 = ЭАрМ_УтверждениеСБИС.ОтпечатокВBase64(Результат.Подписант.Отпечаток);
	КонецЕсли;

	Попытка
		Результат.СессияСБИС = ЗначениеЗаполнено(ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию());
	Исключение
		Результат.СессияСБИС = Ложь;
	КонецПопытки;

	Если ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторУПД;
		МенеджерЗаписи.Прочитать();
		Результат.НомерУПД = ?(МенеджерЗаписи.Выбран(), МенеджерЗаписи.Номер, ИдентификаторУПД);
		Попытка
			Результат.ЗапретУПД = ЭАрМ_УтверждениеСБИС.ЗапретУтверждения("УПД", ИдентификаторУПД);
		Исключение
			Результат.ЗапретУПД = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Подписанты

// Все данные подписантов ЭДО в одном окне: что записано в настройках
// (ФИО, ИНН, должность, отпечаток) и что о сертификате знает этот компьютер
// (найден ли в личном хранилище, владелец, издатель, срок, ИНН в сертификате).
// Ничего не подписывает и в СБИС не ходит.
//
&НаКлиенте
Процедура ПоказатьПодписантов(Команда)

	ОбзорПодписантов = Новый Структура;
	ОбзорПодписантов.Вставить("Подписанты", ПодписантыДляОбзораНаСервере());
	ОбзорПодписантов.Вставить("Индекс", 0);
	ОбзорПодписантов.Вставить("Строки", Новый Массив);

	ОбзорПодписантов.Строки.Добавить(НСтр("ru = 'Подписанты ЭДО'") + " - "
		+ Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДЛФ=DT"));

	Если ОбзорПодписантов.Подписанты.Количество() = 0 Тогда
		ОбзорПодписантов.Строки.Добавить("");
		ОбзорПодписантов.Строки.Добавить(НСтр("ru = 'В настройках ЭДО не заполнен ни один подписант (Настройки СБИС и обмена -> Подписант, Подписант 2).'"));
		ПоказатьОбзорПодписантов();
		Возврат;
	КонецЕсли;

	ОбзорСледующегоПодписанта();

КонецПроцедуры

&НаКлиенте
Процедура ОбзорСледующегоПодписанта()

	Если ОбзорПодписантов.Индекс >= ОбзорПодписантов.Подписанты.Количество() Тогда
		ПоказатьОбзорПодписантов();
		Возврат;
	КонецЕсли;

	Подписант = ОбзорПодписантов.Подписанты[ОбзорПодписантов.Индекс];
	Строки = ОбзорПодписантов.Строки;

	Строки.Добавить("");
	Строки.Добавить(СтрШаблон(НСтр("ru = '=== Подписант %1 ==='"), Подписант.Номер));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'ФИО:        %1'"), ?(ЗначениеЗаполнено(Подписант.ФИО), Подписант.ФИО, НСтр("ru = 'не заполнено'"))));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'ИНН:        %1'"), ?(ЗначениеЗаполнено(Подписант.ИНН), Подписант.ИНН, НСтр("ru = 'не заполнен'"))));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Должность:  %1'"), ?(ЗначениеЗаполнено(Подписант.Должность), Подписант.Должность, НСтр("ru = 'не заполнена'"))));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Отпечаток:  %1'"), ?(ЗначениеЗаполнено(Подписант.Отпечаток), Подписант.Отпечаток, НСтр("ru = 'не заполнен'"))));

	Если НЕ ЗначениеЗаполнено(Подписант.ОтпечатокBase64) Тогда
		Строки.Добавить(НСтр("ru = 'Сертификат: не искали - отпечаток пустой или не шестнадцатеричный'"));
		ОбзорПодписантов.Индекс = ОбзорПодписантов.Индекс + 1;
		ОбзорСледующегоПодписанта();
		Возврат;
	КонецЕсли;

	Состояние(СтрШаблон(НСтр("ru = 'Поиск сертификата подписанта %1...'"), Подписант.Номер));
	Попытка
		ЭлектроннаяПодписьКлиент.ПолучитьСертификатПоОтпечатку(
			Новый ОписаниеОповещения("ОбзорПодписантаСертификатПолучен", ЭтотОбъект),
			Подписант.ОтпечатокBase64, Истина);
	Исключение
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Сертификат: хранилище не прочитано - %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		ОбзорПодписантов.Индекс = ОбзорПодписантов.Индекс + 1;
		ОбзорСледующегоПодписанта();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОбзорПодписантаСертификатПолучен(Сертификат, ДополнительныеПараметры) Экспорт

	Состояние();

	Подписант = ОбзорПодписантов.Подписанты[ОбзорПодписантов.Индекс];
	Строки = ОбзорПодписантов.Строки;

	Если ТипЗнч(Сертификат) <> Тип("СертификатКриптографии") Тогда
		Строки.Добавить(НСтр("ru = 'Сертификат: НЕ найден в личном хранилище этого компьютера'"));
	Иначе
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Сертификат: найден, владелец %1'"), ВладелецСертификата(Сертификат)));
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Издатель:   %1'"), ИмяИзОписания(Сертификат.Издатель)));
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Действует:  с %1 по %2'"),
			Формат(Сертификат.ДатаНачала, "ДЛФ=D"), Формат(Сертификат.ДатаОкончания, "ДЛФ=D")));

		ТекстСрока = ОшибкаСрокаСертификата(Сертификат);
		Если ЗначениеЗаполнено(ТекстСрока) Тогда
			Строки.Добавить("!!! " + ТекстСрока);
		Иначе
			Строки.Добавить(СтрШаблон(НСтр("ru = 'Осталось дней: %1'"),
				Цел((Сертификат.ДатаОкончания - ОбщегоНазначенияКлиент.ДатаСеанса()) / 86400)));
		КонецЕсли;

		ИННСертификата = ИННВладельцаСертификата(Сертификат);
		Если ЗначениеЗаполнено(ИННСертификата) Тогда
			Строки.Добавить(СтрШаблон(НСтр("ru = 'ИНН в сертификате: %1%2'"), ИННСертификата,
				?(ЗначениеЗаполнено(Подписант.ИНН) И СтрНайти(ИННСертификата, Подписант.ИНН) = 0,
					НСтр("ru = ' - НЕ совпадает с ИНН в настройках'"), "")));
		КонецЕсли;

		Строки.Добавить(СтрШаблон(НСтр("ru = 'Серийный номер: %1'"), ПолучитьHexСтрокуИзДвоичныхДанных(Сертификат.СерийныйНомер)));
	КонецЕсли;

	ОбзорПодписантов.Индекс = ОбзорПодписантов.Индекс + 1;
	ОбзорСледующегоПодписанта();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОбзорПодписантов()

	Состояние();

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(СтрСоединить(ОбзорПодписантов.Строки, Символы.ПС));
	ТекстовыйДокумент.Показать(НСтр("ru = 'Подписанты ЭДО'"));

	ОбзорПодписантов = Неопределено;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодписантыДляОбзораНаСервере()

	Подписанты = ЭАрМ_НастройкиСервер.ПодписантыСБИС();
	Для Каждого Подписант Из Подписанты Цикл
		Подписант.Вставить("ОтпечатокBase64", ?(ЗначениеЗаполнено(Подписант.Отпечаток),
			ЭАрМ_УтверждениеСБИС.ОтпечатокВBase64(Подписант.Отпечаток), ""));
	КонецЦикла;

	Возврат Подписанты;

КонецФункции

#КонецОбласти

#Область Замеры

&НаСервереБезКонтекста
Процедура ЗаписатьЗамерКликаНаСервере(Идентификатор, Мс, ДогружатьТовары)

	ЭАрМ_Служебный.ЗаписатьСтрокуЗамера("ВыборУПД", Идентификатор, "ИТОГО клик (клиент)", Мс,
		?(ДогружатьТовары, "первый выбор в сеансе", "повторный выбор"));

КонецПроцедуры

#КонецОбласти

#Область УтверждениеВОчередь

// Ставит выделенные УПД в очередь ЭАрМ_ОжидаемыеПодтвержденияЭДО с отметкой
// «Отправить» и флажком «К отправке» в реестре. Вместе с УПД встают её УКД,
// у которых уже «Расхождений нет» (в том числе после «Сверилось вручную»).
// В СБИС ничего не уходит: подписывает очередь. УПД без «Расхождений нет»
// или с разной итоговой суммой в очередь не встаёт - причина выводится сообщением.
//
&НаКлиенте
Процедура УтвердитьВОчередь(Команда)

	Идентификаторы = ВыделенныеИдентификаторы();
	Если Идентификаторы.Количество() = 0 Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите УПД в списке'"));
		Возврат;
	КонецЕсли;

	СообщитьОПостановкеНаУтверждение(ПоставитьНаУтверждениеНаСервере(Идентификаторы));

	ПеречитатьСписокРеестра();

КонецПроцедуры

&НаКлиенте
Функция ВыделенныеИдентификаторы()

	Результат = Новый Массив;

	Для Каждого ВыделеннаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(ВыделеннаяСтрока);
		Если ДанныеСтроки <> Неопределено
			И ЗначениеЗаполнено(ДанныеСтроки.ИдентификаторСБИС) Тогда
			Результат.Добавить(ДанныеСтроки.ИдентификаторСБИС);
		КонецЕсли;
	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Идентификатор = ИдентификаторТекущейСтроки();
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Результат.Добавить(Идентификатор);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура СообщитьОПостановкеНаУтверждение(Итог)

	Если Итог.Поставлено > 0 Тогда
		СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Поставлено на утверждение: %1. Подпишите в очереди «Ожидаемые подтверждения ЭДО».'"),
			Итог.Поставлено));
	КонецЕсли;

	Для Каждого Ошибка Из Итог.Ошибки Цикл
		СообщитьПользователю(Ошибка);
	КонецЦикла;

КонецПроцедуры

