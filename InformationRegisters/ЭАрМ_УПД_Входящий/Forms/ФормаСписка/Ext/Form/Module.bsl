КонецФункции

// Строка прихода Далиона по тексту варианта из списка выбора. Берётся из
// запомненных строк прихода: в плоской таблице часть из них уже стоит в
// строке УПД.
//
&НаКлиенте
Функция СтрокаПриходаПоВарианту(Вариант)

	Найденные = ПриходДалиона.НайтиСтроки(Новый Структура("Вариант", Вариант));
	Если Найденные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Номенклатура, ШтрихкодыСтроки, КлючиНоменклатуры, Количество",
		Найденные[0].Номенклатура, Найденные[0].ШтрихкодыСтроки, Найденные[0].КлючиНоменклатуры,
		Найденные[0].Количество);

КонецФункции

&НаСервереБезКонтекста
Функция СвязатьПаруПриходаНаСервере(ИдентификаторУПД, СтрокаУПД, СтрокаПрихода)

	ИННПоставщика = "";
	Поставщик = "";

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторУПД;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		ИННПоставщика = МенеджерЗаписи.ИННКонтрагента;
		Поставщик = МенеджерЗаписи.Контрагент;
	КонецЕсли;

	Цепочка = ЭАрМ_ЦепочкаЗакупки.ЦепочкаПоУПД(ИдентификаторУПД);
	Если Цепочка <> Неопределено И ЗначениеЗаполнено(Цепочка.ИННПоставщика) Тогда
		ИННПоставщика = Цепочка.ИННПоставщика;
	КонецЕсли;

	Возврат ЭАрМ_СверкаТоваровЦепочки.СвязатьСтрокуУПДСПриходом(
		ИдентификаторУПД, СтрокаУПД, СтрокаПрихода, ИННПоставщика, Поставщик);

КонецФункции

#КонецОбласти

#Область Настройки

// Настройки СБИС и обмена - та же форма, что в реестре ЭТрН и панели ЭДО:
