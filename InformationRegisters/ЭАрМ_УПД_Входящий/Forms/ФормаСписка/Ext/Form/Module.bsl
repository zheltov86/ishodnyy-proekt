// Перечисляет доступные этапы документа и действия на них.
//
// Из этого списка пользователь выбирает, что подготавливать. У действия
// показываются признаки, которые меняют состав запроса: требуется ли подпись,
// комментарий и исполнитель. Отклонение, например, без комментария не пройдёт.
//
&НаСервереБезКонтекста
Функция ЭтапыИДействияДляДиагностики(ДокументСБИС)

	Строки = Новый Массив;

	СостояниеДокумента = ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Состояние");
	Если СостояниеДокумента <> Неопределено Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Состояние документа: %1'"),
			ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(СостояниеДокумента, "Название", "-"))));
	КонецЕсли;

	Для Каждого ОписаниеЭтапа Из ЭАрМ_Служебный.ЗначениеВМассив(
		ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Этап")) Цикл

		Строки.Добавить(СтрШаблон(НСтр("ru = 'Этап: %1 [%2]'"),
			ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеЭтапа, "Название", "-")),
			ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеЭтапа, "Идентификатор", "-"))));

		Для Каждого ОписаниеДействия Из ЭАрМ_Служебный.ЗначениеВМассив(
			ЭАрМ_Служебный.ЗначениеУзла(ОписаниеЭтапа, "Действие")) Цикл

			Строки.Добавить(СтрШаблон(
				НСтр("ru = '    %1 | подпись: %2 (%3) | комментарий: %4 | исполнитель: %5'"),
				ЭАрМ_Служебный.СтрокойИлиПусто(
					ЭАрМ_Служебный.ЗначениеУзла(ОписаниеДействия, "Название", "-")),
				ЭАрМ_Служебный.СтрокойИлиПусто(
					ЭАрМ_Служебный.ЗначениеУзла(ОписаниеДействия, "ТребуетПодписания", "-")),
				ЭАрМ_Служебный.СтрокойИлиПусто(
					ЭАрМ_Служебный.ЗначениеУзла(ОписаниеДействия, "ТипПодписи", "-")),
				ЭАрМ_Служебный.СтрокойИлиПусто(
					ЭАрМ_Служебный.ЗначениеУзла(ОписаниеДействия, "ТребуетКомментария", "-")),
				ЭАрМ_Служебный.СтрокойИлиПусто(
					ЭАрМ_Служебный.ЗначениеУзла(ОписаниеДействия, "ТребуетИсполнителя", "-"))));

		КонецЦикла;

	КонецЦикла;

	Если Строки.Количество() < 2 Тогда
		Строки.Добавить(НСтр(
			"ru = 'Доступных этапов нет: документ уже отработан или ждёт не нас'"));
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Инвалидирует кэш статистики и перечитывает список.
// Таблицу товаров не трогает: она снимок и обновляется раз в 5 минут,
// либо сразу - если команда передала ОбновлятьТовары (загрузка УПД, приход).
//
&НаКлиенте
Процедура ОбновитьСписокИЦепочку(ОбновлятьТовары = Ложь)

	ПоследнийСнимок = "";
	КэшСтатистикиВремя = Неопределено;
	ПеречитатьСписокРеестра();
	Если ОбновлятьТовары = Истина Тогда
		ЦепочкаПостроенаДля = Неопределено;
		ОбновитьЦепочкуДокументов();
	КонецЕсли;
	ОбновитьСтатистикуУПД();

	// Монитор ЭДО и другие открытые формы сеанса - сразу, не ждать таймера
	Оповестить("ЭАрМ_УПД_Обновление", Неопределено, ЭтотОбъект);

КонецПроцедуры

// Реестр изменила другая форма этого сеанса (очередь подтверждений, реестр
// ЭТрН, монитор): перечитывается список. Таблица товаров остаётся как есть
// до пятиминутного обновления.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия <> "ЭАрМ_УПД_Обновление" ИЛИ Источник = ЭтотОбъект Тогда
		Возврат;
	КонецЕсли;

	ПоследнийСнимок = "";
	КэшСтатистикиВремя = Неопределено;
	ЗапланироватьОбновлениеСписка();

КонецПроцедуры

// Перечитывает дерево и итоги по текущей строке списка.
//
// Параметры:
//   ИзКэша - Булево - Истина только при переходе по строкам: дерево берётся из
//            кэша формы, если данные УПД не изменились. Кнопки и догрузка
//            товаров строят дерево заново (Ложь, по умолчанию).
//
&НаКлиенте
Процедура ОбновитьЦепочкуДокументов(ИзКэша = Ложь)

	Идентификатор = ИдентификаторТекущейСтроки();

	Если ЗапрошенныеТоварыУПД = Неопределено Тогда
		ЗапрошенныеТоварыУПД = Новый Соответствие;
	КонецЕсли;

	// Товары одного документа спрашиваем у СБИС один раз за сеанс: активизация
	// строки срабатывает и при переборе списка стрелками, а документ, которого
	// в СБИС нет, иначе будет запрашиваться бесконечно.
	ДогружатьТовары = ЗначениеЗаполнено(Идентификатор)
		И ЗапрошенныеТоварыУПД.Получить(Идентификатор) = Неопределено;

	Если ДогружатьТовары Тогда
		ЗапрошенныеТоварыУПД.Вставить(Идентификатор, Истина);
	КонецЕсли;

	ЦепочкаПостроенаДля = Идентификатор;

	// Дерево строится сразу из того, что уже есть в базе: в СБИС щелчок по
	// строке больше не ходит. Чего не хватает (товаров УПД, груза ЭТрН),
	// догружает фоновое задание, и дерево перестраивается по его окончании.
	// Раньше на каждый такой щелчок форма стояла, пока ответит СБИС.
	Догрузка = Новый Структура("НетТоваровУПД, ИдентификаторЭТрН, Номер", Ложь, "", "");

	НачалоКлика = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если АдресКэшаЦепочек = Неопределено Тогда
		АдресКэшаЦепочек = "";
	КонецЕсли;
	ДанныеЦепочки = ЗаполнитьЦепочкуДокументовНаСервере(Идентификатор, Ложь,
		АдресКэшаЦепочек, ИзКэша, УникальныйИдентификатор);
	ПрименитьДеревоЦепочки(ДанныеЦепочки);
	АдресКэшаЦепочек = ДанныеЦепочки.АдресКэша;
	Догрузка = ДанныеЦепочки.Догрузка;

	// Дерево сошлось (или разошлось) и поменяло отметку в реестре - строка
	// списка перекрашивается сразу. Перечит идёт как программный: таблицу
	// товаров он не пересобирает
	Если ДанныеЦепочки.ИтогИзменён = Истина Тогда
		ПеречитатьСписокРеестра();
	КонецЕсли;

	Если ЗамерыВключены Тогда
		ЗаписатьЗамерКликаНаСервере(Идентификатор,
			ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоКлика, ДогружатьТовары);
	КонецЕсли;

	Если ДогружатьТовары
		И (Догрузка.НетТоваровУПД ИЛИ ЗначениеЗаполнено(Догрузка.ИдентификаторЭТрН)) Тогда
		Операция = ЗапуститьДогрузкуТоваровВФоне(УникальныйИдентификатор, Идентификатор,
			Догрузка.Номер, Догрузка.ИдентификаторЭТрН);
		Если Операция <> Неопределено Тогда
			ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
			ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
			ПараметрыОжидания.ВыводитьПрогрессВыполнения = Ложь;
			ПараметрыОжидания.ВыводитьСообщения = Ложь;
			ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция,
				Новый ОписаниеОповещения("ДогрузкаТоваровЗавершена", ЭтотОбъект, Идентификатор),
				ПараметрыОжидания);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Кладёт дерево цепочки в реквизиты формы на клиенте: без контекстного
// вызова динамический список УПД не уезжает на сервер и не прыгает.
//
&НаКлиенте
Процедура ПрименитьДеревоЦепочки(ДанныеЦепочки)

	Если ДанныеЦепочки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьСтрокиДереваЦепочки(ЦепочкаДокументов.ПолучитьЭлементы(),
		ДеревоЦепочкиУПДПервой(ДанныеЦепочки.Строки));
	Элементы.ЦепочкаДокументовАлкоголь.Видимость = ДанныеЦепочки.Алкоголь;

	СписокВыбора = Элементы.ЦепочкаДокументовПараПрихода.СписокВыбора;
	СписокВыбора.Очистить();
	Для Каждого Вариант Из ДанныеЦепочки.ВариантыПары Цикл
		СписокВыбора.Добавить(Вариант);
	КонецЦикла;

КонецПроцедуры

// Дерево цепочки как было: ветки документов (УПД первой, затем ЭТрН, приход
// Далиона, УКД) с товарами внутри. Колонки те же, что у плоской таблицы: у товара
// УПД - номенклатура Далиона и количество ЭТрН по паре, у товара прихода - его
// номенклатура. Список строк прихода для «Пары в приходе» заполняет
// ПлоскиеСтрокиЦепочки - её результат здесь не нужен.
//
&НаКлиенте
Функция ДеревоЦепочкиУПДПервой(Строки)

	ПлоскиеСтрокиЦепочки(Строки);

	Результат = Новый Массив;
	Если Строки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ДокументУПД = Неопределено;
	ДокументЭТрН = Неопределено;
	ДокументДалион = Неопределено;
	Для Каждого СтрокаДокумента Из Строки Цикл
		Если ДокументУПД = Неопределено И СтрНачинаетсяС(СтрокаДокумента.Документ, НСтр("ru = 'УПД'")) Тогда
			ДокументУПД = СтрокаДокумента;
		ИначеЕсли ДокументЭТрН = Неопределено И СтрокаДокумента.Документ = НСтр("ru = 'ЭТрН'") Тогда
			ДокументЭТрН = СтрокаДокумента;
		ИначеЕсли ДокументДалион = Неопределено И СтрокаДокумента.Документ = НСтр("ru = 'Далион'") Тогда
			ДокументДалион = СтрокаДокумента;
		КонецЕсли;
	КонецЦикла;

	ИменаПрихода = Новый Соответствие;
	Если ДокументДалион <> Неопределено Тогда
		ИндексИмени = 0;
		Для Каждого Товар Из ДокументДалион.Строки Цикл
			Если Товар.Документ = НСтр("ru = 'Товар Далиона'") Тогда
				ИменаПрихода.Вставить(XMLСтрока(ИндексИмени), Товар.Номенклатура);
				ИндексИмени = ИндексИмени + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ТоварыЭТрНПоПаре = Новый Соответствие;
	Если ДокументЭТрН <> Неопределено Тогда
		Для Каждого Товар Из ДокументЭТрН.Строки Цикл
			Если ЗначениеЗаполнено(Товар.ИндексПрихода)
				И ТоварыЭТрНПоПаре.Получить(Товар.ИндексПрихода) = Неопределено Тогда
				ТоварыЭТрНПоПаре.Вставить(Товар.ИндексПрихода, Товар);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// УПД - первой веткой, остальные - в порядке сервера
	Порядок = Новый Массив;
	Если ДокументУПД <> Неопределено Тогда
		Порядок.Добавить(ДокументУПД);
	КонецЕсли;
	Для Каждого СтрокаДокумента Из Строки Цикл
		Если СтрокаДокумента <> ДокументУПД Тогда
			Порядок.Добавить(СтрокаДокумента);
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаДокумента Из Порядок Цикл
		Ветка = КопияПоддереваЦепочки(СтрокаДокумента);
		Для Каждого Товар Из Ветка.Строки Цикл
			Товар.Вставить("НоменклатураДалион", "");
			Если СтрокаДокумента = ДокументУПД И ЗначениеЗаполнено(Товар.ИндексПрихода) Тогда
				ИмяПрихода = ИменаПрихода.Получить(Товар.ИндексПрихода);
				Товар.НоменклатураДалион = ?(ИмяПрихода = Неопределено, "", ИмяПрихода);
				ТоварЭТрН = ТоварыЭТрНПоПаре.Получить(Товар.ИндексПрихода);
				Если ТоварЭТрН <> Неопределено Тогда
					Товар.КолЭТрН = ТоварЭТрН.Количество;
				КонецЕсли;
			ИначеЕсли СтрокаДокумента = ДокументДалион Тогда
				Товар.НоменклатураДалион = Товар.Номенклатура;
			КонецЕсли;
		КонецЦикла;
		Результат.Добавить(Ветка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция КопияПоддереваЦепочки(Источник)

	Копия = КопияСтрокиЦепочки(Источник);
	Для Каждого Подчиненная Из Источник.Строки Цикл
		Копия.Строки.Добавить(КопияПоддереваЦепочки(Подчиненная));
	КонецЦикла;
	Возврат Копия;

КонецФункции

// Дерево сервера (УПД, ЭТрН, приход Далиона и УКД отдельными ветками) -> одна
// таблица: строка на товар УПД, а количество ЭТрН и количество, цена и сумма
// Далиона стоят в той же строке. Итоги документов - первой строкой «Итого».
// Строки прихода без товара УПД и строки ЭТрН без пары идут отдельными
// строками, УКД и «Расхождения с Далионом» остаются как были. Серверное
// дерево, его кэш и сверка не меняются.
//
// Заодно запоминает все строки прихода: пара выбирается и среди тех, что
// уже встали в строку УПД (СтрокаПриходаПоВарианту).
//
&НаКлиенте
Функция ПлоскиеСтрокиЦепочки(Строки)

	Результат = Новый Массив;
	ПриходДалиона.Очистить();

	Если Строки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ДокументУПД    = Неопределено;
	ДокументЭТрН   = Неопределено;
	ДокументДалион = Неопределено;
	Прочие = Новый Массив;

	Для Каждого СтрокаДокумента Из Строки Цикл
		Если ДокументУПД = Неопределено И СтрНачинаетсяС(СтрокаДокумента.Документ, НСтр("ru = 'УПД'")) Тогда
			ДокументУПД = СтрокаДокумента;
		ИначеЕсли ДокументЭТрН = Неопределено И СтрокаДокумента.Документ = НСтр("ru = 'ЭТрН'") Тогда
			ДокументЭТрН = СтрокаДокумента;
		ИначеЕсли ДокументДалион = Неопределено И СтрокаДокумента.Документ = НСтр("ru = 'Далион'") Тогда
			ДокументДалион = СтрокаДокумента;
		Иначе
			Прочие.Добавить(СтрокаДокумента);
		КонецЕсли;
	КонецЦикла;

	// Товары ЭТрН по паре в приходе
	ТоварыЭТрНПоПаре = Новый Соответствие;
	Если ДокументЭТрН <> Неопределено Тогда
		Для Каждого Товар Из ДокументЭТрН.Строки Цикл
			Если ЗначениеЗаполнено(Товар.ИндексПрихода)
				И ТоварыЭТрНПоПаре.Получить(Товар.ИндексПрихода) = Неопределено Тогда
				ТоварыЭТрНПоПаре.Вставить(Товар.ИндексПрихода, Товар);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Наименования строк прихода по индексу - для колонки «Номенклатура Далиона»
	ИменаПрихода = Новый Соответствие;
	Если ДокументДалион <> Неопределено Тогда
		ИндексИмени = 0;
		Для Каждого Товар Из ДокументДалион.Строки Цикл
			Если Товар.Документ = НСтр("ru = 'Товар Далиона'") Тогда
				ИменаПрихода.Вставить(XMLСтрока(ИндексИмени), Товар.Номенклатура);
				ИндексИмени = ИндексИмени + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ИспользованныеПриходы = Новый Соответствие;
	СтрокиТоваров = Новый Массив;

	Если ДокументУПД <> Неопределено Тогда
		Для Каждого Товар Из ДокументУПД.Строки Цикл
			СтрокаТовара = КопияСтрокиЦепочки(Товар);
			СтрокаТовара.Вставить("НоменклатураДалион", "");
			Если ЗначениеЗаполнено(Товар.ИндексПрихода) Тогда
				ИмяПрихода = ИменаПрихода.Получить(Товар.ИндексПрихода);
				СтрокаТовара.НоменклатураДалион = ?(ИмяПрихода = Неопределено, "", ИмяПрихода);
				ИспользованныеПриходы.Вставить(Товар.ИндексПрихода, Истина);
				ТоварЭТрН = ТоварыЭТрНПоПаре.Получить(Товар.ИндексПрихода);
				Если ТоварЭТрН <> Неопределено Тогда
					СтрокаТовара.КолЭТрН = ТоварЭТрН.Количество;
				КонецЕсли;
			КонецЕсли;
			СтрокиТоваров.Добавить(СтрокаТовара);
		КонецЦикла;
	КонецЕсли;

	Если ДокументДалион <> Неопределено Тогда
		Индекс = 0;
		Для Каждого Товар Из ДокументДалион.Строки Цикл

			Если Товар.Документ <> НСтр("ru = 'Товар Далиона'") Тогда
				Прочие.Добавить(Товар);
				Продолжить;
			КонецЕсли;

			ЗаписьПрихода = ПриходДалиона.Добавить();
			ЗаписьПрихода.Вариант           = Товар.ВариантПары;
			ЗаписьПрихода.Номенклатура      = Товар.Номенклатура;
			ЗаписьПрихода.ШтрихкодыСтроки   = Товар.ШтрихкодыСтроки;
			ЗаписьПрихода.КлючиНоменклатуры = Товар.КлючиНоменклатуры;
			// Количество прихода - для штук в единице поставщика при ручной паре
			ЗаписьПрихода.Количество        = ?(ТипЗнч(Товар.КолДалион) = Тип("Число") И Товар.КолДалион <> 0,
				Товар.КолДалион, ?(ТипЗнч(Товар.Количество) = Тип("Число"), Товар.Количество, 0));

			Ключ = XMLСтрока(Индекс);
			Индекс = Индекс + 1;
			Если ИспользованныеПриходы.Получить(Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			// Строка прихода без товара УПД
			СтрокаТовара = КопияСтрокиЦепочки(Товар);
			СтрокаТовара.Вставить("НоменклатураДалион", Товар.Номенклатура);
			СтрокаТовара.КолДалион   = Товар.Количество;
			СтрокаТовара.ЦенаДалион  = Товар.Цена;
			СтрокаТовара.СуммаДалион = Товар.Сумма;
			СтрокаТовара.Количество  = "";
			СтрокаТовара.Цена        = "";
			СтрокаТовара.Сумма       = "";
			ТоварЭТрН = ТоварыЭТрНПоПаре.Получить(Ключ);
			Если ТоварЭТрН <> Неопределено Тогда
				СтрокаТовара.КолЭТрН = ТоварЭТрН.Количество;
			КонецЕсли;
			СтрокиТоваров.Добавить(СтрокаТовара);

		КонецЦикла;
	КонецЕсли;

	// Строки ЭТрН без пары в приходе
	Если ДокументЭТрН <> Неопределено Тогда
		Для Каждого Товар Из ДокументЭТрН.Строки Цикл
			Если ЗначениеЗаполнено(Товар.ИндексПрихода) Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТовара = КопияСтрокиЦепочки(Товар);
			СтрокаТовара.КолЭТрН    = Товар.Количество;
			СтрокаТовара.Количество = "";
			СтрокаТовара.Цена       = "";
			СтрокаТовара.Сумма      = "";
			СтрокиТоваров.Добавить(СтрокаТовара);
		КонецЦикла;
	КонецЕсли;

	// Итоги документов
	Итого = КопияСтрокиЦепочки(Строки[0]);
	Итого.Документ       = НСтр("ru = 'Итого'");
	Итого.Количество     = "";
	Итого.Цена           = "";
	Итого.Сумма          = "";
	Итого.Расхождение    = "";
	Итого.Расходится     = Ложь;
	Итого.Сверена        = Ложь;
	Итого.БезПары        = Ложь;
	Итого.СвереноВручную = Ложь;
	Итого.ПараПрихода    = "";
	Итого.ВариантПары    = "";
	Итого.Позиции        = "";

	Названия = Новый Массив;
	Если ДокументУПД <> Неопределено Тогда
		Итого.Количество = ДокументУПД.Количество;
		Итого.Сумма      = ДокументУПД.Сумма;
		Итого.Расходится = ДокументУПД.Расходится;
		Итого.Сверена    = ДокументУПД.Сверена;
		Названия.Добавить(ДокументУПД.Номенклатура);
	КонецЕсли;
	Если ДокументЭТрН <> Неопределено Тогда
		Итого.КолЭТрН = ДокументЭТрН.Количество;
		Названия.Добавить(ДокументЭТрН.Номенклатура);
	КонецЕсли;
	Если ДокументДалион <> Неопределено Тогда
		Итого.КолДалион   = ДокументДалион.Количество;
		Итого.СуммаДалион = ДокументДалион.Сумма;
		Итого.Расхождение = ДокументДалион.Расхождение;
		Итого.Расходится  = Итого.Расходится ИЛИ ДокументДалион.Расходится;
		Названия.Добавить(ДокументДалион.Номенклатура);
	КонецЕсли;
	Итого.Номенклатура = НСтр("ru = 'Итого: '") + СтрСоединить(Названия, "; ");

	Результат.Добавить(Итого);
	Для Каждого СтрокаТовара Из СтрокиТоваров Цикл
		Результат.Добавить(СтрокаТовара);
	КонецЦикла;
	Для Каждого СтрокаДокумента Из Прочие Цикл
		Результат.Добавить(СтрокаДокумента);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция КопияСтрокиЦепочки(Источник)

	Копия = Новый Структура;
	Для Каждого КлючЗначение Из Источник Цикл
		Копия.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	Копия.Строки = Новый Массив;

	Возврат Копия;

КонецФункции

&НаКлиенте
Процедура ЗаполнитьСтрокиДереваЦепочки(Приёмник, Источник)

	Приёмник.Очистить();
	Для Каждого ДанныеСтроки Из Источник Цикл
		НоваяСтрока = Приёмник.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки);
		ЗаполнитьСтрокиДереваЦепочки(НоваяСтрока.ПолучитьЭлементы(), ДанныеСтроки.Строки);
	КонецЦикла;

КонецПроцедуры

// Товары догружены фоном: дерево перестраивается, если пользователь всё ещё
// стоит на этой УПД. Ушёл на другую - ничего не трогаем.
//
&НаКлиенте
Процедура ДогрузкаТоваровЗавершена(Результат, Идентификатор) Экспорт

	Если Результат = Неопределено ИЛИ Результат.Статус = "Ошибка" Тогда
		Возврат;
	КонецЕсли;

	Если ПолучитьИзВременногоХранилища(Результат.АдресРезультата) <> Истина Тогда
		Возврат;
	КонецЕсли;

	Если ИдентификаторТекущейСтроки() <> Идентификатор Тогда
		Возврат;
	КонецЕсли;

	ЦепочкаПостроенаДля = Неопределено;
	ОбновитьЦепочкуДокументов();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗапуститьДогрузкуТоваровВФоне(ИдентификаторФормы, ИдентификаторУПД, НомерУПД, ИдентификаторЭТрН)

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Реестр УПД: товары из СБИС'");
	ПараметрыВыполнения.СРасширениямиБазыДанных = Истина;

	Попытка
		Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"ЭАрМ_РегламентныйОбменЭДО.ДогрузитьТоварыЦепочки",
			ИдентификаторУПД, НомерУПД, ИдентификаторЭТрН);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Заполняет дерево цепочки и три итоговых реквизита шапки.
//
// УПД, связанная ЭТрН и приходная накладная Далиона - три строки верхнего
// уровня, каждая раскрывается в собственные товары. Вложенность здесь была
// бы обманом: документы не входят друг в друга, а описывают одну поставку с
// трёх сторон, и сравнивать их нужно рядом, а не через два раскрытия.
//
// Ведущей остаётся УПД: она идёт первой, из её строк считаются итоги шапки,
// а колонки Далиона в товарах заполняет сопоставленная строка прихода.
//
// Параметры:
//   Идентификатор     - Строка - документ УПД в СБИС; пустая строка очищает дерево
//   ДогружатьТовары   - Булево - спросить строки у СБИС, если их нет в регистре
//   АдресКэша         - Строка - адрес кэша деревьев формы
//   ИзКэша            - Булево - взять дерево из кэша, если отпечаток данных УПД
//                       тот же и дереву меньше 5 минут
//   ИдентификаторФормы - УникальныйИдентификатор - для временного хранилища кэша
//
// Возвращаемое значение:
//   Структура - Строки, Алкоголь, АдресКэша, Догрузка, ВариантыПары
//
&НаСервереБезКонтекста
Функция ЗаполнитьЦепочкуДокументовНаСервере(Идентификатор, ДогружатьТовары = Ложь,
	АдресКэша = "", ИзКэша = Ложь, ИдентификаторФормы = Неопределено)

	Догрузка = Новый Структура("НетТоваровУПД, ИдентификаторЭТрН, Номер", Ложь, "", "");

	// Возврат на уже построенную УПД младше 5 минут: отдаём готовое дерево.
	// Отпечаток не сверяем - фоновая сверка меняет реестр постоянно, и из-за
	// этого таблица товаров пересобиралась, пока в ней работали
	Если ИзКэша И ЗначениеЗаполнено(Идентификатор) И ЗначениеЗаполнено(АдресКэша) Тогда
		Кэш = ПолучитьИзВременногоХранилища(АдресКэша);
		Запись = ?(ТипЗнч(Кэш) = Тип("Соответствие"), Кэш.Получить(Идентификатор), Неопределено);
		Если Запись <> Неопределено
			И ТекущаяДатаСеанса() - Запись.Время < 300 Тогда
			Возврат РезультатПостроенияЦепочки(Запись.Дерево, Запись.Алкоголь, АдресКэша, Догрузка);
		КонецЕсли;
	КонецЕсли;

	Замер = ЭАрМ_Служебный.НачатьЗамер("ВыборУПД", Идентификатор);

	Дерево = НовоеДеревоЦепочки();
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "01 Дерево из формы");

	ШапкаУПД = ?(ЗначениеЗаполнено(Идентификатор),
		ШапкаУПДДляДерева(Идентификатор), Неопределено);
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "02 Шапка УПД");

	Если ШапкаУПД = Неопределено Тогда
		ЭАрМ_Служебный.ДобавитьСвойствоЗамера(Замер, "УПД", "нет в реестре");
		ЭАрМ_Служебный.ЗаписатьЗамер(Замер);
		Возврат РезультатПостроенияЦепочки(Дерево, Ложь, АдресКэша, Догрузка);
	КонецЕсли;

	ЭАрМ_Служебный.ДобавитьСвойствоЗамера(Замер, "Номер", ШапкаУПД.Номер);

	ТоварыУПД = ТоварыДляДерева(Идентификатор, "УПД");
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "03 Товары УПД");

	// Шапка УПД попадает в реестр раньше строк: если товаров ещё нет,
	// спрашиваем их у СБИС тем же способом, что и форма реестра ЭТрН.
	Если ТоварыУПД.Количество() = 0
		И ДогружатьТовары
		И ЭАрМ_РегламентныйОбменЭДО.ДогрузитьТоварыУПД(
			Идентификатор, ШапкаУПД.Номер) Тогда
		ТоварыУПД = ТоварыДляДерева(Идентификатор, "УПД");
		ЭАрМ_Служебный.ДобавитьСвойствоЗамера(Замер, "ТоварыУПДизСБИС", "да");
	КонецЕсли;
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "04 Догрузка товаров УПД из СБИС");

	СвязаннаяЭТрН = СвязаннаяЭТрНДляДерева(Идентификатор, ШапкаУПД);
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "05 Поиск связанной ЭТрН");
	ТоварыЭТрН    = ТоварыДляДерева(СвязаннаяЭТрН.Идентификатор, "ЭТрН");
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "06 Товары ЭТрН");

	// Груз накладной мог быть ещё не разобран: реестр ЭТрН наполняется
	// отдельно от реестра УПД, и его строки появляются только после чтения
	// документа. Без них ветка ЭТрН в цепочке была бы пустой.
	Если ТоварыЭТрН.Количество() = 0
		И ДогружатьТовары
		И ЗначениеЗаполнено(СвязаннаяЭТрН.Идентификатор)
		И ЭАрМ_РегламентныйОбменЭДО.ОбновитьТоварыДокумента(
			СвязаннаяЭТрН.Идентификатор).Успех Тогда
		ТоварыЭТрН = ТоварыДляДерева(СвязаннаяЭТрН.Идентификатор, "ЭТрН");
		ЭАрМ_Служебный.ДобавитьСвойствоЗамера(Замер, "ТоварыЭТрНизСБИС", "да");
	КонецЕсли;
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "07 Догрузка груза ЭТрН из СБИС");

	// Чего нет в базе - догрузит фоновое задание формы
	Если Догрузка <> Неопределено Тогда
		Догрузка.Номер = ШапкаУПД.Номер;
		Догрузка.НетТоваровУПД = ТоварыУПД.Количество() = 0;
		Если ТоварыЭТрН.Количество() = 0 И ЗначениеЗаполнено(СвязаннаяЭТрН.Идентификатор) Тогда
			Догрузка.ИдентификаторЭТрН = СвязаннаяЭТрН.Идентификатор;
		КонецЕсли;
	КонецЕсли;

	СпособЦепочки = "";
	Цепочка = ЦепочкаДляДерева(Идентификатор, ШапкаУПД, СпособЦепочки);
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "08 Цепочка закупки");
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "09 Актуализация сверки");

	Если НЕ ЗначениеЗаполнено(СвязаннаяЭТрН.Идентификатор)
		И Цепочка <> Неопределено
		И ЗначениеЗаполнено(Цепочка.ИдентификаторЭТрН) Тогда
		СвязаннаяЭТрН = СвязаннаяЭТрНДляДереваПоИдентификатору(Цепочка.ИдентификаторЭТрН);
		ТоварыЭТрН = ТоварыДляДерева(СвязаннаяЭТрН.Идентификатор, "ЭТрН");
	КонецЕсли;

	ПриходДалион  = ПриходДалионаДляДерева(ШапкаУПД, СвязаннаяЭТрН, Цепочка);
	ПриходИзПакета = Ложь;
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "10 Шапка прихода Далиона");
	ТоварыДалион  = ТоварыПриходаДляДерева(Идентификатор, СвязаннаяЭТрН.Идентификатор, Цепочка,
		ПриходИзПакета);
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "11 Позиции прихода Далиона");
	СтрокПриходаИсточник = ТоварыДалион.Количество();
	СтрокиРеестра = СтрокиРеестраТоваровДляДерева(Цепочка, Идентификатор);
	ТоварыДалион  = ДополнитьПриходИзРеестраДляДерева(ТоварыДалион, СтрокиРеестра);
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "12 Реестр товаров заказов");

	// Почему ветка Далиона в дереве такая, какая есть - одной строкой в трассу
	ИсточникПрихода = ?(ПриходИзПакета, "пакет приходной " + Цепочка.ИдентификаторПоступления,
		?(СтрокПриходаИсточник > 0, "товары «База2» в регистре ЭАрМ_ТоварыЭТрН", "НЕТ строк прихода"));
	ЭАрМ_ПриемПакетовДалион.Трасса(Идентификатор, СтрШаблон(
		"Дерево УПД № %1: строк УПД %2; цепочка - %3; поступление «%4»; приход: %5, строк %6 (+ из реестра товаров %7); строк реестра товаров %8",
		ШапкаУПД.Номер, ТоварыУПД.Количество(), СпособЦепочки,
		?(Цепочка = Неопределено, "нет", Цепочка.ИдентификаторПоступления), ИсточникПрихода,
		СтрокПриходаИсточник, ТоварыДалион.Количество() - СтрокПриходаИсточник, СтрокиРеестра.Количество()),
		ТоварыДалион.Количество() > 0 И ТоварыУПД.Количество() > 0);
	Если Цепочка <> Неопределено И ЗначениеЗаполнено(Цепочка.ИдентификаторПоступления)
		И СтрокПриходаИсточник = 0 Тогда
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(Идентификатор, "Дерево УПД / строки прихода",
			"цепочка с поступлением " + Цепочка.ИдентификаторПоступления
			+ " есть, но строк прихода нет ни в пакете (ЭАрМ_ПакетыДалион), ни в «База2» - ветка Далиона пустая");
	КонецЕсли;
	Если ТоварыУПД.Количество() = 0 Тогда
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(Идентификатор, "Дерево УПД / строки УПД",
			"у УПД № " + ШапкаУПД.Номер + " нет строк товаров в ЭАрМ_ТоварыЭТрН (источник «УПД») - сверять не с чем");
	КонецЕсли;

	// С приходом сравнивается УПД с учётом её корректировок - как в сверке
	// цепочки (ЭАрМ_СверкаТоваровЦепочки.ПрименитьКорректировки). Список
	// берём до свёртки: строка УКД находит строку УПД по номеру позиции.
	Корректировки = ЭАрМ_КорректировкиУПД.КорректировкиДляЦепочки(Идентификатор);
	ПримененоСтрокУКД = ПрименитьКорректировкиДляДерева(ТоварыУПД, Идентификатор);
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "13 Корректировки УКД");

	// Номенклатура Далиона и все штрихкоды товара из регистра штрихкодов
	// поставщиков: строке УПД там назначен один штрихкод, а у Далиона в
	// приходе может стоять другой штрихкод той же номенклатуры
	ИННПоставщика = ШапкаУПД.ИННКонтрагента;
	Если Цепочка <> Неопределено И ЗначениеЗаполнено(Цепочка.ИННПоставщика) Тогда
		ИННПоставщика = Цепочка.ИННПоставщика;
	КонецЕсли;
	ДополнитьИзШтрихкодовПоставщикаДляДерева(ТоварыУПД, ИННПоставщика);
	ДополнитьИзШтрихкодовПоставщикаДляДерева(ТоварыЭТрН, ИННПоставщика);
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "14 Штрихкоды поставщика");
	ЭАрМ_Служебный.ДобавитьСвойствоЗамера(Замер, "СтрокУПД", ТоварыУПД.Количество());
	ЭАрМ_Служебный.ДобавитьСвойствоЗамера(Замер, "СтрокЭТрН", ТоварыЭТрН.Количество());
	ЭАрМ_Служебный.ДобавитьСвойствоЗамера(Замер, "СтрокПрихода", ТоварыДалион.Количество());
	ЭАрМ_Служебный.ДобавитьСвойствоЗамера(Замер, "СтрокРеестра", СтрокиРеестра.Количество());

	// Пары УПД и прихода решает сверка цепочки, форма их только показывает:
	// строки собираются по линиям реестра товаров (позиции УПД и строки
	// прихода линии). Своим подбором форма ищет пару только строкам, которых
	// в реестре нет (реестр ещё не пересверен или устарел).
	ПоРеестру = ГруппироватьПоРееструДляДерева(ТоварыУПД, ТоварыДалион, СтрокиРеестра, ПриходИзПакета);
	Если ПоРеестру = Неопределено Тогда
		ТоварыУПД    = СвернутьТоварыДляСверки(ТоварыУПД);
		ТоварыДалион = СвернутьТоварыДляСверки(ТоварыДалион);
		ПарыРеестра  = Неопределено;
	Иначе
		ТоварыУПД    = ПоРеестру.ТоварыУПД;
		ТоварыДалион = ПоРеестру.ТоварыДалион;
		ПарыРеестра  = ПоРеестру;
	КонецЕсли;
	ТоварыЭТрН   = СвернутьТоварыДляСверки(ТоварыЭТрН);
	ЭАрМ_Служебный.ДобавитьСвойствоЗамера(Замер, "ПарыИзРеестра", ?(ПоРеестру = Неопределено, "нет", "да"));
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "15 Группировка и свёртка");

	ПозицийУПД = ТоварыУПД.Количество();
	ПозицийПН  = ТоварыДалион.Количество();
	ИтогСуммаУПД = ?(ПозицийУПД = 0, 0, ТоварыУПД.Итог("Сумма"));
	ИтогСуммаПН  = ?(ПозицийПН = 0, 0, ТоварыДалион.Итог("Сумма"));

	// Строку прихода отдаём одному товару: сопоставленную помечаем, чтобы
	// одинаковые наименования не встали на одну и ту же строку Далиона.
	ИспользованныеДляУПД  = Новый Соответствие;
	ИспользованныеДляЭТрН = Новый Соответствие;

	// Расхождения копим по ходу сверки: отдельным проходом их пришлось бы
	// сопоставлять заново, а сопоставление одноразовое - строка прихода
	// достаётся первому подошедшему товару.
	НайденныеРасхождения = Новый Массив;

	СтрокаУПД = Дерево.Строки.Добавить();
	СтрокаУПД.Номенклатура = ?(ЗначениеЗаполнено(ШапкаУПД.Представление),
		ШапкаУПД.Представление,
		СтрШаблон(НСтр("ru = 'УПД № %1'"), ШапкаУПД.Номер));
	СтрокаУПД.Документ = ?(ПримененоСтрокУКД > 0,
		НСтр("ru = 'УПД с учётом УКД'"), НСтр("ru = 'УПД'"));
	ИтогиДокументаВДерево(СтрокаУПД, ТоварыУПД);

	ДобавитьТоварыВДерево(СтрокаУПД, ТоварыУПД, НСтр("ru = 'Товар УПД'"),
		ТоварыДалион, ИспользованныеДляУПД, НайденныеРасхождения, ПарыРеестра,
		ЭАрМ_КорректировкиУПД.ОтметкиСтрокСверкиВручную(Идентификатор));
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "16 Подбор пар и ветка УПД");

	ДобавитьИтогиДокументовВРасхождения(НайденныеРасхождения,
		ПозицийУПД, ПозицийПН, ИтогСуммаУПД, ИтогСуммаПН);

	// Разошлись только итоговая сумма или число строк - строки товаров
	// могут быть зелёными, но сам документ не сошёлся
	Если НайденныеРасхождения.Количество() > 0 Тогда
		СтрокаУПД.Расходится = Истина;
	КонецЕсли;

	// Итог решает готовность к утверждению. «Точно» - до копейки, иначе
	// погрешность из шапки. Строка говорит, какая сумма больше и на сколько
	НастройкиСуммы = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	ИтогиСошлись = ПозицийУПД > 0 И ПозицийПН > 0
		И ЭАрМ_СверкаТоваровЦепочки.СуммыИтогаВДопуске(ИтогСуммаУПД, ИтогСуммаПН, НастройкиСуммы);
	Если ИтогиСошлись Тогда
		СтрокаУПД.Расходится = Ложь;
		СтрокаУПД.Сверена    = Истина;
	КонецЕсли;
	ДобавитьСтрокуРазницыСумм(Дерево, ИтогСуммаУПД, ИтогСуммаПН, ИтогиСошлись, ПозицийПН > 0);

	Если НайденныеРасхождения.Количество() = 0 И ТоварыДалион.Количество() > 0 Тогда
		ОтметитьСошедшиесяСтрокиПодУПД(СтрокаУПД);
	КонецЕсли;

	// Корректировки - отдельными документами сразу за УПД, их изменения - в
	// колонке «Расхождения» строк УПД
	ДобавитьКорректировкиВДерево(Дерево, СтрокаУПД, ТоварыУПД, Корректировки);
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "17 Ветка УКД");

	Если ЗначениеЗаполнено(СвязаннаяЭТрН.Идентификатор)
		И СвязаннаяЭТрН.Идентификатор <> Идентификатор Тогда

		СтрокаЭТрН = Дерево.Строки.Добавить();
		СтрокаЭТрН.Номенклатура = ?(ЗначениеЗаполнено(СвязаннаяЭТрН.Номер),
			СтрШаблон(НСтр("ru = 'ЭТрН № %1'"), СвязаннаяЭТрН.Номер),
			НСтр("ru = 'Связанная ЭТрН'"));
		СтрокаЭТрН.Документ = НСтр("ru = 'ЭТрН'");
		ИтогиДокументаВДерево(СтрокаЭТрН, ТоварыЭТрН);

		// Расхождения по ЭТрН в общий список не идут: приход сверяется с УПД,
		// а ЭТрН показывает тот же груз глазами перевозчика
		ДобавитьТоварыВДерево(СтрокаЭТрН, ТоварыЭТрН, НСтр("ru = 'Товар ЭТрН'"),
			ТоварыДалион, ИспользованныеДляЭТрН, Неопределено);

		// ЭТрН утверждается по факту приходной Далиона, совпадение товаров не
		// требуется (ЭАрМ_УтверждениеСБИС.ЗапретУтверждения). Пары строк ЭТрН
		// с приходом ищутся только по штрихкоду, а у груза ЭТрН его часто нет -
		// и ветка краснела при найденной приходной. Приходная есть - ветка
		// зелёная, несовпадения строк остаются в колонке «Расхождение» справкой
		Если ЗначениеЗаполнено(ПриходДалион.НомерДокумента) ИЛИ ТоварыДалион.Количество() > 0 Тогда
			ОтметитьВеткуЭТрНСПриходом(СтрокаЭТрН);
		КонецЕсли;

		Если ЭТрНОтправленаВСБИС(СвязаннаяЭТрН) Тогда
			СтрокаЭТрН.Номенклатура = СтрокаЭТрН.Номенклатура + НСтр("ru = ' — отправлена'");
			СтрокаЭТрН.Сверена = Истина;
			СтрокаЭТрН.Расходится = Ложь;
		КонецЕсли;

	КонецЕсли;

	// Дерево тоже коллекция строк, поэтому приход встаёт третьим документом
	// того же уровня, а не веткой внутри УПД или накладной.
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "18 Ветка ЭТрН");
	ДобавитьВеткуДалионаВДерево(Дерево, ПриходДалион, ТоварыДалион,
		?(ТоварыУПД.Количество() > 0, ИспользованныеДляУПД, Неопределено));

	ДобавитьСтрокуРасхожденийВДерево(Дерево, НайденныеРасхождения);
	СвестиКолонкиРасхожденийДерева(Дерево.Строки);

	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "19 Ветка Далиона и расхождения");

	АлкогольВДереве = ВДеревеЕстьАлкоголь(Дерево.Строки);
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "20 Дерево в форму");

	// Товары дерева сошлись полностью: есть строки и УПД, и прихода, и ни
	// одного расхождения - ни по строкам, ни по числу позиций, ни по сумме
	СтрокиСошлись = ИтогиСошлись;
	ИтогИзменён = Ложь;
	ОбработатьРезультатСверки(Идентификатор, ШапкаУПД, НайденныеРасхождения, ПриходДалион,
		СтрокиСошлись, ИтогИзменён);
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "21 Запись итога сверки");

	// Вывод словами: «прихода 0» без пояснения читался как ошибка сверки, а это
	// значит, что сверять не с чем
	Если ПозицийПН = 0 И НЕ ЗначениеЗаполнено(ПриходДалион.НомерДокумента) Тогда
		Вывод = "ПРИХОДНОЙ НЕТ: к УПД не привязана приходная Далиона - сверять не с чем, "
			+ "итог в реестре не меняется. Привязка - по входящему номеру приходной (= номер УПД) и ИНН, "
			+ "или вручную «Выбрать приходную»";
	ИначеЕсли ПозицийПН = 0 Тогда
		Вывод = СтрШаблон("приходная Далиона № %1 привязана, но строк товаров в ней нет - "
			+ "пакет не разобран или пустой; сверять не с чем", ПриходДалион.НомерДокумента);
	ИначеЕсли ИтогиСошлись Тогда
		Вывод = "СОШЛОСЬ: суммы и позиции УПД и приходной совпали, расхождений по строкам нет";
	Иначе
		Вывод = СтрШаблон("НЕ СОШЛОСЬ: разница сумм %1, строк с расхождением %2 - см. колонку «Расхождение»",
			Формат(ИтогСуммаУПД - ИтогСуммаПН, "ЧДЦ=2; ЧГ=0; ЧН=0"), НайденныеРасхождения.Количество());
	КонецЕсли;
	ЭАрМ_ПриемПакетовДалион.Трасса(Идентификатор, СтрШаблон(
		"Дерево УПД № %1: %2. Данные: позиций УПД %3, прихода %4, сумма УПД %5, прихода %6, расхождений %7; итог в реестре УПД %8",
		ШапкаУПД.Номер, Вывод, ПозицийУПД, ПозицийПН, Формат(ИтогСуммаУПД, "ЧДЦ=2; ЧГ=0; ЧН=0"),
		Формат(ИтогСуммаПН, "ЧДЦ=2; ЧГ=0; ЧН=0"), НайденныеРасхождения.Количество(),
		?(ИтогИзменён, "ИЗМЕНЁН", "не менялся")),
		ИтогиСошлись);

	// Сводку строки реестра здесь не пишем: ОбновитьСводкуУПД меняет
	// ДатаСводки, и открытый список прыгает. Сводку догонит регламент.

	// В кэш формы - с отпечатком, снятым после записи итога сверки: сверка
	// сама меняет строку реестра, и отпечаток до неё сразу бы устарел
	АдресКэша = ПоместитьДеревоВКэш(АдресКэша, Идентификатор, Дерево,
		АлкогольВДереве, ИдентификаторФормы);
	ЭАрМ_Служебный.ОтметитьЗамер(Замер, "22 Дерево в кэш формы");

	ЭАрМ_Служебный.ЗаписатьЗамер(Замер);

	Результат = РезультатПостроенияЦепочки(Дерево, АлкогольВДереве, АдресКэша, Догрузка);
	Результат.ИтогИзменён = ИтогИзменён;
	Возврат Результат;

КонецФункции

// Кладёт построенное дерево в кэш формы (не больше 30 УПД: переполнился -
// начинается заново).
//
// Возвращаемое значение:
//   Строка - адрес кэша
//
&НаСервереБезКонтекста
Функция ПоместитьДеревоВКэш(Знач АдресКэша, Идентификатор, Дерево, Алкоголь, ИдентификаторФормы)

	Кэш = ?(ЗначениеЗаполнено(АдресКэша), ПолучитьИзВременногоХранилища(АдресКэша), Неопределено);
	Если ТипЗнч(Кэш) <> Тип("Соответствие") ИЛИ Кэш.Количество() >= 30 Тогда
		Кэш = Новый Соответствие;
	КонецЕсли;

	Кэш.Вставить(Идентификатор, Новый Структура("Отпечаток, Время, Дерево, Алкоголь",
		ОтпечатокДанныхЦепочки(Идентификатор), ТекущаяДатаСеанса(), Дерево.Скопировать(), Алкоголь));

	АдресПомещения = ?(ЗначениеЗаполнено(АдресКэша), АдресКэша, ИдентификаторФормы);
	Возврат ПоместитьВоВременноеХранилище(Кэш, АдресПомещения);

КонецФункции

&НаСервереБезКонтекста
Функция НовоеДеревоЦепочки()

	Дерево = Новый ДеревоЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить(ИменаКолонокДереваЦепочки(), ",", Ложь) Цикл
		Если ИмяКолонки = "Расходится" ИЛИ ИмяКолонки = "Сверена" ИЛИ ИмяКолонки = "БезПары"
			ИЛИ ИмяКолонки = "СвереноВручную" ИЛИ ИмяКолонки = "ЕстьВУТ" Тогда
			Дерево.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Булево"));
		Иначе
			Дерево.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Строка"));
		КонецЕсли;
	КонецЦикла;

	Возврат Дерево;

КонецФункции

&НаСервереБезКонтекста
Функция ИменаКолонокДереваЦепочки()

	Возврат "Номенклатура,Документ,Количество,Цена,Сумма,СтавкаНДС,СуммаНДС,Расхождение,"
		+ "Расходится,Расхождения,Сверена,Алкоголь,ПараПрихода,БезПары,ШтрихкодыСтроки,"
		+ "КлючиНоменклатуры,КодПоставщика,ВариантПары,Позиции,СвереноВручную,"
		+ "ИндексПрихода,КолДалион,ЦенаДалион,СуммаДалион,КолЭТрН,ЕстьВУТ";

КонецФункции

&НаСервереБезКонтекста
Функция РезультатПостроенияЦепочки(Дерево, Алкоголь, АдресКэша, Догрузка)

	Результат = Новый Структура;
	Результат.Вставить("Строки", СтрокиДереваЦепочкиВМассив(Дерево.Строки));
	Результат.Вставить("Алкоголь", Алкоголь);
	Результат.Вставить("АдресКэша", АдресКэша);
	Результат.Вставить("Догрузка", Догрузка);
	Результат.Вставить("ВариантыПары", ВариантыПарыПрихода(Дерево));
	// Дерево поменяло «Расхождений нет» в реестре - список надо перечитать
	Результат.Вставить("ИтогИзменён", Ложь);
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция СтрокиДереваЦепочкиВМассив(СтрокиДерева)

	Результат = Новый Массив;
	ИменаКолонок = ИменаКолонокДереваЦепочки();
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		ДанныеСтроки = Новый Структура(ИменаКолонок);
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаДерева);
		ДанныеСтроки.Вставить("Строки", СтрокиДереваЦепочкиВМассив(СтрокаДерева.Строки));
		Результат.Добавить(ДанныеСтроки);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Отпечаток всего, из чего строится дерево цепочки УПД, - одним пакетом из
// четырёх лёгких запросов: строка реестра УПД (статусы, признаки, сверка),
// строки товаров УПД (число и сумма), цепочка закупки (даты обновления и
// сверки) и связанные ЭТрН (статусы). Изменилось хоть что-то - дерево
// строится заново.
//
&НаСервереБезКонтекста
Функция ОтпечатокДанныхЦепочки(Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.СтатусПодписания КАК СтатусПодписания,
	|	УПД.Подписано КАК Подписано,
	|	УПД.Утверждено КАК Утверждено,
	|	УПД.РасхожденийНет КАК РасхожденийНет,
	|	УПД.СтрокиСвереныВручную КАК СтрокиСвереныВручную,
	|	УПД.ЕстьЭТрН КАК ЕстьЭТрН,
	|	УПД.ЕстьУКД КАК ЕстьУКД,
	|	УПД.ДатаЗагрузки КАК ДатаЗагрузки,
	|	УПД.ЗамененаНа КАК ЗамененаНа
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.ИдентификаторСБИС = &Идентификатор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Строк,
	|	ЕСТЬNULL(СУММА(Товары.Сумма), 0) КАК Сумма
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	(Товары.ИдентификаторСБИС = &Идентификатор
	|			ИЛИ Товары.ИдентификаторУПД = &Идентификатор)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Цепочек,
	|	МАКСИМУМ(Цепочка.ДатаОбновления) КАК ДатаОбновления,
	|	МАКСИМУМ(Цепочка.ДатаСверки) КАК ДатаСверки
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторУПД = &Идентификатор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭТрН.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	ЭТрН.СтатусПодписания КАК СтатусПодписания,
	|	ЭТрН.Подписано КАК Подписано,
	|	ЭТрН.Утверждено КАК Утверждено,
	|	ЭТрН.ДатаЗагрузки КАК ДатаЗагрузки
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	ЭТрН.ИдентификаторУПД = &Идентификатор
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИдентификаторСБИС";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Части = Новый Массив;
	Для Каждого Результат Из Запрос.ВыполнитьПакет() Цикл
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Для Каждого Колонка Из Результат.Колонки Цикл
				Части.Добавить(Строка(Выборка[Колонка.Имя]));
			КонецЦикла;
		КонецЦикла;
		Части.Добавить("#");
	КонецЦикла;

	Возврат СтрСоединить(Части, "|");

КонецФункции

// Кладёт корректировки (УКД) в цепочку.
//
// Каждая УКД - отдельный документ верхнего уровня со своими строками «было ->
// стало» в колонке «Расхождения». Строкам УПД в той же колонке пишется, что с
// ними сделали связанные корректировки. Корректировка, которая по номеру
// подходит к УПД, но не связалась, стоит красной и объясняет почему.
//
&НаСервереБезКонтекста
Процедура ДобавитьКорректировкиВДерево(Дерево, СтрокаУПД, ТоварыУПД, Корректировки)

	Если Корректировки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ТекстыТоваров = РасхожденияУКДПоТоварам(ТоварыУПД, Корректировки);
	Для Индекс = 0 По Мин(ТекстыТоваров.ВГраница(), СтрокаУПД.Строки.Количество() - 1) Цикл
		СтрокаУПД.Строки[Индекс].Расхождения = ТекстыТоваров[Индекс];
	КонецЦикла;

	Связано = 0;
	Для Каждого Корректировка Из Корректировки Цикл
		Если Корректировка.Связана Тогда
			Связано = Связано + 1;
		КонецЕсли;
	КонецЦикла;
	СтрокаУПД.Расхождения = СтрШаблон(НСтр("ru = 'Корректировок (УКД): %1, связано с УПД: %2'"),
		Корректировки.Количество(), Связано);

	Для Каждого Корректировка Из Корректировки Цикл

		// ▼ в шапке УКД - в ней есть уменьшения (возврат товара по корректировке)
		МаркерУменьшения = "";
		Для Каждого СтрокаКорректировки Из Корректировка.Строки Цикл
			Если СтрокаКорректировки.ПризнакИзменения = "Убрана"
				ИЛИ СтрокаКорректировки.ПризнакИзменения = "Уменьшение" Тогда
				МаркерУменьшения = "▼ ";
				Прервать;
			КонецЕсли;
		КонецЦикла;

		СтрокаУКД = Дерево.Строки.Добавить();
		СтрокаУКД.Номенклатура = СтрШаблон(НСтр("ru = 'УКД № %1 от %2'"),
			Корректировка.Номер, Формат(Корректировка.Дата, "ДЛФ=D"));
		СтрокаУКД.Документ = НСтр("ru = 'УКД'");

		Если НЕ Корректировка.Связана Тогда
			СтрокаУКД.Расхождения = НСтр("ru = 'Не связана с УПД: '") + Корректировка.Причина;
			СтрокаУКД.Расходится  = Истина;
		ИначеЕсли Корректировка.РасхожденийНет Тогда
			СтрокаУКД.Расхождения = НСтр("ru = 'Связана с УПД, с учётом корректировки сошлось с приходом'");
		ИначеЕсли ЗначениеЗаполнено(Корректировка.ТекстСверки) Тогда
			СтрокаУКД.Расхождения = НСтр("ru = 'Связана с УПД, не сошлось: '") + Корректировка.ТекстСверки;
			СтрокаУКД.Расходится  = Истина;
		Иначе
			СтрокаУКД.Расхождения = НСтр("ru = 'Связана с УПД, сверки с приходом ещё не было'");
		КонецЕсли;

		СтрокаУКД.Расхождения = МаркерУменьшения + СтрокаУКД.Расхождения;

		Для Каждого СтрокаКорректировки Из Корректировка.Строки Цикл
			СтрокаТовара = СтрокаУКД.Строки.Добавить();
			СтрокаТовара.Номенклатура  = СтрокаКорректировки.Наименование;
			СтрокаТовара.Документ      = НСтр("ru = 'Строка УКД'");
			СтрокаТовара.Количество    = ЧислоДляДерева(СтрокаКорректировки.Количество);
			СтрокаТовара.Цена          = ЧислоДляДерева(СтрокаКорректировки.Цена, 2);
			СтрокаТовара.Сумма         = ЧислоДляДерева(СтрокаКорректировки.Сумма, 2);
			СтрокаТовара.Расхождения   = СтрокаКорректировки.Изменение;
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Ветка ЭТрН при найденной приходной: документ и строки - сверены, не красные.
// Текст несовпадения строки остаётся с пометкой «справочно».
//
&НаСервереБезКонтекста
Процедура ОтметитьВеткуЭТрНСПриходом(СтрокаЭТрН)

	СтрокаЭТрН.Расходится = Ложь;
	СтрокаЭТрН.Сверена    = Истина;

	Для Каждого СтрокаТовара Из СтрокаЭТрН.Строки Цикл
		Если СтрокаТовара.Расходится И ЗначениеЗаполнено(СтрокаТовара.Расхождение) Тогда
			СтрокаТовара.Расхождение = НСтр("ru = 'справочно: '") + СтрокаТовара.Расхождение;
		КонецЕсли;
		СтрокаТовара.Расходится = Ложь;
		СтрокаТовара.Сверена    = Истина;
	КонецЦикла;

КонецПроцедуры

// Колонка «Расхождения (УКД)» спрятана: её текст переносится в одно поле
// «Расхождение», чтобы оператор не читал два почти одинаковых заголовка.
//
&НаСервереБезКонтекста
Процедура СвестиКолонкиРасхожденийДерева(СтрокиДерева)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если ЗначениеЗаполнено(СтрокаДерева.Расхождения) Тогда
			Если ЗначениеЗаполнено(СтрокаДерева.Расхождение) Тогда
				СтрокаДерева.Расхождение = СтрокаДерева.Расхождение + "; "
					+ СтрокаДерева.Расхождения;
			Иначе
				СтрокаДерева.Расхождение = СтрокаДерева.Расхождения;
			КонецЕсли;
		КонецЕсли;
		СвестиКолонкиРасхожденийДерева(СтрокаДерева.Строки);
	КонецЦикла;

КонецПроцедуры

// Колонка алкоголя нужна только когда в выбранной УПД есть такая строка.
//
&НаСервереБезКонтекста
Функция ВДеревеЕстьАлкоголь(СтрокиДерева)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если ЗначениеЗаполнено(СокрЛП(СтрокаДерева.Алкоголь)) Тогда
			Возврат Истина;
		КонецЕсли;
		Если ВДеревеЕстьАлкоголь(СтрокаДерева.Строки) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Тексты изменений связанных корректировок для строк УПД.
//
// Строка корректировки находит строку УПД по номеру позиции, а если свёрнутая
// строка его не сохранила - по наименованию.
//
// Возвращаемое значение:
//   Массив из Строка - в порядке строк ТоварыУПД
//
&НаСервереБезКонтекста
Функция РасхожденияУКДПоТоварам(ТоварыУПД, Корректировки)

	ЧастиПоТоварам = Новый Массив;
	Для Каждого Товар Из ТоварыУПД Цикл
		ЧастиПоТоварам.Добавить(Новый Массив);
	КонецЦикла;

	Для Каждого Корректировка Из Корректировки Цикл

		Если НЕ Корректировка.Связана Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого СтрокаКорректировки Из Корректировка.Строки Цикл

			Индекс = ИндексТовараДляСтрокиУКД(ТоварыУПД, СтрокаКорректировки);
			Если Индекс = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ЧастиПоТоварам[Индекс].Добавить(СтрШаблон(НСтр("ru = 'УКД %1: %2'"),
				Корректировка.Номер, СтрокаКорректировки.Изменение));

		КонецЦикла;

	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого Части Из ЧастиПоТоварам Цикл
		Результат.Добавить(СтрСоединить(Части, "; "));
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ИндексТовараДляСтрокиУКД(ТоварыУПД, СтрокаКорректировки)

	Для Каждого Товар Из ТоварыУПД Цикл
		Если Товар.НомерПозиции = СтрокаКорректировки.НомерПозиции Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаКорректировки.Штрихкод)
				ИЛИ ШтрихкодыСовпадаютДляДерева(Товар.Штрихкод, СтрокаКорректировки.Штрихкод)
				ИЛИ НЕ ЗначениеЗаполнено(Товар.Штрихкод) Тогда
				Возврат ТоварыУПД.Индекс(Товар);
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(СтрокаКорректировки.Штрихкод) Тогда
		Для Каждого Товар Из ТоварыУПД Цикл
			Если ШтрихкодыСовпадаютДляДерева(Товар.Штрихкод, СтрокаКорректировки.Штрихкод) Тогда
				Возврат ТоварыУПД.Индекс(Товар);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	НаименованиеНорм = НормализованноеНаименованиеДляДерева(СтрокаКорректировки.Наименование);
	Если НЕ ЗначениеЗаполнено(НаименованиеНорм) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Товар Из ТоварыУПД Цикл
		Если НормализованноеНаименованиеДляДерева(Товар.Наименование) = НаименованиеНорм Тогда
			Возврат ТоварыУПД.Индекс(Товар);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Товар Из ТоварыУПД Цикл
		Если НаименованияСовпадаютДляДерева(Товар.Наименование, СтрокаКорректировки.Наименование) Тогда
			Возврат ТоварыУПД.Индекс(Товар);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Подменяет строки УПД значениями связанных корректировок (УКД).
//
// Правила те же, что у сверки цепочки (ЭАрМ_СверкаТоваровЦепочки.
// ПрименитьКорректировки), иначе дерево и итог сверки расходились бы:
// корректировки идут по порядку дат, следующая правит уже исправленное;
// нулевые количество и сумма - товар убран из накладной; нулевое количество
// при ненулевой сумме - правка только цены; строка УКД без пары в УПД
// добавляется, чтобы расхождение было видно. Цена - сумма с НДС на
// количество, как у остальных строк дерева.
//
// Параметры:
//   ТоварыУПД     - ТаблицаЗначений - см. ТоварыДляДерева, до свёртки
//   Идентификатор - Строка - УПД в СБИС
//
// Возвращаемое значение:
//   Число - сколько строк корректировок применено
//
&НаСервереБезКонтекста
Функция ПрименитьКорректировкиДляДерева(ТоварыУПД, Идентификатор)

	СтрокиУКД = ЭАрМ_КорректировкиУПД.СтрокиКорректировок(Идентификатор);
	Если СтрокиУКД.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Если ТоварыУПД.Колонки.Найти("ИзмененоУКД") = Неопределено Тогда
		ТоварыУПД.Колонки.Добавить("ИзмененоУКД", Новый ОписаниеТипов("Булево"));
	КонецЕсли;

	Для Каждого СтрокаУКД Из СтрокиУКД Цикл

		Индекс = ИндексТовараДляСтрокиУКД(ТоварыУПД, СтрокаУКД);
		Если Индекс = Неопределено Тогда
			Товар = ТоварыУПД.Добавить();
			Товар.НомерПозиции   = СтрокаУКД.НомерПозиции;
			Товар.Позиции        = Формат(СтрокаУКД.НомерПозиции, "ЧГ=0");
			Товар.Наименование   = СокрЛП(СтрокаУКД.Наименование);
			Товар.Штрихкод       = СтрокаУКД.Штрихкод;
			Товар.Штрихкоды      = СтрокаУКД.Штрихкод;
			Товар.КоличествоМест = 0;
			Товар.СуммаНДС       = 0;
		Иначе
			Товар = ТоварыУПД[Индекс];
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Товар.Штрихкод) И ЗначениеЗаполнено(СтрокаУКД.Штрихкод) Тогда
			Товар.Штрихкод  = СтрокаУКД.Штрихкод;
			Товар.Штрихкоды = ОбъединитьШтрихкодыДляДерева(Товар.Штрихкоды, СтрокаУКД.Штрихкод);
		КонецЕсли;

		Товар.ИзмененоУКД = Истина;

		КоличествоУКД = ЧислоИлиНольДляДерева(СтрокаУКД.Количество);
		СуммаУКД      = ЧислоИлиНольДляДерева(СтрокаУКД.Сумма);

		Если КоличествоУКД = 0 И СуммаУКД = 0 Тогда
			ТоварыУПД.Удалить(Товар);
			Продолжить;
		КонецЕсли;

		// НДС в строке УКД не хранится: пересчитываем пропорционально сумме
		СуммаДо = ЧислоИлиНольДляДерева(Товар.Сумма);
		Товар.СуммаНДС = ?(СуммаДо = 0, 0,
			Окр(ЧислоИлиНольДляДерева(Товар.СуммаНДС) * СуммаУКД / СуммаДо, 2));

		Если КоличествоУКД <> 0 Тогда
			Товар.Количество = КоличествоУКД;
		КонецЕсли;
		Товар.Сумма = СуммаУКД;
		Товар.Цена  = ?(ЧислоИлиНольДляДерева(Товар.Количество) = 0, 0,
			Окр(СуммаУКД / Товар.Количество, 2));

	КонецЦикла;

	Возврат СтрокиУКД.Количество();

КонецФункции

// Складывает количество и сумму документа в его строку-заголовок.
//
// Верхняя строка каждого документа - это он сам, поэтому в товарных колонках
// у неё стоят итоги: их сравнивают между документами, не раскрывая строки.
//
&НаСервереБезКонтекста
Процедура ИтогиДокументаВДерево(СтрокаДокумента, ТоварыДокумента)

	Если ТоварыДокумента.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СтрокаДокумента.Количество = ЧислоДляДерева(
		ТоварыДокумента.Итог("Количество"));
	СтрокаДокумента.Сумма = ЧислоДляДерева(
		ТоварыДокумента.Итог("Сумма"), 2);
	СтрокаДокумента.СуммаНДС = ЧислоДляДерева(
		ТоварыДокумента.Итог("СуммаНДС"), 2);

КонецПроцедуры

// Когда УПД сошлась с приходом, все её товарные строки красятся зелёным:
// признак сверки взведён, признак расхождения снят.
//
&НаСервереБезКонтекста
Процедура ОтметитьСошедшиесяСтрокиПодУПД(СтрокаУПД)

	СтрокаУПД.Расходится = Ложь;
	СтрокаУПД.Сверена    = Истина;

	Для Каждого СтрокаТовара Из СтрокаУПД.Строки Цикл
		СтрокаТовара.Расходится = Ложь;
		СтрокаТовара.Сверена    = Истина;
	КонецЦикла;

КонецПроцедуры

// Добавляет отдельный документ цепочки со списком несошедшихся позиций.
//
// Расхождения Далиона - это его собственный вердикт по приёмке, а здесь
// итог нашей сверки строка в строку. Когда всё сошлось, строки нет: пустой
// заголовок "Расхождений нет" пришлось бы читать на каждом документе.
//
&НаСервереБезКонтекста
Процедура ДобавитьСтрокуРасхожденийВДерево(Дерево, НайденныеРасхождения)

	Если НайденныеРасхождения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СтрокаИтога = Дерево.Строки.Добавить();
	СтрокаИтога.Номенклатура = СтрШаблон(
		НСтр("ru = 'Расхождения с Далионом: %1'"),
		НайденныеРасхождения.Количество());
	СтрокаИтога.Документ   = НСтр("ru = 'Контроль'");
	СтрокаИтога.Расходится = Истина;

	// Колонки количества и цены общие для всех документов, поэтому строка
	// расхождения несёт значения УПД, а значения прихода - её подстрока
	Для Каждого Расхождение Из НайденныеРасхождения Цикл
		СтрокаРасхождения = СтрокаИтога.Строки.Добавить();
		СтрокаРасхождения.Номенклатура = Расхождение.Наименование;
		СтрокаРасхождения.Документ     = НСтр("ru = 'Расхождение'");
		СтрокаРасхождения.Количество   = Расхождение.КоличествоУпд;
		СтрокаРасхождения.Цена         = Расхождение.ЦенаУпд;
		СтрокаРасхождения.Расхождение  = Расхождение.Текст;
		СтрокаРасхождения.Расходится   = Истина;

		Если НЕ ЗначениеЗаполнено(Расхождение.КоличествоДалион)
			И НЕ ЗначениеЗаполнено(Расхождение.ЦенаДалион) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаПрихода = СтрокаРасхождения.Строки.Добавить();
		СтрокаПрихода.Номенклатура = Расхождение.Наименование;
		СтрокаПрихода.Документ     = НСтр("ru = 'Приход Далиона'");
		СтрокаПрихода.Количество   = Расхождение.КоличествоДалион;
		СтрокаПрихода.Цена         = Расхождение.ЦенаДалион;
		СтрокаПрихода.Расходится   = Истина;
	КонецЦикла;

КонецПроцедуры

// Реестр УПД только показывает уже сверенную цепочку. Пары товаров и
// «Расхождений нет» пишет сверка по штрихкодам до этой формы
// (ЭАрМ_ШтрихкодыПоставщиков, ЭАрМ_РеестрТоваровЗаказов). Флажок «Авто» -
// выключатель автоподписания: со снятым флажком подписание остаётся ручным.
//
&НаСервереБезКонтекста
Процедура ОбработатьРезультатСверки(Идентификатор, ШапкаУПД, НайденныеРасхождения, ПриходДалион = Неопределено,
	СтрокиСошлись = Ложь, ИтогИзменён = Ложь)

	ЕстьПриход = ЗначениеЗаполнено(ШапкаУПД.НомерДокументаДалион)
		ИЛИ (ПриходДалион <> Неопределено И ЗначениеЗаполнено(ПриходДалион.НомерДокумента));

	ИтогИзменён = ОтметитьРасхожденияДерева(Идентификатор, ШапкаУПД, НайденныеРасхождения,
		ЕстьПриход, СтрокиСошлись);
	ЭАрМ_РегламентныйОбменЭДО.ОбновитьПризнакЭТрНРеестраУПД(Идентификатор);

	// Список перечитывает клиент, только если отметка в реестре изменилась
	// (ИтогИзменён): на каждый выбор строки Обновить() сдвигал бы прокрутку,
	// а без него строка, сошедшаяся в дереве, оставалась красной до снимка (120 с)

	Если НЕ ЭАрМ_ПанельУправленияЭДОСервер.АвтоотправкаВключена() Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЕстьПриход Тогда
		Возврат;
	КонецЕсли;

	// Тестовые УПД (кнопки «Тест сверки» / «Тест из XML УПД») в СБИС не уходят:
	// такого документа там нет, а подпись или запрос корректировки - это обмен с СБИС
	Если СтрНачинаетсяС(ВРег(Идентификатор), "ТЕСТ") Тогда
		ЭАрМ_ПриемПакетовДалион.Трасса(Идентификатор,
			"Дерево УПД: тестовая УПД - автоподписание и запрос корректировки в СБИС пропущены", Истина);
		Возврат;
	КонецЕсли;

	Если НайденныеРасхождения.Количество() = 0 Тогда
		ПодписатьИОтправитьУПД(Идентификатор, ШапкаУПД);
	Иначе
		ЗапроситьКорректировкуУПД(Идентификатор, ШапкаУПД, НайденныеРасхождения);
	КонецЕсли;

КонецПроцедуры

// Приводит отметку «Расхождений нет» в реестре УПД к тому, что показало
// дерево товаров.
//
// Таблица нашла расхождения, а в реестре итога нет или стоит «Расхождений
// нет» - пишем «Не сошлась итоговая сумма», строка краснеет.
//
// Товары дерева сошлись полностью, а в реестре «Расхождений нет» не стоит -
// ставим: строка зеленеет. Раньше форма только понижала, а поднимала одна
// сверка цепочки - и строка оставалась красной, хотя товары сошлись: УПД не
// связана с цепочкой (приход найден по номеру/ЭТрН), цепочка закрыта пломбой
// и не пересверяется, или сверка свернула строки иначе, чем дерево. Перед
// подписью итоговая сумма всё равно пересчитывается заново
// (ЭАрМ_УтверждениеСБИС.ЗапретУтверждения).
//
// Возвращаемое значение:
//   Булево - отметка в реестре изменена
//
&НаСервереБезКонтекста
Функция ОтметитьРасхожденияДерева(Идентификатор, ШапкаУПД, НайденныеРасхождения, ЕстьПриход,
	СтрокиСошлись = Ложь)

	Если НЕ ЕстьПриход Тогда
		Возврат Ложь;
	КонецЕсли;

	// Аннулированная УПД остаётся красной с текстом о замене
	Если ЭАрМ_УтверждениеСБИС.ДокументРеестраЗакрыт("ЭАрМ_УПД_Входящий", Идентификатор) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрокиСошлись Тогда
		Если ШапкаУПД.РасхожденийНет Тогда
			Возврат Ложь;
		КонецЕсли;
		Попытка
			ЭАрМ_КорректировкиУПД.ЗафиксироватьИтогСверки(Идентификатор, Истина,
				НСтр("ru = 'Сошлось: товары УПД и прихода Далиона совпали по итоговой сумме (реестр УПД)'"));
			Возврат Истина;
		Исключение
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Идентификатор, "СверкаФормы", Ложь,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;

	Если НайденныеРасхождения.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ШапкаУПД.РасхожденийНет И ЗначениеЗаполнено(СокрЛП(ШапкаУПД.ТекстСверки)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Расхождение Из НайденныеРасхождения Цикл
		Части.Добавить(СтрШаблон("%1: %2", Лев(Расхождение.Наименование, 60), Расхождение.Текст));
		Если Части.Количество() >= 10 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Попытка
		ЭАрМ_КорректировкиУПД.ЗафиксироватьИтогСверки(Идентификатор, Ложь,
			"Не сошлась итоговая сумма: " + СтрСоединить(Части, Символы.ПС));
	Исключение
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Идентификатор, "СверкаФормы", Ложь,
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Подписывает сошедшуюся УПД и отправляет её обратно в СБИС.
//
// В разработке.
//
// Подписание в базе уже есть: ЭАрМ_ОбработкаПодтвержденийЭДО.
// ПодписатьИОтправитьПослеПодтверждения гоняет документ по набору действий
// БСП - утвердить, подписать, подготовить к отправке, отправить. Нужен ей
// ЭлектронныйДокумент базы, а у нас на руках только идентификатор документа
// в СБИС: связи между ними ни один регистр подсистемы не хранит, и пока она
// не заведена, вызывать подписание не по чему.
//
&НаСервереБезКонтекста
Процедура ПодписатьИОтправитьУПД(Идентификатор, ШапкаУПД)

КонецПроцедуры

// Запрашивает у поставщика корректировку по несошедшейся УПД.
//
// В разработке.
//
// До прихода корректировочного документа УПД остаётся в статусе рассмотрения:
// подписывать накладную, которая разошлась с фактическим приходом, нельзя.
//
&НаСервереБезКонтекста
Процедура ЗапроситьКорректировкуУПД(Идентификатор, ШапкаУПД, НайденныеРасхождения)

КонецПроцедуры

// Добавляет товарные строки документа и подставляет рядом данные прихода.
//
// Параметры:
//   Родитель, ТоварыДокумента, ВидСтроки, ТоварыДалион, ИспользованныеСтроки
//   НайденныеРасхождения - Массив - пополняется описаниями несошедшихся
//                          позиций; Неопределено - расхождения не собираем
//   ОтметкиСтрок         - Соответствие - ручная сверка строк УПД; для ЭТрН
//                          не передаётся
//
&НаСервереБезКонтекста
Процедура ДобавитьТоварыВДерево(
		Родитель, ТоварыДокумента, ВидСтроки, ТоварыДалион, ИспользованныеСтроки,
		НайденныеРасхождения = Неопределено, ПарыРеестра = Неопределено,
		ОтметкиСтрок = Неопределено)

	// Пары сверки цепочки - окончательные: строки линий реестра в собственный
	// подбор формы не идут, даже если остались без пары
	ЗафиксированныеТовары = Новый Соответствие;
	ПарыТоваров = Новый Соответствие;
	Если ПарыРеестра <> Неопределено Тогда
		Для Каждого КлючЗначение Из ПарыРеестра.Пары Цикл
			ПарыТоваров.Вставить(КлючЗначение.Ключ, ТоварыДалион[КлючЗначение.Значение]);
		КонецЦикла;
		Для Каждого КлючЗначение Из ПарыРеестра.СтрокиУПД Цикл
			ЗафиксированныеТовары.Вставить(КлючЗначение.Ключ, Истина);
		КонецЦикла;
		Для Каждого КлючЗначение Из ПарыРеестра.СтрокиПрихода Цикл
			ИспользованныеСтроки.Вставить(Строка(КлючЗначение.Ключ), Истина);
		КонецЦикла;
	КонецЕсли;

	Для Каждого КлючЗначение Из ПодобратьПарыДляДерева(ТоварыДокумента, ТоварыДалион,
		ИспользованныеСтроки, ЗафиксированныеТовары) Цикл
		ПарыТоваров.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	ЕстьПризнакУКД = ТоварыДокумента.Колонки.Найти("ИзмененоУКД") <> Неопределено;
	ЕстьАлкоголь   = ТоварыДокумента.Колонки.Найти("Алкоголь") <> Неопределено;
	ЕстьПозиции    = ТоварыДокумента.Колонки.Найти("Позиции") <> Неопределено;
	ЕстьШтрихкоды  = ТоварыДокумента.Колонки.Найти("Штрихкоды") <> Неопределено;
	ЕстьШтрихкод   = ТоварыДокумента.Колонки.Найти("Штрихкод") <> Неопределено;

	Для Каждого Товар Из ТоварыДокумента Цикл

		СтрокаТовара = Родитель.Строки.Добавить();
		СтрокаТовара.Номенклатура  = Товар.Наименование;
		ШтрихкодыТовара = "";
		Если ЕстьШтрихкоды Тогда
			ШтрихкодыТовара = Строка(Товар.Штрихкоды);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ШтрихкодыТовара) И ЕстьШтрихкод Тогда
			ШтрихкодыТовара = Строка(Товар.Штрихкод);
		КонецЕсли;
		СтрокаТовара.ЕстьВУТ = ЭАрМ_КатегорииТоваров.ЕстьКарточкаУТПоШтрихкодам(ШтрихкодыТовара);
		СтрокаТовара.Документ      = ВидСтроки;
		Если ЕстьПризнакУКД И Товар.ИзмененоУКД = Истина Тогда
			СтрокаТовара.Документ  = ВидСтроки + НСтр("ru = ' (изменён УКД)'");
		КонецЕсли;
		СтрокаТовара.Количество    = ЧислоДляДерева(Товар.Количество);
		СтрокаТовара.Цена          = ЧислоДляДерева(Товар.Цена, 2);
		СтрокаТовара.Сумма         = ЧислоДляДерева(Товар.Сумма, 2);
		СтрокаТовара.СтавкаНДС     = СокрЛП(Товар.СтавкаНДС);
		СтрокаТовара.СуммаНДС      = ЧислоДляДерева(Товар.СуммаНДС, 2);
		// Признак алкоголя строки (ЭАрМ_АлкогольЕГАИС) - только у строк УПД
		Если ЕстьАлкоголь И ТипЗнч(Товар.Алкоголь) = Тип("Строка") Тогда
			СтрокаТовара.Алкоголь = Товар.Алкоголь;
		КонецЕсли;
		Если ЕстьПозиции Тогда
			СтрокаТовара.Позиции = СокрЛП(Товар.Позиции);
		КонецЕсли;

		ТоварДалион = ПарыТоваров.Получить(ТоварыДокумента.Индекс(Товар));

		// Пара прихода нужна плоской таблице формы: значения Далиона встают
		// в ту же строку, что и товар документа
		Если ТоварДалион <> Неопределено Тогда
			СтрокаТовара.ИндексПрихода = XMLСтрока(ТоварыДалион.Индекс(ТоварДалион));
			СтрокаТовара.КолДалион     = ЧислоДляДерева(ТоварДалион.Количество);
			СтрокаТовара.ЦенаДалион    = ЧислоДляДерева(ТоварДалион.Цена, 2);
			СтрокаТовара.СуммаДалион   = ЧислоДляДерева(ТоварДалион.Сумма, 2);
		КонецЕсли;

		ОтметкаСтроки = ?(НайденныеРасхождения = Неопределено, Неопределено,
			ЭАрМ_КорректировкиУПД.ОтметкаСтрокиСверкиВручную(
				ОтметкиСтрок, СтрокаТовара.Позиции, Товар.Наименование));

		// Строка без пары - тоже расхождение: раньше она молча оставалась
		// белой, и несошедшийся товар ловил только итог по числу строк
		Если ТоварДалион = Неопределено Тогда
			Если ТоварыДалион.Количество() > 0 Тогда
				ТекстБезПары = ПричинаБезПарыДляДерева(Товар);
				Если ОтметкаСтроки <> Неопределено Тогда
					ОтметитьСтрокуСвереннойВДереве(СтрокаТовара, ОтметкаСтроки, ТекстБезПары);
				Иначе
					СтрокаТовара.Расхождение = ТекстБезПары;
					СтрокаТовара.Расходится  = Истина;
					Родитель.Расходится      = Истина;
					ЗапомнитьРасхождение(НайденныеРасхождения, Товар, Неопределено,
						СтрокаТовара.Расхождение);
					ОтметитьБезПарыДляДерева(СтрокаТовара, Товар, НайденныеРасхождения);
				КонецЕсли;
			ИначеЕсли НайденныеРасхождения <> Неопределено Тогда
				// Приходной нет: строка остаётся белой. В итог сверки это не идёт
				СтрокаТовара.Расхождение = НСтр("ru = 'нет приходной'");
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ТоварДалион.Количество = 0 И Товар.Количество > 0 Тогда
			ТекстНетВПриходе = НСтр("ru = 'нет в приходе Далиона'");
			Если ОтметкаСтроки <> Неопределено Тогда
				ОтметитьСтрокуСвереннойВДереве(СтрокаТовара, ОтметкаСтроки, ТекстНетВПриходе);
			Иначе
				СтрокаТовара.Расхождение = ТекстНетВПриходе;
				СтрокаТовара.Расходится  = Истина;
				Родитель.Расходится      = Истина;
				ЗапомнитьРасхождение(НайденныеРасхождения, Товар, Неопределено,
					СтрокаТовара.Расхождение);
				ОтметитьБезПарыДляДерева(СтрокаТовара, Товар, НайденныеРасхождения);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		// Строка документа показывает свои количество и цену; значения
		// прихода - в ветке Далиона и в тексте расхождения
		СтрокаТовара.Сверена     = Истина;
		СтрокаТовара.Расхождение = РасхождениеСтрокДляДерева(Товар, ТоварДалион);

		Если ОтметкаСтроки <> Неопределено Тогда
			Если ЗначениеЗаполнено(СтрокаТовара.Расхождение) Тогда
				ОтметитьСтрокуСвереннойВДереве(СтрокаТовара, ОтметкаСтроки, СтрокаТовара.Расхождение);
			Иначе
				СтрокаТовара.СвереноВручную = Истина;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(СтрокаТовара.Расхождение) Тогда
			СтрокаТовара.Расходится = Истина;
			Родитель.Расходится     = Истина;
			ЗапомнитьРасхождение(НайденныеРасхождения, Товар, ТоварДалион,
				СтрокаТовара.Расхождение);
		КонецЕсли;

	КонецЦикла;

	// Строки прихода, которым не нашлось товара документа
	Если НайденныеРасхождения = Неопределено ИЛИ ТоварыДокумента.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ТоварДалион Из ТоварыДалион Цикл
		Если ИспользованныеСтроки.Получить(Строка(ТоварыДалион.Индекс(ТоварДалион))) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Описание = Новый Структура;
		Описание.Вставить("Наименование",     ТоварДалион.Наименование);
		Описание.Вставить("КоличествоУпд",    "");
		Описание.Вставить("ЦенаУпд",          "");
		Описание.Вставить("КоличествоДалион", ЧислоДляДерева(ТоварДалион.Количество));
		Описание.Вставить("ЦенаДалион",       ЧислоДляДерева(ТоварДалион.Цена, 2));
		Описание.Вставить("Текст",            НСтр("ru = 'есть в приходе Далиона, нет в документе'"));
		НайденныеРасхождения.Добавить(Описание);
	КонецЦикла;

КонецПроцедуры

// Строка УПД без пары в приходе: ей можно выбрать пару в колонке
// «Пара в приходе». Только строки УПД - расхождения собираются только по ним.
//
&НаСервереБезКонтекста
Процедура ОтметитьБезПарыДляДерева(СтрокаТовара, Товар, НайденныеРасхождения)

	Если НайденныеРасхождения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаТовара.БезПары = Истина;

	Колонки = Товар.Владелец().Колонки;
	Если Колонки.Найти("Штрихкод") <> Неопределено И ТипЗнч(Товар.Штрихкод) = Тип("Строка") Тогда
		СтрокаТовара.ШтрихкодыСтроки = СокрЛП(Товар.Штрихкод);
	КонецЕсли;
	Если Колонки.Найти("КодТовараПоставщика") <> Неопределено
		И ТипЗнч(Товар.КодТовараПоставщика) = Тип("Строка") Тогда
		СтрокаТовара.КодПоставщика = СокрЛП(Товар.КодТовараПоставщика);
	КонецЕсли;

КонецПроцедуры

// Строка, принятая человеком: зелёная, с текстом кто и почему. В список
// расхождений документа не попадает - итоговая сумма считается отдельно.
//
&НаСервереБезКонтекста
Процедура ОтметитьСтрокуСвереннойВДереве(СтрокаТовара, Отметка, ТекстБыло)

	СтрокаТовара.Сверена = Истина;
	СтрокаТовара.Расходится = Ложь;
	СтрокаТовара.БезПары = Ложь;
	СтрокаТовара.СвереноВручную = Истина;
	СтрокаТовара.Расхождение = СтрШаблон(НСтр("ru = 'Сверено вручную (%1: %2)'"),
		Отметка.Кем, Отметка.Комментарий);
	Если ЗначениеЗаполнено(ТекстБыло) Тогда
		СтрокаТовара.Расхождение = СтрокаТовара.Расхождение
			+ НСтр("ru = '. Было: '") + ТекстБыло;
	КонецЕсли;

КонецПроцедуры

// Список выбора колонки «Пара в приходе» - строки прихода Далиона текущего
// дерева; сначала те, что не нашли товара УПД.
//
&НаСервереБезКонтекста
Функция ВариантыПарыПрихода(Дерево)

	Результат = Новый Массив;
	Остальные = Новый Массив;
	Для Каждого СтрокаДокумента Из Дерево.Строки Цикл
		Для Каждого СтрокаФакта Из СтрокаДокумента.Строки Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаФакта.ВариантПары) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаФакта.Расходится Тогда
				Результат.Добавить(СтрокаФакта.ВариантПары);
			Иначе
				Остальные.Добавить(СтрокаФакта.ВариантПары);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Вариант Из Остальные Цикл
		Результат.Добавить(Вариант);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Копит описание несошедшейся позиции для отдельного документа расхождений.
//
&НаСервереБезКонтекста
Процедура ЗапомнитьРасхождение(НайденныеРасхождения, Товар, ТоварДалион, Текст)

	Если НайденныеРасхождения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("Наименование",     Товар.Наименование);
	Описание.Вставить("КоличествоУпд",    ЧислоДляДерева(Товар.Количество));
	Описание.Вставить("ЦенаУпд",          ЧислоДляДерева(Товар.Цена, 2));
	Описание.Вставить("КоличествоДалион",
		?(ТоварДалион = Неопределено, "", ЧислоДляДерева(ТоварДалион.Количество)));
	Описание.Вставить("ЦенаДалион",
		?(ТоварДалион = Неопределено, "", ЧислоДляДерева(ТоварДалион.Цена, 2)));
	Описание.Вставить("Текст",            Текст);

	НайденныеРасхождения.Добавить(Описание);

КонецПроцедуры

// Строка дерева: какая сумма больше и на сколько. Пишется, когда разница
// уложилась в погрешность - по сумме УПД готова к утверждению. Сверх допуска
// ту же фразу несёт красная строка расхождений.
//
&НаСервереБезКонтекста
Процедура ДобавитьСтрокуРазницыСумм(Дерево, СуммаУПД, СуммаПН, ВДопуске, ЕстьПриход)

	Если НЕ ЕстьПриход ИЛИ НЕ ВДопуске Тогда
		Возврат;
	КонецЕсли;

	ТекстРазницы = ЭАрМ_СверкаТоваровЦепочки.ТекстКудаБольшеСумма(СуммаУПД, СуммаПН);
	Если НЕ ЗначениеЗаполнено(ТекстРазницы) Тогда
		Возврат;
	КонецЕсли;

	СтрокаРазницы = Дерево.Строки.Добавить();
	СтрокаРазницы.Документ = НСтр("ru = 'Сумма'");
	СтрокаРазницы.Номенклатура = ТекстРазницы + НСтр("ru = ' — в допуске, по сумме готова к утверждению'");
	СтрокаРазницы.Сверена = Истина;
	СтрокаРазницы.Расходится = Ложь;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьИтогиДокументовВРасхождения(НайденныеРасхождения, ПозицийУПД, ПозицийПН,
	СуммаУПД, СуммаПН)

	Если ПозицийУПД = 0 ИЛИ ПозицийПН = 0 Тогда
		Возврат;
	КонецЕсли;

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();

	Если ПозицийУПД <> ПозицийПН Тогда
		ЗапомнитьИтоговоеРасхождение(НайденныеРасхождения,
			НСтр("ru = 'Число строк'"),
			ПозицийУПД, ПозицийПН, 0, 0,
			СтрШаблон(НСтр("ru = 'позиций строк: УПД %1, приход %2'"), ПозицийУПД, ПозицийПН));
	КонецЕсли;

	Если НЕ ЭАрМ_СверкаТоваровЦепочки.СуммыИтогаВДопуске(СуммаУПД, СуммаПН, Настройки) Тогда
		ТекстРазницы = ЭАрМ_СверкаТоваровЦепочки.ТекстКудаБольшеСумма(СуммаУПД, СуммаПН);
		ЗапомнитьИтоговоеРасхождение(НайденныеРасхождения,
			НСтр("ru = 'Итоговая сумма'"),
			0, 0, СуммаУПД, СуммаПН,
			СтрШаблон(НСтр("ru = '%1 (УПД %2, приход %3) — больше допуска, к утверждению не готова'"),
				ТекстРазницы, ЧислоДляДерева(СуммаУПД, 2), ЧислоДляДерева(СуммаПН, 2)));
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗапомнитьИтоговоеРасхождение(НайденныеРасхождения, Наименование,
	КоличествоУпд, КоличествоДалион, ЦенаУпд, ЦенаДалион, Текст)

	Описание = Новый Структура;
	Описание.Вставить("Наименование",     Наименование);
	Описание.Вставить("КоличествоУпд",    ЧислоДляДерева(КоличествоУпд));
	Описание.Вставить("ЦенаУпд",          ЧислоДляДерева(ЦенаУпд, 2));
	Описание.Вставить("КоличествоДалион", ЧислоДляДерева(КоличествоДалион));
	Описание.Вставить("ЦенаДалион",       ЧислоДляДерева(ЦенаДалион, 2));
	Описание.Вставить("Текст",            Текст);
	НайденныеРасхождения.Добавить(Описание);

КонецПроцедуры

// Добавляет строку принятого Далионом документа с его фактическими товарами.
//
// Родителем приходит само дерево: приход - такой же документ цепочки, как
// УПД и ЭТрН, и стоит с ними в одном ряду.
//
&НаСервереБезКонтекста
Процедура ДобавитьВеткуДалионаВДерево(Родитель, Приход, ТоварыДалион,
	ИспользованныеДляУПД = Неопределено)

	Если НЕ ЗначениеЗаполнено(Приход.НомерДокумента)
		И НЕ ЗначениеЗаполнено(Приход.Статус)
		И ТоварыДалион.Количество() = 0
		И НЕ Приход.ЕстьРасхождения Тогда
		Возврат;
	КонецЕсли;

	СтрокаДалион = Родитель.Строки.Добавить();
	СтрокаДалион.Номенклатура = ПредставлениеПриходаДляДерева(Приход);
	СтрокаДалион.Документ     = НСтр("ru = 'Далион'");
	СтрокаДалион.Расхождение  = СокрЛП(Приход.Статус);

	// Количество считаем по строкам, сумму берём из шапки: её База2 посчитала
	// сама, и расходись она с итогом строк - это тоже разговор к приёмке
	СтрокаДалион.Сверена    = Истина;
	СтрокаДалион.Количество = ЧислоДляДерева(
		ТоварыДалион.Итог("Количество"));
	СтрокаДалион.Сумма = ЧислоДляДерева(?(ЗначениеЗаполнено(Приход.Сумма),
		Приход.Сумма, ТоварыДалион.Итог("Сумма")), 2);

	ЕстьШтрихкоды = ТоварыДалион.Колонки.Найти("Штрихкоды") <> Неопределено;
	ЕстьКлючи     = ТоварыДалион.Колонки.Найти("КлючиНоменклатуры") <> Неопределено;

	Для Каждого ТоварДалион Из ТоварыДалион Цикл
		СтрокаФакта = СтрокаДалион.Строки.Добавить();
		СтрокаФакта.Номенклатура     = ТоварДалион.Наименование;
		СтрокаФакта.ЕстьВУТ          = ЭАрМ_КатегорииТоваров.ЕстьКарточкаУТПоШтрихкодам(
			?(ЕстьШтрихкоды И ТипЗнч(ТоварДалион.Штрихкоды) = Тип("Строка"), ТоварДалион.Штрихкоды, ""));
		СтрокаФакта.Документ         = НСтр("ru = 'Товар Далиона'");
		СтрокаФакта.Сверена          = Истина;
		СтрокаФакта.Количество       = ЧислоДляДерева(ТоварДалион.Количество);
		СтрокаФакта.Цена             = ЧислоДляДерева(ТоварДалион.Цена, 2);
		СтрокаФакта.Сумма            = ЧислоДляДерева(ТоварДалион.Сумма, 2);
		СтрокаФакта.СуммаНДС         = ЧислоДляДерева(ТоварДалион.СуммаНДС, 2);
		СтрокаФакта.СтавкаНДС        = СокрЛП(ТоварДалион.СтавкаНДС);
		// Строка прихода, которой не нашлось товара УПД, - красная
		Если ИспользованныеДляУПД <> Неопределено
			И ИспользованныеДляУПД.Получить(Строка(ТоварыДалион.Индекс(ТоварДалион))) = Неопределено Тогда
			СтрокаФакта.Расхождение = НСтр("ru = 'нет в УПД'");
			СтрокаФакта.Расходится  = Истина;
			СтрокаДалион.Расходится = Истина;
		КонецЕсли;
		// Для выбора пары строке УПД: штрихкоды и номенклатура Далиона строки
		Если ЕстьШтрихкоды И ТипЗнч(ТоварДалион.Штрихкоды) = Тип("Строка") Тогда
			СтрокаФакта.ШтрихкодыСтроки = ТоварДалион.Штрихкоды;
		КонецЕсли;
		Если ЕстьКлючи И ТипЗнч(ТоварДалион.КлючиНоменклатуры) = Тип("Строка") Тогда
			СтрокаФакта.КлючиНоменклатуры = ТоварДалион.КлючиНоменклатуры;
		КонецЕсли;
		СтрокаФакта.ВариантПары = СтрШаблон("%1. %2 — %3 × %4%5",
			ТоварыДалион.Индекс(ТоварДалион) + 1, СтрокаФакта.Номенклатура,
			СтрокаФакта.Количество, СтрокаФакта.Цена,
			?(СтрокаФакта.Расходится, НСтр("ru = ' (нет в УПД)'"), ""));
	КонецЦикла;

	Если НЕ Приход.ЕстьРасхождения Тогда
		Возврат;
	КонецЕсли;

	ГруппаРасхождений = СтрокаДалион.Строки.Добавить();
	ГруппаРасхождений.Номенклатура = НСтр("ru = 'Расхождения'");
	ГруппаРасхождений.Документ     = НСтр("ru = 'Контроль'");

	ТекстРасхождений = Приход.ТекстРасхождений;
	Если НЕ ЗначениеЗаполнено(ТекстРасхождений) Тогда
		ТекстРасхождений = Приход.Комментарий;
	КонецЕсли;

	Для Каждого ТекстРасхождения Из СтрРазделить(ТекстРасхождений, Символы.ПС, Ложь) Цикл
		Если НЕ ЗначениеЗаполнено(СокрЛП(ТекстРасхождения)) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРасхождения = ГруппаРасхождений.Строки.Добавить();
		СтрокаРасхождения.Номенклатура = СокрЛП(ТекстРасхождения);
		СтрокаРасхождения.Документ     = НСтр("ru = 'Расхождение'");
	КонецЦикла;

КонецПроцедуры

// Шапка УПД из реестра вместе с тем, что о ней прислал Далион.
//
// Возвращаемое значение:
//   Структура - реквизиты документа и приходной накладной Далиона
//   Неопределено - строки реестра нет
//
&НаСервереБезКонтекста
Функция ШапкаУПДДляДерева(Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.Представление КАК Представление,
	|	УПД.Контрагент КАК Контрагент,
	|	УПД.ИННКонтрагента КАК ИННКонтрагента,
	|	УПД.Состояние КАК Состояние,
	|	УПД.РасхожденийНет КАК РасхожденийНет,
	|	УПД.ТекстСверки КАК ТекстСверки,
	|	УПД.КлючиСвязи КАК КлючиСвязи,
	|	УПД.СтатусДалион КАК СтатусДалион,
	|	УПД.НомерДокументаДалион КАК НомерДокументаДалион,
	|	УПД.ДатаДокументаДалион КАК ДатаДокументаДалион,
	|	УПД.СуммаДокументаДалион КАК СуммаДокументаДалион,
	|	УПД.КомментарийДалион КАК КомментарийДалион
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.ИдентификаторСБИС = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура(
		"Номер, Дата, Представление, Контрагент, ИННКонтрагента, Состояние, РасхожденийНет, ТекстСверки, КлючиСвязи,"
		+ "СтатусДалион, НомерДокументаДалион, ДатаДокументаДалион,"
		+ "СуммаДокументаДалион, КомментарийДалион");
	ЗаполнитьЗначенияСвойств(Результат, Выборка);

	Возврат Результат;

КонецФункции

// Приходная накладная Далиона, относящаяся к цепочке.
//
// Накладную Далион заводит по номеру УПД и присылает её выгрузкой
// result_receipts, поэтому шапка лежит в реестре УПД. Реестр ЭТрН остаётся
// запасным источником: по нему работает приёмка, и только она считает
// расхождения, поэтому расхождения берутся оттуда всегда.
//
// Возвращаемое значение:
//   Структура - НомерДокумента, Дата, Сумма, Статус, Комментарий,
//               ЕстьРасхождения, ТекстРасхождений
//
&НаСервереБезКонтекста
Функция ПриходДалионаДляДерева(ШапкаУПД, СвязаннаяЭТрН, Цепочка = Неопределено)

	Приход = Новый Структура;
	Приход.Вставить("НомерДокумента", "");
	Приход.Вставить("Дата", '00010101');
	Приход.Вставить("Сумма", 0);
	Приход.Вставить("Статус", "");
	Приход.Вставить("Комментарий", "");
	Приход.Вставить("ЕстьРасхождения", Ложь);
	Приход.Вставить("ТекстРасхождений", "");

	Если Цепочка <> Неопределено Тогда
		Приход.НомерДокумента   = СокрЛП(Цепочка.НомерПоступления);
		Приход.Дата             = Цепочка.ДатаПоступления;
		Приход.Сумма            = Цепочка.СуммаПоступления;
		Приход.ЕстьРасхождения  = Цепочка.ЕстьРасхождения;
		Приход.ТекстРасхождений = СокрЛП(Цепочка.ТекстРасхождений);
		Если Цепочка.ЕстьРасхождения Тогда
			Приход.Статус = НСтр("ru = 'Расхождения'");
		ИначеЕсли ЗначениеЗаполнено(Цепочка.ДатаСверки) Тогда
			Приход.Статус = НСтр("ru = 'Сверено'");
		ИначеЕсли Цепочка.ПроведеноПоступление Тогда
			Приход.Статус = НСтр("ru = 'Проведен'");
		Иначе
			Приход.Статус = НСтр("ru = 'Получен'");
		КонецЕсли;
		Приход.Комментарий = Приход.ТекстРасхождений;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Приход.НомерДокумента) Тогда
		Если ЗначениеЗаполнено(ШапкаУПД.НомерДокументаДалион)
			ИЛИ ЗначениеЗаполнено(ШапкаУПД.СтатусДалион) Тогда
			Приход.НомерДокумента = СокрЛП(ШапкаУПД.НомерДокументаДалион);
			Приход.Дата           = ШапкаУПД.ДатаДокументаДалион;
			Приход.Сумма          = ШапкаУПД.СуммаДокументаДалион;
			Приход.Статус         = СокрЛП(ШапкаУПД.СтатусДалион);
			Приход.Комментарий    = СокрЛП(ШапкаУПД.КомментарийДалион);
		Иначе
			Приход.НомерДокумента = СокрЛП(СвязаннаяЭТрН.НомерДокументаДалион);
			Приход.Статус         = СокрЛП(СвязаннаяЭТрН.СтатусДалион);
			Приход.Комментарий    = СокрЛП(СвязаннаяЭТрН.КомментарийДалион);
		КонецЕсли;
	КонецЕсли;

	Если НЕ Приход.ЕстьРасхождения Тогда
		Приход.ЕстьРасхождения  = СвязаннаяЭТрН.ЕстьРасхождения;
		Приход.ТекстРасхождений = СвязаннаяЭТрН.РасхожденияДалион;
	КонецЕсли;

	Возврат Приход;

КонецФункции

// Название ветки приходной накладной.
//
&НаСервереБезКонтекста
Функция ПредставлениеПриходаДляДерева(Приход)

	Если НЕ ЗначениеЗаполнено(Приход.НомерДокумента) Тогда
		Возврат НСтр("ru = 'Документ Далиона'");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Приход.Дата) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Приходная накладная № %1'"),
			Приход.НомерДокумента);
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Приходная накладная № %1 от %2'"),
		Приход.НомерДокумента, Формат(Приход.Дата, "ДЛФ=D"));

КонецФункции

// Фактические строки прихода: сначала пакет цепочки (тот же источник, что
// у сверки), затем запасные строки База2 под УПД или ЭТрН.
//
&НаСервереБезКонтекста
Функция ТоварыПриходаДляДерева(ИдентификаторУПД, ИдентификаторЭТрН, Цепочка = Неопределено,
	ИзПакета = Ложь)

	ИзПакета = Ложь;

	Товары = ТоварыДляДерева("", "База2");

	Если Цепочка <> Неопределено И ЗначениеЗаполнено(Цепочка.ИдентификаторПоступления) Тогда
		НомерСтроки = 0;
		Для Каждого Позиция Из ЭАрМ_ЦепочкаЗакупки.ПозицииПоступления(Цепочка.ИдентификаторПоступления) Цикл
			НомерСтроки = НомерСтроки + 1;
			СтрокаТовара = Товары.Добавить();
			СтрокаТовара.НомерПозиции     = НомерСтроки;
			СтрокаТовара.Наименование     = Позиция.Наименование;
			СтрокаТовара.КодНоменклатуры  = Позиция.КодНоменклатуры;
			СтрокаТовара.Артикул          = Позиция.Артикул;
			СтрокаТовара.Штрихкод         = Позиция.Штрихкод;
			СтрокаТовара.Количество       = Позиция.Количество;
			СтрокаТовара.Цена             = Позиция.Цена;
			СтрокаТовара.Сумма            = ?(Позиция.Свойство("СуммаСНДС"),
				Позиция.СуммаСНДС, Позиция.Сумма);
			СтрокаТовара.СуммаНДС         = Позиция.СуммаНДС;
			СтрокаТовара.СтавкаНДС        = Позиция.СтавкаНДС;
			СтрокаТовара.КоличествоМест   = 0;
			Если Позиция.Свойство("Штрихкоды") Тогда
				СтрокаТовара.Штрихкоды = СтрСоединить(Позиция.Штрихкоды, ";");
			Иначе
				СтрокаТовара.Штрихкоды = СокрЛП(Позиция.Штрихкод);
			КонецЕсли;
			СтрокаТовара.КлючиНоменклатуры = КлючиНоменклатурыДляДерева(
				?(Позиция.Свойство("ИдентификаторНоменклатуры"), Позиция.ИдентификаторНоменклатуры, ""),
				Позиция.КодНоменклатуры);
		КонецЦикла;
		Если Товары.Количество() > 0 Тогда
			// Номера позиций - порядок товаров в пакете, как у сверки цепочки:
			// по ним форма находит строки прихода линий реестра товаров
			ИзПакета = Истина;
			Возврат Товары;
		КонецЕсли;
	КонецЕсли;

	Товары = ТоварыДляДерева(ИдентификаторУПД, "База2");
	Если Товары.Количество() > 0 Тогда
		Возврат Товары;
	КонецЕсли;

	Возврат ТоварыДляДерева(ИдентификаторЭТрН, "База2");

КонецФункции

&НаСервереБезКонтекста
Функция ЦепочкаДляДерева(ИдентификаторУПД, ШапкаУПД, Способ = "")

	Цепочка = ЭАрМ_ЦепочкаЗакупки.ЦепочкаПоУПД(ИдентификаторУПД);
	Если Цепочка <> Неопределено Тогда
		Способ = "привязана к этой УПД";
		Возврат Цепочка;
	КонецЕсли;

	Цепочка = ЭАрМ_ЦепочкаЗакупки.ЦепочкаПоНомеруЭДО(ШапкаУПД.Номер, ШапкаУПД.Дата,
		ШапкаУПД.ИННКонтрагента);
	Если Цепочка = Неопределено Тогда
		Способ = СтрШаблон("НЕТ: ни одна цепочка не привязана к этой УПД, и приходной с входящим номером %1 "
			+ "ИНН %2 в окне %3 дн. от %4 тоже нет", ШапкаУПД.Номер, ШапкаУПД.ИННКонтрагента,
			ЭАрМ_НастройкиСервер.НастройкиЦепочки().ОкноДнейСвязи, Формат(ШапкаУПД.Дата, "ДЛФ=D"))
			+ "; " + ЭАрМ_ПриемПакетовДалион.ОписаниеПакетовПриходнойПоНомеру(ШапкаУПД.Номер);
		Возврат Неопределено;
	КонецЕсли;

	// Цепочка найдена только по номеру: сверка её с этой УПД не сверяла и
	// итог в УПД не писала - строка списка оставалась белой при расхождениях.
	// Тот же поставщик - связываем и сразу сверяем.
	ИННЦепочки = СокрЛП(Цепочка.ИННПоставщика);
	ИННУПД     = СокрЛП(ШапкаУПД.ИННКонтрагента);
	Если НЕ ЗначениеЗаполнено(ИННЦепочки) ИЛИ ИННЦепочки <> ИННУПД Тогда
		Способ = СтрШаблон("найдена по номеру, но НЕ привязана: ИНН цепочки «%1», ИНН УПД «%2»", ИННЦепочки, ИННУПД);
		Возврат Цепочка;
	КонецЕсли;

	Способ = "найдена по входящему номеру";
	Попытка
		Если ЭАрМ_ЦепочкаЗакупки.СвязатьНайденнуюПоНомеру(Цепочка.ИдентификаторЗаказа,
			Цепочка.ИдентификаторПоступления, ИдентификаторУПД) Тогда
			ЭАрМ_СверкаТоваровЦепочки.СверитьЦепочку(Цепочка.ИдентификаторЗаказа,
				Цепочка.ИдентификаторПоступления);
			Цепочка = ЭАрМ_ЦепочкаЗакупки.ЦепочкаПоУПД(ИдентификаторУПД);
			Способ = "найдена по входящему номеру и привязана сейчас, сверена";
		Иначе
			Способ = "найдена по входящему номеру, привязать не удалось";
		КонецЕсли;
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(ИдентификаторУПД, "СвязьЦепочки", Ложь,
			ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения));
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторУПД,
			"Дерево УПД / ЦепочкаДляДерева (привязка цепочки, найденной по номеру)", ОшибкаИсключения);
		Способ = "найдена по входящему номеру, привязка УПАЛА - см. ОШИБКА ПРОВЕРКИ";
	КонецПопытки;

	Возврат Цепочка;

КонецФункции

&НаСервереБезКонтекста
Функция СтрокиРеестраТоваровДляДерева(Цепочка, ИдентификаторУПД)

	ИдентификаторЗаказа = "";
	ИдентификаторПоступления = "";
	Если Цепочка <> Неопределено Тогда
		ИдентификаторЗаказа = Цепочка.ИдентификаторЗаказа;
		ИдентификаторПоступления = Цепочка.ИдентификаторПоступления;
	КонецЕсли;

	Возврат ЭАрМ_РеестрТоваровЗаказов.СтрокиЦепочки(
		ИдентификаторЗаказа, ИдентификаторПоступления, ИдентификаторУПД);

КонецФункции

// Если пакет прихода пустой, строки ПН берём из реестра товаров: сверка
// уже положила туда количество и цену Далиона.
//
&НаСервереБезКонтекста
Функция ДополнитьПриходИзРеестраДляДерева(ТоварыДалион, СтрокиРеестра)

	Если СтрокиРеестра = Неопределено ИЛИ СтрокиРеестра.Количество() = 0 Тогда
		Возврат ТоварыДалион;
	КонецЕсли;

	Если ТоварыДалион.Количество() > 0 Тогда
		Возврат ТоварыДалион;
	КонецЕсли;

	НомерСтроки = 0;
	Для Каждого СтрокаРеестра Из СтрокиРеестра Цикл

		Если СтрокаРеестра.КоличествоПН <= 0 Тогда
			Продолжить;
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;
		СтрокаТовара = ТоварыДалион.Добавить();
		СтрокаТовара.НомерПозиции    = НомерСтроки;
		СтрокаТовара.Наименование    = СтрокаРеестра.Номенклатура;
		СтрокаТовара.Штрихкод        = СтрокаРеестра.Штрихкод;
		СтрокаТовара.Штрихкоды       = СокрЛП(СтрокаРеестра.Штрихкод);
		СтрокаТовара.Количество      = СтрокаРеестра.КоличествоПН;
		СтрокаТовара.Цена            = СтрокаРеестра.ЦенаПН;
		СтрокаТовара.Сумма           = Окр(СтрокаРеестра.КоличествоПН * СтрокаРеестра.ЦенаПН, 2);

	КонецЦикла;

	Возврат ТоварыДалион;

КонецФункции

// Строки одного документа из товарного регистра.
//
// Параметры:
//   Идентификатор - Строка - документ в СБИС; пустая строка даёт пустую таблицу
//   Источник      - Строка - "УПД", "ЭТрН" или "База2"
//
// Возвращаемое значение:
//   ТаблицаЗначений - строки документа в порядке позиций
//
&НаСервереБезКонтекста
Функция ТоварыДляДерева(Идентификатор, Источник)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.Наименование КАК Наименование,
	|	Товары.КодНоменклатуры КАК КодНоменклатуры,
	|	Товары.Артикул КАК Артикул,
	|	Товары.Штрихкод КАК Штрихкод,
	|	Товары.КодТовараПоставщика КАК КодТовараПоставщика,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Товары.Количество КАК Количество,
	|	Товары.КоличествоМест КАК КоличествоМест,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.Алкоголь КАК Алкоголь
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &Идентификатор
	|	И Товары.ИсточникТоваров = &Источник
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерПозиции";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Запрос.УстановитьПараметр("Источник", Источник);

	Товары = Запрос.Выполнить().Выгрузить();

	// Все штрихкоды строки через ";" - у прихода Далиона их несколько.
	// КлючиНоменклатуры - номенклатура Далиона строки через ";" ("uid:..",
	// "код:.."): у прихода своя, у УПД и ЭТрН - из штрихкодов поставщиков.
	Товары.Колонки.Добавить("Штрихкоды", Новый ОписаниеТипов("Строка"));
	Товары.Колонки.Добавить("КлючиНоменклатуры", Новый ОписаниеТипов("Строка"));
	Товары.Колонки.Добавить("Позиции", Новый ОписаниеТипов("Строка"));
	Для Каждого Товар Из Товары Цикл
		Товар.Штрихкоды = СокрЛП(Товар.Штрихкод);
		Товар.Позиции = Формат(Товар.НомерПозиции, "ЧГ=0");
		Если Источник = "База2" Тогда
			Товар.КлючиНоменклатуры = КлючиНоменклатурыДляДерева("", Товар.КодНоменклатуры);
		КонецЕсли;
	КонецЦикла;

	// Цена в регистре - ЦенаТов документа, без НДС, а сумма строки - с НДС.
	// Реестр показывает и сверяет цену с НДС, как приход Далиона и сверка
	// цепочки: сумма на количество
	Для Каждого Товар Из Товары Цикл
		Если Товар.Количество <> 0 И Товар.Сумма <> 0 Тогда
			Товар.Цена = Окр(Товар.Сумма / Товар.Количество, 2);
		КонецЕсли;
	КонецЦикла;

	Возврат Товары;

КонецФункции

// Связанная ЭТрН вместе с тем, что о ней известно по приходу в Далион.
//
// Сам поиск связи живёт в ЭАрМ_РегламентныйОбменЭДО.НайтиЭТрНДляУПД: правило
// должно быть одним для обоих направлений цепочки, иначе пара "УПД - ЭТрН"
// окажется связанной в одной форме и несвязанной в другой.
//
// Возвращаемое значение:
//   Структура - см. ПустаяСтрокаЭТрНДляДерева; Идентификатор пуст, если не нашли
//
&НаСервереБезКонтекста
Функция СвязаннаяЭТрНДляДерева(ИдентификаторУПД, ШапкаУПД)

	Результат = ПустаяСтрокаЭТрНДляДерева();

	НайденнаяЭТрН = ЭАрМ_РегламентныйОбменЭДО.НайтиЭТрНДляУПД(
		ИдентификаторУПД, ШапкаУПД.Номер, ШапкаУПД.КлючиСвязи);

	Если НЕ ЗначениеЗаполнено(НайденнаяЭТрН.Идентификатор) Тогда
		Возврат Результат;
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(Результат, НайденнаяЭТрН);
	ЗаполнитьРеквизитыЭТрНДляДерева(Результат, НайденнаяЭТрН.Идентификатор);

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция СвязаннаяЭТрНДляДереваПоИдентификатору(ИдентификаторЭТрН)

	Результат = ПустаяСтрокаЭТрНДляДерева();
	Результат.Идентификатор = ИдентификаторЭТрН;
	ЗаполнитьРеквизитыЭТрНДляДерева(Результат, ИдентификаторЭТрН);
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьРеквизитыЭТрНДляДерева(Результат, ИдентификаторЭТрН)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭТрН.Номер КАК Номер,
	|	ЭТрН.НомерДокументаДалион КАК НомерДокументаДалион,
	|	ЭТрН.СтатусДалион КАК СтатусДалион,
	|	ЭТрН.ЕстьРасхождения КАК ЕстьРасхождения,
	|	ЭТрН.РасхожденияДалион КАК РасхожденияДалион,
	|	ЭТрН.КомментарийДалион КАК КомментарийДалион,
	|	ЭТрН.Подписано КАК Подписано,
	|	ЭТрН.Утверждено КАК Утверждено,
	|	ЭТрН.СтатусПодписания КАК СтатусПодписания
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	ЭТрН.ИдентификаторСБИС = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторЭТрН);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

КонецПроцедуры

// Пустое описание связанной ЭТрН.
//
&НаСервереБезКонтекста
Функция ПустаяСтрокаЭТрНДляДерева()

	Результат = Новый Структура;
	Результат.Вставить("Идентификатор", "");
	Результат.Вставить("Номер", "");
	Результат.Вставить("НомерДокументаДалион", "");
	Результат.Вставить("СтатусДалион", "");
	Результат.Вставить("ЕстьРасхождения", Ложь);
	Результат.Вставить("РасхожденияДалион", "");
	Результат.Вставить("КомментарийДалион", "");
	Результат.Вставить("Подписано", Ложь);
	Результат.Вставить("Утверждено", Ложь);
	Результат.Вставить("СтатусПодписания",
		Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ПустаяСсылка());

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ЭТрНОтправленаВСБИС(СвязаннаяЭТрН)

	Если СвязаннаяЭТрН.Подписано ИЛИ СвязаннаяЭТрН.Утверждено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СвязаннаяЭТрН.СтатусПодписания
		= Перечисления.ЭАрМ_СтатусыПодписанияЭДО.Подписан
		ИЛИ СвязаннаяЭТрН.СтатусПодписания
		= Перечисления.ЭАрМ_СтатусыПодписанияЭДО.Утвержден;

КонецФункции

// Цены строки документа и строки прихода сравниваются с НДС. Без суммы строки
// у документа осталась ЦенаТов без НДС (см. ТоварыДляДерева) - такую цену с
// ценой Далиона не сравниваем, иначе расходился бы на НДС каждый товар.
//
&НаСервереБезКонтекста
Функция ЦеныРасходятсяДляДерева(Товар, ТоварДалион)

	Если Товар.Сумма = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Макс(Товар.Цена - ТоварДалион.Цена, ТоварДалион.Цена - Товар.Цена) > 0.01;

КонецФункции

// Текст различий между строкой документа и строкой прихода.
//
&НаСервереБезКонтекста
Функция РасхождениеСтрокДляДерева(Товар, ТоварДалион)

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	Сравнение = ЭАрМ_СверкаТоваровЦепочки.СравнитьКоличествоИЦену(
		Новый Структура("Количество, Цена, Сумма, СуммаНДС, СтавкаНДС",
			Товар.Количество, Товар.Цена, Товар.Сумма, Товар.СуммаНДС, Товар.СтавкаНДС),
		Новый Структура("Количество, Цена, Сумма, СуммаНДС, СтавкаНДС",
			ТоварДалион.Количество, ТоварДалион.Цена, ТоварДалион.Сумма,
			ТоварДалион.СуммаНДС, ТоварДалион.СтавкаНДС),
		Настройки);

	Различия = Новый Массив;

	Если НЕ Сравнение.Количество Тогда
		Различия.Добавить(СтрШаблон(НСтр("ru = 'количество %1 и %2'"),
			ЧислоДляДерева(Товар.Количество),
			ЧислоДляДерева(ТоварДалион.Количество)));
	КонецЕсли;

	Если НЕ Сравнение.Цена И ЦеныРасходятсяДляДерева(Товар, ТоварДалион) Тогда
		Различия.Добавить(СтрШаблон(НСтр("ru = 'цена %1 и %2'"),
			ЧислоДляДерева(Товар.Цена, 2),
			ЧислоДляДерева(ТоварДалион.Цена, 2)));
	КонецЕсли;

	Возврат СтрСоединить(Различия, ", ");

КонецФункции

// Складывает повторы одной номенклатуры в одну строку.
//
// Цена входит в ключ намеренно. Один и тот же товар по двум ценам - это два
// разных условия поставки, и свернуть их в одну строку значило бы показать
// среднюю цену, которой нет ни в одном документе. Разные цены остаются
// разными строками, и сверка честно покажет, какая из них не сошлась.
//
// Количество, места, сумма и НДС складываются, остальные реквизиты берутся
// от первой строки группы - у повторов они одинаковы по построению ключа.
// Порядок строк сохраняется: группа встаёт на место своего первого вхождения.
//
// Параметры:
//   Товары - ТаблицаЗначений - см. ТоварыДляДерева
//
// Возвращаемое значение:
//   ТаблицаЗначений - те же колонки, строк не больше
//
&НаСервереБезКонтекста
Функция СвернутьТоварыДляСверки(Товары)

	Свёрнутые = Товары.СкопироватьКолонки();
	Группы = Новый Соответствие;
	ЕстьПризнакУКД = Товары.Колонки.Найти("ИзмененоУКД") <> Неопределено;

	Для Каждого Товар Из Товары Цикл

		Ключ = КлючСворачиванияТовара(Товар);
		СтрокаГруппы = Группы.Получить(Ключ);

		Если СтрокаГруппы = Неопределено Тогда
			СтрокаГруппы = Свёрнутые.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаГруппы, Товар);
			Группы.Вставить(Ключ, СтрокаГруппы);
			Продолжить;
		КонецЕсли;

		СтрокаГруппы.Штрихкоды      = ОбъединитьШтрихкодыДляДерева(СтрокаГруппы.Штрихкоды, Товар.Штрихкоды);
		СтрокаГруппы.КлючиНоменклатуры = ОбъединитьШтрихкодыДляДерева(
			СтрокаГруппы.КлючиНоменклатуры, Товар.КлючиНоменклатуры);
		Если Товары.Колонки.Найти("Позиции") <> Неопределено Тогда
			СтрокаГруппы.Позиции = ОбъединитьШтрихкодыДляДерева(СтрокаГруппы.Позиции, Товар.Позиции);
		КонецЕсли;
		Если ЕстьПризнакУКД И Товар.ИзмененоУКД = Истина Тогда
			СтрокаГруппы.ИзмененоУКД = Истина;
		КонецЕсли;
		СтрокаГруппы.Количество     = ЧислоИлиНольДляДерева(СтрокаГруппы.Количество)
			+ ЧислоИлиНольДляДерева(Товар.Количество);
		СтрокаГруппы.КоличествоМест = ЧислоИлиНольДляДерева(СтрокаГруппы.КоличествоМест)
			+ ЧислоИлиНольДляДерева(Товар.КоличествоМест);
		СтрокаГруппы.Сумма          = ЧислоИлиНольДляДерева(СтрокаГруппы.Сумма)
			+ ЧислоИлиНольДляДерева(Товар.Сумма);
		СтрокаГруппы.СуммаНДС       = ЧислоИлиНольДляДерева(СтрокаГруппы.СуммаНДС)
			+ ЧислоИлиНольДляДерева(Товар.СуммаНДС);

	КонецЦикла;

	Возврат Свёрнутые;

КонецФункции

// Пары строк документа и прихода Далиона по данным самой таблицы.
//
// Строка за строкой пару отдавали первому подошедшему товару: «молоко 1 л»
// забирало по похожему имени строку «молоко 0,5 л» раньше, чем до неё
// доходил её товар. Теперь все возможные пары собираются заранее и
// раздаются от лучшей к худшей:
//   1 - общий штрихкод (любой из штрихкодов карточки Далиона и любой из
//       штрихкодов товара в регистре штрихкодов поставщиков);
//   2 - та же номенклатура Далиона (uid или код) по регистру штрихкодов
//       поставщиков;
//   3 - общий артикул;
//   4 - похожее наименование (оценка от 0,8);
//   5 - сошлись количество и цена при оценке имени от 0,5, либо одни
//       цифры, если пара единственная и штрихкоды не спорят.
// С 28.09.2026 сверка только по штрихкоду: работают этапы 1 и 2, этапы 3-5
// отключены (ТолькоШтрихкод). Строку без общего штрихкода связывает человек
// колонкой «Пара в приходе».
// Внутри этапа выше оценка имени и совпадение цифр, потом меньше разница
// количества и цены.
//
// Возвращаемое значение:
//   Соответствие - индекс строки ТоварыДокумента -> строка ТоварыДалион
//
&НаСервереБезКонтекста
Функция ПодобратьПарыДляДерева(ТоварыДокумента, ТоварыДалион, ИспользованныеСтроки,
	ЗафиксированныеТовары = Неопределено)

	Пары = Новый Соответствие;
	Если ТоварыДокумента.Количество() = 0 ИЛИ ТоварыДалион.Количество() = 0 Тогда
		Возврат Пары;
	КонецЕсли;

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	ТолькоШтрихкод = Истина;

	Кандидаты = Новый ТаблицаЗначений;
	Кандидаты.Колонки.Добавить("ИндексТовара",  Новый ОписаниеТипов("Число"));
	Кандидаты.Колонки.Добавить("ИндексДалиона", Новый ОписаниеТипов("Число"));
	Кандидаты.Колонки.Добавить("Этап",          Новый ОписаниеТипов("Число"));
	Кандидаты.Колонки.Добавить("Оценка",        Новый ОписаниеТипов("Число"));
	Кандидаты.Колонки.Добавить("Разница",       Новый ОписаниеТипов("Число"));
	Кандидаты.Колонки.Добавить("ТолькоЦифры",   Новый ОписаниеТипов("Булево"));

	ТолькоЦифрПоТовару  = Новый Соответствие;
	ТолькоЦифрПоДалиону = Новый Соответствие;

	Для Каждого Товар Из ТоварыДокумента Цикл

		ИндексТовара = ТоварыДокумента.Индекс(Товар);
		Если ЗафиксированныеТовары <> Неопределено
			И ЗафиксированныеТовары.Получить(ИндексТовара) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ШтрихкодыТовара = ШтрихкодыСтрокиДляДерева(Товар);

		Для Каждого ТоварДалион Из ТоварыДалион Цикл

			ИндексДалиона = ТоварыДалион.Индекс(ТоварДалион);
			Если ИспользованныеСтроки.Получить(Строка(ИндексДалиона)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ШтрихкодыДалиона = ШтрихкодыСтрокиДляДерева(ТоварДалион);
			ЦифрыСошлись = ЦифрыСтрокСошлисьДляДерева(Товар, ТоварДалион, Настройки);
			Оценка = 0;
			ТолькоЦифры = Ложь;

			Если ЕстьОбщийШтрихкодДляДерева(ШтрихкодыТовара, ШтрихкодыДалиона)
				И ЭАрМ_СверкаТоваровЦепочки.ПараСтрокПравдоподобна(Товар, ТоварДалион) Тогда
				// Штрихкод мог подставить регистр по ошибочной записи: названия
				// не похожи и не сошлись ни количество, ни цена, ни сумма -
				// такую пару (крест-накрест) не берём
				Этап = 1;
				Оценка = 1;
			ИначеЕсли ЕстьОбщаяНоменклатураДляДерева(Товар, ТоварДалион)
				И ЭАрМ_СверкаТоваровЦепочки.ПараСтрокПравдоподобна(Товар, ТоварДалион) Тогда
				Этап = 2;
				Оценка = 1;
			ИначеЕсли ТолькоШтрихкод Тогда
				// Сверка только по штрихкоду (ЭАрМ_СверкаТоваровЦепочки.
				// ТолькоШтрихкодИКод): артикул, имя и цифры пары не дают
				Продолжить;
			ИначеЕсли АртикулыСовпадаютДляДерева(Товар, ТоварДалион) Тогда
				Этап = 3;
				Оценка = 1;
			Иначе
				Оценка = ЭАрМ_СверкаТоваровЦепочки.ОценкаПохожестиНаименований(
					Товар.Наименование, ТоварДалион.Наименование);
				Если Оценка >= 0.8 Тогда
					Этап = 4;
				ИначеЕсли ЦифрыСошлись И Оценка >= 0.5 Тогда
					Этап = 5;
				ИначеЕсли ЦифрыСошлись
					И (ШтрихкодыТовара.Количество() = 0 ИЛИ ШтрихкодыДалиона.Количество() = 0) Тогда
					Этап = 5;
					ТолькоЦифры = Истина;
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЕсли;

			Кандидат = Кандидаты.Добавить();
			Кандидат.ИндексТовара  = ИндексТовара;
			Кандидат.ИндексДалиона = ИндексДалиона;
			Кандидат.Этап          = Этап;
			// Оценку огрубляем до десятых: 0,86 и 0,84 - одинаково похожие
			// имена, и выбирать между ними должны цифры, а не сотые оценки
			Кандидат.Оценка        = Окр(Оценка, 1) + ?(ЦифрыСошлись, 0.05, 0);
			Кандидат.Разница       = РазницаЦифрДляДерева(Товар, ТоварДалион);
			Кандидат.ТолькоЦифры   = ТолькоЦифры;

			Если ТолькоЦифры Тогда
				ТолькоЦифрПоТовару.Вставить(ИндексТовара,
					ЧислоИлиНольДляДерева(ТолькоЦифрПоТовару.Получить(ИндексТовара)) + 1);
				ТолькоЦифрПоДалиону.Вставить(ИндексДалиона,
					ЧислоИлиНольДляДерева(ТолькоЦифрПоДалиону.Получить(ИндексДалиона)) + 1);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Кандидаты.Сортировать("Этап, Оценка Убыв, Разница, ИндексТовара, ИндексДалиона");

	Для Каждого Кандидат Из Кандидаты Цикл

		КлючДалиона = Строка(Кандидат.ИндексДалиона);
		Если Пары.Получить(Кандидат.ИндексТовара) <> Неопределено
			ИЛИ ИспользованныеСтроки.Получить(КлючДалиона) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Одни цифры без имени и штрихкода - пара, только если она единственная:
		// десять строк по 10 шт. и 50 руб. иначе разошлись бы наугад
		Если Кандидат.ТолькоЦифры
			И (ТолькоЦифрПоТовару.Получить(Кандидат.ИндексТовара) > 1
				ИЛИ ТолькоЦифрПоДалиону.Получить(Кандидат.ИндексДалиона) > 1) Тогда
			Продолжить;
		КонецЕсли;

		ИспользованныеСтроки.Вставить(КлючДалиона, Истина);
		Пары.Вставить(Кандидат.ИндексТовара, ТоварыДалион[Кандидат.ИндексДалиона]);

	КонецЦикла;

	Возврат Пары;

КонецФункции

// Количество и цена строк сходятся по тем же правилам, что и расхождение
// в колонке (см. РасхождениеСтрокДляДерева).
//
&НаСервереБезКонтекста
Функция ЦифрыСтрокСошлисьДляДерева(Товар, ТоварДалион, Настройки)

	Сравнение = ЭАрМ_СверкаТоваровЦепочки.СравнитьКоличествоИЦену(
		СтрокаСравненияДляДерева(Товар), СтрокаСравненияДляДерева(ТоварДалион), Настройки);

	Возврат Сравнение.Количество И Сравнение.Цена;

КонецФункции

&НаСервереБезКонтекста
Функция СтрокаСравненияДляДерева(Товар)

	Возврат Новый Структура("Количество, Цена, Сумма, СуммаНДС, СтавкаНДС",
		ЧислоИлиНольДляДерева(Товар.Количество),
		ЧислоИлиНольДляДерева(Товар.Цена),
		ЧислоИлиНольДляДерева(Товар.Сумма),
		ЧислоИлиНольДляДерева(Товар.СуммаНДС),
		?(ТипЗнч(Товар.СтавкаНДС) = Тип("Строка"), Товар.СтавкаНДС, ""));

КонецФункции

// Чем меньше, тем ближе строки по цифрам: количество весомее цены.
//
&НаСервереБезКонтекста
Функция РазницаЦифрДляДерева(Товар, ТоварДалион)

	РазницаКоличества = ЧислоИлиНольДляДерева(Товар.Количество)
		- ЧислоИлиНольДляДерева(ТоварДалион.Количество);
	РазницаЦены = ЧислоИлиНольДляДерева(Товар.Цена)
		- ЧислоИлиНольДляДерева(ТоварДалион.Цена);

	Возврат Макс(РазницаКоличества, -РазницаКоличества) * 1000000
		+ Макс(РазницаЦены, -РазницаЦены);

КонецФункции

&НаСервереБезКонтекста
Функция ШтрихкодыСтрокиДляДерева(Товар)

	Результат = Новый Массив;
	Тексты = Новый Массив;
	Если ТипЗнч(Товар.Штрихкоды) = Тип("Строка") Тогда
		Тексты = СтрРазделить(Товар.Штрихкоды, ";", Ложь);
	КонецЕсли;
	Если ТипЗнч(Товар.Штрихкод) = Тип("Строка") Тогда
		Тексты.Добавить(Товар.Штрихкод);
	КонецЕсли;

	Для Каждого Текст Из Тексты Цикл
		Текст = СокрЛП(Текст);
		Если ЗначениеЗаполнено(Текст) И Результат.Найти(Текст) = Неопределено Тогда
			Результат.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ЕстьОбщийШтрихкодДляДерева(ШтрихкодыА, ШтрихкодыБ)

	Для Каждого ШтрихкодА Из ШтрихкодыА Цикл
		Для Каждого ШтрихкодБ Из ШтрихкодыБ Цикл
			Если ШтрихкодыСовпадаютДляДерева(ШтрихкодА, ШтрихкодБ) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция АртикулыСовпадаютДляДерева(Товар, ТоварДалион)

	АртикулА = ?(ТипЗнч(Товар.Артикул) = Тип("Строка"), ВРег(СокрЛП(Товар.Артикул)), "");
	АртикулБ = ?(ТипЗнч(ТоварДалион.Артикул) = Тип("Строка"), ВРег(СокрЛП(ТоварДалион.Артикул)), "");

	Возврат ЗначениеЗаполнено(АртикулА) И АртикулА = АртикулБ;

КонецФункции

&НаСервереБезКонтекста
Функция ОбъединитьШтрихкодыДляДерева(ШтрихкодыА, ШтрихкодыБ)

	Все = Новый Массив;
	Для Каждого Текст Из СтрРазделить(
		?(ТипЗнч(ШтрихкодыА) = Тип("Строка"), ШтрихкодыА, "") + ";"
		+ ?(ТипЗнч(ШтрихкодыБ) = Тип("Строка"), ШтрихкодыБ, ""), ";", Ложь) Цикл
		Текст = СокрЛП(Текст);
		Если ЗначениеЗаполнено(Текст) И Все.Найти(Текст) = Неопределено Тогда
			Все.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Все, ";");

КонецФункции

// Дополняет строки УПД или ЭТрН тем, что знает о них регистр штрихкодов
// поставщиков: всеми штрихкодами товара и номенклатурой Далиона.
//
// Параметры:
//   Товары        - ТаблицаЗначений - см. ТоварыДляДерева, до свёртки
//   ИННПоставщика - Строка
//
&НаСервереБезКонтекста
Процедура ДополнитьИзШтрихкодовПоставщикаДляДерева(Товары, ИННПоставщика)

	Если Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого Товар Из Товары Цикл
		Строки.Добавить(Новый Структура("Штрихкоды, КодТовараПоставщика, Наименование",
			ШтрихкодыСтрокиДляДерева(Товар),
			?(ТипЗнч(Товар.КодТовараПоставщика) = Тип("Строка"), Товар.КодТовараПоставщика, ""),
			Товар.Наименование));
	КонецЦикла;

	Сведения = ЭАрМ_СверкаТоваровЦепочки.СведенияШтрихкодовПоставщика(Строки, ИННПоставщика);

	Для Индекс = 0 По Товары.Количество() - 1 Цикл

		Товар = Товары[Индекс];
		СведенияСтроки = Сведения[Индекс];

		Товар.Штрихкоды = ОбъединитьШтрихкодыДляДерева(Товар.Штрихкоды,
			СтрСоединить(СведенияСтроки.Штрихкоды, ";"));

		Ключи = Новый Массив;
		Для Каждого Уид Из СведенияСтроки.Идентификаторы Цикл
			Ключи.Добавить(КлючиНоменклатурыДляДерева(Уид, ""));
		КонецЦикла;
		Для Каждого Код Из СведенияСтроки.Коды Цикл
			Ключи.Добавить(КлючиНоменклатурыДляДерева("", Код));
		КонецЦикла;
		Товар.КлючиНоменклатуры = ОбъединитьШтрихкодыДляДерева(Товар.КлючиНоменклатуры,
			СтрСоединить(Ключи, ";"));

	КонецЦикла;

КонецПроцедуры

// Ключи номенклатуры Далиона для сравнения строк: "uid:<uid>" и "код:<код>".
//
&НаСервереБезКонтекста
Функция КлючиНоменклатурыДляДерева(Уид, Код)

	Ключи = Новый Массив;
	Если ТипЗнч(Уид) = Тип("Строка") И ЗначениеЗаполнено(СокрЛП(Уид)) Тогда
		Ключи.Добавить("uid:" + НРег(СокрЛП(Уид)));
	КонецЕсли;
	Если ТипЗнч(Код) = Тип("Строка") И ЗначениеЗаполнено(СокрЛП(Код)) Тогда
		Ключи.Добавить("код:" + ВРег(СокрЛП(Код)));
	КонецЕсли;

	Возврат СтрСоединить(Ключи, ";");

КонецФункции

&НаСервереБезКонтекста
Функция ЕстьОбщаяНоменклатураДляДерева(Товар, ТоварДалион)

	Если ТипЗнч(Товар.КлючиНоменклатуры) <> Тип("Строка")
		ИЛИ ТипЗнч(ТоварДалион.КлючиНоменклатуры) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	КлючиДалиона = СтрРазделить(ТоварДалион.КлючиНоменклатуры, ";", Ложь);
	Для Каждого Ключ Из СтрРазделить(Товар.КлючиНоменклатуры, ";", Ложь) Цикл
		Если КлючиДалиона.Найти(Ключ) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Почему строка документа осталась без пары - чтобы по тексту было видно,
// с чем её пытались сравнить.
//
&НаСервереБезКонтекста
Функция ПричинаБезПарыДляДерева(Товар)

	Части = Новый Массив;

	Штрихкоды = ШтрихкодыСтрокиДляДерева(Товар);
	Если Штрихкоды.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'штрихкоды %1'"), СтрСоединить(Штрихкоды, ", ")));
	Иначе
		Части.Добавить(НСтр("ru = 'штрихкода нет'"));
	КонецЕсли;

	Если ТипЗнч(Товар.КлючиНоменклатуры) = Тип("Строка")
		И ЗначениеЗаполнено(Товар.КлючиНоменклатуры) Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'номенклатура Далиона по штрихкодам поставщиков: %1 - в приходе её нет'"),
			СтрЗаменить(Товар.КлючиНоменклатуры, ";", ", ")));
	Иначе
		Части.Добавить(НСтр("ru = 'в штрихкодах поставщиков товар не найден'"));
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'нет пары в приходе Далиона (%1)'"), СтрСоединить(Части, "; "));

КонецФункции

// Собирает строки УПД и прихода по линиям реестра товаров - так, как их
// сопоставила сверка цепочки.
//
// Линия реестра хранит позиции УПД (ПозицииУПД) и номера товаров пакета
// Далиона (СтрокиПН). Строки одной линии складываются в одну строку дерева,
// а линия с обеими сторонами даёт пару. Строки, которых нет ни в одной линии,
// добавляются как есть - им пару подберёт форма.
//
// Параметры:
//   ТоварыУПД      - ТаблицаЗначений - см. ТоварыДляДерева, с учётом УКД, до свёртки
//   ТоварыДалион   - ТаблицаЗначений - строки прихода
//   СтрокиРеестра  - ТаблицаЗначений - см. ЭАрМ_РеестрТоваровЗаказов.СтрокиЦепочки
//   ПриходИзПакета - Булево - номера строк прихода - порядок товаров в пакете
//
// Возвращаемое значение:
//   Неопределено - реестр не хранит позиций (не пересверен) или приход не из
//                  пакета: форма подбирает пары сама, как раньше
//   Структура:
//     * ТоварыУПД, ТоварыДалион - ТаблицаЗначений - строки по линиям и остатки
//     * Пары          - Соответствие - индекс строки ТоварыУПД -> индекс ТоварыДалион
//     * СтрокиУПД     - Соответствие - индексы строк ТоварыУПД из линий реестра
//     * СтрокиПрихода - Соответствие - индексы строк ТоварыДалион из линий реестра
//
&НаСервереБезКонтекста
Функция ГруппироватьПоРееструДляДерева(ТоварыУПД, ТоварыДалион, СтрокиРеестра, ПриходИзПакета)

	Если НЕ ПриходИзПакета
		ИЛИ СтрокиРеестра = Неопределено
		ИЛИ СтрокиРеестра.Колонки.Найти("ПозицииУПД") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЕстьПозиции = Ложь;
	Для Каждого СтрокаРеестра Из СтрокиРеестра Цикл
		Если ЗначениеЗаполнено(СтрокаРеестра.ПозицииУПД) ИЛИ ЗначениеЗаполнено(СтрокаРеестра.СтрокиПН) Тогда
			ЕстьПозиции = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЕстьПозиции Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ТоварыУПД",     ТоварыУПД.СкопироватьКолонки());
	Результат.Вставить("ТоварыДалион",  ТоварыДалион.СкопироватьКолонки());
	Результат.Вставить("Пары",          Новый Соответствие);
	Результат.Вставить("СтрокиУПД",     Новый Соответствие);
	Результат.Вставить("СтрокиПрихода", Новый Соответствие);

	ВзятыеУПД    = Новый Соответствие;
	ВзятыеПрихода = Новый Соответствие;

	Для Каждого СтрокаРеестра Из СтрокиРеестра Цикл

		СтрокиУПДЛинии    = СтрокиПоПозициямДляДерева(ТоварыУПД, СтрокаРеестра.ПозицииУПД, ВзятыеУПД);
		СтрокиПриходаЛинии = СтрокиПоПозициямДляДерева(ТоварыДалион, СтрокаРеестра.СтрокиПН, ВзятыеПрихода);

		ИндексУПД = Неопределено;
		Если СтрокиУПДЛинии.Количество() > 0 Тогда
			СложитьСтрокиДляДерева(Результат.ТоварыУПД, СтрокиУПДЛинии);
			ИндексУПД = Результат.ТоварыУПД.Количество() - 1;
			Результат.СтрокиУПД.Вставить(ИндексУПД, Истина);
		КонецЕсли;

		ИндексПрихода = Неопределено;
		Если СтрокиПриходаЛинии.Количество() > 0 Тогда
			СложитьСтрокиДляДерева(Результат.ТоварыДалион, СтрокиПриходаЛинии);
			ИндексПрихода = Результат.ТоварыДалион.Количество() - 1;
			Результат.СтрокиПрихода.Вставить(ИндексПрихода, Истина);
		КонецЕсли;

		Если ИндексУПД <> Неопределено И ИндексПрихода <> Неопределено Тогда
			Результат.Пары.Вставить(ИндексУПД, ИндексПрихода);
		КонецЕсли;

	КонецЦикла;

	// Строки, которых нет в реестре (например, пришли после сверки)
	Для Каждого Товар Из ТоварыУПД Цикл
		Если ВзятыеУПД.Получить(ТоварыУПД.Индекс(Товар)) = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Результат.ТоварыУПД.Добавить(), Товар);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Товар Из ТоварыДалион Цикл
		Если ВзятыеПрихода.Получить(ТоварыДалион.Индекс(Товар)) = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Результат.ТоварыДалион.Добавить(), Товар);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строки таблицы с номерами позиций из списка "1;5;7", ещё не взятые другой линией.
//
&НаСервереБезКонтекста
Функция СтрокиПоПозициямДляДерева(Товары, ПозицииСтрокой, Взятые)

	Результат = Новый Массив;
	Если ТипЗнч(ПозицииСтрокой) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(ПозицииСтрокой) Тогда
		Возврат Результат;
	КонецЕсли;

	Номера = Новый Массив;
	Для Каждого Часть Из СтрРазделить(ПозицииСтрокой, ";", Ложь) Цикл
		Попытка
			Номера.Добавить(Число(СокрЛП(Часть)));
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;

	Для Каждого Товар Из Товары Цикл
		Индекс = Товары.Индекс(Товар);
		Если Взятые.Получить(Индекс) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Номера.Найти(ЧислоИлиНольДляДерева(Товар.НомерПозиции)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Взятые.Вставить(Индекс, Истина);
		Результат.Добавить(Товар);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Складывает строки одной линии в новую строку таблицы: количества, суммы и
// НДС суммируются, штрихкоды и номенклатура объединяются, остальное - от
// первой строки. Цена нескольких строк - сумма на количество.
//
&НаСервереБезКонтекста
Процедура СложитьСтрокиДляДерева(Приёмник, Строки)

	Новая = Приёмник.Добавить();
	ЗаполнитьЗначенияСвойств(Новая, Строки[0]);
	Если Строки.Количество() = 1 Тогда
		Возврат;
	КонецЕсли;

	ЕстьПризнакУКД = Приёмник.Колонки.Найти("ИзмененоУКД") <> Неопределено;

	Для Индекс = 1 По Строки.ВГраница() Цикл
		Товар = Строки[Индекс];
		Новая.Количество     = ЧислоИлиНольДляДерева(Новая.Количество) + ЧислоИлиНольДляДерева(Товар.Количество);
		Новая.КоличествоМест = ЧислоИлиНольДляДерева(Новая.КоличествоМест) + ЧислоИлиНольДляДерева(Товар.КоличествоМест);
		Новая.Сумма          = ЧислоИлиНольДляДерева(Новая.Сумма) + ЧислоИлиНольДляДерева(Товар.Сумма);
		Новая.СуммаНДС       = ЧислоИлиНольДляДерева(Новая.СуммаНДС) + ЧислоИлиНольДляДерева(Товар.СуммаНДС);
		Новая.Штрихкоды      = ОбъединитьШтрихкодыДляДерева(Новая.Штрихкоды, Товар.Штрихкоды);
		Новая.КлючиНоменклатуры = ОбъединитьШтрихкодыДляДерева(Новая.КлючиНоменклатуры, Товар.КлючиНоменклатуры);
		Если Приёмник.Колонки.Найти("Позиции") <> Неопределено Тогда
			Новая.Позиции = ОбъединитьШтрихкодыДляДерева(Новая.Позиции, Товар.Позиции);
		КонецЕсли;
		Если ЕстьПризнакУКД И Товар.ИзмененоУКД = Истина Тогда
			Новая.ИзмененоУКД = Истина;
		КонецЕсли;
	КонецЦикла;

	Если Новая.Количество <> 0 И Новая.Сумма <> 0 Тогда
		Новая.Цена = Окр(Новая.Сумма / Новая.Количество, 2);
	КонецЕсли;

КонецПроцедуры

// Строки прихода Далиона добавляются в таблицу из запроса вручную, и не
// заполненные ими колонки (КоличествоМест, СуммаНДС) остаются Null: колонка
// результата запроса допускает Null, и Null + Число падает.
//
&НаСервереБезКонтекста
Функция ЧислоИлиНольДляДерева(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);

КонецФункции

// Ключ повтора: одинаковый штрихкод - одна позиция, даже если цена
// в разных строках чуть отличается. Без штрихкода - имя, код и цена.
//
&НаСервереБезКонтекста
Функция КлючСворачиванияТовара(Товар)

	Канон = ЭАрМ_СверкаТоваровЦепочки.КаноническийШтрихкод(Товар.Штрихкод);
	Если ЗначениеЗаполнено(Канон) Тогда
		Возврат "ШК|" + Канон;
	КонецЕсли;

	ЧастиКлюча = Новый Массив;
	ЧастиКлюча.Добавить(ВРег(СокрЛП(Товар.Артикул)));
	ЧастиКлюча.Добавить(ВРег(СокрЛП(Товар.КодНоменклатуры)));
	ЧастиКлюча.Добавить(НормализованноеНаименованиеДляДерева(Товар.Наименование));
	ЧастиКлюча.Добавить(Формат(Товар.Цена, "ЧЦ=15; ЧДЦ=2; ЧГ=0"));

	Возврат СтрСоединить(ЧастиКлюча, "|");

КонецФункции

&НаСервереБезКонтекста
Функция ШтрихкодыСовпадаютДляДерева(ШтрихкодА, ШтрихкодБ)

	Возврат ЭАрМ_СверкаТоваровЦепочки.ШтрихкодыСовпадают(ШтрихкодА, ШтрихкодБ);

КонецФункции

&НаСервереБезКонтекста
Функция НаименованияСовпадаютДляДерева(НаименованиеА, НаименованиеБ)

	Возврат ЭАрМ_СверкаТоваровЦепочки.НаименованияСовпадают(НаименованиеА, НаименованиеБ);

КонецФункции

// Нормализованное имя для ключа строки дерева.
//
&НаСервереБезКонтекста
Функция НормализованноеНаименованиеДляДерева(Наименование)

	Возврат ЭАрМ_СверкаТоваровЦепочки.НормализованноеНаименование(Наименование);

КонецФункции

// Число для строковой колонки дерева. Ноль не показываем вовсе.
//
// Разрядность зависит от того, что за число. Деньги просят её явно и всегда
// показывают копейки: цена 49,10 без нуля читалась бы как другая цена.
// Количество разрядность не задаёт, и незначащие нули у него срезаются:
// 280,000 и 280 - одно и то же число, а глазом сравнивать проще второе.
//
// Параметры:
//   Значение           - Число
//   ЗнаковДробнойЧасти - Число - фиксированная разрядность для денег
//                      - Неопределено - количество, разрядность по значению
//
&НаСервереБезКонтекста
Функция ЧислоДляДерева(Значение, ЗнаковДробнойЧасти = Неопределено)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Если ЗнаковДробнойЧасти <> Неопределено Тогда
		Возврат Формат(Значение, СтрШаблон("ЧЦ=15; ЧДЦ=%1", ЗнаковДробнойЧасти));
	КонецЕсли;

	// Больше трёх знаков в регистре товаров всё равно не хранится
	Знаков = 3;
	Пока Знаков > 0 И Окр(Значение, Знаков - 1) = Окр(Значение, Знаков) Цикл
		Знаков = Знаков - 1;
	КонецЦикла;

	Возврат Формат(Значение, СтрШаблон("ЧЦ=15; ЧДЦ=%1", Знаков));

КонецФункции

#КонецОбласти
