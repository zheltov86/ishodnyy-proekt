КонецФункции

// Читает документ в СБИС и, если названо действие, просит его подготовить.
//
// Чтение безопасно и идёт всегда: из узла ТекущиеЭтапы видно, на каком этапе
// стоит УПД и какие действия по ней доступны. Подготовка меняет документ на
// стороне СБИС - пересобирает служебные вложения и титул ответа, - поэтому
// делается только по явному названию действия.
//
// Ответы возвращаются сырыми, без разбора: цель команды - увидеть формат.
//
// Параметры:
//   Идентификатор - Строка - документ УПД в СБИС
//   ДействиеЭтапа - Строка - название действия; пустая - только чтение
//
// Возвращаемое значение:
//   Строка - запросы и ответы подряд
//
&НаСервере
Функция ПодготовитьДействиеНаСервере(Идентификатор, ДействиеЭтапа = "")

	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();

	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Возврат НСтр("ru = 'Не удалось авторизоваться в СБИС, проверьте настройки ЭДО'");
	КонецЕсли;

	Адрес = ЭАрМ_НастройкиСервер.НастройкиСБИС().АдресСервера;

	ЧастиОтчёта = Новый Массив;
	ЧастиОтчёта.Добавить(СтрШаблон(
		НСтр("ru = 'Документ СБИС: %1'"), Идентификатор));

	Чтение = ЭАрМ_ОбщийМодульОбмен.ПрочитатьДокумент(
		Идентификатор, Сессия, Адрес, "Стороны,ТекущиеЭтапы,Подстановки");

	ЧастиОтчёта.Добавить("");
	ЧастиОтчёта.Добавить("=== СБИС.ПрочитатьДокумент ===");
	ЧастиОтчёта.Добавить(Чтение.Ответ);

	ЧастиОтчёта.Добавить("");
	ЧастиОтчёта.Добавить("=== Доступные этапы и действия ===");
	ЧастиОтчёта.Добавить(ЭтапыИДействияДляДиагностики(Чтение.Документ));

	Если НЕ ЗначениеЗаполнено(ДействиеЭтапа) Тогда
		ЧастиОтчёта.Добавить("");
		ЧастиОтчёта.Добавить(НСтр(
			"ru = 'Действие не названо, СБИС.ПодготовитьДействие не вызывался.'"));
		Возврат СтрСоединить(ЧастиОтчёта, Символы.ПС);
	КонецЕсли;

	ПараметрыДокумента = Новый Структура;
	ПараметрыДокумента.Вставить("Идентификатор", Идентификатор);

	Этап = ЭтапПоДействию(Чтение.Документ, ДействиеЭтапа);
	Если Этап = Неопределено Тогда
		Этап = Новый Структура;
	КонецЕсли;

	Действие = Новый Структура("Название", ДействиеЭтапа);

	Сертификат = СертификатПодписантаДляСБИС();
	Если Сертификат = Неопределено Тогда
		ЧастиОтчёта.Добавить("");
		ЧастиОтчёта.Добавить(НСтр("ru = 'В настройках ЭДО не заполнены реквизиты подписанта: отпечаток сертификата, ФИО и ИНН. Без них СБИС отвечает, что информация о сертификате неполная.'"));
		Возврат СтрСоединить(ЧастиОтчёта, Символы.ПС);
	КонецЕсли;

	Действие.Вставить("Сертификат", Сертификат);
	Этап.Вставить("Действие", Действие);
	ПараметрыДокумента.Вставить("Этап", Этап);

	ПараметрыМетода = Новый Структура("Документ", ПараметрыДокумента);

	ЧастиОтчёта.Добавить("");
	ЧастиОтчёта.Добавить("=== СБИС.ПодготовитьДействие, параметры ===");
	ЧастиОтчёта.Добавить(ЭАрМ_ОбщийМодульОбмен.ТекстJSONУзла(ПараметрыМетода));

	ОтветМетода = ЭАрМ_Служебный.ВыполнитьМетодСБИС(
		"СБИС.ПодготовитьДействие", ПараметрыМетода, Сессия, Адрес);

	ЧастиОтчёта.Добавить("");
	ЧастиОтчёта.Добавить("=== СБИС.ПодготовитьДействие, ответ ===");
	ЧастиОтчёта.Добавить(ОтветМетода.Ответ);

	Если НЕ ОтветМетода.Успех Тогда
		ЧастиОтчёта.Добавить("");
		ЧастиОтчёта.Добавить(СтрШаблон(НСтр("ru = 'Ошибка: %1'"), ОтветМетода.Ошибка));
	КонецЕсли;

	Возврат СтрСоединить(ЧастиОтчёта, Символы.ПС);

КонецФункции

// Подготовка утверждения, отправка подписей и запрет утверждения живут в
