////////////////////////////////////////////////////////////////////////////////
// Форма списка регистра ЭАрМ_УПД_Входящий.
//
// Реестр УПД наполняет регламентное задание; команда здесь нужна, чтобы
// перечитать его вручную, не дожидаясь расписания. Пока форма открыта,
// список сам перечитывается по снимку (фолбэк раз в 2 минуты) и по событиям
// сеанса, а ожидающие цепочки сверяются в фоне. Догрузка товаров список
// не перечитывает: иначе таблица прыгала, пока пользователь в ней работал.
//
// Загрузка разбита на два шага. Реестр - один запрос в СБИС на страницу,
// его ждём прямо в вызове. Товары - поход в СБИС на каждый документ, и вот
// они уходят в фоновое задание: пользователь видит прогресс и может работать
// дальше, а порции документов разбираются параллельно, насколько это
// позволяет БСП (см. ДлительныеОперации.ДопустимоеКоличествоПотоков).
//
// Выбранная строка списка тянет за собой дерево ЦепочкаДокументов.
// В дереве УПД, связанная ЭТрН и приходная накладная Далиона стоят
// отдельными строками одного уровня, у каждой в заголовке итоги по её
// товарам. Строка реестра УПД зелёная только если сошлись количество и цена
// с приходом; иначе после сверки — красная. После чистой сверки уходит
// запрос пломбы в Далион.
//
// Ведущий документ здесь УПД: из её строк считаются итоги шапки. Зеркальное
// дерево от ЭТрН собирает форма списка ЭАрМ_РеестрЭТрН.
////////////////////////////////////////////////////////////////////////////////

#Область ПеременныеФормы

// Соответствие - документы УПД, товары которых уже спрашивали у СБИС
// в этом сеансе работы с формой.
//
&НаКлиенте
Перем ЗапрошенныеТоварыУПД;

// Структура - состояние текущего подписания: этап, сертификат и вложения
// с их подписями. Живёт между шагами асинхронной цепочки.
//
&НаКлиенте
Перем ПодписаниеСБИС;

// Булево - фоновая автосверка ещё идёт. Пока она не закончилась, новый
// запуск не делаем: иначе одно и то же ждало бы в нескольких заданиях.
//
&НаКлиенте
Перем ИдётАвтообновлениеРеестра;

// Строка - УПД, для которой построено дерево цепочки. Перечитывание списка
// активизирует строку заново: без этой отметки дерево строилось бы снова,
// а Список.Обновить() в конце построения вызывал новую активизацию.
//
&НаКлиенте
Перем ЦепочкаПостроенаДля;

// Строка - текст «Расхождение» до выбора статуса из списка, чтобы отменить выбор.
//
&НаКлиенте
Перем ТекстРасхожденияДоВыбора;

// Дата - когда последний раз запускали фоновую автосверку. Она сверяет до
// 30 цепочек и пишет признак «Есть ЭТрН» по всему реестру: вместе со
// снимком списка это нагружало базу, пока пользователь работал.
//
&НаКлиенте
Перем ПоследняяАвтосверка;

// Структура - состояние кнопки «Проверка ЭП»: строки отчёта, сертификат,
// менеджер криптографии и тестовые данные. Отдельно от ПодписаниеСБИС,
// чтобы проверка не мешала настоящему подписанию.
//
&НаКлиенте
Перем ПроверкаЭП;

// Структура - состояние кнопки «Подписанты»: список подписантов из настроек,
// текущий индекс и строки отчёта.
//
&НаКлиенте
Перем ОбзорПодписантов;

// Булево - подготовка или отправка утверждения идёт фоновым заданием: форма
// не висит, а второй запуск, пока первый не закончился, не делаем.
//
&НаКлиенте
Перем ИдётФоновоеУтверждение;

// Структура - автоотправка этой формы (ЭАрМ_ПанельУправленияЭДОКлиент.
// НовоеСостояниеАвтоотправки): подписант, взятые документы, текущая пачка.
//
&НаКлиенте
Перем АвтоСостояние;

// Дата - когда последний раз обновлялась кэшированная статистика УПД.
// Позволяет не гонять COUNT(*) по регистру на каждый фолбэк: результат
// живёт 60 секунд, а в промежутке отдаётся из кэша.
//
&НаКлиенте
Перем КэшСтатистикиВремя;

// Строка - хеш последнего снимка реестра (Всего+Подписано+КОтправке+
// ЖдутПодписи+СРасхождениями+MAX дат сводки/комментария).
// ДатаЗагрузки в хеш не входит: догрузка товаров иначе дёргала список.
// Если снимок не изменился — список и статистику не перечитываем.
//
&НаКлиенте
Перем ПоследнийСнимок;

// Строка - адрес временного хранилища с уже построенными деревьями цепочки
// (Соответствие: УПД -> дерево и отпечаток данных). Возврат на УПД, у
// которой данные не менялись, берёт дерево отсюда - без 12 запросов
// построения (см. ЗаполнитьЦепочкуДокументовНаСервере).
//
&НаКлиенте
Перем АдресКэшаЦепочек;

// Булево - идёт получение реестра или фоновая догрузка товаров. Пока так,
// платформа не обновляет динамический список сама (UpdateOnDataChange),
// и таймер снимка таблицу не перечитывает.
//
&НаКлиенте
Перем ИдётЗагрузкаРеестра;

// Булево - Список.Обновить() вызван кодом формы, а не пользователем.
// Активизация строки тогда не считается работой с таблицей.
//
&НаКлиенте
Перем ИдётПрограммноеОбновлениеСписка;

// Дата - последнее действие пользователя со списком (выбор другой строки).
// Пока он листает, отложенное перечитывание ждёт паузы.
//
&НаКлиенте
Перем ПоследнееДействиеСоСписком;

// Булево - снимок или оповещение просили перечитать список, но пользователь
// ещё работает с таблицей. Применим, когда он остановится.
//
&НаКлиенте
Перем ЕстьОтложенноеОбновление;

// Булево - настройка «Обработка событий через очередь» на момент открытия формы.
// Включена: четыре таймера (снимок, автосверка, таблица товаров, автоотправка)
// заменены одним минутным опросом отметки изменений реестра. Выключена -
// таймеры прежние.
//
&НаКлиенте
Перем ОчередьСобытийВключена;

// Дата - отметка изменений реестра УПД (ЭАрМ_ИзмененияРеестров), которую форма
// уже показала. Опрос перечитывает список, только если отметка новее.
//
&НаКлиенте
Перем ПоследняяОтметкаИзменений;

// Булево - очередь отправки подписывает задание на сервере (подпись на сервере
// настроена): форма автоотправку не ведёт, иначе документ ушёл бы дважды.
//
&НаКлиенте
Перем ПодписьВОчередиНаСервере;

#КонецОбласти

#Область ОбработчикиФормы

// Настраивает подсветку несошедшихся строк.
//
// Оформление задаём кодом, а не в форме: условие у списка и дерева одно
// и то же, и держать его в двух местах настроек - лишний повод им разъехаться.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// По умолчанию - УПД за последние 3 дня (сегодня и два дня до него):
	// реестр за всё время грузился долго, а работают с ним по свежим
	ДатаУПДС  = НачалоДня(ТекущаяДатаСеанса()) - 2 * 86400;
	ДатаУПДПо = НачалоДня(ТекущаяДатаСеанса());

	ДопускСуммы = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	ПогрешностьКопеек = ДопускСуммы.ПогрешностьКопеек;
	Точно = ДопускСуммы.СуммаТочно;
	Элементы.ПогрешностьКопеек.Доступность = НЕ Точно;

	// Иначе любая запись в реестр (сводка при клике, автосверка, догрузка
	// товаров) сама перечитывает таблицу и сдвигает прокрутку
	Элементы.Список.ОбновлениеПриИзмененииДанных = ОбновлениеПриИзмененииДанных.НеОбновлять;

	// Флажок «Автоотправка» - общая настройка с формой «Ожидают отправки»
	АвтоПодписания = ЭАрМ_ПанельУправленияЭДОСервер.АвтоотправкаВключена();

	ПодключитьСтатусОтправкиЭТрНКСписку();
	УстановитьОтборАннулированных(Список, НеПоказыватьАннулированные);
	УстановитьОтборБезЗамены(Список, АннулированныеБезЗамены);
	УстановитьПериодСписка(Список, ДатаУПДС, ДатаУПДПо);
	ДосчитатьСводкуПериода(ДатаУПДС, ДатаУПДПо);
	ЗаполнитьВыборСтатусаПодписания();
	УстановитьОтборСтатусаСписка(Список, ОтборСтатусаПодписания);
	ЗаполнитьВыборСтатусаПриходной();
	УстановитьОтборСтатусаПриходной(Список, ОтборСтатусаПриходной);
	ПодсветитьРазницуСуммПриходнойИУПД();

	// Замеры выбора строки: включаются папкой в настройках ЭДО (читается при
	// открытии формы - после смены настройки форму нужно переоткрыть)
	ЗамерыВключены = ЗначениеЗаполнено(ЭАрМ_НастройкиСервер.ПапкаЗамеров());
	ПодсветитьСовпадения("ЦепочкаДокументов");
	ПодсветитьРасхождения("ЦепочкаДокументов");
	ПодсветитьУКДРеестраУПД();
	ПодсветитьОтправленнуюЭТрНРеестраУПД();
	ПодсветитьПроблемыРеестраУПД();
	ЗаполнитьГалкуАннулирована();
	ПодсветитьАннулированныеУПД();
	ДобавитьКомандыКомментария();
	ДобавитьКомандуПересверкиНоменклатуры();
	ДобавитьКомандуСоздатьНоменклатуру();
	ДобавитьКомандыСверкиВручную();
	ДобавитьКомандуСверкиВсехУПД();
	НастроитьСтатусРасхожденияСтроки();

	// После голубой УКД и серой аннулированной: приходная снова красит строку
	// в зелёный. Статус подписания - самым последним.
	ПодсветитьСхождениеРеестраУПД();

	// Подписанная УПД остаётся зелёной. Жёлтый статус «Утвержден» в этой таблице не красим:
	// строка остаётся цветом сверки
	ЭАрМ_УтверждениеСБИС.НастроитьОформлениеСтатусовПодписания(УсловноеОформление, "Список", Ложь);

КонецПроцедуры

// Сверка писалась в реестр только по клику на строку. Пока форма открыта,
// догоняем ожидающие цепочки в фоне (не чаще раза в минуту), список
// перечитывается сам. Первая автосверка - по таймеру, а не при открытии:
// иначе она спорила за базу и блокировки с первым построением дерева.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Признаки = ПризнакиОчередиСобытийНаСервере();
	ОчередьСобытийВключена = Признаки.Включена;
	ПодписьВОчередиНаСервере = Признаки.ПодписьНаСервере;
	ПоследняяОтметкаИзменений = Признаки.Отметка;

	// Первый снимок — сразу, чтобы показать статистику и запомнить хеш
	Подключаемый_ОбновитьРеестрУПД();

	Если ОчередьСобытийВключена Тогда

		// Вместо четырёх таймеров - один: раз в минуту спрашиваем отметку изменений
		// реестра (ЭАрМ_ИзмененияРеестров). Сверку и сводку по событиям записи делает
		// задание ЭАрМ_ОбработкаОчереди, автоотправка с этого компьютера идёт в том же опросе
		ПодключитьОбработчикОжидания("Подключаемый_ОпросИзмененийРеестра", 60);

	Иначе

		ПодключитьОбработчикОжидания("Подключаемый_ОбновитьРеестрУПД", 120);

		// Автосверка и сводка реестра - своим таймером. Раньше они запускались
		// из таймера снимка (15 с) и первая шла сразу при открытии, споря
		// за базу с первым построением дерева
		ПодключитьОбработчикОжидания("Подключаемый_Автосверка", 120);

		// Таблица товаров - снимок. Пока пользователь в ней работает, её не
		// пересобираем: следующее построение - по этому таймеру
		ПодключитьОбработчикОжидания("Подключаемый_ОбновитьТаблицуТоваров", 300);

	КонецЕсли;

	// Подписывает только компьютер, где включили галочку
	АвтоПодписания = ЭАрМ_ПанельУправленияЭДОСервер.АвтоотправкаЭтогоКомпьютера(ИмяКомпьютера());
	Если АвтоПодписания И НЕ АвтоотправкаУЗадания() Тогда
		ЗапуститьАвтоотправку();
	КонецЕсли;

КонецПроцедуры

// Очередь отправки ведёт задание на сервере (подпись на сервере настроена):
// форма тогда не подписывает.
//
&НаКлиенте
Функция АвтоотправкаУЗадания()

	Возврат ОчередьСобытийВключена = Истина И ПодписьВОчередиНаСервере = Истина;

КонецФункции

// Минутный опрос вместо таймеров снимка, автосверки и таблицы товаров: отметка
// изменений реестра новее показанной - список (и товары выбранной УПД)
// перечитываются, нет - ничего не делается. Автоотправка с этого компьютера
// (подпись ключом рабочего места) идёт здесь же.
//
&НаКлиенте
Процедура Подключаемый_ОпросИзмененийРеестра()

	Отметка = ПоследнееИзменениеРеестраУПДНаСервере();

	Если Отметка > ПоследняяОтметкаИзменений Тогда
		ПоследняяОтметкаИзменений = Отметка;
		ОбновитьСтатистикуУПД();
		ЗапланироватьОбновлениеСписка();
		// Товары выбранной УПД: пока пользователь листает таблицу, не трогаем -
		// их перечитает следующая смена строки
		Если НЕ ПользовательРаботаетСоСписком() Тогда
			Подключаемый_ОбновитьТаблицуТоваров();
		КонецЕсли;
	КонецЕсли;

	Если АвтоПодписания И НЕ АвтоотправкаУЗадания() Тогда
		Подключаемый_Автоотправка();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПоследнееИзменениеРеестраУПДНаСервере()

	Возврат ЭАрМ_ИзмененияРеестров.ПоследнееИзменение("УПД");

КонецФункции

// Настройка очереди событий, подпись очереди и отметка изменений реестра - одним вызовом.
//
&НаСервереБезКонтекста
Функция ПризнакиОчередиСобытийНаСервере()

	Результат = Новый Структура("Включена, ПодписьНаСервере, Отметка", Ложь, Ложь, '00010101');

	Результат.Включена = ЭАрМ_НастройкиСервер.ЗначениеНастройки("Очередь_Включена") = Истина;
	Если Результат.Включена Тогда
		Результат.ПодписьНаСервере = ЭАрМ_ОбработкаПодтвержденийЭДО.ОтправкаОчередиНаСервереНастроена();
		Результат.Отметка = ЭАрМ_ИзмененияРеестров.ПоследнееИзменение("УПД");
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("Подключаемый_ОбновитьРеестрУПД");
	ОтключитьОбработчикОжидания("Подключаемый_ПрименитьОтложенноеОбновлениеСписка");
	ОтключитьОбработчикОжидания("Подключаемый_Автосверка");
	ОтключитьОбработчикОжидания("Подключаемый_ОбновитьЦепочкуПоСтроке");
	ОтключитьОбработчикОжидания("Подключаемый_ОбновитьТаблицуТоваров");
	ОтключитьОбработчикОжидания("Подключаемый_ОпросИзмененийРеестра");

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_Автосверка()

	ЗапуститьАвтообновлениеРеестра();

КонецПроцедуры

// Дубли реестра за период на форме: одна УПД поставщика (номер и дата)
// несколькими строками. Сначала список, после согласия удаляются только
// пустые строки - см. ЭАрМ_ЦепочкаЗакупки.НайтиДублиРеестраУПД.
//
&НаКлиенте
Процедура УдалитьДублиУПД(Команда)

	Дубли = НайтиДублиУПДНаСервере(ДатаУПДС, ДатаУПДПо);

	Если Дубли.Удалить.Количество() = 0 Тогда
		Текст = НСтр("ru = 'Пустых дублей за период нет.'");
		Если Дубли.Спорные.Количество() > 0 Тогда
			Текст = Текст + Символы.ПС + НСтр("ru = 'Есть группы с несколькими рабочими строками - их решают вручную:'")
				+ Символы.ПС + СтрСоединить(Дубли.Спорные, Символы.ПС);
		КонецЕсли;
		ПоказатьПредупреждение(, Текст);
		Возврат;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Удалить пустые дубли УПД (%1)? Связи цепочек, ЭТрН и корректировок перейдут на оставленную строку.'"),
		Дубли.Удалить.Количество()));
	Строки.Добавить("");
	Для Каждого Дубль Из Дубли.Удалить Цикл
		Если Строки.Количество() > 22 Тогда
			Строки.Добавить(НСтр("ru = '…'"));
			Прервать;
		КонецЕсли;
		Строки.Добавить(СтрШаблон("УПД № %1 от %2 — %3", Дубль.Номер, Формат(Дубль.Дата, "ДЛФ=D"), Дубль.Контрагент));
	КонецЦикла;

	ПоказатьВопрос(Новый ОписаниеОповещения("УдалитьДублиУПДЗавершение", ЭтотОбъект),
		СтрСоединить(Строки, Символы.ПС), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьДублиУПДЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Удаление дублей УПД...'"));
	Итог = УдалитьДублиУПДНаСервере(ДатаУПДС, ДатаУПДПо);
	Состояние();

	ПоследнийСнимок = "";
	ПеречитатьСписокРеестра();
	ПоказатьПредупреждение(, Итог.Текст);

КонецПроцедуры

