КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает реестр и запускает догрузку товаров в фоне.
//
// Возвращаемое значение:
//   Структура:
//     * Ошибка    - Строка - непустая, если до СБИС не достучались
//     * Сообщение - Строка - итог по реестру
//     * Операция  - Структура - см. ДлительныеОперации.ВыполнитьФункциюВНесколькоПотоков
//                 - Неопределено - догружать нечего
//
&НаСервереБезКонтекста
Функция ЗагрузитьУПДТочечноНаСервере(Идентификатор)

	Возврат ЭАрМ_РегламентныйОбменЭДО.ЗагрузитьУПДТочечно(Идентификатор);

КонецФункции

&НаСервереБезКонтекста
Функция ЗагрузитьРеестрНаСервере(ИдентификаторФормы, ДатаС = Неопределено, ДатаПо = Неопределено)

	Результат = Новый Структура("Ошибка, Сообщение, Операция", "", "", Неопределено);

	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();

	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Результат.Ошибка = НСтр("ru = 'Не удалось авторизоваться в СБИС, проверьте настройки ЭДО'");
		Возврат Результат;
	КонецЕсли;

	// Реестр ждём здесь: это один запрос на страницу
	Чтение = ЭАрМ_РегламентныйОбменЭДО.ПрочитатьРеестрУПД(Сессия, ,
		?(ДатаС = Неопределено, "", Формат(ДатаС, "ДФ=дд.ММ.гггг")),
		?(ДатаПо = Неопределено, "", Формат(ДатаПо, "ДФ=дд.ММ.гггг")));
	Результат.Сообщение = СтрШаблон(
		НСтр("ru = 'Получено документов УПД: %1'"), Чтение.Записано);

	ЭАрМ_РегламентныйОбменЭДО.ОбновитьПризнакЭТрНРеестраУПД();

	// Догружаем только то, что приехало сейчас. Кому нужны товары - спрашиваем
	// у регистра одним запросом.
	// Имя не "Документы": так называется свойство глобального контекста,
	// присвоить ему нельзя
	ОжидающиеДокументы = ЭАрМ_РегламентныйОбменЭДО.ДокументыУПДБезТоваров(
		Чтение.Идентификаторы);

	Если ОжидающиеДокументы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Сессия = Чтение.Сессия;

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания =
		НСтр("ru = 'Загрузка товаров УПД из СБИС'");
	ПараметрыВыполнения.КлючФоновогоЗадания = "ЭАрМ_ЗагрузкаТоваровУПД";
	// Код лежит в расширении: без этого фоновое задание запустится без него
	ПараметрыВыполнения.СРасширениямиБазыДанных = Истина;

	Результат.Операция = ДлительныеОперации.ВыполнитьФункциюВНесколькоПотоков(
		"ЭАрМ_РегламентныйОбменЭДО.ЗагрузитьТоварыУПДПоСписку",
		ПараметрыВыполнения,
		ЭАрМ_РегламентныйОбменЭДО.ПорцииДокументовУПД(ОжидающиеДокументы, Сессия));

	Результат.Сообщение = Результат.Сообщение + СтрШаблон(
		НСтр("ru = '. Товары догружаются в фоне: %1 документов'"),
		ОжидающиеДокументы.Количество());

	Возврат Результат;

КонецФункции

// Фоновая сверка ожидающих цепочек: цвет и «Расхождений нет» без клика
// по каждой УПД. Галочку «К отправке» сверка больше не ставит.
//
// Без контекста формы: вызов идёт своим таймером, и дерево цепочки
// с товарами гонялось бы на сервер и обратно при каждом запуске.
//
&НаСервереБезКонтекста
Функция ЗапуститьАвтосверкуНаСервере(ИдентификаторФормы, ДатаС = Неопределено, ДатаПо = Неопределено)

	// Сводка реестра УПД за видимый период - своим фоновым заданием (результат
	// не ждём). ДатаСводки в снимок формы не входит: иначе догрузка товаров
	// дёргала таблицу. Уже идёт у другого пользователя - пропускаем
	Попытка
		ПараметрыСводки = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
		ПараметрыСводки.НаименованиеФоновогоЗадания = НСтр("ru = 'Сводка реестра УПД'");
		ПараметрыСводки.КлючФоновогоЗадания = "ЭАрМ_СводкаРеестраУПД";
		ПараметрыСводки.СРасширениямиБазыДанных = Истина;
		ПараметрыСводки.ОжидатьЗавершение = 0;
		ДлительныеОперации.ВыполнитьФункцию(ПараметрыСводки,
			"ЭАрМ_РегламентныйОбменЭДО.ОбновитьСводкуРеестраУПД", Неопределено, ДатаС, ДатаПо, Ложь);
	Исключение
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.СводкаРеестраУПД", УровеньЖурналаРегистрации.Примечание, , ,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка

		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания =
			НСтр("ru = 'Автосверка цепочек УПД'");
		ПараметрыВыполнения.КлючФоновогоЗадания = "ЭАрМ_АвтосверкаУПД";
		ПараметрыВыполнения.СРасширениямиБазыДанных = Истина;
		ПараметрыВыполнения.ОжидатьЗавершение = 0;

		Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"ЭАрМ_СверкаТоваровЦепочки.СверитьОжидающиеДляФормы", ДатаС, ДатаПо);

	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Обработчик завершения фоновой догрузки товаров.
//
&НаКлиенте
Процедура ЗагрузкаТоваровЗавершена(Результат, ДополнительныеПараметры) Экспорт

	Попытка

		Если Результат <> Неопределено Тогда

			Если Результат.Статус = "Ошибка" Тогда
				СообщитьПользователю(СтрШаблон(НСтр("ru = 'Товары УПД не загружены: %1'"),
					Результат.КраткоеПредставлениеОшибки));
			Иначе
				СообщитьПользователю(ИтогЗагрузкиТоваров(Результат.АдресРезультата));
				ОбновитьЦепочкуДокументов();
				ОбновитьСтатистикуУПД();
			КонецЕсли;

		КонецЕсли;

	Исключение
		РазморозитьАвтообновлениеСписка(Ложь);
		ВызватьИсключение;
	КонецПопытки;

	РазморозитьАвтообновлениеСписка(Ложь);

КонецПроцедуры

// Складывает результаты потоков в одну строку для пользователя.
//
// Многопоточная операция кладёт в АдресРезультата Соответствие "порция →
// результат потока", и у каждого потока свой адрес с возвращённым числом.
//
&НаСервереБезКонтекста
Функция ИтогЗагрузкиТоваров(АдресРезультата)

	Результаты = ПолучитьИзВременногоХранилища(АдресРезультата);

	Загружено = 0;
	ПотоковСОшибкой = 0;

	Если ТипЗнч(Результаты) = Тип("Соответствие") Тогда

		Для Каждого КлючИЗначение Из Результаты Цикл

			РезультатПотока = КлючИЗначение.Значение;
			Если ТипЗнч(РезультатПотока) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;

			Если РезультатПотока.Статус <> "Выполнено" Тогда
				ПотоковСОшибкой = ПотоковСОшибкой + 1;
				Продолжить;
			КонецЕсли;

			ЗначениеПотока = ПолучитьИзВременногоХранилища(РезультатПотока.АдресРезультата);
			Если ТипЗнч(ЗначениеПотока) = Тип("Число") Тогда
				Загружено = Загружено + ЗначениеПотока;
			КонецЕсли;

		КонецЦикла;

	ИначеЕсли ТипЗнч(Результаты) = Тип("Число") Тогда
		Загружено = Результаты;
	КонецЕсли;

	Итог = СтрШаблон(НСтр("ru = 'Товары УПД загружены по %1 документам'"), Загружено);

	Если ПотоковСОшибкой > 0 Тогда
		Итог = Итог + СтрШаблон(
			НСтр("ru = ', потоков с ошибкой: %1 (подробности в журнале регистрации)'"),
			ПотоковСОшибкой);
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Показывает результат пользователю.
//
&НаКлиенте
Процедура СообщитьПользователю(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры


// Красит строку таблицы, когда её признак расхождения взведён.
//
// Параметры:
//   ИмяТаблицы - Строка - имя реквизита и элемента формы; у обоих есть
//                колонка Расходится, по ней и идёт отбор
//
&НаСервере
Процедура ПодсветитьРасхождения(ИмяТаблицы)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы);
	ОформляемоеПоле.Использование = Истина;

	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".Расходится");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Отбор.Использование  = Истина;

	// Розовый фон и тёмный текст: строка должна бросаться в глаза, но
	// оставаться читаемой и в списке, и на печати экрана
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра(
		"ЦветФона", Новый Цвет(255, 224, 224));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра(
		"ЦветТекста", Новый Цвет(140, 0, 0));

КонецПроцедуры

// Зелёные строки, которые сошлись с приходом Далиона.
// Нет карточки в УТ цвет не меняет: строка зелёная или красная по сверке.
//
&НаСервере
Процедура ПодсветитьСовпадения(ИмяТаблицы)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы);
	ОформляемоеПоле.Использование = Истина;

	ОтборРасходится = ЭлементОформления.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборРасходится.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".Расходится");
	ОтборРасходится.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборРасходится.ПравоеЗначение = Ложь;
	ОтборРасходится.Использование  = Истина;

	ОтборСверен = ЭлементОформления.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСверен.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".Сверена");
	ОтборСверен.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборСверен.ПравоеЗначение = Истина;
	ОтборСверен.Использование = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра(
		"ЦветФона", Новый Цвет(220, 255, 220));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра(
		"ЦветТекста", Новый Цвет(0, 100, 0));

КонецПроцедуры

// Строка реестра УПД: зелёная, если приходная Далиона уже есть или сверка
// сошлась. Красная - только когда сверка записала расхождение. Сама по себе
// ЭТрН строку не красит. Правило стоит после голубой УКД и серой
// аннулированной, поэтому приходная возвращает прежний зелёный.
//
&НаСервере
Процедура ПодсветитьСхождениеРеестраУПД()

	ЭлементСошлось = УсловноеОформление.Элементы.Добавить();

	ПолеСошлось = ЭлементСошлось.Поля.Элементы.Добавить();
	ПолеСошлось.Поле = Новый ПолеКомпоновкиДанных("Список");
	ПолеСошлось.Использование = Истина;

	ГруппаСошлось = ЭлементСошлось.Отбор.Элементы.Добавить(
		Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаСошлось.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	ГруппаСошлось.Использование = Истина;

	ОтборСошлось = ГруппаСошлось.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСошлось.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.РасхожденийНет");
	ОтборСошлось.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборСошлось.ПравоеЗначение = Истина;
	ОтборСошлось.Использование  = Истина;

	СтатусыСПриходом = Новый СписокЗначений;
	СтатусыСПриходом.Добавить("Сверено");
	СтатусыСПриходом.Добавить("К УПД");
	СтатусыСПриходом.Добавить("К ЭТрН");

	ОтборСтатусПрихода = ГруппаСошлось.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСтатусПрихода.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.СтатусПриходной");
	ОтборСтатусПрихода.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборСтатусПрихода.ПравоеЗначение = СтатусыСПриходом;
	ОтборСтатусПрихода.Использование  = Истина;

	// Номер или сумма прихода есть, а сводка ещё не успела поставить статус.
	// «Расхождения» красит правило ниже, «Заменена» остаётся обычной
	ГруппаЕстьПриход = ГруппаСошлось.Элементы.Добавить(
		Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаЕстьПриход.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	ГруппаЕстьПриход.Использование = Истина;

	ГруппаНомерИлиСумма = ГруппаЕстьПриход.Элементы.Добавить(
		Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаНомерИлиСумма.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	ГруппаНомерИлиСумма.Использование = Истина;

	ОтборНомерПрихода = ГруппаНомерИлиСумма.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборНомерПрихода.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.НомерДокументаДалион");
	ОтборНомерПрихода.ВидСравнения  = ВидСравненияКомпоновкиДанных.Заполнено;
	ОтборНомерПрихода.Использование = Истина;

	ОтборСуммаПрихода = ГруппаНомерИлиСумма.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСуммаПрихода.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.СуммаПриходной");
	ОтборСуммаПрихода.ВидСравнения  = ВидСравненияКомпоновкиДанных.Заполнено;
	ОтборСуммаПрихода.Использование = Истина;

	СтатусыБезЗеленого = Новый СписокЗначений;
	СтатусыБезЗеленого.Добавить("Расхождения");
	СтатусыБезЗеленого.Добавить("Заменена");
	СтатусыБезЗеленого.Добавить("Нет приходной");

	ОтборНеПроблемныйСтатус = ГруппаЕстьПриход.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборНеПроблемныйСтатус.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.СтатусПриходной");
	ОтборНеПроблемныйСтатус.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеВСписке;
	ОтборНеПроблемныйСтатус.ПравоеЗначение = СтатусыБезЗеленого;
	ОтборНеПроблемныйСтатус.Использование  = Истина;

	ЭлементСошлось.Оформление.УстановитьЗначениеПараметра(
		"ЦветФона", Новый Цвет(220, 255, 220));
	ЭлементСошлось.Оформление.УстановитьЗначениеПараметра(
		"ЦветТекста", Новый Цвет(0, 100, 0));

	ЭлементРасхождение = УсловноеОформление.Элементы.Добавить();

	ПолеРасхождение = ЭлементРасхождение.Поля.Элементы.Добавить();
	ПолеРасхождение.Поле = Новый ПолеКомпоновкиДанных("Список");
	ПолеРасхождение.Использование = Истина;

	ОтборНеСошлось = ЭлементРасхождение.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборНеСошлось.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.РасхожденийНет");
	ОтборНеСошлось.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборНеСошлось.ПравоеЗначение = Ложь;
	ОтборНеСошлось.Использование  = Истина;

	// Красная только со статусом «Расхождения». Текст сверки сам по себе
	// строку не красит: приходная без этого статуса остаётся зелёной
	ОтборСтатусРасхождения = ЭлементРасхождение.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСтатусРасхождения.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.СтатусПриходной");
	ОтборСтатусРасхождения.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборСтатусРасхождения.ПравоеЗначение = "Расхождения";
	ОтборСтатусРасхождения.Использование  = Истина;

	ЭлементРасхождение.Оформление.УстановитьЗначениеПараметра(
		"ЦветФона", Новый Цвет(255, 224, 224));
	ЭлементРасхождение.Оформление.УстановитьЗначениеПараметра(
		"ЦветТекста", Новый Цвет(140, 0, 0));

КонецПроцедуры

// УПД, у которой есть связанная корректировка (УКД): голубой фон, чтобы
// строку было видно среди обычных накладных. Красное расхождение важнее.
//
&НаСервере
Процедура ПодсветитьУКДРеестраУПД()

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Список");
	ОформляемоеПоле.Использование = Истина;

	ОтборУКД = ЭлементОформления.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУКД.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ЕстьУКД");
	ОтборУКД.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборУКД.ПравоеЗначение = Истина;
	ОтборУКД.Использование  = Истина;

	ОтборНетЭТрН = ЭлементОформления.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборНетЭТрН.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ЕстьЭТрН");
	ОтборНетЭТрН.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборНетЭТрН.ПравоеЗначение = Ложь;
	ОтборНетЭТрН.Использование  = Истина;

	ГруппаНеРасхождение = ЭлементОформления.Отбор.Элементы.Добавить(
		Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаНеРасхождение.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	ГруппаНеРасхождение.Использование = Истина;

	ОтборСошлось = ГруппаНеРасхождение.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСошлось.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.РасхожденийНет");
	ОтборСошлось.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборСошлось.ПравоеЗначение = Истина;
	ОтборСошлось.Использование  = Истина;

	ОтборБезСверки = ГруппаНеРасхождение.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборБезСверки.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.ТекстСверки");
	ОтборБезСверки.ВидСравнения  = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	ОтборБезСверки.Использование = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра(
		"ЦветФона", Новый Цвет(210, 230, 255));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра(
		"ЦветТекста", Новый Цвет(0, 50, 120));

КонецПроцедуры

// Галка «Аннулирована» для уже загруженных строк: обмен ставит её при следующем
// чтении состояния, здесь догоняются те, что закрыты в СБИС раньше ресурса.
//
&НаСервере
Процедура ЗаполнитьГалкуАннулирована()

	УсловиеЗакрыта = "НЕ (" + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УПД") + ")";

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	" + УсловиеЗакрыта + " КАК Аннулирована
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.Аннулирована <> (" + УсловиеЗакрыта + ")";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭАрМ_КорректировкиУПД.ИзменитьСтрокуРеестра("ЭАрМ_УПД_Входящий", Выборка.ИдентификаторСБИС,
			Новый Структура("Аннулирована", Выборка.Аннулирована));
	КонецЦикла;

КонецПроцедуры

// Аннулированная, отозванная, удалённая УПД (коды СБИС 19-22) - серая и курсивом: работать
// нужно с новой, которую пришлёт поставщик. УПД, по которой предложено аннулирование
// (код 27), - оранжевым: документ ещё действует, но утверждать его нельзя.
// Надпись колонки «Документ» у закрытой УПД зачёркнута.
//
&НаСервере
Процедура ПодсветитьАннулированныеУПД()

	Закрытые = Новый СписокЗначений;
	Для Каждого Код Из ЭАрМ_УтверждениеСБИС.КодыЗакрытыхДокументов() Цикл
		Закрытые.Добавить(Код);
	КонецЦикла;

	// Закрытая
	ЭлементЗакрытых = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементЗакрытых.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Список");
	ОформляемоеПоле.Использование = Истина;
	ОтборЗакрытых = ЭлементЗакрытых.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЗакрытых.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.КодСостояния");
	ОтборЗакрытых.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборЗакрытых.ПравоеЗначение = Закрытые;
	ОтборЗакрытых.Использование  = Истина;
	ЭлементЗакрытых.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(140, 140, 140));
	ЭлементЗакрытых.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(240, 240, 240));
	ЭлементЗакрытых.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , , Истина));

	// Надпись в колонке «Документ» зачёркнута
	ЭлементДокумента = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементДокумента.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Представление");
	ОформляемоеПоле.Использование = Истина;
	ОтборДокумента = ЭлементДокумента.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборДокумента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.Аннулирована");
	ОтборДокумента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборДокумента.ПравоеЗначение = Истина;
	ОтборДокумента.Использование  = Истина;
	ЭлементДокумента.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , , Истина, , Истина));

	// Ожидает аннулирования
	ЭлементОжидает = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементОжидает.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Список");
	ОформляемоеПоле.Использование = Истина;
	ОтборОжидает = ЭлементОжидает.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборОжидает.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.КодСостояния");
	ОтборОжидает.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборОжидает.ПравоеЗначение = "27";
	ОтборОжидает.Использование  = Истина;
	ЭлементОжидает.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(200, 100, 0));

КонецПроцедуры

// Колонка «ЭТрН» зелёная, если связанная накладная уже ушла в СБИС
// (утверждена или подписана) - и из реестра ЭТрН, и отсюда.
//
&НаСервере
Процедура ПодсветитьОтправленнуюЭТрНРеестраУПД()

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ЭТрН");
	ОформляемоеПоле.Использование = Истина;

	ОтборОтправлена = ЭлементОформления.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборОтправлена.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ЭТрНОтправлена");
	ОтборОтправлена.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборОтправлена.ПравоеЗначение = Истина;
	ОтборОтправлена.Использование  = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра(
		"ЦветФона", Новый Цвет(220, 255, 220));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра(
		"ЦветТекста", Новый Цвет(0, 100, 0));

КонецПроцедуры

// Запрос списка УПД задаётся здесь, а не в описании формы. Сводные поля
//   ЭТрНОтправлена  - ЭТрН по этой УПД уже отправлена;
//   СуммаУПД        - сумма строк товаров УПД с НДС, как уходит в Бухгалтерию;
//   СуммаПриходной  - приходная Далиона (цепочка, иначе шапка УПД, иначе ЭТрН);
//   СтатусПриходной - Расхождения / Сверено / К УПД / К ЭТрН / Нет приходной /
//                     Заменена
// раньше считались здесь пятью соединениями при КАЖДОМ перечитывании списка.
// Теперь это ресурсы реестра: их пересчитывает
// ЭАрМ_РегламентныйОбменЭДО.ОбновитьСводкуРеестраУПД (регламент, фон формы
// раз в минуту, дерево цепочки, загрузка строк, связь прихода) - список
// читает одну таблицу.
//
&НаСервере
Процедура ПодключитьСтатусОтправкиЭТрНКСписку()

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	УПД.*,
	|	ВЫБОР
	|		КОГДА УПД.ЕстьУКД
	|			ТОГДА УПД.СуммаСУчетомУКД
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК СуммаИтогоСУКД
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	(&НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ УПД.Дата >= &НачалоПериода)
	|	И (&КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ УПД.Дата <= &КонецПериода)
	|	И (&ВсеСтатусы
	|			ИЛИ УПД.СтатусПодписания = &СтатусПодписания)
	|	И (&ПоказыватьАннулированные
	|			ИЛИ &АннулированныеБезЗамены
	|			ИЛИ НЕ УПД.Аннулирована)
	|	И (НЕ &АннулированныеБезЗамены
	|			ИЛИ УПД.Аннулирована
	|				И УПД.ЗамененаНа = """")";

	Список.ПроизвольныйЗапрос = Истина;
	Список.ТекстЗапроса = ТекстЗапроса;
	// Явно, после смены запроса: список читает страницу по ключу основной
	// таблицы, а не весь период целиком при каждом перечитывании
	Список.ОсновнаяТаблица = "РегистрСведений.ЭАрМ_УПД_Входящий";
	Список.ДинамическоеСчитываниеДанных = Истина;

	Список.УстановитьОбязательноеИспользование("ЭТрНОтправлена", Истина);
	Список.УстановитьОбязательноеИспользование("СуммаУПД", Истина);
	Список.УстановитьОбязательноеИспользование("СуммаПриходной", Истина);
	Список.УстановитьОбязательноеИспользование("СуммаИтогоСУКД", Истина);
	// Номер и дата - кнопке «Пересверка номенклатуры»
	Список.УстановитьОбязательноеИспользование("Номер", Истина);
	Список.УстановитьОбязательноеИспользование("Дата", Истина);
	Список.УстановитьОбязательноеИспользование("СтатусПриходной", Истина);

	ДобавитьКолонкиПриходнойИУПД();
	УстановитьОтборАннулированных(Список, НеПоказыватьАннулированные);
	УстановитьОтборБезЗамены(Список, АннулированныеБезЗамены);

КонецПроцедуры

// Колонки «Приходная», «Сумма приходной», «Сумма УПД» создаются кодом: их
// поля есть только в запросе, который задаётся выше при открытии формы, -
// в описании формы такой путь к данным платформа не примет. Встают последними,
// рядом друг с другом.
//
&НаСервере
Процедура ДобавитьКолонкиПриходнойИУПД()

	ДобавитьКолонкуСписка("СтатусПриходной", НСтр("ru = 'Приходная'"),
		НСтр("ru = 'Приходная Далиона: Расхождения / Сверено / К УПД (приход связан с УПД, сверки ещё нет) / К ЭТрН (приход только у ЭТрН) / Нет приходной / Заменена (пришла УПД с тем же номером позже - нужна она)'"),
		"");
	// Суммы - сразу после «Документ», перед «Статус»: их сравнивают глазами
	// вместе с номером документа
	ДобавитьКолонкуСписка("СуммаУПД", НСтр("ru = 'Сумма УПД'"),
		НСтр("ru = 'Сумма строк товаров УПД с НДС (как уходит в БП). 0 - товары УПД ещё не загружены'"),
		"ЧДЦ=2", Элементы.СтатусПодписания);
	ДобавитьКолонкуСписка("СуммаПриходной", НСтр("ru = 'Сумма приходной'"),
		НСтр("ru = 'Сумма приходной накладной Далиона. Красная - не сходится с суммой УПД, а если есть УКД - с суммой после корректировки'"),
		"ЧДЦ=2", Элементы.СтатусПодписания);
	ДобавитьКолонкуСписка("СуммаИтогоСУКД", НСтр("ru = 'Сумма с УКД'"),
		НСтр("ru = 'Сумма УПД после корректировок. Пусто, пока связанной УКД нет'"),
		"ЧДЦ=2", Элементы.СтатусПодписания);
	ДобавитьКолонкуСписка("СвереноВручную", НСтр("ru = 'Вручную'"),
		НСтр("ru = 'Расхождения приняты вручную (кнопка «Сверилось вручную»): кто, когда и почему - в тексте сверки. Снимается кнопкой «Вернуть расхождения»'"),
		"БЛ=; БИ=Вручную", Элементы.СтатусПодписания);

	// Комментарий оператора - последними колонками (ресурсы реестра)
	ДобавитьКолонкуСписка("ЕстьПроблема", НСтр("ru = 'Проблема'"),
		НСтр("ru = 'Оператор отметил проблему по УПД (кнопка «Комментарий / проблема»); снимается кнопкой «Проблема решена»'"),
		"БЛ=; БИ=Проблема");
	// Колонку «Комментарий» в списке не показываем (длинный текст мешал
	// читать реестр). Поле нужно кнопкам «Комментарий / проблема» и
	// «Проблема решена» - они читают его из текущей строки
	Список.УстановитьОбязательноеИспользование("КомментарийОператора", Истина);

КонецПроцедуры

// Колонка «Проблема» - красная у УПД с отмеченной проблемой.
//
&НаСервере
Процедура ПодсветитьПроблемыРеестраУПД()

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	Для Каждого ИмяПоля Из СтрРазделить("ЕстьПроблема", ",") Цикл
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		ОформляемоеПоле.Использование = Истина;
	КонецЦикла;

	ОтборПроблемы = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПроблемы.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ЕстьПроблема");
	ОтборПроблемы.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПроблемы.ПравоеЗначение = Истина;
	ОтборПроблемы.Использование  = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 215, 215));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(160, 0, 0));

КонецПроцедуры

// Кнопки «Комментарий / проблема» и «Проблема решена» - на панели и в
// контекстном меню списка. Создаются кодом, как и колонки выше.
//
&НаСервере
Процедура ДобавитьКомандыКомментария()

	Описания = Новый Массив;
	Описания.Добавить(Новый Структура("Имя, Заголовок, Подсказка",
		"КомментарийПроблема", НСтр("ru = 'Комментарий / проблема'"),
		НСтр("ru = 'Оставить комментарий к УПД: нашли ошибку или проблему - опишите, строка станет красной'")));
	Описания.Добавить(Новый Структура("Имя, Заголовок, Подсказка",
		"ПроблемаРешена", НСтр("ru = 'Проблема решена'"),
		НСтр("ru = 'Снять отметку проблемы; комментарий остаётся с пометкой «решено»'")));

	Для Каждого Описание Из Описания Цикл

		Если Команды.Найти(Описание.Имя) = Неопределено Тогда
			Команда = Команды.Добавить(Описание.Имя);
			Команда.Действие = Описание.Имя;
			Команда.Заголовок = Описание.Заголовок;
			Команда.Подсказка = Описание.Подсказка;
		КонецЕсли;

		Для Каждого Панель Из СтрРазделить("СписокКоманднаяПанель,СписокКонтекстноеМеню", ",") Цикл
			ИмяКнопки = Панель + Описание.Имя;
			Если Элементы.Найти(ИмяКнопки) = Неопределено Тогда
				Кнопка = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), Элементы[Панель]);
				Кнопка.ИмяКоманды = Описание.Имя;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Кнопки «Сверилось вручную» и «Вернуть расхождения» - на панели и в
// контекстном меню списка, создаются кодом, как и кнопки комментария.
//
&НаСервере
Процедура ДобавитьКомандыСверкиВручную()

	Описания = Новый Массив;
	Описания.Добавить(Новый Структура("Имя, Заголовок, Подсказка",
		"СверилосьВручную", НСтр("ru = 'Сверилось вручную'"),
		НСтр("ru = 'Принять расхождения УПД с приходной: УПД станет «Расхождений нет» и «Готов к отправке», пересверка отметку не снимет, итоговая сумма перед подписью не проверяется. Нужен комментарий - почему'")));
	Описания.Добавить(Новый Структура("Имя, Заголовок, Подсказка",
		"ВернутьРасхождения", НСтр("ru = 'Вернуть расхождения'"),
		НСтр("ru = 'Снять ручную отметку «Сверилось»: цепочка пересверится и покажет настоящий итог'")));

	Для Каждого Описание Из Описания Цикл

		Если Команды.Найти(Описание.Имя) = Неопределено Тогда
			Команда = Команды.Добавить(Описание.Имя);
			Команда.Действие = Описание.Имя;
			Команда.Заголовок = Описание.Заголовок;
			Команда.Подсказка = Описание.Подсказка;
		КонецЕсли;

		Для Каждого Панель Из СтрРазделить("СписокКоманднаяПанель,СписокКонтекстноеМеню", ",") Цикл
			ИмяКнопки = Панель + Описание.Имя;
			Если Элементы.Найти(ИмяКнопки) = Неопределено Тогда
				Кнопка = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), Элементы[Панель]);
				Кнопка.ИмяКоманды = Описание.Имя;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Ручная отметка «Сверилось»: сначала - почему расхождения приняты. Без
// комментария не ставится: по нему потом разбираются, кто и зачем пропустил
// расхождение в подпись.
//
&НаКлиенте
Процедура СверилосьВручную(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Данные = Новый Структура("ИдентификаторУПД", ТекущиеДанные.ИдентификаторСБИС);
	ПоказатьВводСтроки(Новый ОписаниеОповещения("СверилосьВручнуюКомментарийВведен", ЭтотОбъект, Данные),
		"", СтрШаблон(НСтр("ru = 'Сверилось вручную: %1 - почему расхождения приняты?'"),
			ТекущиеДанные.Представление), 300, Истина);

КонецПроцедуры

&НаКлиенте
Процедура СверилосьВручнуюКомментарийВведен(Текст, Данные) Экспорт

	Если Текст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СокрЛП(Текст)) Тогда
		СообщитьПользователю(НСтр("ru = 'Отметка не поставлена: напишите, почему расхождения приняты - комментарий попадёт в текст сверки и в журнал'"));
		Возврат;
	КонецЕсли;

	СообщитьПользователю(СверилосьВручнуюНаСервере(Данные.ИдентификаторУПД, СокрЛП(Текст)));
	ОбновитьСписокИЦепочку();

КонецПроцедуры

&НаСервереБезКонтекста
Функция СверилосьВручнуюНаСервере(ИдентификаторУПД, Комментарий)

	Попытка
		Возврат ЭАрМ_КорректировкиУПД.ОтметитьСверенымВручную(ИдентификаторУПД, Комментарий);
	Исключение
		Возврат НСтр("ru = 'Отметка не поставлена: '")
			+ ЭАрМ_Служебный.КраткийТекстОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ВернутьРасхождения(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("ВернутьРасхожденияЗавершение", ЭтотОбъект,
		Новый Структура("ИдентификаторУПД", ТекущиеДанные.ИдентификаторСБИС)),
		СтрШаблон(НСтр("ru = 'Снять ручную отметку «Сверилось» с %1? Цепочка пересверится, и если расхождения остались, УПД снова не пойдёт на подпись.'"),
			ТекущиеДанные.Представление),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ВернутьРасхожденияЗавершение(Ответ, Данные) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СообщитьПользователю(ВернутьРасхожденияНаСервере(Данные.ИдентификаторУПД));
	ОбновитьСписокИЦепочку();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ВернутьРасхожденияНаСервере(ИдентификаторУПД)

	Попытка
		Возврат ЭАрМ_КорректировкиУПД.СнятьСверкуВручную(ИдентификаторУПД);
	Исключение
		Возврат НСтр("ru = 'Отметка не снята: '")
			+ ЭАрМ_Служебный.КраткийТекстОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Статус строки товара выбирается в колонке «Расхождение», без кнопок
// и без пересборки таблицы.
//
&НаСервере
Процедура НастроитьСтатусРасхожденияСтроки()

	Поле = Элементы.ЦепочкаДокументовРасхождение;
	Поле.ТолькоПросмотр = Ложь;
	Поле.КнопкаВыпадающегоСписка = Истина;
	Поле.РедактированиеТекста = Ложь;
	Поле.СписокВыбора.Очистить();
	Поле.СписокВыбора.Добавить(НСтр("ru = 'Сверено вручную'"));
	Поле.СписокВыбора.Добавить(НСтр("ru = 'Снять сверку'"));
	Поле.Подсказка = НСтр("ru = 'Статус строки. «Сверено вручную» принимает расхождение этой строки и не пересобирает таблицу. Подробный текст расхождения остаётся, пока статус не выбран'");
	Поле.УстановитьДействие("ПриИзменении", "ЦепочкаДокументовРасхождениеПриИзменении");

КонецПроцедуры

// Выбор статуса в «Расхождении». Таблица не пересобирается: меняется
// только эта строка, отметка пишется в реестр без пересверки цепочки.
//
&НаКлиенте
Процедура ЦепочкаДокументовРасхождениеПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ЦепочкаДокументов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Статус = СокрЛП(ТекущиеДанные.Расхождение);
	ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();

	Если Статус = НСтр("ru = 'Сверено вручную'") Тогда

		Если ТекущиеДанные.СвереноВручную Тогда
			ТекущиеДанные.Расхождение = ТекстРасхожденияДоВыбора;
			СообщитьПользователю(НСтр("ru = 'Строка уже сверена вручную'"));
			Возврат;
		КонецЕсли;

		Если НЕ ТекущиеДанные.Расходится И НЕ ТекущиеДанные.БезПары
			И НЕ ЗначениеЗаполнено(ТекстРасхожденияДоВыбора) Тогда
			ТекущиеДанные.Расхождение = ТекстРасхожденияДоВыбора;
			СообщитьПользователю(НСтр("ru = 'Строка и так сверена с приходом'"));
			Возврат;
		КонецЕсли;

		Данные = Новый Структура("ИдентификаторУПД, Позиции, Наименование, ИдентификаторСтроки",
			ИдентификаторТекущейСтроки(), ТекущиеДанные.Позиции, ТекущиеДанные.Номенклатура,
			ИдентификаторСтроки);
		ПоказатьВводСтроки(Новый ОписаниеОповещения("СвереноСтрокаВручнуюКомментарийВведен", ЭтотОбъект, Данные),
			"", СтрШаблон(НСтр("ru = 'Сверено вручную: %1 - почему?'"), ТекущиеДанные.Номенклатура), 300, Истина);
		Возврат;

	КонецЕсли;

	Если Статус = НСтр("ru = 'Снять сверку'") Тогда

		Если НЕ ТекущиеДанные.СвереноВручную Тогда
			ТекущиеДанные.Расхождение = ТекстРасхожденияДоВыбора;
			СообщитьПользователю(НСтр("ru = 'У этой строки нет ручной сверки'"));
			Возврат;
		КонецЕсли;

		Данные = Новый Структура("ИдентификаторУПД, Позиции, Наименование, ИдентификаторСтроки",
			ИдентификаторТекущейСтроки(), ТекущиеДанные.Позиции, ТекущиеДанные.Номенклатура,
			ИдентификаторСтроки);
		СнятьСверкуСтрокиЗавершение(КодВозвратаДиалога.Да, Данные);
		Возврат;

	КонецЕсли;

	ТекущиеДанные.Расхождение = ТекстРасхожденияДоВыбора;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьСтрокуТовараСверенной(ИдентификаторСтроки, Комментарий)

	СтрокаТовара = ЦепочкаДокументов.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаТовара.Сверена = Истина;
	СтрокаТовара.Расходится = Ложь;
	СтрокаТовара.БезПары = Ложь;
	СтрокаТовара.СвереноВручную = Истина;
	СтрокаТовара.Расхождение = СтрШаблон(НСтр("ru = 'Сверено вручную (%1)'"), Комментарий);

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкуСтрокиТовара(ИдентификаторСтроки)

	СтрокаТовара = ЦепочкаДокументов.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаТовара.СвереноВручную = Ложь;
	СтрокаТовара.Сверена = Ложь;
	СтрокаТовара.Расходится = Истина;
	СтрокаТовара.Расхождение = НСтр("ru = 'Сверка снята. Текст расхождения обновится через 5 минут'");

КонецПроцедуры

// «Сверено вручную» и «Снять сверку строки» больше не кнопки: статус
// выбирается в колонке «Расхождение».
//
&НаСервере
Процедура ДобавитьКомандыСверкиСтроки()

	Описания = Новый Массив;
	Описания.Добавить(Новый Структура("Имя, Заголовок, Подсказка",
		"СвереноСтрокаВручную", НСтр("ru = 'Сверено вручную'"),
		НСтр("ru = 'Принять расхождение текущей строки товаров УПД. Пересверка эту строку обратно в расхождения не вернёт. Итоговая сумма УПД по-прежнему решает отправку. Нужен комментарий - почему'")));
	Описания.Добавить(Новый Структура("Имя, Заголовок, Подсказка",
		"СнятьСверкуСтроки", НСтр("ru = 'Снять сверку строки'"),
		НСтр("ru = 'Снять ручную сверку текущей строки товаров: цепочка пересверится и строка снова покажет настоящее расхождение'")));

	Для Каждого Описание Из Описания Цикл

		Если Команды.Найти(Описание.Имя) = Неопределено Тогда
			Команда = Команды.Добавить(Описание.Имя);
			Команда.Действие = Описание.Имя;
			Команда.Заголовок = Описание.Заголовок;
			Команда.Подсказка = Описание.Подсказка;
		КонецЕсли;

		ИмяКнопки = "Цепочка" + Описание.Имя;
		Если Элементы.Найти(ИмяКнопки) = Неопределено Тогда
			Кнопка = Элементы.Вставить(ИмяКнопки, Тип("КнопкаФормы"),
				Элементы.ГруппаЦепочкаДокументов, Элементы.ЦепочкаДокументов);
			Кнопка.ИмяКоманды = Описание.Имя;
		КонецЕсли;

		ИмяМеню = "ЦепочкаДокументовКонтекстноеМеню" + Описание.Имя;
		Если Элементы.Найти(ИмяМеню) = Неопределено Тогда
			КнопкаМеню = Элементы.Добавить(ИмяМеню, Тип("КнопкаФормы"),
				Элементы.ЦепочкаДокументовКонтекстноеМеню);
			КнопкаМеню.ИмяКоманды = Описание.Имя;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СвереноСтрокаВручную(Команда)

	СтрокаТовара = ТекущаяСтрокаТовараУПД();
	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если СтрокаТовара.СвереноВручную Тогда
		СообщитьПользователю(НСтр("ru = 'Строка уже сверена вручную. Снять отметку - «Снять сверку строки»'"));
		Возврат;
	КонецЕсли;

	Если НЕ СтрокаТовара.Расходится И НЕ СтрокаТовара.БезПары Тогда
		СообщитьПользователю(НСтр("ru = 'Строка и так сверена с приходом'"));
		Возврат;
	КонецЕсли;

	Данные = Новый Структура("ИдентификаторУПД, Позиции, Наименование",
		ИдентификаторТекущейСтроки(), СтрокаТовара.Позиции, СтрокаТовара.Номенклатура);
	ПоказатьВводСтроки(Новый ОписаниеОповещения("СвереноСтрокаВручнуюКомментарийВведен", ЭтотОбъект, Данные),
		"", СтрШаблон(НСтр("ru = 'Сверено вручную: %1 - почему?'"), СтрокаТовара.Номенклатура), 300, Истина);

КонецПроцедуры

&НаКлиенте
Процедура СвереноСтрокаВручнуюКомментарийВведен(Текст, Данные) Экспорт

	Если Текст = Неопределено Тогда
		ВернутьРасхождениеСтроки(Данные);
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СокрЛП(Текст)) Тогда
		ВернутьРасхождениеСтроки(Данные);
		СообщитьПользователю(НСтр("ru = 'Отметка не поставлена: напишите, почему строка сверена'"));
		Возврат;
	КонецЕсли;

	Итог = СвереноСтрокаВручнуюНаСервере(Данные.ИдентификаторУПД, Данные.Позиции,
		Данные.Наименование, СокрЛП(Текст));
	СообщитьПользователю(Итог);
	Если СтрНачинаетсяС(Итог, НСтр("ru = 'Отметка строки не поставлена'")) Тогда
		ВернутьРасхождениеСтроки(Данные);
		Возврат;
	КонецЕсли;
	Если Данные.Свойство("ИдентификаторСтроки") Тогда
		ОтметитьСтрокуТовараСверенной(Данные.ИдентификаторСтроки, СокрЛП(Текст));
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СвереноСтрокаВручнуюНаСервере(ИдентификаторУПД, Позиции, Наименование, Комментарий)

	Попытка
		Возврат ЭАрМ_КорректировкиУПД.ОтметитьСтрокуСверенойВручную(
			ИдентификаторУПД, Позиции, Наименование, Комментарий);
	Исключение
		Возврат НСтр("ru = 'Отметка строки не поставлена: '")
			+ ЭАрМ_Служебный.КраткийТекстОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура СнятьСверкуСтроки(Команда)

	СтрокаТовара = ТекущаяСтрокаТовараУПД();
	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ СтрокаТовара.СвереноВручную Тогда
		СообщитьПользователю(НСтр("ru = 'У этой строки нет ручной сверки'"));
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("СнятьСверкуСтрокиЗавершение", ЭтотОбъект,
		Новый Структура("ИдентификаторУПД, Позиции, Наименование",
			ИдентификаторТекущейСтроки(), СтрокаТовара.Позиции, СтрокаТовара.Номенклатура)),
		СтрШаблон(НСтр("ru = 'Снять ручную сверку строки «%1»? Цепочка пересверится.'"),
			СтрокаТовара.Номенклатура),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СнятьСверкуСтрокиЗавершение(Ответ, Данные) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		ВернутьРасхождениеСтроки(Данные);
		Возврат;
	КонецЕсли;

	Итог = СнятьСверкуСтрокиНаСервере(Данные.ИдентификаторУПД, Данные.Позиции, Данные.Наименование);
	СообщитьПользователю(Итог);
	Если СтрНачинаетсяС(Итог, НСтр("ru = 'Сверка строки не снята'")) Тогда
		ВернутьРасхождениеСтроки(Данные);
		Возврат;
	КонецЕсли;
	Если Данные.Свойство("ИдентификаторСтроки") Тогда
		СнятьОтметкуСтрокиТовара(Данные.ИдентификаторСтроки);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВернутьРасхождениеСтроки(Данные)

	Если ТипЗнч(Данные) <> Тип("Структура") ИЛИ НЕ Данные.Свойство("ИдентификаторСтроки") Тогда
		Возврат;
	КонецЕсли;

	СтрокаТовара = ЦепочкаДокументов.НайтиПоИдентификатору(Данные.ИдентификаторСтроки);
	Если СтрокаТовара <> Неопределено Тогда
		СтрокаТовара.Расхождение = ТекстРасхожденияДоВыбора;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СнятьСверкуСтрокиНаСервере(ИдентификаторУПД, Позиции, Наименование)

	Попытка
		Возврат ЭАрМ_КорректировкиУПД.СнятьСверкуСтрокиВручную(ИдентификаторУПД, Позиции, Наименование);
	Исключение
		Возврат НСтр("ru = 'Сверка строки не снята: '")
			+ ЭАрМ_Служебный.КраткийТекстОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Текущая строка таблицы «Товары выбранной УПД» - именно товар УПД,
// не шапка документа и не строка прихода.
//
&НаКлиенте
Функция ТекущаяСтрокаТовараУПД()

	Если НЕ ЗначениеЗаполнено(ИдентификаторТекущейСтроки()) Тогда
		СообщитьПользователю(НСтр("ru = 'Выберите УПД в списке'"));
		Возврат Неопределено;
	КонецЕсли;

	ТекущиеДанные = Элементы.ЦепочкаДокументов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		ИЛИ НЕ СтрНачинаетсяС(ТекущиеДанные.Документ, НСтр("ru = 'Товар УПД'")) Тогда
		СообщитьПользователю(НСтр("ru = 'Встаньте на строку товара УПД в таблице товаров'"));
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Позиции) Тогда
		СообщитьПользователю(НСтр("ru = 'У строки нет номера позиции - обновите таблицу товаров'"));
		Возврат Неопределено;
	КонецЕсли;

	Возврат ТекущиеДанные;

КонецФункции

// Кнопка «Сверить все УПД с приходными» - на панели и в контекстном меню списка.
//
&НаСервере
Процедура ДобавитьКомандуСверкиВсехУПД()

	ИмяКоманды = "СверитьВсеУПДСПриходными";

	Если Команды.Найти(ИмяКоманды) = Неопределено Тогда
		Команда = Команды.Добавить(ИмяКоманды);
		Команда.Действие = ИмяКоманды;
		Команда.Заголовок = НСтр("ru = 'Сверить все УПД с приходными'");
		Команда.Подсказка = НСтр("ru = 'Все УПД периода: прочитать папку, заменить устаревшие приходные Далиона (тот же номер и дата, есть более новая), пересверить все открытые цепочки и подготовить готовые к отправке. Подписанные не трогаются'");
	КонецЕсли;

	Для Каждого Панель Из СтрРазделить("СписокКоманднаяПанель,СписокКонтекстноеМеню", ",") Цикл
		ИмяКнопки = Панель + ИмяКоманды;
		Если Элементы.Найти(ИмяКнопки) = Неопределено Тогда
			Кнопка = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), Элементы[Панель]);
			Кнопка.ИмяКоманды = ИмяКоманды;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СверитьВсеУПДСПриходными(Команда)

	Текст = СтрШаблон(НСтр("ru = 'Сверить все УПД за период %1 - %2 с приходными Далиона?
		|
		|Папка обмена будет прочитана, устаревшие приходные с тем же номером и датой заменены более новыми, все открытые цепочки пересверены заново, готовые УПД собраны к отправке. Подписанные УПД не трогаются.
		|
		|Идёт фоном, может занять несколько минут.'"),
		?(ЗначениеЗаполнено(ДатаУПДС), Формат(ДатаУПДС, "ДЛФ=D"), НСтр("ru = 'начало'")),
		?(ЗначениеЗаполнено(ДатаУПДПо), Формат(ДатаУПДПо, "ДЛФ=D"), НСтр("ru = 'сегодня'")));

	ПоказатьВопрос(Новый ОписаниеОповещения("СверитьВсеУПДСПриходнымиПослеВопроса", ЭтотОбъект),
		Текст, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СверитьВсеУПДСПриходнымиПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Операция = ЗапуститьСверкуВсехУПДВФоне(УникальныйИдентификатор, ДатаУПДС, ДатаУПДПо);
	Если ТипЗнч(Операция) = Тип("Строка") Тогда
		СообщитьПользователю(Операция);
		Возврат;
	КонецЕсли;

	ТекстСостояния = НСтр("ru = 'Сверка всех УПД с приходными'");
	Состояние(ТекстСостояния + "...");

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = ТекстСостояния;
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;

	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция,
		Новый ОписаниеОповещения("СверитьВсеУПДСПриходнымиЗавершение", ЭтотОбъект),
		ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура СверитьВсеУПДСПриходнымиЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Состояние();

	Если Результат = Неопределено Тогда
		Итог = НСтр("ru = 'Ожидание сверки всех УПД отменено: задание продолжает работу в фоне'");
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		Итог = НСтр("ru = 'Сверка всех УПД прервана: '") + Результат.КраткоеПредставлениеОшибки;
	Иначе
		Итог = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	КонецЕсли;

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(Строка(Итог));
	ТекстовыйДокумент.Показать(НСтр("ru = 'Сверка всех УПД с приходными'"));

	ОбновитьСписокИЦепочку(Истина);

КонецПроцедуры

// Возвращаемое значение:
//   Структура - длительная операция БСП; Строка - почему не запустилась
//
&НаСервереБезКонтекста
Функция ЗапуститьСверкуВсехУПДВФоне(ИдентификаторФормы, ДатаС, ДатаПо)

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Сверка всех УПД с приходными'");
	ПараметрыВыполнения.СРасширениямиБазыДанных = Истина;
	// Второй клик, пока первая сверка идёт, второго задания не запустит
	ПараметрыВыполнения.КлючФоновогоЗадания = "ЭАрМ_СверкаВсехУПДСПриходными";

	Попытка
		Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"ЭАрМ_ЦепочкаЗакупки.СверитьВсеУПДСПриходными", ДатаС, ДатаПо);
	Исключение
		Возврат СтрШаблон(НСтр("ru = 'Сверка всех УПД не запущена (возможно, уже идёт): %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

// Кнопка «Пересверка номенклатуры» - на панели и в контекстном меню списка,
// создаётся кодом, как и кнопки комментария.
//
&НаСервере
Процедура ДобавитьКомандуПересверкиНоменклатуры()

	ИмяКоманды = "ПересверкаНоменклатуры";

	Если Команды.Найти(ИмяКоманды) = Неопределено Тогда
		Команда = Команды.Добавить(ИмяКоманды);
		Команда.Действие = ИмяКоманды;
		Команда.Заголовок = НСтр("ru = 'Пересверка номенклатуры'");
		Команда.Подсказка = НСтр("ru = 'Отдельное окно: строки текущей УПД и их пары с приходом Далиона. Там можно связать строки, при необходимости с принудительной перезаписью штрихкодов поставщика, после связи цепочки пересверяются'");
	КонецЕсли;

	Для Каждого Панель Из СтрРазделить("СписокКоманднаяПанель,СписокКонтекстноеМеню", ",") Цикл
		ИмяКнопки = Панель + ИмяКоманды;
		Если Элементы.Найти(ИмяКнопки) = Неопределено Тогда
			Кнопка = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), Элементы[Панель]);
			Кнопка.ИмяКоманды = ИмяКоманды;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Кнопка «Создать номенклатуру УТ» над деревом цепочки: выделенные строки УПД
// со штрихкодом -> окно видов -> карточка УТ (тот же путь, что «Сохранить пары»,
// но без обязательной пары с приходом).
Процедура ДобавитьКомандуСоздатьНоменклатуру()

	ИмяКоманды = "СоздатьНоменклатуруУТ";

	Если Команды.Найти(ИмяКоманды) = Неопределено Тогда
		Команда = Команды.Добавить(ИмяКоманды);
		Команда.Действие = ИмяКоманды;
		Команда.Заголовок = НСтр("ru = 'Создать номенклатуру УТ'");
		Команда.Подсказка = НСтр("ru = 'Выделенные строки УПД: выбрать вид номенклатуры и создать карточку в УТ'");
	КонецЕсли;

	Для Каждого Панель Из СтрРазделить("ЦепочкаДокументовКоманднаяПанель,ЦепочкаДокументовКонтекстноеМеню", ",") Цикл
		ИмяКнопки = Панель + ИмяКоманды;
		Если Элементы.Найти(ИмяКнопки) = Неопределено Тогда
			Кнопка = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), Элементы[Панель]);
			Кнопка.ИмяКоманды = ИмяКоманды;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Открывает окно пересверки номенклатуры сразу на текущей УПД.
//
&НаКлиенте
Процедура ПересверкаНоменклатуры(Команда)

	ПараметрыФормы = Новый Структура;
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПараметрыФормы.Вставить("НомерУПД", ТекущиеДанные.Номер);
		ПараметрыФормы.Вставить("ДатаУПД",  ТекущиеДанные.Дата);
	КонецЕсли;

	ОткрытьФорму("Обработка.ЭАрМ_ПересверкаНоменклатуры.Форма.Форма", ПараметрыФормы,
		ЭтотОбъект, Новый УникальныйИдентификатор, , ,
		Новый ОписаниеОповещения("ПересверкаНоменклатурыЗакрыта", ЭтотОбъект));

КонецПроцедуры

// После пересверки пары и суммы могли измениться: перечитываем список и
// дерево цепочки текущей строки.
//
&НаКлиенте
Процедура ПересверкаНоменклатурыЗакрыта(Результат, ДополнительныеПараметры) Экспорт

	ПоследнийСнимок = "";
	КэшСтатистикиВремя = Неопределено;
	ЦепочкаПостроенаДля = Неопределено;
	ЗапланироватьОбновлениеСписка();
	ОтключитьОбработчикОжидания("Подключаемый_ОбновитьЦепочкуПоСтроке");
	ПодключитьОбработчикОжидания("Подключаемый_ОбновитьЦепочкуПоСтроке", 0.3, Истина);

КонецПроцедуры

// Комментарий к текущей УПД: текст (многострочный), затем - проблема это или
// просто пометка.
//
&НаКлиенте
Процедура КомментарийПроблема(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеКомментария = Новый Структура("ИдентификаторУПД", ТекущиеДанные.ИдентификаторСБИС);
	ПоказатьВводСтроки(Новый ОписаниеОповещения("КомментарийПроблемаТекстВведен", ЭтотОбъект, ДанныеКомментария),
		ТекущиеДанные.КомментарийОператора,
		СтрШаблон(НСтр("ru = 'Комментарий: %1 - что не так?'"), ТекущиеДанные.Представление),
		1000, Истина);

КонецПроцедуры

&НаКлиенте
Процедура КомментарийПроблемаТекстВведен(Текст, ДанныеКомментария) Экспорт

	Если Текст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДанныеКомментария.Вставить("Текст", СокрЛП(Текст));

	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Это проблема'"));
	Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Просто комментарий'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
	ПоказатьВопрос(Новый ОписаниеОповещения("КомментарийПроблемаЗавершение", ЭтотОбъект, ДанныеКомментария),
		НСтр("ru = 'Отметить УПД как проблемную (строка станет красной)?'"), Кнопки, , КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура КомментарийПроблемаЗавершение(Ответ, ДанныеКомментария) Экспорт

	Если Ответ = КодВозвратаДиалога.Отмена ИЛИ Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьКомментарийУПД(ДанныеКомментария.ИдентификаторУПД, ДанныеКомментария.Текст, Ответ = КодВозвратаДиалога.Да, Ложь);
	ПеречитатьСписокРеестра();
	Оповестить("ЭАрМ_УПД_Обновление", Неопределено, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПроблемаРешена(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ НЕ ТекущиеДанные.ЕстьПроблема Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'У текущей УПД проблема не отмечена.'"));
		Возврат;
	КонецЕсли;

	ЗаписатьКомментарийУПД(ТекущиеДанные.ИдентификаторСБИС, ТекущиеДанные.КомментарийОператора, Ложь, Истина);
	ПеречитатьСписокРеестра();
	Оповестить("ЭАрМ_УПД_Обновление", Неопределено, ЭтотОбъект);

КонецПроцедуры

// Пишет комментарий в реестр УПД (ресурсы КомментарийОператора, ЕстьПроблема,
// КомментарийАвтор, КомментарийДата) с блокировкой строки - как все записи
// реестра; остальные поля не трогает. Каждое изменение - в журнал регистрации.
//
&НаСервереБезКонтекста
Процедура ЗаписатьКомментарийУПД(Знач ИдентификаторУПД, Знач Текст, Знач ЕстьПроблема, Знач Решено)

	Автор = ИмяПользователя();
	Момент = ТекущаяДатаСеанса();

	Если Решено Тогда
		Текст = СтрШаблон(НСтр("ru = '[решено %1, %2] %3'"),
			Формат(Момент, "ДФ='dd.MM.yyyy HH:mm'"), Автор, Текст);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра("РегистрСведений.ЭАрМ_УПД_Входящий", ИдентификаторУПД);

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторУПД;
		МенеджерЗаписи.Прочитать();
		Если НЕ МенеджерЗаписи.Выбран() Тогда
			ВызватьИсключение НСтр("ru = 'УПД не найдена в реестре'");
		КонецЕсли;

		МенеджерЗаписи.КомментарийОператора = Лев(Текст, 1000);
		МенеджерЗаписи.ЕстьПроблема = ЕстьПроблема;
		МенеджерЗаписи.КомментарийАвтор = Лев(Автор, 100);
		МенеджерЗаписи.КомментарийДата = Момент;
		МенеджерЗаписи.Записать(Истина);

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.КомментарийУПД", УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("%1 [%2%3]: %4", ИдентификаторУПД,
			?(ЕстьПроблема, НСтр("ru = 'проблема'"), НСтр("ru = 'комментарий'")),
			?(Решено, НСтр("ru = ', решено'"), ""), Текст));

КонецПроцедуры

&НаСервере
Процедура ДобавитьКолонкуСписка(ИмяПоля, Заголовок, Подсказка, Формат, ПередКолонкой = Неопределено)

	Если Элементы.Найти(ИмяПоля) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Колонка = Элементы.Вставить(ИмяПоля, Тип("ПолеФормы"), Элементы.Список, ПередКолонкой);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Список." + ИмяПоля;
	Колонка.Заголовок = Заголовок;
	Колонка.Подсказка = Подсказка;
	Колонка.ТолькоПросмотр = Истина;
	// Ячейка - одна строка: колонка, созданная кодом, без этого могла
	// растягивать строки списка по высоте
	Колонка.Высота = 1;
	Если ЗначениеЗаполнено(Формат) Тогда
		Колонка.Формат = Формат;
	КонецЕсли;

КонецПроцедуры

// Варианты отбора по статусу подписания: все, без статуса и значения
// перечисления - новые статусы попадают в список сами.
//
&НаСервере
Процедура ЗаполнитьВыборСтатусаПодписания()

	СписокВыбора = Элементы.ОтборСтатусаПодписания.СписокВыбора;
	СписокВыбора.Очистить();
	СписокВыбора.Добавить("", НСтр("ru = 'Все статусы'"));
	СписокВыбора.Добавить("БезСтатуса", НСтр("ru = 'Без статуса'"));

	Для Каждого ЗначениеПеречисления Из Метаданные.Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ЗначенияПеречисления Цикл
		СписокВыбора.Добавить(ЗначениеПеречисления.Имя, ЗначениеПеречисления.Представление());
	КонецЦикла;

КонецПроцедуры

// Отбор списка УПД по статусу подписания. Пусто - все статусы,
// «БезСтатуса» - статус не заполнен, иначе имя значения перечисления.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборСтатусаСписка(Список, ИмяСтатуса)

	Список.Параметры.УстановитьЗначениеПараметра("ВсеСтатусы", НЕ ЗначениеЗаполнено(ИмяСтатуса));

	Если НЕ ЗначениеЗаполнено(ИмяСтатуса) ИЛИ ИмяСтатуса = "БезСтатуса" Тогда
		Статус = ПредопределенноеЗначение("Перечисление.ЭАрМ_СтатусыПодписанияЭДО.ПустаяСсылка");
	Иначе
		Статус = ПредопределенноеЗначение("Перечисление.ЭАрМ_СтатусыПодписанияЭДО." + ИмяСтатуса);
	КонецЕсли;
	Список.Параметры.УстановитьЗначениеПараметра("СтатусПодписания", Статус);

КонецПроцедуры

&НаКлиенте
Процедура ОтборСтатусаПодписанияПриИзменении(Элемент)

	УстановитьОтборСтатусаСписка(Список, ОтборСтатусаПодписания);

КонецПроцедуры

// Варианты отбора по приходной Далиона - значения поля СтатусПриходной
// запроса списка (см. ПодключитьСтатусОтправкиЭТрНКСписку).
//
&НаСервере
Процедура ЗаполнитьВыборСтатусаПриходной()

	СписокВыбора = Элементы.ОтборСтатусаПриходной.СписокВыбора;
	СписокВыбора.Очистить();
	СписокВыбора.Добавить("", НСтр("ru = 'Все'"));
	Для Каждого Статус Из СтрРазделить("Расхождения,Сверено,К УПД,К ЭТрН,Нет приходной,Заменена", ",") Цикл
		СписокВыбора.Добавить(Статус);
	КонецЦикла;

КонецПроцедуры

// Отбор списка по статусу приходной. Пусто - без отбора.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборСтатусаПриходной(Список, Статус)

	Поле = Новый ПолеКомпоновкиДанных("СтатусПриходной");

	ЭлементОтбора = Неопределено;
	Для Каждого Элемент Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных")
			И Элемент.ЛевоеЗначение = Поле Тогда
			ЭлементОтбора = Элемент;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЭлементОтбора = Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(Статус) Тогда
			Возврат;
		КонецЕсли;
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Поле;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	КонецЕсли;

	ЭлементОтбора.ПравоеЗначение = Статус;
	ЭлементОтбора.Использование = ЗначениеЗаполнено(Статус);

КонецПроцедуры

&НаКлиенте
Процедура ОтборСтатусаПриходнойПриИзменении(Элемент)

	УстановитьОтборСтатусаПриходной(Список, ОтборСтатусаПриходной);

КонецПроцедуры

// Галка «Не показывать аннулированные»: закрытые в СБИС УПД уходят из списка.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборАннулированных(Список, Скрывать)

	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьАннулированные", НЕ Скрывать);

КонецПроцедуры

// Галка «Аннулированные без замены»: только закрытые в СБИС УПД, взамен которых
// новая ещё не пришла. Перекрывает «Не показывать аннулированные».
//
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборБезЗамены(Список, ТолькоБезЗамены)

	Список.Параметры.УстановитьЗначениеПараметра("АннулированныеБезЗамены", ТолькоБезЗамены = Истина);

КонецПроцедуры

&НаКлиенте
Процедура АннулированныеБезЗаменыПриИзменении(Элемент)

	УстановитьОтборБезЗамены(Список, АннулированныеБезЗамены);

КонецПроцедуры

&НаКлиенте
Процедура НеПоказыватьАннулированныеПриИзменении(Элемент)

	УстановитьОтборАннулированных(Список, НеПоказыватьАннулированные);
	УстановитьОтборБезЗамены(Список, АннулированныеБезЗамены);

КонецПроцедуры

// Красным - приходная и сумма, с которой её сравнивают. Пока приходной нет
// (0), не подсвечивается. ЕстьУКД отбирает, какую пару колонок красить.
//
&НаСервере
Процедура ПодсветитьРазницуСумм(ИменаПолей, ИмяСуммыДокумента, ЕстьУКД)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	Для Каждого ИмяПоля Из СтрРазделить(ИменаПолей, ",") Цикл
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		ОформляемоеПоле.Использование = Истина;
	КонецЦикла;

	ОтборЕстьПриходная = ЭлементОформления.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЕстьПриходная.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.СуммаПриходной");
	ОтборЕстьПриходная.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЕстьПриходная.ПравоеЗначение = 0;
	ОтборЕстьПриходная.Использование  = Истина;

	ОтборУКД = ЭлементОформления.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУКД.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ЕстьУКД");
	ОтборУКД.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборУКД.ПравоеЗначение = ЕстьУКД;
	ОтборУКД.Использование  = Истина;

	ОтборРазница = ЭлементОформления.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборРазница.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.СуммаПриходной");
	ОтборРазница.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборРазница.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Список." + ИмяСуммыДокумента);
	ОтборРазница.Использование  = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра(
		"ЦветТекста", Новый Цвет(200, 0, 0));

КонецПроцедуры

// Суммы приходной Далиона и УПД не сходятся - обе красным. Без УКД
// сравнивается сумма УПД, с УКД - сумма после корректировки.
//
&НаСервере
Процедура ПодсветитьРазницуСуммПриходнойИУПД()

	ПодсветитьРазницуСумм("СуммаПриходной,СуммаУПД", "СуммаУПД", Ложь);
	ПодсветитьРазницуСумм("СуммаПриходной,СуммаИтогоСУКД", "СуммаИтогоСУКД", Истина);

	// Заменённая УПД (пришла такая же позже) - серая: работать нужно с новой
	ЭлементЗамены = УсловноеОформление.Элементы.Добавить();
	Для Каждого ИмяПоля Из СтрРазделить("СтатусПриходной,СуммаПриходной,СуммаУПД,СуммаИтогоСУКД", ",") Цикл
		ОформляемоеПоле = ЭлементЗамены.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		ОформляемоеПоле.Использование = Истина;
	КонецЦикла;
	ОтборЗамены = ЭлементЗамены.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЗамены.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.СтатусПриходной");
	ОтборЗамены.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЗамены.ПравоеЗначение = "Заменена";
	ОтборЗамены.Использование  = Истина;
	ЭлементЗамены.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(150, 150, 150));

КонецПроцедуры

// Период отбора списка УПД по дате документа. Пустая дата - без границы.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПериодСписка(Список, ДатаС, ДатаПо)

	Список.Параметры.УстановитьЗначениеПараметра("НачалоПериода",
		?(ЗначениеЗаполнено(ДатаС), НачалоДня(ДатаС), Дата(1, 1, 1)));
	Список.Параметры.УстановитьЗначениеПараметра("КонецПериода",
		?(ЗначениеЗаполнено(ДатаПо), КонецДня(ДатаПо), Дата(1, 1, 1)));

КонецПроцедуры

&НаКлиенте
Процедура ПогрешностьКопеекПриИзменении(Элемент)

	Если ПогрешностьКопеек < 0 Тогда
		ПогрешностьКопеек = 0;
	КонецЕсли;
	СохранитьДопускСуммыНаСервере(ПогрешностьКопеек, Точно);
	ОбновитьЦепочкуДокументов();

КонецПроцедуры

&НаКлиенте
Процедура ТочноПриИзменении(Элемент)

	Элементы.ПогрешностьКопеек.Доступность = НЕ Точно;
	СохранитьДопускСуммыНаСервере(ПогрешностьКопеек, Точно);
	ОбновитьЦепочкуДокументов();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьДопускСуммыНаСервере(Копеек, СуммаТочно)

	ЭАрМ_НастройкиСервер.СохранитьНастройку("Цепочка_ПогрешностьКопеек", Макс(Копеек, 0));
	ЭАрМ_НастройкиСервер.СохранитьНастройку("Цепочка_СуммаТочно", СуммаТочно = Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПериодУПДПриИзменении(Элемент)

	УстановитьПериодСписка(Список, ДатаУПДС, ДатаУПДПо);
	ДосчитатьСводкуПериода(ДатаУПДС, ДатаУПДПо);
	ОбновитьСтатистикуУПД();

КонецПроцедуры

// Строки периода, у которых сводки ещё нет (старые УПД, новый период), -
// досчитываются сразу, чтобы в колонках не стояли нули до первого фона.
// Строки со сводкой не трогает - их обновляет фон формы и регламент.
//
&НаСервереБезКонтекста
Процедура ДосчитатьСводкуПериода(Знач ДатаС, Знач ДатаПо)

	Попытка
		ЭАрМ_РегламентныйОбменЭДО.ОбновитьСводкуРеестраУПД(Неопределено, ДатаС, ДатаПо, Истина);
	Исключение
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.СводкаРеестраУПД", УровеньЖурналаРегистрации.Предупреждение, , ,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция ИдентификаторТекущейСтроки()

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ТекущиеДанные.ИдентификаторСБИС;

КонецФункции

// Разбирает выгрузки приходных накладных из папки обмена.
//
// Возвращаемое значение:
//   Строка - итог чтения для пользователя
//
&НаСервереБезКонтекста
Функция ЗабратьНакладныеДалионНаСервере()

	Чтение = ЭАрМ_РегламентныйОбменЭДО.ПрочитатьПриходныеНакладныеИзПапки();
	ИтогПакетов = ЭАрМ_ПриемПакетовДалион.ВыполнитьВручную();

	Итог = ?(Чтение.Разобрано > 0,
		СтрШаблон(НСтр("ru = 'Приходных накладных разобрано: %1'"), Чтение.Разобрано)
			+ Символы.ПС + ИтогПакетов,
		ИтогПакетов);

	Если ЗначениеЗаполнено(Чтение.Сообщение) Тогда
		Итог = Итог + Символы.ПС + Чтение.Сообщение;
	КонецЕсли;

	Возврат Итог;

КонецФункции

