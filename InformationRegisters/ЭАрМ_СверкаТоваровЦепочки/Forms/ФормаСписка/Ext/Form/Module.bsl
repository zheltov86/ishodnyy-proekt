////////////////////////////////////////////////////////////////////////////////
// Форма списка регистра ЭАрМ_СверкаТоваровЦепочки.
//
// Колонки - те же и в том же порядке, что у автоматической формы регистра:
// сначала измерения, потом ресурсы. Своя форма понадобилась ради двух команд:
//   «Прогнать несверенные по названию» - для цепочек со строками «Нет в УПД» /
//     «Нет в поступлении» пары ищутся по названию с понижением порога, пока
//     цепочка не сойдётся (см. ЭАрМ_СверкаТоваровЦепочки.ПрогнатьНесверенныеПоНазванию);
//   «Только несверенные» - быстрый отбор этих строк и обратно.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьЗаголовок();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Прогон несверенных строк по названию.
//
// Меняет сверку многих цепочек сразу и может сделать УПД сошедшейся, то есть
// готовой к утверждению, - поэтому сначала вопрос.
//
&НаКлиенте
Процедура ПрогнатьПоНазванию(Команда)

	ОписаниеОповещения = Новый ОписаниеОповещения("ПрогнатьПоНазваниюПодтверждение", ЭтотОбъект);

	ПоказатьВопрос(ОписаниеОповещения,
		НСтр("ru = 'Прогнать несверенные строки по названию? Для каждой цепочки порог совпадения слов будет понижаться до 50%, пока цепочка не сойдётся. Разный вес, объём или жирность пару запрещают всегда. Результат держится до следующей обычной пересверки цепочки.'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПрогнатьПоНазваниюПодтверждение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Прогон несверенных строк по названию...'"));
	Текст = ПрогнатьПоНазваниюНаСервере();
	Состояние();

	Элементы.Список.Обновить();
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

// Показать только несверенные строки и обратно.
//
// Состояние переключателя хранит сам отбор списка - так же, как «Только
// ошибки» в журнале обмена.
//
&НаКлиенте
Процедура ТолькоНесверенные(Команда)

	ПереключитьОтборНесверенныхНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ГрафикЦен(Команда)

	ПараметрыФормы = Новый Структура("Штрихкод, Номенклатура", "", "");
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПараметрыФормы.Штрихкод = ТекущиеДанные.Штрихкод;
		Если ЗначениеЗаполнено(ТекущиеДанные.НаименованиеУПД) Тогда
			ПараметрыФормы.Номенклатура = ТекущиеДанные.НаименованиеУПД;
		ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.НоменклатураПоступления) Тогда
			ПараметрыФормы.Номенклатура = ТекущиеДанные.НоменклатураПоступления;
		Иначе
			ПараметрыФормы.Номенклатура = ТекущиеДанные.НоменклатураЗаказа;
		КонецЕсли;
	КонецЕсли;

	ОткрытьФорму("РегистрСведений.ЭАрМ_СверкаТоваровЦепочки.Форма.ФормаГрафикаЦен", ПараметрыФормы);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПрогнатьПоНазваниюНаСервере()

	Возврат ЭАрМ_СверкаТоваровЦепочки.ПрогнатьНесверенныеПоНазванию().Текст;

КонецФункции

&НаСервере
Процедура ПереключитьОтборНесверенныхНаСервере()

	ЭлементОтбора = ЭлементОтбораНесверенных();

	Если ЭлементОтбора = Неопределено Тогда
		Несверенные = Новый СписокЗначений;
		Несверенные.Добавить("НетВУПД");
		Несверенные.Добавить("НетВПоступлении");

		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Результат");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.ПравоеЗначение = Несверенные;
		ЭлементОтбора.Использование  = Истина;
	Иначе
		Список.Отбор.Элементы.Удалить(ЭлементОтбора);
	КонецЕсли;

	ОбновитьЗаголовок();

КонецПроцедуры

&НаСервере
Функция ЭлементОтбораНесверенных()

	Поле = Новый ПолеКомпоновкиДанных("Результат");
	Для Каждого Элемент Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных")
			И Элемент.ЛевоеЗначение = Поле
			И Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервере
Процедура ОбновитьЗаголовок()

	ЭтаФорма.Заголовок = ?(ЭлементОтбораНесверенных() = Неопределено,
		НСтр("ru = 'Сверка товаров цепочки'"),
		НСтр("ru = 'Сверка товаров цепочки: только несверенные'"));

КонецПроцедуры

#КонецОбласти
