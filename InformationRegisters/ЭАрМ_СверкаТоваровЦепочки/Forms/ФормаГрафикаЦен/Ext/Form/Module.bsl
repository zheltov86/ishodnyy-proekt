////////////////////////////////////////////////////////////////////////////////
// График динамики цен УПД и прихода по регистру сверки товаров цепочки.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Штрихкод") Тогда
		Штрихкод = Параметры.Штрихкод;
	КонецЕсли;
	Если Параметры.Свойство("Номенклатура") Тогда
		Номенклатура = Параметры.Номенклатура;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПостроитьГрафикНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ПостроитьГрафикНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПостроитьГрафик(Команда)

	ПостроитьГрафикНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПостроитьГрафикНаСервере()

	ДиаграммаЦен.Обновление = Ложь;
	ДиаграммаЦен.Очистить();
	ДиаграммаЦен.ТипДиаграммы = ТипДиаграммы.График;

	СерияУПД = ДиаграммаЦен.Серии.Добавить(НСтр("ru = 'Цена УПД'"));
	СерияПН  = ДиаграммаЦен.Серии.Добавить(НСтр("ru = 'Цена прихода'"));

	Для Каждого СтрокаГрафика Из ЭАрМ_СверкаТоваровЦепочки.ДанныеГрафикаЦен(Штрихкод, Номенклатура) Цикл

		Точка = ДиаграммаЦен.Точки.Добавить(Формат(СтрокаГрафика.Дата, "ДЛФ=D"));
		Если СтрокаГрафика.ЦенаУПД <> 0 Тогда
			ДиаграммаЦен.УстановитьЗначение(Точка, СерияУПД, СтрокаГрафика.ЦенаУПД);
		КонецЕсли;
		Если СтрокаГрафика.ЦенаПоступления <> 0 Тогда
			ДиаграммаЦен.УстановитьЗначение(Точка, СерияПН, СтрокаГрафика.ЦенаПоступления);
		КонецЕсли;

	КонецЦикла;

	ДиаграммаЦен.Обновление = Истина;

КонецПроцедуры

#КонецОбласти
