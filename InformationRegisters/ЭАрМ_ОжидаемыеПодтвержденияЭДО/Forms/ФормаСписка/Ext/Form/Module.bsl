////////////////////////////////////////////////////////////////////////////////
// Форма списка ЭАрМ_ОжидаемыеПодтвержденияЭДО.
//
// Очередь документов, готовых к подписанию в СБИС. Отправка идёт по очереди -
// порядок строк сохраняется, - но за два похода на сервер на всю пачку:
// подготовка всех документов одним вызовом, затем подписание всех вложений
// на клиенте одним сертификатом, затем отправка всех подписей одним вызовом.
// Ходить на сервер на каждый документ незачем: сессия СБИС и соединение
// поднимаются один раз, а пользователь один раз отвечает на запрос ключа.
//
// Список показан таблицей значений, а не динамическим списком: динамический
// список в 1С не редактируется, и флажок «Отправить» в нём нажать нельзя -
// он только рисовался. Здесь «Отправить» - обычное булево поле таблицы,
// нажатие на ячейку сразу пишет отметку в регистр.
//
// В таблице только то, что читает человек: статус, вид документа, номер, дата,
// поставщик, даты отправки и подписи, короткое объяснение. Идентификаторы СБИС
// и запроса - колонки реквизита, на форму не вынесены: у таблицы значений
// ТекущиеДанные отдают все колонки, показаны они или нет.
//
// Цвет строки ведёт статус:
//   Готовы к отправке    - обычная, ничего ещё не делали;
//   Отправлен / подписан - зелёная, ушло в СБИС;
//   Ошибка отправки      - красная.
////////////////////////////////////////////////////////////////////////////////

#Область ПеременныеФормы

// Массив из Структура - подготовленные подписания всей пачки: у каждого этап,
// вложения и их подписи. Живёт между шагами асинхронной цепочки.
//
&НаКлиенте
Перем ПакетПодписания;

// Число - документ пачки, вложения которого подписываются сейчас.
//
&НаКлиенте
Перем ИндексДокумента;

// Число - вложение текущего документа.
//
&НаКлиенте
Перем ИндексВложения;

// Массив из Строка - что не удалось ещё на подготовке.
//
&НаКлиенте
Перем ОшибкиПодготовки;

&НаКлиенте
Перем СертификатПодписи;

&НаКлиенте
Перем МенеджерПодписи;

// Булево - подготовка или отправка пачки идёт фоновым заданием: форма не
// висит, новую пачку, пока не закончилась эта, не начинаем.
//
&НаКлиенте
Перем ИдётФоновоеПодписание;

// Структура - автоотправка этой формы (ЭАрМ_ПанельУправленияЭДОКлиент.
// НовоеСостояниеАвтоотправки): подписант, взятые документы, текущая пачка.
//
&НаКлиенте
Перем АвтоСостояние;

// Структура - опрос индикатора отправки в шапке (см.
// ЭАрМ_ПанельУправленияЭДОКлиент.ОбновитьИндикаторОтправки).
//
&НаКлиенте
Перем КэшИндикатораОтправки;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЭтаФорма.Заголовок = НСтр("ru = 'Ожидают отправки в СБИС'");

	АвтоотправкаУПД = ЭАрМ_ПанельУправленияЭДОСервер.АвтоотправкаВключена();
	ЗаполнитьСписокПодписантов();

	НастроитьКолонки();
	НастроитьЦветаСтрок();

	// По умолчанию - только то, что ещё не ушло в СБИС
	ТолькоНеОтправленные = Истина;

	// Магазин строкам очереди дописывает регламент (СобратьГотовыеКОтправке):
	// при открытии формы перебор всех строк без магазина её и тормозил

	// Дубли строк одного документа (остались от параллельной записи) -
	// склеиваем сразу, не дожидаясь регламента. Без дублей - один запрос
	ЭАрМ_ОбработкаПодтвержденийЭДО.УбратьДублиОчереди();

	// Ключ на сервере здесь не проверяем: это делает только компьютер,
	// на котором включена галочка, и только при открытии его формы
	ЗаполнитьОчередьНаСервере(Ложь, Истина);

КонецПроцедуры

// Сохраняет флажок «Автоотправка» - одна настройка с реестром УПД.
//
&НаКлиенте
Процедура АвтоотправкаУПДФлагПриИзменении(Элемент)

	ЭАрМ_ПанельУправленияЭДОСервер.УстановитьАвтоотправку(АвтоотправкаУПД, ИмяКомпьютера());

	// Флажок - это и функциональная опция «Очередь отправки в СБИС»: кнопки
	// серверной отправки появляются/скрываются после обновления интерфейса
	ОбновитьИнтерфейс();
	ОбновитьИтогиОчереди(АвтоотправкаУПД);

	// Подписывает только этот компьютер. Сняли галочку - таймер гаснет.
	Если АвтоотправкаУПД И АвтоСостояние = Неопределено Тогда
		ЗапуститьАвтоотправку();
	ИначеЕсли НЕ АвтоотправкаУПД Тогда
		ОстановитьАвтоотправку();
		АвтоСостояние = Неопределено;
	КонецЕсли;

КонецПроцедуры

// Подписант этого рабочего места: запоминается по компьютеру, дальше с этого
// места подписывает он - и кнопками, и автоотправкой, без вопроса.
//
&НаКлиенте
Процедура ПодписантРабочегоМестаПриИзменении(Элемент)

	ЭАрМ_ПанельУправленияЭДОСервер.СохранитьПодписантаРабочегоМеста(ИмяКомпьютера(),
		?(ЗначениеЗаполнено(ПодписантРабочегоМеста), ПодписантРабочегоМеста, 0));

	// Автоотправка сразу подписывает новым подписантом
	Если АвтоСостояние <> Неопределено И ЗначениеЗаполнено(ПодписантРабочегоМеста) Тогда
		АвтоСостояние.НомерПодписанта = ПодписантРабочегоМеста;
	КонецЕсли;

КонецПроцедуры

// Флажок уже стоял - автоотправка начинает работать, как только форма открыта.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПодписантРабочегоМеста = ЭАрМ_ПанельУправленияЭДОСервер.ПодписантРабочегоМеста(ИмяКомпьютера());

	// Галочка на чужом компьютере на этой форме не горит и таймер не стартует
	АвтоотправкаУПД = ЭАрМ_ПанельУправленияЭДОСервер.АвтоотправкаЭтогоКомпьютера(ИмяКомпьютера());
	Если АвтоотправкаУПД Тогда
		ЗапуститьАвтоотправку();
		ОбновитьИтогиОчереди(Истина);
	КонецЕсли;

	// Индикатор отправки в шапке: колесо и зелёная метка, пока идёт
	// отправка (СБИС или Бухгалтерия); пауза, если автоотправка выключена.
	// Секундомер в шапке не показываем.
	Подключаемый_ПроверитьОтправку();
	ПодключитьОбработчикОжидания("Подключаемый_ПроверитьОтправку", 3);

КонецПроцедуры

// Индикатор отправки в шапке: колесо и зелёная метка, пока отправляет
// сервер, эта форма или выгрузка в Бухгалтерию. Секундомер не показывается.
// Отправка закончилась - перечитывает очередь и счётчики.
//
&НаКлиенте
Процедура Подключаемый_ПроверитьОтправку()

	ФормаОтправляет = ИдётФоновоеПодписание = Истина
		ИЛИ (АвтоСостояние <> Неопределено И АвтоСостояние.Идёт);

	Если ЭАрМ_ПанельУправленияЭДОКлиент.ОбновитьИндикаторОтправки(ЭтотОбъект,
		"ИдётОтправкаНадпись", КэшИндикатораОтправки, ФормаОтправляет) Тогда
		ОбновитьСписокИИтоги();
	КонецЕсли;

КонецПроцедуры

#Область Автоотправка

// Автоотправка: всё, что попало в очередь и ещё не отправлено, уходит в СБИС
// само - пачками по 5, раз в минуту, пока форма открыта. Сошедшиеся УПД и УКД
// реестра попадают в очередь тем же фоновым заданием. Подпись - ключом этого
// компьютера (подписант рабочего места), подготовка и отправка - фоновыми
// заданиями, форма не висит. Сама цепочка - ЭАрМ_ПанельУправленияЭДОКлиент,
// общая с реестром УПД.
//
// Строки «Ошибка отправки» автоотправка не берёт, а документ, который уже
// брала в этом сеансе формы, второй раз не берёт. Их отправляют кнопкой.
//
&НаКлиенте
Процедура ЗапуститьАвтоотправку()

	АвтоСостояние = ЭАрМ_ПанельУправленияЭДОКлиент.НовоеСостояниеАвтоотправки(ЭтотОбъект,
		Новый ОписаниеОповещения("АвтоПачкаЗавершена", ЭтотОбъект));
	ЭАрМ_ПанельУправленияЭДОКлиент.ВыбратьПодписантаАвтоотправки(АвтоСостояние,
		Новый ОписаниеОповещения("АвтоотправкаПодписантВыбран", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура АвтоотправкаПодписантВыбран(НомерПодписанта, ДополнительныеПараметры) Экспорт

	Если НомерПодписанта = Неопределено Тогда
		// Настройку не трогаем: без подписанта эта форма просто не подписывает
		АвтоСостояние = Неопределено;
		ПоказатьОповещениеПользователя(НСтр("ru = 'Отправка из очереди не запущена'"), ,
			НСтр("ru = 'Подписант не выбран - выберите «Подписант рабочего места» внизу формы'"));
		Возврат;
	КонецЕсли;

	ОтключитьОбработчикОжидания("Подключаемый_Автоотправка");
	ПодключитьОбработчикОжидания("Подключаемый_Автоотправка", 60);
	ПодключитьОбработчикОжидания("Подключаемый_АвтоотправкаСейчас", 2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьАвтоотправку()

	ОтключитьОбработчикОжидания("Подключаемый_Автоотправка");
	ОтключитьОбработчикОжидания("Подключаемый_АвтоотправкаСейчас");

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_АвтоотправкаСейчас()

	Подключаемый_Автоотправка();

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_Автоотправка()

	// Ручная пачка кнопкой идёт - автоотправка ждёт
	Если ИдётФоновоеПодписание = Истина Тогда
		Возврат;
	КонецЕсли;

	ЭАрМ_ПанельУправленияЭДОКлиент.ЗапуститьАвтоПачку(АвтоСостояние);

КонецПроцедуры

// Пачка закончилась: очередь перечитывается, итог - оповещением. Пачка ушла -
// сразу следующая: в очереди может ждать ещё.
//
&НаКлиенте
Процедура АвтоПачкаЗавершена(Итог, ДополнительныеПараметры) Экспорт

	ОбновитьСписокИИтоги();

	Если ЗначениеЗаполнено(Итог.Текст) Тогда
		ЭАрМ_ПанельУправленияЭДОКлиент.ПоказатьИтогОтправкиСБИС(Итог.Текст);
	КонецЕсли;

	Если Итог.Отправлено Тогда
		ПодключитьОбработчикОжидания("Подключаемый_АвтоотправкаСейчас", 5, Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

// Список выбора «Подписант рабочего места» - подписанты из настроек ЭДО.
//
&НаСервере
Процедура ЗаполнитьСписокПодписантов()

	СписокВыбора = Элементы.ПодписантРабочегоМеста.СписокВыбора;
	СписокВыбора.Очистить();
	СписокВыбора.Добавить(0, НСтр("ru = 'Не выбран - спрашивать при подписании'"));
	Для Каждого Подписант Из ЭАрМ_ПанельУправленияЭДОСервер.ПодписантыСБИС() Цикл
		СписокВыбора.Добавить(Подписант.Номер, Подписант.Представление);
	КонецЦикла;

КонецПроцедуры

// Оставляет в таблице только то, что читает человек.
//
// Идентификаторы СБИС и запроса на форму не выносятся вовсе: у таблицы
// значений все колонки реквизита доступны в ТекущиеДанные независимо от того,
// показаны они или нет.
//
&НаСервере
Процедура НастроитьКолонки()

	// Колонка «Отправить» через УстановитьКолонку не идёт: у поля флажка нет
	// ни ширины, ни формата - платформа рисует его по размеру самого флажка,
	// а обращение к Ширина падает с «Поле объекта не обнаружено». Ширину такой
	// колонке задаёт её заголовок. Править её, наоборот, можно - ради неё
	// таблица и редактируемая
	Элементы.ОчередьОтправить.Подсказка = НСтр(
		"ru = 'Нажмите на ячейку, чтобы отметить документ к отправке'");

	УстановитьКолонку("ОчередьСтатус",        22);
	// Статус выбирается прямо в строке (см. ОчередьСтатусПриИзменении)
	Элементы.ОчередьСтатус.ТолькоПросмотр = Ложь;
	Статусы = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО;
	СписокСтатусов = Элементы.ОчередьСтатус.СписокВыбора;
	СписокСтатусов.Очистить();
	СписокСтатусов.Добавить(Статусы.ГотовКОтправке);
	СписокСтатусов.Добавить(Статусы.ОшибкаОтправки);
	СписокСтатусов.Добавить(Статусы.ОтправленНаПодпись);
	СписокСтатусов.Добавить(Статусы.Подтверждено);
	УстановитьКолонку("ОчередьРеестр",         6);
	УстановитьКолонку("ОчередьНомер",         14);
	УстановитьКолонку("ОчередьДатаДокумента", 11, "ДЛФ=D");
	УстановитьКолонку("ОчередьКонтрагент",    34);
	УстановитьКолонку("ОчередьДатаОтправки",  19, "ДФ='dd.MM.yyyy HH:mm:ss'");
	УстановитьКолонку("ОчередьДатаОтвета",    14, "ДЛФ=DT");
	УстановитьКолонку("ОчередьКомментарий",    0);
	УстановитьКолонку("ОчередьБухгалтерия",   18);

	Элементы.ОчередьКомментарий.РастягиватьПоГоризонтали = Истина;
	Элементы.ОчередьКомментарий.АвтоМаксимальнаяШирина   = Ложь;
	Элементы.ОчередьКомментарий.МаксимальнаяШирина       = 0;

	Элементы.ОчередьСтатус.Подсказка = НСтр(
		"ru = 'Готовы к отправке - ждут нажатия; Отправлен на подпись и Подтверждено - ушло, строка зелёная; Ошибка - красная'");
	Элементы.ОчередьРеестр.Подсказка = НСтр("ru = 'УПД — чек, ЭТрН — машинка, УКД — корректировка'");
	Элементы.ОчередьДатаОтправки.Подсказка = НСтр("ru = 'Когда утверждение ушло в СБИС'");
	Элементы.ОчередьДатаОтвета.Подсказка = НСтр("ru = 'Когда СБИС подтвердил подпись'");
	Элементы.ОчередьБухгалтерия.Подсказка = НСтр("ru = 'Отправлен — ушло в БП. Будет внешняя обработка.'");

КонецПроцедуры

// Ширина, формат и запрет правки одной колонки-поля ввода.
//
// Только для полей ввода: у поля флажка этих свойств нет. Нулевая ширина
// означает «не задавать» - такую колонку тянет разметка.
//
// Все колонки, кроме флажка, только для просмотра: их ведёт механизм обмена,
// и руками эти значения менять нечему.
//
&НаСервере
Процедура УстановитьКолонку(ИмяКолонки, Ширина, Формат = "")

	Колонка = Элементы.Найти(ИмяКолонки);
	Если Колонка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Ширина > 0 Тогда
		Колонка.Ширина = Ширина;
	КонецЕсли;

	Если ЗначениеЗаполнено(Формат) Тогда
		Колонка.Формат = Формат;
		Колонка.ФорматРедактирования = Формат;
	КонецЕсли;

	Колонка.ТолькоПросмотр = Истина;

КонецПроцедуры

// Картинки вида документа, зелёная галочка у ушедших и текст поля
// «Бухгалтерия»: отправленные - «Отправлен», остальные - заглушка
// внешней обработки.
//
&НаСервере
Процедура ОформитьСтрокиОчереди(ТаблицаОчереди)

	Если ТаблицаОчереди.Колонки.Найти("ВидКартинка") = Неопределено Тогда
		ТаблицаОчереди.Колонки.Добавить("ВидКартинка", Новый ОписаниеТипов("Картинка"));
	КонецЕсли;
	Если ТаблицаОчереди.Колонки.Найти("Галочка") = Неопределено Тогда
		ТаблицаОчереди.Колонки.Добавить("Галочка", Новый ОписаниеТипов("Картинка"));
	КонецЕсли;

	ПустаяКартинка = Новый Картинка;
	Галочка = БиблиотекаКартинок.ЭАрМ_ГалочкаОтправки;
	КартинкаУПД = БиблиотекаКартинок.ЭАрМ_ИконкаУПД;
	КартинкаЭТрН = БиблиотекаКартинок.ЭАрМ_ИконкаЭТрН;
	КартинкаУКД = БиблиотекаКартинок.ЭАрМ_ИконкаУКД;

	Для Каждого СтрокаОчереди Из ТаблицаОчереди Цикл

		Если СтрокаОчереди.Реестр = "ЭТрН" Тогда
			СтрокаОчереди.ВидКартинка = КартинкаЭТрН;
		ИначеЕсли СтрокаОчереди.Реестр = "УКД" Тогда
			СтрокаОчереди.ВидКартинка = КартинкаУКД;
		Иначе
			СтрокаОчереди.ВидКартинка = КартинкаУПД;
		КонецЕсли;

		Если СтрокаОчереди.МожноОтправлять Тогда
			СтрокаОчереди.Галочка = ПустаяКартинка;
			СтрокаОчереди.Бухгалтерия = НСтр("ru = 'Будет внешняя обработка'");
		Иначе
			СтрокаОчереди.Галочка = Галочка;
			СтрокаОчереди.Бухгалтерия = НСтр("ru = 'Отправлен'");
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Цвет строки по статусу: зелёная - успешно ушло в СБИС (и на подписи, и
// уже подтверждено), красная - ошибка или отказ. Готовые к отправке
// остаются обычными: по ним ещё ничего не делали.
//
&НаСервере
Процедура НастроитьЦветаСтрок()

	СтатусыПеречисления = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО;

	Отправленные = Новый Массив;
	Отправленные.Добавить(СтатусыПеречисления.ОтправленНаПодпись);
	Отправленные.Добавить(СтатусыПеречисления.Ожидает);
	Отправленные.Добавить(СтатусыПеречисления.Подтверждено);
	ДобавитьЦветПоСтатусам(Отправленные, Новый Цвет(220, 255, 220), Новый Цвет(0, 100, 0));

	Проблемные = Новый Массив;
	Проблемные.Добавить(СтатусыПеречисления.ОшибкаОтправки);
	Проблемные.Добавить(СтатусыПеречисления.Отклонено);
	Проблемные.Добавить(СтатусыПеречисления.НеОбработаноВДалион);
	Проблемные.Добавить(СтатусыПеречисления.НетВСБИС);
	ДобавитьЦветПоСтатусам(Проблемные, Новый Цвет(255, 224, 224), Новый Цвет(140, 0, 0));

	ЗапретитьОтметкуОтправленным();

КонецПроцедуры

// Гасит флажок у документов, которые уже отправлены или подписаны.
//
// Условное оформление умеет делать поле только для просмотра по строке -
// в отличие от свойства колонки, которое действует на всю таблицу сразу.
// Флажок у таких строк не нажимается вовсе, а не откатывается после нажатия.
//
&НаСервере
Процедура ЗапретитьОтметкуОтправленным()

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ОчередьОтправить");
	ОформляемоеПоле.Использование = Истина;

	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Очередь.МожноОтправлять");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Ложь;
	Отбор.Использование  = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

КонецПроцедуры

&НаСервере
Процедура ДобавитьЦветПоСтатусам(Статусы, ЦветФона, ЦветТекста)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Очередь");
	ОформляемоеПоле.Использование = Истина;

	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Очередь.Статус");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
	Отбор.ПравоеЗначение = Статусы;
	Отбор.Использование  = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);

КонецПроцедуры

// Перечитывает очередь из регистра и пересчитывает итоги в шапке.
//
// Параметры:
//   ПроверитьПодписьНаСервере - Булево - проверить ключ на сервере (долго,
//     создаёт менеджер криптографии): при открытии формы и смене настроек
//   Синхронизировать - Булево - подтянуть в очередь статусы документов,
//     отправленных кнопками реестров: при открытии формы и по «Обновить»
//
&НаСервере
Процедура ЗаполнитьОчередьНаСервере(ПроверитьПодписьНаСервере = Ложь, Синхронизировать = Ложь)

	// Документы, отправленные кнопками реестров ЭТрН и УПД, - в статусы
	// очереди. Это подстраховка: кнопки реестров отмечают очередь сами, а
	// регламент синхронизирует её при каждом сборе. Раньше она шла при
	// любом перечитывании - после каждого действия и окончания отправки -
	// и каждый раз объединяла три реестра с очередью и писала изменения
	Если Синхронизировать Тогда
		ЭАрМ_ОбработкаПодтвержденийЭДО.СинхронизироватьОчередьСРеестрами();
	КонецЕсли;

	// «Только не отправленные»: «Готов к отправке», без статуса и «Ошибка
	// отправки» - отбор в запросе, а не удалением из всей истории очереди
	// Выбран статус - показываем строки с ним, даже уже отправленные:
	// «Только не отправленные» с отбором «Подтверждено» дал бы пустой список
	ТаблицаОчереди = ЭАрМ_ОбработкаПодтвержденийЭДО.ОчередьПодписания(
		ТолькоНеОтправленные И НЕ ЗначениеЗаполнено(ОтборСтатус));
	ОформитьСтрокиОчереди(ТаблицаОчереди);
	ЗаполнитьСпискиОтбораОчереди(ТаблицаОчереди);

	ПрименитьОтборОчереди(ТаблицаОчереди);

	ЗначениеВРеквизитФормы(ТаблицаОчереди, "Очередь");

	ИтогиОчереди = ЭАрМ_ОбработкаПодтвержденийЭДО.ИтогиОчереди();

	ОбновитьШапкуОтправки(ПроверитьПодписьНаСервере);

КонецПроцедуры

&НаСервере
Процедура ОбновитьИтогиОчереди(ПроверитьПодписьНаСервере = Ложь)

	ИтогиОчереди = ЭАрМ_ОбработкаПодтвержденийЭДО.ИтогиОчереди();

	ОбновитьШапкуОтправки(ПроверитьПодписьНаСервере);

КонецПроцедуры

// Шапка: сколько ушло в СБИС сегодня, от имени кого отправляет сервер и
// работает ли отправка с сервера.
//
&НаСервере
Процедура ОбновитьШапкуОтправки(ПроверитьПодписьНаСервере = Ложь)

	Состояние = ЭАрМ_ПанельУправленияЭДОСервер.СостояниеОтправкиОчереди(ПроверитьПодписьНаСервере);

	// Счётчики - в верхнюю надпись над таблицей, вторая строка - прежние итоги
	Счетчики = Состояние.Счетчики;
	Если Счетчики = Неопределено Тогда
		Элементы.ИтогиОчередиНадпись.Заголовок = ИтогиОчереди;
	Иначе
		Строка1 = СтрШаблон(
			НСтр("ru = 'Ждут отправки: %1   ·   Отправлено сегодня: УПД %2, ЭТрН %3, УКД %4   ·   всего %5 (на подписи %6, подписано %7)'"),
			Счетчики.ЖдутОтправки, Счетчики.СегодняУПД, Счетчики.СегодняЭТрН, Счетчики.СегодняУКД,
			Счетчики.ОтправленоВсего, Счетчики.НаПодписи, Счетчики.Подписано);
		Если Счетчики.СОшибкой > 0 Тогда
			Строка1 = Строка1 + СтрШаблон(НСтр("ru = '   ·   С ошибкой: %1'"), Счетчики.СОшибкой);
		КонецЕсли;
		Элементы.ИтогиОчередиНадпись.Заголовок = Строка1 + Символы.ПС + ИтогиОчереди;
	КонецЕсли;

	СписокВыбора = Элементы.ПодписантОтправки.СписокВыбора;
	СписокВыбора.Очистить();
	Для Каждого Подписант Из Состояние.Подписанты Цикл
		СписокВыбора.Добавить(Подписант.Номер, Подписант.Представление);
	КонецЦикла;
	ПодписантОтправки = Состояние.Подписант;

	СписокИнтервалов = Элементы.ИнтервалОтправки.СписокВыбора;
	СписокИнтервалов.Очистить();
	Для Каждого Минуты Из СтрРазделить("1,2,3,5,10,15,30,60", ",") Цикл
		СписокИнтервалов.Добавить(Число(Минуты), Минуты + " " + НСтр("ru = 'мин'"));
	КонецЦикла;
	Если СписокИнтервалов.НайтиПоЗначению(Состояние.Интервал) = Неопределено Тогда
		СписокИнтервалов.Добавить(Состояние.Интервал, Формат(Состояние.Интервал, "ЧГ=0") + " " + НСтр("ru = 'мин'"));
	КонецЕсли;
	ИнтервалОтправки = Состояние.Интервал;

	Элементы.ИдётОтправкаНадпись.Видимость = Ложь;

	// Функциональная опция «Очередь отправки в СБИС» выключена - поля серверной
	// отправки не нужны (кнопки скрывает сама опция)
	// Значение опции - тот же флажок «Автоотправка»; читаем его, а не опцию:
	// кэш опции сеанса отстаёт, пока интерфейс не обновлён
	ОпцияВключена = ЭАрМ_ПанельУправленияЭДОСервер.АвтоотправкаВключена();
	Элементы.ПодписантОтправки.Видимость = ОпцияВключена;
	Элементы.ИнтервалОтправки.Видимость = ОпцияВключена;

	СписокМест = Элементы.МестоПодписи.СписокВыбора;
	Если СписокМест.Количество() = 0 Тогда
		СписокМест.Добавить("Клиент", НСтр("ru = 'На клиенте (открытая форма, ключ этого компьютера)'"));
		СписокМест.Добавить("Сервер", НСтр("ru = 'На сервере 1С (регламент, без открытых форм)'"));
	КонецЕсли;
	МестоПодписи = Состояние.Место;
	Элементы.МестоПодписи.Видимость = ОпцияВключена;

	// Пусто - подпись на сервере в этот раз не проверяли, надпись прежняя
	Если ЗначениеЗаполнено(Состояние.Пояснение) Тогда
		Элементы.СостояниеОтправкиНадпись.Заголовок = Состояние.Пояснение;
		Элементы.СостояниеОтправкиНадпись.ЦветТекста = ?(Состояние.Норма,
			WebЦвета.Зеленый, WebЦвета.Красный);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СобратьГотовые(Команда)

	Состояние(НСтр("ru = 'Обновление очереди...'"));
	Текст = СобратьГотовыеНаСервере();
	Состояние();

	ОбновитьСписокИИтоги();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Очередь'"), , Текст);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)

	УстановитьОтметкиОтправкиНаСервере(Истина);
	ОбновитьСписокИИтоги();

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)

	УстановитьОтметкиОтправкиНаСервере(Ложь);
	ОбновитьСписокИИтоги();

КонецПроцедуры

// Спрашивает СБИС по отправленным документам, принята ли подпись.
//
// После проверки подписанные строки остаются зелёными (как и просто
// отправленные). Нужна, когда в «Что произошло» ещё нет ответа СБИС.
//
&НаКлиенте
Процедура ПроверитьПодписьВСБИС(Команда)

	Состояние(НСтр("ru = 'СБИС: проверка подписи...'"));
	Текст = ПроверитьПодписиНаСервере();
	Состояние();

	ОбновитьСписокИИтоги();
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОчередь(Команда)

	ОбновитьСписокИИтоги(Истина);

КонецПроцедуры

&НаКлиенте
Процедура УтвердитьИПодписать(Команда)

	ПодписатьПачку("", НСтр("ru = 'Нет документов с отметкой «Отправить».'"));

КонецПроцедуры

// Отмечает и сразу подписывает все ЭТрН очереди.
//
// Обычный порядок - отметить нужное флажками и нажать «Подписать отмеченные».
// ЭТрН почти всегда подписывают целиком, поэтому для них отдельная кнопка:
// она сама проставляет отметки и не трогает УПД и УКД, даже если те отмечены.
//
&НаКлиенте
Процедура ОтправитьВсеЭТрН(Команда)

	ПодписатьПачку("ЭТрН",
		НСтр("ru = 'В очереди нет ЭТрН, которые можно отправить: все уже подписаны или ждут подпись.'"),
		Истина);

КонецПроцедуры

// Под таблицей - «Что произошло» с документом текущей строки: колонка
// комментария скрыта, а причину ошибки отправки видеть надо (иначе после
// «Сменить статус» строка снова «Ошибка отправки» - и непонятно почему).
//
&НаКлиенте
Процедура ОчередьПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Очередь.ТекущиеДанные;
	ЧтоПроизошлоТекущей = ?(ТекущиеДанные = Неопределено, "", ТекущиеДанные.Комментарий);

КонецПроцедуры

// Статус выбран прямо в строке таблицы - то же, что кнопка «Сменить статус»
// для одной строки: запись в очередь, для «Готовы к отправке» - сразу
// отправка. Если сменить нельзя (документ уже подписан), строка вернётся
// к прежнему статусу при перечитывании.
//
&НаКлиенте
Процедура ОчередьСтатусПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Очередь.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.Статус)
		ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторЗапроса) Тогда
		ОбновитьСписокИИтоги();
		Возврат;
	КонецЕсли;

	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(ТекущиеДанные.ИдентификаторЗапроса);

	СменитьСтатусВыбран(Новый Структура("Значение", ТекущиеДанные.Статус), Идентификаторы);

КонецПроцедуры

// Меняет статус выделенных строк. «Готовы к отправке» - документ заново
// возьмут регламент и автоотправка (см.
// ЭАрМ_ОбработкаПодтвержденийЭДО.ИзменитьСтатусСтрокОчереди).
//
&НаКлиенте
Процедура СменитьСтатус(Команда)

	Идентификаторы = Новый Массив;
	Для Каждого ИдентификаторСтроки Из Элементы.Очередь.ВыделенныеСтроки Цикл
		ДанныеСтроки = Очередь.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ДанныеСтроки <> Неопределено И ЗначениеЗаполнено(ДанныеСтроки.ИдентификаторЗапроса) Тогда
			Идентификаторы.Добавить(ДанныеСтроки.ИдентификаторЗапроса);
		КонецЕсли;
	КонецЦикла;

	Если Идентификаторы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите строки очереди, которым нужно сменить статус'"));
		Возврат;
	КонецЕсли;

	Варианты = Новый СписокЗначений;
	Варианты.Добавить(ПредопределенноеЗначение("Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке"),
		НСтр("ru = 'Готовы к отправке - отправить заново'"));
	Варианты.Добавить(ПредопределенноеЗначение("Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки"),
		НСтр("ru = 'Ошибка отправки - не отправлять автоматически'"));
	Варианты.Добавить(ПредопределенноеЗначение("Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОтправленНаПодпись"),
		НСтр("ru = 'Отправлен на подпись'"));
	Варианты.Добавить(ПредопределенноеЗначение("Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено"),
		НСтр("ru = 'Подтверждено - подпись принята'"));

	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("СменитьСтатусВыбран", ЭтотОбъект, Идентификаторы),
		Варианты, Элементы.Очередь);

КонецПроцедуры

&НаКлиенте
Процедура СменитьСтатусВыбран(ВыбранныйЭлемент, Идентификаторы) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Итог = ИзменитьСтатусНаСервере(Идентификаторы, ВыбранныйЭлемент.Значение);

	// Автоотправка этого сеанса формы не берёт документ второй раз - после
	// ручного «Готовы к отправке» он должен уйти снова
	Если АвтоСостояние <> Неопределено Тогда
		Для Каждого ИдентификаторСБИС Из Итог.ИдентификаторыСБИС Цикл
			Индекс = АвтоСостояние.Исключить.Найти(ИдентификаторСБИС);
			Если Индекс <> Неопределено Тогда
				АвтоСостояние.Исключить.Удалить(Индекс);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ОбновитьСписокИИтоги();

	Текст = СтрШаблон(НСтр("ru = 'Статус «%1» поставлен строкам: %2.'"), ВыбранныйЭлемент.Значение, Итог.Изменено);
	Если Итог.Пропущено.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + НСтр("ru = 'Не изменены:'") + Символы.ПС
			+ СтрСоединить(Итог.Пропущено, Символы.ПС);
		ПоказатьПредупреждение(, Текст);
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Статус изменён'"), , Текст);
	КонецЕсли;

	// «Готовы к отправке» - сразу и отправляем, не дожидаясь следующего
	// прохода регламента или минуты автоотправки
	Если ВыбранныйЭлемент.Значение = ПредопределенноеЗначение(
			"Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке")
		И Итог.Изменено > 0 Тогда
		ОтправитьСразуПослеСменыСтатуса(Идентификаторы);
	КонецЕсли;

КонецПроцедуры

// Отправка документов, которым только что вернули «Готовы к отправке»: сразу
// запускается пачка отправки очереди - подпись на сервере, если сервер может
// подписать, иначе ключом этого компьютера. Флажки «Отправить» не ставятся.
//
&НаКлиенте
Процедура ОтправитьСразуПослеСменыСтатуса(ИдентификаторыЗапросов)

	Если ИдётФоновоеПодписание = Истина
		ИЛИ АвтоСостояние <> Неопределено И АвтоСостояние.Идёт Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Отправка в СБИС'"), ,
			НСтр("ru = 'Идёт отправка предыдущей пачки - документы уйдут следующей'"));
		Возврат;
	КонецЕсли;

	// Сразу отправляет только компьютер с галочкой. Остальные формы статус
	// меняют, а подпись и криптографию не трогают
	Если НЕ ЭАрМ_ПанельУправленияЭДОСервер.АвтоотправкаЭтогоКомпьютера(ИмяКомпьютера()) Тогда
		Возврат;
	КонецЕсли;

	Если АвтоСостояние = Неопределено ИЛИ АвтоСостояние.НомерПодписанта = Неопределено Тогда
		ЗапуститьАвтоотправку();
	Иначе
		ПодключитьОбработчикОжидания("Подключаемый_АвтоотправкаСейчас", 1, Истина);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИзменитьСтатусНаСервере(Идентификаторы, НовыйСтатус)

	Возврат ЭАрМ_ОбработкаПодтвержденийЭДО.ИзменитьСтатусСтрокОчереди(Идентификаторы, НовыйСтатус);

КонецФункции

// Сразу запускает серверную отправку очереди (фоном), не дожидаясь регламента.
//
&НаКлиенте
Процедура ОтправитьОчередьСейчас(Команда)

	ЭАрМ_ПанельУправленияЭДОСервер.ЗапуститьОтправкуОчереди();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Отправка в СБИС'"), ,
		НСтр("ru = 'Отправка очереди запущена на сервере'"));

	// Индикатор спросит сервер на следующем тике; по окончании сам
	// перечитает очередь
	ЭАрМ_ПанельУправленияЭДОКлиент.СброситьИндикаторОтправки(КэшИндикатораОтправки);

КонецПроцедуры

// Пароль контейнера ключа подписанта отправки - для подписи на сервере.
// Пустая строка удаляет сохранённый пароль.
//
&НаКлиенте
Процедура ПарольКлючаНаСервере(Команда)

	Если НЕ ЗначениеЗаполнено(ПодписантОтправки) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала выберите подписанта отправки.'"));
		Возврат;
	КонецЕсли;

	ПоказатьВводСтроки(Новый ОписаниеОповещения("ПарольКлючаВведён", ЭтотОбъект), "",
		СтрШаблон(НСтр("ru = 'Пароль ключа подписанта %1 на сервере (пусто - удалить)'"), ПодписантОтправки),
		, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПарольКлючаВведён(Пароль, ДополнительныеПараметры) Экспорт

	Если Пароль = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЭАрМ_ПанельУправленияЭДОСервер.ЗаписатьПарольКлючаНаСервере(ПодписантОтправки, Пароль);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ОбновитьИтогиОчереди(Истина);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Пароль ключа'"), ,
		?(ПустаяСтрока(Пароль), НСтр("ru = 'Пароль удалён'"), НСтр("ru = 'Пароль сохранён на сервере'")));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// От имени кого сервер отправляет очередь в СБИС - общая настройка.
//
// Настройки функциональной опции «Очередь отправки в СБИС» (форма обработки
// панели ЭДО); после закрытия - перечитать флажок, шапку и очередь.
//
&НаКлиенте
Процедура НастройкиОчереди(Команда)

	ОткрытьФорму("Обработка.ЭАрМ_ПанельУправленияЭДО.Форма.ФормаНастроекОчереди", , ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("НастройкиОчередиЗакрыты", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура НастройкиОчередиЗакрыты(Результат, ДополнительныеПараметры) Экспорт

	АвтоотправкаУПД = ЭАрМ_ПанельУправленияЭДОСервер.АвтоотправкаЭтогоКомпьютера(ИмяКомпьютера());
	Если АвтоотправкаУПД И АвтоСостояние = Неопределено Тогда
		ЗапуститьАвтоотправку();
	ИначеЕсли НЕ АвтоотправкаУПД Тогда
		ОстановитьАвтоотправку();
		АвтоСостояние = Неопределено;
	КонецЕсли;

	ОбновитьСписокИИтоги();
	// Ключ на сервере проверяет только компьютер с галочкой
	ОбновитьИтогиОчереди(АвтоотправкаУПД);

КонецПроцедуры

// Где подписывать очередь - общая настройка. На сервере - эта форма больше
// не подписывает (ЗапуститьАвтоПачкуВФоне только подталкивает сервер).
//
&НаКлиенте
Процедура МестоПодписиПриИзменении(Элемент)

	ЭАрМ_ПанельУправленияЭДОСервер.СохранитьМестоПодписиОчереди(МестоПодписи);
	ОбновитьИтогиОчереди(Истина);

КонецПроцедуры

&НаКлиенте
Процедура ТолькоНеОтправленныеФлагПриИзменении(Элемент)

	ОбновитьСписокИИтоги();

КонецПроцедуры

&НаКлиенте
Процедура ОтборОчередиПриИзменении(Элемент)

	ОбновитьСписокИИтоги();

КонецПроцедуры

// Как часто регламентное задание отправляет очередь - общая настройка,
// сразу в расписание задания.
//
&НаКлиенте
Процедура ИнтервалОтправкиПриИзменении(Элемент)

	Если НЕ ЗначениеЗаполнено(ИнтервалОтправки) Тогда
		ИнтервалОтправки = 5;
	КонецЕсли;

	Попытка
		ЭАрМ_ПанельУправленияЭДОСервер.УстановитьИнтервалОтправкиОчереди(ИнтервалОтправки);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ОбновитьИтогиОчереди(Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПодписантОтправкиПриИзменении(Элемент)

	ЭАрМ_ПанельУправленияЭДОСервер.СохранитьПодписантаОтправкиОчереди(ПодписантОтправки);
	ОбновитьИтогиОчереди(Истина);

КонецПроцедуры

// Нажатие на ячейку «Отправить»: отметка сразу уходит в регистр.
//
// Писать сразу, а не по кнопке, нужно затем, что отметку читает и регламентное
// задание, и соседний сеанс: закрытая без сохранения форма не должна оставлять
// решение пользователя только у него на экране.
//
// Подтверждённую строку отметить нельзя: подпись по ней СБИС уже принял,
// и повторная отправка вернулась бы ошибкой «нет этапа с действием».
//
&НаКлиенте
Процедура ОчередьОтправитьПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Очередь.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные.Отправить И НЕ ТекущиеДанные.МожноОтправлять Тогда
		ТекущиеДанные.Отправить = Ложь;
		ПоказатьПредупреждение(,
			НСтр("ru = 'Этот документ уже подписан в СБИС, отправлять его повторно нечем.'"));
		Возврат;
	КонецЕсли;

	ЗаписатьОтметкуОтправкиНаСервере(ТекущиеДанные.ИдентификаторЗапроса, ТекущиеДанные.Отправить);

	// Таблицу не перечитываем: пользователь ставит флажки подряд, и обновление
	// сбросило бы ему текущую строку. Хватит пересчитанных итогов
	ОбновитьИтогиОчереди();

КонецПроцедуры

#КонецОбласти

#Область ПодписаниеСБИС

// Спрашивает подтверждение и запускает подписание пачки.
//
// Параметры:
//   ОтборРеестра   - Строка - "ЭТрН", "УПД", "УКД"; пустая - все реестры
//   ТекстЕслиПусто - Строка - что сказать, когда подписывать нечего
//   ОтметитьВесьРеестр - Булево - брать весь реестр, не глядя на флажки,
//                        и проставить отметки после согласия пользователя
//
&НаКлиенте
Процедура ПодписатьПачку(ОтборРеестра, ТекстЕслиПусто, ОтметитьВесьРеестр = Ложь)

	Если ИдётФоновоеПодписание = Истина
		ИЛИ АвтоСостояние <> Неопределено И АвтоСостояние.Идёт Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отправка предыдущей пачки ещё идёт - дождитесь её'"));
		Возврат;
	КонецЕсли;

	ДокументыОчереди = ДокументыКПодписаниюНаСервере(ОтборРеестра, НЕ ОтметитьВесьРеестр);
	Если ДокументыОчереди.Количество() = 0 Тогда
		ПоказатьПредупреждение(, ТекстЕслиПусто);
		Возврат;
	КонецЕсли;

	// Отметки проставляются только после «Да»: иначе отказ от вопроса оставлял
	// бы весь реестр отмеченным, и следующее «Подписать отмеченные» отправило
	// бы то, от чего пользователь только что отказался.
	// Имя не «Параметры»: так называется свойство формы, присваивать ему нельзя
	ПараметрыПачки = Новый Структура;
	ПараметрыПачки.Вставить("Документы", ДокументыОчереди);
	ПараметрыПачки.Вставить("ОтметитьРеестр", ?(ОтметитьВесьРеестр, ОтборРеестра, ""));

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"УтвердитьИПодписатьПодтверждение", ЭтотОбъект, ПараметрыПачки);

	ПоказатьВопрос(ОписаниеОповещения, ТекстВопросаПодписания(ДокументыОчереди),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// Вид, номер и поставщик каждой строки пачки: иначе вопрос «документы (2)?»
// не показывает, что вместе с ЭТрН уйдёт УПД другого поставщика.
//
&НаКлиенте
Функция ТекстВопросаПодписания(ДокументыОчереди)

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(
		НСтр("ru = 'Подписать и отправить в СБИС документы (%1)? Отменить это будет нельзя.'"),
		ДокументыОчереди.Количество()));
	Строки.Добавить("");

	МаксимумСтрок = 20;
	НомерСтроки = 0;
	ЧислоЭТрН = 0;

	Для Каждого ДокументОчереди Из ДокументыОчереди Цикл

		Если ДокументОчереди.Реестр = "ЭТрН" Тогда
			ЧислоЭТрН = ЧислоЭТрН + 1;
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;
		Если НомерСтроки = МаксимумСтрок + 1 Тогда
			Строки.Добавить(СтрШаблон(НСтр("ru = '… и ещё %1'"),
				ДокументыОчереди.Количество() - МаксимумСтрок));
		КонецЕсли;
		Если НомерСтроки > МаксимумСтрок Тогда
			Продолжить;
		КонецЕсли;

		Контрагент = "";
		ДокументОчереди.Свойство("Контрагент", Контрагент);
		Если ЗначениеЗаполнено(Контрагент) Тогда
			Строки.Добавить(СтрШаблон("%1 %2 — %3",
				ДокументОчереди.Реестр, ДокументОчереди.Номер, Контрагент));
		Иначе
			Строки.Добавить(СтрШаблон("%1 %2",
				ДокументОчереди.Реестр, ДокументОчереди.Номер));
		КонецЕсли;

	КонецЦикла;

	Если ЧислоЭТрН > 0 Тогда
		Строки.Добавить("");
		Строки.Добавить(СтрШаблон(НСтр(
			"ru = 'ЭТрН (%1) будут подписаны как «Получен» - груз принят полностью. Если груз пришёл не весь или с браком, снимите отметку и оформите «Получен частично» или «Не принят» в СБИС.'"),
			ЧислоЭТрН));
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Ответ на вопрос: сервер готовит всю пачку разом и отдаёт вложения.
//
&НаКлиенте
Процедура УтвердитьИПодписатьПодтверждение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	// Подписантов в настройках может быть два - один выбор на всю пачку:
	// пачка подписывается одним сертификатом
	ЭАрМ_ПанельУправленияЭДОКлиент.ВыбратьПодписанта(
		Новый ОписаниеОповещения("ПодписантПачкиВыбран", ЭтотОбъект, ДополнительныеПараметры));

КонецПроцедуры

// Подписант выбран - отмечаем реестр и готовим пачку его сертификатом.
//
&НаКлиенте
Процедура ПодписантПачкиВыбран(НомерПодписанта, ДополнительныеПараметры) Экспорт

	Если НомерПодписанта = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДополнительныеПараметры.ОтметитьРеестр) Тогда
		ОтметитьРеестрНаСервере(ДополнительныеПараметры.ОтметитьРеестр);
	КонецЕсли;

	НачатьПодготовкуПачки(ДополнительныеПараметры.Документы, НомерПодписанта);

КонецПроцедуры

// Подготовка пачки в СБИС - фоновым заданием: форма не висит, пока СБИС
// отвечает по каждому документу.
//
&НаКлиенте
Процедура НачатьПодготовкуПачки(ДокументыОчереди, НомерПодписанта)

	Операция = ЗапуститьПакетВФоне(УникальныйИдентификатор,
		"ЭАрМ_УтверждениеСБИС.ПодготовитьПакетПодписания", ДокументыОчереди, НомерПодписанта);
	Если Операция = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Операция) = Тип("Строка") Тогда
		ЗавершитьПодписание(Операция);
		Возврат;
	КонецЕсли;

	ИдётФоновоеПодписание = Истина;
	ОжидатьФоновоеПодписание(Операция, "ПодготовкаПачкиЗавершена",
		СтрШаблон(НСтр("ru = 'СБИС: подготовка документов (%1)'"), ДокументыОчереди.Количество()), Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПодготовкаПачкиЗавершена(Результат, ДополнительныеПараметры) Экспорт

	ТекстОшибки = "";
	Подготовка = РезультатФоновогоПодписания(Результат, ТекстОшибки);
	Если Подготовка = Неопределено Тогда
		ПрерватьПодписание(ТекстОшибки);
		Возврат;
	КонецЕсли;

	ПакетПодписания  = Подготовка.Подписания;
	ОшибкиПодготовки = Подготовка.Ошибки;
	ИндексДокумента  = 0;
	ИндексВложения   = 0;
	СертификатПодписи = Неопределено;
	МенеджерПодписи   = Неопределено;

	Если ПакетПодписания.Количество() = 0 Тогда
		ЗавершитьПодписание("");
		Возврат;
	КонецЕсли;

	// Сертификат берём первым: по нему менеджер криптографии выберет нужную
	// программу. Один раз на всю пачку - иначе ключ спросят у пользователя
	// столько раз, сколько документов
	ЭлектроннаяПодписьКлиент.ПолучитьСертификатПоОтпечатку(
		Новый ОписаниеОповещения("ПодписаниеСертификатПолучен", ЭтотОбъект),
		ПакетПодписания[0].ОтпечатокBase64, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПодписаниеСертификатПолучен(Сертификат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Сертификат) <> Тип("СертификатКриптографии") Тогда
		ПрерватьПодписание(СтрШаблон(НСтр(
			"ru = 'Сертификат с отпечатком %1 не найден в личном хранилище этого компьютера.'"),
			ПакетПодписания[0].Отпечаток));
		Возврат;
	КонецЕсли;

	СертификатПодписи = Сертификат;

	ЭлектроннаяПодписьКлиент.СоздатьМенеджерКриптографии(
		Новый ОписаниеОповещения("ПодписаниеМенеджерПолучен", ЭтотОбъект),
		"Подписание", Истина, Сертификат.Выгрузить());

КонецПроцедуры

&НаКлиенте
Процедура ПодписаниеМенеджерПолучен(МенеджерКриптографии, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(МенеджерКриптографии) <> Тип("МенеджерКриптографии") Тогда
		ПрерватьПодписание(СтрШаблон(НСтр(
			"ru = 'Не удалось создать менеджер криптографии для этого сертификата: %1'"),
			?(ТипЗнч(МенеджерКриптографии) = Тип("Строка"), МенеджерКриптографии,
				НСтр("ru = 'проверьте, установлена ли нужная программа криптографии'"))));
		Возврат;
	КонецЕсли;

	МенеджерПодписи = МенеджерКриптографии;
	ПодписатьСледующееВложение();

КонецПроцедуры

// Подписывает очередное вложение пачки, переходя от документа к документу.
//
&НаКлиенте
Процедура ПодписатьСледующееВложение()

	Пока ИндексДокумента < ПакетПодписания.Количество() Цикл

		Подписание = ПакетПодписания[ИндексДокумента];

		Если ИндексВложения < Подписание.Вложения.Количество() Тогда

			Вложение = Подписание.Вложения[ИндексВложения];

			Состояние(СтрШаблон(НСтр("ru = 'Подписание %1 %2: %3'"),
				Подписание.Реестр, Подписание.НомерДокумента, Вложение.Имя));

			// Метод менеджера криптографии называется НачатьПодписывание,
			// НачатьПодписание у него нет
			// Обработчик ошибки обязателен: без него сбой подписи (неверный
			// пароль ключа, отказ криптопровайдера) не вызывал продолжения,
			// ИдётФоновоеПодписание оставался Истина - и очередь (кнопка и
			// автоотправка) стояла до переоткрытия формы
			МенеджерПодписи.НачатьПодписывание(
				Новый ОписаниеОповещения("ВложениеПодписано", ЭтотОбъект, ,
					"ВложениеНеПодписано", ЭтотОбъект),
				Вложение.Данные, СертификатПодписи);

			Возврат;

		КонецЕсли;

		ИндексДокумента = ИндексДокумента + 1;
		ИндексВложения  = 0;

	КонецЦикла;

	ОтправитьПакетПодписей();

КонецПроцедуры

&НаКлиенте
Процедура ВложениеНеПодписано(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	СтандартнаяОбработка = Ложь;
	ПрерватьПодписание(НСтр("ru = 'Ошибка подписи: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке));

КонецПроцедуры

&НаКлиенте
Процедура ВложениеПодписано(ДанныеПодписи, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(ДанныеПодписи) <> Тип("ДвоичныеДанные") Тогда
		ПрерватьПодписание(НСтр("ru = 'Подписание прервано'"));
		Возврат;
	КонецЕсли;

	ПакетПодписания[ИндексДокумента].Вложения[ИндексВложения].Подпись = ДанныеПодписи;
	ИндексВложения = ИндексВложения + 1;

	ПодписатьСледующееВложение();

КонецПроцедуры

// Отправляет подписи всей пачки одним вызовом сервера.
//
&НаКлиенте
Процедура ОтправитьПакетПодписей()

	// На сервер уходит только то, что он умеет принять: сертификат и менеджер
	// криптографии между клиентом и сервером не передаются. Файлы вложений
	// нужны, если титул грузополучателя дозаполнили до подписи.
	Пакет = Новый Массив;

	Для Каждого Подписание Из ПакетПодписания Цикл

		ВложенияОтправки = Новый Массив;
		Для Каждого Вложение Из Подписание.Вложения Цикл
			ВложениеОтправки = Новый Структура("Идентификатор, Имя, Подпись",
				Вложение.Идентификатор, Вложение.Имя, Вложение.Подпись);
			Если Вложение.Свойство("ФайлЗаменён") И Вложение.ФайлЗаменён Тогда
				ВложениеОтправки.Вставить("Данные", Вложение.Данные);
				ВложениеОтправки.Вставить("ФайлЗаменён", Истина);
			КонецЕсли;
			ВложенияОтправки.Добавить(ВложениеОтправки);
		КонецЦикла;

		ДанныеОтправки = Новый Структура;
		ДанныеОтправки.Вставить("Реестр",               Подписание.Реестр);
		ДанныеОтправки.Вставить("Идентификатор",        Подписание.Идентификатор);
		ДанныеОтправки.Вставить("Этап",                 Подписание.Этап);
		ДанныеОтправки.Вставить("Действие",             Подписание.Действие);
		ДанныеОтправки.Вставить("Вложения",             ВложенияОтправки);
		ДанныеОтправки.Вставить("ИдентификаторЗапроса", Подписание.ИдентификаторЗапроса);
		ДанныеОтправки.Вставить("НомерДокумента",       Подписание.НомерДокумента);
		ДанныеОтправки.Вставить("НомерПодписанта",      ?(Подписание.Свойство("НомерПодписанта"),
			Подписание.НомерПодписанта, 1));

		Пакет.Добавить(ДанныеОтправки);

	КонецЦикла;

	// Отправка подписей - тоже фоновым заданием
	Операция = ЗапуститьПакетВФоне(УникальныйИдентификатор,
		"ЭАрМ_УтверждениеСБИС.ВыполнитьПакетДействий", Пакет);
	Если Операция = Неопределено Тогда
		ЗавершитьПодписание("");
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Операция) = Тип("Строка") Тогда
		ПрерватьПодписание(Операция);
		Возврат;
	КонецЕсли;

	ОжидатьФоновоеПодписание(Операция, "ОтправкаПачкиЗавершена",
		СтрШаблон(НСтр("ru = 'СБИС: отправка подписей (%1)'"), Пакет.Количество()));

КонецПроцедуры

&НаКлиенте
Процедура ОтправкаПачкиЗавершена(Результат, ДополнительныеПараметры) Экспорт

	ТекстОшибки = "";
	Итоги = РезультатФоновогоПодписания(Результат, ТекстОшибки);
	Если Итоги = Неопределено Тогда
		// Подписи могли уйти: что дошло, покажет «Проверить подпись в СБИС»
		ЗавершитьПодписание(ТекстОшибки);
		Возврат;
	КонецЕсли;

	ТекстСводки = "";
	Если ТипЗнч(Итоги) = Тип("Структура") Тогда
		Итоги.Свойство("ТекстСводки", ТекстСводки);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекстСводки) Тогда
		ТекстСводки = СтрШаблон(
			НСтр("ru = 'Отправлено в СБИС: УПД %1, ЭТрН %2, УКД %3. Подпись подтверждена: %4, с ошибкой: %5.'"),
			?(Итоги.Свойство("УПД"), Итоги.УПД, 0), ?(Итоги.Свойство("ЭТрН"), Итоги.ЭТрН, 0),
			?(Итоги.Свойство("УКД"), Итоги.УКД, 0), Итоги.Подписано, Итоги.Ошибок);
	КонецЕсли;

	ЗавершитьПодписание(ТекстСводки);

КонецПроцедуры

// Запускает функцию ЭАрМ_УтверждениеСБИС фоновым заданием.
//
// Возвращаемое значение:
//   Структура - длительная операция БСП; Строка - почему не запустилась
//
&НаСервереБезКонтекста
Функция ЗапуститьПакетВФоне(ИдентификаторФормы, ИмяФункции, Параметр1, Параметр2 = Неопределено)

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'СБИС: пачка из очереди отправки'");
	ПараметрыВыполнения.СРасширениямиБазыДанных = Истина;
	// Ключ по действию и составу документов: та же пачка второй раз (из этой
	// формы или реестра УПД) параллельно не запустится
	ПараметрыВыполнения.КлючФоновогоЗадания = ЭАрМ_ПанельУправленияЭДОСервер.КлючФоновогоЗаданияСБИС(
		ИмяФункции, Параметр1);

	Попытка
		Если Параметр2 = Неопределено Тогда
			Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ИмяФункции, Параметр1);
		КонецЕсли;
		Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ИмяФункции, Параметр1, Параметр2);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Если СтрНайти(НРег(ТекстОшибки), "уже выполняется") > 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'Фоновое задание СБИС не запущено: %1'"), ТекстОшибки);
	КонецПопытки;

КонецФункции

// Ждёт фоновое задание. Без окна ожидания форма остаётся рабочей, ход виден
// в строке состояния. С окном (СОкном) - окно БСП с кнопкой «Отмена»:
// только для подготовки пачки (в СБИС ничего не ушло, отметки сохраняются).
// Отправку подписей не отменяем - часть могла уже уйти.
//
&НаКлиенте
Процедура ОжидатьФоновоеПодписание(Операция, ИмяОбработчика, ТекстСообщения, СОкном = Ложь)

	Состояние(ТекстСообщения + "...");

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = ТекстСообщения;
	ПараметрыОжидания.ВыводитьОкноОжидания = СОкном;

	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция,
		Новый ОписаниеОповещения(ИмяОбработчика, ЭтотОбъект), ПараметрыОжидания);

КонецПроцедуры

// Результат фонового задания; Неопределено - задание упало или ожидание
// отменили, причина - в ТекстОшибки.
//
&НаКлиенте
Функция РезультатФоновогоПодписания(Результат, ТекстОшибки)

	Состояние();

	Если Результат = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Ожидание ответа СБИС отменено'");
		Возврат Неопределено;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		ТекстОшибки = Результат.КраткоеПредставлениеОшибки;
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПолучитьИзВременногоХранилища(Результат.АдресРезультата);

КонецФункции

// Прекращает подписание, не оставляя за собой состояния.
//
// В СБИС при этом не ушло ничего: подписи отправляются одним вызовом в самом
// конце. Отметки «Отправить» остаются на месте, и пачку можно повторить.
//
&НаКлиенте
Процедура ПрерватьПодписание(ТекстОшибки)

	ЗавершитьПодписание(ТекстОшибки + Символы.ПС
		+ НСтр("ru = 'В СБИС ничего не отправлено, отметки сохранены - можно повторить.'"));

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПодписание(ТекстОтчета)

	ЧастиОтчёта = Новый Массив;

	Если ЗначениеЗаполнено(ТекстОтчета) Тогда
		ЧастиОтчёта.Добавить(ТекстОтчета);
	КонецЕсли;

	Если ОшибкиПодготовки <> Неопределено И ОшибкиПодготовки.Количество() > 0 Тогда
		ЧастиОтчёта.Добавить("");
		ЧастиОтчёта.Добавить(НСтр("ru = '=== Не дошли до подписи ==='"));
		Для Каждого ТекстОшибки Из ОшибкиПодготовки Цикл
			ЧастиОтчёта.Добавить(ТекстОшибки);
		КонецЦикла;
	КонецЕсли;

	ПакетПодписания   = Неопределено;
	ОшибкиПодготовки  = Неопределено;
	ИндексДокумента   = 0;
	ИндексВложения    = 0;
	СертификатПодписи = Неопределено;
	МенеджерПодписи   = Неопределено;
	ИдётФоновоеПодписание = Ложь;

	Состояние();
	ОбновитьСписокИИтоги();

	ЭАрМ_ПанельУправленияЭДОКлиент.ПоказатьИтогОтправкиСБИС(
		СтрСоединить(ЧастиОтчёта, Символы.ПС));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Перечитывает очередь и пересчитывает итоги в шапке.
//
&НаКлиенте
Процедура ОбновитьСписокИИтоги(Синхронизировать = Ложь)

	ЗаполнитьОчередьНаСервере(, Синхронизировать);
	// Таблица перезаполнена - причина под ней по новой текущей строке
	ОчередьПриАктивизацииСтроки(Неопределено);

	// Команды очереди меняют статусы УПД/ЭТрН: реестр УПД и монитор ЭДО,
	// открытые в этом сеансе, перечитываются сразу, а не по таймеру
	Оповестить("ЭАрМ_УПД_Обновление", Неопределено, ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиОтбораОчереди(ТаблицаОчереди)

	ЗаполнитьСписокОтбораПоля(Элементы.ОтборКонтрагент, ТаблицаОчереди, "Контрагент");
	ЗаполнитьСписокМагазинов(ТаблицаОчереди);
	ЗаполнитьСписокСтатусов();

КонецПроцедуры

// Статусы очереди СБИС для отбора: подтверждения Далиона («Ожидает»,
// «Не обработано в Далион») в этой форме не показываются.
//
&НаСервере
Процедура ЗаполнитьСписокСтатусов()

	СписокВыбора = Элементы.ОтборСтатус.СписокВыбора;
	Если СписокВыбора.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	Статусы = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО;
	СписокВыбора.Добавить(Статусы.ГотовКОтправке);
	СписокВыбора.Добавить(Статусы.ОшибкаОтправки);
	СписокВыбора.Добавить(Статусы.ОтправленНаПодпись);
	СписокВыбора.Добавить(Статусы.Подтверждено);
	СписокВыбора.Добавить(Статусы.Отклонено);
	СписокВыбора.Добавить(Статусы.НетВСБИС);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокОтбораПоля(Поле, ТаблицаОчереди, ИмяКолонки)

	Если ТаблицаОчереди.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СписокВыбора = Поле.СписокВыбора;
	СписокВыбора.Очистить();

	Уникальные = Новый Соответствие;
	Для Каждого СтрокаОчереди Из ТаблицаОчереди Цикл
		Значение = СокрЛП(СтрокаОчереди[ИмяКолонки]);
		Если НЕ ЗначениеЗаполнено(Значение) ИЛИ Уникальные[Значение] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уникальные.Вставить(Значение, Истина);
		СписокВыбора.Добавить(Значение);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокМагазинов(ТаблицаОчереди)

	СписокВыбора = Элементы.ОтборМагазин.СписокВыбора;
	СписокВыбора.Очистить();

	Уникальные = Новый Соответствие;
	Для Каждого Магазин Из ЭАрМ_ОбработкаПодтвержденийЭДО.МагазиныДляОтбора() Цикл
		ДобавитьЗначениеОтбора(СписокВыбора, Уникальные, Магазин);
	КонецЦикла;

	Если ТаблицаОчереди.Колонки.Найти("Магазин") <> Неопределено Тогда
		Для Каждого СтрокаОчереди Из ТаблицаОчереди Цикл
			ДобавитьЗначениеОтбора(СписокВыбора, Уникальные, СтрокаОчереди.Магазин);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьЗначениеОтбора(СписокВыбора, Уникальные, Значение)

	Значение = СокрЛП(Значение);
	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ Уникальные[Значение] <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Уникальные.Вставить(Значение, Истина);
	СписокВыбора.Добавить(Значение);

КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборОчереди(ТаблицаОчереди)

	ЕстьКонтрагент = ЗначениеЗаполнено(ОтборКонтрагент);
	ЕстьМагазин = ЗначениеЗаполнено(ОтборМагазин);
	ЕстьСтатус = ЗначениеЗаполнено(ОтборСтатус);
	Если НЕ ЕстьКонтрагент И НЕ ЕстьМагазин И НЕ ЕстьСтатус Тогда
		Возврат;
	КонецЕсли;

	Контрагент = СокрЛП(ОтборКонтрагент);
	Магазин = СокрЛП(ОтборМагазин);
	ЕстьКолонкаМагазин = ТаблицаОчереди.Колонки.Найти("Магазин") <> Неопределено;

	Удаляемые = Новый Массив;
	Для Каждого СтрокаОчереди Из ТаблицаОчереди Цикл
		Если ЕстьСтатус И СтрокаОчереди.Статус <> ОтборСтатус Тогда
			Удаляемые.Добавить(СтрокаОчереди);
			Продолжить;
		КонецЕсли;
		Если ЕстьКонтрагент И СокрЛП(СтрокаОчереди.Контрагент) <> Контрагент Тогда
			Удаляемые.Добавить(СтрокаОчереди);
			Продолжить;
		КонецЕсли;
		Если ЕстьМагазин И ЕстьКолонкаМагазин И СокрЛП(СтрокаОчереди.Магазин) <> Магазин Тогда
			Удаляемые.Добавить(СтрокаОчереди);
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаОчереди Из Удаляемые Цикл
		ТаблицаОчереди.Удалить(СтрокаОчереди);
	КонецЦикла;

КонецПроцедуры

