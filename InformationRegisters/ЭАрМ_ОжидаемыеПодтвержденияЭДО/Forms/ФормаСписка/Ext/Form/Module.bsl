&НаКлиенте
Процедура УПДБезДоговораЗавершение(Период, ДополнительныеПараметры) Экспорт

	Если Период = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Поиск УПД без договора...'"));
	Текст = ТекстУПДБезДоговораНаСервере(Период.ДатаНачала, Период.ДатаОкончания);
	Состояние();

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(Текст);
	ТекстовыйДокумент.Показать(НСтр("ru = 'УПД без договора поставщика'"));

