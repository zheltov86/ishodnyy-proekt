////////////////////////////////////////////////////////////////////////////////
// Пары номенклатуры, сошедшиеся по имени: просмотр и создание номенклатуры УТ.
//
// «Создать номенклатуру УТ» для выделенных пар: наименование берётся из приходной
// Далиона (НаименованиеДалион пары; если штрихкод есть в приходной - её name,
// fullName и папки), вид номенклатуры выбирается в окне, дальше - тот же путь,
// что «Создать недостающую» (ЭАрМ_КатегорииТоваров.СоздатьНедостающуюНоменклатуру):
// ТН ВЭД, НДС, артикул, единица, ГТД, упаковки, поставщик через ФНС.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.Список.ТолькоПросмотр = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьНоменклатуру(Команда)

	Строки = Новый Массив;
	БезШтрихкода = Новый Массив;
	Для Каждого Ключ Из Элементы.Список.ВыделенныеСтроки Цикл
		Данные = Элементы.Список.ДанныеСтроки(Ключ);
		Если Данные = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Данные.Штрихкод) Тогда
			БезШтрихкода.Добавить(Данные.НаименованиеДалион);
			Продолжить;
		КонецЕсли;
		Строки.Добавить(Новый Структура("Наименование, Штрихкод",
			?(ЗначениеЗаполнено(Данные.НаименованиеДалион), Данные.НаименованиеДалион, Данные.НаименованиеЭДО),
			Данные.Штрихкод));
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, ?(БезШтрихкода.Количество() > 0,
			НСтр("ru = 'У выделенных пар нет штрихкода - карточку УТ без штрихкода не создаём'"),
			НСтр("ru = 'Выделите пары, для которых нужно создать номенклатуру'")));
		Возврат;
	КонецЕсли;

	Товары = ТоварыДляСоздания(Строки);
	ОткрытьФорму("Обработка.ЭАрМ_ПанельУправленияЭДО.Форма.ФормаВыборВидовНоменклатуры",
		Новый Структура("Товары", Товары), ЭтаФорма, , , ,
		Новый ОписаниеОповещения("СоздатьНоменклатуруВидыВыбраны", ЭтотОбъект,
			Новый Структура("Товары, БезШтрихкода", Товары, БезШтрихкода)),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуруВидыВыбраны(ВидыТоваров, Контекст) Экспорт

	Если ВидыТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Создание номенклатуры...'"));
	Текст = СоздатьНоменклатуруНаСервере(Контекст.Товары, ВидыТоваров);
	Состояние();

	Если Контекст.БезШтрихкода.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрШаблон(НСтр("ru = 'Пропущены без штрихкода: %1'"),
			СтрСоединить(Контекст.БезШтрихкода, "; "));
	КонецЕсли;
	ПоказатьПредупреждение(, Текст, , НСтр("ru = 'Создание номенклатуры'"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Товары для окна видов: наименование, штрихкод, категория по названию.
//
&НаСервереБезКонтекста
Функция ТоварыДляСоздания(Строки)

	Товары = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Товары.Добавить(Новый Структура("Наименование, Штрихкод, Категория",
			Строка.Наименование, Строка.Штрихкод,
			ЭАрМ_КатегорииТоваров.КатегорияТовара(Строка.Наименование)));
	КонецЦикла;
	Возврат Товары;

КонецФункции

&НаСервереБезКонтекста
Функция СоздатьНоменклатуруНаСервере(Знач Товары, ВидыТоваров)

	ВидыПоШтрихкоду = Новый Соответствие;
	Для Каждого ВидТовара Из ВидыТоваров Цикл
		ВидыПоШтрихкоду.Вставить(ВидТовара.Штрихкод, ВидТовара.ВидУИД);
	КонецЦикла;

	Создаваемые = Новый Массив;
	Для Каждого Товар Из Товары Цикл
		Копия = Новый Структура("Наименование, Штрихкод, Категория", Товар.Наименование, Товар.Штрихкод, Товар.Категория);
		ВидУИД = ВидыПоШтрихкоду.Получить(Товар.Штрихкод);
		Если ВидУИД <> Неопределено Тогда
			Копия.Вставить("ВидУИД", ВидУИД);
		КонецЕсли;
		Создаваемые.Добавить(Копия);
	КонецЦикла;

	Попытка
		Итог = ЭАрМ_КатегорииТоваров.СоздатьНедостающуюНоменклатуру(Создаваемые, Истина, Истина);
	Исключение
		Возврат СтрШаблон(НСтр("ru = 'Ошибка: %1'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Тексты = Новый Массив;
	Тексты.Добавить(СтрШаблон(НСтр("ru = 'Товаров: %1, создано: %2, найдено в 1С:Номенклатура: %3, не создано: %4, ошибок: %5'"),
		Создаваемые.Количество(), Итог.Создано, Итог.ИзСервиса, Итог.НеНайдено, Итог.Ошибок));
	Для Каждого Сообщение Из Итог.Сообщения Цикл
		Тексты.Добавить("• " + Сообщение);
	КонецЦикла;

	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

#КонецОбласти
