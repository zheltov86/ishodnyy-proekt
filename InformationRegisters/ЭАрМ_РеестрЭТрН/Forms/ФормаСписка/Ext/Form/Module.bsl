////////////////////////////////////////////////////////////////////////////////
// Форма списка регистра ЭАрМ_РеестрЭТрН.
//
// Реестр наполняет регламентное задание. Здесь - ручное управление тем же
// механизмом: забрать документы сейчас, посмотреть разобранный груз, отправить
// накладную в Далион и увидеть, чем закончилась выгрузка.
//
// Вся работа идёт через ЭАрМ_РегламентныйОбменЭДО: поведение ручной команды
// не должно отличаться от регламентной.
////////////////////////////////////////////////////////////////////////////////

#Область ПеременныеФормы

// Структура - состояние текущего подписания ЭТрН: этап, сертификат и вложения
// с их подписями. Живёт между шагами асинхронной цепочки.
//
&НаКлиенте
Перем ПодписаниеСБИС;

// Строка - ЭТрН, для которой построено дерево. Автообновление списка заново
// активизирует ту же строку, а построение дерева может сходить в СБИС.
//
&НаКлиенте
Перем ДеревоПостроеноДля;

// Булево - идёт фоновый обмен с СБИС: повторное нажатие не запускает второй.
//
&НаКлиенте
Перем ИдётОбменССБИС;

// Автоутверждение: ЭТрН текущего прохода, которые ещё не подписаны; итоги
// прохода; признак, что проход идёт.
//
&НаКлиенте
Перем АвтоОчередь, АвтоИтоги, АвтоИдёт, АвтоНачало;

// Соответствие - ЭТрН, на которых автоутверждение уже споткнулось, пока форма
// открыта. Иначе одна проблемная накладная подписывалась бы каждую минуту.
//
&НаКлиенте
Перем АвтоПропустить;

// Строка - почему автоутверждение остановлено целиком: нет сертификата,
// отменён ввод пароля. Такая ошибка повторится на каждой ЭТрН, поэтому
// проходы не запускаются, пока галочку не переключат.
//
&НаКлиенте
Перем АвтоСбой;

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Цвет строки: отправленная («Утвержден») зелёная. Подписанная строку не красит -
// галочка стоит в колонке «Подписан». ЭТрН с найденной приходной, с которой
// ещё ничего не делали, остаётся обычной.
// Приходная ищется через цепочку закупки или через соответствующую ЭТрН УПД
// (см. ЭАрМ_ЦепочкаЗакупки.ОтметитьЭТрНПоПриходам).
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПодключитьСтатусОчередиКСписку();

	ЭАрМ_УтверждениеСБИС.НастроитьОформлениеСтатусовПодписания(УсловноеОформление, "Список", Ложь, Ложь, Истина);

	ПодсветитьОтправленногоБотом();

	УстановитьВремяВКолонкахДат();

	// Загружаем настройку автоотправки ЭТрН
	АвтоотправкаЭТрН = ЭАрМ_НастройкиСервер.ЗначениеНастройки("АвтоотправкаЭТрН");

КонецПроцедуры

// Галочка «Автоутверждение ЭТрН» сохраняется у пользователя вместе с формой:
// подписывает сертификат того компьютера, где открыт реестр.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если АвтоутверждениеЭТрН Тогда
		ЗапуститьАвтоутверждение();
	КонецЕсли;

КонецПроцедуры

// Даты в реестре показываются с временем: по ним видно, когда документ
// загрузили из СБИС, когда выгрузили в Далион и когда Далион ответил.
// Без времени соседние события одного дня выглядят одинаково.
//
&НаСервере
Процедура УстановитьВремяВКолонкахДат()

	Для Каждого ИмяКолонки Из СтрРазделить("ДатаВыгрузки,ДатаОтветаДалион,ДатаДокументаДалион", ",") Цикл
		Колонка = Элементы.Найти(ИмяКолонки);
		Если Колонка <> Неопределено Тогда
			Колонка.Формат = "ДЛФ=DT";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Добавляет в запрос списка колонку «СтатусБота» из регистра очереди.
// Показывает: «В очереди», «Отправлено Ботом», «Ошибка отправки» или пусто.
// Нужна, чтобы оператор видел, какие ЭТрН ушли автоматически.
//
&НаСервере
Процедура ПодключитьСтатусОчередиКСписку()

	Список.ПроизвольныйЗапрос = Истина;
	Список.ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЭТрН.*,
	|	ВЫБОР
	|		КОГДА Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено)
	|				И Очередь.ПодписаноРоботом
	|			ТОГДА ""Отправлено Ботом""
	|		КОГДА Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено)
	|			ТОГДА ""Подписано""
	|		КОГДА Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОтправленНаПодпись)
	|				И Очередь.ПодписаноРоботом
	|			ТОГДА ""Бот отправил, ждём СБИС""
	|		КОГДА Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки)
	|			ТОГДА ""Ошибка отправки""
	|		КОГДА Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке)
	|			ТОГДА ""В очереди""
	|		КОГДА Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает)
	|			ТОГДА ""Ожидает подтверждения""
	|		КОГДА Очередь.Статус ЕСТЬ NULL
	|			ТОГДА """"
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(Очередь.Статус)
	|	КОНЕЦ КАК СтатусБота
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|		ПО ЭТрН.ИдентификаторСБИС = Очередь.ИдентификаторСБИС
	|			И Очередь.Реестр = ""ЭТрН""";
	Список.УстановитьОбязательноеИспользование("СтатусБота", Истина);

	// Колонка создаётся программно, т.к. поле СтатусБота появляется только
	// после подмены запроса — в XML оно не валидируется при открытии формы.
	Попытка
		Колонка = Элементы.Добавить("СтатусБота", Тип("ПолеФормы"), Элементы.Список);
		Колонка.Вид = ВидПоляФормы.ПолеВвода;
		Колонка.ПутьКДанным = "Список.СтатусБота";
		Колонка.ТолькоПросмотр = Истина;
		Колонка.Ширина = 18;
		Колонка.Заголовок = "Статус бота";
	Исключение
		// Поле уже существует (например, при повторном вызове) — пропускаем.
	КонецПопытки;

КонецПроцедуры

// Подсвечивает строки с «Отправлено Ботом» зелёным, «Ошибка отправки» — красным.
//
&НаСервере
Процедура ПодсветитьОтправленногоБотом()

	// Зелёный — отправлено ботом
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона",
		Новый Цвет(220, 245, 220));

	Отбор = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.СтатусБота");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = "Отправлено Ботом";

	Поле = ЭлементУО.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("СтатусБота");

	// Красный — ошибка отправки
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона",
		Новый Цвет(255, 220, 220));

	Отбор = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.СтатусБота");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = "Ошибка отправки";

	Поле = ЭлементУО.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("СтатусБота");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Забирает реестры ЭТрН и УПД из СБИС фоновым заданием: сеанс обмена
// длится минуты, и синхронный вызов держал клиент без возможности отмены.
//
&НаКлиенте
Процедура ПолучитьИзСБИС(Команда)

	Если ИдётОбменССБИС = Истина Тогда
		СтатусОбмена = НСтр("ru = 'Обмен с СБИС уже выполняется'");
		Возврат;
	КонецЕсли;

	Запуск = ЗапуститьОбменССБИСНаСервере(УникальныйИдентификатор);
	Если ЗначениеЗаполнено(Запуск.Ошибка) Тогда
		СтатусОбмена = Запуск.Ошибка;
		Возврат;
	КонецЕсли;

	ИдётОбменССБИС = Истина;
	СтатусОбмена = НСтр("ru = 'Обмен с СБИС...'");

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Обмен с СБИС'");
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;

	Попытка
		ДлительныеОперацииКлиент.ОжидатьЗавершение(Запуск.Операция,
			Новый ОписаниеОповещения("ОбменССБИСЗавершен", ЭтотОбъект),
			ПараметрыОжидания);
	Исключение
		ИдётОбменССБИС = Ложь;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОбменССБИСЗавершен(Результат, ДополнительныеПараметры) Экспорт

	ИдётОбменССБИС = Ложь;

	Если Результат = Неопределено Тогда
		СтатусОбмена = НСтр("ru = 'Ожидание обмена с СБИС отменено'");
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		СтатусОбмена = Результат.КраткоеПредставлениеОшибки;
		Возврат;
	КонецЕсли;

	Итоги = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	Если ТипЗнч(Итоги) = Тип("Структура") И Итоги.Свойство("Сообщения") Тогда
		СтатусОбмена = СтрСоединить(Итоги.Сообщения, Символы.ПС);
	КонецЕсли;

	ОбновитьСписок();

КонецПроцедуры

// Выгружает текущий документ в Далион.
//
&НаКлиенте
Процедура ВыгрузитьВДалион(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Выгрузка в Далион...'"));
	СтатусОбмена = ВыгрузитьВДалионНаСервере(Идентификатор);
	Состояние();

	ОбновитьСписок();

КонецПроцедуры

// Перечитывает груз документа и открывает его строки.
//
&НаКлиенте
Процедура ПоказатьТовары(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Чтение груза...'"));
	СтатусОбмена = ОбновитьТоварыНаСервере(Идентификатор);
	Состояние();

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Новый Структура("ИдентификаторСБИС", Идентификатор));

	ОткрытьФорму("РегистрСведений.ЭАрМ_ТоварыЭТрН.ФормаСписка", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

// Показывает JSON, который уйдёт в Далион, ничего не отправляя.
//
&НаКлиенте
Процедура ПоказатьJSON(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Сборка JSON...'"));
	РезультатПодготовки = ПодготовитьJSONНаСервере(Идентификатор);
	Состояние();

	СтатусОбмена = РезультатПодготовки.Статус;

	Если НЕ ЗначениеЗаполнено(РезультатПодготовки.ТекстJSON) Тогда
		Возврат;
	КонецЕсли;

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(РезультатПодготовки.ТекстJSON);
	ТекстовыйДокумент.Показать(РезультатПодготовки.ИмяФайла);

КонецПроцедуры

// Снимает отметку о выгрузке: документ уйдёт в Далион повторно.
//
&НаКлиенте
Процедура СброситьВыгрузку(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения("СброситьВыгрузкуЗавершение", ЭтотОбъект,
		Новый Структура("Идентификатор", Идентификатор));

	ПоказатьВопрос(ОписаниеОповещения,
		НСтр("ru = 'Снять отметку о выгрузке? Документ будет отправлен в Далион ещё раз.'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// Открывает журнал обмена по текущему документу.
//
&НаКлиенте
Процедура ОткрытьЖурнал(Команда)

	ПараметрыФормы = Новый Структура;

	Идентификатор = ИдентификаторТекущейСтроки();
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		ПараметрыФормы.Вставить("Отбор", Новый Структура("ИдентификаторСБИС", Идентификатор));
	КонецЕсли;

	ОткрытьФорму("РегистрСведений.ЭАрМ_ЖурналОбменаЭДО.ФормаСписка", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

// Подписывает титул ЭТрН и отправляет утверждение в СБИС - так же, как
// «Подписать и утвердить» в реестре УПД (механика - ЭАрМ_УтверждениеСБИС).
// Утверждать можно только ЭТрН с отметкой «Можно утвердить»: к ней нашлась
// приходная накладная Далиона.
//
// Действие необратимо, поэтому команда сначала спрашивает подтверждение.
// Подписание идёт на клиенте: закрытый ключ лежит у пользователя.
//
&НаКлиенте
Процедура ПодписатьИУтвердитьСБИС(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Если АвтоутверждениеИдёт() ИЛИ ПодписаниеИдёт() Тогда
		СообщитьОбУтверждении(НСтр("ru = 'Сейчас идёт подписание ЭТрН - повторите, когда оно закончится.'"));
		Возврат;
	КонецЕсли;

	ТекстЗапрета = ЗапретУтвержденияНаСервере(Идентификатор);
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		СообщитьОбУтверждении(ТекстЗапрета);
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПодписатьИУтвердитьПодтверждение", ЭтотОбъект,
		Новый Структура("Идентификатор", Идентификатор));

	// В СБИС это действие «Получен» этапа «Приемка груза» - заявление, что груз
	// принят полностью. Частичная приёмка и отказ оформляются в СБИС вручную
	ПоказатьВопрос(ОписаниеОповещения,
		НСтр("ru = 'Подписать ЭТрН как «Получен» - груз принят полностью - и отправить в СБИС? Отменить это будет нельзя. Если груз пришёл не весь или с браком, оформите «Получен частично» или «Не принят» в СБИС.'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// Открывает статистику ЭДО: что подписано в СБИС, что отправлено и ждёт
// подписи, а что ещё нужно обработать - вместе с итогами товаров.
//
// Итоги живут отдельной обработкой, а не деревом под списком: в реестре они
// занимали пол-экрана, а нужны для другой задачи - не вести документ, а понять
// общую картину за период.
//
&НаКлиенте
Процедура СтатистикаЭДО(Команда)

	ОткрытьФорму("DataProcessor.ЭАрМ_СтатистикаЭДО.Form.Форма", , ЭтаФорма);

КонецПроцедуры

// Показывает этапы и действия ЭТрН прямо из СБИС и каким действием её
// подпишет «Подписать и утвердить». Только чтение - в СБИС ничего не уходит.
//
// Нужна, чтобы увидеть, как СБИС называет действие грузополучателя: у ЭТрН
// это не обязательно «Утвердить», как у УПД.
//
&НаКлиенте
Процедура ЭтапыВСБИС(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'СБИС: чтение документа...'"));
	ТекстОтчета = ЭтапыВСБИСНаСервере(Идентификатор);
	Состояние();

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстОтчета);
	ТекстовыйДокумент.Показать(НСтр("ru = 'ЭТрН: этапы и действия в СБИС'"));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтапыВСБИСНаСервере(Идентификатор)

	Возврат ЭАрМ_УтверждениеСБИС.ЭтапыДокументаВСБИС("ЭТрН", Идентификатор);

КонецФункции

// Раскрывает коды маркировки ЭТрН и её УПД: GTIN, Честный знак, SSCC, ЕГАИС.
//
&НаКлиенте
Процедура КодыМаркировки(Команда)

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'СБИС: чтение кодов маркировки...'"));
	ТекстОтчета = КодыМаркировкиНаСервере(Идентификатор);
	Состояние();

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстОтчета);
	ТекстовыйДокумент.Показать(НСтр("ru = 'Коды маркировки и GTIN'"));

КонецПроцедуры

// Открывает настройки обмена.
//
&НаКлиенте
Процедура ОткрытьНастройки(Команда)

	ОткрытьФорму("РегистрСведений.ЭАрМ_НастройкиЭДО.Форма.ФормаНастроек", , ЭтаФорма, , , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Перестраивает цепочку ЭТрН -> УПД -> товары -> фактические товары Базы2.
//
// Построение откладывается на 0.3 с: при листании стрелками дерево строится
// для строки, на которой остановились. Построение может догружать товары УПД
// из СБИС, и раньше это происходило на каждой промежуточной строке.
//
&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	ОтключитьОбработчикОжидания("Подключаемый_ПостроитьДеревоТоваров");
	ПодключитьОбработчикОжидания("Подключаемый_ПостроитьДеревоТоваров", 0.3, Истина);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПостроитьДеревоТоваров()

	Идентификатор = ИдентификаторТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор)
		ИЛИ Идентификатор = ДеревоПостроеноДля Тогда
		Возврат;
	КонецЕсли;

	ДеревоПостроеноДля = Идентификатор;
	ЗаполнитьДеревоТоваровНаСервере(Идентификатор);

КонецПроцедуры

// Сохраняет настройку «АвтоотправкаЭТрН» при переключении чекбокса.
// Регламент задания и клиентские цепочки читают её через ЗначениеНастройки.
//
&НаКлиенте
Процедура АвтоотправкаЭТрНФлагПриИзменении(Элемент)

	СохранитьНастройкуАвтоотправкиНаСервере(АвтоотправкаЭТрН);

КонецПроцедуры

// Сохраняет настройку на сервере (клиентский обработчик не имеет доступа
// к серверным общим модулям напрямую).
//
&НаСервереБезКонтекста
Процедура СохранитьНастройкуАвтоотправкиНаСервере(Значение)

	ЭАрМ_НастройкиСервер.СохранитьНастройку("АвтоотправкаЭТрН", Значение);

КонецПроцедуры

// Включение автоутверждения - это «Подписать и утвердить» для каждой готовой
// ЭТрН без вопроса, поэтому подтверждение и выбор подписанта - один раз здесь.
//
&НаКлиенте
Процедура АвтоутверждениеЭТрНФлагПриИзменении(Элемент)

	АвтоСбой = "";

	Если НЕ АвтоутверждениеЭТрН Тогда
		ОстановитьАвтоутверждение();
		СтатусОбмена = НСтр("ru = 'Автоутверждение ЭТрН выключено'");
		Возврат;
	КонецЕсли;

	// Включится после подтверждения
	АвтоутверждениеЭТрН = Ложь;

	ПоказатьВопрос(Новый ОписаниеОповещения("ВключитьАвтоутверждениеПодтверждение", ЭтотОбъект),
		НСтр("ru = 'Пока реестр открыт, каждая ЭТрН «Готов к утверждению» (есть приходная Далиона) будет подписываться как «Получен» - груз принят полностью - и уходить в СБИС без вопроса, по 5 штук за раз. Отменить отправленное нельзя. Включить автоутверждение?'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ВключитьАвтоутверждениеПодтверждение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЭАрМ_ПанельУправленияЭДОКлиент.ВыбратьПодписанта(
		Новый ОписаниеОповещения("АвтоутверждениеПодписантВыбран", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура АвтоутверждениеПодписантВыбран(НомерПодписанта, ДополнительныеПараметры) Экспорт

	Если НомерПодписанта = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НомерПодписантаАвто = НомерПодписанта;
	АвтоутверждениеЭТрН = Истина;
	СтатусОбмена = НСтр("ru = 'Автоутверждение ЭТрН включено'");

	ЗапуститьАвтоутверждение();

КонецПроцедуры

#КонецОбласти

#Область Автоутверждение

// Проход - раз в минуту и первый сразу после включения или открытия формы.
//
&НаКлиенте
Процедура ЗапуститьАвтоутверждение()

	ОтключитьОбработчикОжидания("Подключаемый_Автоутверждение");
	ПодключитьОбработчикОжидания("Подключаемый_Автоутверждение", 60);
	ПодключитьОбработчикОжидания("Подключаемый_АвтоутверждениеСейчас", 2, Истина);

КонецПроцедуры

// Новых проходов не будет; начатая ЭТрН дописывается, остальные ждут.
//
&НаКлиенте
Процедура ОстановитьАвтоутверждение()

	ОтключитьОбработчикОжидания("Подключаемый_Автоутверждение");
	ОтключитьОбработчикОжидания("Подключаемый_АвтоутверждениеСейчас");
	АвтоОчередь = Неопределено;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_АвтоутверждениеСейчас()

	Подключаемый_Автоутверждение();

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_Автоутверждение()

	Если НЕ АвтоутверждениеЭТрН
		ИЛИ АвтоутверждениеИдёт()
		ИЛИ ПодписаниеИдёт()
		ИЛИ ИдётОбменССБИС = Истина
		ИЛИ ЗначениеЗаполнено(АвтоСбой) Тогда
		Возврат;
	КонецЕсли;

	Если АвтоПропустить = Неопределено Тогда
		АвтоПропустить = Новый Соответствие;
	КонецЕсли;

	Исключить = Новый Массив;
	Для Каждого КлючЗначение Из АвтоПропустить Цикл
		Исключить.Добавить(КлючЗначение.Ключ);
	КонецЦикла;

	АвтоОчередь = ГотовыеКАвтоутверждениюНаСервере(Исключить);

	Если АвтоОчередь.Количество() = 0 Тогда
		АвтоОчередь = Неопределено;
		Возврат;
	КонецЕсли;

	АвтоИдёт = Истина;
	АвтоНачало = ТекущаяДата();
	АвтоИтоги = Новый Структура("Обработаны, Ошибки, ПачкаПолная", Новый Массив, Новый Массив,
		АвтоОчередь.Количество() >= РазмерПачкиАвтоутверждения());

	АвтоутвердитьСледующую();

КонецПроцедуры

// Цепочка подписи может оборваться исключением, не дойдя до оповещения
// (сбой сервера при отправке). Тогда признаки «идёт» остались бы навсегда
// и блокировали и ручную подпись, и автоутверждение до закрытия формы,
// поэтому давнее состояние считается брошенным.
//
&НаКлиенте
Функция АвтоутверждениеИдёт()

	Возврат АвтоИдёт = Истина
		И АвтоНачало <> Неопределено
		И ТекущаяДата() - АвтоНачало < 1800;

КонецФункции

&НаКлиенте
Функция ПодписаниеИдёт()

	Если ПодписаниеСБИС = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ПодписаниеСБИС.Свойство("Начало") Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ТекущаяДата() - ПодписаниеСБИС.Начало < 600;

КонецФункции

// Запускает для очередной ЭТрН ту же цепочку, что и «Подписать и утвердить»,
// начиная сразу с подготовки: вопрос и подписант уже решены при включении.
//
&НаКлиенте
Процедура АвтоутвердитьСледующую()

	Если АвтоОчередь = Неопределено ИЛИ АвтоОчередь.Количество() = 0 Тогда
		ЗавершитьАвтоутверждение();
		Возврат;
	КонецЕсли;

	Идентификатор = АвтоОчередь[0];
	АвтоОчередь.Удалить(0);

	ПодписантДляПодписанияВыбран(Макс(НомерПодписантаАвто, 1),
		Новый Структура("Идентификатор, Авто", Идентификатор, Истина));

КонецПроцедуры

// Подготовка в СБИС не удалась - это касается одной ЭТрН, идём к следующей.
//
&НаКлиенте
Процедура АвтоОшибкаДокумента(Идентификатор, ТекстОшибки)

	АвтоПропустить.Вставить(Идентификатор, Истина);
	АвтоИтоги.Ошибки.Добавить(ТекстОшибки);

	АвтоутвердитьСледующую();

КонецПроцедуры

// Подписи отправлены. Удалось ли, видно по отметкам реестра в конце прохода.
//
&НаКлиенте
Процедура АвтоДокументОтправлен(Идентификатор)

	АвтоПропустить.Вставить(Идентификатор, Истина);
	АвтоИтоги.Обработаны.Добавить(Идентификатор);

	АвтоутвердитьСледующую();

КонецПроцедуры

// Нет сертификата, не создан менеджер криптографии, отменён пароль - то же
// будет на каждой ЭТрН. Останавливаемся и говорим об этом один раз.
//
&НаКлиенте
Процедура ОстановитьАвтоутверждениеПоСбою(ТекстОшибки)

	АвтоСбой = ТекстОшибки;
	АвтоОчередь = Неопределено;

	ЗавершитьАвтоутверждение();

	СообщитьОбУтверждении(СтрШаблон(
		НСтр("ru = 'Автоутверждение ЭТрН приостановлено: %1
			|Чтобы возобновить, снимите и снова поставьте галочку «Автоутверждение ЭТрН».'"),
		ТекстОшибки));

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьАвтоутверждение()

	АвтоИдёт = Ложь;
	АвтоОчередь = Неопределено;

	Если АвтоИтоги = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Итоги = АвтоИтоги;
	АвтоИтоги = Неопределено;

	// Полная пачка - в реестре, скорее всего, есть ещё готовые: следующая
	// пачка через несколько секунд, а не через минуту. Пауза даёт оператору
	// поработать с формой между пачками
	Если Итоги.ПачкаПолная И АвтоутверждениеЭТрН И НЕ ЗначениеЗаполнено(АвтоСбой) Тогда
		ПодключитьОбработчикОжидания("Подключаемый_АвтоутверждениеСейчас", 5, Истина);
	КонецЕсли;

	Отправлено = 0;
	Если Итоги.Обработаны.Количество() > 0 Тогда
		Отправлено = УтвержденоИзНаСервере(Итоги.Обработаны);
	КонецЕсли;
	НеПрошло = Итоги.Обработаны.Количество() - Отправлено + Итоги.Ошибки.Количество();

	Если Отправлено = 0 И НеПрошло = 0 Тогда
		Возврат;
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = 'Автоутверждение ЭТрН: отправлено в СБИС %1, не прошло %2'"),
		Отправлено, НеПрошло));
	Для Каждого ТекстОшибки Из Итоги.Ошибки Цикл
		Части.Добавить(ТекстОшибки);
	КонецЦикла;
	СтатусОбмена = СтрСоединить(Части, Символы.ПС);

	ПоказатьОповещениеПользователя(НСтр("ru = 'Автоутверждение ЭТрН'"), ,
		СтрШаблон(НСтр("ru = 'Отправлено в СБИС: %1, не прошло: %2'"), Отправлено, НеПрошло));

	ОбновитьСписок();

КонецПроцедуры

// ЭТрН «Готов к утверждению»: есть приходная Далиона («Можно утвердить»),
// утверждение ещё не уходило. Условие то же, что у ЗапретУтверждения для ЭТрН:
// приходная сама даёт право подписи, совпадение товаров не требуется.
// Пачка - РазмерПачкиАвтоутверждения(); ЭТрН, на которых подпись уже сорвалась,
// исключаются здесь же, иначе они занимали бы пачку и остальные не подписывались.
//
&НаСервереБезКонтекста
Функция ГотовыеКАвтоутверждениюНаСервере(Исключить)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(РазмерПачкиАвтоутверждения(), "ЧГ=0") + "
	|	ЭТрН.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	ЭТрН.МожноУтвердить
	|	И НЕ ЭТрН.ИдентификаторСБИС В (&Исключить)
	|	И НЕ ЭТрН.Подписано
	|	И НЕ ЭТрН.Утверждено
	|	И НЕ ЭТрН.СтатусПодписания В (
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Утвержден),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан))
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("ЭТрН") + "
	|	И ЭТрН.КодСостояния <> ""27""
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭТрН.Дата";
	Запрос.УстановитьПараметр("Исключить", Исключить);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИдентификаторСБИС");

КонецФункции

// Сколько ЭТрН подписывается за один проход. Пока идёт пачка, форма ждёт
// ответов СБИС, поэтому пачка небольшая, а полная пачка сразу зовёт следующую.
//
&НаКлиентеНаСервереБезКонтекста
Функция РазмерПачкиАвтоутверждения()

	Возврат 5;

КонецФункции

// Сколько из отправленных ЭТрН реестр считает утверждёнными.
//
&НаСервереБезКонтекста
Функция УтвержденоИзНаСервере(Идентификаторы)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Утверждено
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	ЭТрН.ИдентификаторСБИС В (&Идентификаторы)
	|	И (ЭТрН.Утверждено ИЛИ ЭТрН.Подписано)";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Утверждено;

КонецФункции

#КонецОбласти

#Область ПодписаниеСБИС

// Ответ на вопрос о подписании: сервер готовит действие и отдаёт вложения.
//
&НаКлиенте
Процедура ПодписатьИУтвердитьПодтверждение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	// Подписантов в настройках может быть два - спрашиваем, кто подписывает
	ЭАрМ_ПанельУправленияЭДОКлиент.ВыбратьПодписанта(
		Новый ОписаниеОповещения("ПодписантДляПодписанияВыбран", ЭтотОбъект, ДополнительныеПараметры));

КонецПроцедуры

// Подписант выбран - готовим действие в СБИС его сертификатом.
//
&НаКлиенте
Процедура ПодписантДляПодписанияВыбран(НомерПодписанта, ДополнительныеПараметры) Экспорт

	Если НомерПодписанта = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Авто = ДополнительныеПараметры.Свойство("Авто") И ДополнительныеПараметры.Авто;

	// Чтение документа, подготовка действия и скачивание вложений идут
	// фоновым заданием - и для кнопки, и для робота. Форма ждёт их
	// асинхронно: раньше она замирала до ответа СБИС на каждой ЭТрН.
	// Заглушка держит признак «подписание идёт» (ПодписаниеИдёт), чтобы
	// повторный клик не запустил вторую подготовку
	ПодписаниеСБИС = Новый Структура("Начало, Авто", ТекущаяДата(), Авто);
	ЗапуститьПодготовкуВФоне(ДополнительныеПараметры.Идентификатор, НомерПодписанта, Авто);

КонецПроцедуры

// Подготовка готова - дальше подпись на этом компьютере, общая для ручной
// подписи и робота.
//
&НаКлиенте
Процедура ПодготовкаПолучена(Подготовка, Идентификатор, Авто)

	Если НЕ Подготовка.Успех Тогда
		ПодписаниеСБИС = Неопределено;
		Если Авто Тогда
			АвтоОшибкаДокумента(Идентификатор, Подготовка.Ошибка);
		Иначе
			СообщитьОбУтверждении(Подготовка.Ошибка);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ПодписаниеСБИС = Подготовка;
	ПодписаниеСБИС.Вставить("Индекс", 0);
	ПодписаниеСБИС.Вставить("Авто", Авто);
	ПодписаниеСБИС.Вставить("Начало", ТекущаяДата());

	// Сертификат берём первым: по нему менеджер криптографии выберет программу
	ЭлектроннаяПодписьКлиент.ПолучитьСертификатПоОтпечатку(
		Новый ОписаниеОповещения("ПодписаниеСертификатПолучен", ЭтотОбъект),
		ПодписаниеСБИС.ОтпечатокBase64, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьПодготовкуВФоне(Идентификатор, НомерПодписанта, Авто)

	Попытка
		Операция = ЗапуститьПодготовкуНаСервере(УникальныйИдентификатор,
			Идентификатор, НомерПодписанта);
	Исключение
		ПодготовкаПолучена(Новый Структура("Успех, Ошибка", Ложь,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())), Идентификатор, Авто);
		Возврат;
	КонецПопытки;

	Если НЕ Авто Тогда
		Состояние(НСтр("ru = 'СБИС: подготовка действия...'"));
	КонецЕсли;

	ОжидатьФоновуюОперацию(Операция, "ПодготовкаВФонеЗавершена",
		Новый Структура("Идентификатор, Авто", Идентификатор, Авто));

КонецПроцедуры

&НаКлиенте
Процедура ПодготовкаВФонеЗавершена(Результат, Параметры) Экспорт

	Если НЕ Параметры.Авто Тогда
		Состояние();
	КонецЕсли;

	// Проход робота уже закрыт (сторож признал его брошенным) - поздний
	// ответ не нужен
	Если Параметры.Авто И АвтоИтоги = Неопределено Тогда
		ПодписаниеСБИС = Неопределено;
		Возврат;
	КонецЕсли;

	ТекстОшибки = "";
	Подготовка = РезультатФоновойОперации(Результат, ТекстОшибки);
	Если Подготовка = Неопределено Тогда
		Подготовка = Новый Структура("Успех, Ошибка", Ложь, ТекстОшибки);
	КонецЕсли;

	ПодготовкаПолучена(Подготовка, Параметры.Идентификатор, Параметры.Авто);

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьОтправкуПодписейВФоне(ДанныеОтправки, Авто)

	Попытка
		Операция = ЗапуститьОтправкуНаСервере(УникальныйИдентификатор, ДанныеОтправки, Авто);
	Исключение
		ЗавершитьОтправкуПодписей(ДанныеОтправки.Идентификатор, Авто, Неопределено,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если НЕ Авто Тогда
		Состояние(НСтр("ru = 'СБИС: отправка подписей...'"));
	КонецЕсли;

	ОжидатьФоновуюОперацию(Операция, "ОтправкаПодписейВФонеЗавершена",
		Новый Структура("Идентификатор, Авто", ДанныеОтправки.Идентификатор, Авто));

КонецПроцедуры

&НаКлиенте
Процедура ОтправкаПодписейВФонеЗавершена(Результат, Параметры) Экспорт

	ТекстОшибки = "";
	ОтветСБИС = РезультатФоновойОперации(Результат, ТекстОшибки);

	ЗавершитьОтправкуПодписей(Параметры.Идентификатор, Параметры.Авто, ОтветСБИС, ТекстОшибки);

КонецПроцедуры

// Итог отправки. У робота он ложится в реестр и очередь, а
// ЗавершитьАвтоутверждение сверяет его по отметкам реестра - здесь ловим
// только сбой самого фонового задания: раньше такой сбой обрывал цепочку,
// и автоутверждение стояло до срабатывания сторожа через полчаса.
// Человеку показываем ответ СБИС, как и раньше.
//
&НаКлиенте
Процедура ЗавершитьОтправкуПодписей(Идентификатор, Авто, ОтветСБИС, ТекстОшибки)

	ПодписаниеСБИС = Неопределено;

	Если Авто Тогда
		Если АвтоИтоги = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если ОтветСБИС = Неопределено Тогда
			АвтоОшибкаДокумента(Идентификатор, ТекстОшибки);
		Иначе
			АвтоДокументОтправлен(Идентификатор);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Состояние();

	Если ОтветСБИС = Неопределено Тогда
		СообщитьОбУтверждении(ТекстОшибки);
	Иначе
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.УстановитьТекст(ОтветСБИС);
		ТекстовыйДокумент.Показать(НСтр("ru = 'СБИС: утверждение ЭТрН'"));
	КонецЕсли;

	ОбновитьСписок();

КонецПроцедуры

// Ждёт фоновое задание без окна ожидания: форма остаётся рабочей.
//
&НаКлиенте
Процедура ОжидатьФоновуюОперацию(Операция, ИмяОбработчика, ДополнительныеПараметры)

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;

	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция,
		Новый ОписаниеОповещения(ИмяОбработчика, ЭтотОбъект, ДополнительныеПараметры),
		ПараметрыОжидания);

КонецПроцедуры

// Результат фонового задания; Неопределено и текст ошибки при сбое или отмене.
//
&НаКлиенте
Функция РезультатФоновойОперации(Результат, ТекстОшибки)

	Если Результат = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Ожидание ответа СБИС отменено'");
		Возврат Неопределено;
	КонецЕсли;

	Если Результат.Статус <> "Выполнено" Тогда
		ТекстОшибки = ?(Результат.Статус = "Ошибка",
			Результат.КраткоеПредставлениеОшибки,
			НСтр("ru = 'Фоновое задание отменено'"));
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПолучитьИзВременногоХранилища(Результат.АдресРезультата);

КонецФункции

// Сертификат найден в личном хранилище.
//
&НаКлиенте
Процедура ПодписаниеСертификатПолучен(Сертификат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Сертификат) <> Тип("СертификатКриптографии") Тогда
		ПрерватьПодписаниеСБИС(СтрШаблон(НСтр(
			"ru = 'Сертификат с отпечатком %1 не найден в личном хранилище этого компьютера.'"),
			ПодписаниеСБИС.Отпечаток));
		Возврат;
	КонецЕсли;

	ПодписаниеСБИС.Вставить("Сертификат", Сертификат);

	ЭлектроннаяПодписьКлиент.СоздатьМенеджерКриптографии(
		Новый ОписаниеОповещения("ПодписаниеМенеджерПолучен", ЭтотОбъект),
		"Подписание", Истина, Сертификат.Выгрузить());

КонецПроцедуры

// Менеджер криптографии получен.
//
&НаКлиенте
Процедура ПодписаниеМенеджерПолучен(МенеджерКриптографии, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(МенеджерКриптографии) <> Тип("МенеджерКриптографии") Тогда
		ПрерватьПодписаниеСБИС(СтрШаблон(НСтр(
			"ru = 'Не удалось создать менеджер криптографии для этого сертификата: %1'"),
			?(ТипЗнч(МенеджерКриптографии) = Тип("Строка"), МенеджерКриптографии,
				НСтр("ru = 'проверьте, установлена ли нужная программа криптографии'"))));
		Возврат;
	КонецЕсли;

	ПодписаниеСБИС.Вставить("Менеджер", МенеджерКриптографии);
	ПодписатьСледующееВложениеСБИС();

КонецПроцедуры

// Подписывает очередное вложение либо переходит к отправке.
//
&НаКлиенте
Процедура ПодписатьСледующееВложениеСБИС()

	Если ПодписаниеСБИС.Индекс >= ПодписаниеСБИС.Вложения.Количество() Тогда
		ОтправитьПодписиСБИС();
		Возврат;
	КонецЕсли;

	Вложение = ПодписаниеСБИС.Вложения[ПодписаниеСБИС.Индекс];

	Состояние(СтрШаблон(НСтр("ru = 'Подписание: %1'"), Вложение.Имя));

	// Обработчик ошибки: без него сбой подписи оставлял подписание «идущим»
	ПодписаниеСБИС.Менеджер.НачатьПодписывание(
		Новый ОписаниеОповещения("ВложениеПодписаноСБИС", ЭтотОбъект, ,
			"ВложениеНеПодписаноСБИС", ЭтотОбъект),
		Вложение.Данные, ПодписаниеСБИС.Сертификат);

КонецПроцедуры

&НаКлиенте
Процедура ВложениеНеПодписаноСБИС(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	СтандартнаяОбработка = Ложь;
	ПрерватьПодписаниеСБИС(НСтр("ru = 'Ошибка подписи: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке));

КонецПроцедуры

// Подпись одного вложения готова.
//
&НаКлиенте
Процедура ВложениеПодписаноСБИС(ДанныеПодписи, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(ДанныеПодписи) <> Тип("ДвоичныеДанные") Тогда
		ПрерватьПодписаниеСБИС(НСтр("ru = 'Подписание прервано'"));
		Возврат;
	КонецЕсли;

	ПодписаниеСБИС.Вложения[ПодписаниеСБИС.Индекс].Подпись = ДанныеПодписи;
	ПодписаниеСБИС.Индекс = ПодписаниеСБИС.Индекс + 1;
	ПодписатьСледующееВложениеСБИС();

КонецПроцедуры

// Отправляет подписи в СБИС и показывает ответ.
//
&НаКлиенте
Процедура ОтправитьПодписиСБИС()

	// Сертификат и менеджер криптографии на сервер не передаются. Сами файлы
	// нужны только если титул грузополучателя дозаполнили до подписи: СБИС
	// должен получить тот же XML, который подписали, а не пустой каркас.
	ДанныеОтправки = Новый Структура;
	ДанныеОтправки.Вставить("Идентификатор", ПодписаниеСБИС.Идентификатор);
	ДанныеОтправки.Вставить("Этап",          ПодписаниеСБИС.Этап);
	ДанныеОтправки.Вставить("Действие",      ПодписаниеСБИС.Действие);
	ДанныеОтправки.Вставить("НомерПодписанта", ?(ПодписаниеСБИС.Свойство("НомерПодписанта"),
		ПодписаниеСБИС.НомерПодписанта, 1));

	ВложенияОтправки = Новый Массив;
	Для Каждого Вложение Из ПодписаниеСБИС.Вложения Цикл
		ВложениеОтправки = Новый Структура("Идентификатор, Имя, Подпись",
			Вложение.Идентификатор, Вложение.Имя, Вложение.Подпись);
		Если Вложение.Свойство("ФайлЗаменён") И Вложение.ФайлЗаменён Тогда
			ВложениеОтправки.Вставить("Данные", Вложение.Данные);
			ВложениеОтправки.Вставить("ФайлЗаменён", Истина);
		КонецЕсли;
		ВложенияОтправки.Добавить(ВложениеОтправки);
	КонецЦикла;
	ДанныеОтправки.Вставить("Вложения", ВложенияОтправки);

	Авто = ПодписаниеСБИС.Авто;

	// Подписи сделаны, менеджер криптографии больше не нужен. Подписи
	// уходят в СБИС фоновым заданием; заглушка держит признак «подписание
	// идёт», пока задание не ответит
	ПодписаниеСБИС = Новый Структура("Начало, Авто", ТекущаяДата(), Авто);
	ЗапуститьОтправкуПодписейВФоне(ДанныеОтправки, Авто);

КонецПроцедуры

// Прекращает подписание, не оставляя за собой состояния.
//
&НаКлиенте
Процедура ПрерватьПодписаниеСБИС(ТекстОшибки)

	Авто = ПодписаниеСБИС <> Неопределено И ПодписаниеСБИС.Авто;

	ПодписаниеСБИС = Неопределено;
	Состояние();

	Если Авто Тогда
		ОстановитьАвтоутверждениеПоСбою(ТекстОшибки);
		Возврат;
	КонецЕсли;

	СообщитьОбУтверждении(ТекстОшибки);

КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбУтверждении(Текст)

	СтатусОбмена = Текст;
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗапретУтвержденияНаСервере(Идентификатор)

	Возврат ЭАрМ_УтверждениеСБИС.ЗапретУтверждения("ЭТрН", Идентификатор, Истина);

КонецФункции

// Подготовка подписания в СБИС фоновым заданием - для кнопки и робота.
//
&НаСервереБезКонтекста
Функция ЗапуститьПодготовкуНаСервере(ИдентификаторФормы, Идентификатор, НомерПодписанта)

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания =
		НСтр("ru = 'Утверждение ЭТрН: подготовка в СБИС'");
	ПараметрыВыполнения.СРасширениямиБазыДанных = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;

	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"ЭАрМ_УтверждениеСБИС.ПодготовитьПодписание", "ЭТрН", Идентификатор, НомерПодписанта);

КонецФункции

// Отправка подписей в СБИС фоновым заданием. Робот и человек отмечаются
// в очереди по-разному: см. ЭАрМ_УтверждениеСБИС.ВыполнитьДействиеРобота
// и ВыполнитьДействиеЧеловека.
//
&НаСервереБезКонтекста
Функция ЗапуститьОтправкуНаСервере(ИдентификаторФормы, ДанныеОтправки, Авто)

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания =
		НСтр("ru = 'Утверждение ЭТрН: отправка подписей в СБИС'");
	ПараметрыВыполнения.СРасширениямиБазыДанных = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;

	ИмяФункции = ?(Авто, "ЭАрМ_УтверждениеСБИС.ВыполнитьДействиеРобота",
		"ЭАрМ_УтверждениеСБИС.ВыполнитьДействиеЧеловека");

	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		ИмяФункции, "ЭТрН", ДанныеОтправки);

КонецФункции

#КонецОбласти

#Область УтверждениеВОчередь

// Ставит выделенные ЭТрН в очередь ЭАрМ_ОжидаемыеПодтвержденияЭДО с отметкой
// «Отправить» и флажком «К отправке» в реестре. У ЭТрН утверждение - это
// действие «Получен» этапа «Приемка груза» (груз принят полностью); его
// выполнит очередь при подписи. Здесь в СБИС ничего не уходит. ЭТрН без
// «Можно утвердить» (нет приходной Далиона) в очередь не встаёт.
//
&НаКлиенте
Процедура ПолученВОчередь(Команда)

	Идентификаторы = ВыделенныеИдентификаторы();
	Если Идентификаторы.Количество() = 0 Тогда
		СообщитьОбУтверждении(НСтр("ru = 'Выберите ЭТрН в списке'"));
		Возврат;
	КонецЕсли;

	СообщитьОПостановкеНаУтверждение(ПоставитьНаУтверждениеНаСервере(Идентификаторы));

	ОбновитьСписок();

КонецПроцедуры

// Двойной клик по колонке «К отправке» ставит ЭТрН в очередь или снимает.
// По остальным колонкам - обычное открытие записи.
//
&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле <> Элементы.КОтправке Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	ДанныеСтроки = Элементы.Список.ДанныеСтроки(ВыбраннаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ДанныеСтроки.КОтправке Тогда
		Ошибка = СнятьСУтвержденияНаСервере(ДанныеСтроки.ИдентификаторСБИС);
		СообщитьОбУтверждении(?(ЗначениеЗаполнено(Ошибка), Ошибка,
			НСтр("ru = 'ЭТрН снята с утверждения и убрана из очереди'")));
	Иначе
		Идентификаторы = Новый Массив;
		Идентификаторы.Добавить(ДанныеСтроки.ИдентификаторСБИС);
		СообщитьОПостановкеНаУтверждение(ПоставитьНаУтверждениеНаСервере(Идентификаторы));
	КонецЕсли;

	ОбновитьСписок();

КонецПроцедуры

&НаКлиенте
Функция ВыделенныеИдентификаторы()

	Результат = Новый Массив;

	Для Каждого ВыделеннаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(ВыделеннаяСтрока);
		Если ДанныеСтроки <> Неопределено
			И ЗначениеЗаполнено(ДанныеСтроки.ИдентификаторСБИС) Тогда
			Результат.Добавить(ДанныеСтроки.ИдентификаторСБИС);
		КонецЕсли;
	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Идентификатор = ИдентификаторТекущейСтроки();
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Результат.Добавить(Идентификатор);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура СообщитьОПостановкеНаУтверждение(Итог)

	Части = Новый Массив;

	Если Итог.Поставлено > 0 Тогда
		Части.Добавить(СтрШаблон(
			НСтр("ru = 'Поставлено в очередь как «Получен»: %1. Подпишите в очереди «Ожидаемые подтверждения ЭДО».'"),
			Итог.Поставлено));
	КонецЕсли;

	Для Каждого Ошибка Из Итог.Ошибки Цикл
		Части.Добавить(Ошибка);
	КонецЦикла;

	Если Части.Количество() > 0 Тогда
		СообщитьОбУтверждении(СтрСоединить(Части, Символы.ПС));
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПоставитьНаУтверждениеНаСервере(Идентификаторы)

	Возврат ЭАрМ_ОбработкаПодтвержденийЭДО.ПоставитьНаУтверждение("ЭТрН", Идентификаторы);

КонецФункции

&НаСервереБезКонтекста
Функция СнятьСУтвержденияНаСервере(Идентификатор)

	Возврат ЭАрМ_ОбработкаПодтвержденийЭДО.СнятьСУтверждения("ЭТрН", Идентификатор);

КонецФункции

#КонецОбласти

#Область КодыМаркировки

&НаСервереБезКонтекста
Функция КодыМаркировкиНаСервере(Идентификатор)

	Возврат ЭАрМ_КодыМаркировки.ОтчетЭТрН(Идентификатор);

КонецФункции

#КонецОбласти

#Область СостояниеТитулов

// Пересчитывает сводку титулов выделенных ЭТрН по сохранённому документу.
//
&НаКлиенте
Процедура ОбновитьСостояниеТитулов(Команда)

	Идентификаторы = ВыделенныеИдентификаторы();
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Итог = ОбновитьСостояниеТитуловНаСервере(Идентификаторы);

	Части = Новый Массив;
	Если Итог.Обновлено > 0 Тогда
		Части.Добавить(СтрШаблон(
			НСтр("ru = 'Состояние титулов обновлено: %1'"), Итог.Обновлено));
	КонецЕсли;

	Для Каждого Ошибка Из Итог.Ошибки Цикл
		Части.Добавить(Ошибка);
	КонецЦикла;

	Если Части.Количество() > 0 Тогда
		ПоказатьПредупреждение(, СтрСоединить(Части, Символы.ПС));
	КонецЕсли;

	ОбновитьСписок();

КонецПроцедуры

// Считает сводку титулов по данным документа из регистра: титулы лежат
// в сохранённом узле документа, в СБИС за ними ходить не нужно.
//
// Параметры:
//   Идентификаторы - Массив из Строка - идентификаторы СБИС выделенных строк
//
// Возвращаемое значение:
//   Структура:
//     * Обновлено - Число - сколько записей обновлено
//     * Ошибки   - Массив из Строка - что не обновилось и почему
//
&НаСервереБезКонтекста
Функция ОбновитьСостояниеТитуловНаСервере(Идентификаторы)

	Итог = Новый Структура("Обновлено, Ошибки", 0, Новый Массив);

	Для Каждого Идентификатор Из Идентификаторы Цикл

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_РеестрЭТрН.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
		МенеджерЗаписи.Прочитать();

		Если НЕ МенеджерЗаписи.Выбран() Тогда
			Итог.Ошибки.Добавить(СтрШаблон(
				НСтр("ru = '%1: строка реестра не найдена'"), Идентификатор));
			Продолжить;
		КонецЕсли;

		Если НЕ МенеджерЗаписи.ДанныеПолучены Тогда
			Итог.Ошибки.Добавить(СтрШаблон(
				НСтр("ru = '%1: документ ещё не получен из СБИС'"), Идентификатор));
			Продолжить;
		КонецЕсли;

		Документ = ЭАрМ_ОбщийМодульОбмен.УзелИзJSON(МенеджерЗаписи.ДанныеДокумента);
		Если Документ = Неопределено Тогда
			Итог.Ошибки.Добавить(СтрШаблон(
				НСтр("ru = '%1: данные документа не разбираются'"), Идентификатор));
			Продолжить;
		КонецЕсли;

		МенеджерЗаписи.СостояниеТитулов = Лев(
			ЭАрМ_ОбщийМодульОбмен.СводкаТитуловЭТрН(Документ), 500);
		МенеджерЗаписи.Записать(Истина);

		Итог.Обновлено = Итог.Обновлено + 1;

	КонецЦикла;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Перечитывает список после команды, изменившей данные, и перестраивает
// дерево текущей строки: оно устарело вместе со списком.
//
&НаКлиенте
Процедура ОбновитьСписок()

	ДеревоПостроеноДля = Неопределено;
	Элементы.Список.Обновить();

	// Команда могла поменять признаки УПД (ЕстьЭТрН, отправка ЭТрН): реестр
	// УПД и монитор ЭДО в этом сеансе перечитываются сразу
	Оповестить("ЭАрМ_УПД_Обновление", Неопределено, ЭтотОбъект);

	ОтключитьОбработчикОжидания("Подключаемый_ПостроитьДеревоТоваров");
	ПодключитьОбработчикОжидания("Подключаемый_ПостроитьДеревоТоваров", 0.3, Истина);

КонецПроцедуры

// Идентификатор документа СБИС в текущей строке списка.
//
&НаКлиенте
Функция ИдентификаторТекущейСтроки()

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		СтатусОбмена = НСтр("ru = 'Выберите документ в списке'");
		Возврат "";
	КонецЕсли;

	Возврат ТекущиеДанные.ИдентификаторСБИС;

КонецФункции

// Ответ на вопрос о повторной выгрузке.
//
&НаКлиенте
Процедура СброситьВыгрузкуЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СброситьОтметкуНаСервере(ДополнительныеПараметры.Идентификатор);
	СтатусОбмена = НСтр("ru = 'Отметка о выгрузке снята'");
	ОбновитьСписок();

КонецПроцедуры

// Запускает сеанс обмена фоновым заданием.
//
// Ключ задания не даёт запустить второй ручной обмен, пока идёт первый
// (например, из другого окна реестра).
//
&НаСервереБезКонтекста
Функция ЗапуститьОбменССБИСНаСервере(ИдентификаторФормы)

	Результат = Новый Структура("Операция, Ошибка", Неопределено, "");

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Обмен с СБИС из реестра ЭТрН'");
	ПараметрыВыполнения.КлючФоновогоЗадания = "ЭАрМ_ОбменССБИСРеестрЭТрН";
	ПараметрыВыполнения.СРасширениямиБазыДанных = Истина;

	Попытка
		Результат.Операция = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"ЭАрМ_РегламентныйОбменЭДО.ВыполнитьОбмен");
	Исключение
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Обмен с СБИС не запущен: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Выгружает один документ.
//
&НаСервереБезКонтекста
Функция ВыгрузитьВДалионНаСервере(Идентификатор)

	РезультатВыгрузки = ЭАрМ_РегламентныйОбменЭДО.ВыгрузитьДокумент(Идентификатор);

	Если РезультатВыгрузки.Успех Тогда
		Возврат СтрШаблон(НСтр("ru = 'Выгружено: %1, строк %2, путь %3'"),
			РезультатВыгрузки.ИмяФайла, РезультатВыгрузки.ТоваровВыгружено,
			РезультатВыгрузки.ПутьВыгрузки);
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Ошибка выгрузки: %1'"), РезультатВыгрузки.Ошибка);

КонецФункции

// Перечитывает груз документа.
//
&НаСервереБезКонтекста
Функция ОбновитьТоварыНаСервере(Идентификатор)

	РезультатЧтения = ЭАрМ_РегламентныйОбменЭДО.ОбновитьТоварыДокумента(Идентификатор);

	Если РезультатЧтения.Успех Тогда
		Возврат СтрШаблон(НСтр("ru = 'Строк груза: %1'"), РезультатЧтения.Позиций);
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Груз не прочитан: %1'"), РезультатЧтения.Ошибка);

КонецФункции

// Заполняет дерево связанной цепочки документов и товаров.
//
&НаСервере
Процедура ЗаполнитьДеревоТоваровНаСервере(Идентификатор)

	// Реквизит управляемой формы имеет тип ДанныеФормыДерево, у него нет
	// свойства Строки. Получаем из него обычное ДеревоЗначений, заполняем
	// и возвращаем обратно в реквизит формы.
	ДеревоТоваров = РеквизитФормыВЗначение("Товары");
	ДеревоТоваров.Строки.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭТрН.Номер КАК Номер,
	|	ЭТрН.ИдентификаторУПД КАК ИдентификаторУПД,
	|	ЭТрН.ПредставлениеУПД КАК ПредставлениеУПД,
	|	ЭТрН.НомерДокументаДалион КАК НомерДокументаДалион,
	|	ЭТрН.СтатусДалион КАК СтатусДалион,
	|	ЭТрН.ЕстьРасхождения КАК ЕстьРасхождения,
	|	ЭТрН.РасхожденияДалион КАК РасхожденияДалион,
	|	ЭТрН.КомментарийДалион КАК КомментарийДалион
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	ЭТрН.ИдентификаторСБИС = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ЗначениеВРеквизитФормы(ДеревоТоваров, "Товары");
		СтатусОбмена = НСтр("ru = 'Строка ЭТрН не найдена'");
		Возврат;
	КонецЕсли;

	СтрокаЭТрН = ДеревоТоваров.Строки.Добавить();
	СтрокаЭТрН.Номенклатура = СтрШаблон("ЭТрН № %1", Выборка.Номер);
	СтрокаЭТрН.Документ = "ЭТрН";
	СтрокаЭТрН.Реквизит3 = Идентификатор;

	ИдентификаторУПД = СокрЛП(Выборка.ИдентификаторУПД);
	ПредставлениеУПД = СокрЛП(Выборка.ПредставлениеУПД);
	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		СвязаннаяУПД = ЭАрМ_РегламентныйОбменЭДО.НайтиУПДДляЭТрН(
			Идентификатор, Выборка.Номер);
		ИдентификаторУПД = СвязаннаяУПД.Идентификатор;
		ПредставлениеУПД = СвязаннаяУПД.Представление;
	КонецЕсли;

	СтрокаУПД = Неопределено;
	Если ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		СтрокаУПД = СтрокаЭТрН.Строки.Добавить();
		СтрокаУПД.Номенклатура = ?(ЗначениеЗаполнено(ПредставлениеУПД),
			ПредставлениеУПД, "Связанная УПД");
		СтрокаУПД.Документ = "УПД";
		СтрокаУПД.Реквизит3 = ИдентификаторУПД;
	КонецЕсли;

	ТоварыУПД = ПолучитьТоварыИсточникаДляДерева(
		ИдентификаторУПД);
	Если ЗначениеЗаполнено(ИдентификаторУПД)
		И ТоварыУПД.Количество() = 0
		И ЭАрМ_РегламентныйОбменЭДО.ДогрузитьТоварыУПД(
			ИдентификаторУПД, Выборка.Номер) Тогда
		ТоварыУПД = ПолучитьТоварыИсточникаДляДерева(
			ИдентификаторУПД);
	КонецЕсли;

	ТоварыЭТрН = ПолучитьТоварыЭТрНДляДерева(Идентификатор);
	ТоварыБазы2 = ПолучитьТоварыБазы2ДляДерева(Идентификатор);
	ИспользованныеДляУПД = Новый Соответствие;
	ИспользованныеДляЭТрН = Новый Соответствие;

	Если СтрокаУПД <> Неопределено Тогда
		ДобавитьТоварыИсточникаВДерево(СтрокаУПД, ТоварыУПД,
			"Товар УПД", ТоварыБазы2, ИспользованныеДляУПД);
	КонецЕсли;

	// Товары самой ЭТрН показываем отдельной веткой сразу после УПД.
	Если ТоварыЭТрН.Количество() > 0 Тогда
		ГруппаТоваровЭТрН = СтрокаЭТрН.Строки.Добавить();
		ГруппаТоваровЭТрН.Номенклатура = "Товары ЭТрН";
		ГруппаТоваровЭТрН.Документ = "ЭТрН";
		ГруппаТоваровЭТрН.Реквизит3 = Идентификатор;
		ДобавитьТоварыИсточникаВДерево(ГруппаТоваровЭТрН, ТоварыЭТрН,
			"Товар ЭТрН", ТоварыБазы2, ИспользованныеДляЭТрН);
	КонецЕсли;

	// Документ Далиона - отдельная вложенная ветка после исходных товаров.
	Если ЗначениеЗаполнено(Выборка.НомерДокументаДалион)
		ИЛИ ЗначениеЗаполнено(Выборка.СтатусДалион)
		ИЛИ ТоварыБазы2.Количество() > 0
		ИЛИ Выборка.ЕстьРасхождения Тогда

		СтрокаДалион = СтрокаЭТрН.Строки.Добавить();
		СтрокаДалион.Номенклатура = ?(
			ЗначениеЗаполнено(Выборка.НомерДокументаДалион),
			СтрШаблон("Приходная накладная № %1",
				Выборка.НомерДокументаДалион),
			"Документ Далиона");
		СтрокаДалион.Документ = "Далион";
		СтрокаДалион.Реквизит3 = Выборка.СтатусДалион;

		Для Каждого ТоварБазы2 Из ТоварыБазы2 Цикл
			СтрокаФакта = СтрокаДалион.Строки.Добавить();
			СтрокаФакта.Номенклатура = ТоварБазы2.Наименование;
			СтрокаФакта.Документ = "Товар Далиона";
			СтрокаФакта.Количество = Строка(ТоварБазы2.Количество);
			СтрокаФакта.ЦенаДалион = Строка(ТоварБазы2.Цена);
		КонецЦикла;

		Если Выборка.ЕстьРасхождения Тогда
			ГруппаРасхождений = СтрокаДалион.Строки.Добавить();
			ГруппаРасхождений.Номенклатура = "Расхождения";
			ГруппаРасхождений.Документ = "Контроль";
			ГруппаРасхождений.Реквизит3 = "Есть расхождения";

			ТекстРасхождений = Выборка.РасхожденияДалион;
			Если НЕ ЗначениеЗаполнено(ТекстРасхождений) Тогда
				ТекстРасхождений = Выборка.КомментарийДалион;
			КонецЕсли;

			Для Каждого ТекстРасхождения Из СтрРазделить(
				ТекстРасхождений, Символы.ПС, Ложь) Цикл
				Если НЕ ЗначениеЗаполнено(СокрЛП(ТекстРасхождения)) Тогда
					Продолжить;
				КонецЕсли;
				СтрокаРасхождения = ГруппаРасхождений.Строки.Добавить();
				СтрокаРасхождения.Номенклатура =
					СокрЛП(ТекстРасхождения);
				СтрокаРасхождения.Документ = "Расхождение";
			КонецЦикла;
		КонецЕсли;

	КонецЕсли;

	СтатусОбмена = СтрШаблон(
		НСтр("ru = 'Цепочка загружена: УПД %1, ЭТрН %2, Далион %3'"),
		ТоварыУПД.Количество(), ТоварыЭТрН.Количество(),
		ТоварыБазы2.Количество());
	ЗначениеВРеквизитФормы(ДеревоТоваров, "Товары");

КонецПроцедуры

// Добавляет товарные строки источника и подставляет цену сопоставленной
// строки Далиона в соседнюю колонку.
//
&НаСервереБезКонтекста
Процедура ДобавитьТоварыИсточникаВДерево(
		Родитель, ТоварыИсточника, ВидСтроки,
		ТоварыБазы2, ИспользованныеСтрокиБазы2)

	Для Каждого ТоварИсточника Из ТоварыИсточника Цикл

		СтрокаТовара = Родитель.Строки.Добавить();
		СтрокаТовара.Номенклатура = ТоварИсточника.Наименование;
		СтрокаТовара.Документ = ВидСтроки;
		СтрокаТовара.Реквизит3 = ТоварИсточника.ИсточникТоваров;
		СтрокаТовара.Количество = Строка(ТоварИсточника.Количество);
		СтрокаТовара.ЦенаУпд = Строка(ТоварИсточника.Цена);

		ТоварБазы2 = НайтиТоварБазы2ДляДерева(
			ТоварыБазы2, ТоварИсточника, ИспользованныеСтрокиБазы2);
		Если ТоварБазы2 <> Неопределено Тогда
			СтрокаТовара.ЦенаДалион = Строка(ТоварБазы2.Цена);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Строки связанной УПД.
//
&НаСервереБезКонтекста
Функция ПолучитьТоварыИсточникаДляДерева(
		ИдентификаторУПД)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.Наименование КАК Наименование,
	|	Товары.КодНоменклатуры КАК КодНоменклатуры,
	|	Товары.Артикул КАК Артикул,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.ИсточникТоваров КАК ИсточникТоваров
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &ИдентификаторУПД
	|	И Товары.ИсточникТоваров = &ИсточникУПД
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерПозиции";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);
	Запрос.УстановитьПараметр("ИсточникУПД", "УПД");

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

