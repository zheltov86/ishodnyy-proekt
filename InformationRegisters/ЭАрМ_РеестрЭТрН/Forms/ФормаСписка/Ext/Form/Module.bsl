// Подбирает строку Базы2 по нормализованному наименованию.
//
&НаСервереБезКонтекста
Функция НайтиТоварБазы2ДляДерева(
		ТоварыБазы2, ТоварИсточника, ИспользованныеСтроки)

	Для Каждого ТоварБазы2 Из ТоварыБазы2 Цикл
		КлючСтроки = Строка(ТоварБазы2.НомерПозиции);
		Если ИспользованныеСтроки.Получить(КлючСтроки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ТоварыСоответствуютДляДерева(
			ТоварИсточника, ТоварБазы2) Тогда
			Продолжить;
		КонецЕсли;

		ИспользованныеСтроки.Вставить(КлючСтроки, Истина);
		Возврат ТоварБазы2;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Приоритет сопоставления: код, артикул, затем очищенное наименование.
//
&НаСервереБезКонтекста
Функция ТоварыСоответствуютДляДерева(ТоварИсточника, ТоварБазы2)

	// Артикул одинаков для поставщика и получателя. Если оба артикула
	// заполнены, несовпадение означает разные позиции даже при одном названии.
	Если ЗначениеЗаполнено(ТоварИсточника.Артикул)
		И ЗначениеЗаполнено(ТоварБазы2.Артикул) Тогда
		Возврат ВРег(СокрЛП(ТоварИсточника.Артикул)) =
			ВРег(СокрЛП(ТоварБазы2.Артикул));
	КонецЕсли;

	// Коды в двух базах могут различаться, поэтому совпавший код является
	// точным признаком, а несовпавший не запрещает проверку по названию.
	Если ЗначениеЗаполнено(ТоварИсточника.КодНоменклатуры)
		И ЗначениеЗаполнено(ТоварБазы2.КодНоменклатуры)
		И ВРег(СокрЛП(ТоварИсточника.КодНоменклатуры)) =
			ВРег(СокрЛП(ТоварБазы2.КодНоменклатуры)) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЭАрМ_СверкаТоваровЦепочки.НаименованияСовпадают(
		ТоварИсточника.Наименование, ТоварБазы2.Наименование);

КонецФункции

// Собирает JSON без отправки.
//
&НаСервереБезКонтекста
Функция ПодготовитьJSONНаСервере(Идентификатор)

	Результат = Новый Структура("Статус, ТекстJSON, ИмяФайла", "", "", "");

	Подготовка = ЭАрМ_РегламентныйОбменЭДО.ПодготовитьJSON(Идентификатор);

	Если НЕ Подготовка.Успех Тогда
		Результат.Статус = СтрШаблон(НСтр("ru = 'JSON не собран: %1'"), Подготовка.Ошибка);
		Возврат Результат;
	КонецЕсли;

	Результат.ТекстJSON = Подготовка.ТекстJSON;
	Результат.ИмяФайла  = Подготовка.ИмяФайла;
	Результат.Статус    = СтрШаблон(НСтр("ru = 'Собран %1, строк товаров: %2'"),
		Подготовка.ИмяФайла, Подготовка.ТоваровВыгружено);

	Возврат Результат;

КонецФункции

