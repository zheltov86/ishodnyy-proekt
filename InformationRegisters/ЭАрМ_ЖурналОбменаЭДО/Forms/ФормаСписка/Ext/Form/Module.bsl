////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// Живой журнал обмена ЭДО.
//
// Обмен идёт в фоне - регламентным заданием и подписками, - поэтому оповестить
// открытую форму из кода обмена нечем: ОповеститьОбИзменении живёт на клиенте,
// а фоновое задание до клиента не дотягивается. Единственный рабочий способ -
// тот же, что в типовых списках УТ: динамический список с включённым
// автообновлением. Платформа сама перечитывает его раз в N секунд и делает это
// дёшево - только видимую часть.
//
// Период задан свойством таблицы Список (AutoRefreshPeriod, 10 секунд).
// Здесь - только сортировка свежим вверх, подсветка ошибок и два быстрых
// отбора, которыми обычно и пользуются.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Журнал читают сверху вниз: свежая запись должна быть первой.
	Список.Порядок.Элементы.Очистить();
	ЭлементПорядка = Список.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных("Период");
	ЭлементПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
	ЭлементПорядка.Использование = Истина;

	НастроитьПодсветкуОшибок();

	ОбновитьЗаголовок();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Показать только неуспешные операции и обратно.
//
// Состояние переключателя хранит сам отбор списка: отдельный реквизит формы
// для этого не нужен, а отбор переживает и обновление списка, и его настройку
// пользователем.
//
&НаКлиенте
Процедура ТолькоОшибки(Команда)

	ПереключитьОтборОшибокНаСервере();

КонецПроцедуры

// Ограничить журнал последним часом и обратно.
//
&НаКлиенте
Процедура ЗаПоследнийЧас(Команда)

	ПереключитьОтборПериодаНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПереключитьОтборОшибокНаСервере()

	ЭлементОтбора = ЭлементОтбораПоПолю("Успех");

	Если ЭлементОтбора = Неопределено Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Успех");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Ложь;
		ЭлементОтбора.Использование  = Истина;
	Иначе
		Список.Отбор.Элементы.Удалить(ЭлементОтбора);
	КонецЕсли;

	ОбновитьЗаголовок();

КонецПроцедуры

&НаСервере
Процедура ПереключитьОтборПериодаНаСервере()

	ЭлементОтбора = ЭлементОтбораПоПолю("Период");

	Если ЭлементОтбора = Неопределено Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Период");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
		ЭлементОтбора.ПравоеЗначение = ТекущаяДатаСеанса() - 3600;
		ЭлементОтбора.Использование  = Истина;
	Иначе
		Список.Отбор.Элементы.Удалить(ЭлементОтбора);
	КонецЕсли;

	ОбновитьЗаголовок();

КонецПроцедуры

// Элемент отбора динамического списка по имени поля или Неопределено.
//
&НаСервере
Функция ЭлементОтбораПоПолю(ИмяПоля)

	Для Каждого Элемент Из Список.Отбор.Элементы Цикл

		Если ТипЗнч(Элемент) <> Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;

		Если Строка(Элемент.ЛевоеЗначение) = ИмяПоля Тогда
			Возврат Элемент;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Неуспешные записи - красным. Оформление задаётся кодом, а не настройками
// списка: так его видно в исходниках и оно не теряется при переносе формы.
//
&НаСервере
Процедура НастроитьПодсветкуОшибок()

	Список.УсловноеОформление.Элементы.Очистить();

	ЭлементОформления = Список.УсловноеОформление.Элементы.Добавить();

	ОтборОформления = ЭлементОформления.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборОформления.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Успех");
	ОтборОформления.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборОформления.ПравоеЗначение = Ложь;
	ОтборОформления.Использование  = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	ЭлементОформления.Использование = Истина;

КонецПроцедуры

// Заголовок показывает, что список живой и какие отборы сейчас стоят.
//
&НаСервере
Процедура ОбновитьЗаголовок()

	Уточнения = Новый Массив;
	// Период задан свойством таблицы Список в форме (AutoRefreshPeriod).
	// Здесь он только называется - читать свойство ради подписи незачем.
	Уточнения.Добавить(НСтр("ru = 'обновляется автоматически'"));

	Если ЭлементОтбораПоПолю("Успех") <> Неопределено Тогда
		Уточнения.Добавить(НСтр("ru = 'только ошибки'"));
	КонецЕсли;

	Если ЭлементОтбораПоПолю("Период") <> Неопределено Тогда
		Уточнения.Добавить(НСтр("ru = 'за последний час'"));
	КонецЕсли;

	Заголовок = СтрШаблон(НСтр("ru = 'Журнал обмена ЭДО (%1)'"),
		СтрСоединить(Уточнения, ", "));

КонецПроцедуры

#КонецОбласти
