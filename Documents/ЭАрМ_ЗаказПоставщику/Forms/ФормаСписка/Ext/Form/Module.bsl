&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПодсветитьСтатус("Не совпала", Новый Цвет(255, 224, 224), Новый Цвет(140, 0, 0));
	ПодсветитьСтатус("Внимание", Новый Цвет(255, 224, 224), Новый Цвет(140, 0, 0));
	ПодсветитьСтатус("Все сошлось", Новый Цвет(220, 255, 220), Новый Цвет(0, 100, 0));
	ПодсветитьСтатус("Отправлен", Новый Цвет(220, 255, 220), Новый Цвет(0, 100, 0));
	ПодсветитьСтатус("Готов к отправке", Новый Цвет(255, 248, 210), Новый Цвет(120, 80, 0));

КонецПроцедуры

&НаСервере
Процедура ПодсветитьСтатус(Статус, ЦветФона, ЦветТекста)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	Поле = ЭлементОформления.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("Список");
	Поле.Использование = Истина;

	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.СтатусОтображения");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Статус;
	Отбор.Использование  = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);

КонецПроцедуры
