&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Товары УПД только показываются: это копия строк из реестра УПД,
	// правка здесь никуда бы не записалась
	Элементы.ТоварыУПД.ТолькоПросмотр = Истина;

	ЗаполнитьСвязанныеСтраницы();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ЗаполнитьСвязанныеСтраницы();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСвязанныеСтраницы()

	Данные = ЭАрМ_ДокументыЗакупки.ДанныеСвязанныхСтраниц(
		Объект.ИдентификаторУПД, Объект.ИдентификаторЭТрН);

	ТоварыЭТрН.Загрузить(Данные.ТоварыЭТрН);
	РасхожденияУКД.Загрузить(Данные.РасхожденияУКД);
	ТоварыУПД.Загрузить(Данные.ТоварыУПД);
	СведенияУПД = Данные.СведенияУПД;

	ПодсветитьНесошедшиесяСтроки(Данные.ТоварыУПД);

	ПоказатьИтоги("Товары",     Объект.Товары, "Товары");
	ПоказатьИтоги("ТоварыУПД",  ТоварыУПД,     "УПД");
	ПоказатьИтоги("ТоварыЭТрН", ТоварыЭТрН,    "ЭТрН");

КонецПроцедуры

// Красит строки приходной и УПД, которые по итогу сверки цепочки не сошлись:
// количество, цена, строка только в приходе или только в УПД. Итог берётся
// из реестра товаров - там сверка записала, какие строки вошли в линию.
// Номер строки приходной - номер товара в пакете Далиона (см.
// ЭАрМ_ДокументыЗакупки.ЗаполнитьТоварыИзПакета).
//
// Параметры:
//   ИсходныеТоварыУПД - ТаблицаЗначений - строки УПД с НомерПозиции, в том же
//                       порядке, что и таблица формы ТоварыУПД
//
&НаСервере
Процедура ПодсветитьНесошедшиесяСтроки(ИсходныеТоварыУПД)

	Несошедшиеся = ЭАрМ_РеестрТоваровЗаказов.НесошедшиесяСтроки(Объект.ИдентификаторПоступления);

	ЕстьНомерПозиции = ИсходныеТоварыУПД.Колонки.Найти("НомерПозиции") <> Неопределено;
	Для Индекс = 0 По Мин(ТоварыУПД.Количество(), ИсходныеТоварыУПД.Количество()) - 1 Цикл
		Позиция = ?(ЕстьНомерПозиции, Формат(ИсходныеТоварыУПД[Индекс].НомерПозиции, "ЧГ=0"), "");
		ТоварыУПД[Индекс].Расходится = Несошедшиеся.ПозицииУПД.Получить(Позиция) <> Неопределено;
	КонецЦикла;

	НомераСтрок = Новый СписокЗначений;
	Для Каждого КлючЗначение Из Несошедшиеся.СтрокиПН Цикл
		Попытка
			НомераСтрок.Добавить(Число(КлючЗначение.Ключ));
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;

	// Номера строк меняются от документа к документу: прежнее оформление
	// снимаем и ставим заново
	Метка = "НесошедшиесяСтрокиСверки";
	Прежние = Новый Массив;
	Для Каждого Элемент Из УсловноеОформление.Элементы Цикл
		Если Элемент.Представление = Метка Тогда
			Прежние.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Прежние Цикл
		УсловноеОформление.Элементы.Удалить(Элемент);
	КонецЦикла;

	Если НомераСтрок.Количество() > 0 Тогда
		ЭлементПрихода = УсловноеОформление.Элементы.Добавить();
		ЭлементПрихода.Представление = Метка;
		ПолеПрихода = ЭлементПрихода.Поля.Элементы.Добавить();
		ПолеПрихода.Поле = Новый ПолеКомпоновкиДанных("Товары");
		ОтборПрихода = ЭлементПрихода.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборПрихода.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.Товары.НомерСтроки");
		ОтборПрихода.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
		ОтборПрихода.ПравоеЗначение = НомераСтрок;
		ОтборПрихода.Использование  = Истина;
		УстановитьКрасноеОформление(ЭлементПрихода);
	КонецЕсли;

	ЭлементУПД = УсловноеОформление.Элементы.Добавить();
	ЭлементУПД.Представление = Метка;
	ПолеУПД = ЭлементУПД.Поля.Элементы.Добавить();
	ПолеУПД.Поле = Новый ПолеКомпоновкиДанных("ТоварыУПД");
	ОтборУПД = ЭлементУПД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУПД.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ТоварыУПД.Расходится");
	ОтборУПД.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборУПД.ПравоеЗначение = Истина;
	ОтборУПД.Использование  = Истина;
	УстановитьКрасноеОформление(ЭлементУПД);

КонецПроцедуры

// Тот же красный, что у расхождений в реестре УПД.
//
&НаСервере
Процедура УстановитьКрасноеОформление(ЭлементОформления)

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 224, 224));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(140, 0, 0));

КонецПроцедуры

// Итоги в подвале таблицы товаров: число позиций, количество, сумма и НДС.
//
// Цена не суммируется - сумма цен ничего не значит. Подвал нужен, чтобы без
// калькулятора сравнить приходную, УПД и ЭТрН между собой.
//
// Параметры:
//   ИмяТаблицы - Строка - имя таблицы формы
//   Коллекция  - ДанныеФормыКоллекция - её строки
//   Префикс    - Строка - начало имён колонок таблицы на форме
//
&НаСервере
Процедура ПоказатьИтоги(ИмяТаблицы, Коллекция, Префикс)

	Элементы[ИмяТаблицы].Подвал = Истина;

	ПолеНоменклатуры = Элементы.Найти(Префикс + "Номенклатура");
	Если ПолеНоменклатуры <> Неопределено Тогда
		ПолеНоменклатуры.ТекстПодвала = СтрШаблон(
			НСтр("ru = 'Итого, позиций: %1'"), Коллекция.Количество());
	КонецЕсли;

	ФорматыИтогов = Новый Структура;
	ФорматыИтогов.Вставить("Количество", "ЧДЦ=3; ЧРГ=' '; ЧН=0");
	ФорматыИтогов.Вставить("Сумма",      "ЧДЦ=2; ЧРГ=' '; ЧН=0");
	ФорматыИтогов.Вставить("СуммаНДС",   "ЧДЦ=2; ЧРГ=' '; ЧН=0");

	Для Каждого ОписаниеИтога Из ФорматыИтогов Цикл

		// У таблицы ЭТрН колонки НДС нет - такую колонку просто пропускаем
		Поле = Элементы.Найти(Префикс + ОписаниеИтога.Ключ);
		Если Поле = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Итог = 0;
		Для Каждого СтрокаТовара Из Коллекция Цикл
			Итог = Итог + СтрокаТовара[ОписаниеИтога.Ключ];
		КонецЦикла;

		Поле.ТекстПодвала = Формат(Итог, ОписаниеИтога.Значение);

	КонецЦикла;

КонецПроцедуры
