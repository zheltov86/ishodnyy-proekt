// Параметры сеанса расширения. ЭАрМ_БезОчереди - «запись идёт из задания очереди
// событий»: по умолчанию Ложь, Истина ставит само задание ЭАрМ_ОбработкаОчереди.
//
Процедура УстановкаПараметровСеанса(ИменаПараметровСеанса)

	Если ИменаПараметровСеанса = Неопределено
		ИЛИ ИменаПараметровСеанса.Найти("ЭАрМ_БезОчереди") <> Неопределено Тогда
		ПараметрыСеанса.ЭАрМ_БезОчереди = Ложь;
	КонецЕсли;

