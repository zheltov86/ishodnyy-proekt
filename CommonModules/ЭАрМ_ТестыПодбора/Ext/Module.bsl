#Область Вспомогательные

// Проверка одного утверждения.
//
Процедура Проверить(Ошибки, ИмяПроверки, Факт, Ожидание)
	
	Если Факт <> Ожидание Тогда
		Ошибки.Добавить(СтрШаблон("  ✗ %1: ожидалось «%2», получено «%3»",
			ИмяПроверки, Ожидание, Факт));
	КонецЕсли;
	
КонецПроцедуры

// Результат одного теста.
//
Функция РезультатТеста(Ошибки)
	
	Возврат Новый Структура("Успех, Ошибки", Ошибки.Количество() = 0, Ошибки);
	
КонецФункции

// Прогон одного теста и учёт результата.
//
Процедура ПрогнатьТест(Итог, ИмяТеста, Результат)
	
	Если Результат.Успех Тогда
		Итог.Пройдено = Итог.Пройдено + 1;
	Иначе
		Итог.Провалено = Итог.Провалено + 1;
		Для Каждого Ошибка Из Результат.Ошибки Цикл
			Итог.Ошибки.Добавить(ИмяТеста + ":" + Символы.ПС + Ошибка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
