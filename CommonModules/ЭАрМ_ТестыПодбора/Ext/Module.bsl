// Тест: Двойной прогон — режим ТолькоЛог возвращает статус.
//
Функция Тест_ДвойнойПрогон_Режим()
	
	Ошибки = Новый Массив;
	
	Строка = Новый Структура;
	Строка.Вставить("Штрихкод", "");
	Строка.Вставить("КодТовара", "");
	Строка.Вставить("Наименование", "Несуществующий товар 12345");
	Строка.Вставить("ИННПоставщика", "");
	Строка.Вставить("Категория", "");
	
	Результат = ЭАрМ_ПодборНоменклатуры.НайтиТовар(Строка, "ТолькоЛог");
	
