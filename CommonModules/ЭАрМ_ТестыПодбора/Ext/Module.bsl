// Тесты модуля ЭАрМ_ПодборНоменклатуры (фасад + двойной прогон).
// Запуск: ЭАрМ_ТестыПодбора.ПрогнатьВсе()
// Результат: Структура {Пройдено, Провалено, Ошибки[]}

#Область ПрограммныйИнтерфейс

// Прогон всех тестов. Возвращает итог.
//
Функция ПрогнатьВсе() Экспорт
	
	Итог = Новый Структура("Пройдено, Провалено, Ошибки", 0, 0, Новый Массив);
	
	// Утилиты
	ПрогнатьТест(Итог, "Тест_ТолькоЦифры", Тест_ТолькоЦифры());
	ПрогнатьТест(Итог, "Тест_КаноническийШтрихкод", Тест_КаноническийШтрихкод());
	ПрогнатьТест(Итог, "Тест_ВариантыШтрихкода", Тест_ВариантыШтрихкода());
	ПрогнатьТест(Итог, "Тест_НормализоватьИмя", Тест_НормализоватьИмя());
	ПрогнатьТест(Итог, "Тест_КлючЗаписиШтрихкода", Тест_КлючЗаписиШтрихкода());
	
	// Вес и токены
	ПрогнатьТест(Итог, "Тест_РазобратьИмяСВесом", Тест_РазобратьИмяСВесом());
	ПрогнатьТест(Итог, "Тест_ТокеныИмени", Тест_ТокеныИмени());
	ПрогнатьТест(Итог, "Тест_ДоляПересеченияТокенов", Тест_ДоляПересеченияТокенов());
	
	// Каскад и пакеты
	ПрогнатьТест(Итог, "Тест_НайтиТовар_Структура", Тест_НайтиТовар_Структура());
	ПрогнатьТест(Итог, "Тест_НайтиПарыПакетом", Тест_НайтиПарыПакетом());
	
	// Двойной прогон
	ПрогнатьТест(Итог, "Тест_ДвойнойПрогон_Режим", Тест_ДвойнойПрогон_Режим());
	
	Возврат Итог;
	
КонецФункции

// Запуск одного теста по имени.
//
Функция ПрогнатьОдин(ИмяТеста) Экспорт
	
	Итог = Новый Структура("Пройдено, Провалено, Ошибки", 0, 0, Новый Массив);
	Результат = Вычислить(ИмяТеста + "()");
	ПрогнатьТест(Итог, ИмяТеста, Результат);
	Возврат Итог;
	
КонецФункции

#КонецОбласти

#Область ТестыУтилит

// Тест: ТолькоЦифры — извлечение цифр из строки.
//
Функция Тест_ТолькоЦифры()
	
	Ошибки = Новый Массив;
	
	// Обычный случай
	Проверить(Ошибки, "Буквы+цифры",
		ЭАрМ_ПодборНоменклатуры.ТолькоЦифры("abc123def456"), "123456");
	
	// Только буквы
	Проверить(Ошибки, "Только буквы",
		ЭАрМ_ПодборНоменклатуры.ТолькоЦифры("abc"), "");
	
	// Пустая строка
	Проверить(Ошибки, "Пустая строка",
		ЭАрМ_ПодборНоменклатуры.ТолькоЦифры(""), "");
	
	// Неопределено
	Проверить(Ошибки, "Неопределено",
		ЭАрМ_ПодборНоменклатуры.ТолькоЦифры(Неопределено), "");
	
	// Null
	Проверить(Ошибки, "Null",
		ЭАрМ_ПодборНоменклатуры.ТолькоЦифры(Null), "");
	
	// Несколько через ";" — берётся первый
	Проверить(Ошибки, "Точка с запятой",
		ЭАрМ_ПодборНоменклатуры.ТолькоЦифры("123;456"), "123");
	
	// Число
	Проверить(Ошибки, "Число",
		ЭАрМ_ПодборНоменклатуры.ТолькоЦифры(12345), "12345");
	
	Возврат РезультатТеста(Ошибки);
	
КонецФункции

// Тест: КаноническийШтрихкод — нормализация EAN-13 / GTIN-14 / GS1.
//
Функция Тест_КаноническийШтрихкод()
	
	Ошибки = Новый Массив;
	
	// EAN-13 (13 цифр) — без изменений
	Проверить(Ошибки, "EAN-13",
		ЭАрМ_ПодборНоменклатуры.КаноническийШтрихкод("4600000000000"), "4600000000000");
	
	// UPC-A (12 цифр) → EAN-13 с ведущим нулём
	Проверить(Ошибки, "UPC-A → EAN-13",
		ЭАрМ_ПодборНоменклатуры.КаноническийШтрихкод("012345678905"), "012345678905");
	
	// GTIN-14 с ведущим нулём → EAN-13
	Проверить(Ошибки, "GTIN-14 → EAN-13",
		ЭАрМ_ПодборНоменклатуры.КаноническийШтрихкод("04600000000000"), "4600000000000");
	
	// GS1 AI 01 (код маркировки с префиксом)
	Проверить(Ошибки, "GS1 AI 01",
		ЭАрМ_ПодборНоменклатуры.КаноническийШтрихкод("010460000000000031035"), "4600000000003");
	
	// Пустая строка
	Проверить(Ошибки, "Пустая",
		ЭАрМ_ПодборНоменклатуры.КаноническийШтрихкод(""), "");
	
	// С мусором
	Проверить(Ошибки, "С мусором",
		ЭАрМ_ПодборНоменклатуры.КаноническийШтрихкод("460-000-000-000-0"), "4600000000000");
	
	Возврат РезультатТеста(Ошибки);
	
КонецФункции

// Тест: ВариантыШтрихкода — GTIN-14 ↔ EAN-13.
//
Функция Тест_ВариантыШтрихкода()
	
	Ошибки = Новый Массив;
	
	// EAN-13 → два варианта (сам + с ведущим нулём)
	В = ЭАрМ_ПодборНоменклатуры.ВариантыШтрихкода("4600000000000");
	Проверить(Ошибки, "EAN-13: количество", В.Количество(), 2);
	Проверить(Ошибки, "EAN-13: первый", В[0], "4600000000000");
	Проверить(Ошибки, "EAN-13: второй", В[1], "04600000000000");
	
	// GTIN-14 с нулём → два варианта
	В = ЭАрМ_ПодборНоменклатуры.ВариантыШтрихкода("04600000000000");
	Проверить(Ошибки, "GTIN-14: количество", В.Количество(), 2);
	Проверить(Ошибки, "GTIN-14: первый", В[0], "04600000000000");
	Проверить(Ошибки, "GTIN-14: второй", В[1], "4600000000000");
	
	// Два кода через ;
	В = ЭАрМ_ПодборНоменклатуры.ВариантыШтрихкода("111;222");
	Проверить(Ошибки, "Два кода: количество", В.Количество(), 2);
	Проверить(Ошибки, "Два кода: первый", В[0], "111");
	Проверить(Ошибки, "Два кода: второй", В[1], "222");
	
	// Пустая
	В = ЭАрМ_ПодборНоменклатуры.ВариантыШтрихкода("");
	Проверить(Ошибки, "Пустая", В.Количество(), 0);
	
	Возврат РезультатТеста(Ошибки);
	
КонецФункции

// Тест: НормализоватьИмя — Ё→Е, без пунктуации.
//
Функция Тест_НормализоватьИмя()
	
	Ошибки = Новый Массив;
	
	Проверить(Ошибки, "Ё→Е",
		ЭАрМ_ПодборНоменклатуры.НормализоватьИмя("Ёлка"), "ЕЛКА");
	
	Проверить(Ошибки, "Пунктуация",
		ЭАрМ_ПодборНоменклатуры.НормализоватьИмя("Молоко, 3.2%, 1 л"), "МОЛОКО 3 2% 1 Л");
	
	Проверить(Ошибки, "Двойные пробелы",
		ЭАрМ_ПодборНоменклатуры.НормализоватьИмя("Тест  двойной  пробел"), "ТЕСТ ДВОЙНОЙ ПРОБЕЛ");
	
	Проверить(Ошибки, "Пустая",
		ЭАрМ_ПодборНоменклатуры.НормализоватьИмя(""), "");
	
	Проверить(Ошибки, "Скобки и кавычки",
		ЭАрМ_ПодборНоменклатуры.НормализоватьИмя("Вода («Живая»)"), "ВОДА ЖИВАЯ");
	
	Возврат РезультатТеста(Ошибки);
	
КонецФункции

// Тест: КлючЗаписиШтрихкода — канонический ШК + имя.
//
Функция Тест_КлючЗаписиШтрихкода()
	
	Ошибки = Новый Массив;
	
	Ключ = ЭАрМ_ПодборНоменклатуры.КлючЗаписиШтрихкода("4600000000000", "Молоко");
	Проверить(Ошибки, "Базовый", Ключ, "4600000000000|Молоко");
	
	// Канонизация GTIN-14
	Ключ = ЭАрМ_ПодборНоменклатуры.КлючЗаписиШтрихкода("04600000000000", "Молоко");
	Проверить(Ошибки, "GTIN-14 канон", Ключ, "4600000000000|Молоко");
	
	// Пустой ШК
	Ключ = ЭАрМ_ПодборНоменклатуры.КлючЗаписиШтрихкода("", "Молоко");
	Проверить(Ошибки, "Пустой ШК", Ключ, "|Молоко");
	
	Возврат РезультатТеста(Ошибки);
	
КонецФункции

#КонецОбласти

#Область ТестыВесИТокены

// Тест: РазобратьИмяСВесом — парсинг весовых токенов.
//
Функция Тест_РазобратьИмяСВесом()
	
	Ошибки = Новый Массив;
	
	// «Молоко 3.2% 1 л» → вес 1, единица Л
	Ч = ЭАрМ_ПодборНоменклатуры.РазобратьИмяСВесом("МОЛОКО 3.2% 1 Л");
	Проверить(Ошибки, "Молоко: вес", Ч.Вес, "1");
	Проверить(Ошибки, "Молоко: единица", Ч.Единица, "Л");
	
	// «500 г» → вес 500, единица Г
	Ч = ЭАрМ_ПодборНоменклатуры.РазобратьИмяСВесом("ШОКОЛАД 500 Г");
	Проверить(Ошибки, "Шоколад: вес", Ч.Вес, "500");
	Проверить(Ошибки, "Шоколад: единица", Ч.Единица, "Г");
	
	// «3,2%» → процент
	Ч = ЭАрМ_ПодборНоменклатуры.РазобратьИмяСВесом("СМЕТАНА 3,2%");
	Проверить(Ошибки, "Сметана: процент", Ч.Процент, "32");
	Проверить(Ошибки, "Сметана: единица", Ч.Единица, "%");
	
	// Без веса
	Ч = ЭАрМ_ПодборНоменклатуры.РазобратьИмяСВесом("ХЛЕБ БОРОДИНСКИЙ");
	Проверить(Ошибки, "Без веса: вес", Ч.Вес, "");
	
	Возврат РезультатТеста(Ошибки);
	
КонецФункции

// Тест: ТокеныИмени — разбиение на слова без стоп-слов.
//
Функция Тест_ТокеныИмени()
	
	Ошибки = Новый Массив;
	
	Т = ЭАрМ_ПодборНоменклатуры.ТокеныИмени("МОЛОКО ДЛЯ ДЕТЕЙ 1%");
	// Стоп-слова: ДЛЯ → остаются: МОЛОКО, ДЕТЕЙ, 1%
	Проверить(Ошибки, "Количество", Т.Количество(), 3);
	Проверить(Ошибки, "Первый", Т[0], "МОЛОКО");
	
	// Короткие слова (< 2 символов) отбрасываются
	Т = ЭАрМ_ПодборНоменклатуры.ТокеныИмени("Я И ТЫ");
	Проверить(Ошибки, "Короткие", Т.Количество(), 1);
	
	// Пустая
	Т = ЭАрМ_ПодборНоменклатуры.ТокеныИмени("");
	Проверить(Ошибки, "Пустая", Т.Количество(), 0);
	
	Возврат РезультатТеста(Ошибки);
	
КонецФункции

// Тест: ДоляПересеченияТокенов — Jaccard-доля.
//
Функция Тест_ДоляПересеченияТокенов()
	
	Ошибки = Новый Массив;
	
	А = Новый Массив; А.Добавить("МОЛОКО"); А.Добавить("ДЕТСКОЕ");
	Б = Новый Массив; Б.Добавить("МОЛОКО"); Б.Добавить("ДЕТСКОЕ");
	// Полное совпадение: 2/2 = 1.0
	Проверить(Ошибки, "Полное", ЭАрМ_ПодборНоменклатуры.ДоляПересеченияТокенов(А, Б), 1);
	
	В = Новый Массив; В.Добавить("МОЛОКО"); В.Добавить("ШОКОЛАД");
	// 1 пересечение / мин(2,2) = 0.5
	Доля = ЭАрМ_ПодборНоменклатуры.ДоляПересеченияТокенов(А, В);
	Проверить(Ошибки, "Половина", Окр(Доля, 2), 0.5);
	
	// Пустой массив
	Г = Новый Массив;
	Проверить(Ошибки, "Пустой", ЭАрМ_ПодборНоменклатуры.ДоляПересеченияТокенов(А, Г), 0);
	
	Возврат РезультатТеста(Ошибки);
	
КонецФункции

#КонецОбласти

#Область ТестыКаскадИПакеты

// Тест: НайтиТовар — структура результата.
//
Функция Тест_НайтиТовар_Структура()
	
	Ошибки = Новый Массив;
	
	Строка = Новый Структура;
	Строка.Вставить("Штрихкод", "4600000000000");
	Строка.Вставить("КодТовара", "");
	Строка.Вставить("Наименование", "Молоко 3.2%");
	Строка.Вставить("ИННПоставщика", "");
	Строка.Вставить("Категория", "");
	
	Результат = ЭАрМ_ПодборНоменклатуры.НайтиТовар(Строка);
	
	// Проверяем структуру результата
	Проверить(Ошибки, "Есть Номенклатура", Результат.Свойство("Номенклатура"), Истина);
	Проверить(Ошибки, "Есть Score", Результат.Свойство("Score"), Истина);
	Проверить(Ошибки, "Есть Источник", Результат.Свойство("Источник"), Истина);
	Проверить(Ошибки, "Есть Статус", Результат.Свойство("Статус"), Истина);
	Проверить(Ошибки, "Есть Кандидаты", Результат.Свойство("Кандидаты"), Истина);
	Проверить(Ошибки, "Есть Расхождение", Результат.Свойство("Расхождение"), Истина);
	
	// Score в допустимых пределах
	Проверить(Ошибки, "Score >= 0", Результат.Score >= 0, Истина);
	Проверить(Ошибки, "Score <= 1", Результат.Score <= 1, Истина);
	
	Возврат РезультатТеста(Ошибки);
	
КонецФункции

// Тест: НайтиПарыПакетом — пакетное сопоставление.
//
Функция Тест_НайтиПарыПакетом()
	
	Ошибки = Новый Массив;
	
	// Эталон 1: с штрихкодом
	Э1 = Новый Структура("Штрихкод, Наименование, КодТовара", "4600000000000", "Молоко", "");
	// Эталон 2: без штрихкода
	Э2 = Новый Структура("Штрихкод, Наименование, КодТовара", "", "Хлеб бородинский", "");
	
	// Кандидат 1: совпадает по ШК
	К1 = Новый Структура("Штрихкод, Наименование, КодТовара, Использована", "4600000000000", "Молоко детское", "", Ложь);
	// Кандидат 2: совпадает по имени
	К2 = Новый Структура("Штрихкод, Наименование, КодТовара, Использована", "", "Хлеб бородинский", "", Ложь);
	
	Эталоны = Новый Массив; Эталоны.Добавить(Э1); Эталоны.Добавить(Э2);
	Кандидаты = Новый Массив; Кандидаты.Добавить(К1); Кандидаты.Добавить(К2);
	
	Пары = ЭАрМ_ПодборНоменклатуры.НайтиПарыПакетом(Эталоны, Кандидаты);
	
	Проверить(Ошибки, "Количество пар", Пары.Количество(), 2);
	
	Если Пары.Количество() = 2 Тогда
		Проверить(Ошибки, "Пара 1: score", Пары[0].Score, 1.00);
		Проверить(Ошибки, "Пара 1: источник", Пары[0].Источник, "Штрихкод");
		Проверить(Ошибки, "Пара 2: score", Пары[1].Score, 0.90);
		Проверить(Ошибки, "Пара 2: источник", Пары[1].Источник, "Наименование");
	КонецЕсли;
	
	// Кандидаты помечены как использованные
	Проверить(Ошибки, "К1 использована", К1.Использована, Истина);
	Проверить(Ошибки, "К2 использована", К2.Использована, Истина);
	
	Возврат РезультатТеста(Ошибки);
	
КонецФункции

#КонецОбласти

