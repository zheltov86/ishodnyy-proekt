////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_КорректировкиУПД: корректировочные документы (УКД) из СБИС - связь с
// исходной УПД и сверка с приходом Далиона с учётом корректировки.
//
// Приём. УКД приходит тем же реестром СБИС, что и УПД (реестр запрашивается
// за месяц без отбора форматов), но хранится в своём регистре
// ЭАрМ_УКД_Входящий: в списке УПД корректировок нет. Корректировку узнаём по
// имени файла ON_NKORSCHFDOPPR / ON_KORSCHFDOPPR, а если имя не подсказало -
// по XML (таблица ТаблКСчФ), и тогда строка переносится из реестра УПД. У строки
// УКД значения До и После изменения; в ЭАрМ_ТоварыЭТрН с источником "УКД"
// пишутся значения После, а номер позиции - номер строки исходной УПД
// (ПорНомТовВСЧФ, в старых файлах - НомСтр).
//
// Связь. Номер и дата исправляемого счёта-фактуры берутся из XML (СвКСчФ/СчФ)
// вместе со строками. УПД ищется в реестре по номеру, дате (+-3 дня) и ИНН
// контрагента. Из подходящих первой берётся УПД с расхождениями: корректировку
// присылают на разошедшуюся накладную. Итог - ИдентификаторОснования в строке
// УКД. Не нашлась сразу - повторяется шагом регламентного задания цепочки
// (ОбработатьКорректировки); УКД без номера исправляемой УПД этот шаг
// перечитывает из СБИС. Почему связи нет - ПричинаБезСвязи.
//
// Сверка. ЭАрМ_СверкаТоваровЦепочки подменяет строки УПД строками всех её УКД
// по порядку дат: с приходом Далиона сравнивается уже исправленная накладная.
// Строка УКД ищется в УПД по номеру позиции, затем по штрихкоду, затем по имени.
// Итог (РасхожденийНет, текст расхождений) пишется и в УПД, и во все её УКД.
// Расхождений нет — совпадение с приходом по штрихкоду, количеству, цене
// или общей сумме с учётом количества.
// Утвердить УКД можно только если исправленная УПД сошлась с приходом.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Формат, который ЭАрМ_Служебный.ФорматДокументаПоВложениям даёт корректировке.
// Этим же именем корректировки называются в очереди подписания.
//
Функция ФорматКорректировки() Экспорт

	Возврат "УКД";

КонецФункции

// Источник строк корректировки в регистре ЭАрМ_ТоварыЭТрН.
//
Функция ИсточникТоваровКорректировки() Экспорт

	Возврат "УКД";

КонецФункции

// Источник строк возврата поставщику из Далиона (Документ.ВозвратТоваровПоставщику)
// в регистре ЭАрМ_ТоварыЭТрН.
//
Функция ИсточникТоваровВозвратаДалион() Экспорт

	Возврат "ВозвратДалион";

КонецФункции

// Источник строк корректировки поставщика из Далиона
// (Документ.КорректировочныйДокументВходящий) в регистре ЭАрМ_ТоварыЭТрН.
//
Функция ИсточникТоваровКорректировкиДалион() Экспорт

	Возврат "КорректировкаДалион";

КонецФункции

// Идентификатор, под которым строки возврата или корректировки Далиона лежат
// в регистре ЭАрМ_ТоварыЭТрН (измерение ИдентификаторСБИС): «ВозвратДалион:<uid>»
// и «КорректировкаДалион:<uid>». Свой идентификатор, а не УПД: так строки не
// попадают в выборки по УПД, УКД и ЭТрН и не смешиваются со строками «База2».
//
// Параметры:
//   ТипПакета     - Строка - ВозвратПоставщику или КорректировкаПоставщика
//   Идентификатор - Строка - uid документа Далиона
//
// Возвращаемое значение:
//   Строка
//
Функция ИдентификаторСтрокДокументаДалион(ТипПакета, Идентификатор) Экспорт

	Источник = ?(ТипПакета = "ВозвратПоставщику",
		ИсточникТоваровВозвратаДалион(), ИсточникТоваровКорректировкиДалион());

	Возврат Источник + ":" + СокрЛП(Идентификатор);

КонецФункции

// Кладёт строки возврата поставщику или корректировки поставщика из пакета
// Далиона в регистр ЭАрМ_ТоварыЭТрН (источник «ВозвратДалион» /
// «КорректировкаДалион», идентификатор - ИдентификаторСтрокДокументаДалион).
//
// Строки документа перезаписываются целиком: набор по идентификатору документа
// очищается и заполняется заново. Документ, помеченный на удаление в Далионе,
// строк не имеет - прежние убираются. Количество, цена и суммы - значения
// «после»; у корректировки признак изменения (Убрана / Уменьшение / Увеличение /
// БезИзменений) считается по её значениям «до» и «после», у возврата строки
// помечаются «Возврат». Значения «до» остаются в пакете (ЭАрМ_ПакетыДалион).
// Связь с приходной (basis.purchaseInvoice.uid) тоже читается из пакета.
//
// Параметры:
//   ТипПакета - Строка - ВозвратПоставщику или КорректировкаПоставщика
//   Объект    - Соответствие - секция data пакета
//
// Возвращаемое значение:
//   Число - сколько строк записано
//
Функция ЗаписатьСтрокиДокументаДалион(ТипПакета, Объект) Экспорт

	Идентификатор = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Объект, "uid", ""));
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		ВызватьИсключение СтрШаблон("В пакете %1 не заполнен uid", ТипПакета);
	КонецЕсли;

	Если ТипПакета <> "ВозвратПоставщику" И ТипПакета <> "КорректировкаПоставщика" Тогда
		ВызватьИсключение СтрШаблон("Тип пакета ""%1"" не возврат и не корректировка поставщика", ТипПакета);
	КонецЕсли;

	ЭтоВозврат = ТипПакета = "ВозвратПоставщику";
	Источник = ?(ЭтоВозврат, ИсточникТоваровВозвратаДалион(), ИсточникТоваровКорректировкиДалион());
	ИдентификаторСтрок = ИдентификаторСтрокДокументаДалион(ТипПакета, Идентификатор);
	НомерДокумента = Лев(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Объект, "number", "")), 50);
	Удален = ЭАрМ_Служебный.ЗначениеУзла(Объект, "deletionMark", Ложь) = Истина;

	// Откуда строки: номер документа, основание и состояние - в трассу
	ПриходнаяОснования = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеПоПути(Объект,
		?(ЭтоВозврат, "basis.purchaseInvoice.uid", "purchaseInvoice.uid"), ""));
	ЭАрМ_ПриемПакетовДалион.Трасса(Идентификатор, СтрШаблон(
		"Запись: %1 № %2 - строки в ЭАрМ_ТоварыЭТрН (%3), приходная-основание %4, помечен на удаление %5, проведён %6",
		ТипПакета, НомерДокумента, ИдентификаторСтрок, ?(ЗначениеЗаполнено(ПриходнаяОснования), ПриходнаяОснования, "не указана"),
		?(Удален, "да", "нет"), ?(ЭАрМ_Служебный.ЗначениеУзла(Объект, "posted", Ложь) = Истина, "да", "нет")));

	Позиции = Новый Массив;
	Если НЕ Удален Тогда
		ИспользованныеНомера = Новый Соответствие;
		Для Каждого Товар Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "goods")) Цикл
			Позиция = ПозицияДокументаДалион(ЭтоВозврат, Товар, Позиции.Количество() + 1, ИспользованныеНомера);
			Позиции.Добавить(Позиция);
		КонецЦикла;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра("РегистрСведений.ЭАрМ_ТоварыЭТрН", ИдентификаторСтрок);

		НаборЗаписей = РегистрыСведений.ЭАрМ_ТоварыЭТрН.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдентификаторСБИС.Установить(ИдентификаторСтрок);
		НаборЗаписей.Прочитать();
		БылоСтрок = НаборЗаписей.Количество();
		НаборЗаписей.Очистить();

		Для Каждого Позиция Из Позиции Цикл
			ЗаписьТовара = НаборЗаписей.Добавить();
			ЗаписьТовара.ИдентификаторСБИС  = ИдентификаторСтрок;
			ЗаписьТовара.НомерПозиции       = Позиция.НомерПозиции;
			ЗаписьТовара.НомерДокумента     = НомерДокумента;
			ЗаписьТовара.ИсточникТоваров    = Источник;
			ЗаписьТовара.Наименование       = Позиция.Наименование;
			ЗаписьТовара.КодНоменклатуры    = Позиция.КодНоменклатуры;
			ЗаписьТовара.Артикул            = Позиция.Артикул;
			ЗаписьТовара.Штрихкод           = Позиция.Штрихкод;
			ЗаписьТовара.СпособПоискаШК     = ?(ЗначениеЗаполнено(Позиция.Штрихкод), "Далион", "");
			ЗаписьТовара.Количество         = Позиция.Количество;
			ЗаписьТовара.Цена               = Позиция.Цена;
			ЗаписьТовара.Сумма              = Позиция.Сумма;
			ЗаписьТовара.СуммаНДС           = Позиция.СуммаНДС;
			ЗаписьТовара.ПризнакИзменения   = Позиция.ПризнакИзменения;
		КонецЦикла;

		НаборЗаписей.Записать(Истина);

		ЗафиксироватьТранзакцию();

	Исключение

		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(Идентификатор,
			"ЗаписатьСтрокиДокументаДалион (" + ТипПакета + ", строки в ЭАрМ_ТоварыЭТрН не записаны)", ОшибкаИсключения);
		ВызватьИсключение;

	КонецПопытки;

	ЭАрМ_ПриемПакетовДалион.Трасса(Идентификатор, СтрШаблон(
		"Запись: ЭАрМ_ТоварыЭТрН %1 - было строк %2, записано %3",
		ИдентификаторСтрок, БылоСтрок, Позиции.Количество()));

	// Записанное читаем обратно: число строк по документу и первая строка целиком
	ЭАрМ_ПриемПакетовДалион.ПроверитьКоличествоЗапросом(Идентификатор,
		"ЭАрМ_ТоварыЭТрН " + Источник,
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
		|ГДЕ
		|	Товары.ИдентификаторСБИС = &ИдентификаторСБИС
		|	И Товары.ИсточникТоваров = &Источник",
		Новый Структура("ИдентификаторСБИС, Источник", ИдентификаторСтрок, Источник),
		Позиции.Количество());

	Если Позиции.Количество() > 0 Тогда
		Первая = Позиции[0];
		ЭАрМ_ПриемПакетовДалион.ПроверитьЗаписьРегистра(Идентификатор, "ЭАрМ_ТоварыЭТрН",
			Новый Структура("ИдентификаторСБИС, НомерПозиции", ИдентификаторСтрок, Первая.НомерПозиции),
			Новый Структура("ИсточникТоваров, Количество, Штрихкод, ПризнакИзменения",
				Источник, Первая.Количество, Первая.Штрихкод, Первая.ПризнакИзменения));
	КонецЕсли;

	Возврат Позиции.Количество();

КонецФункции

// Шаг регламентного задания цепочки: переносит корректировки, записанные в
// реестр УПД до появления реестра УКД, перечитывает УКД без номера исправляемой
// УПД и связывает с исходными УПД те, что пришли раньше своих УПД или не нашли
// их при загрузке.
//
Процедура ОбработатьКорректировки() Экспорт

	ПеренестиКорректировкиИзРеестраУПД();
	ДогрузитьСтрокиБезОснования();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 200
	|	УКД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УКД.ДатаПоискаОснования КАК ДатаПоискаОснования
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.ИдентификаторОснования = """"
	|	И УКД.НомерОснования <> """"
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УКД") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	УКД.Дата УБЫВ";

	// Исходную УПД, которой нет в реестре, ищем в СБИС по номеру: не больше
	// десяти поисков за проход и не чаще раза в шесть часов на корректировку
	ПоисковВСБИС = 0;
	ГраницаПовтора = ТекущаяДатаСеанса() - 6 * 3600;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИскатьВСБИС = ПоисковВСБИС < 10 И Выборка.ДатаПоискаОснования < ГраницаПовтора;
		Попытка
			//@skip-check query-in-loop
			ИдентификаторУПД = СвязатьСОснованием(Выборка.ИдентификаторСБИС, ИскатьВСБИС);
			Если ИскатьВСБИС И НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
				ПоисковВСБИС = ПоисковВСБИС + 1;
			КонецЕсли;
		Исключение
			ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС, Ложь,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Истина, если документ лежит в реестре корректировок.
//
// Параметры:
//   ИдентификаторСБИС - Строка
//
// Возвращаемое значение:
//   Булево
//
Функция ЕстьВРеестреКорректировок(ИдентификаторСБИС) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторСБИС) Тогда
		Возврат Ложь;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УКД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторСБИС;
	МенеджерЗаписи.Прочитать();

	Возврат МенеджерЗаписи.Выбран();

КонецФункции

// Переносит строку из реестра УПД в реестр корректировок. Если корректировка
// там уже есть, строка УПД просто удаляется. Товары не трогаем: они лежат под
// тем же идентификатором с источником "УКД".
//
// Параметры:
//   ИдентификаторСБИС - Строка
//
// Возвращаемое значение:
//   Булево - Истина, если строка была в реестре УПД
//
Функция ПеренестиВРеестрКорректировок(ИдентификаторСБИС) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторСБИС) Тогда
		Возврат Ложь;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра(
			"РегистрСведений.ЭАрМ_УПД_Входящий", ИдентификаторСБИС);
		ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра(
			"РегистрСведений.ЭАрМ_УКД_Входящий", ИдентификаторСБИС);

		СтрокаУПД = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
		СтрокаУПД.ИдентификаторСБИС = ИдентификаторСБИС;
		СтрокаУПД.Прочитать();

		Если НЕ СтрокаУПД.Выбран() Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;

		СтрокаУКД = РегистрыСведений.ЭАрМ_УКД_Входящий.СоздатьМенеджерЗаписи();
		СтрокаУКД.ИдентификаторСБИС = ИдентификаторСБИС;
		СтрокаУКД.Прочитать();

		// Уже перенесённую корректировку не затираем старой копией из реестра УПД
		Если НЕ СтрокаУКД.Выбран() Тогда
			ЗаполнитьЗначенияСвойств(СтрокаУКД, СтрокаУПД, ПоляРеестраКорректировок());
			СтрокаУКД.ИдентификаторСБИС = ИдентификаторСБИС;
			СтрокаУКД.Записать(Истина);
		КонецЕсли;

		СтрокаУПД.Удалить();

		ЗафиксироватьТранзакцию();

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторСБИС,
			"ПеренестиВРеестрКорректировок (УКД не перенесена в реестр корректировок)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Запоминает реквизиты исходного документа из XML корректировки и ищет
// исходную УПД. Вызывается после записи строк УКД в регистр товаров.
//
// Параметры:
//   ИдентификаторУКД - Строка
//   ТоварыУКД        - Структура - см. ЭАрМ_ОбщийМодульОбмен.НовыйРезультатТоваровУПД
//
Процедура ЗафиксироватьРеквизитыКорректировки(ИдентификаторУКД, ТоварыУКД) Экспорт

	Попытка

		// Имя вложения не выдало корректировку, и строка легла в реестр УПД
		ПеренестиВРеестрКорректировок(ИдентификаторУКД);

		Изменения = Новый Структура;
		Изменения.Вставить("НомерОснования", Лев(СокрЛП(ТоварыУКД.НомерОснования), 50));
		Изменения.Вставить("ДатаОснования",  ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ТоварыУКД.ДатаОснования));

		ИзменитьСтрокуРеестра(ИмяРеестраКорректировок(), ИдентификаторУКД, Изменения);

		Если НЕ ЗначениеЗаполнено(Изменения.НомерОснования) Тогда
			ЗаписатьВЖурнал(ИдентификаторУКД, Ложь, СтрШаблон(
				"В XML корректировки (файл %1) не найден номер исправляемого документа (СвКСчФ/СчФ): связать с УПД не по чему",
				ТоварыУКД.ИмяФайла));
			Возврат;
		КонецЕсли;

		СвязатьСОснованием(ИдентификаторУКД);

	Исключение
		// Строки УКД уже записаны; связь дотянет регламентное задание
		ЗаписатьВЖурнал(ИдентификаторУКД, Ложь,
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Ищет исходную УПД корректировки, записывает связь и отправляет цепочки
// этой УПД на повторную сверку.
//
// Параметры:
//   ИдентификаторУКД     - Строка
//   ИскатьВСБИС          - Булево - нет в реестре УПД: найти в СБИС по номеру и загрузить
//   БезОграниченияПоиска - Булево - искать в СБИС, даже если искали меньше шести часов назад
//
// Возвращаемое значение:
//   Строка - идентификатор исходной УПД; пустая, если не нашлась
//
Функция СвязатьСОснованием(ИдентификаторУКД, ИскатьВСБИС = Ложь, БезОграниченияПоиска = Ложь) Экспорт

	Реквизиты = РеквизитыКорректировки(ИдентификаторУКД);
	Если Реквизиты = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Реквизиты.НомерОснования) Тогда
		Возврат "";
	КонецЕсли;

	ИдентификаторУПД = НайтиИсходнуюУПД(ИдентификаторУКД, Реквизиты);

	// Корректировку часто присылают на УПД старше окна загрузки реестра -
	// такую берём из СБИС по номеру
	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) И ИскатьВСБИС
		И ЗагрузитьИсходнуюУПДИзСБИС(ИдентификаторУКД, Реквизиты, БезОграниченияПоиска) Тогда
		ИдентификаторУПД = НайтиИсходнуюУПД(ИдентификаторУКД, Реквизиты);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат "";
	КонецЕсли;

	Если Реквизиты.ИдентификаторОснования <> ИдентификаторУПД Тогда
		ИзменитьСтрокуРеестра(ИмяРеестраКорректировок(), ИдентификаторУКД,
			Новый Структура("ИдентификаторОснования", ИдентификаторУПД));
		ЗаписатьВЖурнал(ИдентификаторУКД, Истина, СтрШаблон(
			"УКД %1 от %2 связана с УПД %3 от %4", Реквизиты.Номер, Формат(Реквизиты.Дата, "ДЛФ=D"),
			Реквизиты.НомерОснования, Формат(Реквизиты.ДатаОснования, "ДЛФ=D")));
		// Прежняя УПД больше не исправляется этой корректировкой
		Если ЗначениеЗаполнено(Реквизиты.ИдентификаторОснования) Тогда
			ОбновитьПризнакУКД(Реквизиты.ИдентификаторОснования);
			ЭАрМ_ЦепочкаЗакупки.ОтметитьИзменениеУПД(Реквизиты.ИдентификаторОснования);
		КонецЕсли;
	КонецЕсли;

	ИзменитьСтрокуРеестра("ЭАрМ_УПД_Входящий", ИдентификаторУПД,
		Новый Структура("ЕстьУКД", Истина));

	// Исходная УПД теперь сверяется с учётом корректировки
	ЭАрМ_ЦепочкаЗакупки.ОтметитьИзменениеУПД(ИдентификаторУПД);

	Возврат ИдентификаторУПД;

КонецФункции

// Строки всех корректировок УПД в порядке их применения.
//
// Возвращаемое значение:
//   Массив из Структура - ИдентификаторУКД, Номер, Дата, НомерПозиции,
//     Наименование, Штрихкод, Количество, Сумма (после изменения, с НДС)
//
Функция СтрокиКорректировок(ИдентификаторУПД) Экспорт

	Результат = Новый Массив;

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УКД.ИдентификаторСБИС КАК ИдентификаторУКД,
	|	УКД.Номер КАК Номер,
	|	УКД.Дата КАК Дата,
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.Наименование КАК Наименование,
	|	Товары.Штрихкод КАК Штрихкод,
	|	Товары.Количество КАК Количество,
	|	Товары.Сумма КАК Сумма,
	|	Товары.ПризнакИзменения КАК ПризнакИзменения
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ПО УКД.ИдентификаторСБИС = Товары.ИдентификаторСБИС
	|			И (Товары.ИсточникТоваров = &Источник)
	|ГДЕ
	|	УКД.ИдентификаторОснования = &ИдентификаторУПД
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	УКД.ДатаЗагрузки,
	|	ИдентификаторУКД,
	|	НомерПозиции";
	// Две УКД одного дня (дата без времени) - в порядке получения: следующая
	// правит уже исправленное, и порядок по идентификатору СБИС был случайным
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);
	Запрос.УстановитьПараметр("Источник", ИсточникТоваровКорректировки());

	// Дубль корректировки (тот же номер и дата) применяется один раз
	БезДублей = КорректировкиУПД(ИдентификаторУПД);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаУКД = Новый Структура("ИдентификаторУКД, Номер, Дата, НомерПозиции, Наименование, Штрихкод, Количество, Сумма, ПризнакИзменения");
		ЗаполнитьЗначенияСвойств(СтрокаУКД, Выборка);
		СтрокаУКД.ИдентификаторУКД = СокрЛП(СтрокаУКД.ИдентификаторУКД);
		СтрокаУКД.Штрихкод = СокрЛП(СтрокаУКД.Штрихкод);
		Если БезДублей.Найти(СтрокаУКД.ИдентификаторУКД) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(СтрокаУКД);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Корректировки для цепочки документов в форме реестра УПД.
//
// Связанные с УПД идут первыми, в порядке дат: у их строк значения «было»
// берутся из УПД с учётом предыдущих корректировок. Затем корректировки, которые
// по номеру исправляемого документа (или, если номер не прочитан, по ИНН и
// дате) подходят к этой УПД, но не связаны, - с причиной. Такую корректировку
// сначала пробуем связать.
//
// Параметры:
//   ИдентификаторУПД - Строка
//
// Возвращаемое значение:
//   Массив из Структура:
//     * ИдентификаторУКД, Номер, ТекстСверки, Причина - Строка - Причина пуста у связанной
//     * Дата - Дата
//     * Связана, РасхожденийНет, Утверждено - Булево
//     * Строки - Массив из Структура - НомерПозиции, Наименование, Штрихкод,
//       КоличествоДо, ЦенаДо, Количество, Цена, Сумма, Изменение (текст «было -> стало»)
//
Функция КорректировкиДляЦепочки(ИдентификаторУПД) Экспорт

	Результат = Новый Массив;

	РеквизитыУПД = РеквизитыУПД(ИдентификаторУПД);
	Если РеквизитыУПД = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Несвязанные = Новый Массив;

	Для Каждого ИдентификаторУКД Из ПодходящиеНесвязанныеКорректировки(РеквизитыУПД) Цикл

		Попытка
			СвязатьСОснованием(ИдентификаторУКД);
		Исключение
			ЗаписатьВЖурнал(ИдентификаторУКД, Ложь,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;

		Реквизиты = РеквизитыКорректировки(ИдентификаторУКД);
		Если Реквизиты <> Неопределено И Реквизиты.ИдентификаторОснования <> ИдентификаторУПД Тогда
			Несвязанные.Добавить(ОписаниеКорректировкиДляЦепочки(ИдентификаторУКД, Реквизиты,
				ПричинаБезСвязи(ИдентификаторУКД, Реквизиты), СтрокиУПДПоПозициям(ИдентификаторУПД)));
		КонецЕсли;

	КонецЦикла;

	// Каждая следующая корректировка правит уже исправленную накладную
	ТекущиеСтроки = СтрокиУПДПоПозициям(ИдентификаторУПД);

	Для Каждого ИдентификаторУКД Из КорректировкиУПД(ИдентификаторУПД) Цикл
		Результат.Добавить(ОписаниеКорректировкиДляЦепочки(ИдентификаторУКД,
			РеквизитыКорректировки(ИдентификаторУКД), "", ТекущиеСтроки));
	КонецЦикла;

	// Несвязанная копия уже показанной корректировки - дубль, в цепочке не нужна
	Учтенные = Новый Соответствие;
	Для Каждого Описание Из Результат Цикл
		Учтенные.Вставить(КлючКорректировки(Описание.Номер, Описание.Дата), Истина);
	КонецЦикла;

	Для Каждого Описание Из Несвязанные Цикл
		Ключ = КлючКорректировки(Описание.Номер, Описание.Дата);
		Если Учтенные.Получить(Ключ) = Неопределено Тогда
			Учтенные.Вставить(Ключ, Истина);
			Результат.Добавить(Описание);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Пишет итог сверки цепочки в УПД и во все её корректировки.
//
// Параметры:
//   ИдентификаторУПД - Строка
//   РасхожденийНет   - Булево
//   ТекстРасхождений - Строка
//   ЭТрНСошлась      - Булево, Неопределено - приход сошёлся с ЭТрН; Неопределено не меняет галочку
//   ОжидаетУКД       - Булево, Неопределено - в УПД есть товар, которого нет в
//                      приходе, и число позиций не сходится: статус УПД
//                      «Ожидает УКД». Неопределено не меняет этот статус.
//                      Корректировкам статус не ставится - ждёт УКД сама УПД
//   НетВозвратаДалиона - Булево, Неопределено - статус «УКД есть, нет возврата из
//                      Далиона», как ОжидаетУКД (см. ИзменитьСтрокуРеестра)
//
Процедура ЗафиксироватьИтогСверки(ИдентификаторУПД, РасхожденийНет, ТекстРасхождений, ЭТрНСошлась = Неопределено,
	ОжидаетУКД = Неопределено, НетВозвратаДалиона = Неопределено) Экспорт

	// Сверено вручную: человек принял расхождения, и пересверка их обратно
	// не возвращает. Текст сверки остаётся - по нему видно, что именно приняли
	Ручная = СведенияСверкиВручную(ИдентификаторУПД);
	Если Ручная.Сверено И НЕ РасхожденийНет Тогда
		ТекстРасхождений = ТекстСверкиВручную(Ручная.Кем, ТекстРасхождений);
		РасхожденийНет = Истина;
		ОжидаетУКД = Неопределено;
		НетВозвратаДалиона = Неопределено;
	КонецЕсли;

	Изменения = Новый Структура("РасхожденийНет, ТекстСверки", РасхожденийНет,
		Лев(?(ЗначениеЗаполнено(ТекстРасхождений), ТекстРасхождений,
			?(РасхожденийНет, "Сошлось", "")), 1024));
	Если НЕ РасхожденийНет Тогда
		Изменения.Вставить("КОтправке", Ложь);
	КонецЕсли;

	// «К отправке» копируем только если её сняли: сошедшаяся УПД галочку сама не ставит
	ИзмененияКорректировок = Новый Структура("РасхожденийНет, ТекстСверки");
	ЗаполнитьЗначенияСвойств(ИзмененияКорректировок, Изменения);
	Если Изменения.Свойство("КОтправке") Тогда
		ИзмененияКорректировок.Вставить("КОтправке", Изменения.КОтправке);
	КонецЕсли;

	Если ЭТрНСошлась <> Неопределено Тогда
		Изменения.Вставить("ЕстьЭТрН", ЭТрНСошлась);
	КонецЕсли;
	Изменения.Вставить("ЕстьУКД", КорректировкиУПД(ИдентификаторУПД).Количество() > 0);

	// ПЕРЕД записью: что сейчас лежит в строке реестра УПД
	Было = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	Было.ИдентификаторСБИС = ИдентификаторУПД;
	Было.Прочитать();
	Если Было.Выбран() Тогда
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторУПД, СтрШаблон(
			"Сверка: реестр УПД № %1 ПЕРЕД записью итога - было: расхождений нет = %2, статус «%3», текст «%4»; будет: расхождений нет = %5, текст «%6»",
			Было.Номер, Было.РасхожденийНет, Было.СтатусПодписания, Лев(Было.ТекстСверки, 150),
			РасхожденийНет, Лев(Изменения.ТекстСверки, 150)));
	Иначе
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(ИдентификаторУПД, "ЗафиксироватьИтогСверки",
			"строки УПД нет в реестре УПД - итог сверки записать некуда");
	КонецЕсли;

	ИзменитьСтрокуРеестра("ЭАрМ_УПД_Входящий", ИдентификаторУПД, Изменения, ОжидаетУКД, НетВозвратаДалиона);

	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторУПД, СтрШаблон(
		"Сверка: в реестр УПД %1 записано: Расхождений нет = %2, текст «%3»%4%5",
		ИдентификаторУПД, РасхожденийНет, Лев(Изменения.ТекстСверки, 300),
		?(Изменения.Свойство("КОтправке"), ", «К отправке» снято", ""),
		?(Ручная.Сверено, ", сверено вручную", "")), РасхожденийНет);

	// Строку реестра УПД читаем обратно: итог сверки должен лежать в регистре
	ЭАрМ_ПриемПакетовДалион.ПроверитьЗаписьРегистра(ИдентификаторУПД, "ЭАрМ_УПД_Входящий",
		Новый Структура("ИдентификаторСБИС", ИдентификаторУПД),
		Новый Структура("РасхожденийНет, ТекстСверки", РасхожденийНет, Изменения.ТекстСверки));

	Для Каждого ИдентификаторУКД Из КорректировкиУПД(ИдентификаторУПД) Цикл
		ИзменитьСтрокуРеестра(ИмяРеестраКорректировок(), ИдентификаторУКД, ИзмененияКорректировок);
	КонецЦикла;

КонецПроцедуры

// Сколько УКД периода - возвратные. Признака «возврат» на уровне документа в СБИС
// нет (у УПД - отрицательные строки, у УКД - «Убрана» и «Уменьшение» по строкам), поэтому
// возвратной считается УКД, где строки только убирают товар или уменьшают количество
// и нет строк с увеличением и новых.
//
// Параметры:
//   ДатаС, ДатаПо - Дата - по дате УПД-основания; пустая - без границы
//
// Возвращаемое значение:
//   Структура - Возвратных, Всего (Число) - УКД к УПД периода (незакрытые)
//
Функция СчетчикиКорректировок(ДатаС = Неопределено, ДатаПо = Неопределено) Экспорт

	Итог = Новый Структура("Возвратных, Всего", 0, 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УКД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	ЕСТЬNULL(Признаки.Уменьшений, 0) КАК Уменьшений,
	|	ЕСТЬNULL(Признаки.Прочих, 0) КАК Прочих
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО УКД.ИдентификаторОснования = УПД.ИдентификаторСБИС
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Товары.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|			СУММА(ВЫБОР
	|				КОГДА Товары.ПризнакИзменения В (""Убрана"", ""Уменьшение"")
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ) КАК Уменьшений,
	|			СУММА(ВЫБОР
	|				КОГДА Товары.ПризнакИзменения В (""Увеличение"", ""Новая"")
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ) КАК Прочих
	|		ИЗ
	|			РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ГДЕ
	|			Товары.ПризнакИзменения <> """"
	|		СГРУППИРОВАТЬ ПО
	|			Товары.ИдентификаторСБИС) КАК Признаки
	|		ПО УКД.ИдентификаторСБИС = Признаки.ИдентификаторСБИС
	|ГДЕ
	|	(&БезНачала ИЛИ УПД.Дата >= &ДатаС)
	|	И (&БезКонца ИЛИ УПД.Дата <= &ДатаПо)
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УКД");
	Запрос.УстановитьПараметр("БезНачала", НЕ ЗначениеЗаполнено(ДатаС));
	Запрос.УстановитьПараметр("ДатаС", НачалоДня(ДатаС));
	Запрос.УстановитьПараметр("БезКонца", НЕ ЗначениеЗаполнено(ДатаПо));
	Запрос.УстановитьПараметр("ДатаПо", КонецДня(ДатаПо));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Итог.Всего = Итог.Всего + 1;
		Если Выборка.Уменьшений > 0 И Выборка.Прочих = 0 Тогда
			Итог.Возвратных = Итог.Возвратных + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Ручная отметка «Сверилось»: человек проверил расхождения УПД с приходной
// Далиона и принял их.
//
// УПД и её УКД получают «Расхождений нет» и статус «Готов к отправке»,
// пересверка отметку не снимает (ЗафиксироватьИтогСверки), а проверка
// итоговой суммы перед подписью её пропускает
// (ЭАрМ_УтверждениеСБИС.ЗапретПоИтоговойСумме). Найденные сверкой
// расхождения остаются в тексте сверки. Кто, когда и почему - в
// СвереноВручнуюКем и в журнале обмена.
//
// Параметры:
//   ИдентификаторУПД - Строка
//   Комментарий      - Строка - почему расхождения приняты
//
// Возвращаемое значение:
//   Строка - итог для пользователя
//
Функция ОтметитьСверенымВручную(ИдентификаторУПД, Комментарий) Экспорт

	Шапка = ШапкаДляСверкиВручную(ИдентификаторУПД);

	Кем = СтрШаблон("%1, %2", ТекущийПользовательДляОтметки(),
		Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'"));
	Если ЗначениеЗаполнено(СокрЛП(Комментарий)) Тогда
		Кем = Кем + ": " + СокрЛП(Комментарий);
	КонецЕсли;

	// Повторная отметка не наращивает приставку - берём сам итог сверки
	Текст = ТекстСверкиВручную(Кем, ИтогСверкиБезОтметки(Шапка.ТекстСверки));

	ИзменитьСтрокуРеестра("ЭАрМ_УПД_Входящий", ИдентификаторУПД,
		Новый Структура("СвереноВручную, СвереноВручнуюКем, РасхожденийНет, ТекстСверки",
			Истина, Лев(Кем, 500), Истина, Лев(Текст, 1024)));

	Для Каждого ИдентификаторУКД Из КорректировкиУПД(ИдентификаторУПД) Цикл
		ИзменитьСтрокуРеестра(ИмяРеестраКорректировок(), ИдентификаторУКД,
			Новый Структура("РасхожденийНет, ТекстСверки", Истина, Лев(Текст, 1024)));
	КонецЦикла;

	ЭАрМ_РегламентныйОбменЭДО.ОбновитьСводкуУПД(ИдентификаторУПД);

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторУПД, 100), "СверкаВручную", Истина,
		СтрШаблон(НСтр("ru = 'УПД %1 отмечена «Сверилось» вручную: %2'"), Шапка.Номер, Кем));

	Возврат СтрШаблон(НСтр("ru = 'УПД %1 отмечена «Сверилось». Расхождения сверки сохранены в её тексте, итоговая сумма перед подписью не проверяется.'"),
		Шапка.Номер);

КонецФункции

// Снимает ручную отметку «Сверилось» и возвращает настоящий итог сверки:
// цепочки УПД с приходом пересверяются. Приходной нет - сверять не с чем.
//
// Возвращаемое значение:
//   Строка - итог для пользователя
//
Функция СнятьСверкуВручную(ИдентификаторУПД) Экспорт

	Шапка = ШапкаДляСверкиВручную(ИдентификаторУПД);

	ИзменитьСтрокуРеестра("ЭАрМ_УПД_Входящий", ИдентификаторУПД,
		Новый Структура("СвереноВручную, СвереноВручнуюКем", Ложь, ""));

	Пересверено = ЭАрМ_СверкаТоваровЦепочки.ПересверитьЦепочкиУПДОбычно(ИдентификаторУПД);

	Если Пересверено = 0 Тогда
		Текст = НСтр("ru = 'Приходная Далиона к УПД не найдена - сверять не с чем'");
		ИзменитьСтрокуРеестра("ЭАрМ_УПД_Входящий", ИдентификаторУПД,
			Новый Структура("РасхожденийНет, ТекстСверки", Ложь, Текст));
		Для Каждого ИдентификаторУКД Из КорректировкиУПД(ИдентификаторУПД) Цикл
			ИзменитьСтрокуРеестра(ИмяРеестраКорректировок(), ИдентификаторУКД,
				Новый Структура("РасхожденийНет, ТекстСверки", Ложь, Текст));
		КонецЦикла;
	КонецЕсли;

	ЭАрМ_РегламентныйОбменЭДО.ОбновитьСводкуУПД(ИдентификаторУПД);

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторУПД, 100), "СверкаВручную", Истина,
		СтрШаблон(НСтр("ru = 'УПД %1: ручная отметка «Сверилось» снята (%2), пересверено цепочек %3'"),
			Шапка.Номер, ТекущийПользовательДляОтметки(), Пересверено));

	Возврат СтрШаблон(НСтр("ru = 'УПД %1: ручная отметка снята, пересверено цепочек %2.'"),
		Шапка.Номер, Пересверено);

КонецФункции

// Отмечена ли УПД сверенной вручную.
//
// Возвращаемое значение:
//   Структура - Сверено (Булево), Кем (Строка)
//
Функция СведенияСверкиВручную(ИдентификаторУПД) Экспорт

	Результат = Новый Структура("Сверено, Кем", Ложь, "");

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.СвереноВручную КАК Сверено,
	|	УПД.СвереноВручнуюКем КАК Кем
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.ИдентификаторСБИС = &ИдентификаторУПД";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Сверено = Выборка.Сверено = Истина;
		Результат.Кем = СокрЛП(Выборка.Кем);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ШапкаДляСверкиВручную(ИдентификаторУПД)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.Номер КАК Номер,
	|	УПД.ТекстСверки КАК ТекстСверки
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.ИдентификаторСБИС = &ИдентификаторУПД";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) ИЛИ НЕ Выборка.Следующий() Тогда
		ВызватьИсключение НСтр("ru = 'УПД нет в реестре'");
	КонецЕсли;

	Возврат Новый Структура("Номер, ТекстСверки", СокрЛП(Выборка.Номер), СокрЛП(Выборка.ТекстСверки));

КонецФункции

Функция ПриставкаСверкиВручную()

	Возврат "Сверено вручную";

КонецФункции

Функция ТекстСверкиВручную(Кем, ИтогСверки)

	Текст = ПриставкаСверкиВручную() + " (" + Кем + ")";
	Итог = ИтогСверкиБезОтметки(ИтогСверки);
	Если ЗначениеЗаполнено(Итог) И Итог <> "Сошлось" Тогда
		Текст = Текст + ". Сверка: " + Итог;
	КонецЕсли;

	Возврат Текст;

КонецФункции

Функция ИтогСверкиБезОтметки(ТекстСверки)

	Текст = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ТекстСверки));
	Если НЕ СтрНачинаетсяС(Текст, ПриставкаСверкиВручную()) Тогда
		Возврат Текст;
	КонецЕсли;

	Позиция = СтрНайти(Текст, ". Сверка: ");
	Возврат ?(Позиция > 0, Сред(Текст, Позиция + СтрДлина(". Сверка: ")), "");

КонецФункции

Функция ТекущийПользовательДляОтметки()

	Имя = ПолноеИмяПользователя();
	Возврат ?(ЗначениеЗаполнено(Имя), Имя, ИмяПользователя());

КонецФункции

// Отметки строк товаров УПД, которые человек принял вручную.
// Пересверка их не возвращает в расхождения: итоговая сумма УПД по-прежнему
// решает, можно ли документ отправлять.
//
// Возвращаемое значение:
//   Соответствие - номер позиции -> Структура (Наименование, Кем, Комментарий)
//
Функция ОтметкиСтрокСверкиВручную(ИдентификаторУПД) Экспорт

	Результат = Новый Соответствие;
	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.СтрокиСвереныВручную КАК СтрокиСвереныВручную
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.ИдентификаторСБИС = &ИдентификаторУПД";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() ИЛИ НЕ ЗначениеЗаполнено(Выборка.СтрокиСвереныВручную) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Запись Из СтрРазделить(Выборка.СтрокиСвереныВручную, Символы.ПС, Ложь) Цикл
		Части = СтрРазделить(Запись, Символы.Таб, Истина);
		Если Части.Количество() < 4 Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Номер = Число(СокрЛП(Части[0]));
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"ОтметкиСтрокСверкиВручную (номер строки в отметке не число - отметка пропущена)", ОшибкаИсключения);
			Продолжить;
		КонецПопытки;
		Если Номер <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Номер, Новый Структура("Наименование, Кем, Комментарий",
			Части[1], Части[2], Части[3]));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строка товаров УПД отмечена сверенной, если отмечена каждая её позиция
// и наименование с момента отметки не сменилось.
//
// Возвращаемое значение:
//   Структура - Кем, Комментарий; Неопределено - отметки нет или она чужая
//
Функция ОтметкаСтрокиСверкиВручную(Отметки, ПозицииСтрокой, Наименование) Экспорт

	Если Отметки = Неопределено ИЛИ Отметки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Номера = НомераПозицийСтроки(ПозицииСтрокой);
	Если Номера.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяСтроки = ЭАрМ_СверкаТоваровЦепочки.НормализованноеНаименование(Наименование);
	Кем = "";
	Комментарий = "";
	Для Каждого Номер Из Номера Цикл
		Отметка = Отметки.Получить(Номер);
		Если Отметка = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если ЭАрМ_СверкаТоваровЦепочки.НормализованноеНаименование(Отметка.Наименование) <> ИмяСтроки Тогда
			Возврат Неопределено;
		КонецЕсли;
		Кем = Отметка.Кем;
		Комментарий = Отметка.Комментарий;
	КонецЦикла;

	Возврат Новый Структура("Кем, Комментарий", Кем, Комментарий);

КонецФункции

// Принимает расхождение текущей строки товаров УПД. Отметка пишется в УПД
// и переживает пересверку: строка больше не считается расхождением.
// Итоговая сумма документа при этом не принимается - её по-прежнему
// закрывает «Сверилось вручную» на всю УПД.
//
// Параметры:
//   Позиции     - Строка - номера позиций УПД через ";"
//   Наименование - Строка - как строка показана в таблице товаров
//   Комментарий - Строка - почему расхождение принято
//
// Возвращаемое значение:
//   Строка - итог для пользователя
//
Функция ОтметитьСтрокуСверенойВручную(ИдентификаторУПД, Позиции, Наименование, Комментарий) Экспорт

	Номера = НомераПозицийСтроки(Позиции);
	Если Номера.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'У строки нет номера позиции УПД - обновите таблицу товаров'");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СокрЛП(Наименование)) Тогда
		ВызватьИсключение НСтр("ru = 'У строки нет наименования'");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СокрЛП(Комментарий)) Тогда
		ВызватьИсключение НСтр("ru = 'Напишите, почему строка сверена'");
	КонецЕсли;

	Кем = СтрШаблон("%1, %2", ТекущийПользовательДляОтметки(),
		Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'"));
	Отметки = ОтметкиСтрокСверкиВручную(ИдентификаторУПД);
	Для Каждого Номер Из Номера Цикл
		Отметки.Вставить(Номер, Новый Структура("Наименование, Кем, Комментарий",
			СокрЛП(Наименование), Кем, СокрЛП(Комментарий)));
	КонецЦикла;
	ЗаписатьОтметкиСтрок(ИдентификаторУПД, Отметки);

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторУПД, 100), "СверкаСтрокиВручную", Истина,
		СтрШаблон(НСтр("ru = 'УПД: строка «%1» (позиции %2) сверена вручную: %3. Таблица товаров не пересверялась'"),
			Наименование, СтрСоединить(Номера, ", "), Кем + ": " + СокрЛП(Комментарий)));

	Возврат СтрШаблон(НСтр("ru = 'Строка «%1» сверена вручную. Итоговая сумма УПД по-прежнему решает, можно ли её отправлять.'"),
		Наименование);

КонецФункции

// Снимает ручную сверку позиций строки и возвращает обычный итог пересверки.
//
Функция СнятьСверкуСтрокиВручную(ИдентификаторУПД, Позиции, Наименование) Экспорт

	Номера = НомераПозицийСтроки(Позиции);
	Если Номера.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'У строки нет номера позиции УПД - обновите таблицу товаров'");
	КонецЕсли;

	Отметки = ОтметкиСтрокСверкиВручную(ИдентификаторУПД);
	Для Каждого Номер Из Номера Цикл
		Отметки.Удалить(Номер);
	КонецЦикла;
	ЗаписатьОтметкиСтрок(ИдентификаторУПД, Отметки);

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторУПД, 100), "СверкаСтрокиВручную", Истина,
		СтрШаблон(НСтр("ru = 'УПД: со строки «%1» (позиции %2) снята ручная сверка (%3), без пересверки'"),
			Наименование, СтрСоединить(Номера, ", "), ТекущийПользовательДляОтметки()));

	Возврат СтрШаблон(НСтр("ru = 'Со строки «%1» ручная сверка снята.'"), Наименование);

КонецФункции

// Снимает ручные сверки всех строк УПД - когда УПД отвязали от прихода.
//
Процедура СнятьСтрокиСверкиВручную(ИдентификаторУПД) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат;
	КонецЕсли;
	Если ОтметкиСтрокСверкиВручную(ИдентификаторУПД).Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьОтметкиСтрок(ИдентификаторУПД, Новый Соответствие);

КонецПроцедуры

Функция НомераПозицийСтроки(ПозицииСтрокой)

	Результат = Новый Массив;
	Если ТипЗнч(ПозицииСтрокой) = Тип("Число") И ПозицииСтрокой > 0 Тогда
		Результат.Добавить(ПозицииСтрокой);
		Возврат Результат;
	КонецЕсли;

	Для Каждого Часть Из СтрРазделить(ЭАрМ_Служебный.СтрокойИлиПусто(ПозицииСтрокой), ";", Ложь) Цикл
		Попытка
			Номер = Число(СокрЛП(Часть));
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"НомераПозицийСтроки (номер позиции не число - пропущен)", ОшибкаИсключения);
			Продолжить;
		КонецПопытки;
		Если Номер > 0 И Результат.Найти(Номер) = Неопределено Тогда
			Результат.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаписатьОтметкиСтрок(ИдентификаторУПД, Отметки)

	Строки = Новый Массив;
	Для Каждого КлючЗначение Из Отметки Цикл
		Отметка = КлючЗначение.Значение;
		Строки.Добавить(СтрШаблон("%1%2%3%4%5%6%7",
			Формат(КлючЗначение.Ключ, "ЧГ=0"), Символы.Таб,
			ТекстПоляОтметки(Отметка.Наименование), Символы.Таб,
			ТекстПоляОтметки(Отметка.Кем), Символы.Таб,
			ТекстПоляОтметки(Отметка.Комментарий)));
	КонецЦикла;

	ИзменитьСтрокуРеестра("ЭАрМ_УПД_Входящий", ИдентификаторУПД,
		Новый Структура("СтрокиСвереныВручную", СтрСоединить(Строки, Символы.ПС)));

КонецПроцедуры

Функция ТекстПоляОтметки(Текст)

	Возврат СтрЗаменить(СтрЗаменить(СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(Текст)),
		Символы.Таб, " "), Символы.ПС, " ");

КонецФункции

// Скачивает XML-вложение УКД из СБИС, чтобы открыть его как есть.
//
// Берёт то же вложение, из которого разбираются строки товаров (титул
// продавца в приоритете). Файл нужен для разбора признаков возврата и
// аннулирования: в реестре они не хранятся.
//
// Параметры:
//   ИдентификаторУКД - Строка - идентификатор документа в СБИС
//
// Возвращаемое значение:
//   Структура:
//     * Успех  - Булево
//     * Ошибка - Строка
//     * Имя    - Строка - имя файла вложения
//     * Данные - ДвоичныеДанные
//
Функция ФайлКорректировки(ИдентификаторУКД) Экспорт

	Результат = Новый Структура("Успех, Ошибка, Имя, Данные", Ложь, "", "", Неопределено);

	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Результат.Ошибка = "Не удалось авторизоваться в СБИС";
		Возврат Результат;
	КонецЕсли;

	ДанныеДокумента = ЭАрМ_ОбщийМодульОбмен.ПрочитатьДокумент(ИдентификаторУКД, Сессия, "", "Вложение");
	Если НЕ ДанныеДокумента.Успех Тогда
		Результат.Ошибка = ДанныеДокумента.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Вложения = ЭАрМ_Служебный.ВложенияСДаннымиТоваров(ДанныеДокумента.Документ);
	Если Вложения.Количество() = 0 Тогда
		Результат.Ошибка = "У документа нет XML-вложения со ссылкой на файл";
		Возврат Результат;
	КонецЕсли;

	ОписаниеВложения = Вложения[0];
	ПутьКФайлу = ЭАрМ_Служебный.СкачатьВложениеВФайл(ОписаниеВложения, Сессия, "");
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Результат.Ошибка = "Не удалось скачать файл (подробности в журнале регистрации)";
		Возврат Результат;
	КонецЕсли;

	Результат.Данные = Новый ДвоичныеДанные(ПутьКФайлу);
	ЭАрМ_Служебный.УдалитьВременныйФайл(ПутьКФайлу);

	Результат.Имя = ?(ЗначениеЗаполнено(ОписаниеВложения.Имя), ОписаниеВложения.Имя,
		СтрШаблон("УКД_%1.xml", ИдентификаторУКД));
	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// Сверка УПД или корректировки с приходом Далиона - текст для пользователя.
//
// Сначала пересверяет цепочку, не дожидаясь задания: отметки «Расхождений
// нет» у УПД и УКД обновляются сразу. Затем по каждой строке показывает
// значения УПД до корректировки, после неё и приход Далиона.
//
// Параметры:
//   ИдентификаторСБИС - Строка - УПД из реестра УПД или УКД из реестра УКД
//
// Возвращаемое значение:
//   Строка
//
Функция ОтчетСверки(ИдентификаторСБИС) Экспорт

	Части = Новый Массив;

	ИдентификаторУПД = ИдентификаторСБИС;
	Реквизиты = РеквизитыКорректировки(ИдентификаторСБИС);

	Если Реквизиты <> Неопределено Тогда

		Части.Добавить(СтрШаблон("Корректировка (УКД) %1 от %2, %3",
			Реквизиты.Номер, Формат(Реквизиты.Дата, "ДЛФ=D"), Реквизиты.Контрагент));
		Части.Добавить(СтрШаблон("Исправляемый документ по данным УКД: %1 от %2",
			Реквизиты.НомерОснования, Формат(Реквизиты.ДатаОснования, "ДЛФ=D")));

		ИдентификаторУПД = Реквизиты.ИдентификаторОснования;
		Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
			ИдентификаторУПД = СвязатьСОснованием(ИдентификаторСБИС, Истина, Истина);
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
			Части.Добавить("");
			Части.Добавить("Исходная УПД не связана: " + ПричинаБезСвязи(ИдентификаторСБИС, Реквизиты));
			Возврат СтрСоединить(Части, Символы.ПС);
		КонецЕсли;

		Части.Добавить("");

	КонецЕсли;

	РеквизитыУПД = РеквизитыУПД(ИдентификаторУПД);
	Если РеквизитыУПД <> Неопределено Тогда
		Части.Добавить(СтрШаблон("УПД %1 от %2, %3", РеквизитыУПД.Номер,
			Формат(РеквизитыУПД.Дата, "ДЛФ=D"), РеквизитыУПД.Контрагент));
	ИначеЕсли Реквизиты = Неопределено Тогда
		Возврат НСтр("ru = 'Документа нет ни в реестре УПД, ни в реестре УКД'");
	КонецЕсли;

	Корректировки = КорректировкиУПД(ИдентификаторУПД);
	Если Корректировки.Количество() = 0 Тогда
		Части.Добавить("Корректировок к УПД нет.");
	Иначе
		Для Каждого ИдентификаторУКД Из Корректировки Цикл
			РеквизитыУКД = РеквизитыКорректировки(ИдентификаторУКД);
			Части.Добавить(СтрШаблон("  УКД %1 от %2%3", РеквизитыУКД.Номер,
				Формат(РеквизитыУКД.Дата, "ДЛФ=D"), ?(РеквизитыУКД.Утверждено, ", утверждена", "")));
		КонецЦикла;
	КонецЕсли;

	Цепочка = ЭАрМ_ЦепочкаЗакупки.ЦепочкаПоУПД(ИдентификаторУПД);

	Если Цепочка = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Цепочка.ИдентификаторПоступления) Тогда

		Части.Добавить("");
		Части.Добавить("УПД не связана с приходной накладной Далиона - сверять не с чем. Изменения по корректировкам:");
		Для Каждого СтрокаУКД Из СтрокиКорректировок(ИдентификаторУПД) Цикл
			Части.Добавить(СтрШаблон("  УКД %1, строка %2 %3: после изменения %4, сумма %5",
				СтрокаУКД.Номер, СтрокаУКД.НомерПозиции, СтрокаУКД.Наименование,
				Формат(СтрокаУКД.Количество, "ЧН=0; ЧГ=0"), Формат(СтрокаУКД.Сумма, "ЧН=0; ЧГ=0")));
		КонецЦикла;

		Возврат СтрСоединить(Части, Символы.ПС);

	КонецЕсли;

	ЭАрМ_СверкаТоваровЦепочки.СверитьЦепочку(Цепочка.ИдентификаторЗаказа, Цепочка.ИдентификаторПоступления);
	Линии = ЭАрМ_СверкаТоваровЦепочки.ЛинииЦепочки(Цепочка.ИдентификаторЗаказа, Цепочка.ИдентификаторПоступления);

	Части.Добавить(СтрШаблон("Приходная накладная Далиона %1 от %2",
		Цепочка.НомерПоступления, Формат(Цепочка.ДатаПоступления, "ДЛФ=D")));
	Части.Добавить("");
	Части.Добавить("=== Строки: УПД до корректировки -> после -> приход Далиона (количество x цена с НДС) ===");

	Расхождений = 0;

	Для Каждого Линия Из ЭАрМ_Служебный.ЗначениеВМассив(Линии) Цикл

		Если Линия.УПД = Неопределено И Линия.Поступление = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Линия.Результат <> "Совпадает" Тогда
			Расхождений = Расхождений + 1;
		КонецЕсли;

		Части.Добавить(СтрШаблон("%1. %2 [%3]", Линия.НомерСтроки, НаименованиеЛинии(Линия), Линия.Результат));

		Если Линия.УПД = Неопределено Тогда
			Части.Добавить("    УПД: строки нет");
		ИначеЕсли ЗначениеЗаполнено(Линия.УПД.Корректировка) Тогда
			Части.Добавить(СтрШаблон("    УПД: %1 -> %2: %3",
				ЧислоИЦена(Линия.УПД.КоличествоДо, Линия.УПД.ЦенаДо), Линия.УПД.Корректировка,
				ЧислоИЦена(Линия.УПД.Количество, Линия.УПД.Цена)));
		Иначе
			Части.Добавить(СтрШаблон("    УПД: %1 (без корректировки)",
				ЧислоИЦена(Линия.УПД.Количество, Линия.УПД.Цена)));
		КонецЕсли;

		Если Линия.Поступление = Неопределено Тогда
			Части.Добавить("    Приход Далиона: строки нет");
		Иначе
			Части.Добавить(СтрШаблон("    Приход Далиона: %1",
				ЧислоИЦена(Линия.Поступление.Количество, Линия.Поступление.Цена)));
		КонецЕсли;

		Если Линия.Результат <> "Совпадает" И ЗначениеЗаполнено(Линия.Комментарий) Тогда
			Части.Добавить("    Замечания: " + Линия.Комментарий);
		КонецЕсли;

	КонецЦикла;

	Части.Добавить("");
	Если Расхождений = 0 Тогда
		Части.Добавить("Итог: расхождений нет. УПД и её корректировки можно утверждать.");
	Иначе
		Части.Добавить(СтрШаблон(
			"Итог: строк с расхождениями %1. Утверждение запрещено: запросите у поставщика корректировку на эти строки.",
			Расхождений));
	КонецЕсли;

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// Галочка «Есть УКД» у УПД - по действующим корректировкам, связанным с ней.
//
// Параметры:
//   ИдентификаторУПД - Строка
//
Процедура ОбновитьПризнакУКД(ИдентификаторУПД) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УКД.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.ИдентификаторОснования = &ИдентификаторУПД
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УКД");
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	ИзменитьСтрокуРеестра("ЭАрМ_УПД_Входящий", ИдентификаторУПД,
		Новый Структура("ЕстьУКД", НЕ Запрос.Выполнить().Пустой()));

КонецПроцедуры

// Снимает связи корректировок с документами, закрытыми в СБИС (аннулированы,
// удалены, отозваны):
//   - корректировка закрытой УПД отпускает её: ОбработатьКорректировки свяжет
//     корректировку по номеру с УПД, которую поставщик пришлёт взамен;
//   - закрытая корректировка отпускает свою УПД, и та пересверяется без неё.
// Шаг ЭАрМ_ЦепочкаЗакупки.ОтвязатьЗакрытыеДокументы.
//
Процедура ОтвязатьЗакрытыеДокументы() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УКД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УКД.Номер КАК Номер,
	|	УПД.Номер КАК НомерУПД,
	|	УПД.Состояние КАК СостояниеУПД
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО УКД.ИдентификаторОснования = УПД.ИдентификаторСБИС
	|ГДЕ
	|	НЕ (" + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УПД") + ")";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ИзменитьСтрокуРеестра(ИмяРеестраКорректировок(), СокрЛП(Выборка.ИдентификаторСБИС),
				Новый Структура("ИдентификаторОснования, ДатаПоискаОснования", "", Дата(1, 1, 1)));
			ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС, Истина, СтрШаблон(
				"УКД %1: исходная УПД %2 закрыта в СБИС (%3), связь снята - корректировка свяжется с УПД, присланной взамен",
				СокрЛП(Выборка.Номер), СокрЛП(Выборка.НомерУПД), СокрЛП(Выборка.СостояниеУПД)));
		Исключение
			ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС, Ложь,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	УКД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УКД.Номер КАК Номер,
	|	УКД.Состояние КАК Состояние,
	|	УКД.ИдентификаторОснования КАК ИдентификаторОснования
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.ИдентификаторОснования <> """"
	|	И НЕ (" + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УКД") + ")";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ИдентификаторУПД = СокрЛП(Выборка.ИдентификаторОснования);
			ИзменитьСтрокуРеестра(ИмяРеестраКорректировок(), СокрЛП(Выборка.ИдентификаторСБИС),
				Новый Структура("ИдентификаторОснования", ""));
			ОбновитьПризнакУКД(ИдентификаторУПД);
			ЭАрМ_ЦепочкаЗакупки.ОтметитьИзменениеУПД(ИдентификаторУПД);
			ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС, Истина, СтрШаблон(
				"УКД %1 закрыта в СБИС (%2): больше не исправляет УПД, УПД пересверится без неё",
				СокрЛП(Выборка.Номер), СокрЛП(Выборка.Состояние)));
		Исключение
			ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС, Ложь,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строка возврата или корректировки Далиона из пакета - в виде, готовом для записи
// в ЭАрМ_ТоварыЭТрН: длины полей, округление, штрихкод, признак изменения.
//
// Штрихкод - первый из ЭАрМ_СверкаТоваровЦепочки.ШтрихкодыСтрокиДалиона (штрихкод
// строки, затем штрихкоды карточки); по имени и цене строки не сопоставляются.
// Единицу измерения, ставку НДС, ТН ВЭД и алкоголь не пишем: по штрихкоду эти
// поля ищут в регистре карточки товара (ЭАрМ_НоменклатураПоставщиковУТ,
// ЭАрМ_КатегорииТоваров), и значения Далиона попали бы к ним вместо значений УПД.
//
// Параметры:
//   ЭтоВозврат           - Булево - Истина: возврат, Ложь: корректировка
//   Товар                - Соответствие - элемент goods пакета
//   ПорядковыйНомер      - Число - номер строки в пакете, если lineNumber не задан
//   ИспользованныеНомера - Соответствие - занятые номера позиций (дополняется)
//
// Возвращаемое значение:
//   Структура - НомерПозиции, Наименование, КодНоменклатуры, Артикул, Штрихкод,
//               Количество, Цена, Сумма, СуммаНДС, ПризнакИзменения
//
Функция ПозицияДокументаДалион(ЭтоВозврат, Товар, ПорядковыйНомер, ИспользованныеНомера)

	Номенклатура = ЭАрМ_Служебный.ЗначениеУзла(Товар, "nomenclature");

	// Номер строки в документе Далиона; повторился или не задан - следующий свободный
	НомерПозиции = Цел(ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "lineNumber", 0)));
	Если НомерПозиции <= 0 ИЛИ ИспользованныеНомера.Получить(НомерПозиции) <> Неопределено Тогда
		НомерПозиции = ПорядковыйНомер;
		Пока ИспользованныеНомера.Получить(НомерПозиции) <> Неопределено Цикл
			НомерПозиции = НомерПозиции + 1;
		КонецЦикла;
	КонецЕсли;
	ИспользованныеНомера.Вставить(НомерПозиции, Истина);

	Наименование = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Номенклатура, "name", ""));
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Наименование = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеПоПути(Товар, "item.supplierName", ""));
	КонецЕсли;

	Артикул = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеПоПути(Товар, "item.article", ""));
	Если НЕ ЗначениеЗаполнено(Артикул) Тогда
		Артикул = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Номенклатура, "article", ""));
	КонецЕсли;

	КодНоменклатуры = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Номенклатура, "code", ""));
	Если НЕ ЗначениеЗаполнено(КодНоменклатуры) Тогда
		КодНоменклатуры = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеПоПути(Товар, "item.code", ""));
	КонецЕсли;

	Штрихкоды = ЭАрМ_СверкаТоваровЦепочки.ШтрихкодыСтрокиДалиона(Товар);

	Количество = Окр(ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "quantity", 0)), 3);
	Сумма = Окр(ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "amount", 0)), 2);

	Если ЭтоВозврат Тогда
		Признак = "Возврат";
	Иначе
		КоличествоДо = Окр(ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "quantityBefore", 0)), 3);
		СуммаДо = Окр(ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "amountBefore", 0)), 2);
		Если КоличествоДо = 0 И СуммаДо = 0 И (Количество <> 0 ИЛИ Сумма <> 0) Тогда
			// Значений «до» нет: строки до корректировки не было
			Признак = "Новая";
		Иначе
			Признак = ЭАрМ_Служебный.ПризнакИзмененияУКД(Новый Структура(
				"Количество, КоличествоДо, СуммаСНДС, СуммаСНДСДо", Количество, КоличествоДо, Сумма, СуммаДо));
		КонецЕсли;
	КонецЕсли;

	Позиция = Новый Структура;
	Позиция.Вставить("НомерПозиции",     НомерПозиции);
	Позиция.Вставить("Наименование",     Лев(Наименование, 500));
	Позиция.Вставить("КодНоменклатуры",  Лев(КодНоменклатуры, 50));
	Позиция.Вставить("Артикул",          Лев(Артикул, 50));
	Позиция.Вставить("Штрихкод",         Лев(?(Штрихкоды.Количество() > 0, Штрихкоды[0], ""), 200));
	Позиция.Вставить("Количество",       Количество);
	Позиция.Вставить("Цена",             Окр(ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "price", 0)), 4));
	Позиция.Вставить("Сумма",            Сумма);
	Позиция.Вставить("СуммаНДС",         Окр(ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "vatAmount", 0)), 2));
	Позиция.Вставить("ПризнакИзменения", Признак);

	Возврат Позиция;

КонецФункции

Функция ИмяРеестраКорректировок()

	Возврат "ЭАрМ_УКД_Входящий";

КонецФункции

// Поля, общие у реестров УПД и УКД: их переносит ПеренестиВРеестрКорректировок.
//
Функция ПоляРеестраКорректировок()

	Возврат "Номер, Дата, Наименование, Представление, Состояние, Организация, Контрагент,"
		+ " ИННКонтрагента, ТипРеестра, КлючиСвязи, ДатаЗагрузки, ИдентификаторОснования,"
		+ " НомерОснования, ДатаОснования, РасхожденийНет, ТекстСверки, КОтправке,"
		+ " Утверждено, Подписано, СтатусПодписания, КодСостояния";

КонецФункции

// Корректировки, которые лежат в реестре УПД: записанные до появления реестра
// УКД (Формат = "УКД"), распознанные только по XML (строки товаров "УКД") и
// копии строк, которые уже есть в реестре УКД. Вызывается и после загрузки реестра.
//
Процедура ПеренестиКорректировкиИзРеестраУПД() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	(УПД.Формат = &Формат
	|			ИЛИ УПД.ИдентификаторСБИС В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					Товары.ИдентификаторСБИС
	|				ИЗ
	|					РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|				ГДЕ
	|					Товары.ИсточникТоваров = &Источник)
	|			ИЛИ УПД.ИдентификаторСБИС В
	|				(ВЫБРАТЬ
	|					УКД.ИдентификаторСБИС
	|				ИЗ
	|					РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД))";
	Запрос.УстановитьПараметр("Формат", ФорматКорректировки());
	Запрос.УстановитьПараметр("Источник", ИсточникТоваровКорректировки());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ПеренестиВРеестрКорректировок(СокрЛП(Выборка.ИдентификаторСБИС));
		Исключение
			ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС, Ложь,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Корректировки без номера исправляемой УПД и без строк "УКД". Так бывает,
// когда строки загрузились до того, как корректировки стали разбираться
// отдельно, - они легли строками УПД, и повторная загрузка их пропускает, раз
// товары уже есть. А номер исправляемой УПД читается из XML только вместе со
// строками. Перечитываем из СБИС понемногу за проход.
//
Процедура ДогрузитьСтрокиБезОснования()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	УКД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УКД.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.НомерОснования = """"
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УКД") + "
	|	И НЕ УКД.ИдентификаторСБИС В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					Товары.ИдентификаторСБИС
	|				ИЗ
	|					РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|				ГДЕ
	|					Товары.ИсточникТоваров = &Источник)
	|
	|УПОРЯДОЧИТЬ ПО
	|	УКД.Дата УБЫВ";
	Запрос.УстановитьПараметр("Источник", ИсточникТоваровКорректировки());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ЭАрМ_РегламентныйОбменЭДО.ДогрузитьТоварыУПД(
				СокрЛП(Выборка.ИдентификаторСБИС), СокрЛП(Выборка.Номер));
		Исключение
			ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС, Ложь,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Возвращаемое значение:
//   Структура - поля строки реестра УКД; Неопределено - строки нет
//
Функция РеквизитыКорректировки(ИдентификаторСБИС)

	Реквизиты = РеквизитыСтроки(ИмяРеестраКорректировок(), ИдентификаторСБИС,
		"Номер, Дата, Контрагент, ИННКонтрагента, НомерОснования, ДатаОснования,"
		+ " ИдентификаторОснования, Утверждено, РасхожденийНет, ТекстСверки, ДатаПоискаОснования");

	Если Реквизиты <> Неопределено Тогда
		Реквизиты.НомерОснования         = СокрЛП(Реквизиты.НомерОснования);
		Реквизиты.ИдентификаторОснования = СокрЛП(Реквизиты.ИдентификаторОснования);
	КонецЕсли;

	Возврат Реквизиты;

КонецФункции

// Возвращаемое значение:
//   Структура - поля строки реестра УПД; Неопределено - строки нет
//
Функция РеквизитыУПД(ИдентификаторСБИС)

	Возврат РеквизитыСтроки("ЭАрМ_УПД_Входящий", ИдентификаторСБИС,
		"Номер, Дата, Контрагент, ИННКонтрагента, Утверждено, РасхожденийНет");

КонецФункции

Функция РеквизитыСтроки(ИмяРегистра, ИдентификаторСБИС, ИменаПолей)

	Если НЕ ЗначениеЗаполнено(ИдентификаторСБИС) Тогда
		Возврат Неопределено;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторСБИС;
	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Реквизиты = Новый Структура(ИменаПолей);
	ЗаполнитьЗначенияСвойств(Реквизиты, МенеджерЗаписи);

	Возврат Реквизиты;

КонецФункции

// Исходная УПД: тот же номер (с нормализацией), дата +-3 дня от даты
// исправляемого счёта-фактуры, ИНН контрагента. Без даты в XML ищем за год
// до даты самой УКД. Из нескольких подходящих берётся последняя по времени
// создания в СБИС (у старых записей без него - по времени загрузки).
// В одну секунду - сначала разошедшаяся с приходом, затем ближайшая по дате.
//
Функция НайтиИсходнуюУПД(ИдентификаторУКД, Реквизиты)

	Период = ПериодПоискаУПД(Реквизиты);

	// Формат отсекает корректировки, ещё не перенесённые из реестра УПД
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК Идентификатор,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.ДатаВремяСБИС КАК ДатаВремяСБИС,
	|	УПД.ДатаЗагрузки КАК ДатаЗагрузки,
	|	УПД.ИННКонтрагента КАК ИНН,
	|	УПД.РасхожденийНет КАК РасхожденийНет
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.Формат <> &Формат
	|	И УПД.ИдентификаторСБИС <> &ИдентификаторУКД
	|	И УПД.Номер <> """"
	|	И УПД.Дата МЕЖДУ &ДатаС И &ДатаПо
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УПД");
	Запрос.УстановитьПараметр("Формат", ФорматКорректировки());
	Запрос.УстановитьПараметр("ИдентификаторУКД", ИдентификаторУКД);
	Запрос.УстановитьПараметр("ДатаС", Период.ДатаС);
	Запрос.УстановитьПараметр("ДатаПо", Период.ДатаПо);

	Лучший = "";
	ЛучшийМомент = '00010101';
	ЛучшаяРазница = 0;
	ЛучшаяСошлась = Ложь;

	// Как ищем - в трассу: номер и ИНН из УКД, окно дат, каждая УПД с тем же номером
	// и почему взята или нет
	КандидатыТрассы = Новый Массив;
	ДругихНомеров = 0;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если НЕ ЭАрМ_Служебный.НомераСовпадают(Выборка.Номер, Реквизиты.НомерОснования) Тогда
			ДругихНомеров = ДругихНомеров + 1;
			Продолжить;
		КонецЕсли;
		Если НЕ ИННСовпадает(Выборка.ИНН, Реквизиты.ИННКонтрагента) Тогда
			КандидатыТрассы.Добавить(СтрШаблон("№ %1 (%2) ИНН %3 - другой ИНН, не берём", Выборка.Номер,
				СокрЛП(Выборка.Идентификатор), Выборка.ИНН));
			Продолжить;
		КонецЕсли;
		КандидатыТрассы.Добавить(СтрШаблон("№ %1 (%2) от %3, загружена %4, сошлась с приходом %5 - подходит",
			Выборка.Номер, СокрЛП(Выборка.Идентификатор), Формат(Выборка.Дата, "ДЛФ=D"),
			Формат(МоментУПД(Выборка.ДатаВремяСБИС, Выборка.ДатаЗагрузки, Выборка.Дата), "ДЛФ=DT"),
			?(Выборка.РасхожденийНет, "да", "нет")));

		Разница = Макс(Выборка.Дата - Период.ОпорнаяДата, Период.ОпорнаяДата - Выборка.Дата);
		Момент = МоментУПД(Выборка.ДатаВремяСБИС, Выборка.ДатаЗагрузки, Выборка.Дата);

		// Последняя по времени. В одну секунду - разошедшаяся с приходом,
		// затем ближайшая к дате счёта-фактуры
		Если НЕ ЗначениеЗаполнено(Лучший) ИЛИ Момент > ЛучшийМомент Тогда
			ЛучшийМомент = Момент;
			ЛучшаяРазница = Разница;
			ЛучшаяСошлась = Выборка.РасхожденийНет;
			Лучший = СокрЛП(Выборка.Идентификатор);
		ИначеЕсли Момент = ЛучшийМомент
			И ((ЛучшаяСошлась И НЕ Выборка.РасхожденийНет)
				ИЛИ (ЛучшаяСошлась = Выборка.РасхожденийНет И Разница < ЛучшаяРазница)) Тогда
			ЛучшаяРазница = Разница;
			ЛучшаяСошлась = Выборка.РасхожденийНет;
			Лучший = СокрЛП(Выборка.Идентификатор);
		КонецЕсли;

	КонецЦикла;

	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторУКД, СтрШаблон(
		"УКД № %1: КАК ИЩЕМ исходную УПД - номер «%2», ИНН %3, даты %4 - %5 (опорная %6); УПД в окне с другим номером %7; с этим номером: %8 -> %9",
		Реквизиты.Номер, Реквизиты.НомерОснования, Реквизиты.ИННКонтрагента, Формат(Период.ДатаС, "ДЛФ=D"),
		Формат(Период.ДатаПо, "ДЛФ=D"), Формат(Период.ОпорнаяДата, "ДЛФ=D"), ДругихНомеров,
		?(КандидатыТрассы.Количество() = 0, "нет ни одной", СтрСоединить(КандидатыТрассы, "; ")),
		?(ЗначениеЗаполнено(Лучший), "выбрана " + Лучший + " (последняя по времени загрузки; при равенстве - не сошедшаяся, затем ближайшая по дате)",
			"в окне дат не нашлась")), ЗначениеЗаполнено(Лучший));

	// В окне дат не нашлось: тот же номер и тот же ИНН (оба заполнены) без
	// ограничения по дате - дата в реестре СБИС бывает не датой счёта-фактуры
	Если НЕ ЗначениеЗаполнено(Лучший) И ЗначениеЗаполнено(ТолькоЦифры(Реквизиты.ИННКонтрагента)) Тогда
		Лучший = УПДПоНомеруИИНН(ИдентификаторУКД, Реквизиты, Период.ОпорнаяДата);
	КонецЕсли;

	Возврат Лучший;

КонецФункции

// Исходная УПД по номеру и ИНН контрагента шире окна дат - последняя по
// времени, но не дальше года: номера у поставщиков каждый год начинаются
// заново, и без границы корректировка цеплялась к прошлогодней УПД с тем же
// номером. В одну секунду - ближайшая к опорной дате.
//
Функция УПДПоНомеруИИНН(ИдентификаторУКД, Реквизиты, ОпорнаяДата)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК Идентификатор,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.ДатаВремяСБИС КАК ДатаВремяСБИС,
	|	УПД.ДатаЗагрузки КАК ДатаЗагрузки,
	|	УПД.ИННКонтрагента КАК ИНН
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.Формат <> &Формат
	|	И УПД.ИдентификаторСБИС <> &ИдентификаторУКД
	|	И УПД.Номер <> """"
	|	И УПД.ИННКонтрагента <> """"
	|	И УПД.Дата МЕЖДУ &ДатаС И &ДатаПо
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УПД");
	Запрос.УстановитьПараметр("Формат", ФорматКорректировки());
	Запрос.УстановитьПараметр("ИдентификаторУКД", ИдентификаторУКД);
	Запрос.УстановитьПараметр("ДатаС", НачалоДня(ОпорнаяДата) - 366 * 86400);
	Запрос.УстановитьПараметр("ДатаПо", КонецДня(ОпорнаяДата) + 366 * 86400);

	Лучший = "";
	ЛучшийМомент = '00010101';
	ЛучшаяРазница = 0;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если НЕ ЭАрМ_Служебный.НомераСовпадают(Выборка.Номер, Реквизиты.НомерОснования)
			ИЛИ НЕ ИННСовпадает(Выборка.ИНН, Реквизиты.ИННКонтрагента) Тогда
			Продолжить;
		КонецЕсли;

		Разница = Макс(Выборка.Дата - ОпорнаяДата, ОпорнаяДата - Выборка.Дата);
		Момент = МоментУПД(Выборка.ДатаВремяСБИС, Выборка.ДатаЗагрузки, Выборка.Дата);
		Если НЕ ЗначениеЗаполнено(Лучший)
			ИЛИ Момент > ЛучшийМомент
			ИЛИ (Момент = ЛучшийМомент И Разница < ЛучшаяРазница) Тогда
			ЛучшийМомент = Момент;
			ЛучшаяРазница = Разница;
			Лучший = СокрЛП(Выборка.Идентификатор);
		КонецЕсли;

	КонецЦикла;

	Возврат Лучший;

КонецФункции

// Ищет исходную УПД корректировки в СБИС по номеру (окно 180 дней, реестр
// «Входящие») и записывает её в реестр УПД с товарами. Без БезОграничения - не
// чаще раза в шесть часов на корректировку: СБИС перебирает всё окно поиска.
//
// Возвращаемое значение:
//   Булево - Истина, если документ найден и записан
//
Функция ЗагрузитьИсходнуюУПДИзСБИС(ИдентификаторУКД, Реквизиты, БезОграничения)

	Если НЕ БезОграничения
		И ЗначениеЗаполнено(Реквизиты.ДатаПоискаОснования)
		И Реквизиты.ДатаПоискаОснования > ТекущаяДатаСеанса() - 6 * 3600 Тогда
		Возврат Ложь;
	КонецЕсли;

	ИзменитьСтрокуРеестра(ИмяРеестраКорректировок(), ИдентификаторУКД,
		Новый Структура("ДатаПоискаОснования", ТекущаяДатаСеанса()));

	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		ЗаписатьВЖурнал(ИдентификаторУКД, Ложь, "Поиск исходной УПД в СБИС: не удалось авторизоваться");
		Возврат Ложь;
	КонецЕсли;

	Найденная = ЭАрМ_ОбщийМодульОбмен.НайтиУПДПоНомеру(Реквизиты.НомерОснования, Сессия);

	Если НЕ ЗначениеЗаполнено(Найденная.Идентификатор)
		ИЛИ Найденная.ДокументРеестра = Неопределено
		ИЛИ Найденная.Идентификатор = ИдентификаторУКД
		ИЛИ Найденная.Реестр <> "Входящие" Тогда
		ЗаписатьВЖурнал(ИдентификаторУКД, Ложь, СтрШаблон(
			"Исходная УПД № %1 не найдена ни в реестре, ни во входящих СБИС: %2",
			Реквизиты.НомерОснования, ?(ЗначениеЗаполнено(Найденная.Ошибка), Найденная.Ошибка,
				"нашёлся документ из реестра " + Найденная.Реестр)));
		Возврат Ложь;
	КонецЕсли;

	ЭАрМ_РегламентныйОбменЭДО.ЗагрузитьДокументРеестраУПД(Найденная.ДокументРеестра, Найденная.Реестр);

	ЗаписатьВЖурнал(ИдентификаторУКД, Истина, СтрШаблон(
		"Исходная УПД %1 от %2 загружена из СБИС для корректировки %3",
		Найденная.Номер, Найденная.Дата, Реквизиты.Номер));

	Возврат Истина;

КонецФункции

// Окно дат, в котором ищется исходная УПД корректировки.
//
// Возвращаемое значение:
//   Структура - ОпорнаяДата, ДатаС, ДатаПо
//
// Чем УПД новее: время создания в СБИС, иначе время загрузки, иначе дата документа.
//
Функция МоментУПД(ДатаВремяСБИС, ДатаЗагрузки, Дата)

	Если ЗначениеЗаполнено(ДатаВремяСБИС) Тогда
		Возврат ДатаВремяСБИС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаЗагрузки) Тогда
		Возврат ДатаЗагрузки;
	КонецЕсли;

	Возврат Дата;

КонецФункции

Функция ПериодПоискаУПД(Реквизиты)

	Период = Новый Структура("ОпорнаяДата, ДатаС, ДатаПо");

	Если ЗначениеЗаполнено(Реквизиты.ДатаОснования) Тогда
		Период.ОпорнаяДата = Реквизиты.ДатаОснования;
		Период.ДатаС  = НачалоДня(Период.ОпорнаяДата) - 3 * 86400;
		Период.ДатаПо = КонецДня(Период.ОпорнаяДата) + 3 * 86400;
	Иначе
		Период.ОпорнаяДата = ?(ЗначениеЗаполнено(Реквизиты.Дата), Реквизиты.Дата, ТекущаяДатаСеанса());
		Период.ДатаС  = НачалоДня(Период.ОпорнаяДата) - 365 * 86400;
		Период.ДатаПо = КонецДня(Период.ОпорнаяДата);
	КонецЕсли;

	Возврат Период;

КонецФункции

// Почему корректировка не связана с исходной УПД - текст для пользователя.
// Проверки идут в том порядке, в каком их проходит СвязатьСОснованием.
//
Функция ПричинаБезСвязи(ИдентификаторУКД, Реквизиты)

	Если ЗначениеЗаполнено(Реквизиты.ИдентификаторОснования) Тогда
		РеквизитыОснования = РеквизитыУПД(Реквизиты.ИдентификаторОснования);
		Возврат СтрШаблон("связана с другой УПД %1", ?(РеквизитыОснования = Неопределено,
			Реквизиты.ИдентификаторОснования,
			СтрШаблон("№ %1 от %2", СокрЛП(РеквизитыОснования.Номер), Формат(РеквизитыОснования.Дата, "ДЛФ=D"))));
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Реквизиты.НомерОснования) Тогда
		Если ЕстьСтрокиКорректировки(ИдентификаторУКД) Тогда
			Возврат "в XML корректировки не найден номер исправляемого документа (СвКСчФ/СчФ, НомерСчФ)";
		КонецЕсли;
		Возврат "строки корректировки не загружены как УКД, а номер исправляемой УПД читается из XML вместе с ними."
			+ " Шаг задания «Корректировки УПД» перечитает их из СБИС";
	КонецЕсли;

	Кандидаты = УПДПоНомеру(Реквизиты.НомерОснования, ИдентификаторУКД);
	Если Кандидаты.Количество() = 0 Тогда
		Возврат СтрШаблон("УПД № %1 нет в реестре и не найдена в СБИС за 180 дней (%2)",
			Реквизиты.НомерОснования, ?(ЗначениеЗаполнено(Реквизиты.ДатаПоискаОснования),
				"искали " + Формат(Реквизиты.ДатаПоискаОснования, "ДЛФ=DT"), "в СБИС ещё не искали - «Найти исходную УПД»"));
	КонецЕсли;

	Период = ПериодПоискаУПД(Реквизиты);
	Части = Новый Массив;

	Для Каждого Кандидат Из Кандидаты Цикл

		Замечания = Новый Массив;

		Если Кандидат.Дата < Период.ДатаС ИЛИ Кандидат.Дата > Период.ДатаПо Тогда
			Если ЗначениеЗаполнено(Реквизиты.ДатаОснования) Тогда
				Замечания.Добавить(СтрШаблон("дата отличается на %1 дн. (в УКД исправляемый документ от %2)",
					Цел(Макс(Кандидат.Дата - Период.ОпорнаяДата, Период.ОпорнаяДата - Кандидат.Дата) / 86400),
					Формат(Реквизиты.ДатаОснования, "ДЛФ=D")));
			Иначе
				Замечания.Добавить("дата не попадает в год до даты УКД (дата исправляемого документа в XML не прочитана)");
			КонецЕсли;
		КонецЕсли;

		Если НЕ ИННСовпадает(Кандидат.ИНН, Реквизиты.ИННКонтрагента) Тогда
			Замечания.Добавить(СтрШаблон("ИНН контрагента %1, в УКД %2", Кандидат.ИНН, Реквизиты.ИННКонтрагента));
		КонецЕсли;

		Если ЭАрМ_УтверждениеСБИС.ДокументЗакрытВСБИС(Кандидат.КодСостояния, Кандидат.Состояние) Тогда
			Замечания.Добавить(СтрШаблон("закрыта в СБИС (%1): корректировка свяжется с УПД, которую поставщик пришлёт взамен",
				Кандидат.Состояние));
		КонецЕсли;

		Если Замечания.Количество() = 0 Тогда
			Замечания.Добавить("подходит, связь запишется при следующем проходе шага «Корректировки УПД»");
		КонецЕсли;

		Части.Добавить(СтрШаблон("УПД № %1 от %2: %3", Кандидат.Номер,
			Формат(Кандидат.Дата, "ДЛФ=D"), СтрСоединить(Замечания, ", ")));

	КонецЦикла;

	Возврат СтрШаблон("УПД с номером %1 есть, но не подошла: %2",
		Реквизиты.НомерОснования, СтрСоединить(Части, "; "));

КонецФункции

// УПД реестра, номер которых совпадает с номером исправляемого документа.
//
// Возвращаемое значение:
//   Массив из Структура - Номер, Дата, ИНН
//
Функция УПДПоНомеру(НомерОснования, ИдентификаторУКД)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.ИННКонтрагента КАК ИНН,
	|	УПД.КодСостояния КАК КодСостояния,
	|	УПД.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.Формат <> &Формат
	|	И УПД.ИдентификаторСБИС <> &ИдентификаторУКД
	|	И УПД.Номер <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	УПД.Дата УБЫВ";
	Запрос.УстановитьПараметр("Формат", ФорматКорректировки());
	Запрос.УстановитьПараметр("ИдентификаторУКД", ИдентификаторУКД);

	Результат = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() И Результат.Количество() < 5 Цикл
		Если ЭАрМ_Служебный.НомераСовпадают(Выборка.Номер, НомерОснования) Тогда
			Результат.Добавить(Новый Структура("Номер, Дата, ИНН, КодСостояния, Состояние",
				СокрЛП(Выборка.Номер), Выборка.Дата, СокрЛП(Выборка.ИНН),
				СокрЛП(Выборка.КодСостояния), СокрЛП(Выборка.Состояние)));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Несвязанные корректировки, которые подходят к УПД: номер исправляемого
// документа совпадает с номером УПД (и ИНН не противоречит), а если номер
// не прочитан - тот же ИНН и дата УКД в пределах 90 дней после УПД.
// Закрытые в СБИС корректировки не предлагаются.
//
Функция ПодходящиеНесвязанныеКорректировки(РеквизитыУПД)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УКД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УКД.НомерОснования КАК НомерОснования,
	|	УКД.ИННКонтрагента КАК ИНН,
	|	УКД.Дата КАК Дата
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.ИдентификаторОснования = """"
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УКД") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	УКД.Дата";

	ИННУПД = ТолькоЦифры(РеквизитыУПД.ИННКонтрагента);
	Результат = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если ЗначениеЗаполнено(Выборка.НомерОснования) Тогда
			// Номера повторяются у разных поставщиков
			Подходит = ЭАрМ_Служебный.НомераСовпадают(Выборка.НомерОснования, РеквизитыУПД.Номер)
				И ИННСовпадает(Выборка.ИНН, РеквизитыУПД.ИННКонтрагента);
		Иначе
			Подходит = ЗначениеЗаполнено(ИННУПД)
				И ТолькоЦифры(Выборка.ИНН) = ИННУПД
				И Выборка.Дата >= НачалоДня(РеквизитыУПД.Дата)
				И Выборка.Дата <= КонецДня(РеквизитыУПД.Дата) + 90 * 86400;
		КонецЕсли;

		Если Подходит Тогда
			Результат.Добавить(СокрЛП(Выборка.ИдентификаторСБИС));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЕстьСтрокиКорректировки(ИдентификаторУКД)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Товары.НомерПозиции КАК НомерПозиции
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &ИдентификаторУКД
	|	И Товары.ИсточникТоваров = &Источник";
	Запрос.УстановитьПараметр("ИдентификаторУКД", ИдентификаторУКД);
	Запрос.УстановитьПараметр("Источник", ИсточникТоваровКорректировки());

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Строки УПД по номеру позиции: от них считаются значения «было» у строк УКД.
//
// Возвращаемое значение:
//   Соответствие - НомерПозиции (Число) → Структура: Наименование, Количество, Цена, Сумма
//
Функция СтрокиУПДПоПозициям(ИдентификаторУПД)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.Наименование КАК Наименование,
	|	Товары.Штрихкод КАК Штрихкод,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &ИдентификаторУПД
	|	И Товары.ИсточникТоваров = ""УПД""";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	Результат = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.НомерПозиции, Новый Структура("Наименование, Штрихкод, Количество, Цена, Сумма",
			СокрЛП(Выборка.Наименование), СокрЛП(Выборка.Штрихкод), Выборка.Количество, ЦенаСтроки(Выборка), Выборка.Сумма));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Описание одной корректировки для цепочки со строками «было -> стало».
//
// Параметры:
//   ТекущиеСтроки - Соответствие - см. СтрокиУПДПоПозициям; значения «стало»
//                   записываются обратно - для следующей корректировки это «было»
//
Функция ОписаниеКорректировкиДляЦепочки(ИдентификаторУКД, Реквизиты, Причина, ТекущиеСтроки)

	Описание = Новый Структура("ИдентификаторУКД, Номер, Дата, Связана, РасхожденийНет, Утверждено,"
		+ " ТекстСверки, Причина, Строки");
	Описание.ИдентификаторУКД = ИдентификаторУКД;
	Описание.Номер            = СокрЛП(Реквизиты.Номер);
	Описание.Дата             = Реквизиты.Дата;
	Описание.Связана          = НЕ ЗначениеЗаполнено(Причина);
	Описание.РасхожденийНет   = Реквизиты.РасхожденийНет;
	Описание.Утверждено       = Реквизиты.Утверждено;
	Описание.ТекстСверки      = СокрЛП(Реквизиты.ТекстСверки);
	Описание.Причина          = Причина;
	Описание.Строки           = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.Наименование КАК Наименование,
	|	Товары.Штрихкод КАК Штрихкод,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &ИдентификаторУКД
	|	И Товары.ИсточникТоваров = &Источник
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерПозиции";
	Запрос.УстановитьПараметр("ИдентификаторУКД", ИдентификаторУКД);
	Запрос.УстановитьПараметр("Источник", ИсточникТоваровКорректировки());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		КлючСтроки = Выборка.НомерПозиции;
		СтрокаДо = ТекущиеСтроки.Получить(КлючСтроки);

		Если СтрокаДо <> Неопределено И НЕ ШтрихкодУКДПодходитКСтрокеУПД(СтрокаДо, Выборка.Штрихкод) Тогда
			СтрокаДо = Неопределено;
		КонецЕсли;

		Если СтрокаДо = Неопределено И ЗначениеЗаполнено(Выборка.Штрихкод) Тогда
			Для Каждого КлючЗначение Из ТекущиеСтроки Цикл
				Если ШтрихкодУКДПодходитКСтрокеУПД(КлючЗначение.Значение, Выборка.Штрихкод)
					И ЗначениеЗаполнено(КлючЗначение.Значение.Штрихкод) Тогда
					КлючСтроки = КлючЗначение.Ключ;
					СтрокаДо = КлючЗначение.Значение;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// Номер позиции разметки не совпал - ищем строку УПД по наименованию
		Если СтрокаДо = Неопределено Тогда
			Для Каждого КлючЗначение Из ТекущиеСтроки Цикл
				Если ЭАрМ_СверкаТоваровЦепочки.НаименованияСовпадают(
						Выборка.Наименование, КлючЗначение.Значение.Наименование) Тогда
					КлючСтроки = КлючЗначение.Ключ;
					СтрокаДо = КлючЗначение.Значение;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// Корректировка только цены может прийти без количества - оно прежнее
		Количество = Выборка.Количество;
		Если Количество = 0 И Выборка.Сумма <> 0 И СтрокаДо <> Неопределено Тогда
			Количество = СтрокаДо.Количество;
		КонецЕсли;

		// Цена с НДС, как у строк УПД (см. ЦенаСтроки)
		Цена = Выборка.Цена;
		Если Количество <> 0 И Выборка.Сумма <> 0 Тогда
			Цена = Выборка.Сумма / Количество;
		КонецЕсли;

		СтрокаОписания = Новый Структура("НомерПозиции, Наименование, Штрихкод, КоличествоДо, ЦенаДо,"
			+ " Количество, Цена, Сумма, Изменение, ПризнакИзменения",
			Выборка.НомерПозиции, СокрЛП(Выборка.Наименование), СокрЛП(Выборка.Штрихкод), 0, 0,
			Количество, Цена, Выборка.Сумма, ТекстИзменения(СтрокаДо, Количество, Цена, Выборка.Сумма),
			ПризнакИзмененияСтроки(СтрокаДо, Количество, Цена, Выборка.Сумма));
		Если СтрокаДо <> Неопределено Тогда
			СтрокаОписания.КоличествоДо = СтрокаДо.Количество;
			СтрокаОписания.ЦенаДо       = СтрокаДо.Цена;
		КонецЕсли;
		Описание.Строки.Добавить(СтрокаОписания);

		ТекущиеСтроки.Вставить(КлючСтроки, Новый Структура("Наименование, Штрихкод, Количество, Цена, Сумма",
			?(СтрокаДо = Неопределено, СтрокаОписания.Наименование, СтрокаДо.Наименование),
			СокрЛП(?(СтрокаДо = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СтрокаДо.Штрихкод),
				Выборка.Штрихкод, СтрокаДо.Штрихкод)),
			Количество, Цена, Выборка.Сумма));

	КонецЦикла;

	Возврат Описание;

КонецФункции

// Признак изменения строки корректировки против строки УПД:
//   "Убрана"       - количество обнулено (товар убран из накладной, возврат);
//   "Уменьшение"   - сумма (или количество) уменьшилась - частичный возврат;
//   "Увеличение"   - сумма (или количество) выросла - доплата;
//   "Новая"        - строки в УПД не было;
//   "БезИзменений" - значения совпадают.
// Единый источник знака изменения: текст в ТекстИзменения и маркеры ▼/▲
// в дереве формы строятся по нему же.
//
// Параметры:
//   СтрокаДо   - Структура - строка УПД (Количество, Цена, Сумма), Неопределено
//                - строка в УПД не найдена
//   Количество - Число - значение после корректировки
//   Цена       - Число - значение после корректировки
//   Сумма      - Число - значение после корректировки
//
// Возвращаемое значение:
//   Строка
//
Функция ПризнакИзмененияСтроки(СтрокаДо, Количество, Цена, Сумма) Экспорт

	Если СтрокаДо = Неопределено Тогда
		Возврат "Новая";
	КонецЕсли;

	Если Количество = 0 И СтрокаДо.Количество <> 0 Тогда
		Возврат "Убрана";
	КонецЕсли;

	// Знак - по сумме строки, а если она не изменилась - по количеству
	Если Сумма < СтрокаДо.Сумма ИЛИ (Сумма = СтрокаДо.Сумма И Количество < СтрокаДо.Количество) Тогда
		Возврат "Уменьшение";
	КонецЕсли;

	Если Сумма > СтрокаДо.Сумма ИЛИ (Сумма = СтрокаДо.Сумма И Количество > СтрокаДо.Количество) Тогда
		Возврат "Увеличение";
	КонецЕсли;

	Возврат "БезИзменений";

КонецФункции

// Что поменяла строка корректировки: «▼ уменьшение: кол-во 10 -> 8,
// цена 100 -> 95». Маркер ▼ - уменьшение (возврат товара по корректировке),
// ▲ - увеличение (доплата); знак берёт ПризнакИзмененияСтроки.
//
Функция ТекстИзменения(СтрокаДо, Количество, Цена, Сумма)

	Признак = ПризнакИзмененияСтроки(СтрокаДо, Количество, Цена, Сумма);

	Если Признак = "Новая" Тогда
		Возврат СтрШаблон("строки нет в УПД: %1", ЧислоИЦена(Количество, Цена));
	КонецЕсли;

	Если Признак = "Убрана" Тогда
		Возврат СтрШаблон("▼ возврат: убрана из накладной (было %1)",
			ЧислоИЦена(СтрокаДо.Количество, СтрокаДо.Цена));
	КонецЕсли;

	Части = Новый Массив;
	Если Количество <> СтрокаДо.Количество Тогда
		Части.Добавить(СтрШаблон("кол-во %1 -> %2", ЧислоТекстом(СтрокаДо.Количество), ЧислоТекстом(Количество)));
	КонецЕсли;
	Если Цена <> СтрокаДо.Цена Тогда
		Части.Добавить(СтрШаблон("цена %1 -> %2", ЧислоТекстом(СтрокаДо.Цена), ЧислоТекстом(Цена)));
	КонецЕсли;
	Если Части.Количество() = 0 И Сумма <> СтрокаДо.Сумма Тогда
		Части.Добавить(СтрШаблон("сумма %1 -> %2", ЧислоТекстом(СтрокаДо.Сумма), ЧислоТекстом(Сумма)));
	КонецЕсли;

	Если Части.Количество() = 0 Тогда
		Возврат "без изменений";
	КонецЕсли;

	Маркер = "";
	Если Признак = "Уменьшение" Тогда
		Маркер = "▼ уменьшение: ";
	ИначеЕсли Признак = "Увеличение" Тогда
		Маркер = "▲ увеличение: ";
	КонецЕсли;

	Возврат Маркер + СтрСоединить(Части, ", ");

КонецФункции

Функция ШтрихкодУКДПодходитКСтрокеУПД(СтрокаУПД, ШтрихкодУКД)

	Если НЕ ЗначениеЗаполнено(ШтрихкодУКД) Тогда
		Возврат Истина;
	КонецЕсли;

	ШтрихкодУПД = "";
	Если НЕ СтрокаУПД.Свойство("Штрихкод", ШтрихкодУПД) ИЛИ НЕ ЗначениеЗаполнено(ШтрихкодУПД) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЭАрМ_СверкаТоваровЦепочки.ШтрихкодыСовпадают(ШтрихкодУПД, ШтрихкодУКД);

КонецФункции

// Цена строки регистра товаров с НДС: сумма (с НДС) на количество. Поле Цена -
// ЦенаТов документа без НДС, берём его, только когда суммы нет.
//
Функция ЦенаСтроки(СтрокаТоваров)

	Если СтрокаТоваров.Сумма = 0 ИЛИ СтрокаТоваров.Количество = 0 Тогда
		Возврат СтрокаТоваров.Цена;
	КонецЕсли;

	Возврат СтрокаТоваров.Сумма / СтрокаТоваров.Количество;

КонецФункции

// Корректировки, связанные с УПД, по порядку дат.
// Дубль (тот же номер и дата) не возвращается: берётся загруженный последним.
//
// Возвращаемое значение:
//   Массив из Строка - идентификаторы СБИС незакрытых УКД
//
Функция КорректировкиУПД(ИдентификаторУПД) Экспорт

	Результат = Новый Массив;
	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УКД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УКД.Номер КАК Номер,
	|	УКД.Дата КАК Дата
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.ИдентификаторОснования = &ИдентификаторУПД
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УКД") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	УКД.Дата,
	|	УКД.ДатаЗагрузки УБЫВ";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	// Одна корректировка может прийти в СБИС несколькими документами (повторная
	// отправка, роуминг): с тем же номером и датой берём одну - загруженную последней
	Учтенные = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = КлючКорректировки(Выборка.Номер, Выборка.Дата);
		Если Учтенные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Учтенные.Вставить(Ключ, Истина);
		Результат.Добавить(СокрЛП(Выборка.ИдентификаторСБИС));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ход загрузки для формы реестра УКД: идут ли сейчас фоновые задания АРМ ЭДО
// (регламентный обмен, приём пакетов Далиона, тест приёма и сверки) и сколько с
// начала самого раннего из них загружено и обработано - по базе:
//   * УКД загружено (ДатаЗагрузки), из них связано с исходной УПД и аннулировано;
//   * цепочек сверено и сколько с расхождениями;
//   * последний шаг трассы приёма.
// Идёт тест - добавляется его этап и счётчики (ЭАрМ_ТестУпаковок.ТекстПрогрессаТеста).
//
// Возвращаемое значение:
//   Структура - Идет (Булево), Текст (Строка)
//
Функция ХодЗагрузкиРеестров() Экспорт

	Результат = Новый Структура("Идет, Текст", Ложь, "");

	УстановитьПривилегированныйРежим(Истина);
	Активные = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно));

	Работы = Новый Массив;
	Начало = Неопределено;
	ИдетТест = Ложь;
	Для Каждого Задание Из Активные Цикл
		Если НЕ СтрНачинаетсяС(Задание.ИмяМетода, "ЭАрМ_") Тогда
			Продолжить;
		КонецЕсли;
		Работы.Добавить(СтрШаблон("%1 с %2", ?(ЗначениеЗаполнено(Задание.Наименование), Задание.Наименование,
			Задание.ИмяМетода), Формат(Задание.Начало, "ДФ=HH:mm:ss")));
		Начало = ?(Начало = Неопределено, Задание.Начало, Мин(Начало, Задание.Начало));
		ИдетТест = ИдетТест ИЛИ Задание.Ключ = "ЭАрМ_ТестПриемаИСверки";
	КонецЦикла;

	Если Работы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(УКД.ИдентификаторСБИС) КАК Загружено,
	|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА УКД.ИдентификаторОснования = """" ТОГДА 0 ИНАЧЕ 1 КОНЕЦ), 0) КАК Связано,
	|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УКД") + " ТОГДА 0 ИНАЧЕ 1 КОНЕЦ), 0) КАК Аннулировано
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.ДатаЗагрузки >= &Начало
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Сверено,
	|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА Цепочка.ЕстьРасхождения ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК СРасхождениями
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ДатаСверки >= &Начало
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Трасса.ДатаШага КАК ДатаШага,
	|	Трасса.Шаг КАК Шаг,
	|	Трасса.Сообщение КАК Сообщение
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТрассаПриема КАК Трасса
	|ГДЕ
	|	Трасса.ДатаШага >= &Начало
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаШага УБЫВ");
	Запрос.УстановитьПараметр("Начало", Начало);
	Результаты = Запрос.ВыполнитьПакет();

	ВыборкаУКД = Результаты[0].Выбрать();
	ВыборкаУКД.Следующий();
	ВыборкаЦепочек = Результаты[1].Выбрать();
	ВыборкаЦепочек.Следующий();
	ВыборкаТрассы = Результаты[2].Выбрать();
	Сейчас = "";
	Если ВыборкаТрассы.Следующий() Тогда
		Сейчас = СтрШаблон("%1 %2: %3", Формат(ВыборкаТрассы.ДатаШага, "ДФ=HH:mm:ss"), СокрП(ВыборкаТрассы.Шаг),
			Лев(СтрЗаменить(СокрП(ВыборкаТрассы.Сообщение), Символы.ПС, " "), 200));
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("Идёт загрузка: " + СтрСоединить(Работы, "; "));
	Строки.Добавить(СтрШаблон("С %1 загружено УКД %2 (связано с исходной УПД %3, аннулированных %4) · сверено цепочек %5 (с расхождениями %6)",
		Формат(Начало, "ДФ=HH:mm:ss"), ВыборкаУКД.Загружено, ВыборкаУКД.Связано, ВыборкаУКД.Аннулировано,
		ВыборкаЦепочек.Сверено, ВыборкаЦепочек.СРасхождениями));
	Если ИдетТест Тогда
		Попытка
			Строки.Добавить("Тест: " + СтрЗаменить(ЭАрМ_ТестУпаковок.ТекстПрогрессаТеста(Начало), Символы.ПС, " · "));
		Исключение
			Строки.Добавить("Тест: ход не прочитан - " + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	Если ЗначениеЗаполнено(Сейчас) Тогда
		Строки.Добавить("Сейчас: " + Сейчас);
	КонецЕсли;

	Результат.Идет = Истина;
	Результат.Текст = СтрСоединить(Строки, Символы.ПС);

	Возврат Результат;

КонецФункции

// Ключ дублей корректировки: нормализованный номер и дата.
//
Функция КлючКорректировки(Номер, Дата)

	Возврат ЭАрМ_Служебный.НомерДляСравнения(Номер) + "|" + Формат(Дата, "ДФ=yyyyMMdd");

КонецФункции

// Меняет поля строки реестра УПД или УКД под блокировкой; без изменений не пишет.
//
// Параметры:
//   ИмяРегистра       - Строка - ЭАрМ_УПД_Входящий или ЭАрМ_УКД_Входящий
//   ИдентификаторСБИС - Строка
//   Изменения         - Структура - имя поля и новое значение
//   ОжидаетУКД        - Булево, Неопределено - только вместе с РасхожденийНет = Ложь:
//                       Истина ставит статус «Ожидает УКД», Ложь снимает его;
//                       Неопределено статус «Ожидает УКД» не трогает
//   НетВозвратаДалиона - Булево, Неопределено - так же для статуса «УКД есть, нет
//                       возврата из Далиона» (ЭАрМ_СтатусыПодписанияЭДО.НетВозвратаДалиона);
//                       «Ожидает УКД» важнее, если Истина оба
//
Процедура ИзменитьСтрокуРеестра(ИмяРегистра, ИдентификаторСБИС, Изменения, ОжидаетУКД = Неопределено,
	НетВозвратаДалиона = Неопределено) Экспорт

	НачатьТранзакцию();
	Попытка

		ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра(
			"РегистрСведений." + ИмяРегистра, ИдентификаторСБИС);

		МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторСБИС;
		МенеджерЗаписи.Прочитать();

		Если НЕ МенеджерЗаписи.Выбран() Тогда
			ОтменитьТранзакцию();
			// Пустой идентификатор - менять нечего (документа в цепочке нет), это не ошибка
			Если ЗначениеЗаполнено(ИдентификаторСБИС) Тогда
				Поля = Новый Массив;
				Для Каждого КлючЗначение Из Изменения Цикл
					Поля.Добавить(КлючЗначение.Ключ);
				КонецЦикла;
				ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(ИдентификаторСБИС, "ИзменитьСтрокуРеестра",
					СтрШаблон("строки нет в %1 - поля %2 не записаны", ИмяРегистра, СтрСоединить(Поля, ", ")));
			КонецЕсли;
			Возврат;
		КонецЕсли;

		Изменено = Ложь;
		Для Каждого КлючЗначение Из Изменения Цикл
			Если МенеджерЗаписи[КлючЗначение.Ключ] <> КлючЗначение.Значение Тогда
				МенеджерЗаписи[КлючЗначение.Ключ] = КлючЗначение.Значение;
				Изменено = Истина;
			КонецЕсли;
		КонецЦикла;

		Если Изменения.Свойство("РасхожденийНет") Тогда
			ПрежнийСтатус = МенеджерЗаписи.СтатусПодписания;
			Статусы = Перечисления.ЭАрМ_СтатусыПодписанияЭДО;
			Если Изменения.РасхожденийНет Тогда
				// Сошлась (в том числе с учётом пришедшей УКД) - из «Ожидает УКД»
				// тоже поднимается
				ЭАрМ_УтверждениеСБИС.ПовыситьСтатусПодписания(МенеджерЗаписи, Статусы.ГотовКОтправке);
			ИначеЕсли ОжидаетУКД = Истина
				И (НЕ ЗначениеЗаполнено(ПрежнийСтатус)
					ИЛИ ПрежнийСтатус = Статусы.ГотовКОтправке
					ИЛИ ПрежнийСтатус = Статусы.ОжидаетУКД
					ИЛИ ПрежнийСтатус = Статусы.НетВозвратаДалиона) Тогда
				МенеджерЗаписи.СтатусПодписания = Статусы.ОжидаетУКД;
			ИначеЕсли НетВозвратаДалиона = Истина
				И (НЕ ЗначениеЗаполнено(ПрежнийСтатус)
					ИЛИ ПрежнийСтатус = Статусы.ГотовКОтправке
					ИЛИ ПрежнийСтатус = Статусы.ОжидаетУКД
					ИЛИ ПрежнийСтатус = Статусы.НетВозвратаДалиона) Тогда
				// УКД уменьшила УПД, а приходная Далиона больше - возврат в Далионе не проведён
				МенеджерЗаписи.СтатусПодписания = Статусы.НетВозвратаДалиона;
			ИначеЕсли ПрежнийСтатус = Статусы.ГотовКОтправке
				ИЛИ ОжидаетУКД = Ложь И ПрежнийСтатус = Статусы.ОжидаетУКД
				ИЛИ НетВозвратаДалиона = Ложь И ПрежнийСтатус = Статусы.НетВозвратаДалиона Тогда
				МенеджерЗаписи.СтатусПодписания = Статусы.ПустаяСсылка();
			КонецЕсли;
			// У корректировки этих статусов не бывает - ждёт сама УПД. Старый статус
			// (строка переехала из реестра УПД) снимается при записи сверки
			Если ИмяРегистра = "ЭАрМ_УКД_Входящий"
				И (МенеджерЗаписи.СтатусПодписания = Статусы.ОжидаетУКД
					ИЛИ МенеджерЗаписи.СтатусПодписания = Статусы.НетВозвратаДалиона) Тогда
				МенеджерЗаписи.СтатусПодписания = Статусы.ПустаяСсылка();
			КонецЕсли;
			Если МенеджерЗаписи.СтатусПодписания <> ПрежнийСтатус Тогда
				Изменено = Истина;
			КонецЕсли;
			Если НЕ Изменения.Свойство("КОтправке")
				И НЕ Изменения.РасхожденийНет
				И МенеджерЗаписи.КОтправке Тогда
				МенеджерЗаписи.КОтправке = Ложь;
				Изменено = Истина;
			КонецЕсли;
		КонецЕсли;

		Если Изменено Тогда
			МенеджерЗаписи.Записать(Истина);
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторСБИС,
			"ИзменитьСтрокуРеестра (" + ИмяРегистра + " не записан)", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция НаименованиеЛинии(Линия)

	Для Каждого ИмяСтроки Из СтрРазделить("УПД,Поступление,Заказ,ЭТрН", ",") Цикл
		СтрокаДокумента = Линия[ИмяСтроки];
		Если СтрокаДокумента <> Неопределено И ЗначениеЗаполнено(СтрокаДокумента.Наименование) Тогда
			Возврат СтрокаДокумента.Наименование;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЧислоИЦена(Количество, Цена)

	Возврат СтрШаблон("%1 x %2", Формат(Количество, "ЧН=0; ЧГ=0"), Формат(Цена, "ЧН=0; ЧГ=0"));

КонецФункции

Функция ЧислоТекстом(Значение)

	Возврат Формат(Значение, "ЧН=0; ЧГ=0");

КонецФункции

// Пустой ИНН с любой стороны связь не опровергает: у части документов СБИС
// ИНН в реестр не попадает.
//
Функция ИННСовпадает(ИНН1, ИНН2)

	Цифры1 = ТолькоЦифры(ИНН1);
	Цифры2 = ТолькоЦифры(ИНН2);

	Если НЕ ЗначениеЗаполнено(Цифры1) ИЛИ НЕ ЗначениеЗаполнено(Цифры2) Тогда
		Возврат Истина;
	КонецЕсли;

	Длина = Мин(СтрДлина(Цифры1), СтрДлина(Цифры2), 12);

	Возврат Лев(Цифры1, Длина) = Лев(Цифры2, Длина);

КонецФункции

// Фасад: делегирует в ЭАрМ_ПодборНоменклатуры (единая реализация).
Функция ТолькоЦифры(Значение)

	Возврат ЭАрМ_ПодборНоменклатуры.ТолькоЦифры(Значение);

КонецФункции

Процедура ЗаписатьВЖурнал(ИдентификаторСБИС, Успех, Текст)

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторСБИС, 100), "КорректировкиУПД", Успех, Текст);

КонецПроцедуры

