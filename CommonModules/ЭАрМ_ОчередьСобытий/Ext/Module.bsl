////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_ОчередьСобытий: «событие → очередь → одно задание».
//
// Подписки ПриЗаписи раньше делали работу прямо в транзакции записи: запросы
// в цикле, вызов веб-сервиса СБИС, строка в журнал регистрации на каждую запись.
// Теперь они только ставят отметку изменений (ЭАрМ_ИзмененияРеестров) и строку
// в очередь ЭАрМ_ОчередьСобытий, а работу делает регламентное задание
// ЭАрМ_ОбработкаОчереди (раз в минуту):
//   СверкаУПД     - сверка только этих документов (ключ - ИдентификаторСБИС);
//   ЭТрН          - обработка входящего ЭТрН (ключ и объект - ссылка документа);
//   Подтверждение - поиск электронных документов объекта учёта и отправка на
//                   подтверждение, если ещё не отправлен.
//
// Защита от зацикливания: задание само пишет итоги сверки в реестры, и это
// снова вызывает подписку. Поэтому в сеансе задания стоит параметр сеанса
// ЭАрМ_БезОчереди (так же действует ДополнительныеСвойства.ЭАрМ_БезОчереди у
// набора или объекта и ОбменДанными.Загрузка): подписка тогда ставит только
// отметку изменений, строку очереди - нет.
//
// Настройка «Обработка событий через очередь» выключена - подписки работают
// по-старому, старый код оставлен за этим флажком.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обработчик подписки ЭАрМ_ПриЗаписиРеестровЭДО: запись реестров УПД, УКД, ЭТрН и
// цепочки закупок. Ничего не читает из базы, кроме записей набора.
//
Процедура ПриЗаписиРеестра(Источник, Отказ, Замещение) Экспорт

	Если НЕ ЭАрМ_ОчередьСобытийПовтИсп.ОчередьВключена() Тогда
		Возврат;
	КонецЕсли;

	ИмяРегистра = Источник.Метаданные().Имя;

	Реестр = "";
	Если ИмяРегистра = "ЭАрМ_УПД_Входящий" Тогда
		Реестр = "УПД";
	ИначеЕсли ИмяРегистра = "ЭАрМ_УКД_Входящий" Тогда
		Реестр = "УКД";
	ИначеЕсли ИмяРегистра = "ЭАрМ_РеестрЭТрН" Тогда
		Реестр = "ЭТрН";
	КонецЕсли;

	// Отметку ставим всегда (и при записи из задания, и при загрузке обмена):
	// форма должна увидеть, что данные поменялись
	Если ЗначениеЗаполнено(Реестр) Тогда
		Попытка
			ЭАрМ_ИзмененияРеестров.Отметить(Реестр);
		Исключение
			// Запись реестра из-за отметки падать не должна
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"ЭАрМ_ОчередьСобытий: отметка изменений реестра " + Реестр + " не записана", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Если БезОчереди(Источник) Тогда
		Возврат;
	КонецЕсли;

	Строки = Новый Массив;
	Если Реестр = "УПД" ИЛИ Реестр = "УКД" Тогда
		Для Каждого Запись Из Источник Цикл
			Строки.Добавить(Новый Структура("Вид, Ключ", "СверкаУПД", Запись.ИдентификаторСБИС));
		КонецЦикла;
	ИначеЕсли ИмяРегистра = "ЭАрМ_ЦепочкаЗакупки" Тогда
		// Пришла приходная или связь цепочки: УПД, к которой она относится, надо пересверить
		Для Каждого Запись Из Источник Цикл
			Если ЗначениеЗаполнено(Запись.ИдентификаторУПД) Тогда
				Строки.Добавить(Новый Структура("Вид, Ключ", "СверкаУПД", Запись.ИдентификаторУПД));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ПоставитьИзПодписки(Строки);

КонецПроцедуры

// Подписка на запись входящего ЭДО (документ): ЭТрН - строка в очередь.
//
Процедура ПоставитьВходящийЭДО(Источник) Экспорт

	Если БезОчереди(Источник) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Источник.ВидДокумента) Тогда
		Возврат;
	КонецЕсли;

	Если ЭАрМ_ОчередьСобытийПовтИсп.ТипДокументаПоВиду(Источник.ВидДокумента) <> Перечисления.ТипыДокументовЭДО.ЭТрН Тогда
		Возврат;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(Новый Структура("Вид, Ключ, Объект", "ЭТрН",
		Строка(Источник.Ссылка.УникальныйИдентификатор()), Источник.Ссылка));
	ПоставитьИзПодписки(Строки);

КонецПроцедуры

// Подписка на запись состояния ЭДО (регистр): по объекту учёта - строка
// «Подтверждение».
//
Процедура ПоставитьСостоянияОбъектов(Источник) Экспорт

	Если Источник.Количество() = 0 ИЛИ БезОчереди(Источник) Тогда
		Возврат;
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого Запись Из Источник Цикл
		СсылкаНаОбъект = Запись.СсылкаНаОбъект;
		Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
			Строки.Добавить(Новый Структура("Вид, Ключ, Объект", "Подтверждение",
				Строка(СсылкаНаОбъект.УникальныйИдентификатор()), СсылкаНаОбъект));
		КонецЕсли;
	КонецЦикла;
	ПоставитьИзПодписки(Строки);

КонецПроцедуры

// Постановка из подписки: ошибка постановки не должна ронять запись документа или
// реестра, поэтому она идёт в трассу «ОШИБКА ПРОВЕРКИ», а запись продолжается.
//
Процедура ПоставитьИзПодписки(Строки)

	Попытка
		ПоставитьПачкой(Строки);
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ЭАрМ_ОчередьСобытий: событие не поставлено в очередь", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Ставит строки в очередь. Строка с тем же видом и ключом не плодится:
// обновляются момент и счётчик попыток.
//
// Параметры:
//   Строки - Массив из Структура - Вид, Ключ, Объект (необязательно)
//
Процедура ПоставитьПачкой(Строки) Экспорт

	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Момент = ТекущаяДатаСеанса();
	Уникальные = Новый Соответствие;

	Для Каждого Элемент Из Строки Цикл

		Ключ = Лев(СокрЛП(Строка(Элемент.Ключ)), 150);
		Если НЕ ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		ПризнакУникальности = Элемент.Вид + "|" + ВРег(Ключ);
		Если Уникальные.Получить(ПризнакУникальности) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уникальные.Вставить(ПризнакУникальности, Истина);

		// Запись с заменой по ключу (Вид, Ключ): без чтения и без ошибки «запись
		// с такими ключевыми полями существует»
		Запись = РегистрыСведений.ЭАрМ_ОчередьСобытий.СоздатьМенеджерЗаписи();
		Запись.Вид = Элемент.Вид;
		Запись.Ключ = Ключ;
		Если Элемент.Свойство("Объект") И ЗначениеЗаполнено(Элемент.Объект) Тогда
			Запись.Объект = Элемент.Объект;
		КонецЕсли;
		Запись.Момент = Момент;
		Запись.Попыток = 0;
		Запись.ТекстОшибки = "";
		Запись.СледующаяПопытка = '00010101';
		Запись.Записать(Истина);

	КонецЦикла;

КонецПроцедуры

// Запись идёт из задания очереди, из обмена данными или помечена
// ДополнительныеСвойства.ЭАрМ_БезОчереди: строку очереди не ставим (иначе
// итог сверки снова вызвал бы сверку).
//
Функция БезОчереди(Источник) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат Истина;
	КонецЕсли;

	Значение = Неопределено;
	Если Источник.ДополнительныеСвойства.Свойство("ЭАрМ_БезОчереди", Значение) И Значение = Истина Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ПризнакБезОчереди();

КонецФункции

// Параметр сеанса ЭАрМ_БезОчереди: Истина в сеансе задания обработки очереди.
//
Функция ПризнакБезОчереди() Экспорт

	Попытка
		Возврат ПараметрыСеанса.ЭАрМ_БезОчереди = Истина;
	Исключение
		// Параметр сеанса ещё не получил значения (в новом сеансе так и бывает, если
		// обработчик модуля сеанса его не задал) - начальное значение «Ложь».
		// Запись в реестр из-за этого падать не должна
		Попытка
			ПараметрыСеанса.ЭАрМ_БезОчереди = Ложь;
		Исключение
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"ЭАрМ_ОчередьСобытий: параметр сеанса ЭАрМ_БезОчереди не установлен", ИнформацияОбОшибке());
		КонецПопытки;
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Регламентное задание ЭАрМ_ОбработкаОчереди (раз в минуту).
//
// Очередь пуста - сразу выход после одного чтения. Иначе пачка до 200 строк.
// Успех - строка удаляется. Ошибка - Попыток + 1 и СледующаяПопытка через
// 1, 5, 15, 60 минут; после 5 попыток строка остаётся с ТекстОшибки, в трассу
// идёт «ОШИБКА ПРОВЕРКИ». Итог прогона - одна строка в трассу.
//
Процедура ОбработатьОчередь() Экспорт

	Сейчас = ТекущаяДатаСеанса();

	Строки = СтрокиКОбработке(Сейчас);
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ЭАрМ_НастройкиСервер.ФоновыеЗаданияОтключены() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
			Метаданные.РегламентныеЗадания.ЭАрМ_ОбработкаОчереди);
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ОбработатьОчередь (начало регламентного задания)", ИнформацияОбОшибке());
	КонецПопытки;

	Итог = Новый Структура("Обработано, Ошибок, ПоВидам", 0, 0, Новый Соответствие);

	// В сеансе задания записи реестров не ставят строки очереди
	ПараметрыСеанса.ЭАрМ_БезОчереди = Истина;
	Попытка
		ОбработатьСтроки(Строки, Сейчас, Итог);
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "ОбработатьОчередь", ИнформацияОбОшибке());
	КонецПопытки;
	ПараметрыСеанса.ЭАрМ_БезОчереди = Ложь;

	Части = Новый Массив;
	Для Каждого КлючИЗначение Из Итог.ПоВидам Цикл
		Части.Добавить(СтрШаблон("%1 %2", КлючИЗначение.Ключ, КлючИЗначение.Значение));
	КонецЦикла;

	ЭАрМ_ПриемПакетовДалион.Трасса("", СтрШаблон(
		НСтр("ru = 'Очередь событий: в пачке %1, обработано %2 (%3), с ошибкой %4'"),
		Строки.Количество(), Итог.Обработано, СтрСоединить(Части, ", "), Итог.Ошибок), Итог.Ошибок = 0);

	// Отметки умерших сеансов (раз за непустой прогон, не на каждой пустой минуте)
	Попытка
		ЭАрМ_ИзмененияРеестров.ОчиститьСтарые();
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "ОбработатьОчередь: очистка отметок", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Единственное чтение пустой очереди: строки, которым пора (не раньше секунды
// после постановки и не раньше СледующаяПопытка), пока попыток меньше предела.
//
Функция СтрокиКОбработке(Сейчас)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 200
	|	Очередь.Вид КАК Вид,
	|	Очередь.Ключ КАК Ключ,
	|	Очередь.Объект КАК Объект,
	|	Очередь.Момент КАК Момент,
	|	Очередь.Попыток КАК Попыток
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОчередьСобытий КАК Очередь
	|ГДЕ
	|	Очередь.Момент <= &Граница
	|	И Очередь.Попыток < &МаксимумПопыток
	|	И Очередь.СледующаяПопытка <= &Сейчас
	|
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.Момент";
	// Секунда запаса: событие этой же секунды ещё может дописываться, а
	// Момент строки - то, по чему задание узнаёт, что её не успели поставить заново
	Запрос.УстановитьПараметр("Граница", Сейчас - 1);
	Запрос.УстановитьПараметр("МаксимумПопыток", МаксимумПопыток());
	Запрос.УстановитьПараметр("Сейчас", Сейчас);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция МаксимумПопыток()

	Возврат 5;

КонецФункции

// Пауза перед следующей попыткой, секунд: 1, 5, 15, 60 минут.
//
Функция ПаузаПослеПопытки(НомерПопытки)

	Паузы = Новый Массив;
	Паузы.Добавить(60);
	Паузы.Добавить(300);
	Паузы.Добавить(900);
	Паузы.Добавить(3600);

	Возврат Паузы[Мин(НомерПопытки, Паузы.Количество()) - 1];

КонецФункции

Процедура ОбработатьСтроки(Строки, Сейчас, Итог)

	// Сверка - пачкой по списку документов, остальное - по одной строке
	СверкаУПД = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Если Строка.Вид = "СверкаУПД" Тогда
			СверкаУПД.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;

	Если СверкаУПД.Количество() > 0 Тогда
		ОбработатьПачкуСверки(СверкаУПД, Сейчас, Итог);
	КонецЕсли;

	Для Каждого Строка Из Строки Цикл
		Если Строка.Вид = "СверкаУПД" Тогда
			Продолжить;
		КонецЕсли;
		ЗавершитьСтроку(Строка, ВыполнитьСтроку(Строка), Сейчас, Итог);
	КонецЦикла;

КонецПроцедуры

Процедура ОбработатьПачкуСверки(СтрокиСверки, Сейчас, Итог)

	Ключи = Новый Массив;
	Для Каждого Строка Из СтрокиСверки Цикл
		Ключи.Добавить(Строка.Ключ);
	КонецЦикла;

	Попытка
		ОбработатьСверкуУПД(Ключи);
	Исключение
		// Пачка не прошла: разбираемся по документам, чтобы один плохой не держал остальные
		ЭАрМ_ПриемПакетовДалион.Трасса("", НСтр("ru = 'Очередь событий: пачка сверки не прошла, документы по одному: '")
			+ ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()), Ложь);
		Для Каждого Строка Из СтрокиСверки Цикл
			ЗавершитьСтроку(Строка, ВыполнитьСтроку(Строка), Сейчас, Итог);
		КонецЦикла;
		Возврат;
	КонецПопытки;

	Для Каждого Строка Из СтрокиСверки Цикл
		ЗавершитьСтроку(Строка, "", Сейчас, Итог);
	КонецЦикла;

КонецПроцедуры

// Одна строка очереди. Возвращает текст ошибки, пусто - успех.
//
Функция ВыполнитьСтроку(Строка)

	Попытка

		Если Строка.Вид = "СверкаУПД" Тогда
			Ключи = Новый Массив;
			Ключи.Добавить(Строка.Ключ);
			ОбработатьСверкуУПД(Ключи);
		ИначеЕсли Строка.Вид = "ЭТрН" Тогда
			ЭАрМ_ОбщийМодуль.ОбработатьВходящийЭТрНИзОчереди(Строка.Объект);
		ИначеЕсли Строка.Вид = "Подтверждение" Тогда
			ЭАрМ_ОбщийМодуль.ОтправитьПодтверждениеПоОбъекту(Строка.Объект);
		Иначе
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный вид события «%1»'"), Строка.Вид);
		КонецЕсли;

	Исключение
		// И в строку очереди, и в трассу - короткий текст без стека вызовов
		Возврат ЭАрМ_Служебный.КраткийТекстОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат "";

КонецФункции

// Сверка только этих документов: цепочки их УПД и сводка реестра. Ключ УКД
// ведёт к УПД-основанию.
//
Процедура ОбработатьСверкуУПД(Ключи)

	Идентификаторы = Новый Массив;
	Уникальные = Новый Соответствие;
	Для Каждого Ключ Из Ключи Цикл
		Идентификаторы.Добавить(Ключ);
		Уникальные.Вставить(ВРег(Ключ), Истина);
	КонецЦикла;

	Для Каждого Основание Из ОснованияКорректировок(Ключи) Цикл
		Если Уникальные.Получить(ВРег(Основание)) = Неопределено Тогда
			Идентификаторы.Добавить(Основание);
			Уникальные.Вставить(ВРег(Основание), Истина);
		КонецЕсли;
	КонецЦикла;

	ЭАрМ_СверкаТоваровЦепочки.СверитьОжидающиеПоУПД(Идентификаторы);
	ЭАрМ_РегламентныйОбменЭДО.ОбновитьСводкуРеестраУПД(Идентификаторы);

	// Галочка «Есть ЭТрН»: по списку - по каждому, большая пачка - одним проходом
	Если Идентификаторы.Количество() <= 20 Тогда
		Для Каждого Идентификатор Из Идентификаторы Цикл
			//@skip-check query-in-loop
			ЭАрМ_РегламентныйОбменЭДО.ОбновитьПризнакЭТрНРеестраУПД(Идентификатор);
		КонецЦикла;
	Иначе
		ЭАрМ_РегламентныйОбменЭДО.ОбновитьПризнакЭТрНРеестраУПД();
	КонецЕсли;

КонецПроцедуры

// УПД-основания тех из ключей, что являются УКД.
//
Функция ОснованияКорректировок(Ключи)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УКД.ИдентификаторОснования КАК ИдентификаторОснования
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.ИдентификаторСБИС В (&Ключи)
	|	И УКД.ИдентификаторОснования <> """"";
	Запрос.УстановитьПараметр("Ключи", Ключи);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат Результат.Выгрузить().ВыгрузитьКолонку("ИдентификаторОснования");

КонецФункции

// Итог по строке: успех - строка удаляется; ошибка - Попыток + 1 и пауза.
// Строка, поставленная заново, пока её разбирали (изменился Момент), остаётся.
//
Процедура ЗавершитьСтроку(Строка, ТекстОшибки, Сейчас, Итог)

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЭАрМ_ОчередьСобытий");
		ЭлементБлокировки.УстановитьЗначение("Вид", Строка.Вид);
		ЭлементБлокировки.УстановитьЗначение("Ключ", Строка.Ключ);
		Блокировка.Заблокировать();

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОчередьСобытий.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Вид = Строка.Вид;
		МенеджерЗаписи.Ключ = Строка.Ключ;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() И МенеджерЗаписи.Момент = Строка.Момент Тогда
			Если НЕ ЗначениеЗаполнено(ТекстОшибки) Тогда
				МенеджерЗаписи.Удалить();
			Иначе
				МенеджерЗаписи.Попыток = МенеджерЗаписи.Попыток + 1;
				МенеджерЗаписи.ТекстОшибки = Лев(ТекстОшибки, 500);
				МенеджерЗаписи.СледующаяПопытка = ?(МенеджерЗаписи.Попыток < МаксимумПопыток(),
					Сейчас + ПаузаПослеПопытки(МенеджерЗаписи.Попыток), '00010101');
				МенеджерЗаписи.Записать(Истина);
			КонецЕсли;
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(Строка.Ключ,
			"ОбработатьОчередь: итог по строке " + Строка.Вид, ИнформацияОбОшибке());
		Итог.Ошибок = Итог.Ошибок + 1;
		Возврат;
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(ТекстОшибки) Тогда
		Итог.Обработано = Итог.Обработано + 1;
		Итог.ПоВидам.Вставить(Строка.Вид, ?(Итог.ПоВидам.Получить(Строка.Вид) = Неопределено, 1,
			Итог.ПоВидам.Получить(Строка.Вид) + 1));
		Возврат;
	КонецЕсли;

	Итог.Ошибок = Итог.Ошибок + 1;
	Если Строка.Попыток + 1 >= МаксимумПопыток() Тогда
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(Строка.Ключ, "ОбработатьОчередь: " + Строка.Вид,
			СтрШаблон(НСтр("ru = 'событие не обработано за %1 попыток, строка остаётся в очереди: %2'"),
				МаксимумПопыток(), Лев(ТекстОшибки, 300)));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
