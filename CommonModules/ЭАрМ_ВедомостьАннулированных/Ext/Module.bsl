// Ведомость по аннулированным документам ЭДО.
// Сигнал + даты + ссылка на замену + ведомость «вычет заявлен по аннулированному».
// Сторно книги покупок — руками бухгалтера (решение Ирины).
//
// Запуск: ЭАрМ_ВедомостьАннулированных.СформироватьВедомость(ДатаНачала, ДатаОкончания)

#Область ПрограммныйИнтерфейс

// Сформировать ведомость по аннулированным документам.
//
// Параметры:
//   ДатаНачала    - Дата - начало периода
//   ДатаОкончания - Дата - конец периода
//   Контрагент    - СправочникСсылка.Контрагенты - необязательный фильтр
//
// Возвращаемое значение:
//   Структура:
//     * Документы - Массив - строки ведомости
//     * Итоги     - Структура - {Количество, Сумма, ВычетЗаявлен}
//     * Заголовок - Строка - текст заголовка
//
Функция СформироватьВедомость(ДатаНачала, ДатаОкончания, Контрагент = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Документы", Новый Массив);
	Результат.Вставить("Итоги", Новый Структура("Количество, Сумма, ВычетЗаявлен", 0, 0, 0));
	Результат.Вставить("Заголовок", "");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.Контрагент КАК Контрагент,
	|	УПД.ИННКонтрагента КАК ИНН,
	|	УПД.СуммаУПД КАК Сумма,
	|	УПД.Состояние КАК Состояние,
	|	УПД.ЗамененаНа КАК ЗамененаНа,
	|	УПД.ДатаАннулирования КАК ДатаАннулирования,
	|	УПД.ВыгруженВБух КАК ВыгруженВБух
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.КодСостояния В (&КодыАннулирования)
	|	И УПД.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И (&Контрагент = НЕОПРЕДЕЛЕНО Или УПД.Контрагент = &Контрагент)
	|
	|УПОРЯДОЧИТЬ ПО
	|	УПД.Дата УБЫВ";

	// Коды аннулирования в СБИС
	КодыАннулирования = Новый Массив;
	КодыАннулирования.Добавить("22");  // Аннулирование
	КодыАннулирования.Добавить("27");  // Закрыт/аннулирован
	КодыАннулирования.Добавить("40");  // Отозван
	КодыАннулирования.Добавить("19");  // Отказ
	КодыАннулирования.Добавить("20");  // Отказ
	КодыАннулирования.Добавить("21");  // Отказ

	Запрос.УстановитьПараметр("КодыАннулирования", КодыАннулирования);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		СтрокаВедомости = Новый Структура;
		СтрокаВедомости.Вставить("ИдентификаторСБИС", Выборка.ИдентификаторСБИС);
		СтрокаВедомости.Вставить("Номер", Выборка.Номер);
		СтрокаВедомости.Вставить("Дата", Выборка.Дата);
		СтрокаВедомости.Вставить("Контрагент", Выборка.Контрагент);
		СтрокаВедомости.Вставить("ИНН", Выборка.ИНН);
		СтрокаВедомости.Вставить("Сумма", Выборка.Сумма);
		СтрокаВедомости.Вставить("ДатаАннулирования", Выборка.ДатаАннулирования);
		СтрокаВедомости.Вставить("ЗамененаНа", Выборка.ЗамененаНа);
		СтрокаВедомости.Вставить("ЕстьЗамена", ЗначениеЗаполнено(Выборка.ЗамененаНа));
		СтрокаВедомости.Вставить("ВычетЗаявлен", Выборка.ВыгруженВБух);
		СтрокаВедомости.Вставить("ТребуетсяСторно", Выборка.ВыгруженВБух);
		СтрокаВедомости.Вставить("Статус", ОпределитьСтатус(Выборка));

		Результат.Документы.Добавить(СтрокаВедомости);

		Результат.Итоги.Количество = Результат.Итоги.Количество + 1;
		Результат.Итоги.Сумма = Результат.Итоги.Сумма + Выборка.Сумма;
		Если Выборка.ВыгруженВБух Тогда
			Результат.Итоги.ВычетЗаявлен = Результат.Итоги.ВычетЗаявлен + 1;
		КонецЕсли;

	КонецЦикла;

	Результат.Заголовок = СтрШаблон(
		"Ведомость по аннулированным документам ЭДО%1",
		?(Контрагент = Неопределено, "", " (" + Контрагент + ")"));

	Возврат Результат;

КонецФункции

// Текстовый отчёт (для печати/экспорта).
//
Функция СформироватьТекст(Ведомость) Экспорт

	Текст = Новый Массив;
	Текст.Добавить(Ведомость.Заголовок);
	Текст.Добавить(СтрШаблон("Период: %1 — %2", Формат(Ведомость.Итоги.Количество, "ЧН=0"), ""));
	Текст.Добавить(СтрШаблон("Документов: %1, на сумму %2", Ведомость.Итоги.Количество, Ведомость.Итоги.Сумма));
	Текст.Добавить(СтрШаблон("Вычет заявлен по %1 документам", Ведомость.Итоги.ВычетЗаявлен));
	Текст.Добавить("");
	Текст.Добавить("№ | Номер | Дата | Контрагент | Сумма | Замена | Статус");
	Текст.Добавить("--+-------+------+------------+-------+--------+------");

	Номер = 0;
	Для Каждого Док Из Ведомость.Документы Цикл
		Номер = Номер + 1;
		Текст.Добавить(СтрШаблон("%1 | %2 | %3 | %4 | %5 | %6 | %7",
			Номер,
			Док.Номер,
			Формат(Док.Дата, "ДФ=dd.MM.yyyy"),
			Док.Контрагент,
			Док.Сумма,
			?(Док.ЕстьЗамена, "→ " + Док.ЗамененаНа, "—"),
			Док.Статус));
	КонецЦикла;

	Текст.Добавить("");
	Текст.Добавить("ВНИМАНИЕ: Сторно книги покупок — руками бухгалтера.");

	Возврат СтрСоединить(Текст, Символы.ПС);

КонецФункции

// Данные для формы/табличного документа.
//
Функция ПодготовитьДанныеДляТаблицы(Ведомость) Экспорт

	Таблица = Новый Массив;

	Для Каждого Док Из Ведомость.Документы Цикл
		Строка = Новый Структура;
		Строка.Вставить("Номер", Док.Номер);
		Строка.Вставить("Дата", Док.Дата);
		Строка.Вставить("Контрагент", Док.Контрагент);
		Строка.Вставить("ИНН", Док.ИНН);
		Строка.Вставить("Сумма", Док.Сумма);
		Строка.Вставить("ДатаАннулирования", Док.ДатаАннулирования);
		Строка.Вставить("ЗаменаНа", Док.ЗамененаНа);
		Строка.Вставить("ВычетЗаявлен", Док.ВычетЗаявлен);
		Строка.Вставить("ТребуетсяСторно", Док.ТребуетсяСторно);
		Строка.Вставить("Статус", Док.Статус);
		Таблица.Добавить(Строка);
	КонецЦикла;

	Возврат Таблица;

КонецФункции

#КонецОбласти

#Область Вспомогательные

// Определение статуса строки ведомости.
//
Функция ОпределитьСтатус(Выборка) Экспорт

	Если Выборка.ВыгруженВБух Тогда
		Если ЗначениеЗаполнено(Выборка.ЗамененаНа) Тогда
			Возврат "⚠ Вычет заявлен, есть замена";
		Иначе
			Возврат "🔴 Вычет заявлен, замены нет";
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(Выборка.ЗамененаНа) Тогда
			Возврат "✅ Есть замена, вычет не заявлен";
		Иначе
			Возврат "ℹ Не выгружен в Бух";
		КонецЕсли;
	КонецЕсли;

КонецФункции

#КонецОбласти
