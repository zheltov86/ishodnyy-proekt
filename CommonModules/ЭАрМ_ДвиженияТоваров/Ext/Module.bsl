// Вид движения товара: Приход / Возврат.
// Разделение поставок и возвратов для корректного учёта остатков.
// Решение: Марина (ревью), обязательное поле движений.

#Область ПрограммныйИнтерфейс

// Виды движения товара.
//
Функция ВидПриход() Экспорт
	Возврат "Приход";
КонецФункции

Функция ВидВозврат() Экспорт
	Возврат "Возврат";
КонецФункции

// Определение вида движения по данным строки/документа.
//
// Параметры:
//   Строка - Структура - данные строки:
//     * ПризнакВозврата - Булево - явный признак
//     * ТипДокумента    - Строка - "ВозвратПоставщику", "ВозвратТовара"
//     * Количество      - Число  - отрицательное = возврат
//     * Сумма           - Число  - отрицательная = возврат
//
// Возвращаемое значение:
//   Строка - "Приход" или "Возврат"
//
Функция ОпределитьВидДвижения(Строка) Экспорт

	// 1. Явный признак
	Если Строка.Свойство("ПризнакВозврата") И Строка.ПризнакВозврата = Истина Тогда
		Возврат ВидВозврат();
	КонецЕсли;

	// 2. Тип документа
	Если Строка.Свойство("ТипДокумента") Тогда
		Тип = ВРег(Строка.ТипДокумента);
		Если СтрНайти(Тип, "ВОЗВРАТ") > 0 Тогда
			Возврат ВидВозврат();
		КонецЕсли;
	КонецЕсли;

	// 3. Отрицательное количество
	Если Строка.Свойство("Количество") И Строка.Количество < 0 Тогда
		Возврат ВидВозврат();
	КонецЕсли;

	// 4. Отрицательная сумма
	Если Строка.Свойство("Сумма") И Строка.Сумма < 0 Тогда
		Возврат ВидВозврат();
	КонецЕсли;

	Возврат ВидПриход();

КонецФункции

// Запись движения с видом в регистр накопления.
//
// Параметры:
//   Движения      - КоллекцияДвижений - движения документа
//   ВидДвижения   - Строка - "Приход" или "Возврат"
//   Номенклатура  - СправочникСсылка.Номенклатура
//   Количество    - Число (для возврата — положительное, движение инвертируется)
//   Сумма         - Число
//   ДатаДвижения  - Дата
//
Процедура ЗаписатьДвижение(Движения, ВидДвижения, Номенклатура, Количество, Сумма, ДатаДвижения) Экспорт

	Если ВидДвижения = ВидВозврат() Тогда
		// Возврат — расход (товар уходит от нас)
		Запись = Движения.ТоварыНаСкладах.Добавить();
		Запись.ВидДвижения = ВидДвиженияРасход();
		Запись.Количество = Количество;
	Иначе
		// Приход — приход (товар поступает к нам)
		Запись = Движения.ТоварыНаСкладах.Добавить();
		Запись.ВидДвижения = ВидДвиженияПриход();
		Запись.Количество = Количество;
	КонецЕсли;

	Запись.Период = ДатаДвижения;
	Запись.Номенклатура = Номенклатура;
	Запись.Сумма = Сумма;

КонецПроцедуры

// Проверка: движение является возвратом.
//
Функция ЭтоВозврат(ВидДвижения) Экспорт
	Возврат ВидДвижения = ВидВозврат();
КонецФункции

// Проверка: движение является приходом.
//
Функция ЭтоПриход(ВидДвижения) Экспорт
	Возврат ВидДвижения = ВидПриход();
КонецФункции

// Строковое представление для отчётов.
//
Функция ПредставлениеВида(ВидДвижения) Экспорт
	Если ЭтоВозврат(ВидДвижения) Тогда
		Возврат "↩ Возврат";
	Иначе
		Возврат "→ Приход";
	КонецЕсли;
КонецФункции

// Подсчёт движений по видам.
//
// Параметры:
//   Движения - Массив - массив структур с полем ВидДвижения
//
// Возвращаемое значение:
//   Структура - {Приход, Возврат, Всего}
//
Функция ПодсчитатьДвижения(Движения) Экспорт

	Итог = Новый Структура("Приход, Возврат, Всего", 0, 0, 0);

	Для Каждого Движение Из Движения Цикл
		Если ЭтоВозврат(Движение.ВидДвижения) Тогда
			Итог.Возврат = Итог.Возврат + 1;
		Иначе
			Итог.Приход = Итог.Приход + 1;
		КонецЕсли;
		Итог.Всего = Итог.Всего + 1;
	КонецЦикла;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область Вспомогательные

Функция ВидДвиженияПриход()
	Возврат ВидДвиженияНакопления.Приход;
КонецФункции

Функция ВидДвиженияРасход()
	Возврат ВидДвиженияНакопления.Расход;
КонецФункции

#КонецОбласти
