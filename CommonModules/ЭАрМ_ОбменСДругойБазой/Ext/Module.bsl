#Область ПрограммныйИнтерфейс

// Отправляет электронный документ на подтверждение в другую базу через Web-сервис Exchange.
//
// Параметры:
//   ЭлектронныйДокумент - ДокументСсылка.ЭлектронныйДокументВходящийЭДО
//   ИдентификаторЗапроса - Строка - UUID запроса
//
// Возвращаемое значение:
//   Булево - Истина, если отправка успешна
//
Функция ОтправитьДокументНаПодтверждение(ЭлектронныйДокумент, ИдентификаторЗапроса) Экспорт

	ДанныеДокумента = ПодготовитьДанныеДокумента(ЭлектронныйДокумент);

	Попытка
		Прокси = ПолучитьWSПрокси();
		ТелоЗапроса = ОбщегоНазначенияБЭД.JSONСтрока(ДанныеДокумента);

		Прокси.PutData(
			ИдентификаторЗапроса,
			ТелоЗапроса,
			"EDOConfirmation"
		);

		Возврат Истина;

	Исключение
		ИмяСобытия = НСтр("ru = 'АРМ_ЭдоОбмен.ОтправкаДокументаНаПодтверждение'",
			ОбщегоНазначения.КодОсновногоЯзыка());
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка,
			,
			ЭлектронныйДокумент,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Отправляет электронный документ на подтверждение в другую базу через HTTP POST.
//
// Параметры:
//   ЭлектронныйДокумент - ДокументСсылка.ЭлектронныйДокументВходящийЭДО
//   ИдентификаторЗапроса - Строка - UUID запроса
//
// Возвращаемое значение:
//   Булево - Истина, если отправка успешна и документ подтверждён
//
Функция ОтправитьДокументНаПодтверждениеHTTP(ЭлектронныйДокумент, ИдентификаторЗапроса) Экспорт

	ДанныеДокумента = ПодготовитьДанныеДокумента(ЭлектронныйДокумент);
	ДанныеДокумента.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);

	Попытка
		АдресСервиса = Константы.ЭАрМ_АдресСервисаОбменаСДругойБазой.Получить();
		Если НЕ ЗначениеЗаполнено(АдресСервиса) Тогда
			ВызватьИсключение НСтр("ru = 'Не настроен адрес сервиса обмена с другой базой'");
		КонецЕсли;

		// Формируем JSON
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Новый Структура("requestId, documentType, data",
			ИдентификаторЗапроса, "ЭТрН", ДанныеДокумента));
		ТелоЗапроса = ЗаписьJSON.Закрыть();

		// Отправляем HTTP POST
		HTTPЗапрос = Новый HTTPЗапрос("/api/etrn/accept");
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);

		Соединение = Новый HTTPСоединение(АдресСервиса, , , , , 60);
		Ответ = Соединение.ОтправитьДляОбработки(HTTPЗапрос);

		Если Ответ.КодСостояния <> 200 Тогда
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'АРМ_ЭдоОбмен.ОтправкаЧерезHTTP'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка, , ЭлектронныйДокумент,
				СтрШаблон("Код ответа: %1", Ответ.КодСостояния));
			Возврат Ложь;
		КонецЕсли;

		// Читаем ответ
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		Возврат ДанныеОтвета.approved = Истина;

	Исключение
		ИмяСобытия = НСтр("ru = 'АРМ_ЭдоОбмен.ОтправкаЧерезHTTP'",
			ОбщегоНазначения.КодОсновногоЯзыка());
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка,
			,
			ЭлектронныйДокумент,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Отправляет электронный документ на подтверждение в другую базу через FTP.
//
// Параметры:
//   ЭлектронныйДокумент - ДокументСсылка.ЭлектронныйДокументВходящийЭДО
//   ИдентификаторЗапроса - Строка - UUID запроса
//
// Возвращаемое значение:
//   Булево - Истина, если отправка успешна
//
Функция ОтправитьДокументНаПодтверждениеFTP(ЭлектронныйДокумент, ИдентификаторЗапроса) Экспорт

	ДанныеДокумента = ПодготовитьДанныеДокумента(ЭлектронныйДокумент);
	ДанныеДокумента.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);

	Попытка
		// Формируем JSON
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ДанныеДокумента);
		ТелоЗапроса = ЗаписьJSON.Закрыть();

		// Сохраняем во временный файл
		ВременныйФайл = ПолучитьИмяВременногоФайла("json");
		ЗаписьТекста = Новый ЗаписьТекста(ВременныйФайл, КодировкаТекста.UTF8);
		ЗаписьТекста.Записать(ТелоЗапроса);
		ЗаписьТекста.Закрыть();

		// Подключаемся к FTP. Соединение собирает ЭАрМ_Служебный: адрес там
		// приводится к имени хоста, а режим и таймаут берутся из настроек -
		// свой конструктор здесь падал на "ftp://" в адресе и ходил активным
		// режимом, который за NAT не проходит
		НастройкиFTP = ПолучитьНастройкиFTP();
		Соединение = ЭАрМ_Служебный.СоздатьСоединениеFTP(НастройкиFTP);

		// Загружаем файл
		ИмяФайла = СтрШаблон("etrn_%1.json", ИдентификаторЗапроса);
		ПолныйПуть = ЭАрМ_Служебный.ОбъединитьПутьFTP(НастройкиFTP.Каталог, ИмяФайла);
		Соединение.Записать(ВременныйФайл, ПолныйПуть);

		// Удаляем временный файл
		УдалитьФайлы(ВременныйФайл);

		ЗаписьЖурналаРегистрации("АРМ_ЭДО.FTP",
			УровеньЖурналаРегистрации.Информация, , ЭлектронныйДокумент,
			СтрШаблон("Файл %1 загружен на FTP", ИмяФайла));

		Возврат Истина;

	Исключение
		ИмяСобытия = НСтр("ru = 'АРМ_ЭдоОбмен.ОтправкаЧерезFTP'",
			ОбщегоНазначения.КодОсновногоЯзыка());
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка,
			,
			ЭлектронныйДокумент,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Отправляет электронный документ на подтверждение через общую папку.
//
// Параметры:
//   ЭлектронныйДокумент - ДокументСсылка.ЭлектронныйДокументВходящийЭДО
//   ИдентификаторЗапроса - Строка - UUID запроса
//
// Возвращаемое значение:
//   Булево - Истина, если отправка успешна
//
Функция ОтправитьДокументЧерезПапку(ЭлектронныйДокумент, ИдентификаторЗапроса) Экспорт

	ДанныеДокумента = ПодготовитьДанныеДокумента(ЭлектронныйДокумент);
	ДанныеДокумента.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);

	Попытка
		// Формируем JSON
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ДанныеДокумента);
		ТелоЗапроса = ЗаписьJSON.Закрыть();

		// Получаем путь к папке
		ПутьКПапке = ЭАрМ_НастройкиСервер.ПолучитьНастройку("ПапкаОбмена");
		Если НЕ ЗначениеЗаполнено(ПутьКПапке) Тогда
			ВызватьИсключение "Не указан путь к папке обмена";
		КонецЕсли;

		// Создаем папку если не существует
		Каталог = Новый Файл(ПутьКПапке);
		Если НЕ Каталог.Существует() Тогда
			СоздатьКаталог(ПутьКПапке);
		КонецЕсли;

		// Сохраняем файл
		ИмяФайла = СтрШаблон("etrn_%1.json", ИдентификаторЗапроса);
		ПолныйПуть = ПутьКПапке + "\" + ИмяФайла;

		ЗаписьТекста = Новый ЗаписьТекста(ПолныйПуть, КодировкаТекста.UTF8);
		ЗаписьТекста.Записать(ТелоЗапроса);
		ЗаписьТекста.Закрыть();

		ЗаписьЖурналаРегистрации("АРМ_ЭДО.Папка",
			УровеньЖурналаРегистрации.Информация, , ЭлектронныйДокумент,
			СтрШаблон("Файл %1 сохранен в папку", ИмяФайла));

		Возврат Истина;

	Исключение
		ИмяСобытия = НСтр("ru = 'АРМ_ЭдоОбмен.ОтправкаЧерезПапку'",
			ОбщегоНазначения.КодОсновногоЯзыка());
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка,
			,
			ЭлектронныйДокумент,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Универсальная отправка с выбором транспорта из настроек.
//
Функция ОтправитьДокументУниверсально(ЭлектронныйДокумент, ИдентификаторЗапроса) Экспорт

	Транспорт = ЭАрМ_НастройкиСервер.ПолучитьНастройку("ТранспортОбмена");

	Если Транспорт = "FTP" Тогда
		Возврат ОтправитьДокументНаПодтверждениеFTP(ЭлектронныйДокумент, ИдентификаторЗапроса);
	ИначеЕсли Транспорт = "Папка" Тогда
		Возврат ОтправитьДокументЧерезПапку(ЭлектронныйДокумент, ИдентификаторЗапроса);
	Иначе
		Возврат ОтправитьДокументНаПодтверждениеHTTP(ЭлектронныйДокумент, ИдентификаторЗапроса);
	КонецЕсли;

КонецФункции

#КонецОбласти
#Область ПрограммныйИнтерфейс2
// Создает WS-прокси для подключения к Web-сервису Exchange другой базы.
//
Функция ПолучитьWSПрокси()

	АдресСервиса = Константы.ЭАрМ_АдресСервисаОбменаСДругойБазой.Получить();

	Если НЕ ЗначениеЗаполнено(АдресСервиса) Тогда
		ВызватьИсключение НСтр("ru = 'Не настроен адрес сервиса обмена с другой базой.
			|Установите значение константы ЭАрМ_АдресСервисаОбменаСДругойБазой'");
	КонецЕсли;

	АдресWSDL = АдресСервиса + "/ws/Exchange_3_0_2_2?wsdl";
	// Таймауты обязательны: без них зависший сервис держал вызов бесконечно
	Определения = Новый WSОпределения(АдресWSDL, "", "", , 60);

	URIПространстваИмен = "http://www.1c.ru/SSL/Exchange_3_0_2_2";
	Прокси = Новый WSПрокси(Определения, URIПространстваИмен,
		"Exchange_3_0_2_2", "Exchange_3_0_2_2Soap", , 60);

	Возврат Прокси;

КонецФункции

// Получает настройки FTP из регистра.
//
// Состав берётся у ЭАрМ_НастройкиСервер целиком - вместе с пассивным режимом
// и таймаутом. Раньше здесь собиралась своя, укороченная структура: ключей
// хватало на конструктор из четырёх параметров, а соединение получалось без
// режима и без таймаута, хотя в настройках они заданы.
//
// Возвращаемое значение:
//   Структура - см. ЭАрМ_НастройкиСервер.НастройкиFTP
//
Функция ПолучитьНастройкиFTP() Экспорт

	Результат = ЭАрМ_НастройкиСервер.НастройкиFTP();

	Если НЕ ЗначениеЗаполнено(Результат.Порт) Тогда
		Результат.Порт = 21;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Результат.Каталог) Тогда
		Результат.Каталог = "/edo";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Подготавливает данные электронного документа для отправки.
//
// Параметры:
//   ЭлектронныйДокумент - ДокументСсылка
//
// Возвращаемое значение:
//   Структура - данные документа для сериализации
//
Функция ПодготовитьДанныеДокумента(ЭлектронныйДокумент) Экспорт

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭлектронныйДокумент,
		"Ссылка, Номер, Дата, ВидДокумента, Организация, Контрагент,
		|СуммаДокумента, ИдентификаторДокументооборота, ДатаПолучения,
		|НомерДокумента, ДатаДокумента, ДоговорКонтрагента,
		|ИдентификаторДокумента, ИдентификаторОрганизации, ИдентификаторКонтрагента,
		|ТипРегламента, СпособОбмена, ФорматОсновногоТитула,
		|ТребуетсяИзвещение, ТребуетсяПодтверждение");

	ВидДокумента = Реквизиты.ВидДокумента;
	ТипДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидДокумента, "ТипДокумента");

	Данные = Новый Структура;
	Данные.Вставить("ИдентификаторЭДО", Реквизиты.ИдентификаторДокументооборота);
	Данные.Вставить("ТипДокумента", XMLСтрока(ТипДокумента));
	Данные.Вставить("Номер", Реквизиты.Номер);
	Данные.Вставить("Дата", Реквизиты.Дата);
	Данные.Вставить("Сумма", Реквизиты.СуммаДокумента);
	Данные.Вставить("Организация", Строка(Реквизиты.Организация));
	Данные.Вставить("Контрагент", Строка(Реквизиты.Контрагент));
	Данные.Вставить("ДатаПолучения", Реквизиты.ДатаПолучения);
	Данные.Вставить("СсылкаСтрока", ПолучитьНавигационнуюСсылку(ЭлектронныйДокумент));
	Данные.Вставить("НомерДокумента", Реквизиты.НомерДокумента);
	Данные.Вставить("ДатаДокумента", Реквизиты.ДатаДокумента);
	Данные.Вставить("ДоговорКонтрагента", Строка(Реквизиты.ДоговорКонтрагента));
	Данные.Вставить("ИдентификаторДокумента", Реквизиты.ИдентификаторДокумента);
	Данные.Вставить("ИдентификаторОрганизации", Реквизиты.ИдентификаторОрганизации);
	Данные.Вставить("ИдентификаторКонтрагента", Реквизиты.ИдентификаторКонтрагента);
	Данные.Вставить("ТипРегламента", Строка(Реквизиты.ТипРегламента));
	Данные.Вставить("СпособОбмена", Строка(Реквизиты.СпособОбмена));
	Данные.Вставить("ФорматОсновногоТитула", Реквизиты.ФорматОсновногоТитула);
	Данные.Вставить("ТребуетсяИзвещение", Реквизиты.ТребуетсяИзвещение);
	Данные.Вставить("ТребуетсяПодтверждение", Реквизиты.ТребуетсяПодтверждение);

	// Дополнительные данные для ЭТрН
	Если ТипДокумента = Перечисления.ТипыДокументовЭДО.ЭТрН Тогда
		ДополнитьДанныеЭТрН(Данные, ЭлектронныйДокумент);
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Извлекает данные из связанного документа ЭлектроннаяТранспортнаяНакладная.
//
Процедура ДополнитьДанныеЭТрН(Данные, ЭлектронныйДокумент)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭТрН.Ссылка КАК Ссылка,
	|	ЭТрН.ТитулГрузоотправителяТранспортнаяНакладнаяНомер КАК НомерТН,
	|	ЭТрН.ТитулГрузоотправителяТранспортнаяНакладнаяДата КАК ДатаТН,
	|	ЭТрН.СсылкаТитулГрузоотправителяГрузоотправитель КАК Грузоотправитель,
	|	ЭТрН.СсылкаТитулГрузоотправителяГрузополучатель КАК Грузополучатель,
	|	ЭТрН.СсылкаТитулГрузоотправителяПеревозчик КАК Перевозчик,
	|	ЭТрН.СсылкаТитулГрузоотправителяЗаказчик КАК Заказчик
	|ИЗ
	|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК Связи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭлектроннаяТранспортнаяНакладная КАК ЭТрН
	|		ПО Связи.ОбъектУчета = ЭТрН.Ссылка
	|ГДЕ
	|	Связи.ЭлектронныйДокумент = &ЭлектронныйДокумент";
	Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокумент);

	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Данные.Вставить("НомерТН", Выборка.НомерТН);
		Данные.Вставить("ДатаТН", Выборка.ДатаТН);
		Данные.Вставить("Грузоотправитель", Строка(Выборка.Грузоотправитель));
		Данные.Вставить("Грузополучатель", Строка(Выборка.Грузополучатель));
		Данные.Вставить("Перевозчик", Строка(Выборка.Перевозчик));
		Данные.Вставить("Заказчик", Строка(Выборка.Заказчик));
	Иначе
		Данные.Вставить("НомерТН", "");
		Данные.Вставить("ДатаТН", Неопределено);
		Данные.Вставить("Грузоотправитель", "");
		Данные.Вставить("Грузополучатель", "");
		Данные.Вставить("Перевозчик", "");
		Данные.Вставить("Заказчик", "");
	КонецЕсли;

КонецПроцедуры

// Проверяет статус обработки документа в базе Далион.
//
// Параметры:
//   ИдентификаторЗапроса - Строка - UUID запроса
//
// Возвращаемое значение:
//   Структура, Неопределено - статус обработки или Неопределено если не найден
//
Функция ПроверитьСтатусВДалион(ИдентификаторЗапроса) Экспорт

	Попытка
		АдресСервиса = Константы.ЭАрМ_АдресСервисаОбменаСДругойБазой.Получить();
		Если НЕ ЗначениеЗаполнено(АдресСервиса) Тогда
			Возврат Неопределено;
		КонецЕсли;

		HTTPЗапрос = Новый HTTPЗапрос(
			СтрШаблон("/api/etrn/status?requestId=%1", ИдентификаторЗапроса));

		Соединение = Новый HTTPСоединение(АдресСервиса, , , , , 60);
		Ответ = Соединение.Получить(HTTPЗапрос);

		Если Ответ.КодСостояния <> 200 Тогда
			Возврат Неопределено;
		КонецЕсли;

		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		Возврат ДанныеОтвета;

	Исключение
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ПроверкаСтатуса",
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти
