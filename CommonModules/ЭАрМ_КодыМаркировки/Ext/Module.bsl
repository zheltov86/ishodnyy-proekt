////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_КодыМаркировки: раскрытие GTIN и кодов маркировки из УПД и ЭТрН.
//
// Что раскрываем:
//   GTIN (8/12/13/14 цифр) - GTIN-14 и EAN-13, индикатор упаковки, префикс GS1 и
//                            страна регистрации кода, проверка контрольной цифры;
//   Честный знак (GS1)     - AI 01 GTIN, 21 серийный номер, 91 ключ проверки,
//                            92/93 криптоподпись, 8005 МРЦ, 17 годен до,
//                            11 дата производства, 10 партия, 310n вес;
//                            код пачки сигарет из 29 знаков без AI;
//   SSCC (AI 00, 18 цифр)  - код транспортной упаковки;
//   ЕГАИС                  - акцизная/федеральная марка распознаётся по формату
//                            (PDF417 - 68 знаков, DataMatrix - 150 знаков). Состав
//                            марки (алкокод, серия, номер) закодирован ФСРАР и
//                            раскрывается запросом в УТМ ЕГАИС - это следующий шаг.
//
// В УПД коды лежат в ДопСведТов/НомСредИдентТов (КИЗ, НомУпак, ИдентТрансУпак), в
// ЭТрН - в строках груза. Разделитель GS в XML не передаётся, поэтому серийный
// номер без GS отделяется по известным раскладкам кодов Честного знака.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Раскрывает один код: GTIN, код Честного знака, SSCC или марку ЕГАИС.
//
// Возвращаемое значение:
//   Структура:
//     * Код, Вид - Строка - Вид: GTIN, ЧестныйЗнак, ЧестныйЗнакПачка, SSCC, ЕГАИС,
//                  Неизвестно, Пусто
//     * GTIN, Серийный, КодИдентификации, КлючПроверки, Криптоподпись,
//       Партия, SSCC, ФорматЕГАИС, Описание - Строка
//     * МРЦ, Вес - Число
//     * ГоденДо, ДатаПроизводства - Дата
//
Функция РазобратьКод(Знач Код) Экспорт

	Разбор = Новый Структура("Код, Вид, GTIN, Серийный, КодИдентификации, КлючПроверки, Криптоподпись,"
		+ " МРЦ, ГоденДо, ДатаПроизводства, Партия, Вес, SSCC, ФорматЕГАИС, Описание",
		СокрЛП(Код), "Неизвестно", "", "", "", "", "", 0, '00010101', '00010101', "", 0, "", "", "");

	Текст = НормализованныйКод(Код);
	Длина = СтрДлина(Текст);

	Если Длина = 0 Тогда
		Разбор.Вид = "Пусто";
		Разбор.Описание = "пустой код";
		Возврат Разбор;
	КонецЕсли;

	Если ТолькоЦифры(Текст) И (Длина = 8 ИЛИ Длина = 12 ИЛИ Длина = 13 ИЛИ Длина = 14) Тогда
		Разбор.Вид  = "GTIN";
		Разбор.GTIN = ДополнитьНулями(Текст, 14);
		Разбор.Описание = ОписаниеGTIN(Текст).Описание;
		Возврат Разбор;
	КонецЕсли;

	Если ТолькоЦифры(Текст) И (Длина = 20 И Лев(Текст, 2) = "00" ИЛИ Длина = 18) Тогда
		Разбор.Вид  = "SSCC";
		Разбор.SSCC = Прав(Текст, 18);
		Разбор.Описание = СтрШаблон("SSCC транспортной упаковки %1, контрольная цифра %2",
			Разбор.SSCC, ?(КонтрольнаяЦифраВерна(Разбор.SSCC), "верна", "НЕ верна"));
		Возврат Разбор;
	КонецЕсли;

	Если Лев(Текст, 2) = "01" И Длина >= 16 И ТолькоЦифры(Сред(Текст, 3, 14)) Тогда
		Разбор.Вид = "ЧестныйЗнак";
		РазобратьGS1(Текст, Разбор);
		Разбор.Описание = ОписаниеКодаЧестныйЗнак(Разбор);
		Возврат Разбор;
	КонецЕсли;

	// Пачка сигарет: GTIN 14 цифр, серийный 7, МРЦ 4 (закодирована), крипто 4
	Если Длина = 29 И ТолькоЦифры(Лев(Текст, 14)) Тогда
		Разбор.Вид           = "ЧестныйЗнакПачка";
		Разбор.GTIN          = Лев(Текст, 14);
		Разбор.Серийный      = Сред(Текст, 15, 7);
		Разбор.Криптоподпись = Сред(Текст, 26, 4);
		Разбор.КодИдентификации = Лев(Текст, 21);
		Разбор.Описание = СтрШаблон("Честный знак, пачка сигарет: GTIN %1 (%2), серийный %3, МРЦ в коде %4, криптохвост %5",
			Разбор.GTIN, ОписаниеGTIN(Разбор.GTIN).Кратко, Разбор.Серийный, Сред(Текст, 22, 4), Разбор.Криптоподпись);
		Возврат Разбор;
	КонецЕсли;

	Если (Длина = 68 ИЛИ Длина = 150) И ТолькоЦифрыИЛатиница(Текст) Тогда
		Разбор.Вид = "ЕГАИС";
		Разбор.ФорматЕГАИС = ?(Длина = 68, "PDF417, марка старого образца (68 знаков)",
			"DataMatrix, марка нового образца (150 знаков)");
		Разбор.Описание = "Марка ЕГАИС, " + Разбор.ФорматЕГАИС
			+ ": алкокод, серия и номер закодированы ФСРАР - раскрываются запросом в УТМ ЕГАИС";
		Возврат Разбор;
	КонецЕсли;

	Разбор.Описание = СтрШаблон("формат не распознан (%1 знаков)", Длина);

	Возврат Разбор;

КонецФункции

// Раскрывает GTIN.
//
// Параметры:
//   Код - Строка - 8, 12, 13 или 14 цифр
//
// Возвращаемое значение:
//   Структура - GTIN14, EAN13, Индикатор, Префикс, Страна, КонтрольВерен (Булево),
//               Кратко, Описание; для строки не из цифр Описание объясняет почему
//
Функция ОписаниеGTIN(Знач Код) Экспорт

	Результат = Новый Структура("GTIN14, EAN13, Индикатор, Префикс, Страна, КонтрольВерен, Кратко, Описание",
		"", "", "", "", "", Ложь, "", "");

	Код  = СокрЛП(Код);
	Длина = СтрДлина(Код);

	Если НЕ ТолькоЦифры(Код) ИЛИ (Длина <> 8 И Длина <> 12 И Длина <> 13 И Длина <> 14) Тогда
		Результат.Описание = СтрШаблон("«%1» не GTIN: нужно 8, 12, 13 или 14 цифр", Код);
		Результат.Кратко   = "не GTIN";
		Возврат Результат;
	КонецЕсли;

	Результат.GTIN14        = ДополнитьНулями(Код, 14);
	Результат.КонтрольВерен = КонтрольнаяЦифраВерна(Результат.GTIN14);

	Индикатор = Лев(Результат.GTIN14, 1);
	Если Индикатор = "0" Тогда
		Результат.Индикатор = "единица товара";
		Результат.EAN13     = Сред(Результат.GTIN14, 2);
	ИначеЕсли Индикатор = "9" Тогда
		Результат.Индикатор = "товар переменной меры";
	Иначе
		Результат.Индикатор = СтрШаблон("групповая упаковка (индикатор %1)", Индикатор);
	КонецЕсли;

	Если Длина = 8 Тогда
		Результат.Префикс = Лев(Код, 3);
		Результат.Страна  = СтранаGS1(Результат.Префикс) + " (GTIN-8)";
	ИначеЕсли Длина = 12 Тогда
		Результат.Префикс = "0" + Лев(Код, 2);
		Результат.Страна  = "США и Канада (UPC-A)";
	Иначе
		Результат.Префикс = Сред(Результат.GTIN14, 2, 3);
		Результат.Страна  = СтранаGS1(Результат.Префикс);
	КонецЕсли;

	Результат.Кратко = СтрШаблон("%1, %2, контроль %3", Результат.Страна, Результат.Индикатор,
		?(Результат.КонтрольВерен, "верен", "НЕ верен"));

	Результат.Описание = СтрШаблон("GTIN-14 %1%2; префикс GS1 %3 - %4 (страна регистрации кода, а не производства); %5; контрольная цифра %6",
		Результат.GTIN14, ?(ЗначениеЗаполнено(Результат.EAN13), ", EAN-13 " + Результат.EAN13, ""),
		Результат.Префикс, Результат.Страна, Результат.Индикатор,
		?(Результат.КонтрольВерен, "верна", "НЕ верна - код введён с ошибкой"));

	Возврат Результат;

КонецФункции

// Раскладывает коды маркировки на Честный знак и ЕГАИС, без повторов.
//
// Параметры:
//   Коды - Массив, Строка - коды или текст с кодами через перевод строки
//
// Возвращаемое значение:
//   Структура - ЧестныйЗнак, ЕГАИС (Массив из Строка)
//
Функция МаркиПоВидам(Коды) Экспорт

	Результат = Новый Структура("ЧестныйЗнак, ЕГАИС", Новый Массив, Новый Массив);
	УжеЧестныйЗнак = Новый Соответствие;
	УжеЕГАИС = Новый Соответствие;

	Для Каждого Код Из КодыКакМассив(Коды) Цикл

		Текст = СокрЛП(Код);
		Если НЕ ЗначениеЗаполнено(Текст) Тогда
			Продолжить;
		КонецЕсли;

		Разбор = РазобратьКод(Текст);
		Если Разбор.Вид = "ЧестныйЗнак" ИЛИ Разбор.Вид = "ЧестныйЗнакПачка" Тогда
			Если УжеЧестныйЗнак.Получить(Текст) = Неопределено Тогда
				Результат.ЧестныйЗнак.Добавить(Текст);
				УжеЧестныйЗнак.Вставить(Текст, Истина);
			КонецЕсли;
		ИначеЕсли Разбор.Вид = "ЕГАИС" Тогда
			Если УжеЕГАИС.Получить(Текст) = Неопределено Тогда
				Результат.ЕГАИС.Добавить(Текст);
				УжеЕГАИС.Вставить(Текст, Истина);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КодыКакМассив(Коды)

	Если ТипЗнч(Коды) = Тип("Массив") Тогда
		Возврат Коды;
	ИначеЕсли ТипЗнч(Коды) = Тип("Строка") Тогда
		Возврат СтрРазделить(Коды, Символы.ПС, Ложь);
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

// Отчёт по GTIN и кодам маркировки УПД: читает документ из СБИС.
//
// Возвращаемое значение:
//   Строка
//
Функция ОтчетУПД(ИдентификаторУПД) Экспорт

	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Возврат "Не удалось авторизоваться в СБИС";
	КонецЕсли;

	ТоварыУПД = ЭАрМ_ОбщийМодульОбмен.ПолучитьТоварыУПД(ИдентификаторУПД, Сессия);
	Если НЕ ТоварыУПД.Успех Тогда
		Возврат "Не удалось прочитать товары УПД из СБИС: " + ТоварыУПД.Ошибка;
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого СтрокаУПД Из ТоварыУПД.Товары Цикл
		Строки.Добавить(Новый Структура("Наименование, Штрихкод, Маркировки",
			ЭАрМ_Служебный.ЗначениеУзла(СтрокаУПД, "Наименование", ""),
			ЭАрМ_Служебный.ЗначениеУзла(СтрокаУПД, "Штрихкод", ""),
			ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(СтрокаУПД, "Маркировки"))));
	КонецЦикла;

	Номер = ?(ЗначениеЗаполнено(ТоварыУПД.НомерВФайле), ТоварыУПД.НомерВФайле, ТоварыУПД.НомерДокумента);

	Возврат ОтчетПоСтрокам(СтрШаблон("%1 %2 от %3 (файл %4)",
		?(ТоварыУПД.ЭтоКорректировка, "УКД", "УПД"), Номер, ТоварыУПД.ДатаВФайле, ТоварыУПД.ИмяФайла), Строки);

КонецФункции

// Отчёт по кодам маркировки ЭТрН (груз читается из СБИС) и её УПД.
//
// Возвращаемое значение:
//   Строка
//
Функция ОтчетЭТрН(ИдентификаторЭТрН) Экспорт

	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Возврат "Не удалось авторизоваться в СБИС";
	КонецЕсли;

	Части = Новый Массив;

	Груз = ЭАрМ_ОбщийМодульОбмен.ПолучитьГрузПоИдентификатору(ИдентификаторЭТрН, Сессия);
	Если НЕ Груз.Успех Тогда
		Части.Добавить("Не удалось прочитать груз ЭТрН из СБИС: " + Груз.Ошибка);
	Иначе
		Строки = Новый Массив;
		Для Каждого Позиция Из Груз.Позиции Цикл
			Строки.Добавить(Новый Структура("Наименование, Штрихкод, Маркировки",
				Позиция.Наименование, "", ЭАрМ_Служебный.ЗначениеВМассив(Позиция.Маркировки)));
		КонецЦикла;
		Части.Добавить(ОтчетПоСтрокам("ЭТрН (груз)", Строки));
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_РеестрЭТрН.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторЭТрН;
	МенеджерЗаписи.Прочитать();

	Если МенеджерЗаписи.Выбран() И ЗначениеЗаполнено(МенеджерЗаписи.ИдентификаторУПД) Тогда
		Части.Добавить("");
		Части.Добавить("==================== Связанная УПД ====================");
		Части.Добавить(ОтчетУПД(СокрЛП(МенеджерЗаписи.ИдентификаторУПД)));
	КонецЕсли;

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// Раскладывает коды маркировки по строкам товаров по GTIN, зашитому в код:
// AI 01 у Честного знака, первые 14 цифр у пачки сигарет. Так коды ЭТрН находят
// свою строку УПД, даже когда наименования в документах разные или груз ЭТрН
// свёрнут в одну строку.
//
// Строки с одним GTIN получают коды по очереди, каждая не больше своего
// количества; последней достаётся остаток. Коды без GTIN (SSCC, ЕГАИС) и с
// GTIN, которого нет ни у одной строки, не раскладываются: угадывать хуже,
// чем оставить пустым.
//
// Параметры:
//   Строки - Массив из Структура - Штрихкоды (Массив из Строка), Количество (Число)
//   Коды   - Массив из Строка
//
// Возвращаемое значение:
//   Массив из Массив - коды для каждой строки, в порядке Строки
//
Функция РазложитьКодыПоGTIN(Строки, Коды) Экспорт

	Результат = Новый Массив;
	СтрокиПоGTIN = Новый Соответствие;

	Для Индекс = 0 По Строки.ВГраница() Цикл

		Результат.Добавить(Новый Массив);
		УчтенныеGTIN = Новый Соответствие;

		Для Каждого Штрихкод Из КодыКакМассив(Строки[Индекс].Штрихкоды) Цикл

			GTIN = ОписаниеGTIN(Штрихкод).GTIN14;
			Если НЕ ЗначениеЗаполнено(GTIN) ИЛИ УчтенныеGTIN.Получить(GTIN) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			УчтенныеGTIN.Вставить(GTIN, Истина);

			ИндексыСтрок = СтрокиПоGTIN.Получить(GTIN);
			Если ИндексыСтрок = Неопределено Тогда
				ИндексыСтрок = Новый Массив;
				СтрокиПоGTIN.Вставить(GTIN, ИндексыСтрок);
			КонецЕсли;
			ИндексыСтрок.Добавить(Индекс);

		КонецЦикла;

	КонецЦикла;

	КодыПоGTIN = Новый Соответствие;
	Добавленные = Новый Соответствие;

	Для Каждого Код Из КодыКакМассив(Коды) Цикл

		Текст = СокрЛП(Код);
		Если НЕ ЗначениеЗаполнено(Текст) ИЛИ Добавленные.Получить(Текст) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Добавленные.Вставить(Текст, Истина);

		Разбор = РазобратьКод(Текст);
		Если Разбор.Вид <> "ЧестныйЗнак" И Разбор.Вид <> "ЧестныйЗнакПачка" Тогда
			Продолжить;
		КонецЕсли;

		GTIN = ДополнитьНулями(Разбор.GTIN, 14);
		Если СтрокиПоGTIN.Получить(GTIN) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		КодыGTIN = КодыПоGTIN.Получить(GTIN);
		Если КодыGTIN = Неопределено Тогда
			КодыGTIN = Новый Массив;
			КодыПоGTIN.Вставить(GTIN, КодыGTIN);
		КонецЕсли;
		КодыGTIN.Добавить(Текст);

	КонецЦикла;

	Для Каждого КлючЗначение Из КодыПоGTIN Цикл

		ИндексыСтрок = СтрокиПоGTIN.Получить(КлючЗначение.Ключ);
		КодыGTIN = КлючЗначение.Значение;
		Позиция = 0;

		Для Номер = 0 По ИндексыСтрок.ВГраница() Цикл

			Осталось = КодыGTIN.Количество() - Позиция;
			Если Номер = ИндексыСтрок.ВГраница() Тогда
				Сколько = Осталось;
			Иначе
				Сколько = Мин(Макс(Цел(Строки[ИндексыСтрок[Номер]].Количество), 0), Осталось);
			КонецЕсли;

			Для Шаг = 1 По Сколько Цикл
				Результат[ИндексыСтрок[Номер]].Добавить(КодыGTIN[Позиция]);
				Позиция = Позиция + 1;
			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Отчет

// Сводка сверху, затем по строкам: GTIN строки и раскрытие кодов маркировки.
// Коды одной строки перечисляются подробно до предела, остальные только
// считаются. GTIN кода Честного знака сверяется с GTIN строки.
//
Функция ОтчетПоСтрокам(Заголовок, Строки)

	ПодробноКодовНаСтроку = 20;

	ПоВидам         = Новый Соответствие;
	ВсегоКодов      = 0;
	СтрокСGTIN      = 0;
	ОшибокКонтроля  = 0;
	НесовпаденийGTIN = 0;
	Детали          = Новый Массив;

	НомерСтроки = 0;
	Для Каждого СтрокаТовара Из Строки Цикл

		НомерСтроки = НомерСтроки + 1;
		Детали.Добавить("");
		Детали.Добавить(СтрШаблон("%1. %2", НомерСтроки, СтрокаТовара.Наименование));

		GTINСтроки = "";
		Если ЗначениеЗаполнено(СтрокаТовара.Штрихкод) Тогда
			ОписаниеШтрихкода = ОписаниеGTIN(СтрокаТовара.Штрихкод);
			Детали.Добавить("   GTIN строки: " + ОписаниеШтрихкода.Описание);
			Если ЗначениеЗаполнено(ОписаниеШтрихкода.GTIN14) Тогда
				СтрокСGTIN = СтрокСGTIN + 1;
				GTINСтроки = ОписаниеШтрихкода.GTIN14;
				Если НЕ ОписаниеШтрихкода.КонтрольВерен Тогда
					ОшибокКонтроля = ОшибокКонтроля + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Коды = СтрокаТовара.Маркировки;
		Если Коды.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Детали.Добавить(СтрШаблон("   Кодов маркировки: %1", Коды.Количество()));

		Индекс = 0;
		Для Каждого Код Из Коды Цикл

			Разбор = РазобратьКод(Код);
			ВсегоКодов = ВсегоКодов + 1;
			ПоВидам.Вставить(Разбор.Вид, ?(ПоВидам.Получить(Разбор.Вид) = Неопределено, 0, ПоВидам.Получить(Разбор.Вид)) + 1);

			ГTINНеСовпал = ЗначениеЗаполнено(GTINСтроки) И ЗначениеЗаполнено(Разбор.GTIN) И Разбор.GTIN <> GTINСтроки;
			Если ГTINНеСовпал Тогда
				НесовпаденийGTIN = НесовпаденийGTIN + 1;
			КонецЕсли;

			Индекс = Индекс + 1;
			Если Индекс <= ПодробноКодовНаСтроку Тогда
				Детали.Добавить("     - " + Разбор.Код);
				Детали.Добавить("       " + Разбор.Описание
					+ ?(ГTINНеСовпал, " | GTIN кода НЕ совпадает с GTIN строки " + GTINСтроки, ""));
			КонецЕсли;

		КонецЦикла;

		Если Коды.Количество() > ПодробноКодовНаСтроку Тогда
			Детали.Добавить(СтрШаблон("     ... ещё %1 кодов", Коды.Количество() - ПодробноКодовНаСтроку));
		КонецЕсли;

	КонецЦикла;

	Шапка = Новый Массив;
	Шапка.Добавить("=== " + Заголовок + " ===");
	Шапка.Добавить(СтрШаблон("Строк: %1, с GTIN: %2, GTIN с ошибкой контрольной цифры: %3",
		Строки.Количество(), СтрокСGTIN, ОшибокКонтроля));
	Шапка.Добавить(СтрШаблон("Кодов маркировки: %1", ВсегоКодов));
	Для Каждого КлючЗначение Из ПоВидам Цикл
		Шапка.Добавить(СтрШаблон("   %1: %2", ПредставлениеВида(КлючЗначение.Ключ), КлючЗначение.Значение));
	КонецЦикла;
	Если НесовпаденийGTIN > 0 Тогда
		Шапка.Добавить(СтрШаблон("ВНИМАНИЕ: кодов с GTIN, не совпадающим с GTIN строки: %1", НесовпаденийGTIN));
	КонецЕсли;
	Если ВсегоКодов = 0 Тогда
		Шапка.Добавить("Кодов маркировки в документе нет (в УПД они лежат в ДопСведТов/НомСредИдентТов).");
	КонецЕсли;

	Возврат СтрСоединить(Шапка, Символы.ПС) + Символы.ПС + СтрСоединить(Детали, Символы.ПС);

КонецФункции

Функция ПредставлениеВида(Вид)

	Если Вид = "ЧестныйЗнак" Тогда
		Возврат "Честный знак";
	ИначеЕсли Вид = "ЧестныйЗнакПачка" Тогда
		Возврат "Честный знак, пачки сигарет";
	ИначеЕсли Вид = "SSCC" Тогда
		Возврат "SSCC транспортных упаковок";
	ИначеЕсли Вид = "ЕГАИС" Тогда
		Возврат "марки ЕГАИС";
	ИначеЕсли Вид = "GTIN" Тогда
		Возврат "GTIN без кода маркировки";
	КонецЕсли;

	Возврат Вид;

КонецФункции

#КонецОбласти

#Область РазборGS1

// Разбирает код GS1 по идентификаторам применения (AI).
//
Процедура РазобратьGS1(Текст, Разбор)

	GS = Символ(29);
	Длина = СтрДлина(Текст);
	Позиция = 1;

	Пока Позиция <= Длина Цикл

		Если Сред(Текст, Позиция, 1) = GS Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		AI = ИдентификаторПрименения(Текст, Позиция);
		Если НЕ ЗначениеЗаполнено(AI) Тогда
			// Остаток не разбирается - то, что уже разобрано, остаётся в результате
			Прервать;
		КонецЕсли;

		Позиция = Позиция + СтрДлина(AI);

		ДлинаЗначения = ДлинаЗначенияAI(AI);
		Если ДлинаЗначения > 0 Тогда
			Значение = Сред(Текст, Позиция, ДлинаЗначения);
		Иначе
			Значение = ЗначениеПеременнойДлины(Сред(Текст, Позиция), AI);
		КонецЕсли;

		Если СтрДлина(Значение) = 0 Тогда
			Прервать;
		КонецЕсли;

		Позиция = Позиция + СтрДлина(Значение);
		ПрименитьAI(Разбор, AI, Значение);

	КонецЦикла;

	Если ЗначениеЗаполнено(Разбор.GTIN) И ЗначениеЗаполнено(Разбор.Серийный) Тогда
		Разбор.КодИдентификации = "01" + Разбор.GTIN + "21" + Разбор.Серийный;
	КонецЕсли;

КонецПроцедуры

Функция ИдентификаторПрименения(Текст, Позиция)

	Два    = Сред(Текст, Позиция, 2);
	Три    = Сред(Текст, Позиция, 3);
	Четыре = Сред(Текст, Позиция, 4);

	Если Четыре = "8005" ИЛИ Четыре = "7003" ИЛИ (Три = "310" И ТолькоЦифры(Четыре)) Тогда
		Возврат Четыре;
	ИначеЕсли Три = "240" Тогда
		Возврат Три;
	ИначеЕсли СтрНайти("|00|01|02|10|11|13|15|17|21|91|92|93|", "|" + Два + "|") > 0 Тогда
		Возврат Два;
	КонецЕсли;

	Возврат "";

КонецФункции

// Длина значения AI фиксированной длины; 0 - переменная длина. Ключ проверки
// (91) и короткий криптохвост (93) у Честного знака всегда по 4 знака.
//
Функция ДлинаЗначенияAI(AI)

	Если AI = "00" Тогда
		Возврат 18;
	ИначеЕсли AI = "01" ИЛИ AI = "02" Тогда
		Возврат 14;
	ИначеЕсли AI = "11" ИЛИ AI = "13" ИЛИ AI = "15" ИЛИ AI = "17" ИЛИ AI = "8005" ИЛИ Лев(AI, 3) = "310" Тогда
		Возврат 6;
	ИначеЕсли AI = "7003" Тогда
		Возврат 10;
	ИначеЕсли AI = "91" ИЛИ AI = "93" Тогда
		Возврат 4;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Значение переменной длины - до GS. Без GS серийный номер (AI 21) отделяется
// по раскладкам Честного знака:
//   21 серийный 91 XXXX 92 криптоподпись  - лёгкая промышленность, обувь, шины...
//   21 серийный 93 XXXX                    - молочная продукция, вода и др.
//   21 серийный 8005 МРЦ(6) 93 XXXX        - блок сигарет
// Не подошла ни одна - это код идентификации без криптохвоста (обычно в УПД).
//
Функция ЗначениеПеременнойДлины(Остаток, AI)

	ПозицияGS = СтрНайти(Остаток, Символ(29));
	Если ПозицияGS > 0 Тогда
		Возврат Лев(Остаток, ПозицияGS - 1);
	КонецЕсли;

	Если AI <> "21" Тогда
		Возврат Остаток;
	КонецЕсли;

	Для ДлинаСерийного = 6 По Мин(СтрДлина(Остаток) - 1, 20) Цикл

		Хвост = Сред(Остаток, ДлинаСерийного + 1);

		Если СтрНачинаетсяС(Хвост, "91") И СтрДлина(Хвост) > 8 И Сред(Хвост, 7, 2) = "92" Тогда
			Возврат Лев(Остаток, ДлинаСерийного);
		ИначеЕсли СтрНачинаетсяС(Хвост, "93") И СтрДлина(Хвост) = 6 Тогда
			Возврат Лев(Остаток, ДлинаСерийного);
		ИначеЕсли СтрНачинаетсяС(Хвост, "8005") И СтрДлина(Хвост) = 16 И Сред(Хвост, 11, 2) = "93" Тогда
			Возврат Лев(Остаток, ДлинаСерийного);
		КонецЕсли;

	КонецЦикла;

	Возврат Лев(Остаток, 20);

КонецФункции

Процедура ПрименитьAI(Разбор, AI, Значение)

	Если AI = "01" ИЛИ AI = "02" Тогда
		Разбор.GTIN = Значение;
	ИначеЕсли AI = "00" Тогда
		Разбор.SSCC = Значение;
	ИначеЕсли AI = "21" Тогда
		Разбор.Серийный = Значение;
	ИначеЕсли AI = "91" Тогда
		Разбор.КлючПроверки = Значение;
	ИначеЕсли AI = "92" ИЛИ AI = "93" Тогда
		Разбор.Криптоподпись = Значение;
	ИначеЕсли AI = "10" Тогда
		Разбор.Партия = Значение;
	ИначеЕсли AI = "17" Тогда
		Разбор.ГоденДо = ДатаGS1(Значение);
	ИначеЕсли AI = "11" Тогда
		Разбор.ДатаПроизводства = ДатаGS1(Значение);
	ИначеЕсли AI = "8005" И ТолькоЦифры(Значение) Тогда
		Разбор.МРЦ = Число(Значение) / 100;
	ИначеЕсли Лев(AI, 3) = "310" И ТолькоЦифры(Значение) Тогда
		Разбор.Вес = Число(Значение) / Pow(10, Число(Прав(AI, 1)));
	КонецЕсли;

КонецПроцедуры

Функция ОписаниеКодаЧестныйЗнак(Разбор)

	Части = Новый Массив;
	Части.Добавить("Честный знак");
	Части.Добавить(СтрШаблон("GTIN %1 (%2)", Разбор.GTIN, ОписаниеGTIN(Разбор.GTIN).Кратко));

	Если ЗначениеЗаполнено(Разбор.Серийный) Тогда
		Части.Добавить(СтрШаблон("серийный %1 (%2 зн.)", Разбор.Серийный, СтрДлина(Разбор.Серийный)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Разбор.КлючПроверки) Тогда
		Части.Добавить("ключ проверки " + Разбор.КлючПроверки);
	КонецЕсли;
	Если ЗначениеЗаполнено(Разбор.Криптоподпись) Тогда
		Части.Добавить(СтрШаблон("криптоподпись %1 (%2 зн.)", Лев(Разбор.Криптоподпись, 8)
			+ ?(СтрДлина(Разбор.Криптоподпись) > 8, "...", ""), СтрДлина(Разбор.Криптоподпись)));
	Иначе
		Части.Добавить("без криптохвоста - код идентификации");
	КонецЕсли;
	Если Разбор.МРЦ > 0 Тогда
		Части.Добавить(СтрШаблон("МРЦ %1 руб.", Формат(Разбор.МРЦ, "ЧДЦ=2; ЧГ=0")));
	КонецЕсли;
	Если ЗначениеЗаполнено(Разбор.ГоденДо) Тогда
		Части.Добавить("годен до " + Формат(Разбор.ГоденДо, "ДЛФ=D"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Разбор.ДатаПроизводства) Тогда
		Части.Добавить("произведён " + Формат(Разбор.ДатаПроизводства, "ДЛФ=D"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Разбор.Партия) Тогда
		Части.Добавить("партия " + Разбор.Партия);
	КонецЕсли;
	Если Разбор.Вес > 0 Тогда
		Части.Добавить(СтрШаблон("вес %1 кг", Разбор.Вес));
	КонецЕсли;

	Возврат СтрСоединить(Части, ", ");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Приводит разделитель GS, записанный текстом, к символу 29 и снимает
// идентификатор символики сканера (]d2, ]C1, ]Q3).
//
Функция НормализованныйКод(Код)

	Текст = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(Код));

	Для Каждого ЗаписьGS Из СтрРазделить("&#29;|&#x1D;|&#x1d;|\x1d||<GS>|{GS}", "|") Цикл
		Текст = СтрЗаменить(Текст, ЗаписьGS, Символ(29));
	КонецЦикла;

	Для Каждого Префикс Из СтрРазделить("]d2|]C1|]Q3", "|") Цикл
		Если СтрНачинаетсяС(Текст, Префикс) Тогда
			Текст = Сред(Текст, СтрДлина(Префикс) + 1);
		КонецЕсли;
	КонецЦикла;

	Если СтрНачинаетсяС(Текст, Символ(29)) Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Контрольная цифра GS1 (GTIN, SSCC): веса 3 и 1 справа налево, без последней цифры.
//
Функция КонтрольнаяЦифраВерна(Цифры)

	Длина = СтрДлина(Цифры);
	Если Длина < 2 ИЛИ НЕ ТолькоЦифры(Цифры) Тогда
		Возврат Ложь;
	КонецЕсли;

	Сумма = 0;
	Вес = 3;
	Для Позиция = 1 По Длина - 1 Цикл
		Сумма = Сумма + Число(Сред(Цифры, Длина - Позиция, 1)) * Вес;
		Вес = ?(Вес = 3, 1, 3);
	КонецЦикла;

	Возврат (10 - Сумма % 10) % 10 = Число(Прав(Цифры, 1));

КонецФункции

// Страна регистрации кода по префиксу GS1 (первые три цифры GTIN-13).
//
Функция СтранаGS1(Префикс)

	Если НЕ ТолькоЦифры(Префикс) Тогда
		Возврат "префикс не распознан";
	КонецЕсли;

	П = Число(Префикс);

	Диапазоны = "0-19:США и Канада;20-29:внутренняя нумерация;30-39:США (лекарства);40-49:внутренняя нумерация;"
		+ "50-59:купоны;60-139:США и Канада;200-299:внутренняя нумерация (в т.ч. коды, выданные Честным знаком);"
		+ "300-379:Франция;380-380:Болгария;383-383:Словения;385-385:Хорватия;400-440:Германия;450-459:Япония;"
		+ "460-469:Россия;470-470:Кыргызстан;471-471:Тайвань;474-474:Эстония;475-475:Латвия;476-476:Азербайджан;"
		+ "477-477:Литва;478-478:Узбекистан;479-479:Шри-Ланка;480-480:Филиппины;481-481:Беларусь;482-482:Украина;"
		+ "483-483:Туркменистан;484-484:Молдова;485-485:Армения;486-486:Грузия;487-487:Казахстан;488-488:Таджикистан;"
		+ "489-489:Гонконг;490-499:Япония;500-509:Великобритания;520-521:Греция;540-549:Бельгия и Люксембург;"
		+ "560-560:Португалия;569-569:Исландия;570-579:Дания;590-590:Польша;594-594:Румыния;599-599:Венгрия;"
		+ "600-601:ЮАР;690-699:Китай;700-709:Норвегия;729-729:Израиль;730-739:Швеция;760-769:Швейцария;"
		+ "770-771:Колумбия;789-790:Бразилия;800-839:Италия;840-849:Испания;850-850:Куба;858-858:Словакия;"
		+ "859-859:Чехия;860-860:Сербия;865-865:Монголия;868-869:Турция;870-879:Нидерланды;880-880:Южная Корея;"
		+ "885-885:Таиланд;888-888:Сингапур;890-890:Индия;893-893:Вьетнам;899-899:Индонезия;900-919:Австрия;"
		+ "930-939:Австралия;940-949:Новая Зеландия;955-955:Малайзия;977-977:периодика (ISSN);978-979:книги (ISBN);"
		+ "980-980:возвратные квитанции;990-999:купоны";

	Для Каждого Диапазон Из СтрРазделить(Диапазоны, ";", Ложь) Цикл
		Границы = СтрРазделить(Лев(Диапазон, СтрНайти(Диапазон, ":") - 1), "-");
		Если П >= Число(Границы[0]) И П <= Число(Границы[1]) Тогда
			Возврат Сред(Диапазон, СтрНайти(Диапазон, ":") + 1);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон("префикс %1 не закреплён за страной", Префикс);

КонецФункции

Функция ДатаGS1(Значение)

	Если СтрДлина(Значение) <> 6 ИЛИ НЕ ТолькоЦифры(Значение) Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Год   = 2000 + Число(Лев(Значение, 2));
		Месяц = Число(Сред(Значение, 3, 2));
		День  = Число(Прав(Значение, 2));
		// День 00 в GS1 - последний день месяца
		Возврат ?(День = 0, НачалоДня(КонецМесяца(Дата(Год, Месяц, 1))), Дата(Год, Месяц, День));
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

Функция ДополнитьНулями(Цифры, Длина)

	Результат = Цифры;
	Пока СтрДлина(Результат) < Длина Цикл
		Результат = "0" + Результат;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ТолькоЦифры(Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ТолькоЦифрыИЛатиница(Значение)

	Допустимые = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";

	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти(Допустимые, Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрДлина(Значение) > 0;

КонецФункции

