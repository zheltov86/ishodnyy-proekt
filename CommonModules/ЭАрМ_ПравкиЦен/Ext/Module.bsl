////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// Правка цены строки приходной накладной Далиона.
//
// Цена в пакете прихода не совпала с УПД - человек исправляет её в «Реестре
// товаров по заказам» и обязательно пишет комментарий. Правка хранится в
// РС ЭАрМ_ПравкиЦенПриходов (поступление + номер строки в пакете) и применяется
// при каждой сверке вместо цены пакета, поэтому переживает пересверку и приём
// пакета заново. Строка правки действует, только пока наименование строки
// в пакете то же (порядок строк мог смениться).
//
// После правки цепочка пересверяется: реестр товаров, итог цепочки и реестр УПД
// («Сошлось», если итоговая сумма сошлась) обновляются сами.
//
// Затем в Далион уходит serviceRequest action = editReceiptPrices (как setSeal
// для пломбы). В реестре товаров галочка «Подтвердить в Далион» загорается
// после ответа serviceResponse с priceApplied.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Исправляет цену строк приходной накладной. Комментарий обязателен.
//
// Параметры:
//   ИдентификаторЗаказа      - Строка
//   ИдентификаторПоступления - Строка
//   СтрокиПН                 - Строка - номера строк прихода через «;» (как в реестре товаров)
//   НоваяЦена                - Число - цена за штуку, с НДС, как в реестре
//   Комментарий              - Строка - почему меняется цена
//   ДатаДокументаИзУПД       - Булево - передать в Далион: дату приходной взять по УПД
//
// Возвращаемое значение:
//   Структура - Успех (Булево), Текст (Строка)
//
Функция ИсправитьЦену(ИдентификаторЗаказа, ИдентификаторПоступления, СтрокиПН, НоваяЦена, Комментарий,
		ДатаДокументаИзУПД = Ложь) Экспорт

	// Кратко - для всплывающего оповещения (короткое), Строки - полный разбор по строкам
	Результат = Новый Структура("Успех, Текст, Кратко, Строки", Ложь, "", "", Новый Массив);

	Если ПустаяСтрока(СокрЛП(Комментарий)) Тогда
		Результат.Текст = НСтр("ru = 'Цену можно изменить только с комментарием. Цена не изменена.'");
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(НоваяЦена) <> Тип("Число") ИЛИ НоваяЦена <= 0 Тогда
		Результат.Текст = НСтр("ru = 'Цена должна быть больше нуля.'");
		Возврат Результат;
	КонецЕсли;

	Номера = НомераСтрок(СтрокиПН);
	Если Номера.Количество() = 0 ИЛИ НЕ ЗначениеЗаполнено(ИдентификаторПоступления) Тогда
		Результат.Текст = НСтр("ru = 'У строки нет строки в приходной накладной - цену исправлять нечему.'");
		Возврат Результат;
	КонецЕсли;

	// Цены пакета без правок: «было» и сравнение с исходной ценой
	Позиции = ЭАрМ_ЦепочкаЗакупки.ПозицииПоступления(ИдентификаторПоступления, Истина);
	Пользователь = ?(ЗначениеЗаполнено(ПолноеИмяПользователя()), ПолноеИмяПользователя(), ИмяПользователя());
	Исправлено = 0;
	Тексты = Новый Массив;

	НачатьТранзакцию();
	Попытка

		Для Каждого Номер Из Номера Цикл

			Если Номер < 1 ИЛИ Номер > Позиции.Количество() Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'В приходной нет строки %1'"), Номер);
			КонецЕсли;
			Позиция = Позиции[Номер - 1];

			Менеджер = РегистрыСведений.ЭАрМ_ПравкиЦенПриходов.СоздатьМенеджерЗаписи();
			Менеджер.ИдентификаторПоступления = Лев(ИдентификаторПоступления, 40);
			Менеджер.НомерСтрокиПН = Номер;

			// Вернули исходную цену пакета - правка снимается
			Если Окр(Позиция.Цена, 4) = Окр(НоваяЦена, 4) Тогда
				Менеджер.Прочитать();
				Если Менеджер.Выбран() Тогда
					Менеджер.Удалить();
				КонецЕсли;
				Тексты.Добавить(СтрШаблон(НСтр("ru = '%1: цена как в пакете, правка снята'"), Позиция.Наименование));
			Иначе
				Менеджер.Наименование = Лев(Позиция.Наименование, 500);
				Менеджер.ЦенаБыла = Позиция.Цена;
				Менеджер.ЦенаСтала = НоваяЦена;
				Менеджер.Комментарий = Лев(СокрЛП(Комментарий), 500);
				Менеджер.Пользователь = Лев(Пользователь, 100);
				Менеджер.ДатаПравки = ТекущаяДатаСеанса();
				Менеджер.ДатаДокументаИзУПД = ДатаДокументаИзУПД;
				Менеджер.ПодтвержденоВДалион = Ложь;
				Менеджер.ЗапросОтправлен = Ложь;
				Менеджер.ИдентификаторЗапросаДалион = "";
				Менеджер.Записать();
				Тексты.Добавить(СтрШаблон(НСтр("ru = '%1: цена %2 -> %3'"),
					Позиция.Наименование, Формат(Позиция.Цена, "ЧДЦ=2; ЧН=0"), Формат(НоваяЦена, "ЧДЦ=2; ЧН=0")));
			КонецЕсли;
			Исправлено = Исправлено + 1;

		КонецЦикла;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Результат.Текст = СтрШаблон(НСтр("ru = 'Цена не изменена: %1'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;

	// Сумма приходной в реестре УПД берётся из цепочки: включаем в неё правку цены
	ЭАрМ_ЦепочкаЗакупки.ПересчитатьСуммуПоступления(ИдентификаторПоступления);

	// Пересверка цепочки: реестр товаров, итог цепочки и реестр УПД обновятся сами
	ТекстСверки = "";
	Попытка
		ЭАрМ_СверкаТоваровЦепочки.СверитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления);
	Исключение
		ТекстСверки = НСтр("ru = ' Пересверка не выполнилась, она пройдёт на ближайшем проходе: '")
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторПоступления, 100), "ПравкаЦены", Истина,
		Лев(СтрШаблон("%1. Комментарий: %2", СтрСоединить(Тексты, "; "), СокрЛП(Комментарий)), 1000));

	ТекстЗапросаДалион = ОтправитьЗапросИзмененияЦеныВДалион(ИдентификаторПоступления, Номера, ДатаДокументаИзУПД);
	Если ЗначениеЗаполнено(ТекстЗапросаДалион) Тогда
		Результат.Строки.Добавить(ТекстЗапросаДалион);
	КонецЕсли;

	ИтогСверки = ИтогСверкиПоступления(ИдентификаторПоступления);

	Результат.Успех = Истина;
	Результат.Строки.Добавить(НСтр("ru = 'Цена подтверждена.'"));
	Для Каждого ТекстСтроки Из Тексты Цикл
		Результат.Строки.Добавить(ТекстСтроки);
	КонецЦикла;
	Результат.Строки.Добавить(СтрШаблон(НСтр("ru = 'Комментарий: %1'"), Лев(СокрЛП(Комментарий), 200)));
	Результат.Строки.Добавить(ИтогСверки.Текст + ТекстСверки);
	Результат.Кратко = СтрШаблон(НСтр("ru = 'Исправлено строк: %1. %2'"), Исправлено, ИтогСверки.Кратко);
	Результат.Текст = СтрСоединить(Результат.Строки, " ");

	Возврат Результат;

КонецФункции

// Применяет правки цен к строкам сверки поступления (вызывается при построении линий).
//
// Параметры:
//   Строки                   - Массив из Структура - строки поступления (Номер, Наименование,
//                              Количество, Цена, Сумма, СуммаНДС)
//   ИдентификаторПоступления - Строка
//
Процедура ПрименитьКСтрокамПоступления(Строки, ИдентификаторПоступления) Экспорт

	Правки = ПравкиПоступления(ИдентификаторПоступления);
	Если Правки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаСверки Из Строки Цикл

		Правка = Правки.Получить(СтрокаСверки.Номер);
		Если Правка = Неопределено ИЛИ НЕ ИмяТоже(Правка.Наименование, СтрокаСверки.Наименование) Тогда
			Продолжить;
		КонецЕсли;

		СтараяСумма = СтрокаСверки.Сумма;
		СтрокаСверки.Цена = Правка.ЦенаСтала;
		СтрокаСверки.Сумма = Окр(СтрокаСверки.Количество * Правка.ЦенаСтала, 2);
		Если СтараяСумма <> 0 Тогда
			СтрокаСверки.СуммаНДС = Окр(СтрокаСверки.СуммаНДС * СтрокаСверки.Сумма / СтараяСумма, 2);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Применяет правки цен к позициям прихода (ЭАрМ_ЦепочкаЗакупки.ПозицииПоступления),
// чтобы форма реестра УПД показывала ту же цену, что и сверка.
//
Процедура ПрименитьКПозициям(Позиции, ИдентификаторПоступления) Экспорт

	Правки = ПравкиПоступления(ИдентификаторПоступления);
	Если Правки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Номер = 0;
	Для Каждого Позиция Из Позиции Цикл

		Номер = Номер + 1;
		Правка = Правки.Получить(Номер);
		Если Правка = Неопределено ИЛИ НЕ ИмяТоже(Правка.Наименование, Позиция.Наименование) Тогда
			Продолжить;
		КонецЕсли;

		СтараяСуммаСНДС = ?(Позиция.Свойство("СуммаСНДС"), Позиция.СуммаСНДС, Позиция.Сумма);
		НоваяСуммаСНДС = Окр(Позиция.Количество * Правка.ЦенаСтала, 2);
		Позиция.Цена = Правка.ЦенаСтала;
		Если СтараяСуммаСНДС <> 0 Тогда
			Позиция.Сумма = Окр(Позиция.Сумма * НоваяСуммаСНДС / СтараяСуммаСНДС, 2);
			Позиция.СуммаНДС = Окр(Позиция.СуммаНДС * НоваяСуммаСНДС / СтараяСуммаСНДС, 2);
		КонецЕсли;
		Если Позиция.Свойство("СуммаСНДС") Тогда
			Позиция.СуммаСНДС = НоваяСуммаСНДС;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Сумма приходной с учётом правок цен: сумма пакета плюс разница по исправленным
// строкам. В реестре УПД сумма приходной берётся из цепочки закупки, а там
// лежала сумма из пакета Далиона - правка цены её не меняла.
//
// Параметры:
//   ИдентификаторПоступления - Строка
//   СуммаПакета              - Число - сумма документа из пакета Далиона
//
// Возвращаемое значение:
//   Число - сумма пакета, если правок нет
//
Функция СуммаСПравками(ИдентификаторПоступления, СуммаПакета) Экспорт

	Правки = ПравкиПоступления(ИдентификаторПоступления);
	Если Правки.Количество() = 0 Тогда
		Возврат СуммаПакета;
	КонецЕсли;

	// Строки пакета без правок: разница считается от исходной суммы строки
	Позиции = ЭАрМ_ЦепочкаЗакупки.ПозицииПоступления(ИдентификаторПоступления, Истина);

	Разница = 0;
	Номер = 0;
	Для Каждого Позиция Из Позиции Цикл

		Номер = Номер + 1;
		Правка = Правки.Получить(Номер);
		Если Правка = Неопределено ИЛИ НЕ ИмяТоже(Правка.Наименование, Позиция.Наименование) Тогда
			Продолжить;
		КонецЕсли;

		БылаСумма = ?(Позиция.Свойство("СуммаСНДС"), Позиция.СуммаСНДС, Позиция.Сумма);
		Разница = Разница + Окр(Позиция.Количество * Правка.ЦенаСтала, 2) - БылаСумма;

	КонецЦикла;

	Возврат Окр(СуммаПакета + Разница, 2);

КонецФункции

// Правки поступления: номер строки прихода -> Структура(Наименование, ЦенаБыла,
// ЦенаСтала, Комментарий, Пользователь, ДатаПравки).
//
Функция ПравкиПоступления(ИдентификаторПоступления) Экспорт

	Результат = Новый Соответствие;
	Если НЕ ЗначениеЗаполнено(ИдентификаторПоступления) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правки.НомерСтрокиПН КАК НомерСтрокиПН,
	|	Правки.Наименование КАК Наименование,
	|	Правки.ЦенаБыла КАК ЦенаБыла,
	|	Правки.ЦенаСтала КАК ЦенаСтала,
	|	Правки.Комментарий КАК Комментарий,
	|	Правки.Пользователь КАК Пользователь,
	|	Правки.ДатаПравки КАК ДатаПравки
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПравкиЦенПриходов КАК Правки
	|ГДЕ
	|	Правки.ИдентификаторПоступления = &ИдентификаторПоступления";
	Запрос.УстановитьПараметр("ИдентификаторПоступления", Лев(ИдентификаторПоступления, 40));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Правка = Новый Структура("Наименование, ЦенаБыла, ЦенаСтала, Комментарий, Пользователь, ДатаПравки");
		ЗаполнитьЗначенияСвойств(Правка, Выборка);
		Результат.Вставить(Число(Выборка.НомерСтрокиПН), Правка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Все правки в виде «поступление|номер» -> Структура: для пометки в реестре товаров.
//
Функция ВсеПравки() Экспорт

	Результат = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правки.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Правки.НомерСтрокиПН КАК НомерСтрокиПН,
	|	Правки.ЦенаБыла КАК ЦенаБыла,
	|	Правки.ЦенаСтала КАК ЦенаСтала,
	|	Правки.Комментарий КАК Комментарий,
	|	Правки.Пользователь КАК Пользователь,
	|	Правки.ДатаПравки КАК ДатаПравки,
	|	Правки.ЗапросОтправлен КАК ЗапросОтправлен,
	|	Правки.ПодтвержденоВДалион КАК ПодтвержденоВДалион,
	|	Правки.ИдентификаторЗапросаДалион КАК ИдентификаторЗапросаДалион,
	|	Правки.ДатаДокументаИзУПД КАК ДатаДокументаИзУПД
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПравкиЦенПриходов КАК Правки";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Правка = Новый Структура(
			"ЦенаБыла, ЦенаСтала, Комментарий, Пользователь, ДатаПравки, ЗапросОтправлен, ПодтвержденоВДалион, ИдентификаторЗапросаДалион, ДатаДокументаИзУПД");
		ЗаполнитьЗначенияСвойств(Правка, Выборка);
		Результат.Вставить(СокрЛП(Выборка.ИдентификаторПоступления) + "|" + Формат(Выборка.НомерСтрокиПН, "ЧГ=0"), Правка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Текст правки для комментария строки реестра товаров.
//
Функция ТекстПравки(Правка) Экспорт

	Возврат СтрШаблон(НСтр("ru = 'Цена прихода исправлена вручную: было %1, стало %2. %3 (%4, %5)'"),
		Формат(Правка.ЦенаБыла, "ЧДЦ=2; ЧН=0"), Формат(Правка.ЦенаСтала, "ЧДЦ=2; ЧН=0"),
		СокрЛП(Правка.Комментарий), СокрЛП(Правка.Пользователь), Формат(Правка.ДатаПравки, "ДФ=dd.MM.yyyy"));

КонецФункции

// Статус строки реестра товаров, у которой цену подтвердили вручную.
//
Функция СтатусЦенаПодтверждена() Экспорт

	Возврат НСтр("ru = 'Цена подтверждена'");

КонецФункции

// Результат проверки на сверку после правки: что с УПД цепочки и сколько строк
// приходной ещё не сошлось.
//
Функция ИтогСверкиПоступления(ИдентификаторПоступления)

	Результат = Новый Структура("Текст, Кратко", НСтр("ru = 'Сверка выполнена, итог прочитать не удалось.'"),
		НСтр("ru = 'сверка выполнена'"));

	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УПД.Номер КАК Номер,
		|	УПД.РасхожденийНет КАК РасхожденийНет,
		|	УПД.ТекстСверки КАК ТекстСверки
		|ИЗ
		|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
		|		ПО Цепочка.ИдентификаторУПД = УПД.ИдентификаторСБИС
		|ГДЕ
		|	Цепочка.ИдентификаторПоступления = &ИдентификаторПоступления";
		Запрос.УстановитьПараметр("ИдентификаторПоступления", ИдентификаторПоступления);

		НеСошлись = ЭАрМ_РеестрТоваровЗаказов.НесошедшиесяСтроки(ИдентификаторПоступления).СтрокиПН.Количество();

		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Результат.Текст = СтрШаблон(НСтр("ru = 'Сверка: строк приходной с расхождением - %1 (УПД к приходной не привязана).'"), НеСошлись);
			Результат.Кратко = СтрШаблон(НСтр("ru = 'строк с расхождением: %1'"), НеСошлись);
		ИначеЕсли Выборка.РасхожденийНет Тогда
			Результат.Текст = СтрШаблон(НСтр("ru = 'Сверка: УПД № %1 сошлась. Строк приходной с расхождением: %2.'"), Выборка.Номер, НеСошлись);
			Результат.Кратко = СтрШаблон(НСтр("ru = 'УПД № %1 сошлась'"), Выборка.Номер);
		Иначе
			Результат.Текст = СтрШаблон(НСтр("ru = 'Сверка: УПД № %1 пока не сошлась (%2). Строк приходной с расхождением: %3.'"),
				Выборка.Номер, Лев(СокрЛП(Выборка.ТекстСверки), 150), НеСошлись);
			Результат.Кратко = СтрШаблон(НСтр("ru = 'УПД № %1 пока не сошлась'"), Выборка.Номер);
		КонецЕсли;

	Исключение
		// Текст по умолчанию
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Что не сошлось в дереве реестра товаров: для строки-подсказки в шапке формы.
//
// Параметры:
//   ДеревоДанных - ДеревоЗначений - см. ЭАрМ_РеестрТоваровЗаказов.ДеревоРеестра
//
// Возвращаемое значение:
//   Структура - Текст (Строка), Проблем (Число)
//
Функция ПроблемыДерева(ДеревоДанных) Экспорт

	Счетчики = Новый Структура("Количество, Цена, НетВУПД, НетВПоступлении, Всего", 0, 0, 0, 0, 0);

	Для Каждого УзелВерхний Из ДеревоДанных.Строки Цикл
		Для Каждого УзелПоставки Из УзелВерхний.Строки Цикл
			Для Каждого Товар Из УзелПоставки.Строки Цикл
				Счетчики.Всего = Счетчики.Всего + 1;
				Если Счетчики.Свойство(Товар.Результат) И Товар.Результат <> "Всего" Тогда
					Счетчики[Товар.Результат] = Счетчики[Товар.Результат] + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Проблем = Счетчики.Количество + Счетчики.Цена + Счетчики.НетВУПД + Счетчики.НетВПоступлении;

	Если Счетчики.Всего = 0 Тогда
		Возврат Новый Структура("Текст, Проблем", НСтр("ru = 'Расхождений нет или нет данных за выбранный период и отбор'"), 0);
	КонецЕсли;

	Если Проблем = 0 Тогда
		Возврат Новый Структура("Текст, Проблем",
			СтрШаблон(НСтр("ru = 'Всё сошлось: товаров в списке %1, расхождений нет'"), Счетчики.Всего), 0);
	КонецЕсли;

	Части = Новый Массив;
	Если Счетчики.Количество > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'количество - %1'"), Счетчики.Количество));
	КонецЕсли;
	Если Счетчики.Цена > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'цена - %1'"), Счетчики.Цена));
	КонецЕсли;
	Если Счетчики.НетВУПД > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'нет в УПД - %1'"), Счетчики.НетВУПД));
	КонецЕсли;
	Если Счетчики.НетВПоступлении > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'нет в приходе - %1'"), Счетчики.НетВПоступлении));
	КонецЕсли;

	Возврат Новый Структура("Текст, Проблем",
		СтрШаблон(НСтр("ru = 'Проблемы: %1 (товаров в списке %2). Цену прихода можно изменить в любой строке с приходом: двойной щелчок или «Изменить цену», с комментарием.'"),
			СтрСоединить(Части, "; "), Счетчики.Всего),
		Проблем);

КонецФункции

// Обрабатывает serviceResponse на editReceiptPrices. Истина - пакет обработан
// здесь, пломбу разбирать не нужно.
//
Функция ПрименитьОтветServiceResponse(Данные) Экспорт

	Заголовок = ЭАрМ_Служебный.ЗначениеУзла(Данные, "header");
	ИдентификаторЗапроса = СокрЛП(ЗначениеСтрокой(Заголовок, "requestId"));
	Если НЕ ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЕстьПравкиПоЗапросуДалион(ИдентификаторЗапроса) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Ответ Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Данные, "data")) Цикл

		ИдентификаторПоступления = ЗначениеСтрокой(Ответ, "uid");
		Подтверждено = ЭАрМ_Служебный.ЗначениеУзла(Ответ, "priceApplied", Ложь) = Истина;
		Ошибка = ЗначениеСтрокой(Ответ, "error");

		ОтметитьОтветДалионПоПоступлению(ИдентификаторПоступления, ИдентификаторЗапроса, Подтверждено, Ошибка);

	КонецЦикла;

	ЭАрМ_ЗапросыДалион.ОтметитьОтветПравкиЦены(ИдентификаторЗапроса, Истина, "");

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область Служебные

Функция ДействиеИзмененияЦеныВДалионе()

	Возврат "editReceiptPrices";

КонецФункции

// Отправляет в Далион правки строк приходной, только что записанные в регистр.
//
Функция ОтправитьЗапросИзмененияЦеныВДалион(ИдентификаторПоступления, НомераСтрок, ДатаДокументаИзУПД)

	Правки = ПравкиПоступления(ИдентификаторПоступления);
	СтрокиЗапроса = Новый Массив;

	Для Каждого Номер Из НомераСтрок Цикл

		Правка = Правки.Получить(Номер);
		Если Правка = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СтрокаJSON = Новый Структура;
		СтрокаJSON.Вставить("lineNo", Номер);
		СтрокаJSON.Вставить("price", Правка.ЦенаСтала);
		СтрокаJSON.Вставить("comment", СокрЛП(Правка.Комментарий));
		СтрокиЗапроса.Добавить(СтрокаJSON);

	КонецЦикла;

	Если СтрокиЗапроса.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	НомерПоступления = НомерПоступленияИзПакета(ИдентификаторПоступления);
	Документ = Новый Структура("uid, number, lines", ИдентификаторПоступления, НомерПоступления, СтрокиЗапроса);
	СписокДокументов = Новый Массив;
	СписокДокументов.Добавить(Документ);

	Данные = Новый Структура;
	Данные.Вставить("action", ДействиеИзмененияЦеныВДалионе());
	Данные.Вставить("useDocumentDateFromUpd", ДатаДокументаИзУПД);
	Данные.Вставить("documents", СписокДокументов);

	Отправка = ЭАрМ_ЗапросыДалион.ОтправитьServiceRequest(Данные, ИдентификаторПоступления);

	Если Отправка.Успех Тогда
		ОтметитьОтправкуЗапроса(ИдентификаторПоступления, НомераСтрок, Отправка.ИдентификаторЗапроса, ДатаДокументаИзУПД);
		ЭАрМ_ЗапросыДалион.ЗафиксироватьЗапросПравкиЦены(Отправка.ИдентификаторЗапроса,
			ИдентификаторПоступления, Отправка.ИмяФайла, Истина, "");
		Возврат СтрШаблон(НСтр("ru = 'Запрос изменения цены в Далион отправлен (%1).'"), Отправка.ИмяФайла);
	КонецЕсли;

	ЭАрМ_ЗапросыДалион.ЗафиксироватьЗапросПравкиЦены(Отправка.ИдентификаторЗапроса,
		ИдентификаторПоступления, Отправка.ИмяФайла, Ложь, Отправка.Ошибка);
	Возврат СтрШаблон(НСтр("ru = 'Запрос в Далион не отправлен: %1'"), Отправка.Ошибка);

КонецФункции

Процедура ОтметитьОтправкуЗапроса(ИдентификаторПоступления, НомераСтрок, ИдентификаторЗапроса, ДатаДокументаИзУПД)

	Для Каждого Номер Из НомераСтрок Цикл

		Менеджер = РегистрыСведений.ЭАрМ_ПравкиЦенПриходов.СоздатьМенеджерЗаписи();
		Менеджер.ИдентификаторПоступления = Лев(ИдентификаторПоступления, 40);
		Менеджер.НомерСтрокиПН = Номер;
		Менеджер.Прочитать();
		Если НЕ Менеджер.Выбран() Тогда
			Продолжить;
		КонецЕсли;

		Менеджер.ЗапросОтправлен = Истина;
		Менеджер.ИдентификаторЗапросаДалион = Лев(ИдентификаторЗапроса, 36);
		Менеджер.ДатаДокументаИзУПД = ДатаДокументаИзУПД;
		Менеджер.ПодтвержденоВДалион = Ложь;
		Менеджер.Записать();

	КонецЦикла;

КонецПроцедуры

Процедура ОтметитьОтветДалионПоПоступлению(ИдентификаторПоступления, ИдентификаторЗапроса, Подтверждено, Ошибка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правки.НомерСтрокиПН КАК НомерСтрокиПН
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПравкиЦенПриходов КАК Правки
	|ГДЕ
	|	Правки.ИдентификаторПоступления = &ИдентификаторПоступления
	|	И Правки.ИдентификаторЗапросаДалион = &ИдентификаторЗапроса";
	Запрос.УстановитьПараметр("ИдентификаторПоступления", Лев(ИдентификаторПоступления, 40));
	Запрос.УстановитьПараметр("ИдентификаторЗапроса", Лев(ИдентификаторЗапроса, 36));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Менеджер = РегистрыСведений.ЭАрМ_ПравкиЦенПриходов.СоздатьМенеджерЗаписи();
		Менеджер.ИдентификаторПоступления = Лев(ИдентификаторПоступления, 40);
		Менеджер.НомерСтрокиПН = Выборка.НомерСтрокиПН;
		Менеджер.Прочитать();
		Если НЕ Менеджер.Выбран() Тогда
			Продолжить;
		КонецЕсли;

		Менеджер.ПодтвержденоВДалион = Подтверждено;
		Менеджер.Записать();

	КонецЦикла;

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторПоступления, 100), "ПравкаЦеныДалион",
		Подтверждено, Лев(?(ЗначениеЗаполнено(Ошибка), Ошибка,
			?(Подтверждено, "Цена подтверждена в Далион", "Далион не подтвердил правку")), 500));

КонецПроцедуры

Функция ЕстьПравкиПоЗапросуДалион(ИдентификаторЗапроса)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Поле
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПравкиЦенПриходов КАК Правки
	|ГДЕ
	|	Правки.ИдентификаторЗапросаДалион = &ИдентификаторЗапроса";
	Запрос.УстановитьПараметр("ИдентификаторЗапроса", Лев(ИдентификаторЗапроса, 36));

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

Функция НомерПоступленияИзПакета(ИдентификаторПоступления)

	Объект = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ПриходнаяНакладная", ИдентификаторПоступления);
	Если Объект = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Объект, "number", ""));

КонецФункции

Функция ЗначениеСтрокой(Узел, Имя)

	Если Узел = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Узел, Имя, "")));

КонецФункции

Функция НомераСтрок(СтрокаНомеров)

	Результат = Новый Массив;
	Для Каждого Часть Из СтрРазделить(СтрЗаменить(СокрЛП(СтрокаНомеров), ",", ";"), ";", Ложь) Цикл
		Попытка
			Номер = Число(СокрЛП(Часть));
		Исключение
			Продолжить;
		КонецПопытки;
		Если Номер > 0 И Результат.Найти(Номер) = Неопределено Тогда
			Результат.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ИмяТоже(ИмяА, ИмяБ)

	Возврат ЭАрМ_СверкаТоваровЦепочки.НормализованноеНаименование(ИмяА)
		= ЭАрМ_СверкаТоваровЦепочки.НормализованноеНаименование(ИмяБ);

КонецФункции

#КонецОбласти
