#Область СлужебныйПрограммныйИнтерфейс

// Собирает читаемое имя документа ЭДО из элемента реестра.
//
// В колонке УПД реестра ЭТрН должен стоять документ, который видно глазами,
// а не идентификатор СБИС из тридцати с лишним символов.
//
// Параметры:
//   ДокументРеестра - Соответствие - элемент реестра ЭДО
//
// Возвращаемое значение:
//   Строка - например "УПД №68387 от 01.09.2026". Пустая, если ни номера,
//            ни названия у документа нет
//
Функция ПредставлениеДокументаЭДО(ДокументРеестра) Экспорт

	Если ТипЗнч(ДокументРеестра) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПредставлениеИзЧастей(
		ФорматДокументаПоВложениям(ДокументРеестра),
		СтрокойИлиПусто(ЗначениеУзла(ДокументРеестра, "Номер", "")),
		СтрокойИлиПусто(ЗначениеУзла(ДокументРеестра, "Дата", "")),
		СтрокойИлиПусто(ЗначениеУзла(ДокументРеестра, "Название", "")));

КонецФункции

// Складывает имя документа из вида, номера и даты.
//
// Параметры:
//   Вид      - Строка - формат документа, например "УПД"
//   Номер    - Строка
//   Дата     - Строка
//   Название - Строка - запасной вариант, когда номера нет
//
// Возвращаемое значение:
//   Строка
//
Функция ПредставлениеИзЧастей(Вид, Номер, Дата, Название = "")

	Если НЕ ЗначениеЗаполнено(Номер) Тогда
		// Без номера имя не собрать - отдаём название документа как есть
		Возврат СокрЛП(Название);
	КонецЕсли;

	Представление = СтрШаблон("%1 №%2",
		?(ЗначениеЗаполнено(Вид), Вид, "Документ"), СокрЛП(Номер));

	Если ЗначениеЗаполнено(Дата) Тогда
		Представление = Представление + " от " + СокрЛП(Дата);
	КонецЕсли;

	Возврат Представление;

КонецФункции

// Добавляет сопроводительный документ в список связанных.
//
Процедура ДобавитьСвязанныйДокумент(СписокДокументов, ДанныеДокумента, Роль) Экспорт

	Если ДанныеДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Номер         = СтрокойИлиПусто(ЗначениеУзла(ДанныеДокумента, "Номер", ""));
	Наименование  = СтрокойИлиПусто(ЗначениеУзла(ДанныеДокумента, "Наименование", ""));
	Идентификатор = СтрокойИлиПусто(
		ЗначениеПоКлючам(ДанныеДокумента, "Идентификатор,ИД,SbisId,ПервичныйКлюч"));

	Если НЕ ЗначениеЗаполнено(Номер)
		И НЕ ЗначениеЗаполнено(Наименование)
		И НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	СвязанныйДокумент = Новый Структура;
	СвязанныйДокумент.Вставить("Роль",          Роль);
	СвязанныйДокумент.Вставить("Номер",         Номер);
	СвязанныйДокумент.Вставить("Дата",          СтрокойИлиПусто(ЗначениеУзла(ДанныеДокумента, "Дата", "")));
	СвязанныйДокумент.Вставить("Наименование",  Наименование);
	СвязанныйДокумент.Вставить("Идентификатор", Идентификатор);

	СписокДокументов.Добавить(СвязанныйДокумент);

КонецПроцедуры

// Возвращает вложения, в которых могут лежать строки товаров, - в порядке
// правдоподобия.
//
// Имя файла ФНС кодирует вид титула: в информации продавца (ON_NSCHFDOPPR
// и подобных) таблица товаров есть, в титуле покупателя (…POK) и служебных
// документах ЭДО (DP_…) её нет. Но имена у поставщиков плавают, поэтому
// слабых кандидатов не выбрасываем, а ставим в конец очереди: разбор всё
// равно покажет, есть там строки или нет.
//
// Возвращаемое значение:
//   Массив структур - Имя, Ссылка, Идентификатор
//
// Возвращает первое непустое строковое значение из перечня путей узла вложения.
// Пути перечисляются через запятую и могут быть вложенными: "Файл.Ссылка".
// Имя и ссылка файла в разных форматах вложения лежат по-разному, поэтому
// перебираем известные варианты, а не угадываем один.
//
Функция ЗначениеВложенияПоПути(ДанныеВложения, Пути) Экспорт

	Для Каждого Путь Из СтрРазделить(Пути, ",", Ложь) Цикл

		Значение = ЗначениеПоПути(ДанныеВложения, СокрЛП(Путь), "");

		Если ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

Функция ВложенияСДаннымиТоваров(ДокументСБИС) Экспорт

	Основные       = Новый Массив;
	Второстепенные = Новый Массив;

	УзелВложений = ЗначениеУзла(ДокументСБИС, "Вложение");
	Если УзелВложений = Неопределено Тогда
		УзелВложений = ЗначениеУзла(ДокументСБИС, "Вложения");
	КонецЕсли;

	Для Каждого ДанныеВложения Из ЗначениеВМассив(УзелВложений) Цикл

		Если СтрокойИлиПусто(ЗначениеУзла(ДанныеВложения, "Служебный", "")) = "Да" Тогда
			Продолжить;
		КонецЕсли;

		// Имя и ссылка в разных форматах вложения лежат по-разному: перебираем
		// известные пути, а ссылку при неудаче ищем по имени ключа в глубину.
		ИмяФайла = ЗначениеВложенияПоПути(ДанныеВложения,
			"Файл.Имя,Имя,Файл.ИмяФайла,Наименование");

		Ссылка = ЗначениеВложенияПоПути(ДанныеВложения,
			"Файл.Ссылка,Ссылка,Файл.СсылкаНаФайл,URL");
		Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
			Ссылка = НайтиЗначениеПоИмениКлюча(ДанныеВложения, "Ссылка,URL,СсылкаНаФайл");
		КонецЕсли;

		// Строки товаров есть только в XML формата ФНС
		Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(ИмяФайла) И НРег(Прав(ИмяФайла, 4)) <> ".xml" Тогда
			Продолжить;
		КонецЕсли;

		ИмяВРегистре = ВРег(ИмяФайла);

		// Транспортная накладная и путевой лист товарными документами не являются
		Если СтрНайти(ИмяВРегистре, "TRNACL") > 0
			Или СтрНайти(ИмяВРегистре, "WAYBILL") > 0 Тогда
			Продолжить;
		КонецЕсли;

		// Акт сверки (ON_ACCOUNTS) и счёт на оплату (ON_SCHET) - не товарные
		// документы: у них табличный документ без строк товаров
		Если СтрНайти(ИмяВРегистре, "ON_ACCOUNTS") > 0
			Или СтрНайти(ИмяВРегистре, "ON_SCHET_") > 0 Тогда
			Продолжить;
		КонецЕсли;

		ОписаниеВложения = Новый Структура;
		ОписаниеВложения.Вставить("Имя",           ИмяФайла);
		ОписаниеВложения.Вставить("Ссылка",        Ссылка);
		ОписаниеВложения.Вставить("Идентификатор",
			СтрокойИлиПусто(ЗначениеУзла(ДанныеВложения, "Идентификатор", "")));

		Если СтрНайти(ИмяВРегистре, "POK") > 0 Или Лев(ИмяВРегистре, 3) = "DP_" Тогда
			Второстепенные.Добавить(ОписаниеВложения);
		Иначе
			Основные.Добавить(ОписаниеВложения);
		КонецЕсли;

	КонецЦикла;

	Для Каждого ОписаниеВложения Из Второстепенные Цикл
		Основные.Добавить(ОписаниеВложения);
	КонецЦикла;

	Возврат Основные;

КонецФункции
// Перечисляет имена вложений документа - для диагностики, когда подходящего
// вложения с данными товаров не нашлось.
//
// Возвращаемое значение:
//   Строка - имена через "; ", либо "нет"
//
Функция ИменаВложенийДляДиагностики(ДокументСБИС) Экспорт

	УзелВложений = ЗначениеУзла(ДокументСБИС, "Вложение");
	Если УзелВложений = Неопределено Тогда
		УзелВложений = ЗначениеУзла(ДокументСБИС, "Вложения");
	КонецЕсли;

	ЧастиОписания = Новый Массив;

	Для Каждого ДанныеВложения Из ЗначениеВМассив(УзелВложений) Цикл

		ИмяФайла = СтрокойИлиПусто(ЗначениеПоПути(ДанныеВложения, "Файл.Имя", ""));
		Если ЗначениеЗаполнено(ИмяФайла) Тогда
			ЧастиОписания.Добавить(ИмяФайла);
		КонецЕсли;

	КонецЦикла;

	Если ЧастиОписания.Количество() = 0 Тогда
		Возврат "нет";
	КонецЕсли;

	Возврат СтрСоединить(ЧастиОписания, "; ");

КонецФункции

// Скачивает вложение по ссылке во временный файл.
//
// Обычный GET с заголовком сессии: файл отдаётся по прямой ссылке, JSON-RPC
// тут ни при чём. Пишем в файл, а не в строку - XML формата ФНС объявляет
// windows-1251, и только чтение файла даёт правильную перекодировку.
//
// Возвращаемое значение:
//   Строка - путь к временному файлу; пустая строка при ошибке
//
Функция СкачатьВложениеВФайл(ОписаниеВложения, Сессия, АдресСервиса,
		КешСоединений = Неопределено) Экспорт

	// Тонкая обёртка над СкачатьВложениеПоСсылке: оставлена для совместимости
	// с прежними вызовами, передающими структуру "Имя, Ссылка".
	Возврат СкачатьВложениеПоСсылке(
		ОписаниеВложения.Ссылка, Сессия, АдресСервиса, ОписаниеВложения.Имя,
		КешСоединений);

КонецФункции

// Скачивает файл по прямой ссылке во временный файл.
//
// Обычный GET с заголовком сессии: файл отдаётся по прямой ссылке, JSON-RPC
// тут ни при чём. Пишем в файл, а не в строку - XML формата ФНС объявляет
// windows-1251, и только чтение файла даёт правильную перекодировку.
//
// Параметры:
//   СсылкаНаФайл - Строка - полный URL либо путь от корня сервера
//   Сессия       - Строка - session ID (sid)
//   АдресСервиса - Строка
//   ИмяДляОшибки - Строка - имя файла для текста ошибки (необязательно)
//   КешСоединений - см. НовыйКешСоединенийСБИС
//
// Возвращаемое значение:
//   Строка - путь к временному файлу; пустая строка при ошибке
//
Функция СкачатьВложениеПоСсылке(СсылкаНаФайл, Сессия = "", АдресСервиса = "",
		ИмяДляОшибки = "", КешСоединений = Неопределено) Экспорт

	Настройки = ЭАрМ_НастройкиСервер.НастройкиСБИС();

	ИдСессии = Сессия;
	Если НЕ ЗначениеЗаполнено(ИдСессии) Тогда
		ИдСессии = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	КонецЕсли;

	ХостПоУмолчанию = АдресСервиса;
	Если НЕ ЗначениеЗаполнено(ХостПоУмолчанию) Тогда
		ХостПоУмолчанию = Настройки.АдресСервера;
	КонецЕсли;

	// В сообщениях об ошибке показываем имя файла, если его передали,
	// иначе - саму ссылку
	ОписаниеОбъекта = ?(ЗначениеЗаполнено(ИмяДляОшибки), ИмяДляОшибки, СсылкаНаФайл);

	ТекущаяСсылка = СсылкаНаФайл;

	// Ссылка на вложение ведёт через переадресацию: сам файл лежит в хранилище
	// на другом адресе. 1С переходы не отрабатывает, а СБИС вдобавок отдаёт
	// переадресацию телом ответа с кодом 200 - и тогда вместо XML сохраняется
	// страница "Found. Redirecting to ...", в которой строк товаров, конечно,
	// нет. Поэтому идём по переходам сами.
	Для НомерПерехода = 1 По 5 Цикл

		ПараметрыСсылки = РазобратьСсылкуНаФайл(ТекущаяСсылка, ХостПоУмолчанию);
		ВременныйФайл   = ПолучитьИмяВременногоФайла("xml");

		Попытка

			Соединение = СоединениеСБИС(ПараметрыСсылки.Хост, КешСоединений);

			Запрос = Новый HTTPЗапрос(ПараметрыСсылки.Путь);
			Запрос.Заголовки.Вставить("X-SBISSessionID", ИдСессии);

			Попытка
				Ответ = Соединение.Получить(Запрос, ВременныйФайл);
			Исключение
				// Кешированное соединение сервер мог закрыть - поднимаем заново
				Если ТипЗнч(КешСоединений) <> Тип("Соответствие") Тогда
					ВызватьИсключение;
				КонецЕсли;
				ЗабытьСоединениеСБИС(ПараметрыСсылки.Хост, КешСоединений);
				Соединение = СоединениеСБИС(ПараметрыСсылки.Хост, КешСоединений);
				Ответ = Соединение.Получить(Запрос, ВременныйФайл);
			КонецПопытки;

		Исключение
			ЗабытьСоединениеСБИС(ПараметрыСсылки.Хост, КешСоединений);
			ЗаписатьОшибку("СкачатьВложениеПоСсылке", СтрШаблон("Ошибка загрузки %1: %2",
				ОписаниеОбъекта, ТекстИсключения(ИнформацияОбОшибке())));
			УдалитьВременныйФайл(ВременныйФайл);
			Возврат "";
		КонецПопытки;

		// Переадресация заголовком
		Если Ответ.КодСостояния >= 300 И Ответ.КодСостояния < 400 Тогда

			НоваяСсылка = ЗаголовокОтвета(Ответ, "Location");
			УдалитьВременныйФайл(ВременныйФайл);

			Если НЕ ЗначениеЗаполнено(НоваяСсылка) Тогда
				ЗаписатьОшибку("СкачатьВложениеПоСсылке", СтрШаблон(
					"HTTP %1 без заголовка Location по ссылке %2",
					Ответ.КодСостояния, ОписаниеОбъекта));
				Возврат "";
			КонецЕсли;

			ХостПоУмолчанию = ПараметрыСсылки.Хост;
			ТекущаяСсылка   = НоваяСсылка;
			Продолжить;

		КонецЕсли;

		Если Ответ.КодСостояния <> 200 Тогда
			ЗаписатьОшибку("СкачатьВложениеПоСсылке",
				СтрШаблон("HTTP %1 по ссылке %2", Ответ.КодСостояния, ОписаниеОбъекта));
			УдалитьВременныйФайл(ВременныйФайл);
			Возврат "";
		КонецЕсли;

		// Переадресация телом ответа
		НоваяСсылка = СсылкаПереадресацииИзФайла(ВременныйФайл);

		Если ЗначениеЗаполнено(НоваяСсылка) Тогда
			УдалитьВременныйФайл(ВременныйФайл);
			ХостПоУмолчанию = ПараметрыСсылки.Хост;
			ТекущаяСсылка   = НоваяСсылка;
			Продолжить;
		КонецЕсли;

		Возврат ВременныйФайл;

	КонецЦикла;

	ЗаписатьОшибку("СкачатьВложениеПоСсылке",
		СтрШаблон("Слишком много переадресаций при загрузке %1", ОписаниеОбъекта));

	Возврат "";

КонецФункции

// Возвращает заголовок ответа без учёта регистра имени.
//
// Регистр заголовков сервер выбирает сам, а Соответствие в 1С регистр
// различает - поэтому перебираем.
//
// Возвращаемое значение:
//   Строка - пустая, если заголовка нет
//
Функция ЗаголовокОтвета(Ответ, ИмяЗаголовка)

	Для Каждого КлючЗначение Из Ответ.Заголовки Цикл
		Если ВРег(КлючЗначение.Ключ) = ВРег(ИмяЗаголовка) Тогда
			Возврат СтрокойИлиПусто(КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Достаёт адрес перехода из тела ответа.
//
// СБИС отвечает на ссылку вложения страницей "Found. Redirecting to <адрес>"
// с кодом 200. Так же её распознаёт штатная обработка Sbis1C: без этого шага
// вместо XML сохраняется сама страница.
//
// Возвращаемое значение:
//   Строка - адрес перехода; пустая, если это не переадресация
//
Функция СсылкаПереадресацииИзФайла(ПутьКФайлу)

	НачалоФайла = ПервыеСимволыФайла(ПутьКФайлу, 1000);

	Если НЕ ЗначениеЗаполнено(НачалоФайла) Тогда
		Возврат "";
	КонецЕсли;

	Маркер  = "Redirecting to";
	Позиция = СтрНайти(НачалоФайла, Маркер);

	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = СокрЛП(Сред(НачалоФайла, Позиция + СтрДлина(Маркер)));

	Возврат АдресДоРазделителя(Хвост);

КонецФункции

// Обрезает адрес по первому разделителю: в теле переадресации за адресом
// идут кавычка, пробел, перевод строки или закрывающий тег.
//
// Возвращаемое значение:
//   Строка
//
Функция АдресДоРазделителя(Текст)

	СтопСимволы = " " + """" + "<>" + Символы.ПС + Символы.ВК + Символы.Таб;

	Для Позиция = 1 По СтрДлина(Текст) Цикл

		Если СтрНайти(СтопСимволы, Сред(Текст, Позиция, 1)) > 0 Тогда
			Возврат Лев(Текст, Позиция - 1);
		КонецЕсли;

	КонецЦикла;

	Возврат Текст;

КонецФункции

// Возвращает начало файла текстом - для диагностики.
//
// Кодировку не знаем: XML формата ФНС объявляет windows-1251, а страница
// ошибки приходит в UTF-8. Пробуем обе, нам нужны только первые символы.
//
// Возвращаемое значение:
//   Строка - пустая, если прочитать не удалось
//
Функция ПервыеСимволыФайла(ПутьКФайлу, Количество = 200)

	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого ИмяКодировки Из СтрРазделить("UTF-8,windows-1251", ",", Ложь) Цикл

		НачалоФайла  = Неопределено;
		ЧтениеТекста = Неопределено;

		Попытка
			ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, ИмяКодировки);
			НачалоФайла  = ЧтениеТекста.Прочитать(Количество);
		Исключение
			// пробуем следующую кодировку
		КонецПопытки;

		// Файл потом удаляется, поэтому закрываем чтение в любом случае
		Если ЧтениеТекста <> Неопределено Тогда
			Попытка
				ЧтениеТекста.Закрыть();
			Исключение
				// чтение уже закрыто
			КонецПопытки;
		КонецЕсли;

		Если НачалоФайла <> Неопределено Тогда
			Возврат СокрЛП(СтрЗаменить(СтрЗаменить(НачалоФайла,
				Символы.ПС, " "), Символы.ВК, " "));
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

// Разбирает ссылку на файл в хост и путь.
// СБИС отдаёт то полный URL, то путь от корня.
//
// Возвращаемое значение:
//   Структура - Хост, Путь
//
Функция РазобратьСсылкуНаФайл(СсылкаНаФайл, АдресПоУмолчанию)

	Результат = Новый Структура("Хост, Путь", АдресПоУмолчанию, СсылкаНаФайл);

	Ссылка = СокрЛП(СсылкаНаФайл);

	Для Каждого Протокол Из СтрРазделить("https://,http://", ",", Ложь) Цикл

		Если НРег(Лев(Ссылка, СтрДлина(Протокол))) = Протокол Тогда

			БезПротокола = Сред(Ссылка, СтрДлина(Протокол) + 1);
			ПозицияПути  = СтрНайти(БезПротокола, "/");

			Если ПозицияПути = 0 Тогда
				Результат.Хост = БезПротокола;
				Результат.Путь = "/";
			Иначе
				Результат.Хост = Лев(БезПротокола, ПозицияПути - 1);
				Результат.Путь = Сред(БезПротокола, ПозицияПути);
			КонецЕсли;

			Возврат Результат;

		КонецЕсли;

	КонецЦикла;

	Если Лев(Результат.Путь, 1) <> "/" Тогда
		Результат.Путь = "/" + Результат.Путь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Разбирает XML УПД и достаёт строки товаров.
//
// Путь к строкам в формате ФНС - Файл/Документ/ТаблДок/СтрТабл, в версии 3.03
// это Файл/Документ/СписокСтрТабл/СтрТабл. Проверяем оба.
//
// Возвращаемое значение:
//   Структура - Товары (Массив), КлючиСтроки (Строка), КлючиКорня (Строка)
//
Функция РазобратьТоварыИзФайлаУПД(ПутьКФайлу) Экспорт

	Результат = Новый Структура(
		"Товары, КлючиСтроки, КлючиКорня, НомерТранснакладной, Ошибка,"
		+ " НомерВФайле, ДатаВФайле, АдресВФайле, ЭтоКорректировка, НомерОснования, ДатаОснования",
		Новый Массив, "", "", "", "", "", "", "", Ложь, "", "");

	ТекстОшибкиXML = "";
	Корень = ПрочитатьXMLФайлВСоответствие(ПутьКФайлу, ТекстОшибкиXML);

	Если Корень = Неопределено Тогда
		// Чаще всего это не XML вовсе: страница переадресации или ответ
		// об ошибке. Начало файла показывает, что пришло на самом деле.
		НачалоФайла = ПервыеСимволыФайла(ПутьКФайлу, 80);
		Результат.Ошибка = СтрШаблон(
			НСтр("ru = 'файл не читается как XML - это не титул УПД или файл повреждён (%1)%2'"),
			?(ЗначениеЗаполнено(ТекстОшибкиXML), ТекстОшибкиXML, НСтр("ru = 'файл пустой'")),
			?(ЗначениеЗаполнено(НачалоФайла), СтрШаблон(НСтр("ru = '; начало файла: «%1»'"), НачалоФайла), ""));
		Возврат Результат;
	КонецЕсли;

	// УПД сам ссылается на транспортную накладную - это самая точная связь.
	// Путь к ней между версиями формата разный, поэтому ищем по имени ключа.
	Результат.НомерТранснакладной = НайтиЗначениеПоИмениКлюча(
		Корень, "НомТранНакл,НомерТранНакл,НомТранНаклад,ТранНакл");

	// Номер, дата и адрес из самого файла: по ним документ сверяется с ЭТрН,
	// когда связи в API нет
	Результат.НомерВФайле = НайтиЗначениеПоИмениКлюча(Корень, "НомерСчФ,НомерДок,НомДок");
	Результат.ДатаВФайле  = НайтиЗначениеПоИмениКлюча(Корень, "ДатаСчФ,ДатаДок");
	Результат.АдресВФайле = НайтиЗначениеПоИмениКлюча(Корень, "АдрТекст,АдресТекст,Адрес");

	// В диагностику кладём и корень, и узел Документ: если формат окажется
	// другим, по этим двум спискам сразу видно, где искать строки.
	Результат.КлючиКорня = СтрШаблон("корень [%1], Документ [%2]",
		КлючиУзла(Корень), КлючиУзла(ЗначениеУзла(Корень, "Документ")));

	// Корректировочный документ (УКД): таблица ТаблКСчФ, у строк значения До и
	// После. Разбираем отдельно - общий поиск СведТов нашёл бы её строки, но
	// КолТов в них нет, и количества выходили нулевыми
	СтрокиКорректировки = ЗначениеПоПути(Корень, "Документ.ТаблКСчФ.СведТов");
	Если СтрокиКорректировки = Неопределено Тогда
		ТаблицаКорректировки = НайтиУзелПоИмени(Корень, "ТаблКСчФ");
		Если ТаблицаКорректировки <> Неопределено Тогда
			СтрокиКорректировки = ЗначениеУзла(ТаблицаКорректировки, "СведТов");
		КонецЕсли;
	КонецЕсли;

	Если СтрокиКорректировки <> Неопределено Тогда
		ЗаполнитьРезультатКорректировки(Результат, Корень, СтрокиКорректировки);
		Возврат Результат;
	КонецЕсли;

	// Путь к строкам зависит от формата:
	//   УПД / СЧФДОП        - Документ/ТаблСчФакт/СведТов
	//   ЭДОНакл (ТОРГ-12)   - Документ/ТаблДок/СтрТабл
	//   версия 3.03         - Документ/СписокСтрТабл/СтрТабл
	ПутиКСтрокам = "Документ.ТаблСчФакт.СведТов,"
		+ "Документ.ТаблДок.СтрТабл,"
		+ "Документ.СписокСтрТабл.СтрТабл,"
		+ "ТаблСчФакт.СведТов,"
		+ "ТаблДок.СтрТабл";

	СтрокиТаблицы = Неопределено;

	Для Каждого ПутьКСтрокам Из СтрРазделить(ПутиКСтрокам, ",", Ложь) Цикл

		СтрокиТаблицы = ЗначениеПоПути(Корень, СокрЛП(ПутьКСтрокам));
		Если СтрокиТаблицы <> Неопределено Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	// Путь не сошёлся - ищем таблицу по имени узла на любой глубине.
	// Имена строк в форматах ФНС устойчивее, чем путь до них.
	Если СтрокиТаблицы = Неопределено Тогда
		СтрокиТаблицы = НайтиУзелПоИмени(Корень, "СведТов,СтрТабл");
	КонецЕсли;

	Если СтрокиТаблицы = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	НомерСтроки = 1;
	Для Каждого ДанныеСтроки Из ЗначениеВМассив(СтрокиТаблицы) Цикл

		Если НЕ ЗначениеЗаполнено(Результат.КлючиСтроки) Тогда
			Результат.КлючиСтроки = КлючиУзла(ДанныеСтроки);
		КонецЕсли;

		РазобраннаяСтрока = СтрокаТовараУПД(ДанныеСтроки, НомерСтроки);

		// Итоговые строки формата (ВсегоОпл и подобные) товаром не считаем
		Если НЕ ЗначениеЗаполнено(РазобраннаяСтрока.Наименование)
			И РазобраннаяСтрока.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;

		Результат.Товары.Добавить(РазобраннаяСтрока);
		НомерСтроки = НомерСтроки + 1;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заполняет результат разбора по корректировочному документу.
//
// Номер и дата - самой УКД (СвКСчФ: НомерКСчФ, ДатаКСчФ), основание - номер и
// дата исправляемого счёта-фактуры (СвКСчФ/СчФ: НомерСчФ, ДатаСчФ). Если УКД
// исправляет несколько документов, берётся первый.
//
Процедура ЗаполнитьРезультатКорректировки(Результат, Корень, СтрокиКорректировки)

	Результат.ЭтоКорректировка = Истина;

	СведенияКорректировки = НайтиУзелПоИмени(Корень, "СвКСчФ");
	Результат.НомерВФайле = СтрокойИлиПусто(ЗначениеПоКлючам(СведенияКорректировки, "НомерКСчФ,НомерДок"));
	Результат.ДатаВФайле  = СтрокойИлиПусто(ЗначениеПоКлючам(СведенияКорректировки, "ДатаКСчФ,ДатаДок"));

	Основания = ЗначениеВМассив(ЗначениеУзла(СведенияКорректировки, "СчФ"));
	Если Основания.Количество() > 0 Тогда
		// НомерСчФ/ДатаСчФ - формат 5.01; остальные имена - на случай файлов новее
		Результат.НомерОснования = СтрокойИлиПусто(ЗначениеПоКлючам(Основания[0], "НомерСчФ,НомерДок,РеквНомерДок"));
		Результат.ДатаОснования  = СтрокойИлиПусто(ЗначениеПоКлючам(Основания[0], "ДатаСчФ,ДатаДок,РеквДатаДок"));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Результат.НомерОснования) Тогда
		Результат.НомерОснования = НайтиЗначениеПоИмениКлюча(Корень, "НомерСчФ");
		Результат.ДатаОснования  = НайтиЗначениеПоИмениКлюча(Корень, "ДатаСчФ");
	КонецЕсли;

	НомерСтроки = 1;
	Для Каждого ДанныеСтроки Из ЗначениеВМассив(СтрокиКорректировки) Цикл

		Если НЕ ЗначениеЗаполнено(Результат.КлючиСтроки) Тогда
			Результат.КлючиСтроки = КлючиУзла(ДанныеСтроки);
		КонецЕсли;

		РазобраннаяСтрока = СтрокаТовараУКД(ДанныеСтроки, НомерСтроки);

		Если НЕ ЗначениеЗаполнено(РазобраннаяСтрока.Наименование)
			И РазобраннаяСтрока.Количество = 0 И РазобраннаяСтрока.КоличествоДо = 0 Тогда
			Продолжить;
		КонецЕсли;

		Результат.Товары.Добавить(РазобраннаяСтрока);
		НомерСтроки = НомерСтроки + 1;

	КонецЦикла;

КонецПроцедуры

// Разбирает строку таблицы корректировочного документа (ТаблКСчФ/СведТов).
//
// Значения До и После лежат в атрибутах КолТовДо / КолТовПосле, ЦенаТовДо /
// ЦенаТовПосле, стоимости - во вложенных узлах СтТовБезНДС и СтТовУчНал с
// атрибутами СтоимДоИзм / СтоимПослеИзм. Для регистра товаров строка отдаёт
// значения После под теми же именами, что и строка УПД, а До - отдельными
// полями. НомСтр - номер строки исправляемого документа. Имена по форматам
// ФНС 5.01-5.03; сверить на реальном файле СБИС.
//
Функция СтрокаТовараУКД(ДанныеСтроки, НомерСтроки)

	// НомСтр - номер строки внутри самой корректировки, а строку исправляемой
	// УПД называет ПорНомТовВСЧФ (формат 5.01 редакции 2020). В старых файлах
	// его нет - там номера совпадают
	СтрокаТЧ = Новый Структура;
	СтрокаТЧ.Вставить("НомерСтроки", ЧислоИзСтрокиСБИС(
		ЗначениеПоКлючам(ДанныеСтроки, "ПорНомТовВСЧФ,НомСтр")));
	Если СтрокаТЧ.НомерСтроки = 0 Тогда
		СтрокаТЧ.НомерСтроки = НомерСтроки;
	КонецЕсли;

	СтрокаТЧ.Вставить("Наименование", СтрокойИлиПусто(
		ЗначениеПоКлючам(ДанныеСтроки, "НаимТов,НаимТовара,Наименование")));

	СтрокаТЧ.Вставить("КоличествоДо", ЗначениеДоПосле(ДанныеСтроки, "КолТов", "До"));
	СтрокаТЧ.Вставить("Количество",   ЗначениеДоПосле(ДанныеСтроки, "КолТов", "После"));
	СтрокаТЧ.Вставить("ЦенаДо",       ЗначениеДоПосле(ДанныеСтроки, "ЦенаТов", "До"));
	СтрокаТЧ.Вставить("Цена",         ЗначениеДоПосле(ДанныеСтроки, "ЦенаТов", "После"));

	СтрокаТЧ.Вставить("СуммаБезНДСДо", СтоимостьДоПосле(ДанныеСтроки, "СтТовБезНДС", "До"));
	СтрокаТЧ.Вставить("СуммаБезНДС",   СтоимостьДоПосле(ДанныеСтроки, "СтТовБезНДС", "После"));
	СтрокаТЧ.Вставить("СуммаСНДСДо",   СтоимостьДоПосле(ДанныеСтроки, "СтТовУчНал", "До"));
	СтрокаТЧ.Вставить("СуммаСНДС",     СтоимостьДоПосле(ДанныеСтроки, "СтТовУчНал", "После"));

	// Корректировка только цены: КолТовДо/КолТовПосле по схеме необязательны, и
	// количества в строке может не быть. Ноль «после» здесь не значит «товар
	// убран» - количество прежнее, а если нет и «до», его даёт стоимость на цену
	Если НЕ ЕстьЗначениеДоПосле(ДанныеСтроки, "КолТов", "После") Тогда
		Если ЕстьЗначениеДоПосле(ДанныеСтроки, "КолТов", "До") Тогда
			СтрокаТЧ.Количество = СтрокаТЧ.КоличествоДо;
		ИначеЕсли СтрокаТЧ.Цена <> 0 И СтрокаТЧ.СуммаБезНДС <> 0 Тогда
			СтрокаТЧ.Количество = СтрокаТЧ.СуммаБезНДС / СтрокаТЧ.Цена;
		КонецЕсли;
		Если СтрокаТЧ.КоличествоДо = 0 Тогда
			СтрокаТЧ.КоличествоДо = СтрокаТЧ.Количество;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЕстьЗначениеДоПосле(ДанныеСтроки, "ЦенаТов", "После")
		И СтрокаТЧ.Количество <> 0 И СтрокаТЧ.СуммаБезНДС <> 0 Тогда
		СтрокаТЧ.Цена = СтрокаТЧ.СуммаБезНДС / СтрокаТЧ.Количество;
	КонецЕсли;

	// Признак изменения строки против исходной УПД - машинный ответ на вопрос
	// «это возврат (уменьшение) или доплата?». Считается по парам До/После
	// самого файла корректировки; текст для глаз строит ТекстИзменения.
	СтрокаТЧ.Вставить("ПризнакИзменения", ПризнакИзмененияУКД(СтрокаТЧ));

	СтрокаТЧ.Вставить("СтавкаНДС", СтрокойИлиПусто(
		ЗначениеПоКлючам(ДанныеСтроки, "НалСтПосле,НалСтДо,НалСт")));

	СуммаНалога = ЗначениеПоПути(ДанныеСтроки, "СумНалПосле.СумНал");
	Если СуммаНалога = Неопределено Тогда
		СуммаНалога = ЗначениеПоКлючам(ДанныеСтроки, "СумНалПосле");
	КонецЕсли;
	СтрокаТЧ.Вставить("СуммаНДС", ЧислоИзСтрокиСБИС(СуммаНалога));

	СтрокаТЧ.Вставить("ЕдиницаИзмерения", СтрокойИлиПусто(
		ЗначениеПоКлючам(ДанныеСтроки, "НаимЕдИзмПосле,ОКЕИ_ТовПосле,НаимЕдИзм,ОКЕИ_Тов")));

	Артикул = ЗначениеПоПути(ДанныеСтроки, "ДопСведТов.Артикул");
	Если НЕ ЗначениеЗаполнено(Артикул) Тогда
		Артикул = ЗначениеПоПути(ДанныеСтроки, "ДопСведТов.АртикулТов");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Артикул) Тогда
		Артикул = АртикулИзИнфПолФХЖ2(ДанныеСтроки);
	КонецЕсли;
	СтрокаТЧ.Вставить("Артикул", СтрокойИлиПусто(Артикул));

	КодТовара = ЗначениеПоПути(ДанныеСтроки, "ДопСведТов.КодТов");
	Если НЕ ЗначениеЗаполнено(КодТовара) Тогда
		КодТовара = ЗначениеПоКлючам(ДанныеСтроки, "КодТов,КодТовара");
	КонецЕсли;
	СтрокаТЧ.Вставить("КодТовара", СтрокойИлиПусто(КодТовара));

	GTIN = ЗначениеПоПути(ДанныеСтроки, "ДопСведТов.ГТИН");
	СтрокаТЧ.Вставить("Штрихкод", СтрокойИлиПусто(GTIN));

	// ТН ВЭД - ДопСведТов/КодВидТов: по нему узнаётся алкоголь (ЭАрМ_АлкогольЕГАИС)
	КодТНВЭД = ЗначениеПоПути(ДанныеСтроки, "ДопСведТов.КодВидТов");
	Если НЕ ЗначениеЗаполнено(КодТНВЭД) Тогда
		КодТНВЭД = ЗначениеПоКлючам(ДанныеСтроки, "КодВидТов");
	КонецЕсли;
	СтрокаТЧ.Вставить("КодТНВЭД", СтрокойИлиПусто(КодТНВЭД));

	// ГТД и страна происхождения: СвТД (формат 5.01) или СвДТ (5.03). Сведений
	// бывает несколько - берём первые. Страна - код ОКСМ (КодПроисх), иначе
	// краткое наименование из ДопСведТов/КрНаимСтрПр
	СведенияДТ = ЗначениеВМассив(ЗначениеПоКлючам(ДанныеСтроки, "СвДТ,СвТД"));
	ПервыеСведенияДТ = ?(СведенияДТ.Количество() > 0, СведенияДТ[0], Неопределено);
	СтрокаТЧ.Вставить("НомерГТД", СтрокойИлиПусто(
		ЗначениеПоКлючам(ПервыеСведенияДТ, "НомерДТ,НомерТД")));
	СтранаПроисхождения = ЗначениеПоКлючам(ПервыеСведенияДТ, "КодПроисх");
	Если НЕ ЗначениеЗаполнено(СтранаПроисхождения) Тогда
		СтранаПроисхождения = ЗначениеПоПути(ДанныеСтроки, "ДопСведТов.КрНаимСтрПр");
	КонецЕсли;
	СтрокаТЧ.Вставить("СтранаПроисхождения", СтрокойИлиПусто(СтранаПроисхождения));

	// Прослеживаемость (СведПрослеж): РНПТ - товар прослеживаемый
	СведенияПрослеж = ЗначениеВМассив(ЗначениеПоКлючам(ДанныеСтроки, "СведПрослеж"));
	СтрокаТЧ.Вставить("РНПТ", СтрокойИлиПусто(ЗначениеПоКлючам(
		?(СведенияПрослеж.Количество() > 0, СведенияПрослеж[0], Неопределено), "НомТовПрослеж")));

	// Акциз: сумма (Акциз/СумАкциз) или «без акциза» (БезАкциз)
	СуммаАкциза = ЗначениеПоПути(ДанныеСтроки, "Акциз.СумАкциз");
	СтрокаТЧ.Вставить("СуммаАкциза", ЧислоИзСтрокиСБИС(?(СуммаАкциза = Неопределено, 0, СуммаАкциза)));

	// Коды маркировки строки: Честный знак, упаковки, SSCC, марки ЕГАИС
	СтрокаТЧ.Вставить("Маркировки", КодыМаркировкиСтрокиУПД(ДанныеСтроки));

	СтрокаТЧ.Вставить("СырыеДанные", ДанныеСтроки);

	Возврат СтрокаТЧ;

КонецФункции

// Признак изменения строки УКД по парам До/После:
//   "Убрана"       - количество обнулено, товар убран из накладной (возврат);
//   "Уменьшение"   - сумма с НДС (или количество) уменьшилась - частичный
//                    возврат товара;
//   "Увеличение"   - сумма с НДС (или количество) выросла - доплата;
//   "БезИзменений" - значения совпадают.
// Корректировка только цены попадает в "Уменьшение"/"Увеличение" по стоимости:
// различать её отдельно - дело текста в ЭАрМ_КорректировкиУПД.ТекстИзменения.
//
// Параметры:
//   СтрокаТЧ - Структура - см. СтрокаТовараУКД
//
// Возвращаемое значение:
//   Строка
//
Функция ПризнакИзмененияУКД(СтрокаТЧ) Экспорт

	Если СтрокаТЧ.Количество = 0 И СтрокаТЧ.КоличествоДо <> 0 Тогда
		Возврат "Убрана";
	КонецЕсли;

	// Знак - по сумме с НДС; если её не было или она не изменилась - по количеству
	Если СтрокаТЧ.СуммаСНДСДо <> 0 Тогда
		Если СтрокаТЧ.СуммаСНДС < СтрокаТЧ.СуммаСНДСДо Тогда
			Возврат "Уменьшение";
		ИначеЕсли СтрокаТЧ.СуммаСНДС > СтрокаТЧ.СуммаСНДСДо Тогда
			Возврат "Увеличение";
		КонецЕсли;
	КонецЕсли;

	Если СтрокаТЧ.Количество < СтрокаТЧ.КоличествоДо Тогда
		Возврат "Уменьшение";
	ИначеЕсли СтрокаТЧ.Количество > СтрокаТЧ.КоличествоДо Тогда
		Возврат "Увеличение";
	КонецЕсли;

	Возврат "БезИзменений";

КонецФункции

// Значение До/После из атрибута ИмяДо / ИмяПосле или из вложенного узла Имя
// с ключами До / После.
//
Функция ЗначениеДоПосле(ДанныеСтроки, Имя, Суффикс)

	Значение = ЗначениеПоКлючам(ДанныеСтроки, Имя + Суффикс);

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Значение = ЗначениеПоКлючам(ЗначениеУзла(ДанныеСтроки, Имя), Суффикс);
	КонецЕсли;

	Возврат ЧислоИзСтрокиСБИС(Значение);

КонецФункции

// Есть ли в строке УКД значение До/После - в отличие от ЗначениеДоПосле
// различает «не указано» и явный ноль.
//
Функция ЕстьЗначениеДоПосле(ДанныеСтроки, Имя, Суффикс)

	Значение = ЗначениеПоКлючам(ДанныеСтроки, Имя + Суффикс);

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Значение = ЗначениеПоКлючам(ЗначениеУзла(ДанныеСтроки, Имя), Суффикс);
	КонецЕсли;

	Возврат ЗначениеЗаполнено(СокрЛП(СтрокойИлиПусто(Значение)));

КонецФункции

// Стоимость До/После изменения из узла стоимости строки УКД.
//
Функция СтоимостьДоПосле(ДанныеСтроки, ИмяУзла, Суффикс)

	Узел = ЗначениеУзла(ДанныеСтроки, ИмяУзла);
	Значение = ЗначениеПоКлючам(Узел, ?(Суффикс = "До", "СтоимДоИзм", "СтоимПослеИзм"));

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Значение = ЗначениеПоКлючам(ДанныеСтроки, ИмяУзла + Суффикс);
	КонецЕсли;

	Возврат ЧислоИзСтрокиСБИС(Значение);

КонецФункции

// Коды маркировки строки УПД из ДопСведТов/НомСредИдентТов: КИЗ - коды
// идентификации (Честный знак, марки), НомУпак - коды групповых упаковок,
// атрибут ИдентТрансУпак - SSCC транспортной упаковки. Повторы не дублируются.
// Имена по форматам ФНС 5.01-5.03; сверить на реальном файле СБИС.
//
// Возвращаемое значение:
//   Массив из Строка
//
Функция КодыМаркировкиСтрокиУПД(ДанныеСтроки)

	Результат   = Новый Массив;
	Добавленные = Новый Соответствие;

	Узлы = НайтиУзелПоИмени(ДанныеСтроки, "НомСредИдентТов", 4);

	Для Каждого Узел Из ЗначениеВМассив(Узлы) Цикл

		Кандидаты = Новый Массив;

		Если ТипЗнч(Узел) = Тип("Строка") Тогда
			Кандидаты.Добавить(Узел);
		Иначе
			Для Каждого ИмяУзла Из СтрРазделить("КИЗ,НомУпак", ",") Цикл
				Для Каждого Значение Из ЗначениеВМассив(ЗначениеУзла(Узел, ИмяУзла)) Цикл
					Кандидаты.Добавить(Значение);
				КонецЦикла;
			КонецЦикла;
			Кандидаты.Добавить(ЗначениеУзла(Узел, "ИдентТрансУпак", ""));
		КонецЕсли;

		Для Каждого Кандидат Из Кандидаты Цикл
			Код = СокрЛП(СтрокойИлиПусто(Кандидат));
			Если ЗначениеЗаполнено(Код) И Добавленные.Получить(Код) = Неопределено Тогда
				Добавленные.Вставить(Код, Истина);
				Результат.Добавить(Код);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Разбирает одну строку таблицы товаров УПД.
//
// Имена полей формата ФНС перечислены списками: между версиями формата они
// отличаются, а угадывать одно имя мы уже пробовали.
//
// Возвращаемое значение:
//   Структура - реквизиты строки плюс СырыеДанные
//
Функция СтрокаТовараУПД(ДанныеСтроки, НомерСтроки)

	СтрокаТЧ = Новый Структура;
	СтрокаТЧ.Вставить("НомерСтроки", ЧислоИзСтрокиСБИС(
		ЗначениеПоКлючам(ДанныеСтроки, "НомСтр")));

	Если СтрокаТЧ.НомерСтроки = 0 Тогда
		СтрокаТЧ.НомерСтроки = НомерСтроки;
	КонецЕсли;

	СтрокаТЧ.Вставить("Наименование", СтрокойИлиПусто(
		ЗначениеПоКлючам(ДанныеСтроки, "НаимТов,НаимТовара,Наименование")));

	СтрокаТЧ.Вставить("Количество", ЧислоИзСтрокиСБИС(
		ЗначениеПоКлючам(ДанныеСтроки, "КолТов,Количество")));

	СтрокаТЧ.Вставить("Цена", ЧислоИзСтрокиСБИС(
		ЗначениеПоКлючам(ДанныеСтроки, "ЦенаТов,Цена,ЦенаТовара,ЦенаЕд")));

	СтрокаТЧ.Вставить("СуммаБезНДС", ЧислоИзСтрокиСБИС(
		ЗначениеПоКлючам(ДанныеСтроки, "СтТовБезНДС,СтТовБезНДСВсего,СуммаБезНДС")));

	СтрокаТЧ.Вставить("СуммаСНДС", ЧислоИзСтрокиСБИС(
		ЗначениеПоКлючам(ДанныеСтроки, "СтТовУчНал,СуммаСНДС")));

	СтрокаТЧ.Вставить("СтавкаНДС", СтрокойИлиПусто(
		ЗначениеПоКлючам(ДанныеСтроки, "НалСт,СтавкаНДС")));

	// Сумма налога бывает вложенным узлом СумНал/СумНал
	СуммаНалога = ЗначениеПоПути(ДанныеСтроки, "СумНал.СумНал");
	Если СуммаНалога = Неопределено Тогда
		СуммаНалога = ЗначениеПоКлючам(ДанныеСтроки, "СумНал,СуммаНДС");
	КонецЕсли;
	СтрокаТЧ.Вставить("СуммаНДС", ЧислоИзСтрокиСБИС(СуммаНалога));

	// Строка возврата: в возвратных документах количество или суммы приходят
	// со знаком минус, знак проходит через ЧислоИзСтрокиСБИС как есть
	СтрокаТЧ.Вставить("ОтрицательнаяСтрока", СтрокаТЧ.Количество < 0
		ИЛИ СтрокаТЧ.СуммаБезНДС < 0 ИЛИ СтрокаТЧ.СуммаСНДС < 0);

	СтрокаТЧ.Вставить("ЕдиницаИзмерения", СтрокойИлиПусто(
		ЗначениеПоКлючам(ДанныеСтроки, "НаимЕдИзм,ОКЕИ_Тов,ЕдиницаИзмерения")));

	// Артикул лежит в дополнительных сведениях о товаре
	Артикул = ЗначениеПоПути(ДанныеСтроки, "ДопСведТов.Артикул");
	Если Артикул = Неопределено Тогда
		Артикул = ЗначениеПоКлючам(ДанныеСтроки, "Артикул");
	КонецЕсли;
	// Формат 5.03: ДопСведТов/АртикулТов
	Если НЕ ЗначениеЗаполнено(Артикул) Тогда
		Артикул = ЗначениеПоПути(ДанныеСтроки, "ДопСведТов.АртикулТов");
	КонецЕсли;
	// Многие поставщики пишут артикул только в ИнфПолФХЖ2 (Идентиф="Артикул")
	Если НЕ ЗначениеЗаполнено(Артикул) Тогда
		Артикул = АртикулИзИнфПолФХЖ2(ДанныеСтроки);
	КонецЕсли;
	СтрокаТЧ.Вставить("Артикул", СтрокойИлиПусто(Артикул));

	// Код товара у поставщика и GTIN - ключи для штрихкодов поставщиков.
	// Имена узлов по форматам ФНС 5.01-5.03; сверить на реальном файле СБИС.
	КодТовара = ЗначениеПоПути(ДанныеСтроки, "ДопСведТов.КодТов");
	Если НЕ ЗначениеЗаполнено(КодТовара) Тогда
		КодТовара = ЗначениеПоКлючам(ДанныеСтроки, "КодТов,КодТовара");
	КонецЕсли;
	СтрокаТЧ.Вставить("КодТовара", СтрокойИлиПусто(КодТовара));

	GTIN = ЗначениеПоПути(ДанныеСтроки, "ДопСведТов.ГТИН");
	Если НЕ ЗначениеЗаполнено(GTIN) Тогда
		GTIN = ЗначениеПоКлючам(ДанныеСтроки, "ГТИН,GTIN,Штрихкод");
	КонецЕсли;
	СтрокаТЧ.Вставить("Штрихкод", СтрокойИлиПусто(GTIN));

	// ТН ВЭД - ДопСведТов/КодВидТов: по нему узнаётся алкоголь (ЭАрМ_АлкогольЕГАИС)
	КодТНВЭД = ЗначениеПоПути(ДанныеСтроки, "ДопСведТов.КодВидТов");
	Если НЕ ЗначениеЗаполнено(КодТНВЭД) Тогда
		КодТНВЭД = ЗначениеПоКлючам(ДанныеСтроки, "КодВидТов");
	КонецЕсли;
	СтрокаТЧ.Вставить("КодТНВЭД", СтрокойИлиПусто(КодТНВЭД));

	// ГТД и страна происхождения: СвТД (формат 5.01) или СвДТ (5.03). Сведений
	// бывает несколько - берём первые. Страна - код ОКСМ (КодПроисх), иначе
	// краткое наименование из ДопСведТов/КрНаимСтрПр
	СведенияДТ = ЗначениеВМассив(ЗначениеПоКлючам(ДанныеСтроки, "СвДТ,СвТД"));
	ПервыеСведенияДТ = ?(СведенияДТ.Количество() > 0, СведенияДТ[0], Неопределено);
	СтрокаТЧ.Вставить("НомерГТД", СтрокойИлиПусто(
		ЗначениеПоКлючам(ПервыеСведенияДТ, "НомерДТ,НомерТД")));
	СтранаПроисхождения = ЗначениеПоКлючам(ПервыеСведенияДТ, "КодПроисх");
	Если НЕ ЗначениеЗаполнено(СтранаПроисхождения) Тогда
		СтранаПроисхождения = ЗначениеПоПути(ДанныеСтроки, "ДопСведТов.КрНаимСтрПр");
	КонецЕсли;
	СтрокаТЧ.Вставить("СтранаПроисхождения", СтрокойИлиПусто(СтранаПроисхождения));

	// Прослеживаемость (СведПрослеж): РНПТ - товар прослеживаемый
	СведенияПрослеж = ЗначениеВМассив(ЗначениеПоКлючам(ДанныеСтроки, "СведПрослеж"));
	СтрокаТЧ.Вставить("РНПТ", СтрокойИлиПусто(ЗначениеПоКлючам(
		?(СведенияПрослеж.Количество() > 0, СведенияПрослеж[0], Неопределено), "НомТовПрослеж")));

	// Акциз: сумма (Акциз/СумАкциз) или «без акциза» (БезАкциз)
	СуммаАкциза = ЗначениеПоПути(ДанныеСтроки, "Акциз.СумАкциз");
	СтрокаТЧ.Вставить("СуммаАкциза", ЧислоИзСтрокиСБИС(?(СуммаАкциза = Неопределено, 0, СуммаАкциза)));

	// Коды маркировки строки: Честный знак, упаковки, SSCC, марки ЕГАИС
	СтрокаТЧ.Вставить("Маркировки", КодыМаркировкиСтрокиУПД(ДанныеСтроки));

	СтрокаТЧ.Вставить("СырыеДанные", ДанныеСтроки);

	Возврат СтрокаТЧ;

КонецФункции

// Возвращает документ из элемента реестра.
// В реестре по событиям элемент - это событие, а сам документ вложен в узел
// "Документ". В обычном списке документ приходит элементом напрямую.
//
Функция ДокументИзЭлементаРеестра(ЭлементРеестра) Экспорт

	ВложенныйДокумент = ЗначениеУзла(ЭлементРеестра, "Документ");

	Если ВложенныйДокумент <> Неопределено Тогда
		Возврат ВложенныйДокумент;
	КонецЕсли;

	Возврат ЭлементРеестра;

КонецФункции

// Ищет значение по имени ключа во всём дереве узла, на любой глубине.
//
// Нужно там, где точный путь неизвестен: разметка ФНС отличается между
// версиями формата, и перебирать пути по одному оказалось тупиковым.
// Поиск в глубину, первое непустое совпадение выигрывает.
//
// Параметры:
//   Узел        - Соответствие, Массив, Строка - дерево разобранного XML
//   ИменаКлючей - Строка - имена через запятую
//   Глубина     - Число - служебный ограничитель рекурсии
//
// Возвращаемое значение:
//   Строка - найденное значение, иначе пустая строка
//
Функция НайтиЗначениеПоИмениКлюча(Узел, ИменаКлючей, Глубина = 0) Экспорт

	Если Глубина > 20 Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Узел) = Тип("Массив") Тогда

		Для Каждого ЭлементУзла Из Узел Цикл
			НайденноеЗначение = НайтиЗначениеПоИмениКлюча(ЭлементУзла, ИменаКлючей, Глубина + 1);
			Если ЗначениеЗаполнено(НайденноеЗначение) Тогда
				Возврат НайденноеЗначение;
			КонецЕсли;
		КонецЦикла;

		Возврат "";

	КонецЕсли;

	Если ТипЗнч(Узел) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	// Сначала прямые ключи текущего уровня
	Для Каждого ИмяКлюча Из СтрРазделить(ИменаКлючей, ",", Ложь) Цикл

		ЗначениеКлюча = Узел.Получить(СокрЛП(ИмяКлюча));
		Если ТипЗнч(ЗначениеКлюча) = Тип("Строка") И ЗначениеЗаполнено(ЗначениеКлюча) Тогда
			Возврат ЗначениеКлюча;
		КонецЕсли;

	КонецЦикла;

	// Затем вглубь
	Для Каждого ЭлементУзла Из Узел Цикл

		НайденноеЗначение = НайтиЗначениеПоИмениКлюча(
			ЭлементУзла.Значение, ИменаКлючей, Глубина + 1);

		Если ЗначениеЗаполнено(НайденноеЗначение) Тогда
			Возврат НайденноеЗначение;
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

// Возвращает формат документа по имени вложения.
//
// Имена файлов ФНС однозначно кодируют формат, и это единственный надёжный
// признак: поле "Название" в реестре заполняется поставщиком произвольно.
//
// Возвращаемое значение:
//   Строка - УПД, ТОРГ-12, Накладная ЭДО, Счёт-фактура, ЭТрН, ЭПЛ,
//            либо пустая строка, если распознать не удалось
//
Функция ФорматДокументаПоВложениям(ДокументРеестра) Экспорт

	УзелВложений = ЗначениеУзла(ДокументРеестра, "Вложение");
	Если УзелВложений = Неопределено Тогда
		УзелВложений = ЗначениеУзла(ДокументРеестра, "Вложения");
	КонецЕсли;

	Для Каждого ДанныеВложения Из ЗначениеВМассив(УзелВложений) Цикл

		ИмяФайла = ВРег(СтрокойИлиПусто(ЗначениеПоПути(ДанныеВложения, "Файл.Имя", "")));
		Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
			Продолжить;
		КонецЕсли;

		Если СтрНайти(ИмяФайла, "TRNACL") > 0 Тогда
			Возврат "ЭТрН";
		ИначеЕсли СтрНайти(ИмяФайла, "WAYBILL") > 0 Тогда
			Возврат "ЭПЛ";
		ИначеЕсли СтрНайти(ИмяФайла, "KORSCHF") > 0 Тогда
			// ON_NKORSCHFDOPPR, ON_KORSCHFDOPPR - корректировочный документ; проверяем
			// раньше SCHFDOP, который входит в его имя
			Возврат "УКД";
		ИначеЕсли СтрНайти(ИмяФайла, "SCHFDOP") > 0 Тогда
			Возврат "УПД";
		ИначеЕсли СтрНайти(ИмяФайла, "TORG12") > 0 Тогда
			Возврат "ТОРГ-12";
		ИначеЕсли СтрНайти(ИмяФайла, "EDONAKL") > 0 Тогда
			Возврат "Накладная ЭДО";
		ИначеЕсли СтрНайти(ИмяФайла, "SCHF") > 0 Тогда
			Возврат "Счёт-фактура";
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

// Набор ДопПоля для чтения документа вместе со связями.
//
// К обычному набору добавлены "ПервичныйКлюч,ЦепочкаДокументов" - ровно те,
// что штатная обработка СБИС доклеивает к любому чтению документа. В остальных
// чтениях они не нужны, поэтому в значение по умолчанию не вынесены.
//
// Возвращаемое значение:
//   Строка
//
Функция ДопПоляСоСвязями() Экспорт

	Возврат "ДопДействия,ТекущиеЭтапы,Подстановки,Расширение,Стороны,"
		+ "ИдентификаторУчастника,ПервичныйКлюч,ЦепочкаДокументов";

КонецФункции

// Написания метода связанных документов, от самого вероятного к общему.
//
// Возвращаемое значение:
//   Массив строк
//
Функция ИменаМетодовСвязей() Экспорт

	Результат = Новый Массив;

	Результат.Добавить("СБИС.СвязанныхДокументовСНаименованиями");
	Результат.Добавить("СБИС.СписокСвязанныхДокументовСНаименованиями");
	Результат.Добавить("СБИС.СписокСвязанныхДокументов");
	Результат.Добавить("СБИС.СвязанныеДокументы");
	Результат.Добавить("СБИС.ПолучитьСвязанныеДокументы");
	Результат.Добавить("Документ.СвязанныхДокументовСНаименованиями");
	Результат.Добавить("Документ.СписокСвязанныхДокументов");

	Возврат Результат;

КонецФункции

// Параметры запроса связей в том виде, в каком их описывают для СБИС.
//
// Пустые ключи не отправляем: незнакомый ключ сервис отвергает вместе со всем
// запросом, и тогда непонятно, метод не тот или параметр.
//
// Возвращаемое значение:
//   Структура
//
Функция ПараметрыЗапросаСвязей(Идентификатор, НаправлениеСвязи, ВидСвязи) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Документ", Новый Структура("Идентификатор", Строка(Идентификатор)));

	Если ЗначениеЗаполнено(НаправлениеСвязи) Тогда
		Результат.Вставить("НаправлениеСвязи", НаправлениеСвязи);
	КонецЕсли;

	Если ЗначениеЗаполнено(ВидСвязи) Тогда
		Результат.Вставить("ВидСвязи", ВидСвязи);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Отличает "такого метода нет" от прочих ошибок сервиса.
//
// JSON-RPC отдаёт на неизвестный метод код -32601, но СБИС пишет об этом ещё
// и словами, причём по-разному - поэтому смотрим на текст целиком.
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоОшибкаНеизвестногоМетода(ТекстОшибки) Экспорт

	ТекстПроверки = ВРег(СтрокойИлиПусто(ТекстОшибки));

	Если НЕ ЗначениеЗаполнено(ТекстПроверки) Тогда
		Возврат Ложь;
	КонецЕсли;

	Признаки = "МЕТОД НЕ НАЙДЕН|МЕТОДА НЕ СУЩЕСТВУЕТ|НЕИЗВЕСТНЫЙ МЕТОД|"
		+ "METHOD NOT FOUND|UNKNOWN METHOD|-32601|НЕ НАЙДЕН МЕТОД|"
		+ "НЕ ПОДДЕРЖИВАЕТСЯ";

	Для Каждого Признак Из СтрРазделить(Признаки, "|", Ложь) Цикл
		Если СтрНайти(ТекстПроверки, Признак) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Ключи, по которым два документа СБИС можно считать связанными.
//
// Цепочка документов у многих документов приходит пустой, а сопоставлять по
// номерам и датам ненадёжно. Зато у документа есть идентификаторы, общие для
// связанных: пакет, первичный ключ, код перевозки, идентификатор в госсистеме
// и ссылки на другие документы. Совпадение любого из них - это уже связь,
// а не догадка.
//
// Параметры:
//   ДокументСБИС - Соответствие - документ реестра либо прочитанный документ
//
// Возвращаемое значение:
//   Строка - пары "имя=значение" через ";"; пустая, если ключей нет
//
Функция КлючиСвязиДокумента(ДокументСБИС) Экспорт

	ЧастиКлючей = Новый Массив;

	ИменаКлючей = "ИдентификаторПакета,ПервичныйКлюч,КодПеревозки,ГИС_УИД";

	Для Каждого ИмяКлюча Из СтрРазделить(ИменаКлючей, ",", Ложь) Цикл

		ЗначениеКлюча = СтрокойИлиПусто(ЗначениеУзла(ДокументСБИС, СокрЛП(ИмяКлюча), ""));

		Если ЗначениеЗаполнено(ЗначениеКлюча) Тогда
			ЧастиКлючей.Добавить(СокрЛП(ИмяКлюча) + "=" + ЗначениеКлюча);
		КонецЕсли;

	КонецЦикла;

	// Ссылки кладём под одним именем: ссылка одного документа должна сойтись
	// с идентификатором другого
	Для Каждого ИмяУзла Из СтрРазделить("LinkedOutflows,LinkedInflows", ",", Ложь) Цикл

		УзелСсылок = ЗначениеУзла(ДокументСБИС, СокрЛП(ИмяУзла));

		Для Каждого ЗначениеСсылки Из ЗначениеВМассив(УзелСсылок) Цикл
			Если ЗначениеЗаполнено(СтрокойИлиПусто(ЗначениеСсылки)) Тогда
				ЧастиКлючей.Добавить("Ссылка=" + СтрокойИлиПусто(ЗначениеСсылки));
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	ИдентификаторДокумента = СтрокойИлиПусто(ЗначениеУзла(ДокументСБИС, "Идентификатор", ""));
	Если ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		ЧастиКлючей.Добавить("Ссылка=" + ИдентификаторДокумента);
	КонецЕсли;

	Возврат СтрСоединить(ЧастиКлючей, ";");

КонецФункции

// Возвращает имя ключа, по которому сошлись два документа.
//
// Параметры:
//   КлючиПервого, КлючиВторого - Строка - см. КлючиСвязиДокумента
//
// Возвращаемое значение:
//   Строка - имя совпавшего ключа; пустая, если совпадений нет
//
Функция СовпадениеКлючейСвязи(КлючиПервого, КлючиВторого) Экспорт

	Если НЕ ЗначениеЗаполнено(КлючиПервого) Или НЕ ЗначениеЗаполнено(КлючиВторого) Тогда
		Возврат "";
	КонецЕсли;

	КлючиВторогоДокумента = СтрРазделить(ВРег(КлючиВторого), ";", Ложь);

	Для Каждого Ключ Из СтрРазделить(КлючиПервого, ";", Ложь) Цикл

		Если КлючиВторогоДокумента.Найти(ВРег(СокрЛП(Ключ))) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ПозицияЗнака = СтрНайти(Ключ, "=");
		Возврат ?(ПозицияЗнака > 1, Лев(Ключ, ПозицияЗнака - 1), Ключ);

	КонецЦикла;

	Возврат "";

КонецФункции

// Приводит номер к виду, пригодному для сравнения.
//
Функция НомерДляСравнения(НомерДокумента) Экспорт

	Результат = ВРег(СокрЛП(СтрокойИлиПусто(НомерДокумента)));
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, "№", "");

	Пока СтрДлина(Результат) > 1 И Лев(Результат, 1) = "0" Цикл
		Результат = Сред(Результат, 2);
	КонецЦикла;

	// В номерах с буквенным префиксом нули стоят не в начале всей строки,
	// а в цифровой части: МЗ-00134027 и МЗ-134027 — один номер.
	ЧастиНомера = СтрРазделить(Результат, "-", Истина);
	Для ИндексЧасти = 0 По ЧастиНомера.Количество() - 1 Цикл

		ЧастьНомера = ЧастиНомера[ИндексЧасти];
		ТолькоЦифры = ЗначениеЗаполнено(ЧастьНомера);
		Для ПозицияСимвола = 1 По СтрДлина(ЧастьНомера) Цикл
			Если СтрНайти("0123456789",
				Сред(ЧастьНомера, ПозицияСимвола, 1)) = 0 Тогда
				ТолькоЦифры = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ТолькоЦифры Тогда
			Пока СтрДлина(ЧастьНомера) > 1
				И Лев(ЧастьНомера, 1) = "0" Цикл
				ЧастьНомера = Сред(ЧастьНомера, 2);
			КонецЦикла;
			ЧастиНомера[ИндексЧасти] = ЧастьНомера;
		КонецЕсли;

	КонецЦикла;
	Результат = СтрСоединить(ЧастиНомера, "-");

	// 0000-000123 и 123 для человека один номер, а после снятия нулей
	// получается 0-123. Нулевые куски слева отбрасываем.
	Пока СтрДлина(Результат) > 2 И Лев(Результат, 2) = "0-" Цикл
		Результат = Сред(Результат, 3);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сравнивает номера так, как их читает человек: 0000-000123, УПД-123 и 123
// считаются одним номером.
//
Функция НомераСовпадают(Номер1, Номер2) Экспорт

	Левый = НомерДляСравнения(Номер1);
	Правый = НомерДляСравнения(Номер2);
	Если НЕ ЗначениеЗаполнено(Левый) ИЛИ НЕ ЗначениеЗаполнено(Правый) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Левый = Правый Тогда
		Возврат Истина;
	КонецЕсли;

	КореньЛевый = ЦифровойКореньНомера(Номер1);
	КореньПравый = ЦифровойКореньНомера(Номер2);

	Возврат ЗначениеЗаполнено(КореньЛевый)
		И КореньЛевый = КореньПравый;

КонецФункции

// Самая длинная цифровая часть номера без ведущих нулей. Короткие хвосты
// вроде "/1" отбрасываются, чтобы не склеить разные документы.
//
Функция ЦифровойКореньНомера(НомерДокумента) Экспорт

	Текст = ВРег(СокрЛП(СтрокойИлиПусто(НомерДокумента)));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Группы = Новый Массив;
	Текущая = "";

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Текущая = Текущая + Символ;
		ИначеЕсли ЗначениеЗаполнено(Текущая) Тогда
			Группы.Добавить(Текущая);
			Текущая = "";
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(Текущая) Тогда
		Группы.Добавить(Текущая);
	КонецЕсли;

	Лучшая = "";
	Для Каждого Группа Из Группы Цикл
		Корень = Группа;
		Пока СтрДлина(Корень) > 1 И Лев(Корень, 1) = "0" Цикл
			Корень = Сред(Корень, 2);
		КонецЦикла;
		Если СтрДлина(Корень) >= 3 И СтрДлина(Корень) >= СтрДлина(Лучшая) Тогда
			Лучшая = Корень;
		КонецЕсли;
	КонецЦикла;

	Возврат Лучшая;

КонецФункции
//
// Возвращаемое значение:
//   Структура - Идентификатор, Вид, Связь, Роль, Номер, Дата, Наименование,
//               Состояние, ЭтоЗаявкаНаПеревозку
//
Функция НоваяСвязьДокументов()

	Возврат Новый Структура(
		"Идентификатор, Вид, Связь, Роль, Номер, Дата, Наименование, Состояние,"
		+ " ЭтоЗаявкаНаПеревозку",
		"", "", "", "", "", "", "", "", Ложь);

КонецФункции

// Добавляет связь в список, отсеивая повторы и сам документ.
//
// Один и тот же документ приходит и в цепочке, и в титуле - в таблице он должен
// быть один раз. Ключ сравнения: идентификатор, а при его отсутствии - вид,
// номер и дата.
//
Процедура ДобавитьСвязьДокументов(СписокСвязей, ОписаниеСвязи, ИдентификаторДокумента)

	Если НЕ ЗначениеЗаполнено(ОписаниеСвязи.Идентификатор)
		И НЕ ЗначениеЗаполнено(ОписаниеСвязи.Номер)
		И НЕ ЗначениеЗаполнено(ОписаниеСвязи.Наименование) Тогда
		Возврат;
	КонецЕсли;

	// Сам документ в списке своих связей не нужен
	Если ЗначениеЗаполнено(ОписаниеСвязи.Идентификатор)
		И ОписаниеСвязи.Идентификатор = ИдентификаторДокумента Тогда
		Возврат;
	КонецЕсли;

	ОписаниеСвязи.ЭтоЗаявкаНаПеревозку = ЭтоЗаявкаНаПеревозку(
		ОписаниеСвязи.Вид, ОписаниеСвязи.Наименование);

	КлючНовой = КлючСвязиДокументов(ОписаниеСвязи);

	Для Каждого СуществующаяСвязь Из СписокСвязей Цикл

		Если КлючСвязиДокументов(СуществующаяСвязь) <> КлючНовой Тогда
			Продолжить;
		КонецЕсли;

		// Повтор: дополняем то, чего в первой записи не было
		Для Каждого КлючЗначение Из ОписаниеСвязи Цикл
			Если НЕ ЗначениеЗаполнено(СуществующаяСвязь[КлючЗначение.Ключ])
				И ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
				СуществующаяСвязь.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЕсли;
		КонецЦикла;

		Возврат;

	КонецЦикла;

	СписокСвязей.Добавить(ОписаниеСвязи);

КонецПроцедуры

// Ключ, по которому связи считаются одной и той же.
//
Функция КлючСвязиДокументов(ОписаниеСвязи)

	Если ЗначениеЗаполнено(ОписаниеСвязи.Идентификатор) Тогда
		Возврат "ид:" + ВРег(СокрЛП(ОписаниеСвязи.Идентификатор));
	КонецЕсли;

	Возврат "рек:" + ВРег(СокрЛП(ОписаниеСвязи.Вид) + "|"
		+ СокрЛП(ОписаниеСвязи.Номер) + "|" + СокрЛП(ОписаниеСвязи.Дата));

КонецФункции

// Собирает связи из узла цепочки документов.
//
// Разметка узла нам не обещана, поэтому идём от данных: обходим дерево и
// считаем документом любой узел, где есть идентификатор либо пара
// "номер + дата". Так разбор переживёт смену раскладки.
//
Процедура СобратьСвязиИзЦепочки(ДокументСБИС, СписокСвязей, ИдентификаторДокумента) Экспорт

	УзелЦепочки = ЗначениеПоПути(ДокументСБИС, "Расширение.ЦепочкаДокументов");

	Если УзелЦепочки = Неопределено Тогда
		УзелЦепочки = НайтиУзелПоИмени(ДокументСБИС, "ЦепочкаДокументов");
	КонецЕсли;

	Если УзелЦепочки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Цепочка приходит и коллекцией, и одной строкой-идентификатором:
	// во втором случае это ссылка на связанный документ, а не список
	Если ТипЗнч(УзелЦепочки) = Тип("Строка") Тогда

		Если ЗначениеЗаполнено(УзелЦепочки) Тогда
			ОписаниеСвязи = НоваяСвязьДокументов();
			ОписаниеСвязи.Идентификатор = УзелЦепочки;
			ОписаниеСвязи.Связь         = "ЦепочкаДокументов";
			ДобавитьСвязьДокументов(СписокСвязей, ОписаниеСвязи, ИдентификаторДокумента);
		КонецЕсли;

		Возврат;

	КонецЕсли;

	СобратьДокументыИзУзла(УзелЦепочки, СписокСвязей, ИдентификаторДокумента,
		"ЦепочкаДокументов", 0);

КонецПроцедуры

// Обходит дерево узла и добавляет всё, что похоже на документ.
//
Процедура СобратьДокументыИзУзла(Узел, СписокСвязей, ИдентификаторДокумента,
		ИмяСвязи, Глубина) Экспорт

	Если Глубина > 8 Или СписокСвязей.Количество() > 200 Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Узел) = Тип("Массив") Тогда

		Для Каждого ЭлементУзла Из Узел Цикл
			СобратьДокументыИзУзла(ЭлементУзла, СписокСвязей, ИдентификаторДокумента,
				ИмяСвязи, Глубина + 1);
		КонецЦикла;

		Возврат;

	КонецЕсли;

	Если ТипЗнч(Узел) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	ОписаниеСвязи = СвязьИзУзлаДокумента(Узел, ИмяСвязи);

	Если ОписаниеСвязи <> Неопределено Тогда
		ДобавитьСвязьДокументов(СписокСвязей, ОписаниеСвязи, ИдентификаторДокумента);
	КонецЕсли;

	// Вложенные узлы тоже смотрим: цепочка бывает деревом
	Для Каждого КлючЗначение Из Узел Цикл
		СобратьДокументыИзУзла(КлючЗначение.Значение, СписокСвязей,
			ИдентификаторДокумента, ИмяСвязи, Глубина + 1);
	КонецЦикла;

КонецПроцедуры

// Пробует прочитать узел как описание документа.
//
// Возвращаемое значение:
//   Структура, Неопределено - Неопределено, если узел на документ не похож
//
Функция СвязьИзУзлаДокумента(Узел, ИмяСвязи)

	Идентификатор = СтрокойИлиПусто(
		ЗначениеПоКлючам(Узел, "Идентификатор,ИдентификаторДокумента,ИдДокумента,ИД,ПервичныйКлюч"));

	Номер = СтрокойИлиПусто(ЗначениеПоКлючам(Узел, "Номер,НомерДокумента"));
	Дата  = СтрокойИлиПусто(ЗначениеПоКлючам(Узел, "Дата,ДатаДокумента"));

	Если НЕ ЗначениеЗаполнено(Идентификатор)
		И НЕ (ЗначениеЗаполнено(Номер) И ЗначениеЗаполнено(Дата)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОписаниеСвязи = НоваяСвязьДокументов();
	ОписаниеСвязи.Идентификатор = Идентификатор;
	ОписаниеСвязи.Номер         = Номер;
	ОписаниеСвязи.Дата          = Дата;
	ОписаниеСвязи.Связь         = ИмяСвязи;

	ОписаниеСвязи.Вид = СтрокойИлиПусто(
		ЗначениеПоКлючам(Узел, "Тип,ТипДокумента,Вид,ВидДокумента,ТипВложения"));

	ОписаниеСвязи.Наименование = СтрокойИлиПусто(
		ЗначениеПоКлючам(Узел, "Название,Наименование,НазваниеДокумента"));

	// Состояние приходит вложенным узлом с собственным названием
	ОписаниеСвязи.Состояние = СтрокойИлиПусто(
		ЗначениеПоПути(Узел, "Состояние.Название", ""));
	Если НЕ ЗначениеЗаполнено(ОписаниеСвязи.Состояние) Тогда
		ОписаниеСвязи.Состояние = СтрокойИлиПусто(ЗначениеПоКлючам(Узел, "Состояние"));
	КонецЕсли;

	Возврат ОписаниеСвязи;

КонецФункции

// Собирает связи из массивов идентификаторов, которые СБИС отдаёт вместе
// с документом (LinkedOutflows и подобные).
//
Процедура СобратьСвязиИзСсылок(ДокументСБИС, СписокСвязей, ИдентификаторДокумента) Экспорт

	ИменаУзлов = "LinkedOutflows,LinkedInflows,СвязанныеДокументы,СвязанныеПакеты,"
		+ "ИдентификаторПакета";

	Для Каждого ИмяУзла Из СтрРазделить(ИменаУзлов, ",", Ложь) Цикл

		УзелСсылок = ЗначениеУзла(ДокументСБИС, СокрЛП(ИмяУзла));

		Если УзелСсылок = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ЗначениеСсылки Из ЗначениеВМассив(УзелСсылок) Цикл

			Если ТипЗнч(ЗначениеСсылки) = Тип("Соответствие") Тогда
				СобратьДокументыИзУзла(ЗначениеСсылки, СписокСвязей,
					ИдентификаторДокумента, СокрЛП(ИмяУзла), 0);
				Продолжить;
			КонецЕсли;

			Если НЕ ЗначениеЗаполнено(СтрокойИлиПусто(ЗначениеСсылки)) Тогда
				Продолжить;
			КонецЕсли;

			// Здесь известен только идентификатор - реквизиты доберёт
			// повторное чтение, если они понадобятся
			ОписаниеСвязи = НоваяСвязьДокументов();
			ОписаниеСвязи.Идентификатор = СтрокойИлиПусто(ЗначениеСсылки);
			ОписаниеСвязи.Связь         = СокрЛП(ИмяУзла);

			ДобавитьСвязьДокументов(СписокСвязей, ОписаниеСвязи, ИдентификаторДокумента);

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Собирает связи из сопроводительных документов титулов ЭТрН.
//
Процедура СобратьСвязиИзТитулов(ДокументСБИС, СписокСвязей, ИдентификаторДокумента) Экспорт

	Для Каждого СвязанныйДокумент Из ЭАрМ_ОбщийМодульОбмен.СвязанныеДокументыЭТрН(ДокументСБИС) Цикл

		ОписаниеСвязи = НоваяСвязьДокументов();
		ОписаниеСвязи.Идентификатор = СвязанныйДокумент.Идентификатор;
		ОписаниеСвязи.Номер         = СвязанныйДокумент.Номер;
		ОписаниеСвязи.Дата          = СвязанныйДокумент.Дата;
		ОписаниеСвязи.Наименование  = СвязанныйДокумент.Наименование;
		ОписаниеСвязи.Роль          = СвязанныйДокумент.Роль;
		ОписаниеСвязи.Вид           = СвязанныйДокумент.Наименование;
		ОписаниеСвязи.Связь         = "титул ЭТрН";

		ДобавитьСвязьДокументов(СписокСвязей, ОписаниеСвязи, ИдентификаторДокумента);

	КонецЦикла;

КонецПроцедуры

// Определяет, заказ ли это (заявка) на перевозку.
//
// Одна точка правды: признак нужен и таблице, и поиску заявки. Смотрим и
// русские названия, и английский код типа - тот же, что у реестра ЭПД.
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоЗаявкаНаПеревозку(Вид, Наименование)

	ТекстПроверки = ВРег(СокрЛП(СтрокойИлиПусто(Вид)) + " "
		+ СокрЛП(СтрокойИлиПусто(Наименование)));

	Если НЕ ЗначениеЗаполнено(ТекстПроверки) Тогда
		Возврат Ложь;
	КонецЕсли;

	Признаки = "ЗАКАЗ НА ПЕРЕВОЗ,ЗАКАЗНАПЕРЕВОЗ,ЗАЯВКА НА ПЕРЕВОЗ,ЗАЯВКАНАПЕРЕВОЗ,"
		+ "TRANSPORTORDER,ЗАКАЗВХ,ЗАКАЗИСХ";

	Для Каждого Признак Из СтрРазделить(Признаки, ",", Ложь) Цикл
		Если СтрНайти(ТекстПроверки, СокрЛП(Признак)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Перечисляет узлы документа, в которых могут лежать связи, и их ключи.
//
// Возвращаемое значение:
//   Строка
//
Функция ОписаниеУзловСвязей(ДокументСБИС) Экспорт

	ЧастиОписания = Новый Массив;

	ЧастиОписания.Добавить("корень [" + КлючиУзла(ДокументСБИС) + "]");

	УзелРасширения = ЗначениеУзла(ДокументСБИС, "Расширение");
	ЧастиОписания.Добавить("Расширение [" + КлючиУзла(УзелРасширения) + "]");

	УзелЦепочки = ЗначениеПоПути(ДокументСБИС, "Расширение.ЦепочкаДокументов");
	Если УзелЦепочки = Неопределено Тогда
		УзелЦепочки = НайтиУзелПоИмени(ДокументСБИС, "ЦепочкаДокументов");
	КонецЕсли;

	Если УзелЦепочки = Неопределено Тогда
		ЧастиОписания.Добавить("ЦепочкаДокументов: нет");
	ИначеЕсли ТипЗнч(УзелЦепочки) <> Тип("Соответствие") Тогда
		ЧастиОписания.Добавить(СтрШаблон("ЦепочкаДокументов: %1 = %2",
			Строка(ТипЗнч(УзелЦепочки)), Строка(УзелЦепочки)));
	ИначеЕсли УзелЦепочки.Количество() = 0 Тогда
		ЧастиОписания.Добавить("ЦепочкаДокументов: пусто");
	Иначе
		ЭлементыЦепочки = ЗначениеВМассив(УзелЦепочки);
		ЧастиОписания.Добавить(СтрШаблон("ЦепочкаДокументов: элементов %1, ключи [%2]",
			ЭлементыЦепочки.Количество(), КлючиУзла(УзелЦепочки)));
		ЧастиОписания.Добавить("первый элемент [" + КлючиУзла(ЭлементыЦепочки[0]) + "]");
	КонецЕсли;

	Для Каждого ИмяУзла Из СтрРазделить("LinkedOutflows,LinkedInflows", ",", Ложь) Цикл
		УзелСсылок = ЗначениеУзла(ДокументСБИС, СокрЛП(ИмяУзла));
		Если УзелСсылок <> Неопределено Тогда
			ЧастиОписания.Добавить(СтрШаблон("%1: %2 шт.",
				СокрЛП(ИмяУзла), ЗначениеВМассив(УзелСсылок).Количество()));
		КонецЕсли;
	КонецЦикла;

	ЧастиОписания.Добавить(СтрШаблон("сопроводительных в титулах: %1",
		ЭАрМ_ОбщийМодульОбмен.СвязанныеДокументыЭТрН(ДокументСБИС).Количество()));

	// Значения ключей важнее списка узлов: по ним и идёт сопоставление
	ЧастиОписания.Добавить("ключи связи: "
		+ ?(ЗначениеЗаполнено(КлючиСвязиДокумента(ДокументСБИС)),
			КлючиСвязиДокумента(ДокументСБИС), "нет"));

	Возврат СтрСоединить(ЧастиОписания, "; ");

КонецФункции

// Возвращает первое непустое значение из перечня ключей.
//
Функция ЗначениеПоКлючам(Узел, Ключи)

	Для Каждого ИмяКлюча Из СтрРазделить(Ключи, ",", Ложь) Цикл

		НайденноеЗначение = ЗначениеУзла(Узел, СокрЛП(ИмяКлюча));
		Если ЗначениеЗаполнено(НайденноеЗначение) Тогда
			Возврат НайденноеЗначение;
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

// Читает XML в дерево из Соответствий.
// Атрибуты и вложенные элементы кладутся одинаково - в формате ФНС значения
// приходят и так, и так, и различать их на этом уровне незачем.
//
// Возвращаемое значение:
//   Соответствие, Неопределено
//
Функция ПрочитатьXMLФайлВСоответствие(ПутьКФайлу, ТекстОшибки = "") Экспорт

	ТекстОшибки = "";

	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ТекстОшибки = "путь к файлу не заполнен";
		Возврат Неопределено;
	КонецЕсли;

	Попытка

		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(ПутьКФайлу);

		Результат = Неопределено;

		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				Результат = ПрочитатьЭлементXML(ЧтениеXML);
				Прервать;
			КонецЕсли;
		КонецЦикла;

		ЧтениеXML.Закрыть();

		Возврат Результат;

	Исключение
		// Пользователю - причина без стека вызовов, стек - в журнал регистрации
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = КраткийТекстОшибки(ИнфОбОшибке);
		ЗаписатьОшибку("ПрочитатьXMLФайлВСоответствие", ТекстИсключения(ИнфОбОшибке));
		Попытка
			ЧтениеXML.Закрыть();
		Исключение
			// файл не открылся или чтение уже закрыто
		КонецПопытки;
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Читает текущий элемент XML вместе с содержимым.
// Чтение стоит на НачалоЭлемента.
//
Функция ПрочитатьЭлементXML(ЧтениеXML)

	// Разбор плоский, со стеком: рекурсия спотыкалась о пустые узлы <Тег/>.
	// Свойства "пустой элемент" у ЧтениеXML нет - платформа сама выдаёт для
	// таких узлов НачалоЭлемента и сразу КонецЭлемента, поэтому достаточно
	// открывать кадр на начале и закрывать по имени на конце.

	Стек = Новый Массив;
	Стек.Добавить(НовыйКадрXML(ЧтениеXML));

	Пока ЧтениеXML.Прочитать() Цикл

		ТипТекущегоУзла = ЧтениеXML.ТипУзла;

		Если ТипТекущегоУзла = ТипУзлаXML.НачалоЭлемента Тогда

			Стек.Добавить(НовыйКадрXML(ЧтениеXML));

		ИначеЕсли ТипТекущегоУзла = ТипУзлаXML.КонецЭлемента Тогда

			ИмяЗакрываемого = ЧтениеXML.Имя;

			// Закрываем по имени: если разметка не сошлась, лишние кадры
			// схлопываем в родителя, а не теряем весь разбор
			Пока Стек.Количество() > 0 Цикл

				Кадр = Стек[Стек.ВГраница()];
				Стек.Удалить(Стек.ВГраница());

				Если Стек.Количество() = 0 Тогда
					Возврат СвернутьКадрXML(Кадр);
				КонецЕсли;

				Родитель = Стек[Стек.ВГраница()];
				ДобавитьДочернийУзелXML(Родитель.Значения, Кадр.Имя, СвернутьКадрXML(Кадр));

				Если Кадр.Имя = ИмяЗакрываемого Тогда
					Прервать;
				КонецЕсли;

			КонецЦикла;

		ИначеЕсли ТипТекущегоУзла = ТипУзлаXML.Текст Тогда

			Кадр = Стек[Стек.ВГраница()];
			Кадр.Текст = Кадр.Текст + ЧтениеXML.Значение;

		КонецЕсли;

	КонецЦикла;

	// Файл оборвался раньше закрывающих тегов - сворачиваем, что собрали
	Пока Стек.Количество() > 1 Цикл

		Кадр = Стек[Стек.ВГраница()];
		Стек.Удалить(Стек.ВГраница());

		Родитель = Стек[Стек.ВГраница()];
		ДобавитьДочернийУзелXML(Родитель.Значения, Кадр.Имя, СвернутьКадрXML(Кадр));

	КонецЦикла;

	Возврат СвернутьКадрXML(Стек[0]);

КонецФункции
// Заготовка узла для текущего элемента: имя и атрибуты.
//
// Имя снимается ДО обхода атрибутов - ПрочитатьАтрибут переводит чтение
// на узел-атрибут, где имя элемента уже недоступно.
//
Функция НовыйКадрXML(ЧтениеXML)

	Кадр = Новый Структура("Имя, Значения, Текст",
		ЧтениеXML.Имя, Новый Соответствие, "");

	Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
		Кадр.Значения.Вставить(ЧтениеXML.Имя, ЧтениеXML.Значение);
	КонецЦикла;

	Возврат Кадр;

КонецФункции
// Превращает заготовку в значение узла.
// Лист без атрибутов и без вложений - это просто текст.
//
Функция СвернутьКадрXML(Кадр)

	ТекстУзла = СокрЛП(Кадр.Текст);

	Если Кадр.Значения.Количество() = 0 Тогда
		Возврат ТекстУзла;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекстУзла) Тогда
		Кадр.Значения.Вставить("#текст", ТекстУзла);
	КонецЕсли;

	Возврат Кадр.Значения;

КонецФункции

// Ищет узел с одним из указанных имён на любой глубине - обход в ширину.
// Нужен как запасной вариант, когда путь к таблице товаров не сошёлся:
// имена узлов в форматах ФНС стабильнее, чем путь до них.
//
// Возвращаемое значение:
//   Произвольный, Неопределено
//
Функция НайтиУзелПоИмени(Корень, ИменаУзлов, МаксимальнаяГлубина = 12)

	ИскомыеИмена = СтрРазделить(ИменаУзлов, ",", Ложь);

	ТекущийУровень = Новый Массив;
	ТекущийУровень.Добавить(Корень);

	Глубина = 0;

	Пока ТекущийУровень.Количество() > 0 И Глубина < МаксимальнаяГлубина Цикл

		СледующийУровень = Новый Массив;

		Для Каждого Узел Из ТекущийУровень Цикл

			Если ТипЗнч(Узел) = Тип("Массив") Тогда
				Для Каждого ЭлементМассива Из Узел Цикл
					СледующийУровень.Добавить(ЭлементМассива);
				КонецЦикла;
				Продолжить;
			КонецЕсли;

			Если ТипЗнч(Узел) <> Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли;

			Для Каждого ИмяУзла Из ИскомыеИмена Цикл
				Найденное = Узел.Получить(СокрЛП(ИмяУзла));
				Если Найденное <> Неопределено Тогда
					Возврат Найденное;
				КонецЕсли;
			КонецЦикла;

			Для Каждого КлючЗначение Из Узел Цикл
				СледующийУровень.Добавить(КлючЗначение.Значение);
			КонецЦикла;

		КонецЦикла;

		ТекущийУровень = СледующийУровень;
		Глубина = Глубина + 1;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Добавляет дочерний узел; повторяющиеся имена собираются в массив.
//
Процедура ДобавитьДочернийУзелXML(Элемент, ИмяУзла, ЗначениеУзлаXML)

	Существующее = Элемент.Получить(ИмяУзла);

	Если Существующее = Неопределено Тогда
		Элемент.Вставить(ИмяУзла, ЗначениеУзлаXML);
	ИначеЕсли ТипЗнч(Существующее) = Тип("Массив") Тогда
		Существующее.Добавить(ЗначениеУзлаXML);
	Иначе
		СписокУзлов = Новый Массив;
		СписокУзлов.Добавить(Существующее);
		СписокУзлов.Добавить(ЗначениеУзлаXML);
		Элемент.Вставить(ИмяУзла, СписокУзлов);
	КонецЕсли;

КонецПроцедуры

// Приводит адрес FTP-сервера к тому виду, который принимает конструктор.
//
// В поле настроек попадает то, что человек скопировал: "ftp://host",
// "host:2121", "host/edo", лишний слэш в конце. Конструктору FTPСоединение
// нужно голое имя хоста, на всём остальном он падает с "Ошибка при вызове
// конструктора" - и не поясняет, что именно ему не понравилось.
//
// Параметры:
//   Сервер - Строка - адрес, как его ввели в настройках
//   Порт   - Число, Строка - порт из настроек
//
// Возвращаемое значение:
//   Структура:
//     * Сервер - Строка - только имя хоста
//     * Порт   - Число - порт из адреса, если он был указан там, иначе из
//                настроек; 21, если не задан нигде
//
Функция АдресСервераFTP(Сервер, Порт = 0) Экспорт

	Результат = Новый Структура("Сервер, Порт", "", ЧислоИзСтрокиСБИС(Порт));

	Адрес = СокрЛП(СтрЗаменить(Строка(Сервер), "\", "/"));

	// Схему отбрасываем. FTPСоединение ходит по FTP, поэтому sftp:// здесь
	// всё равно не заработает - но пусть отказ придёт от сервера, а не от
	// конструктора: так в журнале видно, куда именно не достучались
	Позиция = СтрНайти(Адрес, "://");
	Если Позиция > 0 Тогда
		Адрес = Сред(Адрес, Позиция + 3);
	КонецЕсли;

	// Каталог задаётся отдельной настройкой, в адресе он лишний
	Позиция = СтрНайти(Адрес, "/");
	Если Позиция > 0 Тогда
		Адрес = Лев(Адрес, Позиция - 1);
	КонецЕсли;

	// "host:2121" - порт из адреса главнее: его указали вместе с сервером
	Позиция = СтрНайти(Адрес, ":");
	Если Позиция > 0 Тогда
		ПортИзАдреса = ЧислоИзСтрокиСБИС(Сред(Адрес, Позиция + 1));
		Адрес = Лев(Адрес, Позиция - 1);
		Если ПортИзАдреса > 0 Тогда
			Результат.Порт = ПортИзАдреса;
		КонецЕсли;
	КонецЕсли;

	Результат.Сервер = СокрЛП(Адрес);

	Если Результат.Порт <= 0 Тогда
		Результат.Порт = 21;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Создаёт FTP-соединение.
//
// Сам конструктор вызывает БСП - ТранспортСообщенийОбмена.FTPСоединение. Своя
// сборка держала состав параметров вручную и передавала прокси пустым: в сети
// с прокси-сервером соединение до FTP не доходило. БСП же берёт прокси из
// настроек интернет-поддержки и знает про ЗащищенноеСоединение.
//
// Наше здесь - разбор адреса и приведение типов: FTPИмяСервераИПуть из БСП
// требует строку строго вида "ftp://server/path" и падает на "host" и
// "host:2121", а в поле настроек лежит именно имя хоста.
//
// Параметры:
//   НастройкиПодключения - Структура - см. ЭАрМ_НастройкиСервер.НастройкиFTP.
//                          Обязательны Сервер, Порт, Пользователь, Пароль;
//                          ПассивноеСоединение и Таймаут - по возможности
//
// Возвращаемое значение:
//   FTPСоединение
//
Функция СоздатьСоединениеFTP(НастройкиПодключения) Экспорт

	// Адрес и порт разбираются вместе: конструктору нужны отдельно имя хоста
	// и Число, а в настройках порт мог сохраниться строкой, да и в самом
	// адресе он мог оказаться. Без приведения конструктор падает с
	// "Несоответствие типов (параметр номер '2')", даже если сервер верный
	Адрес = АдресСервераFTP(НастройкиПодключения.Сервер, НастройкиПодключения.Порт);

	Если НЕ ЗначениеЗаполнено(Адрес.Сервер) Тогда
		ВызватьИсключение НСтр(
			"ru = 'Не заполнен адрес FTP-сервера. Настройки ЭДО - раздел FTP'");
	КонецЕсли;

	Настройки = ТранспортСообщенийОбмена.FTPНастройкиСоединения();
	Настройки.Сервер             = Адрес.Сервер;
	Настройки.Порт               = Адрес.Порт;
	Настройки.ИмяПользователя    = НастройкиПодключения.Пользователь;
	Настройки.ПарольПользователя = НастройкиПодключения.Пароль;

	// Структуру настроек собирают разные вызывающие, и не в каждой есть режим
	// и таймаут. Пассивный режим по умолчанию: за NAT активный не проходит
	Настройки.ПассивноеСоединение = Истина;
	ЗначениеРежима = Неопределено;
	Если НастройкиПодключения.Свойство("ПассивноеСоединение", ЗначениеРежима)
		И ЗначениеРежима <> Неопределено Тогда

		Настройки.ПассивноеСоединение = ?(ТипЗнч(ЗначениеРежима) = Тип("Булево"),
			ЗначениеРежима, ЗначениеЗаполнено(ЗначениеРежима));

	КонецЕсли;

	// Таймаут не задан - остаётся умолчание БСП (180 секунд)
	ЗначениеТаймаута = Неопределено;
	Если НастройкиПодключения.Свойство("Таймаут", ЗначениеТаймаута) Тогда
		Таймаут = ЧислоИзСтрокиСБИС(ЗначениеТаймаута);
		Если Таймаут > 0 Тогда
			Настройки.Таймаут = Таймаут;
		КонецЕсли;
	КонецЕсли;

	Попытка
		Возврат ТранспортСообщенийОбмена.FTPСоединение(Настройки);
	Исключение
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Не удалось создать FTP-соединение с %1:%2. %3'"),
			Адрес.Сервер, Формат(Адрес.Порт, "ЧГ=0"),
			ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

// Убеждается, что каталог на FTP есть, и создаёт его, если нет.
//
// Раньше каталог создавался вслепую, а отказ молча проглатывался: "каталог уже
// есть" и "нет прав" выглядели одинаково, и настоящая причина всплывала позже -
// на записи файла. Наличие проверяем через БСП
// (ТранспортСообщенийОбмена.FTPКаталогСуществует), создаём только отсутствующий,
// и вот его отказ уже означает именно отказ - он уходит вызывающему.
//
// Параметры:
//   Соединение   - FTPСоединение - см. СоздатьСоединениеFTP
//   ПутьКаталога - Строка - полный путь на сервере
//
Процедура ОбеспечитьКаталогFTP(Соединение, ПутьКаталога) Экспорт

	Путь = СокрЛП(СтрЗаменить(Строка(ПутьКаталога), "\", "/"));

	Если Прав(Путь, 1) = "/" И СтрДлина(Путь) > 1 Тогда
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЕсли;

	// Корень создавать не нужно и нечем: у него нет родителя
	Если НЕ ЗначениеЗаполнено(Путь) ИЛИ Путь = "/" Тогда
		Возврат;
	КонецЕсли;

	Позиция = СтрНайти(Путь, "/", НаправлениеПоиска.СКонца);
	ИмяКаталога  = ?(Позиция > 0, Сред(Путь, Позиция + 1), Путь);
	ПутьРодителя = ?(Позиция > 1, Лев(Путь, Позиция - 1), "/");

	Попытка
		Существует = ТранспортСообщенийОбмена.FTPКаталогСуществует(
			ПутьРодителя, ИмяКаталога, Соединение);
	Исключение
		// Родительского каталога может не быть - тогда и проверять нечего
		Существует = Ложь;
	КонецПопытки;

	Если Существует Тогда
		Возврат;
	КонецЕсли;

	Соединение.СоздатьКаталог(Путь);

КонецПроцедуры

// Пишет текст в файл в UTF-8 без BOM: BOM ломает разбор JSON приёмниками.
//
Процедура ЗаписатьТекстВФайл(ТекстФайла, ПутьКФайлу) Экспорт

	Попытка
		ДанныеФайла = ПолучитьДвоичныеДанныеИзСтроки(ТекстФайла, "UTF-8", Ложь);
		ДанныеФайла.Записать(ПутьКФайлу);
	Исключение
		ЗаписьФайла = Новый ЗаписьТекста(ПутьКФайлу, "UTF-8");
		ЗаписьФайла.ЗаписатьСтроку(ТекстФайла);
		ЗаписьФайла.Закрыть();
	КонецПопытки;

КонецПроцедуры

// Удаляет временный файл, не мешая основному результату при отказе.
//
Процедура УдалитьВременныйФайл(ПутьКФайлу) Экспорт

	Попытка
		УдалитьФайлы(ПутьКФайлу);
	Исключение
		// временный файл подчистит система
	КонецПопытки;

КонецПроцедуры

// Склеивает каталог и имя файла в путь FTP через прямой слэш.
//
Функция ОбъединитьПутьFTP(Каталог, ИмяФайла) Экспорт

	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		Возврат ИмяФайла;
	КонецЕсли;

	ПутьКаталога = СтрЗаменить(Каталог, "\", "/");
	Если Прав(ПутьКаталога, 1) = "/" Тогда
		Возврат ПутьКаталога + ИмяФайла;
	КонецЕсли;

	Возврат ПутьКаталога + "/" + ИмяФайла;

КонецФункции

// Формирует имя файла выгрузки: тип, номер документа и метка времени.
//
Функция ИмяФайлаВыгрузки(ДанныеНакладной) Экспорт

	НомерДокумента = ОчиститьДляИмениФайла(ДанныеНакладной.ПриходнаяНакладная.ВходящийНомер);
	Если НЕ ЗначениеЗаполнено(НомерДокумента) Тогда
		НомерДокумента = ОчиститьДляИмениФайла(ДанныеНакладной.Источник.Идентификатор);
	КонецЕсли;

	Возврат СтрШаблон("ЭТрН_%1_%2.json",
		НомерДокумента, Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss"));

КонецФункции

// Убирает из строки символы, недопустимые в имени файла.
//
Функция ОчиститьДляИмениФайла(Значение) Экспорт

	Результат = СтрокойИлиПусто(Значение);

	Для Каждого НедопустимыйСимвол Из СтрРазделить("\,/,:,*,?,"",<,>,|, ", ",", Ложь) Цикл
		Результат = СтрЗаменить(Результат, НедопустимыйСимвол, "_");
	КонецЦикла;

	Возврат СокрЛП(Результат);

КонецФункции

// Возвращает узел "Источник" будущего JSON.
//
Функция ИсточникДляДалион(ДокументСБИС, РезультатГруза) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Система",       "СБИС");
	Результат.Вставить("ТипДокумента",  "ЭТрН");
	Результат.Вставить("Идентификатор", СтрокойИлиПусто(ЗначениеУзла(ДокументСБИС, "Идентификатор", "")));
	Результат.Вставить("КодТитула",     РезультатГруза.КодТитула);
	Результат.Вставить("ИмяТитула",     РезультатГруза.ИмяТитула);

	// Номер и дата нужны приёмнику, чтобы опознать документ без разбора шапки
	Результат.Вставить("Номер", СтрокойИлиПусто(ЗначениеУзла(ДокументСБИС, "Номер", "")));
	Результат.Вставить("Дата",  СтрокойИлиПусто(ЗначениеУзла(ДокументСБИС, "Дата", "")));

	// Товары либо построчно из самой ЭТрН, либо (когда груз свёрнут в одну
	// строку) из документа ЭДО, найденного строго по совпадению номера
	ИсточникТоваров = "ЭТрН";
	РезультатГруза.Свойство("ИсточникТоваров", ИсточникТоваров);
	Результат.Вставить("ИсточникТоваров", ИсточникТоваров);

	ИдентификаторУПД = "";
	РезультатГруза.Свойство("ИдентификаторУПД", ИдентификаторУПД);
	Результат.Вставить("ИдентификаторУПД", ИдентификаторУПД);

	Результат.Вставить("ВыгруженоВ", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));

	Возврат Результат;

КонецФункции

// Возвращает ТЧ "Товары" по реквизитам Документ.ПриходнаяНакладная Далиона.
//
// Цена, СтавкаНДС, СуммаНДС, ЕдиницаИзмерения, СрокГодности, НомерГТД,
// СтранаПроисхождения в ЭТрН отсутствуют - это товарные реквизиты, они живут
// в накладной ЭДО. Поля оставлены пустыми, чтобы приёмник видел их наличие.
//
// Количество приравнено к КоличествоМест: другой величины количества
// в транспортной накладной нет.
//
Функция ТоварыДляДалион(Позиции) Экспорт

	Результат = Новый Массив;

	Для Каждого ОписаниеПозиции Из Позиции Цикл

		Товар = Новый Структура;
		Товар.Вставить("ИдентификаторСтроки",       ОписаниеПозиции.НомерСтроки);
		Товар.Вставить("Номенклатура",              ОписаниеПозиции.Наименование);
		Товар.Вставить("КодНоменклатуры",           ОписаниеПозиции.Номенклатура);
		Товар.Вставить("ХарактеристикаНоменклатуры", "");
		Товар.Вставить("Артикул",                   ОписаниеПозиции.Артикул);
		Товар.Вставить("КоличествоМест",            ОписаниеПозиции.КоличествоМест);
		Товар.Вставить("ЕдиницаИзмеренияМест",      ОписаниеПозиции.СпособУпаковки);
		Товар.Вставить("ЕдиницаИзмерения",          ОписаниеПозиции.ЕдиницаИзмерения);
		// В ЭТрН количество товара - это грузовые места
		Товар.Вставить("Количество",                ОписаниеПозиции.КоличествоМест);
		Товар.Вставить("Коэффициент",               1);
		Товар.Вставить("Цена",                      ОписаниеПозиции.Цена);
		Товар.Вставить("Сумма",                     ОписаниеПозиции.Стоимость);
		Товар.Вставить("СтавкаНДС",                 ОписаниеПозиции.СтавкаНДС);
		Товар.Вставить("СуммаНДС",                  ОписаниеПозиции.СуммаНДС);
		Товар.Вставить("СрокГодности",              "");
		Товар.Вставить("НомерГТД",                  "");
		Товар.Вставить("СтранаПроисхождения",       "");
		Товар.Вставить("Склад",                     "");
		Товар.Вставить("ВидАлкогольнойПродукции",   "");
		Товар.Вставить("ПроизводительАлкоголя",     "");

		// Сведения ЭТрН, которых нет в реквизитах Далиона, но которые нужны
		// для сопоставления и контроля приёмки
		Товар.Вставить("ЭТрН_ТараКод",     ОписаниеПозиции.ТараКод);
		Товар.Вставить("ЭТрН_МассаБрутто", ОписаниеПозиции.МассаБрутто);
		Товар.Вставить("ЭТрН_МассаНетто",  ОписаниеПозиции.МассаНетто);
		Товар.Вставить("ЭТрН_Валюта",      ОписаниеПозиции.КодВалюты);
		Товар.Вставить("ЭТрН_Контейнеры",  ОписаниеПозиции.Контейнеры);

		Результат.Добавить(Товар);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает ТЧ "ШтрихкодыУпаковок": коды маркировки Честного знака.
// Это единственная поштучная идентификация товара, которая есть в ЭТрН.
//
Функция ШтрихкодыУпаковокДляДалион(Позиции) Экспорт

	Результат = Новый Массив;

	Для Каждого ОписаниеПозиции Из Позиции Цикл

		Для Каждого КодМаркировки Из ОписаниеПозиции.Маркировки Цикл

			СтрокаШтрихкода = Новый Структура;
			СтрокаШтрихкода.Вставить("ИдентификаторСтроки", ОписаниеПозиции.НомерСтроки);
			СтрокаШтрихкода.Вставить("Штрихкод",            КодМаркировки);
			СтрокаШтрихкода.Вставить("GTIN",                "");
			СтрокаШтрихкода.Вставить("СерийныйНомер",       "");
			СтрокаШтрихкода.Вставить("Считана",             Ложь);
			СтрокаШтрихкода.Вставить("ДобавленаВручную",    Ложь);

			Результат.Добавить(СтрокаШтрихкода);

		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает сумму документа по строкам товаров.
//
Функция СуммаПоТоварам(Товары) Экспорт

	Результат = 0;

	Для Каждого Товар Из Товары Цикл
		Результат = Результат + Товар.Сумма;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает валюту документа: первую непустую по строкам товаров.
//
Функция ВалютаПоТоварам(Товары) Экспорт

	Для Каждого Товар Из Товары Цикл
		Если ЗначениеЗаполнено(Товар.ЭТрН_Валюта) Тогда
			Возврат Товар.ЭТрН_Валюта;
		КонецЕсли;
	КонецЦикла;

	Возврат "643";

КонецФункции

// Складывает комментарий из данных доставки: в реквизитах Далиона
// адреса маршрута нет, а для приёмки он нужен.
//
Функция КомментарийПоДоставке(РезультатГруза) Экспорт

	ЧастиКомментария = Новый Массив;

	Если ЗначениеЗаполнено(РезультатГруза.АдресДоставки) Тогда
		ЧастиКомментария.Добавить("Доставка: " + РезультатГруза.АдресДоставки);
	КонецЕсли;

	Если ЗначениеЗаполнено(РезультатГруза.ДоставитьДо) Тогда
		ЧастиКомментария.Добавить("Доставить до: " + РезультатГруза.ДоставитьДо);
	КонецЕсли;

	Возврат СтрСоединить(ЧастиКомментария, "; ");

КонецФункции

// Возвращает узел стороны по перечню возможных ролей.
//
Функция СторонаПоКлючам(Стороны, Ключи) Экспорт

	Для Каждого ИмяРоли Из СтрРазделить(Ключи, ",", Ложь) Цикл

		ДанныеСтороны = ЗначениеУзла(Стороны, СокрЛП(ИмяРоли));
		Если ДанныеСтороны <> Неопределено Тогда
			Возврат ДанныеСтороны;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает свою сторону или встречную с учётом направления документа.
//
Функция СторонаПоНаправлению(ДокументСБИС, Стороны, Направление, ЭтоСвояСторона) Экспорт

	ЭтоИсходящий = (ВРег(Направление) = ВРег("Исходящий"));
	НужнаРольОтправителя = (ЭтоИсходящий = ЭтоСвояСторона);

	Если НужнаРольОтправителя Тогда
		ДанныеСтороны = СторонаПоКлючам(Стороны, "Отправитель,Грузоотправитель,Продавец");
	Иначе
		ДанныеСтороны = СторонаПоКлючам(Стороны, "Получатель,Грузополучатель,Покупатель");
	КонецЕсли;

	Если ДанныеСтороны <> Неопределено Тогда
		Возврат ДанныеСтороны;
	КонецЕсли;

	// Явные узлы документа точнее вывода по направлению
	Если ЭтоСвояСторона Тогда
		Возврат ЗначениеУзла(ДокументСБИС, "НашаОрганизация");
	КонецЕсли;

	Возврат ЗначениеУзла(ДокументСБИС, "Контрагент");

КонецФункции

// Возвращает заготовку результата методов получения списка.
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, Документы, Навигация, Ответ
//
Функция НовыйРезультатСписка() Экспорт

	Возврат Новый Структура("Успех, Ошибка, Документы, Навигация, Ответ",
		Истина, "", Новый Массив, Новый Соответствие, "");

КонецФункции

// Добавляет в фильтр период и навигацию в формате СБИС.
//
// Период обязателен: фильтр без ДатаС/ДатаПо означает "весь архив", и СБИС
// перебирает его целиком на каждый вызов. Через эту процедуру проходят оба
// метода списка, поэтому незаполненный период здесь и подменяется окном из
// настроек - запросов "за всё время" в обмене быть не должно.
//
Процедура ДополнитьФильтрПериодомИНавигацией(
		СтруктураФильтра, ДатаС, ДатаПо, Страница, РазмерСтраницы) Экспорт

	НачалоПериода = ДатаС;
	КонецПериода  = ДатаПо;

	Если НЕ ЗначениеЗаполнено(НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(КонецПериода) Тогда

		ПериодПоУмолчанию = ЭАрМ_НастройкиСервер.ПериодЗапросаСБИС();

		Если НЕ ЗначениеЗаполнено(НачалоПериода) Тогда
			НачалоПериода = ПериодПоУмолчанию.ДатаС;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(КонецПериода) Тогда
			КонецПериода = ПериодПоУмолчанию.ДатаПо;
		КонецЕсли;

	КонецЕсли;

	СтруктураФильтра.Вставить("ДатаС", НачалоПериода);
	СтруктураФильтра.Вставить("ДатаПо", КонецПериода);

	НавигацияФильтра = Новый Структура;
	НавигацияФильтра.Вставить("Страница", Строка(Страница));
	НавигацияФильтра.Вставить("РазмерСтраницы", Строка(РазмерСтраницы));
	СтруктураФильтра.Вставить("Навигация", НавигацияФильтра);

КонецПроцедуры

// Выполняет метод списка и раскладывает ответ по полям результата.
//
Процедура ЗаполнитьРезультатСписка(Результат, Метод, СтруктураФильтра, Сессия, АдресСервиса) Экспорт

	Настройки = ЭАрМ_НастройкиСервер.НастройкиСБИС();

	ИдСессии = Сессия;
	Если НЕ ЗначениеЗаполнено(ИдСессии) Тогда
		ИдСессии = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	КонецЕсли;

	Адрес = АдресСервиса;
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Адрес = Настройки.АдресСервера;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИдСессии) Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = "Не заполнена сессия (sid)";
		Возврат;
	КонецЕсли;

	ОтветМетода = ВыполнитьМетодСБИС(
		Метод, Новый Структура("Фильтр", СтруктураФильтра), ИдСессии, Адрес);

	Результат.Ответ = ОтветМетода.Ответ;

	Если НЕ ОтветМетода.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = ОтветМетода.Ошибка;
		Возврат;
	КонецЕсли;

	// Документы могут прийти как "Реестр" или "Документ".
	// Имя переменной не "Документы": так называется глобальный менеджер
	// документов 1С, присваивание в него запрещено.
	СписокДокументов = ЗначениеУзла(ОтветМетода.Данные, "Реестр");
	Если СписокДокументов = Неопределено Тогда
		СписокДокументов = ЗначениеУзла(ОтветМетода.Данные, "Документ");
	КонецЕсли;
	// В реестре по событиям элемент - это событие с вложенным документом
	Если СписокДокументов <> Неопределено Тогда
		Для Каждого ЭлементРеестра Из ЗначениеВМассив(СписокДокументов) Цикл
			Результат.Документы.Добавить(ДокументИзЭлементаРеестра(ЭлементРеестра));
		КонецЦикла;
	КонецЕсли;

	// Навигация (Страница, РазмерСтраницы, ЕстьЕще)
	ДанныеНавигации = ЗначениеУзла(ОтветМетода.Данные, "Навигация");
	Если ДанныеНавигации <> Неопределено Тогда
		Результат.Навигация = ДанныеНавигации;
	КонецЕсли;

КонецПроцедуры

// Выполняет JSON-RPC метод СБИС.
//
// Каждый вызов (и повтор после обрыва соединения из кеша) оставляет строку
// в журнале запросов СБИС - см. ЗаписатьВЖурналЗапросовСБИС.
//
// Параметры:
//   Метод           - Строка - имя метода, например "СБИС.СписокДокументов"
//   ПараметрыМетода - Структура - узел params
//   Сессия          - Строка - session ID (sid)
//   АдресСервиса    - Строка - хост сервера
//   КешСоединений   - Соответствие, Неопределено
//   Источник        - Строка - откуда вызвано (для журнала запросов), необязательно
//
// Возвращаемое значение:
//   Структура:
//     * Успех  - Булево
//     * Ошибка - Строка
//     * Ответ  - Строка - полный ответ сервера
//     * Данные - Произвольный - содержимое узла result
//
Функция ВыполнитьМетодСБИС(Метод, ПараметрыМетода, Сессия, АдресСервиса,
		КешСоединений = Неопределено, Источник = "") Экспорт

	Результат = Новый Структура("Успех, Ошибка, Ответ, Данные",
		Истина, "", "", Неопределено);

	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("jsonrpc", "2.0");
	СтруктураЗапроса.Вставить("method",  Метод);
	СтруктураЗапроса.Вставить("params",  ПараметрыМетода);
	СтруктураЗапроса.Вставить("id",      1);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
	ТелоЗапроса = ЗаписьJSON.Закрыть();

	// Для журнала запросов СБИС: время, код HTTP и текст ошибки БЕЗ тела ответа
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ДлительностьМс = Неопределено;
	КодСостояния = 0;
	ТекстДляЖурнала = "";
	Повтор = Ложь;

	Попытка
		Соединение = СоединениеСБИС(АдресСервиса, КешСоединений);

		Запрос = Новый HTTPЗапрос("/service/?srv=1");
		Запрос.Заголовки.Вставить("Content-Type", "application/json-rpc;charset=utf-8");
		Запрос.Заголовки.Вставить("X-SBISSessionID", Сессия);
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8",
			ИспользованиеByteOrderMark.НеИспользовать);

		Попытка
			Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Исключение
			// Соединение из кеша сервер мог уже закрыть - поднимаем заново
			// и повторяем один раз, иначе оборвалась бы вся пачка
			Если ТипЗнч(КешСоединений) <> Тип("Соответствие") Тогда
				ВызватьИсключение;
			КонецЕсли;
			// Неудавшаяся попытка - своя строка журнала, повтор - следующая
			ЗаписатьВЖурналЗапросовСБИС(Метод, НачалоМс,
				ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс, Ложь, 0,
				ТекстИсключения(ИнформацияОбОшибке()), ИдентификаторДляЖурналаСБИС(ПараметрыМетода),
				0, 0, Ложь, Источник);
			Повтор = Истина;
			НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ЗабытьСоединениеСБИС(АдресСервиса, КешСоединений);
			Соединение = СоединениеСБИС(АдресСервиса, КешСоединений);
			Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		КонецПопытки;

		Результат.Ответ = Ответ.ПолучитьТелоКакСтроку();
		ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
		КодСостояния = Ответ.КодСостояния;

		// СБИС отдаёт ошибки бизнес-логики как JSON-RPC error с кодом HTTP 500,
		// поэтому тело разбираем независимо от кода состояния.
		ДанныеОтвета    = ПрочитатьОтветJSON(Результат.Ответ);
		ТекстОшибкиСБИС = ТекстОшибкиОтвета(ДанныеОтвета);

		Если ЗначениеЗаполнено(ТекстОшибкиСБИС) Тогда
			Результат.Успех = Ложь;
			Результат.Ошибка = ТекстОшибкиСБИС;
			ТекстДляЖурнала = ТекстОшибкиСБИС;
		ИначеЕсли Ответ.КодСостояния <> 200 Тогда
			Результат.Успех = Ложь;
			Результат.Ошибка = СтрШаблон("HTTP %1: %2",
				Ответ.КодСостояния, Результат.Ответ);
			// Тело ответа в журнал не идёт - только код
			ТекстДляЖурнала = СтрШаблон("HTTP %1", Ответ.КодСостояния);
		Иначе
			Результат.Данные = ЗначениеУзла(ДанныеОтвета, "result");
		КонецЕсли;

	Исключение
		Если ДлительностьМс = Неопределено Тогда
			ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
		КонецЕсли;
		ЗабытьСоединениеСБИС(АдресСервиса, КешСоединений);
		Результат.Успех = Ложь;
		Результат.Ошибка = СтрШаблон("Ошибка вызова %1: %2",
			Метод, ТекстИсключения(ИнформацияОбОшибке()));
		ТекстДляЖурнала = Результат.Ошибка;
		ЗаписатьОшибку(Метод, Результат.Ошибка);
	КонецПопытки;

	ЗаписатьВЖурналЗапросовСБИС(Метод, НачалоМс, ДлительностьМс, Результат.Успех, КодСостояния,
		ТекстДляЖурнала, ИдентификаторДляЖурналаСБИС(ПараметрыМетода), СтрДлина(Результат.Ответ),
		ЧислоЭлементовДляЖурналаСБИС(Метод, Результат.Данные), Повтор, Источник);

	Возврат Результат;

КонецФункции

// Идентификатор документа из параметров метода: Документ.Идентификатор или
// Идентификатор. Больше ничего из параметров в журнал не идёт.
//
Функция ИдентификаторДляЖурналаСБИС(ПараметрыМетода)

	Значение = ЗначениеУзла(ПараметрыМетода, "Идентификатор");
	Если Значение = Неопределено Тогда
		Значение = ЗначениеУзла(ЗначениеУзла(ПараметрыМетода, "Документ"), "Идентификатор");
	КонецЕсли;

	Если Значение = Неопределено ИЛИ ТипЗнч(Значение) = Тип("Структура")
		ИЛИ ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Сколько элементов списка пришло в result (Реестр или Документ), иначе 0.
// У СБИС.ПрочитатьДокумент «Документ» - вложенные документы одного документа,
// это не список.
//
Функция ЧислоЭлементовДляЖурналаСБИС(Метод, Данные)

	Если Данные = Неопределено ИЛИ Метод = "СБИС.ПрочитатьДокумент" Тогда
		Возврат 0;
	КонецЕсли;

	СписокДокументов = ЗначениеУзла(Данные, "Реестр");
	Если СписокДокументов = Неопределено Тогда
		СписокДокументов = ЗначениеУзла(Данные, "Документ");
	КонецЕсли;
	Если СписокДокументов = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ЗначениеВМассив(СписокДокументов).Количество();

КонецФункции

// Дописывает строку в журнал запросов к СБИС: одна строка JSON на вызов.
//
// Формат и смысл полей - МониторПапок\docs\Журнал_Запросов_СБИС.md; файл читает
// монитор. Файл: <КаталогПакетов>\СБИС\СБИС_Запросы_<ггггММдд>_с<НомерСеанса>.jsonl
// (папка та же, что у ТрассаПриема.log), UTF-8, дописывание в конец.
//
// Запись не ломает вызов: ошибка идёт в журнал регистрации «ЭАрМ.ЖурналСБИС»
// (Предупреждение). Каталога пакетов нет - не пишем. В строку НЕ попадают сессия,
// AppClientId, AppSecret, SecretKey, логины, пароли, тела запроса и ответа.
//
// Параметры:
//   Метод           - Строка - метод СБИС или "oauth"
//   НачалоМс        - Число - начало вызова, ТекущаяУниверсальнаяДатаВМиллисекундах()
//   ДлительностьМс  - Число
//   Успех           - Булево
//   КодСостояния    - Число - код HTTP, 0 - ответа нет
//   ТекстОшибки     - Строка - режется до 300 знаков
//   Идентификатор   - Строка - документ из параметров, иначе пусто
//   Байт            - Число - длина тела ответа
//   Элементов       - Число - длина списка в result
//   Повтор          - Булево - повтор после обрыва соединения из кеша
//   Источник        - Строка - откуда вызвано, если известно
//
Процедура ЗаписатьВЖурналЗапросовСБИС(Метод, НачалоМс, ДлительностьМс, Успех, КодСостояния,
		ТекстОшибки, Идентификатор, Байт, Элементов, Повтор, Источник = "") Экспорт

	Попытка

		Каталог = СокрЛП(ЭАрМ_НастройкиСервер.НастройкиЦепочки().КаталогПакетов);
		Если НЕ ЗначениеЗаполнено(Каталог) Тогда
			Возврат;
		КонецЕсли;

		// Локальное время начала: универсальные миллисекунды + смещение пояса
		// (округлено до 15 минут, чтобы секундный люфт двух часов не давал сдвиг)
		Смещение = Окр((ТекущаяДата() - ТекущаяУниверсальнаяДата()) / 900) * 900;
		СекундыУниверсальные = Цел(НачалоМс / 1000);
		ДолиСекунды = НачалоМс - СекундыУниверсальные * 1000;
		ВремяНачала = Дата(1, 1, 1) + СекундыУниверсальные + Смещение;

		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить("t", Формат(ВремяНачала, "ДФ=yyyy-MM-ddTHH:mm:ss") + "."
			+ Прав("000" + Формат(ДолиСекунды, "ЧГ=0"), 3));
		ДанныеСтроки.Вставить("m", Метод);
		ДанныеСтроки.Вставить("ms", ДлительностьМс);
		ДанныеСтроки.Вставить("ok", Успех = Истина);
		ДанныеСтроки.Вставить("http", КодСостояния);
		ДанныеСтроки.Вставить("err", Лев(СтрЗаменить(СтрЗаменить(Строка(ТекстОшибки), Символы.ПС, " "), Символы.ВК, ""), 300));
		ДанныеСтроки.Вставить("id", Идентификатор);
		ДанныеСтроки.Вставить("bytes", Байт);
		ДанныеСтроки.Вставить("n", Элементов);
		ДанныеСтроки.Вставить("retry", Повтор = Истина);
		ДанныеСтроки.Вставить("s", НомерСеансаИнформационнойБазы());
		ДанныеСтроки.Вставить("src", Источник);

		ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
		ЗаписьСтроки = Новый ЗаписьJSON;
		ЗаписьСтроки.УстановитьСтроку(ПараметрыJSON);
		ЗаписатьJSON(ЗаписьСтроки, ДанныеСтроки);
		ТекстСтроки = ЗаписьСтроки.Закрыть();

		КаталогЖурнала = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Каталог, "СБИС");
		ФайлКаталога = Новый Файл(КаталогЖурнала);
		Если НЕ ФайлКаталога.Существует() Тогда
			СоздатьКаталог(КаталогЖурнала);
		КонецЕсли;

		ИмяФайла = СтрШаблон("СБИС_Запросы_%1_с%2.jsonl",
			Формат(ВремяНачала, "ДФ=yyyyMMdd"), Формат(НомерСеансаИнформационнойБазы(), "ЧГ=0"));

		Запись = Новый ЗаписьТекста(ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(КаталогЖурнала, ИмяФайла),
			КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку(ТекстСтроки);
		Запись.Закрыть();

	Исключение
		ЗаписьЖурналаРегистрации("ЭАрМ.ЖурналСБИС", УровеньЖурналаРегистрации.Предупреждение, , ,
			СтрШаблон(НСтр("ru = 'Журнал запросов СБИС не записан (%1): %2'"), Метод,
				Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 500)));
	КонецПопытки;

КонецПроцедуры

// Возвращает заготовку результата методов получения груза.
//
// Возвращаемое значение:
//   Структура:
//     * Успех         - Булево
//     * Ошибка        - Строка
//     * Идентификатор - Строка - документ, из которого взят груз
//     * КодТитула     - Строка - титул, из которого взят груз
//     * ИмяТитула     - Строка - имя титула, например "Погрузка"
//     * Позиции       - Массив структур - см. ПозицияГруза
//     * Пункты        - Массив структур - см. ПунктыМаршрутаЭТрН
//     * АдресПогрузки - Строка - адрес первого пункта погрузки
//     * АдресДоставки - Строка - адрес первого пункта выгрузки
//     * ДоставитьДо   - Строка - плановые дата и время выгрузки
//
Функция НовыйРезультатГруза() Экспорт

	Возврат Новый Структура(
		"Успех, Ошибка, Идентификатор, КодТитула, ИмяТитула, Позиции,"
		+ " Пункты, АдресПогрузки, АдресДоставки, ДоставитьДо",
		Истина, "", "", "", "", Новый Массив,
		Новый Массив, "", "", "");

КонецФункции

// Возвращает соответствие "код титула ЭТрН" -> "имя титула".
// Коды - те же, что использует подсистема ЭПД СБИС.
//
// Возвращаемое значение:
//   Соответствие
//
Функция КодыТитуловЭТрН() Экспорт

	РезультатФункции = Новый Соответствие;
	РезультатФункции.Вставить("1110339", "Погрузка");
	РезультатФункции.Вставить("1110340", "ПолучениеГруза");
	РезультатФункции.Вставить("1110341", "ПриемкаГруза");
	РезультатФункции.Вставить("1110342", "ВыдачаГруза");
	РезультатФункции.Вставить("1110343", "Переадресовка");
	РезультатФункции.Вставить("1167009", "ПереадресовкаУведомление");
	РезультатФункции.Вставить("1110344", "ЗаменаВодителяТС");
	РезультатФункции.Вставить("1110345", "ИзменениеСтоимости");
	РезультатФункции.Вставить("1110346", "СогласованиеСтоимости");

	Возврат РезультатФункции;

КонецФункции

// Порядок титулов ЭТрН по титульному flow: сначала основные этапы
// (Погрузка → ПолучениеГруза → ПриемкаГруза → ВыдачаГруза), затем
// служебные титулы. По этому порядку строится сводка для формы реестра
// (см. ЭАрМ_ОбщийМодульОбмен.СводкаТитуловЭТрН).
//
// Возвращаемое значение:
//   Массив из Строка - коды титулов (см. КодыТитуловЭТрН)
//
Функция ПорядокТитуловЭТрН() Экспорт

	РезультатФункции = Новый Массив;
	РезультатФункции.Добавить("1110339"); // Погрузка
	РезультатФункции.Добавить("1110340"); // ПолучениеГруза
	РезультатФункции.Добавить("1110341"); // ПриемкаГруза
	РезультатФункции.Добавить("1110342"); // ВыдачаГруза
	РезультатФункции.Добавить("1110343"); // Переадресовка
	РезультатФункции.Добавить("1167009"); // ПереадресовкаУведомление
	РезультатФункции.Добавить("1110344"); // ЗаменаВодителяТС
	РезультатФункции.Добавить("1110345"); // ИзменениеСтоимости
	РезультатФункции.Добавить("1110346"); // СогласованиеСтоимости

	Возврат РезультатФункции;

КонецФункции

// Разбирает одну позицию груза ЭТрН.
//
// Параметры:
//   Груз        - Соответствие - элемент массива Груз.Позиция
//   НомерСтроки - Число - порядковый номер позиции
//
// Возвращаемое значение:
//   Структура - плоское описание позиции
//
Функция ПозицияГруза(Груз, НомерСтроки) Экспорт

	Позиция = Новый Структура;
	Позиция.Вставить("НомерСтроки",    НомерСтроки);
	Позиция.Вставить("Наименование",   ЗначениеУзла(Груз, "Наименование", ""));

	// Код номенклатуры: при загрузке узел называется "Номенклатура",
	// при выгрузке в шаблоне позиции - "КодНоменклатуры". Читаем оба.
	КодНоменклатуры = ЗначениеУзла(Груз, "Номенклатура", "");
	Если НЕ ЗначениеЗаполнено(КодНоменклатуры) Тогда
		КодНоменклатуры = ЗначениеУзла(Груз, "КодНоменклатуры", "");
	КонецЕсли;
	Позиция.Вставить("Номенклатура", КодНоменклатуры);
	Позиция.Вставить("СпособУпаковки", ЗначениеУзла(Груз, "Упаковка", ""));
	Позиция.Вставить("ТараКод",        ЗначениеУзла(Груз, "ТараКод", ""));
	Позиция.Вставить("Примечание",     ЗначениеУзла(Груз, "ДопИнформация", ""));
	Позиция.Вставить("Состояние",      ЗначениеУзла(Груз, "Состояние", ""));

	ПараметрыГруза = ЗначениеУзла(Груз, "Параметры");
	Позиция.Вставить("КоличествоМест",
		ЧислоИзСтрокиСБИС(ЗначениеУзла(ПараметрыГруза, "КоличествоМест")));
	Позиция.Вставить("КоличествоПаллет",
		ЧислоИзСтрокиСБИС(ЗначениеУзла(ПараметрыГруза, "КоличествоПаллет")));
	Позиция.Вставить("МассаБрутто",
		ЧислоИзСтрокиСБИС(ЗначениеПоПути(ПараметрыГруза, "Масса.Брутто")));
	Позиция.Вставить("МассаНетто",
		ЧислоИзСтрокиСБИС(ЗначениеПоПути(ПараметрыГруза, "Масса.Нетто")));
	Позиция.Вставить("Длина",     ЧислоИзСтрокиСБИС(ЗначениеУзла(ПараметрыГруза, "Длина")));
	Позиция.Вставить("Ширина",    ЧислоИзСтрокиСБИС(ЗначениеУзла(ПараметрыГруза, "Ширина")));
	Позиция.Вставить("Высота",    ЧислоИзСтрокиСБИС(ЗначениеУзла(ПараметрыГруза, "Высота")));
	Позиция.Вставить("Объем",     ЧислоИзСтрокиСБИС(ЗначениеУзла(ПараметрыГруза, "Объем")));
	Позиция.Вставить("Плотность", ЧислоИзСтрокиСБИС(ЗначениеУзла(ПараметрыГруза, "Плотность")));

	Позиция.Вставить("Стоимость",
		ЧислоИзСтрокиСБИС(ЗначениеПоПути(Груз, "Стоимость.ВключаяНДС")));
	Позиция.Вставить("КодВалюты",
		ЗначениеПоПути(Груз, "Стоимость.Валюта.Код", "643"));

	СписокКонтейнеров = КонтейнерыПозиции(Груз);
	Позиция.Вставить("Контейнеры", СписокКонтейнеров);
	Позиция.Вставить("ТипГруза",
		?(СписокКонтейнеров.Количество() > 0, "Контейнер", "Груз"));

	// Ценовые поля заводим всегда, пустыми: в ЭТрН их нет, а УПД читается
	// отдельно и с грузом накладной не смешивается. Так формат выгрузки
	// не зависит от того, что показано на форме.
	Позиция.Вставить("Цена",             0);
	Позиция.Вставить("СтавкаНДС",        "");
	Позиция.Вставить("СуммаНДС",         0);
	Позиция.Вставить("СуммаБезНДС",      0);
	Позиция.Вставить("СуммаСНДС",        0);
	Позиция.Вставить("ЕдиницаИзмерения", "");
	Позиция.Вставить("Артикул",          "");
	Позиция.Вставить("КодТовара",        "");
	Позиция.Вставить("Штрихкод",         "");

	Позиция.Вставить("Маркировки",   МаркировкиПозиции(Груз));
	Позиция.Вставить("ОпасныеГрузы", ЗначениеВМассив(ЗначениеУзла(Груз, "ОпасныйГруз")));
	Позиция.Вставить("СведенияГИС",  СведенияГИСПозиции(Груз));

	Возврат Позиция;

КонецФункции

// Разбирает контейнеры позиции груза.
//
// Возвращаемое значение:
//   Массив структур - Номер, Количество
//
Функция КонтейнерыПозиции(Груз)

	РезультатФункции = Новый Массив;

	Для Каждого Контейнер Из ЗначениеВМассив(ЗначениеУзла(Груз, "Контейнер")) Цикл

		КоличествоКонтейнеров = ЧислоИзСтрокиСБИС(ЗначениеУзла(Контейнер, "Количество"));

		Для Каждого СтрокаНомера Из ЗначениеВМассив(ЗначениеУзла(Контейнер, "Номер")) Цикл

			ОписаниеКонтейнера = Новый Структура;
			ОписаниеКонтейнера.Вставить("Номер", ЗначениеУзла(СтрокаНомера, "Значение", ""));
			ОписаниеКонтейнера.Вставить("Количество",
				?(КоличествоКонтейнеров = 0, 1, КоличествоКонтейнеров));

			РезультатФункции.Добавить(ОписаниеКонтейнера);

		КонецЦикла;

	КонецЦикла;

	Возврат РезультатФункции;

КонецФункции

// Разбирает коды маркировки позиции груза.
//
// Возвращаемое значение:
//   Массив строк
//
Функция МаркировкиПозиции(Груз)

	РезультатФункции = Новый Массив;

	Для Каждого СтрокаМаркировки Из ЗначениеВМассив(ЗначениеУзла(Груз, "Маркировка")) Цикл

		КодМаркировки = ЗначениеУзла(СтрокаМаркировки, "Значение", "");
		Если ЗначениеЗаполнено(КодМаркировки) Тогда
			РезультатФункции.Добавить(КодМаркировки);
		КонецЕсли;

	КонецЦикла;

	Возврат РезультатФункции;

КонецФункции

// Разбирает сведения госсистем (Меркурий, ЕГАИС и т.п.) по позиции груза.
//
// Возвращаемое значение:
//   Структура, Неопределено - Наименование, УчетнаяЕдиница,
//                             ДругаяИнформация, Идентификаторы
//
Функция СведенияГИСПозиции(Груз)

	СведенияГИС = ЗначениеУзла(Груз, "СведенияГИС");
	Если СведенияГИС = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Идентификаторы = Новый Массив;
	Для Каждого СтрокаИдентификатора Из ЗначениеВМассив(ЗначениеУзла(СведенияГИС, "Идентификатор")) Цикл

		ЗначениеИдентификатора = ЗначениеУзла(СтрокаИдентификатора, "Значение", "");
		Если ЗначениеЗаполнено(ЗначениеИдентификатора) Тогда
			Идентификаторы.Добавить(ЗначениеИдентификатора);
		КонецЕсли;

	КонецЦикла;

	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Наименование",     ЗначениеУзла(СведенияГИС, "Наименование", ""));
	РезультатФункции.Вставить("УчетнаяЕдиница",   ЗначениеУзла(СведенияГИС, "УчетнаяЕдиница", ""));
	РезультатФункции.Вставить("ДругаяИнформация", ЗначениеУзла(СведенияГИС, "ДругаяИнформация", ""));
	РезультатФункции.Вставить("Идентификаторы",   Идентификаторы);

	Возврат РезультатФункции;

КонецФункции

// Возвращает значение по пути с точками, например "Стоимость.Валюта.Код".
//
// Параметры:
//   Узел                - Соответствие, Структура, Неопределено - откуда читаем
//   Путь                - Строка - путь через точку
//   ЗначениеПоУмолчанию - Произвольный - что вернуть, если узла нет
//
// Возвращаемое значение:
//   Произвольный
//
Функция ЗначениеПоПути(Узел, Путь, ЗначениеПоУмолчанию = Неопределено) Экспорт

	ТекущийУзел = Узел;

	Для Каждого ЧастьПути Из СтрРазделить(Путь, ".", Ложь) Цикл

		ТекущийУзел = ЗначениеУзла(ТекущийУзел, ЧастьПути);
		Если ТекущийУзел = Неопределено Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;

	КонецЦикла;

	Возврат ТекущийУзел;

КонецФункции

// Добавляет пункты одного вида в общий список маршрута.
// Пунктов может быть несколько, а при единственном СБИС присылает объект,
// а не массив - поэтому приведение через ЗначениеВМассив.
//
Процедура ДобавитьПунктыМаршрута(СписокПунктов, ДанныеПунктов, Вид) Экспорт

	НомерПункта = 1;

	Для Каждого ДанныеПункта Из ЗначениеВМассив(ДанныеПунктов) Цикл

		ОписаниеАдреса = ЭАрМ_ОбщийМодульОбмен.АдресПункта(ДанныеПункта);

		Пункт = Новый Структура;
		Пункт.Вставить("Вид",         Вид);
		Пункт.Вставить("НомерПункта", НомерПункта);
		Пункт.Вставить("Адрес",       ОписаниеАдреса.Адрес);
		Пункт.Вставить("GLN",         ОписаниеАдреса.GLN);
		Пункт.Вставить("ДатаВремя",
			СтрокойИлиПусто(ЗначениеПоПути(ДанныеПункта, "ДатаВремя.Значение", "")));

		СписокПунктов.Добавить(Пункт);

		НомерПункта = НомерПункта + 1;

	КонецЦикла;

КонецПроцедуры

// Собирает адрес строкой из структуры его частей.
// Порядок частей берём как пришёл в ответе: собственного шаблона адреса,
// как в расширении ЭПД, у нас нет.
//
Функция АдресИзЧастей(СтруктураАдреса) Экспорт

	Если СтруктураАдреса = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(СтруктураАдреса) <> Тип("Соответствие")
		И ТипЗнч(СтруктураАдреса) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	ЧастиАдреса = Новый Массив;

	Для Каждого ЭлементАдреса Из СтруктураАдреса Цикл
		ЧастьАдреса = СтрокойИлиПусто(ЭлементАдреса.Значение);
		Если ЗначениеЗаполнено(ЧастьАдреса) Тогда
			ЧастиАдреса.Добавить(СокрЛП(ЧастьАдреса));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(ЧастиАдреса, ", ");

КонецФункции

// Добавляет строку детализации груза, пропуская пустые значения.
//
Процедура ДобавитьДетальГруза(СписокДеталей, Вид, ЗначениеДетали, Количество) Экспорт

	Если НЕ ЗначениеЗаполнено(ЗначениеДетали) Тогда
		Возврат;
	КонецЕсли;

	Деталь = Новый Структура;
	Деталь.Вставить("Вид",        Вид);
	Деталь.Вставить("Значение",   Строка(ЗначениеДетали));
	Деталь.Вставить("Количество", Количество);

	СписокДеталей.Добавить(Деталь);

КонецПроцедуры

// Возвращает наименование опасного груза.
// В формате оно вложенное: отгрузочное и техническое названия.
//
Функция НаименованиеОпасногоГруза(ОписаниеОпасногоГруза) Экспорт

	Наименование = ЗначениеПоПути(ОписаниеОпасногоГруза, "Наименование.Отгрузочное", "");

	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Наименование = ЗначениеПоПути(ОписаниеОпасногоГруза, "Наименование.Техническое", "");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Наименование = ЗначениеУзла(ОписаниеОпасногоГруза, "Наименование", "");
	КонецЕсли;

	Если ТипЗнч(Наименование) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Возврат Наименование;

КонецФункции

// Возвращает название первой непустой стороны из перечня ключей.
//
// Параметры:
//   Стороны - Соответствие, Неопределено - узел "Стороны"
//   Ключи   - Строка - имена ролей через запятую, в порядке приоритета
//
// Возвращаемое значение:
//   Строка
//
Функция НазваниеСтороныПоКлючам(Стороны, Ключи) Экспорт

	Для Каждого ИмяРоли Из СтрРазделить(Ключи, ",", Ложь) Цикл

		НайденноеНазвание = ЭАрМ_ОбщийМодульОбмен.НазваниеСтороны(ЗначениеУзла(Стороны, СокрЛП(ИмяРоли)));
		Если ЗначениеЗаполнено(НайденноеНазвание) Тогда
			Возврат НайденноеНазвание;
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

// Возвращает значение, если это строка, иначе пустую строку.
// Узлы ответа СБИС в неожиданных местах приходят коллекциями, и Строка()
// от коллекции даёт бесполезное "Соответствие".
//
Функция СтрокойИлиПусто(ПроверяемоеЗначение) Экспорт

	Если ТипЗнч(ПроверяемоеЗначение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПроверяемоеЗначение;

КонецФункции

// Перечисляет ключи узла ответа. Нужно для диагностики: когда ожидаемого
// узла нет, важно видеть, что пришло вместо него.
//
// Параметры:
//   Узел - Соответствие, Структура, Произвольный - узел ответа
//
// Возвращаемое значение:
//   Строка - ключи через запятую
//
Функция КлючиУзла(Узел) Экспорт

	Если Узел = Неопределено Тогда
		Возврат "<пусто>";
	КонецЕсли;

	Если ТипЗнч(Узел) <> Тип("Соответствие") И ТипЗнч(Узел) <> Тип("Структура") Тогда
		Возврат СтрШаблон("<%1>", Строка(ТипЗнч(Узел)));
	КонецЕсли;

	СписокКлючей = Новый Массив;
	Для Каждого ЭлементУзла Из Узел Цикл
		СписокКлючей.Добавить(Строка(ЭлементУзла.Ключ));
	КонецЦикла;

	Если СписокКлючей.Количество() = 0 Тогда
		Возврат "<нет ключей>";
	КонецЕсли;

	Возврат СтрСоединить(СписокКлючей, ", ");

КонецФункции

// Собирает иерархию узлов разобранного XML в строку для диагностики.
// Нужно, когда непонятно, где в формате лежат строки товаров: по перечню
// путей сразу видно имена узлов и примеры значений.
//
// Параметры:
//   Корень              - Соответствие, Неопределено - см. ПрочитатьXMLФайлВСоответствие
//   МаксимальнаяГлубина - Число
//
// Возвращаемое значение:
//   Строка - пути "узел.вложенный=значение" через "; "
//
Функция ОписаниеСтруктурыXML(Корень, МаксимальнаяГлубина = 5) Экспорт

	Если Корень = Неопределено Тогда
		Возврат "<не прочитан>";
	КонецЕсли;

	СтрокиДерева = Новый Массив;
	СобратьУзлыXML(Корень, "", 0, МаксимальнаяГлубина, СтрокиДерева);

	Если СтрокиДерева.Количество() = 0 Тогда
		Возврат "<пусто>";
	КонецЕсли;

	Возврат СтрСоединить(СтрокиДерева, "; ");

КонецФункции

// Рекурсивно собирает пути узлов дерева XML в список строк.
//
Процедура СобратьУзлыXML(Узел, Путь, Глубина, МаксимальнаяГлубина, СтрокиДерева)

	Если Глубина > МаксимальнаяГлубина
		Или СтрокиДерева.Количество() >= 200 Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Узел) = Тип("Массив") Тогда

		Для НомерЭлемента = 0 По Узел.ВГраница() Цикл
			СобратьУзлыXML(Узел[НомерЭлемента],
				Путь + "[" + Строка(НомерЭлемента + 1) + "]",
				Глубина + 1, МаксимальнаяГлубина, СтрокиДерева);
		КонецЦикла;

		Возврат;
	КонецЕсли;

	Если ТипЗнч(Узел) <> Тип("Соответствие") Тогда
		Если ЗначениеЗаполнено(Путь) Тогда
			СтрокиДерева.Добавить(СтрШаблон("%1=%2",
				Путь, СокрЛП(СтрокойИлиПусто(Узел))));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Для Каждого КлючЗначение Из Узел Цикл

		ПутьУзла = ?(ЗначениеЗаполнено(Путь), Путь + ".", "")
			+ Строка(КлючЗначение.Ключ);
		ЗначениеКлюча = КлючЗначение.Значение;

		Если ТипЗнч(ЗначениеКлюча) = Тип("Соответствие")
			Или ТипЗнч(ЗначениеКлюча) = Тип("Массив") Тогда
			СобратьУзлыXML(ЗначениеКлюча, ПутьУзла, Глубина + 1,
				МаксимальнаяГлубина, СтрокиДерева);
		Иначе
			СтрокиДерева.Добавить(СтрШаблон("%1=%2",
				ПутьУзла, СокрЛП(СтрокойИлиПусто(ЗначениеКлюча))));
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Приводит значение к массиву.
// СБИС для узла с одним элементом отдаёт объект, а не массив из одного объекта,
// поэтому обходить такие узлы циклом напрямую нельзя.
//
// Параметры:
//   Значение - Произвольный - узел ответа
//
// Возвращаемое значение:
//   Массив
//
// Артикул строки из информационного поля ИнфПолФХЖ2: пара Идентиф/Значен, где
// в Идентиф есть слово «артикул» (Артикул, АртикулТовара, АртикулПоставщика).
//
// Возвращаемое значение:
//   Строка - пусто, если поля нет
//
Функция АртикулИзИнфПолФХЖ2(ДанныеСтроки) Экспорт

	Для Каждого Поле Из ЗначениеВМассив(ЗначениеУзла(ДанныеСтроки, "ИнфПолФХЖ2")) Цикл
		Идентификатор = НРег(СтрокойИлиПусто(ЗначениеУзла(Поле, "Идентиф", "")));
		Если СтрНайти(Идентификатор, "артикул") > 0 ИЛИ СтрНайти(Идентификатор, "article") > 0 Тогда
			Значение = СокрЛП(СтрокойИлиПусто(ЗначениеУзла(Поле, "Значен", "")));
			Если ЗначениеЗаполнено(Значение) Тогда
				Возврат Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЗначениеВМассив(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;

	РезультатФункции = Новый Массив;
	РезультатФункции.Добавить(Значение);

	Возврат РезультатФункции;

КонецФункции

// Преобразует числовое значение из ответа СБИС в число.
// Числа приходят строками, разделитель дробной части зависит от узла.
//
// Параметры:
//   Значение - Произвольный - значение из ответа
//
// Возвращаемое значение:
//   Число - 0, если значение пустое или не разбирается
//
Функция ЧислоИзСтрокиСБИС(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;

	ТекстЧисла = СокрЛП(Строка(Значение));
	ТекстЧисла = СтрЗаменить(ТекстЧисла, Символы.НПП, "");
	ТекстЧисла = СтрЗаменить(ТекстЧисла, " ", "");
	ТекстЧисла = СтрЗаменить(ТекстЧисла, ",", ".");

	Попытка
		Возврат Число(ТекстЧисла);
	Исключение
		Попытка
			Возврат Число(СтрЗаменить(ТекстЧисла, ".", ","));
		Исключение
			Возврат 0;
		КонецПопытки;
	КонецПопытки;

КонецФункции

// Создаёт HTTPS-соединение с сервером СБИС.
//
// Параметры:
//   АдресСервера - Строка - имя хоста (протокол и завершающий слэш отбрасываются)
//
// Возвращаемое значение:
//   HTTPСоединение
//
// Заготовка кеша HTTPS-соединений на время одной пачки обращений к СБИС.
//
// Общий модуль не умеет хранить состояние между вызовами, поэтому кеш ходит
// параметром. Смысл простой: догрузка товаров по сотне документов - это сотни
// запросов к одному и тому же хосту, и на каждый заново поднимался TLS.
// Соединение живёт keep-alive и переиспользуется всей пачкой.
//
// Возвращаемое значение:
//   Соответствие - Хост (Строка) → HTTPСоединение
//
Функция НовыйКешСоединенийСБИС() Экспорт

	Возврат Новый Соответствие;

КонецФункции

// Соединение с хостом: из кеша, если он передан, иначе новое.
//
// Параметры:
//   АдресСервера  - Строка
//   КешСоединений - Соответствие - см. НовыйКешСоединенийСБИС
//                 - Неопределено - не кешировать
//
// Возвращаемое значение:
//   HTTPСоединение
//
Функция СоединениеСБИС(АдресСервера, КешСоединений = Неопределено) Экспорт

	Если ТипЗнч(КешСоединений) <> Тип("Соответствие") Тогда
		Возврат СоздатьСоединениеHTTPS(АдресСервера);
	КонецЕсли;

	Ключ = НРег(СокрЛП(АдресСервера));
	Соединение = КешСоединений.Получить(Ключ);

	Если Соединение = Неопределено Тогда
		Соединение = СоздатьСоединениеHTTPS(АдресСервера);
		КешСоединений.Вставить(Ключ, Соединение);
	КонецЕсли;

	Возврат Соединение;

КонецФункции

// Выбрасывает соединение из кеша: сервер мог его закрыть, и следующий вызов
// должен подняться заново.
//
Процедура ЗабытьСоединениеСБИС(АдресСервера, КешСоединений) Экспорт

	Если ТипЗнч(КешСоединений) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	КешСоединений.Удалить(НРег(СокрЛП(АдресСервера)));

КонецПроцедуры

Функция СоздатьСоединениеHTTPS(АдресСервера) Экспорт

	Адрес = СокрЛП(АдресСервера);
	Адрес = СтрЗаменить(Адрес, "https://", "");
	Адрес = СтрЗаменить(Адрес, "http://", "");
	Если Прав(Адрес, 1) = "/" Тогда
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЕсли;

	Попытка
		// 8.3.10 и новее: 6-й параметр — Таймаут (Число),
		// 7-й — ЗащищенноеСоединение (ЗащищенноеСоединениеOpenSSL)
		Возврат Новый HTTPСоединение(Адрес, 443, , , , 60,
			Новый ЗащищенноеСоединениеOpenSSL());
	Исключение
		// Платформы до 8.3.10: 6-й параметр — признак защищённого соединения (Булево)
		Возврат Новый HTTPСоединение(Адрес, 443, , , , Истина);
	КонецПопытки;

КонецФункции

// Разбирает JSON-ответ сервера.
// Возвращает Соответствие, а не Структуру: ключи в ответах СБИС не обязаны
// быть допустимыми идентификаторами 1С, на таких ключах Структура падает.
//
// Параметры:
//   ТекстОтвета - Строка - тело ответа
//
// Возвращаемое значение:
//   Соответствие, Массив, Неопределено - разобранный ответ
//
Функция ПрочитатьОтветJSON(ТекстОтвета) Экспорт

	Если Не ЗначениеЗаполнено(ТекстОтвета) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстОтвета);
		Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		Результат = Неопределено;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает значение свойства разобранного JSON.
// Понимает и Соответствие, и Структуру, безопасен к Неопределено и Null.
//
// Параметры:
//   Узел                - Соответствие, Структура, Неопределено - узел ответа
//   ИмяСвойства         - Строка - имя ключа
//   ЗначениеПоУмолчанию - Произвольный - что вернуть, если ключа нет
//
// Возвращаемое значение:
//   Произвольный
//
Функция ЗначениеУзла(Узел, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено) Экспорт

	Если Узел = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;
	Если ТипЗнч(Узел) = Тип("Соответствие") Тогда
		Значение = Узел.Получить(ИмяСвойства);
	ИначеЕсли ТипЗнч(Узел) = Тип("Структура") Тогда
		Узел.Свойство(ИмяСвойства, Значение);
	КонецЕсли;

	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Собирает текст ошибки из JSON-RPC ответа СБИС.
//
// Параметры:
//   ДанныеОтвета     - Соответствие, Неопределено - разобранный ответ
//   ТекстПоУмолчанию - Строка - что вернуть, если узла error нет
//
// Возвращаемое значение:
//   Строка
//
Функция ТекстОшибкиОтвета(ДанныеОтвета, ТекстПоУмолчанию = "") Экспорт

	Ошибка = ЗначениеУзла(ДанныеОтвета, "error");
	Если Ошибка = Неопределено Тогда
		Возврат ТекстПоУмолчанию;
	КонецЕсли;

	Сообщение = ЗначениеУзла(Ошибка, "message", "");
	Если ТипЗнч(Сообщение) <> Тип("Строка") Тогда
		Сообщение = "";
	КонецЕсли;

	Детали = ЗначениеУзла(Ошибка, "details", "");
	Если ТипЗнч(Детали) <> Тип("Строка") Тогда
		Детали = "";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Сообщение) И Не ЗначениеЗаполнено(Детали) Тогда
		Возврат ТекстПоУмолчанию;
	КонецЕсли;

	Если ЗначениеЗаполнено(Детали) И Детали <> Сообщение Тогда
		Возврат СокрЛП(Сообщение + " - " + Детали);
	КонецЕсли;

	Возврат СокрЛП(Сообщение);

КонецФункции

// Возвращает текст исключения с максимально доступной детализацией.
// Краткое представление съедает причину ошибки TLS, поэтому берём подробное,
// а на платформах без глобальной функции откатываемся к описанию.
//
// Параметры:
//   ИнфОбОшибке - ИнформацияОбОшибке
//
// Возвращаемое значение:
//   Строка
//
Функция ТекстИсключения(ИнфОбОшибке) Экспорт

	Попытка
		Возврат Вычислить("ПодробноеПредставлениеОшибки(ИнфОбОшибке)");
	Исключение
		Возврат ИнфОбОшибке.Описание;
	КонецПопытки;

КонецФункции

// Текст ошибки для человека: описание и первопричина, без стека вызовов.
// «Ошибка при вызове метода контекста (Прочитать): Ошибка разбора XML: ...»
//
// Параметры:
//   ИнфОбОшибке - ИнформацияОбОшибке
//
// Возвращаемое значение:
//   Строка
//
Функция КраткийТекстОшибки(ИнфОбОшибке) Экспорт

	Описание = СокрЛП(ИнфОбОшибке.Описание);

	Первопричина = "";
	Причина = ИнфОбОшибке.Причина;
	Пока Причина <> Неопределено Цикл
		Если ЗначениеЗаполнено(СокрЛП(Причина.Описание)) Тогда
			Первопричина = СокрЛП(Причина.Описание);
		КонецЕсли;
		Причина = Причина.Причина;
	КонецЦикла;

	Если ЗначениеЗаполнено(Первопричина) И Первопричина <> Описание Тогда
		Возврат Описание + ": " + Первопричина;
	КонецЕсли;

	Возврат Описание;

КонецФункции

// Записывает ошибку в журнал регистрации.
// Журнал доступен не во всех контекстах исполнения, поэтому вызов защищён:
// падение логирования не должно подменять исходную ошибку.
//
Процедура ЗаписатьОшибку(ИмяСобытия, Описание) Экспорт

	Попытка
		ЗаписьЖурналаРегистрации(
			СтрШаблон("ПодписаниеЭдо.%1", ИмяСобытия),
			УровеньЖурналаРегистрации.Ошибка, , ,
			Описание);
	Исключение
		// логирование не критично
	КонецПопытки;

КонецПроцедуры

// Дата из строки в том виде, в каком её отдаёт СБИС.
//
// В ответах встречаются "01.09.2026", "01.09.2026 14:30:00" и
// "2026-09-01T14:30:00": формат зависит от метода и от версии схемы.
// В регистрах дата должна быть датой, иначе по ней не отобрать и не
// упорядочить, поэтому разбираем все три вида.
//
// Параметры:
//   Значение - Строка, Дата - то, что пришло в узле
//
// Возвращаемое значение:
//   Дата - пустая дата, если разобрать не удалось
//
Функция ДатаИзСтрокиСБИС(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;

	ТекстДаты = СокрЛП(СтрокойИлиПусто(Значение));
	Если НЕ ЗначениеЗаполнено(ТекстДаты) Тогда
		Возврат '00010101';
	КонецЕсли;

	// День и время. СБИС пишет время через точки («13.22.05»), ISO - через
	// двоеточие и с долями секунды. Время нужно реестрам: из двух УПД с одним
	// номером корректировка берёт созданную позже
	ТекстДаты = СтрЗаменить(ТекстДаты, "T", " ");
	ЧастиЗначения = СтрРазделить(ТекстДаты, " ", Ложь);
	Если ЧастиЗначения.Количество() = 0 Тогда
		Возврат '00010101';
	КонецЕсли;

	ЧастьДаты = ЧастиЗначения[0];
	ЧастьВремени = ?(ЧастиЗначения.Количество() > 1, ЧастиЗначения[1], "");

	Если СтрНайти(ЧастьДаты, ".") > 0 Тогда
		ЭлементыДаты = СтрРазделить(ЧастьДаты, ".", Ложь);
		Если ЭлементыДаты.Количество() <> 3 Тогда
			Возврат '00010101';
		КонецЕсли;
		СтрокаДаты = ЭлементыДаты[2] + ЭлементыДаты[1] + ЭлементыДаты[0];
	ИначеЕсли СтрНайти(ЧастьДаты, "-") > 0 Тогда
		ЭлементыДаты = СтрРазделить(ЧастьДаты, "-", Ложь);
		Если ЭлементыДаты.Количество() <> 3 Тогда
			Возврат '00010101';
		КонецЕсли;
		СтрокаДаты = ЭлементыДаты[0] + ЭлементыДаты[1] + ЭлементыДаты[2];
	Иначе
		СтрокаДаты = ЧастьДаты;
	КонецЕсли;

	ВремяРеестра = ВремяРеестраИзТекста(ЧастьВремени);
	Если ЗначениеЗаполнено(ВремяРеестра) Тогда
		СтрокаДаты = СтрокаДаты + ВремяРеестра;
	КонецЕсли;

	Если СтрДлина(СтрокаДаты) <> 8 И СтрДлина(СтрокаДаты) <> 14 Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Возврат Дата(СтрокаДаты);
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// «ЧЧММСС» из текста времени СБИС или ISO. Пустая строка - времени не было.
//
Функция ВремяРеестраИзТекста(ЧастьВремени)

	Текст = СокрЛП(ЧастьВремени);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Текст = СтрЗаменить(Текст, ".", ":");
	Куски = СтрРазделить(Текст, ":", Ложь);
	Если Куски.Количество() < 2 Тогда
		Цифры = "";
		Для Позиция = 1 По СтрДлина(Текст) Цикл
			Символ = Сред(Текст, Позиция, 1);
			Если СтрНайти("0123456789", Символ) > 0 Тогда
				Цифры = Цифры + Символ;
			КонецЕсли;
		КонецЦикла;
		Возврат ?(СтрДлина(Цифры) >= 4, Лев(Цифры + "00", 6), "");
	КонецЕсли;

	Часы = Прав("00" + Лев(СокрЛП(Куски[0]), 2), 2);
	Минуты = Прав("00" + Лев(СокрЛП(Куски[1]), 2), 2);
	Секунды = "00";
	Если Куски.Количество() >= 3 Тогда
		Секунды = Прав("00" + Лев(СокрЛП(Куски[2]), 2), 2);
	КонецЕсли;

	Возврат Часы + Минуты + Секунды;

КонецФункции

// Начинает замер времени операции.
//
// Замеры пишутся, только если в настройках ЭДО заполнена «Папка для замеров»:
// в этой папке файл zamery_<операция>_<ГГГГММДД>.csv (Windows-1251, «;»),
// по строке на шаг - удобно сводить в Excel. Папка должна быть доступна
// серверу 1С (службе, а не пользователю Windows).
//
// Параметры:
//   Операция - Строка - например "ВыборУПД"
//   Ключ     - Строка - что меряем: идентификатор документа
//
// Возвращаемое значение:
//   Структура - состояние замера
//   Неопределено - замеры выключены; остальные функции его пропускают
//
Функция НачатьЗамер(Операция, Ключ = "") Экспорт

	Попытка
		Папка = ЭАрМ_НастройкиСервер.ПапкаЗамеров();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(Папка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Замер = Новый Структура;
	Замер.Вставить("Операция",  Операция);
	Замер.Вставить("Ключ",      Строка(Ключ));
	Замер.Вставить("Папка",     Папка);
	Замер.Вставить("Начало",    Сейчас);
	Замер.Вставить("Последняя", Сейчас);
	Замер.Вставить("Шаги",      Новый Массив);
	Замер.Вставить("Свойства",  Новый Массив);

	Возврат Замер;

КонецФункции

// Отмечает конец шага: время с прошлой отметки.
//
Процедура ОтметитьЗамер(Замер, ИмяШага) Экспорт

	Если Замер = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Замер.Шаги.Добавить(Новый Структура("Шаг, Мс", ИмяШага, Сейчас - Замер.Последняя));
	Замер.Последняя = Сейчас;

КонецПроцедуры

// Запоминает подробность замера: сколько строк, откуда данные и т.п.
//
Процедура ДобавитьСвойствоЗамера(Замер, Имя, Значение) Экспорт

	Если Замер = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Замер.Свойства.Добавить(СтрШаблон("%1=%2", Имя, Значение));

КонецПроцедуры

// Дописывает замер в файл: строка на шаг и строка «ИТОГО» с подробностями.
// Ошибка записи в журнал регистрации - форму и обмен она не ломает.
//
Процедура ЗаписатьЗамер(Замер) Экспорт

	Если Замер = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОтметитьЗамер(Замер, "Прочее");

	Строки = Новый Массив;
	Для Каждого Шаг Из Замер.Шаги Цикл
		Если Шаг.Шаг = "Прочее" И Шаг.Мс = 0 Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить(Новый Структура("Шаг, Мс, Подробности", Шаг.Шаг, Шаг.Мс, ""));
	КонецЦикла;
	Строки.Добавить(Новый Структура("Шаг, Мс, Подробности", "ИТОГО сервер",
		Замер.Последняя - Замер.Начало, СтрСоединить(Замер.Свойства, "; ")));

	ДописатьСтрокиЗамера(Замер.Папка, Замер.Операция, Замер.Ключ, Строки);

КонецПроцедуры

// Одна строка замера, снятого на клиенте (полное время вместе с передачей
// формы), - без НачатьЗамер.
//
Процедура ЗаписатьСтрокуЗамера(Операция, Ключ, ИмяШага, Мс, Подробности = "") Экспорт

	Попытка
		Папка = ЭАрМ_НастройкиСервер.ПапкаЗамеров();
	Исключение
		Возврат;
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(Папка) Тогда
		Возврат;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(Новый Структура("Шаг, Мс, Подробности", ИмяШага, Мс, Подробности));
	ДописатьСтрокиЗамера(Папка, Операция, Строка(Ключ), Строки);

КонецПроцедуры

Процедура ДописатьСтрокиЗамера(Папка, Операция, Ключ, Строки)

	Попытка

		КаталогЗамеров = Новый Файл(Папка);
		Если НЕ КаталогЗамеров.Существует() Тогда
			СоздатьКаталог(Папка);
		КонецЕсли;

		Разделитель = ПолучитьРазделительПути();
		ИмяФайла = СтрШаблон("zamery_%1_%2.csv", Операция, Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd"));
		Путь = ?(СтрЗаканчиваетсяНа(Папка, Разделитель), Папка, Папка + Разделитель) + ИмяФайла;

		ФайлЗамеров = Новый Файл(Путь);
		НовыйФайл = НЕ ФайлЗамеров.Существует();

		Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.ANSI, , Истина);
		Если НовыйФайл Тогда
			Запись.ЗаписатьСтроку("Дата;Время;Пользователь;Операция;Ключ;Шаг;Мс;Подробности");
		КонецЕсли;

		Дата  = Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy");
		Время = Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss");
		Пользователь = ИмяПользователя();

		Для Каждого СтрокаЗамера Из Строки Цикл
			Запись.ЗаписатьСтроку(СтрШаблон("%1;%2;%3;%4;%5;%6;%7;%8",
				Дата, Время, ПолеCSV(Пользователь), Операция, ПолеCSV(Ключ),
				ПолеCSV(СтрокаЗамера.Шаг), Формат(СтрокаЗамера.Мс, "ЧН=0; ЧГ=0"),
				ПолеCSV(СтрокаЗамера.Подробности)));
		КонецЦикла;

		Запись.Закрыть();

	Исключение
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.Замеры", УровеньЖурналаРегистрации.Предупреждение, , ,
			СтрШаблон("Замер %1 не записан в %2: %3", Операция, Папка,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

Функция ПолеCSV(Значение)

	Возврат СтрЗаменить(СтрЗаменить(Строка(Значение), ";", ","), Символы.ПС, " ");

КонецФункции

#КонецОбласти
