#Область ПрограммныйИнтерфейс

// Принимает и обрабатывает ЭТРН из УТ через внешнее соединение (COM).
// Вызывается из УТ: COMConnector.ЭАрМ_ПриемДокументовДалион.ПринятьИОбработатьЭТрН(JSON)
//
// Параметры:
//   ДанныеДокументаJSON - Строка - JSON с данными электронного документа
//
// Возвращаемое значение:
//   Булево - Истина = документ принят и обработан, Ложь = отклонён
//
Функция ПринятьИОбработатьЭТрН(ДанныеДокументаJSON) Экспорт

	ЗаписьЖурналаРегистрации("АРМ_Далион.ПриемЭТрН",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("COM: получено %1 символов", СтрДлина(ДанныеДокументаJSON)));

	Попытка
		Данные = ДесериализоватьJSON(ДанныеДокументаJSON);

		Если НЕ Данные.Свойство("ТипДокумента") Тогда
			ЗаписатьОшибку("ПринятьИОбработатьЭТрН", "Отсутствует поле ТипДокумента");
			Возврат Ложь;
		КонецЕсли;

		РезультатОбработки = ОбработатьДокумент(Данные);

		ЗаписьЖурналаРегистрации("АРМ_Далион.ПриемЭТрН",
			УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон("Результат: %1, %2", РезультатОбработки.Принято, РезультатОбработки.Комментарий));

		// Отправляем callback в УТ с результатом
		ОтправитьCallbackВУТ(Данные, РезультатОбработки);

		Возврат РезультатОбработки.Принято;

	Исключение
		ЗаписатьОшибку("ПринятьИОбработатьЭТрН",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Принимает документ через HTTP (вызывается из HTTP-сервиса).
//
// Параметры:
//   ДанныеДокумента - Структура - десериализованные данные документа
//
// Возвращаемое значение:
//   Структура - Принято (Булево), Комментарий (Строка)
//
Функция ПринятьДокументЧерезHTTP(ДанныеДокумента) Экспорт

	Попытка
		Если НЕ ДанныеДокумента.Свойство("ТипДокумента") Тогда
			Возврат Новый Структура("Принято, Комментарий", Ложь, "Отсутствует поле ТипДокумента");
		КонецЕсли;

		РезультатОбработки = ОбработатьДокумент(ДанныеДокумента);

		// Отправляем callback в УТ с результатом
		ОтправитьCallbackВУТ(ДанныеДокумента, РезультатОбработки);

		Возврат Новый Структура("Принято, Комментарий",
			РезультатОбработки.Принято, РезультатОбработки.Комментарий);

	Исключение
		ЗаписатьОшибку("ПринятьДокументЧерезHTTP",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Структура("Принято, Комментарий", Ложь, ОписаниеОшибки());
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основная логика обработки документа.
//
Функция ОбработатьДокумент(Данные)

	Результат = Новый Структура("Принято, Комментарий", Ложь, "");

	ТипДокумента = Данные.ТипДокумента;

	// Маршрутизация по типу документа
	Если ТипДокумента = "ЭТрН" ИЛИ ТипДокумента = "etrn" Тогда
		Результат = ОбработатьЭТрН(Данные);
	ИначеЕсли ТипДокумента = "УПД" ИЛИ ТипДокумента = "upd" Тогда
		Результат = ОбработатьУПД(Данные);
	Иначе
		Результат.Комментарий = СтрШаблон("Неподдерживаемый тип документа: %1", ТипДокумента);
		ЗаписатьОшибку("ОбработатьДокумент", Результат.Комментарий);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Обработка ЭТРН в базе Далион.
//
Функция ОбработатьЭТрН(Данные)

	Результат = Новый Структура("Принято, Комментарий", Ложь, "");

	// 1. Валидация обязательных полей
	Если НЕ Данные.Свойство("НомерТН") ИЛИ НЕ ЗначениеЗаполнено(Данные.НомерТН) Тогда
		Результат.Комментарий = "Не заполнен номер ТН";
		Возврат Результат;
	КонецЕсли;

	// 2. Поиск существующего документа в Далион
	СуществующийДокумент = НайтиЭТрНВДалион(Данные);
	Если СуществующийДокумент <> Неопределено Тогда
		Результат.Принято = Истина;
		Результат.Комментарий = СтрШаблон("ЭТРН %1 от %2 найдена в базе",
			Данные.НомерТН, Данные.ДатаТН);
		Возврат Результат;
	КонецЕсли;

	// 3. Валидация данных (проверка контрагентов, организации и т.д.)
	Если НЕ ВалидироватьДанныеЭТрН(Данные) Тогда
		Результат.Комментарий = "Валидация не пройдена";
		Возврат Результат;
	КонецЕсли;

	// 4. Документ принят
	Результат.Принято = Истина;
	Результат.Комментарий = СтрШаблон("ЭТРН %1 от %2 принята к обработке",
		Данные.НомерТН, Данные.ДатаТН);

	Возврат Результат;

КонецФункции

// Обработка УПД в базе Далион.
