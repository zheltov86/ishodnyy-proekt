// Отправляет callback в УТ с результатом обработки.
//
Процедура ОтправитьCallbackВУТ(Данные, РезультатОбработки)

	Если НЕ Данные.Свойство("ИдентификаторЗапроса") Тогда
		Возврат;
	КонецЕсли;

	Попытка
		// Формируем JSON для callback
		ДанныеCallback = Новый Структура;
		ДанныеCallback.Вставить("requestId", Данные.ИдентификаторЗапроса);
		ДанныеCallback.Вставить("approved", РезультатОбработки.Принято);
		ДанныеCallback.Вставить("comment", РезультатОбработки.Комментарий);

		ТелоЗапроса = СериализоватьJSON(ДанныеCallback);

		// Отправляем HTTP POST в УТ на /edoconfirm/confirm
		АдресУТ = ПолучитьАдресУТ();
		Если НЕ ЗначениеЗаполнено(АдресУТ) Тогда
			ЗаписатьОшибку("ОтправитьCallbackВУТ", "Не настроен адрес УТ");
			Возврат;
		КонецЕсли;

		HTTPЗапрос = Новый HTTPЗапрос("/edoconfirm/confirm");
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);

		Соединение = Новый HTTPСоединение(АдресУТ, , , , , 60);
		Ответ = Соединение.ОтправитьДляОбработки(HTTPЗапрос);

		Если Ответ.КодСостояния <> 200 Тогда
			ЗаписатьОшибку("ОтправитьCallbackВУТ",
				СтрШаблон("Код ответа УТ: %1", Ответ.КодСостояния));
		КонецЕсли;

	Исключение
		ЗаписатьОшибку("ОтправитьCallbackВУТ",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

