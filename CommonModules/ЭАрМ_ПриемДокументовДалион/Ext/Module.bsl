// ============================================================================
// ПОЛУЧЕНИЕ РЕЗУЛЬТАТОВ ИЗ ДАЛИОН ЧЕРЕЗ FTP
// ============================================================================

// Сканирует FTP-папку на наличие result-файлов от ДАЛИОН.
// Читает каждый файл, обрабатывает результат, перемещает в архив.
//
// Возвращаемое значение:
//   Структура - Обработано (Число), Ошибки (Массив)
//
Функция ПолучитьРезультатыИзДалионаЧерезFTP() Экспорт

	Результат = Новый Структура("Обработано, Ошибки", 0, Новый Массив);

	НастройкиFTP = ЭАрМ_ОбменСДругойБазой.ПолучитьНастройкиFTP();

	Попытка
		Соединение = ЭАрМ_Служебный.СоздатьСоединениеFTP(НастройкиFTP);
	Исключение
		Результат.Ошибки.Добавить(СтрШаблон("Ошибка подключения к FTP: %1",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Результат;
	КонецПопытки;

	// Каталог результатов (от ДАЛИОН → в База1). Имя подкаталога задаётся
	// настройкой FTP_КаталогОтветов, здесь оно раньше было прошито строкой
	Каталоги = ЭАрМ_НастройкиСервер.КаталогиОбменаFTP();
	КаталогРезультатов = Каталоги.Ответы;

	Попытка
		ЭАрМ_Служебный.ОбеспечитьКаталогFTP(Соединение, КаталогРезультатов);
	Исключение
		Результат.Ошибки.Добавить(СтрШаблон("Каталог %1 недоступен: %2",
			КаталогРезультатов,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Результат;
	КонецПопытки;

	// Получаем список файлов
	Попытка
		ФайлыНаСервере = Соединение.НайтиФайлы(КаталогРезультатов, "result_*.json");
	Исключение
		Результат.Ошибки.Добавить(СтрШаблон("Ошибка чтения FTP: %1",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Результат;
	КонецПопытки;

	// Архив
	КаталогАрхива = Каталоги.АрхивОтветов;
	Попытка
		ЭАрМ_Служебный.ОбеспечитьКаталогFTP(Соединение, КаталогАрхива);
	Исключение
		// Без архива результаты всё равно разбираются, но каждый следующий
		// проход будет читать их заново - об этом должно остаться сообщение
		Результат.Ошибки.Добавить(СтрШаблон("Каталог архива %1 недоступен: %2",
			КаталогАрхива,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	Для Каждого Файл Из ФайлыНаСервере Цикл

		Попытка
			// Читаем файл
			ВременныйФайл = ПолучитьИмяВременногоФайла("json");
			Соединение.Получить(Файл.ПолноеИмя, ВременныйФайл);

			ЧтениеТекста = Новый ЧтениеТекста(ВременныйФайл, КодировкаТекста.UTF8);
			Содержимое = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();
			УдалитьФайлы(ВременныйФайл);

			// Парсим JSON
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Содержимое);
			ДанныеРезультата = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();

			// Обрабатываем результат
			ОбработатьРезультатИзДалиона(ДанныеРезультата);

			// Перемещаем в архив
			Соединение.Переместить(Файл.ПолноеИмя, КаталогАрхива + "/" + Файл.Имя);

			Результат.Обработано = Результат.Обработано + 1;

		Исключение
			Результат.Ошибки.Добавить(СтрШаблон("Ошибка обработки %1: %2",
				Файл.Имя, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Обрабатывает результат обработки документа из ДАЛИОН.
//
// Параметры:
//   ДанныеРезультата - Структура (распарсенный JSON)
//
Процедура ОбработатьРезультатИзДалиона(ДанныеРезультата)

	ИдентификаторЗапроса = "";
	ДанныеРезультата.Свойство("requestId", ИдентификаторЗапроса);

	Если НЕ ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		ЗаписатьОшибку("ОбработатьРезультатИзДалиона", "Отсутствует requestId");
		Возврат;
	КонецЕсли;

	// Ищем входящий ЭД по идентификатору
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭДВходящий.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЭлектронныйДокументВходящийЭДО КАК ЭДВходящий
	|ГДЕ
	|	ЭДВходящий.ИдентификаторДокументооборота = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторЗапроса);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		ЗаписатьОшибку("ОбработатьРезультатИзДалиона",
			СтрШаблон("Не найден ЭД с идентификатором %1", ИдентификаторЗапроса));
		Возврат;
	КонецЕсли;

	Выборка = Результат.Выбрать();
	Выборка.Следующий();

	// Обновляем статус в регистре
	Набор = РегистрыСведений.СостоянияПоОбъектамУчетаЭДО.СоздатьНаборЗаписей();
	Набор.Отбор.ОбъектУчета.Установить(Выборка.Ссылка);
	Набор.Прочитать();

	Если Набор.Количество() > 0 Тогда
		Запись = Набор[0];
	Иначе
		Запись = Набор.Добавить();
		Запись.ОбъектУчета = Выборка.Ссылка;
	КонецЕсли;

	Запись.Состояние = "ОбработаноДалион";
	Запись.ДатаОбработки = ТекущаяДатаСеанса();
	Запись.Комментарий = ДанныеРезультата.Представление;

	Набор.Записать(Истина);

КонецПроцедуры

#КонецОбласти
