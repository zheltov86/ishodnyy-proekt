// Алкоголь в строках УПД и ЭТрН: признаки алкоголя, вид продукции ЕГАИС,
// заполнение номенклатуры УТ и сопоставление с классификатором ЕГАИС.
//
// Признаки, от надёжного к слабому:
//   марка ЕГАИС в кодах маркировки строки (68/150 знаков)       - точно
//   алкокод в ИнфПолФХЖ2 строки (19 цифр) - найден в классификаторе - точно
//   ТН ВЭД 2203-2208 (ДопСведТов/КодВидТов)                      - точно
//   слова наименования (водка, вино, пиво...) - только подсказка, сам по себе
//   признак номенклатуру не создаёт
//
// Вид продукции ЕГАИС. УТ держит классификатор видов в регистре
// ВидыАлкогольнойПродукцииЕГАИС и получает его из сервиса классификаторов 1С -
// без подписки регистр пустой. Здесь классификатор заполняется статично
// (ЗаполнитьКлассификаторВидов): копия макета УТ Обработка.КлассификаторыЕГАИС -
// справочник видов и кодов вида продукции ФС РАР, 308 видов. Новые виды 2026 года
// (самогон, хреновуха, сбитень, российский виски) в макете ещё нет - их коды
// добавляются в ДанныеКлассификатораВидовТекст по справочнику ФС РАР.
//
// Номенклатура заполняется типовой НоменклатураЛокализация.ЗаполнитьПоПараметрамСоздания
// (та же, что создаёт номенклатуру из ТТН ЕГАИС): вид номенклатуры подбирается по
// особенности учёта (алкогольная продукция / пиво), вид продукции, объём,
// крепость, импортёр. Флаги алкоголя УТ берёт из вида номенклатуры - напрямую
// модуль их не ставит.

#Область ПрограммныйИнтерфейс

// Признаки алкоголя строки товара УПД или ЭТрН.
//
// Параметры:
//   СтрокаТовара - Структура, СтрокаТаблицыЗначений, ЗаписьРегистраСведений - берутся
//                  поля Наименование, Маркировки, КодТНВЭД, Алкокод, СырыеДанные
//                  (строка УПД из ЭАрМ_Служебный), любое может отсутствовать
//
// Возвращаемое значение:
//   Структура - см. НовыеСведенияАлкоголя
//
Функция СведенияАлкоголя(СтрокаТовара) Экспорт

	Сведения = НовыеСведенияАлкоголя();

	Наименование = СтрокойИлиПусто(ЗначениеПоля(СтрокаТовара, "Наименование"));
	СырыеДанные  = ЗначениеПоля(СтрокаТовара, "СырыеДанные");

	// Марки ЕГАИС - алкоголь с акцизной или федеральной маркой
	Марки = ЭАрМ_КодыМаркировки.МаркиПоВидам(ЗначениеПоля(СтрокаТовара, "Маркировки", ""));
	Если Марки.ЕГАИС.Количество() > 0 Тогда
		Сведения.МаркиЕГАИС = Марки.ЕГАИС;
		ОтметитьАлкоголь(Сведения, Истина, СтрШаблон("марки ЕГАИС: %1", Марки.ЕГАИС.Количество()));
		Сведения.Маркируемый = Истина;
	КонецЕсли;

	// Алкокод - код продукции в классификаторе ЕГАИС
	Алкокод = ТолькоЦифры(ЗначениеПоля(СтрокаТовара, "Алкокод", ""));
	Если СтрДлина(Алкокод) <> ДлинаАлкокода() Тогда
		Алкокод = АлкокодИзДанных(СырыеДанные, 0);
	КонецЕсли;
	Если ЗначениеЗаполнено(Алкокод) Тогда
		Сведения.Алкокод = Алкокод;
		АлкогольнаяПродукция = АлкогольнаяПродукцияПоАлкокоду(Алкокод);
		Если ЗначениеЗаполнено(АлкогольнаяПродукция) Тогда
			Сведения.АлкогольнаяПродукция = АлкогольнаяПродукция;
			ЗаполнитьПоКлассификатору(Сведения, АлкогольнаяПродукция);
			ОтметитьАлкоголь(Сведения, Истина, "алкокод " + Алкокод + " есть в классификаторе ЕГАИС");
		Иначе
			ОтметитьАлкоголь(Сведения, Истина, "алкокод " + Алкокод + " (в классификаторе ЕГАИС УТ нет - запросить в УТМ)");
		КонецЕсли;
	КонецЕсли;

	// ТН ВЭД 2203-2208: пиво, вино, вермут, сидр и прочие, спирт, крепкие
	КодТНВЭД = ТолькоЦифры(ЗначениеПоля(СтрокаТовара, "КодТНВЭД", ""));
	Если НЕ ЗначениеЗаполнено(КодТНВЭД) Тогда
		КодТНВЭД = ТолькоЦифры(ЗначениеКлючаВДанных(СырыеДанные, "КодВидТов", 0));
	КонецЕсли;
	Сведения.КодТНВЭД = КодТНВЭД;
	Если ЭтоАлкогольныйТНВЭД(КодТНВЭД) Тогда
		ОтметитьАлкоголь(Сведения, Истина, "ТН ВЭД " + КодТНВЭД);
	КонецЕсли;

	// Наименование: крепость, объём и вид по словам
	Числа = ЧислаНаименования(Наименование);
	Если Сведения.Крепость = 0 Тогда
		Сведения.Крепость = Числа.Крепость;
	КонецЕсли;
	Если Сведения.ОбъемЛитров = 0 Тогда
		Сведения.ОбъемЛитров = Числа.ОбъемЛитров;
	КонецЕсли;

	КодПоСловам = "";
	СловоИсключение = НеАлкогольПоНаименованию(Наименование, Числа);
	Если НЕ ЗначениеЗаполнено(СловоИсключение) Тогда
		ВидПоСловам = ВидПоНаименованию(Наименование, Числа.ЕстьПроцент);
		Если ВидПоСловам <> Неопределено Тогда
			КодПоСловам = ВидПоСловам.Код;
			ОтметитьАлкоголь(Сведения, Ложь, "в наименовании «" + ВидПоСловам.Слово + "»");
		КонецЕсли;
	ИначеЕсли Сведения.Алкоголь Тогда
		Сведения.Причины.Добавить("в наименовании «" + СловоИсключение + "» - проверить");
	КонецЕсли;

	Если НЕ Сведения.Алкоголь Тогда
		Возврат Сведения;
	КонецЕсли;

	// Вид продукции: классификатор ЕГАИС -> слова наименования -> ТН ВЭД
	Если НЕ ЗначениеЗаполнено(Сведения.КодВида) Тогда
		Сведения.КодВида = КодПоСловам;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Сведения.КодВида) Тогда
		Сведения.КодВида = ВидПоТНВЭД(КодТНВЭД);
	КонецЕсли;
	Если Сведения.КодВида = "500" И Сведения.Крепость > 8.6 Тогда
		Сведения.КодВида = "510";
	КонецЕсли;

	Вид = ДанныеВидаПоКоду(Сведения.КодВида);
	Если Вид <> Неопределено Тогда
		Сведения.НаименованиеВида = Вид.Наименование;
		Сведения.Маркируемый = Сведения.Маркируемый ИЛИ Вид.Маркируемый;
	КонецЕсли;
	Сведения.Пиво = ЭтоПиво(Сведения.КодВида, КодТНВЭД);

	Возврат Сведения;

КонецФункции

// Пустые сведения об алкоголе.
//
// Возвращаемое значение:
//   Структура:
//     * Алкоголь             - Булево - есть хоть один признак
//     * Точно                - Булево - признак надёжный (марка, алкокод, ТН ВЭД), а не только слова
//     * Причины              - Массив из Строка - откуда вывод
//     * КодВида              - Строка - код вида продукции ЕГАИС (200, 500, 4011...)
//     * НаименованиеВида     - Строка
//     * Маркируемый          - Булево - вид маркируется марками ЕГАИС
//     * Пиво                 - Булево - пиво и пивные напитки: в УТ особенность учёта «Пиво»
//     * Крепость             - Число - % об.
//     * ОбъемЛитров          - Число - объём единицы, литров
//     * Алкокод              - Строка
//     * АлкогольнаяПродукция - СправочникСсылка.КлассификаторАлкогольнойПродукцииЕГАИС, Неопределено
//     * МаркиЕГАИС           - Массив из Строка
//     * КодТНВЭД             - Строка
//
Функция НовыеСведенияАлкоголя() Экспорт

	Сведения = Новый Структура;
	Сведения.Вставить("Алкоголь",             Ложь);
	Сведения.Вставить("Точно",                Ложь);
	Сведения.Вставить("Причины",              Новый Массив);
	Сведения.Вставить("КодВида",              "");
	Сведения.Вставить("НаименованиеВида",     "");
	Сведения.Вставить("Маркируемый",          Ложь);
	Сведения.Вставить("Пиво",                 Ложь);
	Сведения.Вставить("Крепость",             0);
	Сведения.Вставить("ОбъемЛитров",          0);
	Сведения.Вставить("Алкокод",              "");
	Сведения.Вставить("АлкогольнаяПродукция", Неопределено);
	Сведения.Вставить("МаркиЕГАИС",           Новый Массив);
	Сведения.Вставить("КодТНВЭД",             "");
	Возврат Сведения;

КонецФункции

// Сведения об алкоголе одной строкой - для колонки формы и журнала.
//
// Параметры:
//   Сведения - Структура - см. НовыеСведенияАлкоголя
//
// Возвращаемое значение:
//   Строка
//
Функция ПредставлениеСведений(Сведения) Экспорт

	Если НЕ Сведения.Алкоголь Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(?(Сведения.Точно, "Алкоголь", "Возможно алкоголь"));
	Если ЗначениеЗаполнено(Сведения.КодВида) Тогда
		Части.Добавить(Сведения.КодВида + " " + Сведения.НаименованиеВида);
	КонецЕсли;
	Если Сведения.Крепость > 0 Тогда
		Части.Добавить(Формат(Сведения.Крепость, "ЧДЦ=1; ЧГ=0") + "%");
	КонецЕсли;
	Если Сведения.ОбъемЛитров > 0 Тогда
		Части.Добавить(Формат(Сведения.ОбъемЛитров, "ЧДЦ=3; ЧГ=0") + " л");
	КонецЕсли;
	Части.Добавить("(" + СтрСоединить(Сведения.Причины, "; ") + ")");

	Возврат СтрСоединить(Части, ", ");

КонецФункции

#КонецОбласти

#Область КлассификаторВидов

// Заполняет регистр УТ ВидыАлкогольнойПродукцииЕГАИС статичными данными модуля.
// Записи, пришедшие из сервиса классификаторов 1С, по умолчанию не трогаются:
// в них есть ТН ВЭД и вид подакцизного товара, которых в статике нет.
//
// Параметры:
//   Перезаписывать - Булево - перезаписать и существующие записи
//
// Возвращаемое значение:
//   Структура - Добавлено, Обновлено, Пропущено (Число)
//
Функция ЗаполнитьКлассификаторВидов(Перезаписывать = Ложь) Экспорт

	Итог = Новый Структура("Добавлено, Обновлено, Пропущено", 0, 0, 0);
	Виды = ДанныеКлассификатораВидов();

	// Классификатор общий для всей базы - писать его в привилегированном режиме
	// разрешено только тому, у кого есть право менять его и без расширения
	Если НЕ ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ВидыАлкогольнойПродукцииЕГАИС)
		И НЕ Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для заполнения классификатора видов алкогольной продукции ЕГАИС'");
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("РегистрСведений.ВидыАлкогольнойПродукцииЕГАИС");
		Блокировка.Заблокировать();

		Для Каждого Вид Из Виды Цикл

			Менеджер = РегистрыСведений.ВидыАлкогольнойПродукцииЕГАИС.СоздатьМенеджерЗаписи();
			Менеджер.Код = Вид.Код;
			Менеджер.Прочитать();
			Новая = НЕ Менеджер.Выбран();

			Если НЕ Новая И НЕ Перезаписывать Тогда
				Итог.Пропущено = Итог.Пропущено + 1;
				Продолжить;
			КонецЕсли;

			Менеджер.Код             = Вид.Код;
			Менеджер.Наименование    = Вид.Наименование;
			Менеджер.ОКПД2           = Вид.ОКПД2;
			Менеджер.ГруппаПродукции = Вид.ГруппаПродукции;
			Менеджер.Маркируемый     = Вид.Маркируемый;
			Менеджер.ВидЛицензии     = Вид.ВидЛицензии;
			// Вид подакцизного товара статика знает не для всех видов -
			// заполненное сервисом не затираем
			Если ЗначениеЗаполнено(Вид.ВидПодакцизногоТовара) Тогда
				Менеджер.ВидПодакцизногоТовара = Вид.ВидПодакцизногоТовара;
			КонецЕсли;
			Менеджер.Записать();

			Если Новая Тогда
				Итог.Добавлено = Итог.Добавлено + 1;
			Иначе
				Итог.Обновлено = Итог.Обновлено + 1;
			КонецЕсли;

		КонецЦикла;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("ЭАрМ.АлкогольЕГАИС", УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Вид продукции ЕГАИС из статичного классификатора.
//
// Параметры:
//   КодВида - Строка
//
// Возвращаемое значение:
//   СтрокаТаблицыЗначений, Неопределено - колонки см. ДанныеКлассификатораВидов
//
Функция ДанныеВидаПоКоду(КодВида) Экспорт

	Если НЕ ЗначениеЗаполнено(КодВида) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДанныеКлассификатораВидов().Найти(СокрЛП(КодВида), "Код");

КонецФункции

// Элемент справочника УТ ВидыАлкогольнойПродукции по коду вида. УТ создаёт
// элементы по мере надобности (при загрузке продукции ЕГАИС) - так же и здесь.
//
// Параметры:
//   КодВида   - Строка - код вида продукции ЕГАИС
//   Создавать - Булево - создать элемент, если его нет, по статичному классификатору
//
// Возвращаемое значение:
//   СправочникСсылка.ВидыАлкогольнойПродукции - пустая, если кода нет в классификаторе
//
Функция ВидАлкогольнойПродукции(КодВида, Создавать = Истина) Экспорт

	Код = СокрЛП(КодВида);
	Если НЕ ЗначениеЗаполнено(Код) Тогда
		Возврат Справочники.ВидыАлкогольнойПродукции.ПустаяСсылка();
	КонецЕсли;

	Ссылка = Справочники.ВидыАлкогольнойПродукции.НайтиПоКоду(Код);
	Если ЗначениеЗаполнено(Ссылка) ИЛИ НЕ Создавать Тогда
		Возврат Ссылка;
	КонецЕсли;

	Вид = ДанныеВидаПоКоду(Код);
	Если Вид = Неопределено Тогда
		Возврат Справочники.ВидыАлкогольнойПродукции.ПустаяСсылка();
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Объект = Справочники.ВидыАлкогольнойПродукции.СоздатьЭлемент();
	Объект.Код                   = Вид.Код;
	Объект.Наименование          = Вид.Наименование;
	Объект.Маркируемый           = Вид.Маркируемый;
	Объект.ВидЛицензии           = Вид.ВидЛицензии;
	Объект.ВидПодакцизногоТовара = Вид.ВидПодакцизногоТовара;
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

// Позиция классификатора алкогольной продукции ЕГАИС по алкокоду. Классификатор
// наполняет УТ (ТТН ЕГАИС, запрос в УТМ) - статично его не заполнить.
//
// Параметры:
//   Алкокод - Строка
//
// Возвращаемое значение:
//   СправочникСсылка.КлассификаторАлкогольнойПродукцииЕГАИС - пустая, если не нашлась
//
Функция АлкогольнаяПродукцияПоАлкокоду(Алкокод) Экспорт

	Код = ТолькоЦифры(Алкокод);
	Если НЕ ЗначениеЗаполнено(Код) Тогда
		Возврат Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка();
	КонецЕсли;
	Возврат Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.НайтиПоКоду(Код);

КонецФункции

#КонецОбласти

#Область Номенклатура

// Параметры создания номенклатуры в том виде, в каком их ждёт типовая
// НоменклатураЛокализация.ЗаполнитьПоПараметрамСоздания (ветка ЕГАИС).
//
// Параметры:
//   Сведения     - Структура - см. НовыеСведенияАлкоголя
//   Наименование - Строка - наименование из УПД
//
// Возвращаемое значение:
//   Структура
//
Функция ПараметрыСозданияНоменклатуры(Сведения, Наименование = "") Экспорт

	Параметры = Новый Структура;
	// Наименование и НаименованиеПолное типовая процедура переписывает в
	// параметрах - ключи должны быть
	Параметры.Вставить("Наименование",       Наименование);
	Параметры.Вставить("НаименованиеПолное", Наименование);

	Параметры.Вставить("ВидАлкогольнойПродукцииЕГАИС", ВидАлкогольнойПродукции(Сведения.КодВида));
	Параметры.Вставить("МаркируемаяПродукцияЕГАИС",    Сведения.Маркируемый);
	Параметры.Вставить("НаименованиеНоменклатурыЕГАИС",       "");
	Параметры.Вставить("ПолноеНаименованиеНоменклатурыЕГАИС", "");
	Параметры.Вставить("ОбъемЕГАИС",    Сведения.ОбъемЛитров);
	Параметры.Вставить("КрепостьЕГАИС", Сведения.Крепость);
	// ИмпортерЕГАИС нужен и пустым: типовая проверяет производителя через его наличие
	Параметры.Вставить("ИмпортерЕГАИС",      Справочники.КлассификаторОрганизацийЕГАИС.ПустаяСсылка());
	Параметры.Вставить("ПроизводительЕГАИС", Справочники.КлассификаторОрганизацийЕГАИС.ПустаяСсылка());

	Если ЗначениеЗаполнено(Сведения.АлкогольнаяПродукция) Тогда
		Классификатор = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Сведения.АлкогольнаяПродукция,
			"Наименование, НаименованиеПолное, Производитель, Импортер");
		Параметры.НаименованиеНоменклатурыЕГАИС       = Классификатор.Наименование;
		Параметры.ПолноеНаименованиеНоменклатурыЕГАИС = Классификатор.НаименованиеПолное;
		Параметры.ПроизводительЕГАИС = Классификатор.Производитель;
		Параметры.ИмпортерЕГАИС      = Классификатор.Импортер;
	КонецЕсли;

	Возврат Параметры;

КонецФункции

// Заполняет алкогольные реквизиты номенклатуры УТ. Не записывает. Уже
// заполненные реквизиты и вид номенклатуры существующего элемента не меняются.
//
// Параметры:
//   НоменклатураОбъект - СправочникОбъект.Номенклатура
//   Сведения           - Структура - см. НовыеСведенияАлкоголя
//
// Возвращаемое значение:
//   Массив из Строка - чего не хватает для ЕГАИС (см. ЗамечанияПоНоменклатуре)
//
Функция ЗаполнитьНоменклатуру(НоменклатураОбъект, Сведения) Экспорт

	Если НЕ Сведения.Алкоголь Тогда
		Возврат Новый Массив;
	КонецЕсли;

	ВидБыл = НоменклатураОбъект.ВидНоменклатуры;

	Параметры = ПараметрыСозданияНоменклатуры(Сведения, НоменклатураОбъект.Наименование);
	НоменклатураЛокализация.ЗаполнитьПоПараметрамСоздания(НоменклатураОбъект,
		Новый ФиксированнаяСтруктура(Параметры));

	// Типовой подбор не ставит вид, если подходящих несколько - тогда вид из
	// настроек ЕГАИС
	Если НЕ ЗначениеЗаполнено(НоменклатураОбъект.ВидНоменклатуры) Тогда
		НоменклатураОбъект.ВидНоменклатуры = ВидНоменклатурыИзНастроек(Сведения.Пиво);
	КонецЕсли;

	// Вид номенклатуры подобран - реквизиты по виду (особенность учёта,
	// флаги алкоголя, единица, НДС) берём из него
	Если НЕ ЗначениеЗаполнено(ВидБыл) И ЗначениеЗаполнено(НоменклатураОбъект.ВидНоменклатуры) Тогда
		Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(НоменклатураОбъект);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(НоменклатураОбъект.ВидАлкогольнойПродукции) Тогда
		НоменклатураОбъект.ВидАлкогольнойПродукции = Параметры.ВидАлкогольнойПродукцииЕГАИС;
	КонецЕсли;
	// Подакцизный - только если вид номенклатуры действительно алкогольный
	Если ОсобенностиУчетаАлкоголя().Найти(НоменклатураОбъект.ОсобенностьУчета) <> Неопределено Тогда
		НоменклатураОбъект.ПодакцизныйТовар = Истина;
	КонецЕсли;

	Возврат ЗамечанияПоНоменклатуре(НоменклатураОбъект);

КонецФункции

// Чего не хватает номенклатуре для приёмки алкоголя по ЕГАИС.
//
// Параметры:
//   Номенклатура - СправочникСсылка.Номенклатура, СправочникОбъект.Номенклатура
//
// Возвращаемое значение:
//   Массив из Строка - пустой, если всё заполнено
//
Функция ЗамечанияПоНоменклатуре(Номенклатура) Экспорт

	Замечания = Новый Массив;

	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Замечания.Добавить("номенклатура не выбрана");
			Возврат Замечания;
		КонецЕсли;
		Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура,
			"ВидНоменклатуры, ОсобенностьУчета, ВидАлкогольнойПродукции, Крепость, ОбъемДАЛ,
			|ИмпортнаяАлкогольнаяПродукция, ПроизводительИмпортерКонтрагент, ПодакцизныйТовар");
		Ссылка = Номенклатура;
	Иначе
		Данные = Номенклатура;
		Ссылка = Номенклатура.Ссылка;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Данные.ВидНоменклатуры) Тогда
		Замечания.Добавить("не подобран вид номенклатуры: нужен вид с особенностью учёта «Алкогольная продукция» или «Пиво»");
	ИначеЕсли ОсобенностиУчетаАлкоголя().Найти(Данные.ОсобенностьУчета) = Неопределено Тогда
		Замечания.Добавить("у вида номенклатуры особенность учёта «" + Данные.ОсобенностьУчета
			+ "» - для ЕГАИС нужна «Алкогольная продукция» или «Пиво»");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Данные.ВидАлкогольнойПродукции) Тогда
		Замечания.Добавить("не указан вид алкогольной продукции");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Данные.Крепость) Тогда
		Замечания.Добавить("не указана крепость");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Данные.ОбъемДАЛ) Тогда
		Замечания.Добавить("не указан объём (дал)");
	КонецЕсли;
	Если Данные.ИмпортнаяАлкогольнаяПродукция
		И НЕ ЗначениеЗаполнено(Данные.ПроизводительИмпортерКонтрагент) Тогда
		Замечания.Добавить("импортная продукция без импортёра");
	КонецЕсли;
	Если НЕ Данные.ПодакцизныйТовар Тогда
		Замечания.Добавить("не отмечен подакцизный товар");
	КонецЕсли;

	Если ЗначениеЗаполнено(Ссылка) И НЕ ЕстьСоответствиеЕГАИС(Ссылка) Тогда
		Замечания.Добавить("нет сопоставления с классификатором ЕГАИС (алкокодом)");
	КонецЕсли;

	Возврат Замечания;

КонецФункции

// Сопоставляет номенклатуру УТ с продукцией ЕГАИС - запись регистра
// СоответствиеНоменклатурыЕГАИС так же, как её пишет УТ (без характеристики,
// серии, упаковки и справки 2). Чужое сопоставление алкокода не перебивается.
//
// Параметры:
//   Номенклатура         - СправочникСсылка.Номенклатура
//   АлкогольнаяПродукция - СправочникСсылка.КлассификаторАлкогольнойПродукцииЕГАИС
//
// Возвращаемое значение:
//   Строка - пусто, если записано или уже было; иначе почему не записано
//
Функция ЗаписатьСоответствиеЕГАИС(Номенклатура, АлкогольнаяПродукция) Экспорт

	Если НЕ ЗначениеЗаполнено(Номенклатура) ИЛИ НЕ ЗначениеЗаполнено(АлкогольнаяПродукция) Тогда
		Возврат "не заданы номенклатура или продукция ЕГАИС";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Соответствие.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК Соответствие
	|ГДЕ
	|	Соответствие.АлкогольнаяПродукция = &АлкогольнаяПродукция
	|	И Соответствие.Номенклатура <> &Номенклатура";
	Запрос.УстановитьПараметр("АлкогольнаяПродукция", АлкогольнаяПродукция);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СтрШаблон("продукция ЕГАИС «%1» уже сопоставлена с «%2»",
			АлкогольнаяПродукция, Выборка.Номенклатура);
	КонецЕсли;

	ПустаяХарактеристика = ОбщегоНазначенияИС.ПустоеЗначениеОпределяемогоТипа("ХарактеристикаНоменклатуры");
	ПустаяСерия          = ОбщегоНазначенияИС.ПустоеЗначениеОпределяемогоТипа("СерияНоменклатуры");

	Набор = РегистрыСведений.СоответствиеНоменклатурыЕГАИС.СоздатьНаборЗаписей();
	Набор.Отбор.Номенклатура.Установить(Номенклатура);
	Набор.Отбор.Характеристика.Установить(ПустаяХарактеристика);
	Набор.Отбор.Серия.Установить(ПустаяСерия);
	Набор.Отбор.АлкогольнаяПродукция.Установить(АлкогольнаяПродукция);
	Набор.Отбор.ИдентификаторУпаковки.Установить("");
	Набор.Отбор.Справка2.Установить(Справочники.Справки2ЕГАИС.ПустаяСсылка());
	Набор.Прочитать();
	Если Набор.Количество() > 0 Тогда
		Возврат "";
	КонецЕсли;

	Запись = Набор.Добавить();
	Запись.Номенклатура         = Номенклатура;
	Запись.Характеристика       = ПустаяХарактеристика;
	Запись.Серия                = ПустаяСерия;
	Запись.АлкогольнаяПродукция = АлкогольнаяПродукция;
	Запись.ИдентификаторУпаковки = "";
	Запись.Справка2             = Справочники.Справки2ЕГАИС.ПустаяСсылка();

	ПараметрыУказанияСерий = ИнтеграцияИС.ПараметрыУказанияСерийФормыОбъекта(Запись,
		РегистрыСведений.СоответствиеНоменклатурыЕГАИС);
	ИнтеграцияИСПереопределяемый.ЗаполнитьСтатусыУказанияСерий(Запись, ПараметрыУказанияСерий);
	// Заполнение статуса может сбросить серию - как в ИнтеграцияЕГАИС
	Запись.Серия = ПустаяСерия;

	Попытка
		Набор.Записать();
	Исключение
		Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ЭАрМ.АлкогольЕГАИС", УровеньЖурналаРегистрации.Ошибка,,
			Номенклатура, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Текст;
	КонецПопытки;

	Возврат "";

КонецФункции


// Сопоставляет номенклатуру с продукцией ЕГАИС по алкокоду, который пришёл в
// строке УПД с этим штрихкодом (признак «Алкоголь» строки хранит «алкокод N»).
// Работает, только если включена настройка ЕГАИС_ЗаписыватьСоответствие.
//
// Параметры:
//   Номенклатура - СправочникСсылка.Номенклатура
//   Штрихкод     - Строка
//
// Возвращаемое значение:
//   Строка - пусто, если сопоставлено или сопоставлять нечего; иначе причина
//
Функция СопоставитьСЕГАИСПоШтрихкоду(Номенклатура, Штрихкод) Экспорт

	Если НЕ НастройкаБулево("ЕГАИС_ЗаписыватьСоответствие", Истина)
		ИЛИ НЕ ЗначениеЗаполнено(Номенклатура) ИЛИ НЕ ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат "";
	КонецЕсли;

	Код = ТолькоЦифры(Штрихкод);
	Варианты = Новый Массив;
	Варианты.Добавить(Код);
	Если СтрДлина(Код) = 13 Тогда
		Варианты.Добавить("0" + Код);
	ИначеЕсли СтрДлина(Код) = 14 И СтрНачинаетсяС(Код, "0") Тогда
		Варианты.Добавить(Сред(Код, 2));
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Товары.Алкоголь КАК Алкоголь
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.Штрихкод В (&Штрихкоды)
	|	И Товары.Алкоголь ПОДОБНО ""%алкокод %""";
	Запрос.УстановитьПараметр("Штрихкоды", Варианты);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;

	Позиция = СтрНайти(НРег(Выборка.Алкоголь), "алкокод ");
	Алкокод = ТолькоЦифры(Сред(Выборка.Алкоголь, Позиция + СтрДлина("алкокод "), ДлинаАлкокода()));
	Если СтрДлина(Алкокод) <> ДлинаАлкокода() Тогда
		Возврат "";
	КонецЕсли;

	АлкогольнаяПродукция = АлкогольнаяПродукцияПоАлкокоду(Алкокод);
	Если НЕ ЗначениеЗаполнено(АлкогольнаяПродукция) Тогда
		Возврат СтрШаблон(НСтр("ru = 'алкокода %1 нет в классификаторе ЕГАИС УТ - запросить в УТМ'"), Алкокод);
	КонецЕсли;

	Возврат ЗаписатьСоответствиеЕГАИС(Номенклатура, АлкогольнаяПродукция);

КонецФункции

#КонецОбласти

#Область РеестрУПДИНастройки

// Признак алкоголя строки УПД для регистра товаров и колонки «Алкоголь» реестра
// УПД. Учитывает настройки ЕГАИС_*. Исключений не выпускает: загрузка товаров
// от признака не зависит.
//
// Параметры:
//   СтрокаУПД - Структура, СтрокаТаблицыЗначений - см. СведенияАлкоголя
//
// Возвращаемое значение:
//   Строка - см. ПредставлениеСведений; пусто - не алкоголь или определение выключено
//
Функция АлкогольСтрокиУПД(СтрокаУПД) Экспорт

	Попытка
		Если НЕ НастройкаБулево("ЕГАИС_ОпределятьАлкоголь", Истина) Тогда
			Возврат "";
		КонецЕсли;
		Сведения = СведенияАлкоголя(СтрокаУПД);
		Если НЕ Сведения.Точно И НЕ НастройкаБулево("ЕГАИС_УчитыватьНаименование", Истина) Тогда
			Возврат "";
		КонецЕсли;
		Возврат ПредставлениеСведений(Сведения);
	Исключение
		ЗаписьЖурналаРегистрации("ЭАрМ.АлкогольЕГАИС", УровеньЖурналаРегистрации.Предупреждение,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат "";
	КонецПопытки;

КонецФункции

// Пересчитывает колонку «Алкоголь» у строк УПД, уже лежащих в регистре товаров:
// загруженных до модуля или после смены настроек. Сырых данных УПД в регистре
// нет - признаки берутся из наименования, кодов маркировки и ТН ВЭД строки.
//
// Параметры:
//   ИдентификаторУПД - Строка - один документ; пусто - все УПД
//
// Возвращаемое значение:
//   Структура - Документов, Строк, Алкоголь, Возможно, Изменено (Число)
//
Функция ПересчитатьАлкогольТоваровУПД(ИдентификаторУПД = "") Экспорт

	Итог = Новый Структура("Документов, Строк, Алкоголь, Возможно, Изменено", 0, 0, 0, 0, 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Товары.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИсточникТоваров = ""УПД""
	|	И (&ВсеДокументы ИЛИ Товары.ИдентификаторСБИС = &ИдентификаторУПД)";
	Запрос.УстановитьПараметр("ВсеДокументы", НЕ ЗначениеЗаполнено(ИдентификаторУПД));
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Итог.Документов = Итог.Документов + 1;

		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЭАрМ_ТоварыЭТрН");
			ЭлементБлокировки.УстановитьЗначение("ИдентификаторСБИС", Выборка.ИдентификаторСБИС);
			Блокировка.Заблокировать();

			Набор = РегистрыСведений.ЭАрМ_ТоварыЭТрН.СоздатьНаборЗаписей();
			Набор.Отбор.ИдентификаторСБИС.Установить(Выборка.ИдентификаторСБИС);
			Набор.Прочитать();

			Изменен = Ложь;
			Для Каждого Запись Из Набор Цикл
				Если Запись.ИсточникТоваров <> "УПД" Тогда
					Продолжить;
				КонецЕсли;
				СтрокаТовара = Новый Структура("Наименование, Маркировки, КодТНВЭД",
					Запись.Наименование, Запись.Маркировки, Запись.КодТНВЭД);
				Алкоголь = Лев(АлкогольСтрокиУПД(СтрокаТовара), 300);
				Итог.Строк = Итог.Строк + 1;
				Если СтрНачинаетсяС(Алкоголь, "Алкоголь") Тогда
					Итог.Алкоголь = Итог.Алкоголь + 1;
				ИначеЕсли ЗначениеЗаполнено(Алкоголь) Тогда
					Итог.Возможно = Итог.Возможно + 1;
				КонецЕсли;
				Если Запись.Алкоголь <> Алкоголь Тогда
					Запись.Алкоголь = Алкоголь;
					Итог.Изменено = Итог.Изменено + 1;
					Изменен = Истина;
				КонецЕсли;
			КонецЦикла;

			Если Изменен Тогда
				Набор.Записать(Истина);
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("ЭАрМ.АлкогольЕГАИС", УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Возврат Итог;

КонецФункции

// Что готово и чего не хватает для работы с ЕГАИС в УТ и в реестре УПД.
//
// Возвращаемое значение:
//   Структура:
//     * Готово - Булево - все обязательные пункты выполнены
//     * Текст  - Строка - отчёт по пунктам: что заполнено, что и где заполнить
//
Функция СостояниеПодключенияЕГАИС() Экспорт

	Пункты = Новый Массив;
	Готово = Истина;

	// 1. Функциональная опция УТ
	Включено = Ложь;
	Попытка
		Включено = ПолучитьФункциональнуюОпцию("ВестиСведенияДляДекларацийПоАлкогольнойПродукции");
	Исключение
		Включено = Ложь;
	КонецПопытки;
	ДобавитьПункт(Пункты, Готово, Включено, Истина,
		"Учёт алкогольной продукции (ЕГАИС) в УТ включён",
		"Включить: кнопка «Настройки ЕГАИС в УТ» → флаг учёта алкогольной продукции / ЕГАИС");

	// 2. Настройки обмена с УТМ и доступность УТМ
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Настройки.ИдентификаторФСРАР КАК ИдентификаторФСРАР,
	|	Настройки.АдресУТМ КАК АдресУТМ,
	|	Настройки.ПортУТМ КАК ПортУТМ
	|ИЗ
	|	РегистрСведений.НастройкиОбменаЕГАИС КАК Настройки";
	НастройкиУТМ = Запрос.Выполнить().Выгрузить();
	ДобавитьПункт(Пункты, Готово, НастройкиУТМ.Количество() > 0, Истина,
		СтрШаблон("Настройки обмена с УТМ: %1", НастройкиУТМ.Количество()),
		"Заполнить: кнопка «Настройки обмена с УТМ» → ФСРАР ИД организации, адрес и порт УТМ (обычно localhost, 8080)");
	Для Каждого НастройкаУТМ Из НастройкиУТМ Цикл
		Ответ = ПроверитьУТМ(НастройкаУТМ.АдресУТМ, НастройкаУТМ.ПортУТМ);
		ДобавитьПункт(Пункты, Готово, Ответ.Успех, Истина,
			СтрШаблон("УТМ ФСРАР ИД %1 (%2): %3", НастройкаУТМ.ИдентификаторФСРАР, Ответ.Адрес, Ответ.Текст),
			"Проверить на компьютере с УТМ: служба УТМ запущена, ключ (Рутокен/JaCarta) с КЭП вставлен, порт открыт для сервера 1С");
	КонецЦикла;

	// 3. Своя организация в классификаторе организаций ЕГАИС
	Свои = КоличествоЗаписей(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ Справочник.КлассификаторОрганизацийЕГАИС КАК Т
	|ГДЕ Т.СоответствуетОрганизации И НЕ Т.ПометкаУдаления");
	ДобавитьПункт(Пункты, Готово, Свои > 0, Истина,
		СтрШаблон("Своих организаций в классификаторе ЕГАИС: %1", Свои),
		"Заполнить: «Классификатор организаций ЕГАИС» - запросить свою организацию по ФСРАР ИД и отметить соответствие организации УТ");

	// 4. Автоматический обмен (не обязателен)
	АвтоОбмен = Ложь;
	Попытка
		АвтоОбмен = Константы.ИспользоватьАвтоматическуюОтправкуПолучениеДанныхЕГАИС.Получить();
	Исключение
		АвтоОбмен = Ложь;
	КонецПопытки;
	ДобавитьПункт(Пункты, Готово, АвтоОбмен, Ложь,
		"Автоматическая отправка и получение данных ЕГАИС",
		"По желанию: «Настройки ЕГАИС в УТ» → автоматический обмен; иначе обмен кнопкой «Обмен с ЕГАИС»");

	// 5. Классификатор видов продукции
	Видов = КоличествоЗаписей(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ КОЛИЧЕСТВО(*) КАК Количество ИЗ РегистрСведений.ВидыАлкогольнойПродукцииЕГАИС КАК Т");
	ДобавитьПункт(Пункты, Готово, Видов > 0, Истина,
		СтрШаблон("Классификатор видов продукции ЕГАИС: %1 видов", Видов),
		СтрШаблон("Нажать «Заполнить классификатор видов» (статично, %1 видов)",
			ДанныеКлассификатораВидов().Количество()));

	// 6. Виды номенклатуры для алкоголя
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК Т
	|ГДЕ
	|	НЕ Т.ЭтоГруппа
	|	И НЕ Т.ПометкаУдаления
	|	И Т.ОсобенностьУчета В (&Особенности)";
	Запрос.УстановитьПараметр("Особенности", ОсобенностиУчетаАлкоголя());
	ВидовНоменклатуры = Запрос.Выполнить().Выгрузить()[0].Количество;
	ДобавитьПункт(Пункты, Готово, ВидовНоменклатуры > 0, Истина,
		СтрШаблон("Видов номенклатуры с особенностью учёта «Алкогольная продукция» / «Пиво»: %1", ВидовНоменклатуры),
		"Создать в УТ: «Виды номенклатуры» → особенность учёта «Алкогольная продукция» (и «Пиво»), указать вид алкогольной продукции");
	ВидАлкоголя = ВидНоменклатурыИзНастроек(Ложь);
	ДобавитьПункт(Пункты, Готово, ЗначениеЗаполнено(ВидАлкоголя), Ложь,
		"Вид номенклатуры для алкоголя по умолчанию: " + ?(ЗначениеЗаполнено(ВидАлкоголя), Строка(ВидАлкоголя), "не выбран"),
		"Выбрать в этой форме, если видов для алкоголя несколько - типовой подбор тогда вид не ставит");

	// 7. Номенклатура УТ и сопоставление ЕГАИС
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КОЛИЧЕСТВО(*) КАК Всего,
	|	СУММА(ВЫБОР
	|			КОГДА Т.ВидАлкогольнойПродукции = ЗНАЧЕНИЕ(Справочник.ВидыАлкогольнойПродукции.ПустаяСсылка)
	|					ИЛИ Т.Крепость = 0
	|					ИЛИ Т.ОбъемДАЛ = 0
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Неполных
	|ИЗ
	|	Справочник.Номенклатура КАК Т
	|ГДЕ
	|	НЕ Т.ЭтоГруппа
	|	И НЕ Т.ПометкаУдаления
	|	И Т.ОсобенностьУчета В (&Особенности)";
	Запрос.УстановитьПараметр("Особенности", ОсобенностиУчетаАлкоголя());
	Номенклатура = Запрос.Выполнить().Выгрузить()[0];
	Неполных = ?(Номенклатура.Неполных = Null, 0, Номенклатура.Неполных);
	ДобавитьПункт(Пункты, Готово, Неполных = 0, Ложь,
		СтрШаблон("Алкогольная номенклатура УТ: %1, без вида продукции, крепости или объёма: %2",
			Номенклатура.Всего, Неполных),
		"Нажать «Дозаполнить номенклатуру» - вид, крепость и объём по наименованию, только пустые реквизиты");

	Сопоставлено = КоличествоЗаписей(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Номенклатура) КАК Количество ИЗ РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК Т");
	Продукции = КоличествоЗаписей(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК Т");
	ДобавитьПункт(Пункты, Готово, Сопоставлено > 0, Ложь,
		СтрШаблон("Сопоставлено с ЕГАИС номенклатур: %1, продукции в классификаторе ЕГАИС: %2", Сопоставлено, Продукции),
		"Наполняется из ТТН ЕГАИС; сопоставить - «Сопоставление номенклатуры ЕГАИС»");

	// 8. Реестр УПД
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ВЫБОР КОГДА Т.Алкоголь ПОДОБНО ""Алкоголь%"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Алкоголь,
	|	СУММА(ВЫБОР КОГДА Т.Алкоголь ПОДОБНО ""Возможно%"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Возможно
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Т
	|ГДЕ
	|	Т.ИсточникТоваров = ""УПД""";
	СтрокиУПД = Запрос.Выполнить().Выгрузить()[0];
	ДобавитьПункт(Пункты, Готово, НастройкаБулево("ЕГАИС_ОпределятьАлкоголь", Истина), Ложь,
		СтрШаблон("Строк УПД: алкоголь %1, возможно алкоголь %2",
			?(СтрокиУПД.Алкоголь = Null, 0, СтрокиУПД.Алкоголь),
			?(СтрокиУПД.Возможно = Null, 0, СтрокиУПД.Возможно)),
		"Определение алкоголя выключено в настройках; после включения - «Пересчитать алкоголь в УПД»");

	Заголовок = ?(Готово, "ЕГАИС: обязательное заполнено", "ЕГАИС: есть незаполненное (❌)");
	Возврат Новый Структура("Готово, Текст", Готово,
		Заголовок + Символы.ПС + Символы.ПС + СтрСоединить(Пункты, Символы.ПС));

КонецФункции

// Отчёт по алкоголю одной УПД для команды «Алкоголь ЕГАИС» реестра УПД:
// пересчитывает признак строк и перечисляет строки-алкоголь, затем состояние
// подключения ЕГАИС.
//
// Параметры:
//   ИдентификаторУПД - Строка - документ в СБИС
//
// Возвращаемое значение:
//   Строка
//
Функция ОтчетАлкогольУПД(ИдентификаторУПД) Экспорт

	Итог = ПересчитатьАлкогольТоваровУПД(ИдентификаторУПД);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.Наименование КАК Наименование,
	|	Товары.Количество КАК Количество,
	|	Товары.КодТНВЭД КАК КодТНВЭД,
	|	Товары.Маркировок КАК Маркировок,
	|	Товары.Алкоголь КАК Алкоголь
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &ИдентификаторУПД
	|	И Товары.ИсточникТоваров = ""УПД""
	|	И Товары.Алкоголь <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерПозиции";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);
	Выборка = Запрос.Выполнить().Выбрать();

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Строк УПД: %1, алкоголь: %2, возможно алкоголь: %3",
		Итог.Строк, Итог.Алкоголь, Итог.Возможно));
	Строки.Добавить("");
	Пока Выборка.Следующий() Цикл
		Строки.Добавить(СтрШаблон("%1. %2 - %3 шт.%4%5", Выборка.НомерПозиции, Выборка.Наименование,
			Выборка.Количество,
			?(ЗначениеЗаполнено(Выборка.КодТНВЭД), ", ТН ВЭД " + Выборка.КодТНВЭД, ""),
			?(Выборка.Маркировок > 0, ", марок " + Выборка.Маркировок, "")));
		Строки.Добавить("      " + Выборка.Алкоголь);
	КонецЦикла;
	Если Итог.Алкоголь + Итог.Возможно = 0 Тогда
		Строки.Добавить("Алкоголя в строках нет.");
	КонецЕсли;

	Строки.Добавить("");
	Строки.Добавить("------------------------------------------------------------");
	Попытка
		Строки.Добавить(СостояниеПодключенияЕГАИС().Текст);
	Исключение
		Строки.Добавить("Состояние ЕГАИС не проверено: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Дозаполняет алкогольную номенклатуру УТ (особенность учёта «Алкогольная
// продукция» / «Пиво»): вид продукции, крепость и объём по наименованию,
// подакцизность. Меняются только пустые реквизиты.
//
// Параметры:
//   Лимит - Число - номенклатур за проход; 0 - из настройки ЕГАИС_НоменклатурыЗаПроход
//
// Возвращаемое значение:
//   Структура - Проверено, Заполнено, Ошибок (Число), Замечания (Массив из Строка)
//
Функция ДозаполнитьНоменклатуруУТ(Знач Лимит = 0) Экспорт

	Итог = Новый Структура("Проверено, Заполнено, Ошибок, Замечания", 0, 0, 0, Новый Массив);

	Если Лимит <= 0 Тогда
		Лимит = ЭАрМ_НастройкиСервер.ЗначениеНастройки("ЕГАИС_НоменклатурыЗаПроход");
		Если ТипЗнч(Лимит) <> Тип("Число") ИЛИ Лимит <= 0 Тогда
			Лимит = 500;
		КонецЕсли;
	КонецЕсли;
	// В текст запроса попадает только целое число в разумных пределах
	Лимит = Мин(Макс(Цел(Лимит), 1), 5000);

	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 500
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Т
	|ГДЕ
	|	НЕ Т.ЭтоГруппа
	|	И НЕ Т.ПометкаУдаления
	|	И Т.ОсобенностьУчета В (&Особенности)
	|	И (Т.ВидАлкогольнойПродукции = ЗНАЧЕНИЕ(Справочник.ВидыАлкогольнойПродукции.ПустаяСсылка)
	|			ИЛИ Т.Крепость = 0
	|			ИЛИ Т.ОбъемДАЛ = 0
	|			ИЛИ НЕ Т.ПодакцизныйТовар)", "ПЕРВЫЕ 500", "ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0"));
	Запрос.УстановитьПараметр("Особенности", ОсобенностиУчетаАлкоголя());
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Итог.Проверено = Итог.Проверено + 1;
		Попытка

			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Сведения = СведенияАлкоголя(Новый Структура("Наименование", Объект.Наименование));

			Если НЕ ЗначениеЗаполнено(Объект.ВидАлкогольнойПродукции) И ЗначениеЗаполнено(Сведения.КодВида) Тогда
				Объект.ВидАлкогольнойПродукции = ВидАлкогольнойПродукции(Сведения.КодВида);
			КонецЕсли;
			Если Объект.Крепость = 0 И Сведения.Крепость > 0 Тогда
				Объект.Крепость = Сведения.Крепость;
			КонецЕсли;
			Если Объект.ОбъемДАЛ = 0 И Сведения.ОбъемЛитров > 0 Тогда
				Объект.ОбъемДАЛ = Сведения.ОбъемЛитров / 10;
			КонецЕсли;
			Если НЕ Объект.ПодакцизныйТовар Тогда
				Объект.ПодакцизныйТовар = Истина;
			КонецЕсли;

			Если Объект.Модифицированность() Тогда
				Объект.Записать();
				Итог.Заполнено = Итог.Заполнено + 1;
			КонецЕсли;

			Замечания = ЗамечанияПоНоменклатуре(Объект);
			Если Замечания.Количество() > 0 И Итог.Замечания.Количество() < 50 Тогда
				Итог.Замечания.Добавить(Строка(Объект) + ": " + СтрСоединить(Замечания, "; "));
			КонецЕсли;

		Исключение
			Итог.Ошибок = Итог.Ошибок + 1;
			Если Итог.Замечания.Количество() < 50 Тогда
				Итог.Замечания.Добавить(Строка(Выборка.Ссылка) + ": "
					+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецЕсли;
		КонецПопытки;

	КонецЦикла;

	Возврат Итог;

КонецФункции

// Вид номенклатуры по умолчанию из настроек ЕГАИС_ВидНоменклатурыАлкоголь /
// ЕГАИС_ВидНоменклатурыПиво (хранится УИД).
//
// Параметры:
//   Пиво - Булево
//
// Возвращаемое значение:
//   СправочникСсылка.ВидыНоменклатуры - пустая, если не выбран или удалён
//
Функция ВидНоменклатурыИзНастроек(Пиво) Экспорт

	УИД = ЭАрМ_НастройкиСервер.ЗначениеНастройки(
		?(Пиво, "ЕГАИС_ВидНоменклатурыПиво", "ЕГАИС_ВидНоменклатурыАлкоголь"));
	Если ТипЗнч(УИД) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(УИД) Тогда
		Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	Попытка
		Ссылка = Справочники.ВидыНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
	Исключение
		Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();
	КонецПопытки;

	Если НЕ ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	Возврат Ссылка;

КонецФункции

// Заполняет классификатор видов ЕГАИС, если он пуст или почти пуст. Нужен, чтобы
// ВидАлкогольнойПродукции(Код) возвращал ссылки видов. Вызывается из регламентного
// обмена; вручную классификатор заполняется кнопкой на панели ЕГАИС.
//
// Возвращаемое значение:
//   Структура - итог ЗаполнитьКлассификаторВидов; Неопределено - заполнение не нужно
//
Функция ОбеспечитьКлассификаторВидов() Экспорт

	Если ЭАрМ_НастройкиСервер.ФоновыеЗаданияОтключены() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Количество = КоличествоЗаписей(
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ РегистрСведений.ВидыАлкогольнойПродукцииЕГАИС КАК Т");
	Если Количество >= 100 Тогда
		Возврат Неопределено; // классификатор уже заполнен
	КонецЕсли;

	Попытка
		Возврат ЗаполнитьКлассификаторВидов(Ложь);
	Исключение
		ЗаписьЖурналаРегистрации("ЭАрМ.АлкогольЕГАИС", УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Дозаполняет алкогольную номенклатуру УТ и автоматически сопоставляет её с
// классификатором ЕГАИС по алкокоду строк УПД. Идемпотентно: меняются только
// пустые реквизиты, чужое сопоставление ЕГАИС не перебивается.
//
// Параметры:
//   Лимит - Число - номенклатур за проход; 0 - из настройки ЕГАИС_НоменклатурыЗаПроход
//
// Возвращаемое значение:
//   Структура - Проверено, Заполнено, Ошибок, Замечания, Сопоставлено (Число)
//
Функция ДозаполнитьАлкогольнуюНоменклатуру(Лимит = 0) Экспорт

	Итог = ДозаполнитьНоменклатуруУТ(Лимит);
	Итог.Вставить("Сопоставлено", 0);

	Если НЕ НастройкаБулево("ЕГАИС_ЗаписыватьСоответствие", Истина) Тогда
		Возврат Итог;
	КонецЕсли;

	Попытка
		СопоставитьАлкогольПоСтрокамУПД(Итог);
	Исключение
		Итог.Ошибок = Итог.Ошибок + 1;
		Если Итог.Замечания.Количество() < 50 Тогда
			Итог.Замечания.Добавить("сопоставление ЕГАИС: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецЕсли;
	КонецПопытки;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтметитьАлкоголь(Сведения, Точно, Причина)

	Сведения.Алкоголь = Истина;
	Сведения.Точно = Сведения.Точно ИЛИ Точно;
	Сведения.Причины.Добавить(Причина);

КонецПроцедуры

Процедура ЗаполнитьПоКлассификатору(Сведения, АлкогольнаяПродукция)

	Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АлкогольнаяПродукция,
		"Объем, Крепость, ВидПродукции");
	Сведения.Крепость    = Данные.Крепость;
	Сведения.ОбъемЛитров = Данные.Объем;
	Если ЗначениеЗаполнено(Данные.ВидПродукции) Тогда
		Сведения.КодВида = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.ВидПродукции, "Код"));
	КонецЕсли;

КонецПроцедуры

Функция ЕстьСоответствиеЕГАИС(Номенклатура)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ИСТИНА КАК Найдено
	|ИЗ
	|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК Соответствие
	|ГДЕ
	|	Соответствие.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Массовое сопоставление номенклатуры УТ с классификатором ЕГАИС по алкокоду строк
// УПД. Для строк УПД, у которых в признаке «Алкоголь» есть алкокод и заполнен штрихкод,
// находит номенклатуру и, если у неё ещё нет соответствия ЕГАИС, записывает его.
Процедура СопоставитьАлкогольПоСтрокамУПД(Итог)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Товары.Штрихкод КАК Штрихкод,
	|	МАКСИМУМ(Товары.Алкоголь) КАК Алкоголь
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.Алкоголь ПОДОБНО ""%алкокод %""
	|	И Товары.Штрихкод <> """"
	|СГРУППИРОВАТЬ ПО
	|	Товары.Штрихкод";
	Выборка = Запрос.Выполнить().Выбрать();

	ШтрихкодыАлкоголя = Новый Соответствие; // штрихкод -> алкокод
	Пока Выборка.Следующий() Цикл
		Позиция = СтрНайти(НРег(Выборка.Алкоголь), "алкокод ");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Алкокод = ТолькоЦифры(Сред(Выборка.Алкоголь, Позиция + СтрДлина("алкокод "), ДлинаАлкокода()));
		Если СтрДлина(Алкокод) <> ДлинаАлкокода() Тогда
			Продолжить;
		КонецЕсли;
		Штрихкод = ТолькоЦифры(Выборка.Штрихкод);
		Если ПустаяСтрока(Штрихкод) Тогда
			Продолжить;
		КонецЕсли;
		Если ШтрихкодыАлкоголя.Получить(Штрихкод) = Неопределено Тогда
			ШтрихкодыАлкоголя.Вставить(Штрихкод, Алкокод);
		КонецЕсли;
		// Варианты EAN-13 <-> GTIN-14 с ведущим нулём (как в СопоставитьСЕГАИСПоШтрихкоду)
		Если СтрДлина(Штрихкод) = 13 И ШтрихкодыАлкоголя.Получить("0" + Штрихкод) = Неопределено Тогда
			ШтрихкодыАлкоголя.Вставить("0" + Штрихкод, Алкокод);
		ИначеЕсли СтрДлина(Штрихкод) = 14 И СтрНачинаетсяС(Штрихкод, "0")
			И ШтрихкодыАлкоголя.Получить(Сред(Штрихкод, 2)) = Неопределено Тогда
			ШтрихкодыАлкоголя.Вставить(Сред(Штрихкод, 2), Алкокод);
		КонецЕсли;
	КонецЦикла;

	Если ШтрихкодыАлкоголя.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СписокШтрихкодов = Новый Массив;
	Для Каждого КлючЗначение Из ШтрихкодыАлкоголя Цикл
		СписокШтрихкодов.Добавить(КлючЗначение.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод В (&Штрихкоды)
	|	И Штрихкоды.Номенклатура ССЫЛКА Справочник.Номенклатура
	|	И НЕ Штрихкоды.Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("Штрихкоды", СписокШтрихкодов);
	Выборка = Запрос.Выполнить().Выбрать();

	НоменклатураПоШтрихкоду = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Если НоменклатураПоШтрихкоду.Получить(Выборка.Штрихкод) = Неопределено Тогда
			НоменклатураПоШтрихкоду.Вставить(Выборка.Штрихкод, Выборка.Номенклатура);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючЗначение Из ШтрихкодыАлкоголя Цикл
		Номенклатура = НоменклатураПоШтрихкоду.Получить(КлючЗначение.Ключ);
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Если ЕстьСоответствиеЕГАИС(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		АлкогольнаяПродукция = АлкогольнаяПродукцияПоАлкокоду(КлючЗначение.Значение);
		Если НЕ ЗначениеЗаполнено(АлкогольнаяПродукция) Тогда
			Продолжить;
		КонецЕсли;

		Причина = ЗаписатьСоответствиеЕГАИС(Номенклатура, АлкогольнаяПродукция);
		Если ПустаяСтрока(Причина) Тогда
			Итог.Сопоставлено = Итог.Сопоставлено + 1;
		ИначеЕсли Итог.Замечания.Количество() < 50 Тогда
			Итог.Замечания.Добавить(Строка(Номенклатура) + ", ЕГАИС: " + Причина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ОсобенностиУчетаАлкоголя()

	Особенности = Новый Массив;
	Особенности.Добавить(Перечисления.ОсобенностиУчетаНоменклатуры.АлкогольнаяПродукция);
	Особенности.Добавить(Перечисления.ОсобенностиУчетаНоменклатуры.Пиво);
	Особенности.Добавить(Перечисления.ОсобенностиУчетаНоменклатуры.ПивоВПотребительскихУпаковках);
	Особенности.Добавить(Перечисления.ОсобенностиУчетаНоменклатуры.АлкогольнаяПродукцияДо9Процентов);
	Возврат Особенности;

КонецФункции

// ТН ВЭД группы 22: 2203 пиво, 2204 вино, 2205 вермут, 2206 сидр, пуаре,
// медовуха и прочие сброженные, 2207 спирт, 2208 крепкие напитки.
Функция ЭтоАлкогольныйТНВЭД(КодТНВЭД)

	Группа = Лев(КодТНВЭД, 4);
	Возврат Группа = "2203" ИЛИ Группа = "2204" ИЛИ Группа = "2205"
		ИЛИ Группа = "2206" ИЛИ Группа = "2207" ИЛИ Группа = "2208";

КонецФункции

// Вид продукции по ТН ВЭД, когда наименование ничего не дало. Для 2206-2208
// вид однозначно не определить - пусто, выбирает пользователь.
Функция ВидПоТНВЭД(КодТНВЭД)

	Если Лев(КодТНВЭД, 4) = "2203" Тогда
		Возврат "500";
	ИначеЕсли Лев(КодТНВЭД, 6) = "220410" Тогда
		Возврат "440";
	ИначеЕсли Лев(КодТНВЭД, 4) = "2204" Тогда
		Возврат "4011";
	ИначеЕсли Лев(КодТНВЭД, 4) = "2205" Тогда
		Возврат "4321";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ЭтоПиво(КодВида, КодТНВЭД)

	Возврат КодВида = "500" ИЛИ КодВида = "510" ИЛИ КодВида = "520"
		ИЛИ Лев(КодТНВЭД, 4) = "2203";

КонецФункции

// Вид продукции по словам наименования. Слова проверяются по порядку - сначала
// точные (шампанское, портвейн), потом общие (вино). Слабые слова (бальзам,
// коктейль, пунш, крем) засчитываются только при крепости в наименовании:
// «бальзам для губ» - не алкоголь.
//
// Возвращаемое значение:
//   Структура - Слово, Код; Неопределено - слов алкоголя нет
//
Функция ВидПоНаименованию(Наименование, ЕстьПроцент)

	Слова = СловаНаименования(Наименование);
	Если Слова.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Правило Из ПравилаСлов() Цикл

		Если Правило.НуженПроцент И НЕ ЕстьПроцент Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЕстьСлово(Слова, Правило.Слово, Правило.Целиком) Тогда
			Продолжить;
		КонецЕсли;

		Код = Правило.Код;
		// Уточнения вина
		Если Код = "4011" Тогда
			Если ЕстьСлово(Слова, "креплен", Ложь) Тогда
				Код = "4114";
			ИначеЕсли ЕстьСлово(Слова, "фруктов", Ложь) ИЛИ ЕстьСлово(Слова, "плодов", Ложь) Тогда
				Код = "4213";
			ИначеЕсли ЕстьСлово(Слова, "столов", Ложь) Тогда
				Код = "4031";
			КонецЕсли;
		ИначеЕсли Код = "440" Тогда
			Если ЕстьСлово(Слова, "фруктов", Ложь) ИЛИ ЕстьСлово(Слова, "плодов", Ложь) Тогда
				Код = "4219";
			КонецЕсли;
		КонецЕсли;

		Возврат Новый Структура("Слово, Код", Правило.Слово, Код);

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Правила слов: Слово - начало слова (Целиком - слово целиком), Код - вид
// продукции ЕГАИС (пусто - алкоголь без вида, выбирает пользователь).
Функция ПравилаСлов()

	Правила = Новый Массив;
	ДобавитьПравило(Правила, "шампанск",     "4501");
	ДобавитьПравило(Правила, "игрист",       "440");
	ДобавитьПравило(Правила, "просекко",     "440");
	ДобавитьПравило(Правила, "портвейн",     "4113");
	ДобавитьПравило(Правила, "вермут",       "4321");
	ДобавитьПравило(Правила, "коньяк",       "2291");
	ДобавитьПравило(Правила, "бренди",       "232");
	ДобавитьПравило(Правила, "кальвадос",    "252");
	ДобавитьПравило(Правила, "виски",        "237");
	ДобавитьПравило(Правила, "бурбон",       "237");
	ДобавитьПравило(Правила, "ром",          "236", Истина);
	ДобавитьПравило(Правила, "джин",         "2807", Истина);
	ДобавитьПравило(Правила, "джины",        "2807", Истина);
	ДобавитьПравило(Правила, "граппа",       "2801");
	ДобавитьПравило(Правила, "чача",         "2801", Истина);
	ДобавитьПравило(Правила, "текил",        "28014");
	ДобавитьПравило(Правила, "мескал",       "28014");
	ДобавитьПравило(Правила, "абсент",       "28014");
	ДобавитьПравило(Правила, "водк",         "200");
	ДобавитьПравило(Правила, "ликер",        "21212");
	ДобавитьПравило(Правила, "самбук",       "21212");
	ДобавитьПравило(Правила, "настойк",      "2127");
	ДобавитьПравило(Правила, "наливк",       "2114");
	ДобавитьПравило(Правила, "аперитив",     "2123");
	ДобавитьПравило(Правила, "бальзам",      "2125", Ложь, Истина);
	ДобавитьПравило(Правила, "пунш",         "2112", Ложь, Истина);
	ДобавитьПравило(Правила, "коктейль",     "2124", Ложь, Истина);
	ДобавитьПравило(Правила, "сидр",         "261");
	ДобавитьПравило(Правила, "пуаре",        "262");
	ДобавитьПравило(Правила, "медовух",      "263");
	ДобавитьПравило(Правила, "пивн",         "520");
	ДобавитьПравило(Правила, "пиво",         "500", Истина);
	ДобавитьПравило(Правила, "пива",         "500", Истина);
	ДобавитьПравило(Правила, "эль",          "500", Истина);
	ДобавитьПравило(Правила, "лагер",        "500");
	ДобавитьПравило(Правила, "стаут",        "500");
	ДобавитьПравило(Правила, "портер",       "500", Истина);
	ДобавитьПравило(Правила, "вино",         "4011", Истина);
	ДобавитьПравило(Правила, "вина",         "4011", Истина);
	ДобавитьПравило(Правила, "винн",         "");
	ДобавитьПравило(Правила, "слабоалкогол", "2601");
	Возврат Правила;

КонецФункции

Процедура ДобавитьПравило(Правила, Слово, Код, Целиком = Ложь, НуженПроцент = Ложь)

	Правила.Добавить(Новый Структура("Слово, Код, Целиком, НуженПроцент",
		Слово, Код, Целиком, НуженПроцент));

КонецПроцедуры

// Причина считать строку не алкоголем, хотя в ней есть слова алкоголя:
// безалкогольное, 0%, кондитерка и снеки «со вкусом», косметика, посуда.
//
// Возвращаемое значение:
//   Строка - найденное слово-исключение, пусто - исключений нет
//
Функция НеАлкогольПоНаименованию(Наименование, Числа)

	Если Числа.ЕстьПроцент И Числа.Крепость = 0 Тогда
		Возврат "0%";
	КонецЕсли;

	Текст = НРег(СтрЗаменить(Наименование, "ё", "е"));
	Если СтрНайти(Текст, "б/а") > 0 ИЛИ СтрНайти(Текст, "б/алк") > 0 Тогда
		Возврат "б/а";
	КонецЕсли;

	Слова = СловаНаименования(Наименование);
	Исключения = СтрРазделить(
		"безалкогол,конфет,шоколад,мармелад,торт,кекс,пирож,печень,сироп,уксус,соус,"
		+ "ароматизатор,чай,кофе,морожен,джем,варень,чипс,сухар,снек,орех,квас,лимонад,"
		+ "губ,волос,шампун,ополаск,гель,мыло,бокал,стакан,рюмк,штопор,декантер,дрожж,солод,кружк,баба,"
		+ "молок,молоч,кефир,йогурт,сметан,творог,ряженк", ",");
	Для Каждого Слово Из Исключения Цикл
		Если ЕстьСлово(Слова, Слово, Ложь) Тогда
			Возврат Слово;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Слова наименования в нижнем регистре, ё -> е; разделитель - всё, что не буква.
Функция СловаНаименования(Наименование)

	Слова = Новый Массив;
	Текст = НРег(СтрЗаменить(Строка(Наименование), "ё", "е"));
	Слово = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ЭтоБуква(Символ) Тогда
			Слово = Слово + Символ;
		ИначеЕсли Слово <> "" Тогда
			Слова.Добавить(Слово);
			Слово = "";
		КонецЕсли;
	КонецЦикла;
	Если Слово <> "" Тогда
		Слова.Добавить(Слово);
	КонецЕсли;
	Возврат Слова;

КонецФункции

Функция ЕстьСлово(Слова, Образец, Целиком)

	Для Каждого Слово Из Слова Цикл
		Если Целиком И Слово = Образец Тогда
			Возврат Истина;
		ИначеЕсли НЕ Целиком И СтрНачинаетсяС(Слово, Образец) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЭтоБуква(Символ)

	Возврат НРег(Символ) <> ВРег(Символ);

КонецФункции

// Крепость и объём из наименования: «40%», «4,5 % об.», «0,5л», «0.75 л»,
// «500 мл». Проценты без спиртного бывают у жирности - поэтому крепость
// учитывается, только когда алкоголь уже узнан по другим признакам.
//
// Возвращаемое значение:
//   Структура - Крепость, ОбъемЛитров (Число), ЕстьПроцент (Булево)
//
Функция ЧислаНаименования(Наименование)

	Результат = Новый Структура("Крепость, ОбъемЛитров, ЕстьПроцент", 0, 0, Ложь);
	Текст = НРег(Строка(Наименование));
	Длина = СтрДлина(Текст);
	Позиция = 1;

	Пока Позиция <= Длина Цикл

		Символ = Сред(Текст, Позиция, 1);
		Если НЕ ЭтоЦифра(Символ) Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		// Число: цифры с одной запятой или точкой
		ЧислоТекст = "";
		БылРазделитель = Ложь;
		Пока Позиция <= Длина Цикл
			Символ = Сред(Текст, Позиция, 1);
			Если ЭтоЦифра(Символ) Тогда
				ЧислоТекст = ЧислоТекст + Символ;
			ИначеЕсли (Символ = "," ИЛИ Символ = ".") И НЕ БылРазделитель
				И Позиция < Длина И ЭтоЦифра(Сред(Текст, Позиция + 1, 1)) Тогда
				ЧислоТекст = ЧислоТекст + ".";
				БылРазделитель = Истина;
			Иначе
				Прервать;
			КонецЕсли;
			Позиция = Позиция + 1;
		КонецЦикла;

		// Единица сразу или через пробел
		Хвост = Позиция;
		Пока Хвост <= Длина И Сред(Текст, Хвост, 1) = " " Цикл
			Хвост = Хвост + 1;
		КонецЦикла;
		Единица = "";
		Пока Хвост <= Длина И СтрДлина(Единица) < 3 Цикл
			Символ = Сред(Текст, Хвост, 1);
			Если Символ = "%" Тогда
				Единица = "%";
				Прервать;
			ИначеЕсли ЭтоБуква(Символ) Тогда
				Единица = Единица + Символ;
				Хвост = Хвост + 1;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Значение = ЧислоИзТекста(ЧислоТекст);
		Если Единица = "%" Тогда
			Если НЕ Результат.ЕстьПроцент Тогда
				Результат.ЕстьПроцент = Истина;
				Результат.Крепость = Значение;
			КонецЕсли;
		ИначеЕсли Результат.ОбъемЛитров = 0 Тогда
			Если Единица = "л" ИЛИ Единица = "l" ИЛИ Единица = "лит" Тогда
				Результат.ОбъемЛитров = Значение;
			ИначеЕсли Единица = "мл" ИЛИ Единица = "ml" Тогда
				Результат.ОбъемЛитров = Значение / 1000;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Если Результат.Крепость > 100 Тогда
		Результат.Крепость = 0;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЭтоЦифра(Символ)

	Возврат СтрНайти("0123456789", Символ) > 0 И Символ <> "";

КонецФункции

Функция ЧислоИзТекста(Текст)

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция ДлинаАлкокода()

	Возврат 19;

КонецФункции

// Алкокод в данных строки УПД. Стандартного поля в УПД нет - поставщики кладут
// его в ИнфПолФХЖ2 (Идентиф = «АлкКод», «КодЕГАИС», «AlcCode»...) или отдельным
// ключом с таким именем. Берётся значение из 19 цифр.
Функция АлкокодИзДанных(Данные, Глубина)

	Если Данные = Неопределено ИЛИ Глубина > 8 Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Для Каждого Элемент Из Данные Цикл
			Алкокод = АлкокодИзДанных(Элемент, Глубина + 1);
			Если ЗначениеЗаполнено(Алкокод) Тогда
				Возврат Алкокод;
			КонецЕсли;
		КонецЦикла;
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Данные) <> Тип("Структура") И ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	// Пара Идентиф/Значен (ИнфПолФХЖ2)
	Идентификатор = СтрокойИлиПусто(ЗначениеПоля(Данные, "Идентиф"));
	Если ЭтоИмяАлкокода(Идентификатор) Тогда
		Код = ТолькоЦифры(ЗначениеПоля(Данные, "Значен", ""));
		Если СтрДлина(Код) = ДлинаАлкокода() Тогда
			Возврат Код;
		КонецЕсли;
	КонецЕсли;

	Для Каждого КлючИЗначение Из Данные Цикл
		Если ЭтоИмяАлкокода(Строка(КлючИЗначение.Ключ)) Тогда
			Код = ТолькоЦифры(КлючИЗначение.Значение);
			Если СтрДлина(Код) = ДлинаАлкокода() Тогда
				Возврат Код;
			КонецЕсли;
		КонецЕсли;
		Алкокод = АлкокодИзДанных(КлючИЗначение.Значение, Глубина + 1);
		Если ЗначениеЗаполнено(Алкокод) Тогда
			Возврат Алкокод;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЭтоИмяАлкокода(Имя)

	Текст = НРег(Имя);
	Возврат СтрНайти(Текст, "алк") > 0 ИЛИ СтрНайти(Текст, "alc") > 0
		ИЛИ СтрНайти(Текст, "егаис") > 0 ИЛИ СтрНайти(Текст, "egais") > 0
		ИЛИ СтрНайти(Текст, "фсрар") > 0 ИЛИ СтрНайти(Текст, "fsrar") > 0;

КонецФункции

// Значение первого ключа с таким именем в дереве данных строки УПД.
Функция ЗначениеКлючаВДанных(Данные, Ключ, Глубина)

	Если Данные = Неопределено ИЛИ Глубина > 8 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Для Каждого Элемент Из Данные Цикл
			Значение = ЗначениеКлючаВДанных(Элемент, Ключ, Глубина + 1);
			Если Значение <> Неопределено Тогда
				Возврат Значение;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Данные) <> Тип("Структура") И ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = ЗначениеПоля(Данные, Ключ);
	Если Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Данные Цикл
		Значение = ЗначениеКлючаВДанных(КлючИЗначение.Значение, Ключ, Глубина + 1);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Поле строки товара любого вида: Структура, Соответствие, строка таблицы,
// запись регистра. Нет поля - Умолчание.
Функция ЗначениеПоля(Источник, Имя, Умолчание = Неопределено)

	Если Источник = Неопределено Тогда
		Возврат Умолчание;
	ИначеЕсли ТипЗнч(Источник) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Источник.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат Умолчание;
	ИначеЕсли ТипЗнч(Источник) = Тип("Соответствие") Тогда
		Значение = Источник.Получить(Имя);
		Возврат ?(Значение = Неопределено, Умолчание, Значение);
	КонецЕсли;

	Попытка
		Значение = Источник[Имя];
	Исключение
		Возврат Умолчание;
	КонецПопытки;
	Возврат ?(Значение = Неопределено, Умолчание, Значение);

КонецФункции

Функция СтрокойИлиПусто(Значение)

	Если Значение = Неопределено ИЛИ ТипЗнч(Значение) = Тип("Структура")
		ИЛИ ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Фасад: делегирует в ЭАрМ_ПодборНоменклатуры (единая реализация).
Функция ТолькоЦифры(Значение)

	Возврат ЭАрМ_ПодборНоменклатуры.ТолькоЦифры(Значение);

КонецФункции


Процедура ДобавитьПункт(Пункты, Готово, Выполнено, Обязательный, Что, КакЗаполнить)

	Если Выполнено Тогда
		Пункты.Добавить("✅ " + Что);
	Иначе
		Пункты.Добавить(?(Обязательный, "❌ ", "⚠ ") + Что + Символы.ПС + "      → " + КакЗаполнить);
		Если Обязательный Тогда
			Готово = Ложь;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция КоличествоЗаписей(ТекстЗапроса)

	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И Выборка.Количество <> Null Тогда
			Возврат Выборка.Количество;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЭАрМ.АлкогольЕГАИС", УровеньЖурналаРегистрации.Предупреждение,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат 0;

КонецФункции

// Отвечает ли УТМ по HTTP. Адрес из настроек обмена бывает с протоколом и путём.
//
// Возвращаемое значение:
//   Структура - Успех (Булево), Адрес, Текст (Строка)
//
Функция ПроверитьУТМ(Знач Адрес, Знач Порт)

	Хост = СокрЛП(Адрес);
	Для Каждого Префикс Из СтрРазделить("http://,https://", ",") Цикл
		Если СтрНачинаетсяС(НРег(Хост), Префикс) Тогда
			Хост = Сред(Хост, СтрДлина(Префикс) + 1);
		КонецЕсли;
	КонецЦикла;
	Если СтрНайти(Хост, "/") > 0 Тогда
		Хост = Лев(Хост, СтрНайти(Хост, "/") - 1);
	КонецЕсли;
	Если СтрНайти(Хост, ":") > 0 Тогда
		ПортИзАдреса = Сред(Хост, СтрНайти(Хост, ":") + 1);
		Хост = Лев(Хост, СтрНайти(Хост, ":") - 1);
		Если НЕ ЗначениеЗаполнено(Порт) Тогда
			Порт = ЧислоИзТекста(ТолькоЦифры(ПортИзАдреса));
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Порт) Тогда
		Порт = 8080;
	КонецЕсли;

	Результат = Новый Структура("Успех, Адрес, Текст", Ложь, Хост + ":" + Формат(Порт, "ЧГ=0"), "");
	Если НЕ ЗначениеЗаполнено(Хост) Тогда
		Результат.Текст = "адрес УТМ не указан";
		Возврат Результат;
	КонецЕсли;

	Попытка
		Соединение = Новый HTTPСоединение(Хост, Порт, , , , 5);
		Ответ = Соединение.Получить(Новый HTTPЗапрос("/"));
		Результат.Успех = Ответ.КодСостояния < 500;
		Результат.Текст = "отвечает, код " + Ответ.КодСостояния;
	Исключение
		Результат.Текст = "не отвечает: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция НастройкаБулево(Ключ, Умолчание)

	Значение = ЭАрМ_НастройкиСервер.ЗначениеНастройки(Ключ);
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Умолчание;

КонецФункции

#КонецОбласти

#Область СтатичныйКлассификаторВидов

// Классификатор видов продукции ЕГАИС таблицей.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Код                   - Строка - код вида продукции ЕГАИС
//     * Наименование          - Строка
//     * ОКПД2                 - Строка - пусто у групп видов
//     * ГруппаПродукции       - Строка - АП, ЭС, ССПП, ССНП, ФАРМ, СЛС; пусто у групп
//     * Маркируемый           - Булево - маркируется марками ЕГАИС
//     * ВидЛицензии           - ПеречислениеСсылка.ВидыЛицензийАлкогольнойПродукции
//     * ВидПодакцизногоТовара - ПеречислениеСсылка.ВидыПодакцизныхТоваровИС - только
//                               водка, коньяк и бренди; остальное даёт сервис 1С
//
Функция ДанныеКлассификатораВидов()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Код",                   Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Наименование",          Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ОКПД2",                 Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ГруппаПродукции",       Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Маркируемый",           Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ВидЛицензии",           Новый ОписаниеТипов("ПеречислениеСсылка.ВидыЛицензийАлкогольнойПродукции"));
	Таблица.Колонки.Добавить("ВидПодакцизногоТовара", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыПодакцизныхТоваровИС"));

	Для Каждого Текст Из СтрРазделить(ДанныеКлассификатораВидовТекст(), Символы.ПС, Ложь) Цикл

		Поля = СтрРазделить(Текст, ";");
		Если Поля.Количество() < 5 Тогда
			Продолжить;
		КонецЕсли;

		Вид = Таблица.Добавить();
		Вид.Код             = СокрЛП(Поля[0]);
		Вид.Наименование    = СокрЛП(Поля[1]);
		Вид.ОКПД2           = СокрЛП(Поля[2]);
		Вид.ГруппаПродукции = СокрЛП(Поля[3]);
		Вид.Маркируемый     = (СокрЛП(Поля[4]) = "1");

		// Как в УТ (Обработка.КлассификаторыЕГАИС): АП без марок - пиво
		Если Вид.ГруппаПродукции = "АП" Тогда
			Вид.ВидЛицензии = ?(Вид.Маркируемый,
				Перечисления.ВидыЛицензийАлкогольнойПродукции.АлкогольнаяПродукция,
				Перечисления.ВидыЛицензийАлкогольнойПродукции.Пиво);
		ИначеЕсли Вид.ГруппаПродукции = "ССНП" Тогда
			Вид.ВидЛицензии = Перечисления.ВидыЛицензийАлкогольнойПродукции.СпиртосодержащаяНеПищеваяПродукция;
		ИначеЕсли Вид.ГруппаПродукции = "ССПП" Тогда
			Вид.ВидЛицензии = Перечисления.ВидыЛицензийАлкогольнойПродукции.СпиртосодержащаяПищеваяПродукция;
		ИначеЕсли Вид.ГруппаПродукции = "ЭС" Тогда
			Вид.ВидЛицензии = Перечисления.ВидыЛицензийАлкогольнойПродукции.Спирт;
		КонецЕсли;

		Если Вид.ГруппаПродукции = "АП" Тогда
			Если СтрНачинаетсяС(Вид.Код, "200") Тогда
				Вид.ВидПодакцизногоТовара = Перечисления.ВидыПодакцизныхТоваровИС.Водка;
			ИначеЕсли СтрНачинаетсяС(Вид.Наименование, "Коньяк") Тогда
				Вид.ВидПодакцизногоТовара = Перечисления.ВидыПодакцизныхТоваровИС.Коньяк;
			ИначеЕсли СтрНачинаетсяС(Вид.Наименование, "Бренди") Тогда
				Вид.ВидПодакцизногоТовара = Перечисления.ВидыПодакцизныхТоваровИС.БрендиИАлкогольнаяПродукцияИзВинныхДистилятов;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Таблица.Индексы.Добавить("Код");
	Возврат Таблица;

КонецФункции

