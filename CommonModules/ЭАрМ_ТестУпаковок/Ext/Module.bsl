////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// Тест упаковок: УПД / ЭТрН приходят коробками, в УТ учёт штуками.
//
// Ничего не пишет в базу. Для каждого сценария кладёт в папку
//   ...\ОбменЭдо_08_09_2026\ТестОбмен\Упаковки
// четыре файла: upd_*, etrn_*, dalion_ЗаказПоставщику_*, dalion_ПриходнаяНакладная_*
// и общий ожидания.json, затем проверяет расчёт: штуки = количество x коэффициент,
// цена за штуку = цена за коробку / коэффициент, контрольные цифры штрихкодов.
//
// Файлы можно положить в incoming тестового обмена и прогнать приём вручную.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Запускается кнопкой «Тест упаковок» на форме настроек ЭДО.
//
// Возвращаемое значение:
//   Строка - протокол для поля статуса
//
Функция ЗапуститьТест() Экспорт

	Протокол = Новый Массив;

	Попытка

		Каталог = КаталогТеста();
		ОчиститьКаталог(Каталог);
		ДатаТеста = ТекущаяДата();

		Протокол.Добавить("Каталог: " + Каталог);
		Протокол.Добавить("Дата теста: " + Формат(ДатаТеста, "ДФ=dd.MM.yyyy"));

		Ожидания = Новый Массив;
		ВсегоОшибок = 0;

		Для Каждого Сценарий Из Сценарии() Цикл

			Итог = ВыпуститьСценарий(Сценарий, Каталог, ДатаТеста);
			Ожидания.Добавить(Итог.Ожидание);
			ВсегоОшибок = ВсегоОшибок + Итог.Ошибки.Количество();

			Протокол.Добавить(СтрШаблон("%1. %2: %3 стр., %4 - %5",
				Сценарий.Номер, Сценарий.Название, Итог.Ожидание.Строки.Количество(),
				Итог.Ожидание.Ожидается, ?(Итог.Ошибки.Количество() = 0, "расчёт верен", "ОШИБКА")));
			Для Каждого Ошибка Из Итог.Ошибки Цикл
				Протокол.Добавить("   ! " + Ошибка);
			КонецЦикла;

		КонецЦикла;

		ЗаписатьJSONВФайл(ОбъединитьПуть(Каталог, "ожидания.json"), Ожидания);

		Протокол.Добавить(СтрШаблон("Сценариев: %1, файлов: %2, ошибок расчёта: %3",
			Ожидания.Количество(), Ожидания.Количество() * 4 + 1, ВсегоОшибок));

	Исключение
		Возврат "Ошибка теста упаковок: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат СтрСоединить(Протокол, Символы.ПС);

КонецФункции

// Количество в штуках по количеству в документе и коэффициенту упаковки.
//
Функция ПересчитатьВШтуки(Количество, Коэффициент) Экспорт

	Возврат Количество * ?(Коэффициент > 0, Коэффициент, 1);

КонецФункции

// Штрихкод EAN-13 / GTIN-14 с верной контрольной цифрой.
//
Функция ШтрихкодКорректен(Штрихкод) Экспорт

	Длина = СтрДлина(Штрихкод);
	Если Длина <> 13 И Длина <> 14 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Прав(Штрихкод, 1) = КонтрольнаяЦифра(Лев(Штрихкод, Длина - 1));

КонецФункции

#КонецОбласти

#Область Сценарии

Функция Сценарии()

	Результат = Новый Массив;

	// 1. Замороженные овощи: в УПД коробки, в УТ штуки
	Результат.Добавить(НовыйСценарий(1, "ОвощиКоробки", "Овощи в коробках: УПД коробки, УТ штуки",
		СтрокаСценария("Смесь овощная заморож. 400 г", "OV400", "0710 80", 12, 5, "кор", 960, "Коробка", 12)));

	// 2. Контроль: штуки и в УПД, и в УТ
	Результат.Добавить(НовыйСценарий(2, "ШтукиШтуки", "Контроль: штуки в УПД и в УТ",
		СтрокаСценария("Смесь овощная заморож. 400 г", "OV400", "0710 80", 12, 60, "шт", 80, "Штука", 12)));

	// 3. Смешанный документ
	Результат.Добавить(НовыйСценарий(3, "Смешанный", "Смешанный документ: коробки и штуки",
		СтрокаСценария("Горошек зелёный заморож. 400 г", "GR400", "0710 21", 12, 3, "кор", 840, "Коробка", 12),
		СтрокаСценария("Кукуруза заморож. 400 г", "KU400", "0710 40", 12, 24, "шт", 75, "Штука", 12)));

	// 4. У одной позиции несколько штрихкодов
	Результат.Добавить(НовыйСценарий(4, "МногоШтрихкодов", "Три штрихкода у строки: штука, блок, коробка",
		СтрокаСценария("Брокколи заморож. 400 г", "BR400", "0710 80", 20, 2, "кор", 1900, "Штука,Блок,Коробка", 20)));

	// 5. Карточка есть, упаковки нет: в документе только коробка
	Результат.Добавить(НовыйСценарий(5, "ТолькоКоробка", "Только штрихкод коробки: упаковки в УТ нет",
		СтрокаСценария("Картофель фри заморож. 450 г", "KF450", "2004 10", 10, 3, "кор", 1150, "Коробка", 0)));

	// 6. Расхождение коэффициента
	Результат.Добавить(НовыйСценарий(6, "РасхождениеКоэффициента", "В УПД 12 в коробке, в УТ упаковка на 10",
		СтрокаСценария("Ягодная смесь заморож. 300 г", "YA300", "0811 90", 12, 2, "кор", 1320, "Коробка", 10)));

	// 7. Расхождение количества между УПД и ЭТрН
	Сценарий7 = НовыйСценарий(7, "РасхождениеКоличества", "УПД 5 коробок, ЭТрН 4 коробки",
		СтрокаСценария("Цветная капуста заморож. 400 г", "CK400", "0710 80", 12, 5, "кор", 1020, "Коробка", 12));
	Сценарий7.ЭТрНМинусКоробок = 1;
	Результат.Добавить(Сценарий7);

	// 8. Алкоголь: бутылка - единица хранения, в коробке 6
	Результат.Добавить(НовыйСценарий(8, "Алкоголь", "Вино: бутылка и коробка по 6",
		СтрокаСценария("Вино красное сухое 0,75 л", "VN075", "2204 21", 6, 4, "кор", 3600, "Штука,Коробка", 6)));

	// 9. Без штрихкода: остаётся ручная пара
	Результат.Добавить(НовыйСценарий(9, "БезШтрихкода", "Нет штрихкода: ручная пара",
		СтрокаСценария("Шпинат заморож. 400 г", "SP400", "0710 30", 12, 5, "кор", 780, "", 12)));

	// 10. Новый товар: нет ни карточки, ни штрихкода в УТ
	СтрокаНового = СтрокаСценария("Фасоль стручковая заморож. 400 г", "FS400", "0710 22", 12, 4, "кор", 900, "Штука,Коробка", 0);
	СтрокаНового.ВУТ = Ложь;
	Результат.Добавить(НовыйСценарий(10, "НовыйТовар", "Новый товар: создать карточку и упаковку", СтрокаНового));

	Возврат Результат;

КонецФункции

Функция НовыйСценарий(Номер, Ключ, Название, Строка1, Строка2 = Неопределено)

	Строки = Новый Массив;
	Строки.Добавить(Строка1);
	Если Строка2 <> Неопределено Тогда
		Строки.Добавить(Строка2);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Номер", Номер);
	Результат.Вставить("Ключ", Ключ);
	Результат.Вставить("Название", Название);
	Результат.Вставить("Строки", Строки);
	Результат.Вставить("ЭТрНМинусКоробок", 0);

	Возврат Результат;

КонецФункции

// Параметры:
//   ВКоробке   - Число - штук в коробке
//   Количество - Число - количество в документе, в единице ЕдДок
//   ШК         - Строка - какие штрихкоды есть в документе: Штука, Блок, Коробка
//   КоэффУТ    - Число - коэффициент упаковки в УТ; 0 - упаковки нет
//
Функция СтрокаСценария(Наименование, Артикул, ТНВЭД, ВКоробке, Количество, ЕдДок, ЦенаДок, ШК, КоэффУТ)

	Результат = Новый Структура;
	Результат.Вставить("Наименование", Наименование);
	Результат.Вставить("Артикул", Артикул);
	Результат.Вставить("ТНВЭД", СтрЗаменить(ТНВЭД, " ", ""));
	Результат.Вставить("ВКоробке", ВКоробке);
	Результат.Вставить("Количество", Количество);
	Результат.Вставить("ЕдДок", ЕдДок);
	Результат.Вставить("ЦенаДок", ЦенаДок);
	Результат.Вставить("ШК", ШК);
	Результат.Вставить("КоэффУТ", КоэффУТ);
	Результат.Вставить("ВУТ", Истина);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Выпуск

Функция ВыпуститьСценарий(Сценарий, Каталог, ДатаТеста)

	Ошибки = Новый Массив;
	Номер = Сценарий.Номер;

	СтрокиУПД = Новый Массив;
	СтрокиЭТрН = Новый Массив;
	ТоварыЗаказа = Новый Массив;
	ТоварыПрихода = Новый Массив;
	СтрокиОжидания = Новый Массив;
	СуммаУПД = 0;
	ВсегоШтук = 0;

	НомерСтроки = 0;
	Для Каждого Позиция Из Сценарий.Строки Цикл

		НомерСтроки = НомерСтроки + 1;
		ЭтоКоробка = Позиция.ЕдДок = "кор";
		Коэффициент = ?(ЭтоКоробка, Позиция.ВКоробке, 1);

		Штрихкоды = ШтрихкодыСтроки(Номер, НомерСтроки);
		ВДокументе = ШтрихкодыВДокументе(Штрихкоды, Позиция.ШК);

		КоличествоЭТрН = Позиция.Количество - ?(Сценарий.ЭТрНМинусКоробок > 0 И ЭтоКоробка, Сценарий.ЭТрНМинусКоробок, 0);
		Штук = ПересчитатьВШтуки(Позиция.Количество, Коэффициент);
		ШтукЭТрН = ПересчитатьВШтуки(КоличествоЭТрН, Коэффициент);
		ЦенаШтуки = Окр(Позиция.ЦенаДок / Коэффициент, 4);
		Сумма = Окр(Позиция.Количество * Позиция.ЦенаДок, 2);
		СуммаНДС = Окр(Сумма * 10 / 110, 2);
		СуммаУПД = СуммаУПД + Сумма;
		ВсегоШтук = ВсегоШтук + Штук;

		// Проверки расчёта
		Разница = Сумма - ЦенаШтуки * Штук;
		Если Макс(Разница, -Разница) > 0.5 Тогда
			Ошибки.Добавить(СтрШаблон("%1: цена за штуку x штуки <> сумма", Позиция.Наименование));
		КонецЕсли;
		// Разбор штрихкодов тем же кодом, что создаёт номенклатуру
		Разобранные = ЭАрМ_УпаковкиНоменклатуры.РазобратьШтрихкоды(ВДокументе);
		Если ЗначениеЗаполнено(Разобранные.Коробка) <> (СтрНайти(Позиция.ШК, "Коробка") > 0) Тогда
			Ошибки.Добавить(СтрШаблон("%1: штрихкод коробки разобран неверно (%2)",
				Позиция.Наименование, Разобранные.Коробка));
		КонецЕсли;
		Если ЗначениеЗаполнено(Разобранные.Штука)
			<> (СтрНайти(Позиция.ШК, "Штука") > 0 ИЛИ СтрНайти(Позиция.ШК, "Блок") > 0) Тогда
			Ошибки.Добавить(СтрШаблон("%1: штрихкод штуки разобран неверно (%2)",
				Позиция.Наименование, Разобранные.Штука));
		КонецЕсли;
		Для Каждого Штрихкод Из Штрихкоды Цикл
			Если НЕ ШтрихкодКорректен(Штрихкод.Значение) Тогда
				Ошибки.Добавить(СтрШаблон("%1: неверная контрольная цифра %2", Позиция.Наименование, Штрихкод.Значение));
			КонецЕсли;
		КонецЦикла;
		Если ЭтоКоробка И Штук <> Позиция.Количество * Позиция.ВКоробке Тогда
			Ошибки.Добавить(СтрШаблон("%1: пересчёт в штуки дал %2", Позиция.Наименование, Штук));
		КонецЕсли;

		УПДСтрока = Новый Структура;
		УПДСтрока.Вставить("НомерПозиции", НомерСтроки);
		УПДСтрока.Вставить("Наименование", Позиция.Наименование);
		УПДСтрока.Вставить("Артикул", Позиция.Артикул);
		УПДСтрока.Вставить("КодТНВЭД", Позиция.ТНВЭД);
		УПДСтрока.Вставить("Штрихкод", ?(ВДокументе.Количество() > 0, ВДокументе[0], ""));
		УПДСтрока.Вставить("Штрихкоды", ВДокументе);
		УПДСтрока.Вставить("ЕдиницаИзмерения", Позиция.ЕдДок);
		УПДСтрока.Вставить("Количество", Позиция.Количество);
		УПДСтрока.Вставить("Цена", Позиция.ЦенаДок);
		УПДСтрока.Вставить("Сумма", Сумма);
		УПДСтрока.Вставить("СуммаНДС", СуммаНДС);
		СтрокиУПД.Добавить(УПДСтрока);

		ЭТрНСтрока = Новый Структура;
		ЭТрНСтрока.Вставить("ИдентификаторСтроки", НомерСтроки);
		ЭТрНСтрока.Вставить("Номенклатура", Позиция.Наименование);
		ЭТрНСтрока.Вставить("Артикул", Позиция.Артикул);
		ЭТрНСтрока.Вставить("КоличествоМест", КоличествоЭТрН);
		ЭТрНСтрока.Вставить("ЕдиницаИзмеренияМест", ?(ЭтоКоробка, "Коробки", "Штуки"));
		ЭТрНСтрока.Вставить("ЕдиницаИзмерения", ?(ЭтоКоробка, "КОР", "ШТ"));
		ЭТрНСтрока.Вставить("Количество", КоличествоЭТрН);
		ЭТрНСтрока.Вставить("Коэффициент", Коэффициент);
		ЭТрНСтрока.Вставить("Цена", Позиция.ЦенаДок);
		ЭТрНСтрока.Вставить("Сумма", Окр(КоличествоЭТрН * Позиция.ЦенаДок, 2));
		ЭТрНСтрока.Вставить("ШтрихкодыУпаковок", ВДокументе);
		СтрокиЭТрН.Добавить(ЭТрНСтрока);

		// Заказ в штуках, приход как в УПД: коробки и ratio
		ТоварыЗаказа.Добавить(СтрокаДалиона(НомерСтроки, Позиция, Штрихкоды, ВДокументе, Штук, 1, ЦенаШтуки));
		ТоварыПрихода.Добавить(СтрокаДалиона(НомерСтроки, Позиция, Штрихкоды, ВДокументе,
			КоличествоЭТрН, Коэффициент, Позиция.ЦенаДок));

		Ожид = Новый Структура;
		Ожид.Вставить("Наименование", Позиция.Наименование);
		Ожид.Вставить("ВДокументе", Позиция.Количество);
		Ожид.Вставить("ЕдДок", Позиция.ЕдДок);
		Ожид.Вставить("Коэффициент", Коэффициент);
		Ожид.Вставить("ШтукУПД", Штук);
		Ожид.Вставить("ШтукЭТрН", ШтукЭТрН);
		Ожид.Вставить("ЦенаЗаШтуку", ЦенаШтуки);
		Ожид.Вставить("Штрихкоды", ВДокументе);
		Ожид.Вставить("Итог", ИтогСтроки(Позиция, Штук, ШтукЭТрН, ВДокументе.Количество()));
		СтрокиОжидания.Добавить(Ожид);

	КонецЦикла;

	Идентификатор = "ТЕСТУПАК-" + Формат(Номер, "ЧЦ=2; ЧВН=; ЧГ=0");
	НомерДок = "УП-" + Формат(Номер, "ЧЦ=2; ЧВН=; ЧГ=0");
	Метка = Формат(ДатаТеста, "ДФ=yyyyMMddHHmmss");

	УПД = Новый Структура;
	УПД.Вставить("type", "УПД");
	УПД.Вставить("id", Идентификатор);
	УПД.Вставить("number", НомерДок);
	УПД.Вставить("date", ДатаISO(ДатаТеста));
	УПД.Вставить("counterparty", Новый Структура("name, inn", "ООО ТЕСТ Упаковки", "7703000003"));
	УПД.Вставить("amount", СуммаУПД);
	УПД.Вставить("Товары", СтрокиУПД);
	ЗаписатьJSONВФайл(ОбъединитьПуть(Каталог, СтрШаблон("upd_%1_%2.json", Номер, Сценарий.Ключ)), УПД);

	ЭТрН = Новый Структура;
	ЭТрН.Вставить("type", "ЭТрН");
	ЭТрН.Вставить("id", Идентификатор + "-ЭТРН");
	ЭТрН.Вставить("ВходящийНомер", НомерДок);
	ЭТрН.Вставить("Дата", ДатаISO(ДатаТеста));
	ЭТрН.Вставить("Контрагент", Новый Структура("Название, ИНН, КПП", "ООО ТЕСТ Упаковки", "7703000003", ""));
	ЭТрН.Вставить("Товары", СтрокиЭТрН);
	ЗаписатьJSONВФайл(ОбъединитьПуть(Каталог, СтрШаблон("etrn_%1_%2.json", Номер, Сценарий.Ключ)), ЭТрН);

	UidЗаказа = Строка(Новый УникальныйИдентификатор);
	UidПрихода = Строка(Новый УникальныйИдентификатор);
	Заказ = ПакетДалиона("ЗаказПоставщику", UidЗаказа, "З-" + НомерДок, ДатаТеста, ТоварыЗаказа, Сценарий, "");
	Приход = ПакетДалиона("ПриходнаяНакладная", UidПрихода, "П-" + НомерДок, ДатаТеста, ТоварыПрихода, Сценарий, UidЗаказа);
	ЗаписатьJSONВФайл(ОбъединитьПуть(Каталог, СтрШаблон("dalion_ЗаказПоставщику_%1_%2_%3.json",
		Сценарий.Ключ, UidЗаказа, Метка)), Заказ);
	ЗаписатьJSONВФайл(ОбъединитьПуть(Каталог, СтрШаблон("dalion_ПриходнаяНакладная_%1_%2_%3.json",
		Сценарий.Ключ, UidПрихода, Метка)), Приход);

	Ожидание = Новый Структура;
	Ожидание.Вставить("Сценарий", Сценарий.Номер);
	Ожидание.Вставить("Название", Сценарий.Название);
	Ожидание.Вставить("УПД", НомерДок);
	Ожидание.Вставить("Ожидается", СтрШаблон("в УТ %1 шт.", ВсегоШтук));
	Ожидание.Вставить("Строки", СтрокиОжидания);

	Возврат Новый Структура("Ожидание, Ошибки", Ожидание, Ошибки);

КонецФункции

// Что должно произойти со строкой при приёме и сверке.
//
Функция ИтогСтроки(Позиция, Штук, ШтукЭТрН, КоличествоШК)

	Если КоличествоШК = 0 Тогда
		Возврат "Нет штрихкода: пара только вручную";
	КонецЕсли;
	Если НЕ Позиция.ВУТ Тогда
		Возврат "Нет в УТ: создать карточку, упаковку и штрихкоды";
	КонецЕсли;
	Если Штук <> ШтукЭТрН Тогда
		Возврат СтрШаблон("Расхождение количества: УПД %1 шт, ЭТрН %2 шт", Штук, ШтукЭТрН);
	КонецЕсли;
	Если Позиция.ЕдДок = "кор" И Позиция.КоэффУТ = 0 Тогда
		Возврат "Упаковки нет: создать упаковку на " + Позиция.ВКоробке + " и штрихкод коробки";
	КонецЕсли;
	Если Позиция.ЕдДок = "кор" И Позиция.КоэффУТ <> Позиция.ВКоробке Тогда
		Возврат СтрШаблон("Расхождение коэффициента: документ %1, УТ %2 - не перезаписывать, показать человеку",
			Позиция.ВКоробке, Позиция.КоэффУТ);
	КонецЕсли;

	Возврат "Сходится: " + Штук + " шт.";

КонецФункции

#КонецОбласти

#Область Далион

Функция СтрокаДалиона(НомерСтроки, Позиция, Штрихкоды, ВДокументе, Количество, Коэффициент, Цена)

	Описания = Новый Массив;
	Для Каждого Штрихкод Из ВДокументе Цикл
		Описания.Добавить(Новый Структура("barcode", Штрихкод));
	КонецЦикла;

	Номенклатура = Новый Структура;
	Номенклатура.Вставить("uid", Строка(Новый УникальныйИдентификатор));
	Номенклатура.Вставить("name", Позиция.Наименование);
	Номенклатура.Вставить("code", Позиция.Артикул);
	Номенклатура.Вставить("article", Позиция.Артикул);
	Номенклатура.Вставить("fullName", Позиция.Наименование);
	Номенклатура.Вставить("unit", Новый Структура("name", "шт"));
	Номенклатура.Вставить("barcodes", Описания);

	Сумма = Окр(Количество * Цена, 2);

	Результат = Новый Структура;
	Результат.Вставить("lineNumber", НомерСтроки);
	Результат.Вставить("nomenclature", Номенклатура);
	Результат.Вставить("item", Новый Структура("article", Позиция.Артикул));
	Результат.Вставить("quantity", Количество);
	Результат.Вставить("ratio", Коэффициент);
	Результат.Вставить("price", Цена);
	Результат.Вставить("amount", Сумма);
	Результат.Вставить("vatAmount", Окр(Сумма * 10 / 110, 2));
	Результат.Вставить("barcode", ?(ВДокументе.Количество() > 0, ВДокументе[0], ""));
	Результат.Вставить("barcodes", Описания);

	Возврат Результат;

КонецФункции

Функция ПакетДалиона(ТипДокумента, Uid, Номер, ДатаТеста, Товары, Сценарий, UidЗаказа)

	Сумма = 0;
	Для Каждого Товар Из Товары Цикл
		Сумма = Сумма + Товар.amount;
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("uid", Uid);
	Данные.Вставить("versionNumber", 1);
	Данные.Вставить("number", Номер);
	Данные.Вставить("date", ДатаISO(ДатаТеста));
	Данные.Вставить("modifiedAt", ДатаISO(ДатаТеста));
	Данные.Вставить("posted", Истина);
	Данные.Вставить("deletionMark", Ложь);
	Данные.Вставить("company", Новый Структура("uid, name, code", Строка(Новый УникальныйИдентификатор), "Организация-Тест, ООО", "ORG"));
	Данные.Вставить("counterparty", Новый Структура("uid, name, code, inn, kpp",
		Строка(Новый УникальныйИдентификатор), "ООО ТЕСТ Упаковки", "C", "7703000003", ""));
	Данные.Вставить("warehouse", Новый Структура("uid, name, code", Строка(Новый УникальныйИдентификатор), "Склад тест", "WH"));
	Данные.Вставить("comment", "ТЕСТ упаковок: " + Сценарий.Название);
	Данные.Вставить("amount", Сумма);
	Данные.Вставить("useVat", Истина);
	Данные.Вставить("vatIncluded", Истина);
	Если ТипДокумента = "ПриходнаяНакладная" Тогда
		Данные.Вставить("incomingNumber", "УП-" + Формат(Сценарий.Номер, "ЧЦ=2; ЧВН=; ЧГ=0"));
		Данные.Вставить("basis", Новый Структура("purchaseOrder", Новый Структура("uid, name", UidЗаказа, "З-" + Номер)));
	КонецЕсли;
	Данные.Вставить("goods", Товары);

	Состав = Новый Массив;
	Состав.Добавить("document");
	Состав.Добавить("counterparty");
	Состав.Добавить("contract");
	Состав.Добавить("nomenclature");
	Состав.Добавить("barcodes");

	Заголовок = Новый Структура;
	Заголовок.Вставить("type", ТипДокумента);
	Заголовок.Вставить("export", ТипДокумента);
	Заголовок.Вставить("contents", Состав);
	Заголовок.Вставить("trigger", "test");
	Заголовок.Вставить("version", "1.0");
	Заголовок.Вставить("source", "DALION");
	Заголовок.Вставить("created", Данные.modifiedAt);
	Заголовок.Вставить("requestId", Uid);

	Возврат Новый Структура("header, data", Заголовок, Данные);

КонецФункции

#КонецОбласти

#Область Штрихкоды

// Три штрихкода строки: штука и блок (EAN-13), коробка (GTIN-14 от штуки).
//
Функция ШтрихкодыСтроки(НомерСценария, НомерСтроки)

	Основа = "4609" + Формат(НомерСценария * 10000 + НомерСтроки * 100, "ЧЦ=8; ЧВН=; ЧГ=0");

	Штука = Лев(Основа, 11) + "1";
	Блок = Лев(Основа, 11) + "2";
	Штука = Штука + КонтрольнаяЦифра(Штука);
	Блок = Блок + КонтрольнаяЦифра(Блок);
	Коробка = "1" + Лев(Штука, 12);
	Коробка = Коробка + КонтрольнаяЦифра(Коробка);

	Результат = Новый Структура;
	Результат.Вставить("Штука", Штука);
	Результат.Вставить("Блок", Блок);
	Результат.Вставить("Коробка", Коробка);

	Возврат Результат;

КонецФункции

Функция ШтрихкодыВДокументе(Штрихкоды, Перечень)

	Результат = Новый Массив;

	Для Каждого Имя Из СтрРазделить(Перечень, ",", Ложь) Цикл
		Результат.Добавить(Штрихкоды[СокрЛП(Имя)]);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КонтрольнаяЦифра(Цифры)

	Сумма = 0;
	Длина = СтрДлина(Цифры);

	Для Позиция = 1 По Длина Цикл
		Цифра = Число(Сред(Цифры, Позиция, 1));
		Сумма = Сумма + Цифра * ?((Длина - Позиция) % 2 = 0, 3, 1);
	КонецЦикла;

	Возврат Формат((10 - Сумма % 10) % 10, "ЧЦ=1; ЧГ=0");

КонецФункции

#КонецОбласти

#Область ТестСверки

// Кнопка «Тест приёма и сверки» в настройках ЭДО - единственный тест приёма.
//
// Папка - из поля под кнопкой; пусто - подпапка «Тест_сверки» папки пакетов
// Далиона из настроек (сама папка пакетов тестом не трогается).
//   * Количество больше 0 - в папке создаётся новая подпапка «Прогон_<дата_время>»,
//     в ней XML УПД и УКД тестового поставщика «ООО ТЕСТ Сверки» (формат ФНС,
//     штрихкод строки - в ДопСведТов/ГТИН) по всем сценариям УКД и аннулирования,
//     ПроцентРасхождений поставок - с расхождением (СоздатьXMLТестаСверки). Старые
//     XML в тест не попадают: каждый прогон - свои файлы.
//   * Количество = 0 - тест по своим XML из папки (скачанным из СБИС).
// Дальше один путь - СоздатьТестИзXMLУПД: УПД в реестр боевым разбором и боевой
// записью товаров, рядом заказ и приходная Далиона, полный проход приёма по папке,
// итог по каждой поставке.
//
// Параметры:
//   Папка              - Строка
//   Количество         - Число - сколько поставок создать; 0 - свои XML из папки
//   ПроцентРасхождений - Число - доля поставок с расхождением, 0-100
//
// Возвращаемое значение:
//   Строка - протокол для поля статуса формы
//
Функция ТестПриемаИСверки(Папка, Количество = 0, ПроцентРасхождений = 80) Экспорт

	Каталог = СокрЛП(Папка);
	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		Корень = СокрЛП(ЭАрМ_НастройкиСервер.НастройкиЦепочки().КаталогПакетов);
		Если НЕ ЗначениеЗаполнено(Корень) Тогда
			Возврат "Укажите папку теста в поле под кнопкой или папку пакетов Далиона в настройках ЭДО.";
		КонецЕсли;
		Каталог = ОбъединитьПуть(Корень, "Тест_сверки");
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("Версия расширения: " + ЭАрМ_НастройкиСервер.ВерсияРасширения());
	НачалоТеста = ТекущаяДатаСеанса();
	Если Количество > 0 Тогда
		ОтметитьПрогрессТеста(НовыйПрогрессТеста(Количество), 0, "создание XML УПД и УКД по сценариям");
	КонецЕсли;
	План = Неопределено;

	Попытка

		Если Количество > 0 Тогда
			// Каждый прогон - в новой подпапке: XML прошлых прогонов (в том числе без
			// УКД и сценариев аннулирования) в тест не попадают, но остаются для разбора
			Каталог = ОбъединитьПуть(Каталог, "Прогон_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmmss"));
			СоздатьКаталог(Каталог);
			План = Новый Структура;
			Строки.Добавить(СоздатьXMLТестаСверки(Каталог, Количество, ПроцентРасхождений, План));
		Иначе
			ФайлКаталога = Новый Файл(Каталог);
			ЕстьXML = ?(ФайлКаталога.Существует(), НайтиФайлы(Каталог, "*.xml", Ложь).Количество(), 0);
			Если ЕстьXML = 0 Тогда
				Возврат СтрШаблон("«Сколько поставок» = 0 - тест идёт по своим XML УПД, а в папке %1 их нет. "
					+ "Положите туда XML УПД и УКД или укажите, сколько поставок создать.", Каталог);
			КонецЕсли;
			Строки.Добавить(СтрШаблон("«Сколько поставок» = 0 - тест по своим XML из папки %1 (файлов %2); "
				+ "ожидаемый итог считается по строкам УПД, УКД и приходной", Каталог, ЕстьXML));
		КонецЕсли;

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "ТестПриемаИСверки (папка " + Каталог + ")",
			ОшибкаИсключения);
		Возврат "Тест не начат: " + ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения);
	КонецПопытки;

	Строки.Добавить("");
	Строки.Добавить(СоздатьТестИзXMLУПД(Каталог, План));

	// Что и сколько обработано за тест - сразу под версией, до подробностей
	Попытка
		Строки.Вставить(1, "ОБРАБОТАНО за тест:" + Символы.ПС + ТекстПрогрессаТеста(НачалоТеста, Ложь) + Символы.ПС);
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "Тест: итог обработки для протокола", ИнформацияОбОшибке());
	КонецПопытки;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Сколько секунд даётся проходу приёма в тесте: дальше проход сам прерывается
// с «ОШИБКА ПРОВЕРКИ» и местом, где стоял.
//
Функция СекундНаПроходТеста(Наборов = 10) Экспорт

	// 4 с на поставку, не меньше 4 минут: на 500 поставок - 2000 с
	Возврат Макс(240, Наборов * 4);

КонецФункции

// Через сколько секунд форма снимает фоновое задание теста, если оно всё ещё
// идёт (зависло внутри одного шага - запрос, блокировка, СБИС).
//
Функция СекундДоСнятияТеста(Наборов = 10) Экспорт

	// Весь тест: создание файлов и УПД, проход, итог - 8 с на поставку, не меньше 5 минут
	Возврат Макс(300, Наборов * 8);

КонецФункции

// Фоновое задание кнопки «Тест приёма и сверки»: протокол - во временное хранилище.
//
Процедура ТестПриемаИСверкиФоном(Папка, АдресРезультата, Количество = 0, ПроцентРасхождений = 80) Экспорт

	Результат = ТестПриемаИСверки(Папка, Количество, ПроцентРасхождений);
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

// Запускает тест фоновым заданием: форма не висит, а следит за ним и при
// необходимости снимает.
//
// Параметры:
//   Папка              - Строка
//   ИдентификаторФормы - УникальныйИдентификатор - для временного хранилища
//
// Возвращаемое значение:
//   Структура - Задание (УникальныйИдентификатор или Неопределено), Адрес, Начало, Ошибка
//
Функция ЗапуститьФоновыйТест(Папка, ИдентификаторФормы, Количество = 0, ПроцентРасхождений = 80) Экспорт

	Результат = Новый Структура("Задание, Адрес, Начало, Ошибка", Неопределено, "", ТекущаяДатаСеанса(), "");
	Результат.Адрес = ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы);

	Параметры = Новый Массив;
	Параметры.Добавить(Папка);
	Параметры.Добавить(Результат.Адрес);
	Параметры.Добавить(Количество);
	Параметры.Добавить(ПроцентРасхождений);

	// Прогресс прошлого теста форме не показываем
	ОтметитьПрогрессТеста(НовыйПрогрессТеста(Количество), 0, "запуск фонового задания");

	Попытка
		Задание = ФоновыеЗадания.Выполнить("ЭАрМ_ТестУпаковок.ТестПриемаИСверкиФоном", Параметры,
			"ЭАрМ_ТестПриемаИСверки", "Тест приёма и сверки");
		Результат.Задание = Задание.УникальныйИдентификатор;
		ЭАрМ_ПриемПакетовДалион.Трасса("", "Тест приёма и сверки (версия расширения "
			+ ЭАрМ_НастройкиСервер.ВерсияРасширения() + ") запущен фоном, папка «" + Папка + "»"
			+ ?(Количество > 0, СтрШаблон(", поставок %1, с расхождениями %2 процентов", Количество, ПроцентРасхождений),
				", по своим XML из папки"));
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "Тест приёма и сверки (запуск фонового задания)",
			ОшибкаИсключения);
		Результат.Ошибка = "Тест не запущен: " + ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения)
			+ " (если тест уже идёт - дождитесь его или он будет снят по времени)";
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Состояние фонового теста для формы и что он делает сейчас (последние строки трассы).
//
// Возвращаемое значение:
//   Структура - Состояние ("Активно", "Завершено", "Ошибка", "Отменено", "НеНайдено"),
//               Ошибка (Строка), Сейчас (Строка)
//
Функция СостояниеФоновогоТеста(ИдентификаторЗадания, НачалоТеста) Экспорт

	Результат = Новый Структура("Состояние, Ошибка, Сейчас, Прогресс", "НеНайдено", "", "", "");
	Результат.Сейчас = ПоследниеСтрокиТрассы(НачалоТеста, 1);
	Попытка
		Результат.Прогресс = ТекстПрогрессаТеста(НачалоТеста);
	Исключение
		Результат.Прогресс = "прогресс не прочитан: " + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
	КонецПопытки;

	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если Задание = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Результат.Состояние = "Активно";
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Результат.Состояние = "Завершено";
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		Результат.Состояние = "Ошибка";
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			Результат.Ошибка = ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		КонецЕсли;
	Иначе
		Результат.Состояние = "Отменено";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Этап теста и сколько всего - для поля статуса формы настроек. Пишется в настройку
// «ТестСверки_Прогресс» строкой «этап|номер|этапов|УПД|УКД|поставок» (несколько
// записей за тест - по одной на этап); сколько сделано, ТекстПрогрессаТеста
// считает по базе.
//
// Параметры:
//   Прогресс   - Структура - Этапов, УПД, УКД, Поставок (всего)
//   НомерЭтапа - Число
//   Этап       - Строка - без «|»
//
Процедура ОтметитьПрогрессТеста(Прогресс, НомерЭтапа, Этап) Экспорт

	Попытка
		ЭАрМ_НастройкиСервер.СохранитьНастройку("ТестСверки_Прогресс", СтрШаблон("%1|%2|%3|%4|%5|%6",
			СтрЗаменить(Этап, "|", "/"), Формат(НомерЭтапа, "ЧГ=0; ЧН=0"), Формат(Прогресс.Этапов, "ЧГ=0; ЧН=0"),
			Формат(Прогресс.УПД, "ЧГ=0; ЧН=0"), Формат(Прогресс.УКД, "ЧГ=0; ЧН=0"), Формат(Прогресс.Поставок, "ЧГ=0; ЧН=0")));
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "Тест: прогресс для формы (" + Этап + ")",
			ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Функция НовыйПрогрессТеста(Поставок = 0)

	Возврат Новый Структура("Этапов, УПД, УКД, Поставок", 8, Поставок, 0, Поставок);

КонецФункции

// Сколько обработано с начала теста и чего - по базе:
//   * УПД и УКД теста в реестрах (идентификаторы ТЕСТXML- / ТЕСТУКД-, загружены после начала);
//   * пакеты Далиона: принято, обработано, с ошибкой;
//   * цепочки: сверено и сколько с расхождениями;
//   * «ОШИБКА ПРОВЕРКИ» и прочие неуспешные шаги в трассе.
// Всего - из записи этапа (ОтметитьПрогрессТеста).
//
// Параметры:
//   НачалоТеста - Дата
//   СЭтапом     - Булево - первой строкой «Этап N из M: …»
//
// Возвращаемое значение:
//   Строка
//
Функция ТекстПрогрессаТеста(НачалоТеста, СЭтапом = Истина) Экспорт

	Части = СтрРазделить(Строка(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ТестСверки_Прогресс")), "|", Истина);
	Всего = Новый Структура("Этап, Номер, Этапов, УПД, УКД, Поставок", "", "", "", "?", "?", "?");
	Если Части.Количество() >= 6 Тогда
		Всего.Этап = Части[0];
		Всего.Номер = Части[1];
		Всего.Этапов = Части[2];
		// 0 - ещё не известно (до разбора XML)
		Всего.УПД = ?(ЗначениеЗаполнено(Части[3]) И Части[3] <> "0", Части[3], "?");
		Всего.УКД = ?(ЗначениеЗаполнено(Части[4]) И Части[4] <> "0", Части[4], "?");
		Всего.Поставок = ?(ЗначениеЗаполнено(Части[5]) И Части[5] <> "0", Части[5], "?");
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(УПД.ИдентификаторСБИС) КАК Количество
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.ИдентификаторСБИС ПОДОБНО ""ТЕСТXML-%""
	|	И УПД.ДатаЗагрузки >= &Начало
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(УКД.ИдентификаторСБИС) КАК Количество
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.ИдентификаторСБИС ПОДОБНО ""ТЕСТУКД-%""
	|	И УКД.ДатаЗагрузки >= &Начало
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА Пакеты.ДатаПриема >= &Начало ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК Принято,
	|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА Пакеты.ДатаОбработки >= &Начало И Пакеты.Статус = ""Обработан"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК Обработано,
	|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА Пакеты.Статус = ""Ошибка"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК Ошибок
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПакетыДалион КАК Пакеты
	|ГДЕ
	|	(Пакеты.ДатаПриема >= &Начало
	|			ИЛИ Пакеты.ДатаОбработки >= &Начало)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Сверено,
	|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА Цепочка.ЕстьРасхождения ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК СРасхождениями
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ДатаСверки >= &Начало
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА Трасса.Успех ТОГДА 0 ИНАЧЕ 1 КОНЕЦ), 0) КАК Неуспешных
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТрассаПриема КАК Трасса
	|ГДЕ
	|	Трасса.ДатаШага >= &Начало");
	Запрос.УстановитьПараметр("Начало", НачалоТеста);
	Результаты = Запрос.ВыполнитьПакет();

	ВыборкаУПД = Результаты[0].Выбрать();
	ВыборкаУПД.Следующий();
	ВыборкаУКД = Результаты[1].Выбрать();
	ВыборкаУКД.Следующий();
	ВыборкаПакетов = Результаты[2].Выбрать();
	ВыборкаПакетов.Следующий();
	ВыборкаЦепочек = Результаты[3].Выбрать();
	ВыборкаЦепочек.Следующий();
	ВыборкаТрассы = Результаты[4].Выбрать();
	ВыборкаТрассы.Следующий();

	Строки = Новый Массив;
	Если СЭтапом И ЗначениеЗаполнено(Всего.Этап) Тогда
		Строки.Добавить(СтрШаблон("Этап %1 из %2: %3", Всего.Номер, Всего.Этапов, Всего.Этап));
	КонецЕсли;
	Строки.Добавить(СтрШаблон("Обработано: УПД в реестре %1 из %2 · УКД %3 из %4 · пакетов Далиона принято %5 из %6, "
		+ "обработано %7, с ошибкой %8", ВыборкаУПД.Количество, Всего.УПД, ВыборкаУКД.Количество, Всего.УКД,
		ВыборкаПакетов.Принято, ?(Всего.Поставок = "?", "?", Формат(2 * Число(Всего.Поставок), "ЧГ=0")),
		ВыборкаПакетов.Обработано, ВыборкаПакетов.Ошибок));
	Строки.Добавить(СтрШаблон("Сверено цепочек %1 из %2 (с расхождениями %3) · неуспешных шагов и «ОШИБКА ПРОВЕРКИ» в трассе: %4",
		ВыборкаЦепочек.Сверено, Всего.Поставок, ВыборкаЦепочек.СРасхождениями, ВыборкаТрассы.Неуспешных));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Снимает зависший тест и объясняет, где он стоял.
//
// Возвращаемое значение:
//   Строка - сообщение пользователю
//
Функция СнятьФоновыйТест(ИдентификаторЗадания, НачалоТеста, Секунд) Экспорт

	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Попытка
			Задание.Отменить();
		Исключение
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "Тест приёма и сверки (снятие задания)",
				ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Последние = ПоследниеСтрокиТрассы(НачалоТеста, 8);
	Текст = СтрШаблон("Тест приёма и сверки СНЯТ: шёл %1 с и не закончился (лимит %2 с).
		|Где висел - последние шаги трассы (сверху - самый поздний):
		|%3
		|Если последняя строка давно не меняется - тест стоял внутри этого шага (долгий запрос,
		|блокировка записей другим сеансом или обмен с СБИС). Подробно - ТрассаПриема.log.",
		Секунд, "по расчёту формы",
		?(ЗначениеЗаполнено(Последние), Последние, "в трассе с начала теста нет ни одной строки - тест не дошёл до приёма"));

	ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки("", "Тест приёма и сверки",
		СтрШаблон("снят по времени через %1 с; последний шаг: %2", Секунд, ПоследниеСтрокиТрассы(НачалоТеста, 1)));

	Возврат Текст;

КонецФункции

// Последние строки трассы с начала теста, сверху - самая поздняя.
//
Функция ПоследниеСтрокиТрассы(Начало, Количество)

	Строки = Новый Массив;
	Попытка
		Запрос = Новый Запрос(СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ %1
		|	Трасса.ДатаШага КАК ДатаШага,
		|	Трасса.Шаг КАК Шаг,
		|	Трасса.Успех КАК Успех,
		|	Трасса.Сообщение КАК Сообщение
		|ИЗ
		|	РегистрСведений.ЭАрМ_ТрассаПриема КАК Трасса
		|ГДЕ
		|	Трасса.ДатаШага >= &Начало
		|
		|УПОРЯДОЧИТЬ ПО
		|	Трасса.ДатаШага УБЫВ", Формат(Количество, "ЧГ=0")));
		Запрос.УстановитьПараметр("Начало", Начало);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Строки.Добавить(СтрШаблон("%1 %2 %3: %4", Формат(Выборка.ДатаШага, "ДФ=HH:mm:ss"),
				?(Выборка.Успех, "OK", "СТОП"), Выборка.Шаг, Лев(Выборка.Сообщение, 300)));
		КонецЦикла;
	Исключение
		Строки.Добавить("трасса не прочитана: " + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Сценарии теста приёма и сверки - УПД тестового поставщика, её УКД и приходная.
// Строки УПД: 1 «Тест Молоко» 24 x 62,50; 2 «Тест Кефир» 12 x 71,30;
// 3 «Тест Сыр» 6 x 219,90 (цены с НДС 10%).
//
// Ожидаемый итог поставки руками не задаётся: ОпределитьОжиданиеТеста считает его
// по строкам - УПД после действующих УКД против строк приходной. Группа сценария
// («сошлось», «расхождение», «не привязана») - для доли расхождений и проверки,
// что сценарий собран так, как задуман.
//
// Здесь - поставки, которые должны сойтись: УКД всех видов и аннулирование УКД.
// Закрытая УКД (коды 19, 20, 21, 22 или без кода с текстом «Аннулирован…»,
// «Удален…», «Отозван…») не применяется - приходная по исходной УПД сходится.
// Коды 27 (ожидает аннулирования) и 40 (в аннулировании отказано) - УКД действует,
// приходная по ней. У каждой УПД - своя УКД. Порядок - по важности: при малом
// числе поставок первыми идут основные УКД и аннулирование.
//
// Возвращаемое значение:
//   Массив из Структура - см. СценарийТеста
//
Функция СценарииТестаСошлось()

	// У каждой УПД теста - своя УКД со своим сценарием: «без УКД» не создаётся
	Сценарии = Новый Массив;
	Сценарии.Добавить(СценарийТеста("УКД ▼ количество: Молоко 24 -> 20", , ИзменениеУКД(1, 20)));

	// Ожидание УКД: Кефира нет в приходной, УКД его убирает, но приходит после первой
	// сверки - сначала статус «Ожидает УКД», после УКД - сошлось
	Сценарий = СценарийТеста("НУЖНА УКД: в приходной нет Кефира, УКД Кефир 12 -> 0 приходит ПОСЛЕ первой сверки - "
		+ "сначала «Нужна УКД от поставщика», потом сошлось", , ИзменениеУКД(2, 0));
	Сценарий.ПоздниеУКД.Добавить(1);
	Сценарий.Отклонение = ОтклонениеТеста("УбратьСтроку", "Кефира нет", 2);
	Сценарии.Добавить(Сценарий);

	// Ожидание аннулирования: 27, после первой сверки отказано (40) - УКД действует всё время
	Сценарий = СценарийТеста("УКД ▼ Сыр 6 -> 4 АННУЛИРОВАНИЕ НЕ РЕШЕНО (27), после первой сверки в аннулировании "
		+ "ОТКАЗАНО (40) - действует, сошлось оба раза");
	ДобавитьУКДСценария(Сценарий, ИзменениеУКД(3, 4), СтатусДокументаТеста("27", "Ожидает аннулирования"));
	Сценарий.ПоздниеСтатусы.Вставить(1, СтатусДокументаТеста("40", "Отказано в аннулировании"));
	Сценарии.Добавить(Сценарий);

	Сценарий = СценарийТеста("УКД ▼ Молоко 24 -> 20 АННУЛИРОВАНА (код 21) - приходная по исходной УПД");
	ДобавитьУКДСценария(Сценарий, ИзменениеУКД(1, 20), СтатусДокументаТеста("21", "Аннулирован"));
	Сценарии.Добавить(Сценарий);

	Сценарии.Добавить(СценарийТеста("УКД ▲ количество: Кефир 12 -> 15", , ИзменениеУКД(2, 15)));

	Сценарий = СценарийТеста("УКД ▲ Кефир 12 -> 15 АННУЛИРОВАНИЕ НЕ РЕШЕНО (код 27) - ещё действует, приходная по ней");
	ДобавитьУКДСценария(Сценарий, ИзменениеУКД(2, 15), СтатусДокументаТеста("27", "Ожидает аннулирования"));
	Сценарии.Добавить(Сценарий);

	Сценарии.Добавить(СценарийТеста("УКД ▼ цена: Сыр 219,90 -> 199,90", , ИзменениеУКД(3, , 199.90)));

	Сценарий = СценарийТеста("УКД ▼ цена Сыр 219,90 -> 199,90, в аннулировании ОТКАЗАНО (код 40) - действует, приходная по ней");
	ДобавитьУКДСценария(Сценарий, ИзменениеУКД(3, , 199.90), СтатусДокументаТеста("40", "Отказано в аннулировании"));
	Сценарии.Добавить(Сценарий);

	Сценарии.Добавить(СценарийТеста("УКД ▲ цена: Молоко 62,50 -> 65,00", , ИзменениеУКД(1, , 65.00)));

	Сценарий = СценарийТеста("две УКД: первая (Молоко ▼ 24 -> 20) АННУЛИРОВАНА (код 21), вторая (Сыр ▲ цена 219,90 -> 229,90) действует");
	ДобавитьУКДСценария(Сценарий, ИзменениеУКД(1, 20), СтатусДокументаТеста("21", "Аннулирован"));
	ДобавитьУКДСценария(Сценарий, ИзменениеУКД(3, , 229.90));
	Сценарии.Добавить(Сценарий);

	Сценарии.Добавить(СценарийТеста("УКД ▼ товар убран: Кефир 12 -> 0", , ИзменениеУКД(2, 0)));

	Сценарий = СценарийТеста("УКД ▼ Кефир 12 -> 10 аннулирована только ТЕКСТОМ «Аннулирован» (кода нет) - приходная по исходной УПД");
	ДобавитьУКДСценария(Сценарий, ИзменениеУКД(2, 10), СтатусДокументаТеста("", "Аннулирован"));
	Сценарии.Добавить(Сценарий);

	Сценарий = СценарийТеста("УКД смешанная: Молоко ▼ 24 -> 18 и Сыр ▲ цена 219,90 -> 229,90", , ИзменениеУКД(1, 18));
	Сценарий.УКД[0].Добавить(ИзменениеУКД(3, , 229.90));
	Сценарии.Добавить(Сценарий);

	Сценарий = СценарийТеста("две УКД подряд: Молоко ▼ 24 -> 20, затем ▲ цена 62,50 -> 64,00", , ИзменениеУКД(1, 20));
	ДобавитьУКДСценария(Сценарий, ИзменениеУКД(1, , 64.00));
	Сценарии.Добавить(Сценарий);

	Сценарии.Добавить(СценарийТеста("УКД только цены без количества в файле: Кефир 71,30 -> 69,30", ,
		ИзменениеУКД(2, , 69.30, Истина)));

	Сценарий = СценарийТеста("УКД пришла ДВАЖДЫ (повтор из СБИС: тот же номер и дата): Сыр ▼ 6 -> 4 - применяется один раз", ,
		ИзменениеУКД(3, 4));
	Сценарий.ДубльУКД = 1;
	Сценарии.Добавить(Сценарий);

	Для Каждого Код Из СтрРазделить("19,20,22", ",") Цикл
		Сценарий = СценарийТеста(СтрШаблон("УКД ▼ Сыр 6 -> 5 ЗАКРЫТА в СБИС (код %1) - приходная по исходной УПД", Код));
		ДобавитьУКДСценария(Сценарий, ИзменениеУКД(3, 5), СтатусДокументаТеста(Код, "Закрыт в СБИС, код " + Код));
		Сценарии.Добавить(Сценарий);
	КонецЦикла;

	Сценарий = СценарийТеста("УКД ▲ Молоко 24 -> 26 ОТОЗВАНА (текст «Отозван», кода нет) - приходная по исходной УПД");
	ДобавитьУКДСценария(Сценарий, ИзменениеУКД(1, 26), СтатусДокументаТеста("", "Отозван отправителем"));
	Сценарии.Добавить(Сценарий);

	Возврат Сценарии;

КонецФункции

// Поставки с расхождением, собранные под отдельное правило: приходная по исходной
// при действующей УКД, УКД не закрыла недовоз, приходная по аннулированной УКД,
// аннулированная УПД. Дальше СценарийРасхождения берёт сочетания «сценарий, который
// сходится» + отклонение приходной (ОтклоненияТеста).
//
// Возвращаемое значение:
//   Массив из Структура - см. СценарийТеста
//
Функция СценарииТестаРасхождение()

	Сценарии = Новый Массив;

	Сценарий = СценарийТеста("приходная по ИСХОДНОЙ УПД, а УКД ▼ количество Молоко 24 -> 20", Истина, ИзменениеУКД(1, 20));
	Сценарии.Добавить(СценарийГруппы(Сценарий, "расхождение"));

	Сценарий = СценарийТеста("приходная по ИСХОДНОЙ УПД, а две УКД: Кефир ▲ 12 -> 15, затем Сыр ▼ цена 219,90 -> 199,90",
		Истина, ИзменениеУКД(2, 15));
	ДобавитьУКДСценария(Сценарий, ИзменениеУКД(3, , 199.90));
	Сценарии.Добавить(СценарийГруппы(Сценарий, "расхождение"));

	// Аннулирование после первой сверки: УКД действовала, приходная по ней сошлась,
	// потом УКД закрыта - УПД возвращается к исходной, приходная расходится
	Сценарий = СценарийТеста("УКД ▼ Молоко 24 -> 20 действовала, приходная по ней сошлась; ПОСЛЕ первой сверки "
		+ "УКД АННУЛИРОВАНА (21) - расхождение", , ИзменениеУКД(1, 20));
	Сценарий.ПоздниеСтатусы.Вставить(1, СтатусДокументаТеста("21", "Аннулирован"));
	Сценарии.Добавить(СценарийГруппы(Сценарий, "расхождение"));

	Сценарий = СценарийТеста("УКД ▼ Кефир 12 -> 10 АННУЛИРОВАНИЕ НЕ РЕШЕНО (27), приходная по ней сошлась; ПОСЛЕ "
		+ "первой сверки АННУЛИРОВАНА (21) - расхождение");
	ДобавитьУКДСценария(Сценарий, ИзменениеУКД(2, 10), СтатусДокументаТеста("27", "Ожидает аннулирования"));
	Сценарий.ПоздниеСтатусы.Вставить(1, СтатусДокументаТеста("21", "Аннулирован"));
	Сценарии.Добавить(СценарийГруппы(Сценарий, "расхождение"));

	Сценарий = СценарийТеста("УКД ▼ Молоко 24 -> 22 НЕ ЗАКРЫЛА недовоз: в приходной 20", , ИзменениеУКД(1, 22));
	Сценарий.Отклонение = ОтклонениеТеста("Количество", "Молоко 20 шт", 1, 20);
	Сценарии.Добавить(СценарийГруппы(Сценарий, "расхождение"));

	Сценарий = СценарийТеста("УКД ▼ Молоко 24 -> 20 АННУЛИРОВАНА (код 21), а приходная по ней");
	ДобавитьУКДСценария(Сценарий, ИзменениеУКД(1, 20), СтатусДокументаТеста("21", "Аннулирован"));
	Сценарий.ПриходПоАннулированным = Истина;
	Сценарии.Добавить(СценарийГруппы(Сценарий, "расхождение"));

	Сценарий = СценарийТеста("УКД ▲ Кефир 12 -> 15 аннулирована ТЕКСТОМ «Аннулирован» (кода нет), а приходная по ней");
	ДобавитьУКДСценария(Сценарий, ИзменениеУКД(2, 15), СтатусДокументаТеста("", "Аннулирован"));
	Сценарий.ПриходПоАннулированным = Истина;
	Сценарии.Добавить(СценарийГруппы(Сценарий, "расхождение"));

	Сценарий = СценарийТеста("УКД ▼ Сыр 6 -> 4 АННУЛИРОВАНИЕ НЕ РЕШЕНО (код 27) - ещё действует, а приходная по исходной УПД", Истина);
	ДобавитьУКДСценария(Сценарий, ИзменениеУКД(3, 4), СтатусДокументаТеста("27", "Ожидает аннулирования"));
	Сценарии.Добавить(СценарийГруппы(Сценарий, "расхождение"));

	Сценарий = СценарийТеста("УКД ▼ Молоко 24 -> 20, в аннулировании ОТКАЗАНО (код 40) - действует, а приходная по исходной УПД", Истина);
	ДобавитьУКДСценария(Сценарий, ИзменениеУКД(1, 20), СтатусДокументаТеста("40", "Отказано в аннулировании"));
	Сценарии.Добавить(СценарийГруппы(Сценарий, "расхождение"));

	// УКД к аннулированной УПД: боевая связь закрытую УПД не берёт - УКД остаётся без основания
	Сценарий = СценарийТеста("УПД АННУЛИРОВАНА (код 21), к ней УКД ▼ Молоко 24 -> 20 - приходную и УКД не к чему привязать", ,
		ИзменениеУКД(1, 20));
	Сценарий.СтатусУПД = СтатусДокументаТеста("21", "Аннулирован");
	Сценарии.Добавить(СценарийГруппы(Сценарий, "не привязана"));

	Возврат Сценарии;

КонецФункции

// Отклонения приходной от УПД после УКД: из них и сценариев «сошлось» собираются
// остальные поставки с расхождением.
//
// Возвращаемое значение:
//   Массив из Структура - см. ОтклонениеТеста
//
Функция ОтклоненияТеста()

	Отклонения = Новый Массив;
	Отклонения.Добавить(ОтклонениеТеста("Недовоз", "НЕДОВОЗ - первая строка на 2 шт меньше"));
	Отклонения.Добавить(ОтклонениеТеста("Перевоз", "ПЕРЕВОЗ - вторая строка на 3 шт больше"));
	Отклонения.Добавить(ОтклонениеТеста("ЦенаВыше", "ЦЕНА ВЫШЕ - последняя строка дороже на 10,00 за шт"));
	Отклонения.Добавить(ОтклонениеТеста("ЦенаНиже", "ЦЕНА НИЖЕ - первая строка дешевле на 5,00 за шт"));
	Отклонения.Добавить(ОтклонениеТеста("НетСтроки", "НЕТ СТРОКИ - последней строки УПД в приходной нет"));
	Отклонения.Добавить(ОтклонениеТеста("ЛишняяСтрока", "ЛИШНЯЯ СТРОКА - «Тест Творог» 5 x 89,90, которой нет в УПД"));

	Возврат Отклонения;

КонецФункции

// Отклонение приходной. Вид - Недовоз, Перевоз, ЦенаВыше, ЦенаНиже, НетСтроки,
// ЛишняяСтрока или Количество (строке НомерСтроки - количество Значение).
//
Функция ОтклонениеТеста(Вид, Название, НомерСтроки = 0, Значение = 0)

	Отклонение = Новый Структура;
	Отклонение.Вставить("Вид", Вид);
	Отклонение.Вставить("Название", Название);
	Отклонение.Вставить("НомерСтроки", НомерСтроки);
	Отклонение.Вставить("Значение", Значение);

	Возврат Отклонение;

КонецФункции

// Поставка с расхождением номер Индекс (с 0): сначала СценарииТестаРасхождение по
// разу, дальше сочетания - сценарий, который сходится, плюс отклонение приходной.
// Основы сочетаний начинаются с того сценария, на котором остановились поставки
// «сошлось» (Сдвиг - их число): вместе они проходят все сценарии. На каждом новом
// круге сценариев отклонение сдвигается, сочетания не повторяются.
//
Функция СценарийРасхождения(Индекс, Расхождения, Сошлось, Отклонения, Сдвиг)

	Если Индекс < Расхождения.Количество() Тогда
		Возврат Расхождения[Индекс];
	КонецЕсли;

	// У каждой поставки с расхождением есть УКД: основа - только сценарий с УКД
	Основы = Новый Массив;
	Для Каждого Кандидат Из Сошлось Цикл
		Если Кандидат.УКД.Количество() > 0 Тогда
			Основы.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;

	// Сдвиг - поставок «сошлось»: сочетания продолжают с того сценария, где они
	// остановились. Пары «основа + отклонение» не повторяются, пока не пройдены
	// все (Основы.Количество() x Отклонения.Количество())
	Шаг = Индекс - Расхождения.Количество();
	Основа = Основы[(Сдвиг + Шаг) % Основы.Количество()];
	Отклонение = Отклонения[(Шаг + Цел(Шаг / Основы.Количество())) % Отклонения.Количество()];

	Сценарий = Новый Структура;
	Для Каждого ЭлементСценария Из Основа Цикл
		Сценарий.Вставить(ЭлементСценария.Ключ, ЭлементСценария.Значение);
	КонецЦикла;
	Сценарий.Название = Основа.Название + " + в приходной " + Отклонение.Название;
	Сценарий.Основа = Основа.Название;
	Сценарий.Отклонение = Отклонение;
	Сценарий.Группа = "расхождение";

	Возврат Сценарий;

КонецФункции

// Сценарий теста:
//   Название               - Строка
//   Группа                 - Строка - «сошлось», «расхождение» или «не привязана»
//   Основа                 - Строка - для сочетания: сценарий «сошлось», к которому
//                            добавлено отклонение приходной
//   ПоИсходной             - Булево - приходная по УПД без учёта действующих УКД
//   ПриходПоАннулированным - Булево - приходная с учётом и закрытых УКД
//   СтатусУПД              - Неопределено, Структура - состояние УПД в СБИС
//                            (СтатусДокументаТеста); Неопределено - действует
//   Отклонение             - Неопределено, Структура - см. ОтклонениеТеста
//   УКД                    - Массив корректировок, каждая - Массив из ИзменениеУКД
//   СтатусыУКД             - Массив - состояние каждой УКД, Неопределено - действует
//   ДубльУКД               - Число - номер УКД, которая приходит дважды; 0 - нет
//
Функция СценарийТеста(Название, ПоИсходной = Ложь, ИзменениеПервойУКД = Неопределено)

	Сценарий = Новый Структура;
	Сценарий.Вставить("Название", Название);
	Сценарий.Вставить("Группа", "сошлось");
	Сценарий.Вставить("Основа", "");
	Сценарий.Вставить("ПоИсходной", ПоИсходной);
	Сценарий.Вставить("ПриходПоАннулированным", Ложь);
	Сценарий.Вставить("СтатусУПД", Неопределено);
	Сценарий.Вставить("Отклонение", Неопределено);
	Сценарий.Вставить("УКД", Новый Массив);
	Сценарий.Вставить("СтатусыУКД", Новый Массив);
	Сценарий.Вставить("ДубльУКД", 0);
	// Второй этап: номера УКД (k), которые приходят после первой сверки, и смена
	// состояния УКД после неё (k -> СтатусДокументаТеста)
	Сценарий.Вставить("ПоздниеУКД", Новый Массив);
	Сценарий.Вставить("ПоздниеСтатусы", Новый Соответствие);

	Если ИзменениеПервойУКД <> Неопределено Тогда
		ДобавитьУКДСценария(Сценарий, ИзменениеПервойУКД);
	КонецЕсли;

	Возврат Сценарий;

КонецФункции

Функция СценарийГруппы(Сценарий, Группа)

	Сценарий.Группа = Группа;

	Возврат Сценарий;

КонецФункции

// Новая УКД сценария из одного изменения; ещё изменения - в возвращённый массив.
// Статус - СтатусДокументаТеста; Неопределено - УКД действует.
//
Функция ДобавитьУКДСценария(Сценарий, Изменение, Статус = Неопределено)

	Изменения = Новый Массив;
	Изменения.Добавить(Изменение);
	Сценарий.УКД.Добавить(Изменения);
	Сценарий.СтатусыУКД.Добавить(Статус);

	Возврат Изменения;

КонецФункции

// Состояние документа в СБИС, как его пишет загрузка реестра: код и текст.
//
Функция СтатусДокументаТеста(Код, ТекстСостояния)

	Возврат Новый Структура("Код, Состояние", Код, ТекстСостояния);

КонецФункции

// Изменение строки УПД в УКД. КолПосле / ЦенаПосле (с НДС) - Неопределено, если
// не меняется. ТолькоЦена - в файле УКД нет количества (КолТов): так присылают
// корректировку одной цены.
//
Функция ИзменениеУКД(НомерСтроки, КолПосле = Неопределено, ЦенаПосле = Неопределено, ТолькоЦена = Ложь)

	Возврат Новый Структура("НомерСтроки, КолПосле, ЦенаПосле, ТолькоЦена",
		НомерСтроки, КолПосле, ЦенаПосле, ТолькоЦена);

КонецФункции

// XML УПД и УКД тестового поставщика по сценариям (формат ФНС, как из СБИС).
// Имена: УПД_<номер>.xml (УПД_<номер>_ПоИсходной.xml - приходная строится по
// исходной УПД), УКД_<номер УПД>_<k>.xml - k-я корректировка этой УПД,
// УКД_<номер УПД>_<k>_дубль.xml - она же второй раз (повтор из СБИС).
//
// Доля поставок с расхождением - ПроцентРасхождений, равномерно по номерам:
// поставка N с расхождением, если целая часть N * Процент / 100 выросла. Поставки
// «сошлось» идут по СценарииТестаСошлось по кругу, с расхождением -
// СценарийРасхождения.
//
// Параметры:
//   Каталог            - Строка
//   Количество         - Число - сколько поставок
//   ПроцентРасхождений - Число - 0-100
//   План               - Структура - заполняется тем, чего XML не передаёт:
//     * Сценарии   - Соответствие - номер УПД -> сценарий (СценарийТеста)
//     * СтатусыУКД - Соответствие - номер УКД -> СтатусДокументаТеста
//
// Возвращаемое значение:
//   Строка - строка протокола
//
Функция СоздатьXMLТестаСверки(Каталог, Количество, ПроцентРасхождений, План)

	ДатаТеста = ТекущаяДатаСеанса();
	Серия = Формат(ДатаТеста, "ДФ=MMddHHmm");
	Сошлось = СценарииТестаСошлось();
	Расхождения = СценарииТестаРасхождение();
	Отклонения = ОтклоненияТеста();
	Процент = Мин(Макс(ПроцентРасхождений, 0), 100);
	Всего = Количество;
	ЦифрНомера = Макс(2, СтрДлина(Формат(Всего, "ЧГ=0")));
	ВсегоСошлось = Всего - Цел(Всего * Процент / 100);
	ИндексСошлось = 0;
	ИндексРасхождения = 0;
	ФайловУКД = 0;
	Строки = Новый Массив;
	ПоГруппам = Новый Соответствие;   // группа -> поставок
	ОхватСценариев = Новый Соответствие; // название сценария «сошлось» или «расхождение» -> поставок

	План.Вставить("Сценарии", Новый Соответствие);
	План.Вставить("СтатусыУКД", Новый Соответствие);
	План.Вставить("ПоздниеУКД", Новый Соответствие);     // номер УКД -> Истина
	План.Вставить("ПоздниеСтатусы", Новый Соответствие); // номер УКД -> СтатусДокументаТеста

	Для Номер = 1 По Всего Цикл

		СРасхождением = Цел(Номер * Процент / 100) > Цел((Номер - 1) * Процент / 100);
		Если СРасхождением Тогда
			Сценарий = СценарийРасхождения(ИндексРасхождения, Расхождения, Сошлось, Отклонения, ВсегоСошлось);
			ИндексРасхождения = ИндексРасхождения + 1;
		Иначе
			Сценарий = Сошлось[ИндексСошлось % Сошлось.Количество()];
			ИндексСошлось = ИндексСошлось + 1;
		КонецЕсли;

		НН = Формат(Номер, "ЧЦ=" + ЦифрНомера + "; ЧВН=; ЧГ=0");
		// Номер без дефиса: серия и номер поставки - одна группа цифр. С дефисом
		// («ТС<серия>-01») цифровой корень номера (ЭАрМ_Служебный.ЦифровойКореньНомера -
		// самая длинная группа цифр) у всех УПД прогона один - серия, НомераСовпадают
		// считал их одним номером, и все УКД садились на одну УПД
		НомерУПД = "ТС" + Серия + НН;
		План.Сценарии.Вставить(НомерУПД, Сценарий);

		Позиции = ПозицииТестаСверки(100 + Номер, 0, 0);
		Сумма = 0;
		Для Каждого Позиция Из Позиции Цикл
			Сумма = Сумма + Позиция.Сумма;
		КонецЦикла;
		ЗаписатьXMLУПДТестаСверки(ОбъединитьПуть(Каталог, СтрШаблон("УПД_%1%2.xml", НомерУПД,
			?(Сценарий.ПоИсходной, "_ПоИсходной", ""))), НомерУПД, ДатаТеста, ПоставщикТестаСверки(),
			ИННТестаСверки(), Позиции, Окр(Сумма, 2), "Тест сверки: " + ТекстДляXMLТеста(Сценарий.Название));

		// Состояние строк после каждой УКД: «до» следующей - «после» предыдущей.
		// Закрытая УКД как будто не приходила: состояние строк она не меняет
		СостояниеСтрок = Новый Соответствие;
		Для Каждого Позиция Из Позиции Цикл
			СостояниеСтрок.Вставить(Позиция.Номер, Новый Структура("Кол, Цена", Позиция.Количество, Позиция.Цена));
		КонецЦикла;

		НомерУКД = 0;
		Для Каждого Изменения Из Сценарий.УКД Цикл
			НомерУКД = НомерУКД + 1;
			Статус = Сценарий.СтатусыУКД[НомерУКД - 1];
			Закрыта = Статус <> Неопределено
				И ЭАрМ_УтверждениеСБИС.ДокументЗакрытВСБИС(Статус.Код, Статус.Состояние);
			СтрокиУКД = Новый Массив;
			Для Каждого Изменение Из Изменения Цикл
				Позиция = Позиции[Изменение.НомерСтроки - 1];
				Было = СостояниеСтрок[Изменение.НомерСтроки];
				КолПосле = ?(Изменение.КолПосле = Неопределено, Было.Кол, Изменение.КолПосле);
				ЦенаПосле = ?(Изменение.ЦенаПосле = Неопределено, Было.Цена, Изменение.ЦенаПосле);
				СтрокиУКД.Добавить(Новый Структура(
					"Номер, Наименование, Артикул, Штрихкод, КолДо, КолПосле, ЦенаДо, ЦенаПосле, ТолькоЦена",
					Позиция.Номер, Позиция.Наименование, Позиция.Артикул, Позиция.Штрихкод,
					Было.Кол, КолПосле, Было.Цена, ЦенаПосле, Изменение.ТолькоЦена));
				Если НЕ Закрыта Тогда
					СостояниеСтрок.Вставить(Изменение.НомерСтроки, Новый Структура("Кол, Цена", КолПосле, ЦенаПосле));
				КонецЕсли;
			КонецЦикла;

			НомерДокументаУКД = СтрШаблон("К%1-%2", НомерУКД, НомерУПД);
			ЗаписатьXMLУКДТеста(ОбъединитьПуть(Каталог, СтрШаблон("УКД_%1_%2.xml", НомерУПД, НомерУКД)),
				НомерДокументаУКД, ДатаТеста, НомерУПД, ПоставщикТестаСверки(), ИННТестаСверки(), СтрокиУКД);
			ФайловУКД = ФайловУКД + 1;
			Если Сценарий.ДубльУКД = НомерУКД Тогда
				ЗаписатьXMLУКДТеста(ОбъединитьПуть(Каталог, СтрШаблон("УКД_%1_%2_дубль.xml", НомерУПД, НомерУКД)),
					НомерДокументаУКД, ДатаТеста, НомерУПД, ПоставщикТестаСверки(), ИННТестаСверки(), СтрокиУКД);
				ФайловУКД = ФайловУКД + 1;
			КонецЕсли;
			Если Статус <> Неопределено Тогда
				План.СтатусыУКД.Вставить(НомерДокументаУКД, Статус);
			КонецЕсли;
			Если Сценарий.ПоздниеУКД.Найти(НомерУКД) <> Неопределено Тогда
				План.ПоздниеУКД.Вставить(НомерДокументаУКД, Истина);
			КонецЕсли;
			ПозднийСтатус = Сценарий.ПоздниеСтатусы.Получить(НомерУКД);
			Если ПозднийСтатус <> Неопределено Тогда
				План.ПоздниеСтатусы.Вставить(НомерДокументаУКД, ПозднийСтатус);
			КонецЕсли;
		КонецЦикла;

		ДобавитьКСчетчику(ПоГруппам, Сценарий.Группа);
		ДобавитьКСчетчику(ОхватСценариев, ?(ЗначениеЗаполнено(Сценарий.Основа), Сценарий.Основа, Сценарий.Название));

		Если Номер <= 30 Тогда
			Строки.Добавить(СтрШаблон("  %1. УПД № %2 [%3]: %4", НН, НомерУПД, ВРег(Сценарий.Группа), Сценарий.Название));
		КонецЕсли;

	КонецЦикла;

	Если Всего > 30 Тогда
		Строки.Добавить(СтрШаблон("  ... и ещё %1 поставок (каждая - в ТрассаПриема.log «Тест: УПД №»)", Всего - 30));
	КонецЕсли;

	Строки.Добавить(СтрШаблон("Поставок %1: «сошлось» %2, «расхождение» %3, «не привязана» %4 (задано с расхождениями %5)",
		Всего, ЗначениеСчетчика(ПоГруппам, "сошлось"), ЗначениеСчетчика(ПоГруппам, "расхождение"),
		ЗначениеСчетчика(ПоГруппам, "не привязана"), Формат(Процент, "ЧГ=0") + "%"));
	Строки.Добавить(ОхватСценариевТеста(ОхватСценариев, Сошлось, Расхождения, Процент));

	ЭАрМ_ПриемПакетовДалион.Трасса("", СтрШаблон("Тест: создано XML - УПД %1, УКД %2 «%3» ИНН %4 в %5; %6",
		Всего, ФайловУКД, ПоставщикТестаСверки(), ИННТестаСверки(), Каталог,
		СтрЗаменить(СтрСоединить(Строки, " | "), Символы.ПС, " ")));

	Возврат СтрШаблон("Создано XML: УПД %1, УКД %2 тестового поставщика «%3» ИНН %4 в папке %5. Поставки:",
		Всего, ФайловУКД, ПоставщикТестаСверки(), ИННТестаСверки(), Каталог)
		+ Символы.ПС + СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Какие сценарии попали в прогон: каждый «сошлось» - сам или основой сочетания с
// отклонением, каждый особый «расхождение» - сам. Не попавшие - списком и сколько
// поставок нужно при этом проценте, чтобы были все.
//
Функция ОхватСценариевТеста(ОхватСценариев, Сошлось, Расхождения, Процент)

	НеПопали = Новый Массив;
	Для Каждого Сценарий Из Сошлось Цикл
		Если ОхватСценариев.Получить(Сценарий.Название) = Неопределено Тогда
			НеПопали.Добавить(Сценарий.Название);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Сценарий Из Расхождения Цикл
		Если ОхватСценариев.Получить(Сценарий.Название) = Неопределено Тогда
			НеПопали.Добавить(Сценарий.Название);
		КонецЕсли;
	КонецЦикла;

	Всего = Сошлось.Количество() + Расхождения.Количество();
	Если НеПопали.Количество() = 0 Тогда
		Возврат СтрШаблон("Сценарии: задействованы все %1 (УКД и аннулирования «сошлось» - %2, особых расхождений - %3)",
			Всего, Сошлось.Количество(), Расхождения.Количество());
	КонецЕсли;

	// Наименьшее число поставок, при котором при этом проценте попадут все сценарии
	Нужно = 0;
	Если Процент > 0 И Процент < 100 Тогда
		Для Поставок = Всего По 5000 Цикл
			СРасхождением = Цел(Поставок * Процент / 100);
			Если СРасхождением >= Расхождения.Количество()
				И (Поставок - СРасхождением) + Макс(СРасхождением - Расхождения.Количество(), 0) >= Сошлось.Количество() Тогда
				Нужно = Поставок;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат СтрШаблон("Сценарии: задействовано %1 из %2, не попали (%3): %4. %5", Всего - НеПопали.Количество(), Всего,
		НеПопали.Количество(), СтрСоединить(НеПопали, "; "),
		?(Нужно > 0, СтрШаблон("Чтобы попали все - поставок не меньше %1", Нужно),
			"При 0 и 100 процентах часть сценариев не попадает никогда"));

КонецФункции

Процедура ДобавитьКСчетчику(Счетчики, Ключ)

	Счетчики.Вставить(Ключ, ЗначениеСчетчика(Счетчики, Ключ) + 1);

КонецПроцедуры

Функция ЗначениеСчетчика(Счетчики, Ключ)

	Значение = Счетчики.Получить(Ключ);

	Возврат ?(Значение = Неопределено, 0, Значение);

КонецФункции

// Название сценария для атрибута XML в windows-1251: стрелок там нет.
//
Функция ТекстДляXMLТеста(Текст)

	Возврат СтрЗаменить(СтрЗаменить(Текст, "▼", "(-)"), "▲", "(+)");

КонецФункции

// УКД (КСЧФДИС, формат ФНС 5.01): строки «до/после» количества, цены и стоимости.
// Цены в Строках - с НДС 10%; в файл цена пишется без НДС, как у СБИС.
// ТолькоЦена - атрибутов КолТовДо/КолТовПосле нет: разбор берёт количество из
// стоимости без НДС на цену.
//
Процедура ЗаписатьXMLУКДТеста(Путь, НомерУКД, ДатаТеста, НомерУПД, Поставщик, ИННПоставщика, Строки)

	ДатаСтрокой = Формат(ДатаТеста, "ДФ=dd.MM.yyyy");
	ФорматЧисла = "ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0";

	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(Путь, "windows-1251");
	Запись.ЗаписатьОбъявлениеXML();

	НачатьЭлементXML(Запись, "Файл", Новый Структура("ИдФайл, ВерсФорм, ВерсПрог",
		"ON_NKORSCHFDOPPR_ТЕСТ_" + НомерУКД, "5.01", "Тест сверки УКД"));
	НачатьЭлементXML(Запись, "Документ", Новый Структура("КНД, ДатаИнфПр, ВремИнфПр, Функция",
		"1115127", ДатаСтрокой, "12.00.00", "КСЧФДИС"));

	НачатьЭлементXML(Запись, "СвКСчФ", Новый Структура("НомерКСчФ, ДатаКСчФ, КодОКВ", НомерУКД, ДатаСтрокой, "643"));
	ПустойЭлементXML(Запись, "СчФ", Новый Структура("НомерСчФ, ДатаСчФ", НомерУПД, ДатаСтрокой));
	НачатьЭлементXML(Запись, "СвПрод");
	НачатьЭлементXML(Запись, "ИдСв");
	ПустойЭлементXML(Запись, "СвЮЛУч", Новый Структура("НаимОрг, ИННЮЛ, КПП", Поставщик, ИННПоставщика, "770301001"));
	Запись.ЗаписатьКонецЭлемента(); // ИдСв
	Запись.ЗаписатьКонецЭлемента(); // СвПрод
	НачатьЭлементXML(Запись, "СвПокуп");
	НачатьЭлементXML(Запись, "ИдСв");
	ПустойЭлементXML(Запись, "СвЮЛУч", Новый Структура("НаимОрг, ИННЮЛ, КПП",
		"Организация-Тест, ООО", "7700000000", "770001001"));
	Запись.ЗаписатьКонецЭлемента(); // ИдСв
	Запись.ЗаписатьКонецЭлемента(); // СвПокуп
	Запись.ЗаписатьКонецЭлемента(); // СвКСчФ

	НачатьЭлементXML(Запись, "ТаблКСчФ");
	Для Каждого СтрокаУКД Из Строки Цикл

		СуммаДо = Окр(СтрокаУКД.КолДо * СтрокаУКД.ЦенаДо, 2);
		СуммаПосле = Окр(СтрокаУКД.КолПосле * СтрокаУКД.ЦенаПосле, 2);
		НДСДо = Окр(СуммаДо * 10 / 110, 2);
		НДСПосле = Окр(СуммаПосле * 10 / 110, 2);
		БезНДСДо = СуммаДо - НДСДо;
		БезНДСПосле = СуммаПосле - НДСПосле;

		Атрибуты = Новый Структура;
		Атрибуты.Вставить("НомСтр", Формат(СтрокаУКД.Номер, "ЧГ=0"));
		Атрибуты.Вставить("НаимТов", СтрокаУКД.Наименование);
		Атрибуты.Вставить("ОКЕИ_ТовДо", "796");
		Атрибуты.Вставить("ОКЕИ_ТовПосле", "796");
		Если НЕ СтрокаУКД.ТолькоЦена Тогда
			Атрибуты.Вставить("КолТовДо", Формат(СтрокаУКД.КолДо, ФорматЧисла));
			Атрибуты.Вставить("КолТовПосле", Формат(СтрокаУКД.КолПосле, ФорматЧисла));
		КонецЕсли;
		Атрибуты.Вставить("ЦенаТовДо", Формат(?(СтрокаУКД.КолДо = 0, 0, Окр(БезНДСДо / СтрокаУКД.КолДо, 2)), ФорматЧисла));
		Атрибуты.Вставить("ЦенаТовПосле", Формат(?(СтрокаУКД.КолПосле = 0, 0, Окр(БезНДСПосле / СтрокаУКД.КолПосле, 2)), ФорматЧисла));
		Атрибуты.Вставить("НалСтДо", "10%");
		Атрибуты.Вставить("НалСтПосле", "10%");
		НачатьЭлементXML(Запись, "СведТов", Атрибуты);

		ПустойЭлементXML(Запись, "СтТовБезНДС", Новый Структура("СтоимДоИзм, СтоимПослеИзм",
			Формат(БезНДСДо, ФорматЧисла), Формат(БезНДСПосле, ФорматЧисла)));
		ПустойЭлементXML(Запись, "СтТовУчНал", Новый Структура("СтоимДоИзм, СтоимПослеИзм",
			Формат(СуммаДо, ФорматЧисла), Формат(СуммаПосле, ФорматЧисла)));
		НачатьЭлементXML(Запись, "СумНалДо");
		ТекстовыйЭлементXML(Запись, "СумНал", Формат(НДСДо, ФорматЧисла));
		Запись.ЗаписатьКонецЭлемента(); // СумНалДо
		НачатьЭлементXML(Запись, "СумНалПосле");
		ТекстовыйЭлементXML(Запись, "СумНал", Формат(НДСПосле, ФорматЧисла));
		Запись.ЗаписатьКонецЭлемента(); // СумНалПосле
		ПустойЭлементXML(Запись, "ДопСведТов", Новый Структура("КодТов, ГТИН", СтрокаУКД.Артикул, СтрокаУКД.Штрихкод));

		Запись.ЗаписатьКонецЭлемента(); // СведТов

	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента(); // ТаблКСчФ

	Запись.ЗаписатьКонецЭлемента(); // Документ
	Запись.ЗаписатьКонецЭлемента(); // Файл
	Запись.Закрыть();

КонецПроцедуры

// Тест по XML папки - вызывается из ТестПриемаИСверки. В папке лежат XML УПД и УКД
// (скачанные из СБИС или созданные генератором). Порядок - как в бою:
//   1. данные прошлого теста удаляются (УдалитьТестовыеДанные), чтобы номера были свободны;
//   2. каждая УПД разбирается боевым разбором и пишется в реестр УПД с товарами;
//   3. каждая УКД (по порядку имён файлов) - в реестр корректировок, товары боевой
//      ЗаписатьТоварыУПД, которая сама связывает УКД с УПД по номеру и ИНН; связь
//      проверяется; по плану - состояние УКД в СБИС (аннулирована, ожидает, отказано);
//      строки действующей УКД применяются к строкам УПД после корректировок и к
//      строкам будущей приходной; что возьмёт сверка - проверяется по каждой УПД;
//   4. под каждую УПД в ту же папку - заказ и приходная Далиона: строки и суммы
//      УПД с учётом её УКД (для файла «_ПоИсходной» - без учёта), отклонение по
//      плану; ожидаемый итог - по строкам (ОпределитьОжиданиеТеста);
//   5. проход приёма по папке - только свои пакеты и цепочки, со сроком;
//   6. итог по каждой поставке: ожидалось / получилось -> ПРОЙДЕН / НЕ ПРОЙДЕН.
// Штрихкод строки - из XML (ГТИН), иначе генерируется только в приходной (строке УПД
// его назначит подбор по названию).
//
// Параметры:
//   Папка - Строка
//   План  - Неопределено, Структура - см. СоздатьXMLТестаСверки; Неопределено - свои
//           XML: состояния в СБИС не меняются, отклонений приходной нет
//
// Возвращаемое значение:
//   Строка - протокол
//
Функция СоздатьТестИзXMLУПД(Папка, План = Неопределено) Экспорт

	Каталог = СокрЛП(Папка);
	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		Возврат "Укажите в поле под кнопками папку, где лежат XML УПД.";
	КонецЕсли;
	ФайлКаталога = Новый Файл(Каталог);
	Если НЕ ФайлКаталога.Существует() Тогда
		Возврат "Папка не видна серверу 1С: " + Каталог;
	КонецЕсли;

	// Файлы по имени: УКД одной УПД применяются по порядку
	СписокФайлов = Новый СписокЗначений;
	Для Каждого ФайлXML Из НайтиФайлы(Каталог, "*.xml", Ложь) Цикл
		СписокФайлов.Добавить(ФайлXML, ФайлXML.Имя);
	КонецЦикла;
	СписокФайлов.СортироватьПоПредставлению();
	Если СписокФайлов.Количество() = 0 Тогда
		Возврат "В папке " + Каталог + " нет файлов *.xml.";
	КонецЕсли;

	Строки = Новый Массив;
	ДатаТеста = ТекущаяДатаСеанса();
	Метка = Формат(ДатаТеста, "ДФ=yyyyMMddHHmmss");
	// Замер времени по этапам: сколько читаем, пишем и сверяем на поставку
	Замеры = Новый Массив;
	НачалоТеста = ТекущаяУниверсальнаяДатаВМиллисекундах();
	НачалоЭтапа = НачалоТеста;
	// План сценариев есть, если XML создал генератор этого прогона
	СценарииПлана = ?(План = Неопределено, Новый Соответствие, План.Сценарии);
	СтатусыУКД = ?(План = Неопределено, Новый Соответствие, План.СтатусыУКД);
	// Второй этап (после первой сверки): УКД, которые приходят позже, и смена
	// состояния УКД в СБИС (номер УКД -> СтатусДокументаТеста)
	ПоздниеУКД = ?(План = Неопределено, Новый Соответствие, План.ПоздниеУКД);
	ПоздниеСтатусы = ?(План = Неопределено, Новый Соответствие, План.ПоздниеСтатусы);
	ФайлыПозднихУКД = Новый Массив;
	// Этап и «сколько всего» - для поля статуса формы (ТекстПрогрессаТеста)
	Прогресс = НовыйПрогрессТеста();
	ОтметитьПрогрессТеста(Прогресс, 1, "удаление данных прошлого теста");

	Строки.Добавить(СтрШаблон("Тест по XML: папка %1, XML-файлов %2", Каталог, СписокФайлов.Количество()));
	Строки.Добавить("Данные прошлого теста удалены перед запуском:");
	Строки.Добавить(УдалитьТестовыеДанные());
	ОтметитьЭтапТеста(Замеры, НачалоЭтапа, "удаление прошлого теста");
	ОтметитьПрогрессТеста(Прогресс, 2, "разбор XML");
	ЭАрМ_ПриемПакетовДалион.Трасса("", СтрШаблон("Тест по XML: папка %1, XML-файлов %2",
		Каталог, СписокФайлов.Количество()));

	// --- 1. Разбор всех XML: УПД и УКД ---
	ФайлыУПД = Новый Массив;
	ФайлыУКД = Новый Массив;
	Для Каждого ЭлементСписка Из СписокФайлов Цикл
		ФайлXML = ЭлементСписка.Значение;
		Попытка
			Разбор = ЭАрМ_Служебный.РазобратьТоварыИзФайлаУПД(ФайлXML.ПолноеИмя);
			Если ЗначениеЗаполнено(Разбор.Ошибка) Тогда
				ВызватьИсключение Разбор.Ошибка;
			КонецЕсли;
			Корень = ЭАрМ_Служебный.ПрочитатьXMLФайлВСоответствие(ФайлXML.ПолноеИмя);
			Описание = Новый Структура("Файл, Разбор, Продавец, Сценарий", ФайлXML, Разбор,
				ПродавецИзXMLУПД(Корень),
				ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Корень, "ВерсПрог", "")));
			Если Разбор.ЭтоКорректировка Тогда
				ФайлыУКД.Добавить(Описание);
			Иначе
				ФайлыУПД.Добавить(Описание);
			КонецЕсли;
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"Тест по XML (файл " + ФайлXML.Имя + " не разобран)", ОшибкаИсключения);
			Строки.Добавить(СтрШаблон("%1: НЕ разобран - %2", ФайлXML.Имя,
				ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения)));
		КонецПопытки;
	КонецЦикла;
	Строки.Добавить(СтрШаблон("XML УПД: %1, XML УКД: %2", ФайлыУПД.Количество(), ФайлыУКД.Количество()));

	ОтметитьЭтапТеста(Замеры, НачалоЭтапа, "разбор XML");
	Прогресс.УПД = ФайлыУПД.Количество();
	Прогресс.УКД = ФайлыУКД.Количество();
	Прогресс.Поставок = ФайлыУПД.Количество();
	ОтметитьПрогрессТеста(Прогресс, 3, "УПД в реестр УПД с товарами");
	// --- 2. УПД в реестр ---
	Наборы = Новый Массив;
	Номер = 0;
	Для Каждого Описание Из ФайлыУПД Цикл
		Номер = Номер + 1;
		Попытка
			Набор = СоздатьУПДИзXML(Описание, Номер, ДатаТеста, Метка, СценарииПлана);
			Наборы.Добавить(Набор);
			Строки.Добавить(СтрШаблон("%1. %2: УПД № %3 «%4» ИНН %5, строк %6, сумма %7%8", Набор.НН,
				Описание.Файл.Имя, Набор.Номер, Набор.Продавец.Наименование, Набор.Продавец.ИНН,
				Набор.Строки.Количество(), ЧислоТеста(Набор.СуммаУПД), Набор.Пометка));
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"Тест по XML (УПД из файла " + Описание.Файл.Имя + " не записана)", ОшибкаИсключения);
			Строки.Добавить(СтрШаблон("%1. %2: УПД НЕ записана - %3", Номер, Описание.Файл.Имя,
				ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения)));
		КонецПопытки;
	КонецЦикла;

	ОтметитьЭтапТеста(Замеры, НачалоЭтапа, "УПД в реестр");
	ОтметитьПрогрессТеста(Прогресс, 4, "УКД в реестр, связь с УПД, состояния в СБИС");
	// --- 3. УКД: реестр корректировок, товары, связь с УПД, строки будущей приходной ---
	НомерУКД = 0;
	Для Каждого Описание Из ФайлыУКД Цикл
		Если ПоздниеУКД.Получить(СокрЛП(Описание.Разбор.НомерВФайле)) = Истина Тогда
			ФайлыПозднихУКД.Добавить(Описание);
			Продолжить;
		КонецЕсли;
		НомерУКД = НомерУКД + 1;
		Попытка
			Строки.Добавить(СоздатьУКДИзXML(Описание, НомерУКД, ДатаТеста, Метка, Наборы, СтатусыУКД));
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"Тест по XML (УКД из файла " + Описание.Файл.Имя + " не записана)", ОшибкаИсключения);
			Строки.Добавить(СтрШаблон("УКД %1: НЕ записана - %2", Описание.Файл.Имя,
				ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения)));
		КонецПопытки;
	КонецЦикла;
	Строки.Добавить(ПроверитьУКДНаборовТеста(Наборы));

	ОтметитьЭтапТеста(Замеры, НачалоЭтапа, "УКД");
	ОтметитьПрогрессТеста(Прогресс, 5, "заказы и приходные Далиона (json)");
	// --- 4. Заказ и приходная Далиона под каждую УПД ---
	Для Каждого Набор Из Наборы Цикл
		Попытка
			Строки.Добавить(СоздатьПриходнуюТеста(Набор, Каталог, ДатаТеста, Метка));
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(Набор.Ид,
				"Тест по XML (приходная под УПД № " + Набор.Номер + " не создана)", ОшибкаИсключения);
			Строки.Добавить(СтрШаблон("УПД № %1: приходная НЕ создана - %2", Набор.Номер,
				ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения)));
		КонецПопытки;
	КонецЦикла;

	ТолькоОбъекты = Новый Массив;
	Для Каждого Набор Из Наборы Цикл
		Если ЗначениеЗаполнено(Набор.Приход) Тогда
			ТолькоОбъекты.Добавить(Набор.Заказ);
			ТолькоОбъекты.Добавить(Набор.Приход);
		КонецЕсли;
	КонецЦикла;
	Если ТолькоОбъекты.Количество() = 0 Тогда
		Строки.Добавить("Ни одной приходной не создано - проход приёма не запускался.");
		Возврат СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;

	ОтметитьЭтапТеста(Замеры, НачалоЭтапа, "приходные и заказы (json)");
	ОтметитьПрогрессТеста(Прогресс, 6, "проход приёма: пакеты, цепочки, поиск УПД, сверка");
	// --- 5. Проход приёма: только свои пакеты и цепочки, со сроком ---
	Строки.Добавить("");
	Строки.Добавить(СтрШаблон("=== Проход приёма по папке %1 (приходных %2) ===", Каталог,
		ТолькоОбъекты.Количество() / 2));
	Срок = ТекущаяДатаСеанса() + СекундНаПроходТеста(Наборы.Количество());
	Строки.Добавить(СтрШаблон("Срок прохода: %1 (%2 с), дальше проход прерывается с «ОШИБКА ПРОВЕРКИ»",
		Формат(Срок, "ДЛФ=T"), СекундНаПроходТеста(Наборы.Количество())));
	// Лимиты прохода - под объём теста: все свои пакеты и цепочки за один проход
	Ограничения = Новый Структура("ТолькоОбъекты, Срок", ТолькоОбъекты, Срок);
	Ограничения.Вставить("ПакетовЗаСеанс", Макс(ТолькоОбъекты.Количество(), 100));
	Ограничения.Вставить("ЦепочекЗаСеанс", Макс(Наборы.Количество(), 30));
	Строки.Добавить(ЭАрМ_ПриемПакетовДалион.ВыполнитьВручную(Ложь, , , Каталог, Ограничения));
	ОтметитьЭтапТеста(Замеры, НачалоЭтапа, "проход приёма и сверка");
	ОтметитьПрогрессТеста(Прогресс, 7, "второй этап (поздние УКД, смена состояний, если есть) и итог по поставкам");

	// --- 5б. Второй этап: поздние УКД и смена состояния УКД, второй проход ---
	Если ФайлыПозднихУКД.Количество() > 0 ИЛИ ПоздниеСтатусы.Количество() > 0 Тогда
		Строки.Добавить(ЭтапПозднихСобытийТеста(Наборы, ФайлыПозднихУКД, ПоздниеСтатусы, НомерУКД,
			ДатаТеста, Метка, Каталог));
		ОтметитьЭтапТеста(Замеры, НачалоЭтапа, "поздние УКД, смена состояний, второй проход");
	КонецЕсли;

	// --- 6. Итог: ожидалось / получилось ---
	Строки.Добавить(ИтогНаборовТеста(Наборы));
	ОтметитьЭтапТеста(Замеры, НачалоЭтапа, "итог по наборам");
	ОтметитьПрогрессТеста(Прогресс, 8, "готово");
	Строки.Добавить(ТекстЗамеровТеста(Замеры, НачалоТеста, Наборы.Количество()));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// УПД из XML - в реестр УПД и товары боевой записью. Строки будущей приходной и
// строки «УПД после УКД» - две отдельные копии строк УПД (к ним потом применяются
// УКД); по ним ОпределитьОжиданиеТеста решает, что должно получиться. Сценарий из
// плана (по номеру УПД в файле) даёт отклонение приходной и состояние УПД в СБИС.
//
// Возвращаемое значение:
//   Структура - набор теста
//
Функция СоздатьУПДИзXML(Описание, Номер, ДатаТеста, Метка, СценарииПлана)

	Разбор = Описание.Разбор;
	Продавец = Описание.Продавец;
	Если Разбор.Товары.Количество() = 0 Тогда
		ВызватьИсключение "в XML не найдено строк товаров (" + Разбор.КлючиКорня + ")";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Продавец.ИНН) Тогда
		ВызватьИсключение "в XML нет ИНН продавца (Документ/СвСчФакт/СвПрод)";
	КонецЕсли;
	НомерВФайле = СокрЛП(Разбор.НомерВФайле);
	Если НЕ ЗначениеЗаполнено(НомерВФайле) Тогда
		ВызватьИсключение "в XML нет номера документа (НомерСчФ / НомерДок)";
	КонецЕсли;

	// Дата теста - сегодня: список реестра УПД по умолчанию показывает 3 последних дня
	ДатаВXML = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(Разбор.ДатаВФайле);

	Набор = Новый Структура;
	Набор.Вставить("НН", Формат(Номер, "ЧЦ=3; ЧВН=; ЧГ=0"));
	Набор.Вставить("Файл", Описание.Файл.Имя);
	Набор.Вставить("НомерВФайле", НомерВФайле);
	Набор.Вставить("Номер", НомерВФайле);
	Набор.Вставить("Пометка", "");
	Набор.Вставить("Продавец", Продавец);
	Набор.Вставить("Ид", "ТЕСТXML-" + Метка + "-" + Набор.НН);
	Набор.Вставить("ПоИсходной", СтрНайти(НРег(Описание.Файл.Имя), "поисходной") > 0);
	Набор.Вставить("Сценарий", ?(СтрНачинаетсяС(Описание.Сценарий, "Тест сверки"), Описание.Сценарий, ""));
	Набор.Вставить("УКД", Новый Массив);
	Набор.Вставить("Строки", Новый Массив);
	Набор.Вставить("СуммаУПД", 0);
	Набор.Вставить("Заказ", "");
	Набор.Вставить("Приход", "");
	Набор.Вставить("ОжидаетсяРасхождение", Ложь);
	Набор.Вставить("Ожидание", "");
	// Что должно получиться: «сошлось», «расхождение», «не привязана» (ОпределитьОжиданиеТеста)
	Набор.Вставить("Ожидается", "");
	// Строки УПД после действующих УКД - эталон для приходной
	Набор.Вставить("СтрокиУПД", Новый Массив);
	// УКД набора: Ид, Номер, Закрыта, Повтор (тот же номер второй раз)
	Набор.Вставить("УКДИд", Новый Массив);
	Набор.Вставить("УПДАннулирована", Ложь);
	// Строки УПД как в XML - из них «УПД после УКД» пересчитывается, когда УКД
	// приходит или аннулируется после первой сверки (ПересчитатьСтрокиУПДТеста)
	Набор.Вставить("СтрокиИсходные", Новый Массив);
	// Статус УПД «Ожидает УКД» после сверки (ОпределитьОжиданиеТеста)
	Набор.Вставить("ОжидаетсяСтатусУКД", Ложь);
	// Статус «УКД есть, нет возврата из Далиона» после сверки
	Набор.Вставить("ОжидаетсяНетВозврата", Ложь);
	// Второй этап: УКД приходит или меняет состояние после первой сверки
	Набор.Вставить("ЕстьЭтапБ", Ложь);
	Набор.Вставить("ЭтапПройден", Истина);
	Набор.Вставить("ИтогЭтапа", "");

	// Сценарий генератора: чего XML не передаёт
	Сценарий = СценарииПлана.Получить(НомерВФайле);
	Набор.Вставить("План", Сценарий);
	Набор.Вставить("Группа", ?(Сценарий = Неопределено, "", Сценарий.Группа));
	Набор.Вставить("Отклонение", ?(Сценарий = Неопределено, Неопределено, Сценарий.Отклонение));
	Набор.Вставить("ПриходПоАннулированным", Сценарий <> Неопределено И Сценарий.ПриходПоАннулированным);
	Если Сценарий <> Неопределено Тогда
		Набор.Сценарий = Сценарий.Название;
		Набор.ПоИсходной = Набор.ПоИсходной ИЛИ Сценарий.ПоИсходной;
		Набор.ЕстьЭтапБ = Сценарий.ПоздниеУКД.Количество() > 0 ИЛИ Сценарий.ПоздниеСтатусы.Количество() > 0;
	КонецЕсли;

	Если ЕстьУПДСНомером(НомерВФайле, Продавец.ИНН) Тогда
		Набор.Номер = "Т" + Формат(ДатаТеста, "ДФ=HHmmss") + "-" + НомерВФайле;
		Набор.Пометка = " (УПД № " + НомерВФайле + " этого ИНН уже есть в реестре - номер тестовой " + Набор.Номер + ")";
	КонецЕсли;

	Для Каждого СтрокаУПД Из Разбор.Товары Цикл
		Набор.СуммаУПД = Набор.СуммаУПД + СуммаСНДССтрокиУПД(СтрокаУПД);
		Набор.Строки.Добавить(СтрокаТестаИзXML(СтрокаУПД, Продавец.ИНН, СтрокаУПД.Количество,
			СуммаСНДССтрокиУПД(СтрокаУПД)));
		Набор.СтрокиУПД.Добавить(СтрокаТестаИзXML(СтрокаУПД, Продавец.ИНН, СтрокаУПД.Количество,
			СуммаСНДССтрокиУПД(СтрокаУПД)));
		Набор.СтрокиИсходные.Добавить(СтрокаТестаИзXML(СтрокаУПД, Продавец.ИНН, СтрокаУПД.Количество,
			СуммаСНДССтрокиУПД(СтрокаУПД)));
	КонецЦикла;

	ЗаписатьСтрокуРеестраТеста(Набор.Ид, Набор.Номер, ДатаТеста, Продавец.Наименование, Продавец.ИНН,
		Набор.СуммаУПД, "ТЕСТ из XML " + Описание.Файл.Имя + ": в СБИС не отправлять");
	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьТоварыУПД(Набор.Ид, Набор.Номер, Разбор);
	ЭАрМ_ПриемПакетовДалион.ПроверитьЗаписьРегистра(Набор.Ид, "ЭАрМ_ТоварыЭТрН",
		Новый Структура("ИдентификаторСБИС", Набор.Ид), , Разбор.Товары.Количество());

	// Аннулирование УПД по сценарию - как его пишет загрузка реестра из СБИС
	Если Сценарий <> Неопределено И Сценарий.СтатусУПД <> Неопределено Тогда
		Набор.УПДАннулирована = УстановитьСостояниеТеста("ЭАрМ_УПД_Входящий", Набор.Ид,
			"УПД № " + Набор.Номер, Сценарий.СтатусУПД);
	КонецЕсли;

	ЭАрМ_ПриемПакетовДалион.Трасса(Набор.Ид, СтрШаблон(
		"Тест: УПД № %1 из %2 (дата в XML %3)%4: строк %5, сумма %6; строки: %7",
		Набор.Номер, Описание.Файл.Имя,
		?(ЗначениеЗаполнено(ДатаВXML), Формат(ДатаВXML, "ДЛФ=D"), "не указана"),
		?(ЗначениеЗаполнено(Набор.Сценарий), " - " + Набор.Сценарий, ""),
		Набор.Строки.Количество(), ЧислоТеста(Набор.СуммаУПД), ТекстСтрокТеста(Набор.Строки)));

	Возврат Набор;

КонецФункции

// УКД из XML - как в бою: строка реестра корректировок, товары ЗаписатьТоварыУПД
// (она же связывает УКД с УПД по номеру исправляемого документа и ИНН). Связь
// проверяется. Состояние УКД в СБИС по плану (СтатусыУКД, по номеру УКД) - после
// связи, как приходит аннулирование в бою. Строки действующей УКД применяются к
// строкам «УПД после УКД» и к строкам будущей приходной (кроме приходной «по
// исходной»); закрытой - только к приходной «по аннулированной».
//
// Возвращаемое значение:
//   Строка - строка протокола
//
// Поздняя - УКД пришла после первой сверки (второй этап): приходная уже отправлена,
// к её строкам УКД не применяется.
//
Функция СоздатьУКДИзXML(Описание, НомерУКД, ДатаТеста, Метка, Наборы, СтатусыУКД, Поздняя = Ложь)

	Разбор = Описание.Разбор;
	Продавец = Описание.Продавец;
	НомерОснования = СокрЛП(Разбор.НомерОснования);

	// УПД теста, которую исправляет эта УКД: по номеру в файле и ИНН. Сначала
	// точное совпадение номера (НомерДляСравнения), иначе - «как человек читает»
	// (НомераСовпадают, по цифровому корню); несколько таких - неоднозначно
	Набор = Неопределено;
	ПохожиеНомера = Новый Массив;
	Для Каждого Кандидат Из Наборы Цикл
		Если ЗначениеЗаполнено(Продавец.ИНН) И Кандидат.Продавец.ИНН <> Продавец.ИНН Тогда
			Продолжить;
		КонецЕсли;
		Если ЭАрМ_Служебный.НомерДляСравнения(Кандидат.НомерВФайле) = ЭАрМ_Служебный.НомерДляСравнения(НомерОснования) Тогда
			Набор = Кандидат;
			Прервать;
		ИначеЕсли ЭАрМ_Служебный.НомераСовпадают(Кандидат.НомерВФайле, НомерОснования) Тогда
			ПохожиеНомера.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;
	Если Набор = Неопределено И ПохожиеНомера.Количество() = 1 Тогда
		Набор = ПохожиеНомера[0];
	ИначеЕсли Набор = Неопределено И ПохожиеНомера.Количество() > 1 Тогда
		Номера = Новый Массив;
		Для Каждого Кандидат Из ПохожиеНомера Цикл
			Номера.Добавить(Кандидат.НомерВФайле);
		КонецЦикла;
		ВызватьИсключение СтрШаблон("исправляемая УПД № %1 ИНН %2 неоднозначна: по цифровому корню номера подходят %3 УПД теста (%4) - "
			+ "у номеров одна самая длинная группа цифр", НомерОснования, Продавец.ИНН, ПохожиеНомера.Количество(),
			СтрСоединить(Номера, ", "));
	КонецЕсли;
	Если Набор = Неопределено Тогда
		ВызватьИсключение СтрШаблон("исправляемой УПД № %1 ИНН %2 среди УПД теста нет", НомерОснования, Продавец.ИНН);
	КонецЕсли;

	ИдентификаторУКД = "ТЕСТУКД-" + Метка + "-" + Формат(НомерУКД, "ЧЦ=3; ЧВН=; ЧГ=0");
	НомерУКДВФайле = СокрЛП(Разбор.НомерВФайле);
	ДатаУКД = ДатаТеста + НомерУКД; // порядок УКД одной УПД - по дате и времени загрузки

	Запись = РегистрыСведений.ЭАрМ_УКД_Входящий.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторСБИС = ИдентификаторУКД;
	Запись.Номер = НомерУКДВФайле;
	Запись.Дата = ДатаУКД;
	Запись.Наименование = Лев("УКД тест " + НомерУКДВФайле + " к УПД " + Набор.Номер, 150);
	Запись.Представление = Запись.Наименование;
	Запись.Состояние = "Тест";
	Запись.Организация = "ООО Универсам Сегодня";
	Запись.Контрагент = Продавец.Наименование;
	Запись.ИННКонтрагента = Продавец.ИНН;
	Запись.ТипРеестра = "Входящие";
	Запись.ДатаЗагрузки = ДатаУКД;
	Запись.Записать(Истина);

	// Боевая запись товаров корректировки: строки «УКД» + связь с УПД по номеру и ИНН
	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьТоварыУПД(ИдентификаторУКД, НомерУКДВФайле, Разбор);

	// Связь читаем обратно. Номер тестовой УПД мог получить префикс (такой номер
	// уже был) - тогда УКД связалась бы с чужой УПД: перепривязываем к тестовой
	Проверка = РегистрыСведений.ЭАрМ_УКД_Входящий.СоздатьМенеджерЗаписи();
	Проверка.ИдентификаторСБИС = ИдентификаторУКД;
	Проверка.Прочитать();
	Связана = СокрЛП(Проверка.ИдентификаторОснования);
	Если Связана = Набор.Ид Тогда
		ТекстСвязи = "связана с УПД теста боевой связью (номер и ИНН)";
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторУКД, "Тест: УКД № " + НомерУКДВФайле + " " + ТекстСвязи
			+ " № " + Набор.Номер);
	ИначеЕсли Набор.УПДАннулирована И НЕ ЗначениеЗаполнено(Связана) Тогда
		// Исходная УПД закрыта в СБИС: НайтиИсходнуюУПД закрытые не берёт - так и должно быть
		ТекстСвязи = "НЕ связана: исходная УПД закрыта в СБИС, поиск исходной УПД закрытые не берёт - как и должно";
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторУКД, СтрШаблон("Тест: УКД № %1 к УПД № %2 - %3. КАК ОПРЕДЕЛЕНО: "
			+ "ЭАрМ_КорректировкиУПД.НайтиИсходнуюУПД отбирает УПД условием УсловиеДокументНеЗакрыт",
			НомерУКДВФайле, Набор.Номер, ТекстСвязи));
	ИначеЕсли Набор.УПДАннулирована Тогда
		ТекстСвязи = СтрШаблон("связана с «%1», хотя исходная УПД закрыта - УКД не должна была найти основание", Связана);
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(ИдентификаторУКД, "Тест: связь УКД с закрытой УПД",
			СтрШаблон("УКД № %1 к УПД № %2: %3", НомерУКДВФайле, Набор.Номер, ТекстСвязи));
	Иначе
		ЭАрМ_КорректировкиУПД.ИзменитьСтрокуРеестра("ЭАрМ_УКД_Входящий", ИдентификаторУКД,
			Новый Структура("ИдентификаторОснования, НомерОснования", Набор.Ид, Набор.Номер));
		ЭАрМ_КорректировкиУПД.ОбновитьПризнакУКД(Набор.Ид);
		ЭАрМ_ЦепочкаЗакупки.ОтметитьИзменениеУПД(Набор.Ид);
		Если ЗначениеЗаполнено(Связана) Тогда
			ЭАрМ_КорректировкиУПД.ОбновитьПризнакУКД(Связана);
			ЭАрМ_ЦепочкаЗакупки.ОтметитьИзменениеУПД(Связана);
		КонецЕсли;
		ТекстСвязи = СтрШаблон("боевая связь дала «%1» - перепривязана к УПД теста", Связана);
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(ИдентификаторУКД, "Тест: связь УКД с УПД",
			СтрШаблон("УКД № %1: %2 № %3", НомерУКДВФайле, ТекстСвязи, Набор.Номер));
	КонецЕсли;

	// Состояние УКД в СБИС по плану: аннулирована, закрыта, ожидает, отказано
	Статус = СтатусыУКД.Получить(НомерУКДВФайле);
	УКДЗакрыта = Ложь;
	Если Статус <> Неопределено Тогда
		УКДЗакрыта = УстановитьСостояниеТеста("ЭАрМ_УКД_Входящий", ИдентификаторУКД,
			"УКД № " + НомерУКДВФайле + " к УПД № " + Набор.Номер, Статус);
		// Как после загрузки реестра: признак УКД у УПД и пересверка её цепочки
		ЭАрМ_КорректировкиУПД.ОбновитьПризнакУКД(Набор.Ид);
		ЭАрМ_ЦепочкаЗакупки.ОтметитьИзменениеУПД(Набор.Ид);
		ТекстСвязи = ТекстСвязи + СтрШаблон("; состояние «%1», код «%2» - %3", Статус.Состояние, Статус.Код,
			?(УКДЗакрыта, "ЗАКРЫТА, сверка её не применяет", "действует"));
	КонецЕсли;
	Набор.УКДИд.Добавить(Новый Структура("Ид, Номер, Закрыта, Повтор, Поздняя, Товары", ИдентификаторУКД,
		НомерУКДВФайле, УКДЗакрыта, Набор.УКД.Найти(НомерУКДВФайле) <> Неопределено, Поздняя, Разбор.Товары));
	ПоказатьСценарийВРеестре("ЭАрМ_УКД_Входящий", ИдентификаторУКД, СтрШаблон("ТЕСТ УКД № %1 к УПД № %2%3: %4",
		НомерУКДВФайле, Набор.Номер,
		?(Статус = Неопределено, "", " [" + ВРег(?(УКДЗакрыта, "закрыта", "действует")) + ", код «" + Статус.Код + "»]"),
		?(ЗначениеЗаполнено(Набор.Сценарий), Набор.Сценарий, "свои XML")));

	// Строки УКД: действующая - к «УПД после УКД» и к приходной (если она не «по
	// исходной»), закрытая - только к приходной «по аннулированной»
	КУПД = НЕ УКДЗакрыта;
	КПриходу = НЕ Поздняя И ?(УКДЗакрыта, Набор.ПриходПоАннулированным, НЕ Набор.ПоИсходной);
	Если Поздняя Тогда
		ТекстСвязи = ТекстСвязи + "; ПОЗДНЯЯ - пришла после первой сверки, приходная уже без неё";
	КонецЕсли;
	Изменения = Новый Массив;
	Для Каждого СтрокаУКД Из Разбор.Товары Цикл
		Изменения.Добавить(ПрименитьСтрокуУКДТеста(Набор, СтрокаУКД, КУПД, КПриходу, УКДЗакрыта));
	КонецЦикла;
	Набор.УКД.Добавить(НомерУКДВФайле);

	ЭАрМ_ПриемПакетовДалион.Трасса(Набор.Ид, СтрШаблон("Тест: УКД № %1 (%2) к УПД № %3, %4; изменения: %5",
		НомерУКДВФайле, ИдентификаторУКД, Набор.Номер, ТекстСвязи, СтрСоединить(Изменения, "; ")));

	Возврат СтрШаблон("   УКД № %1 (%2) к УПД № %3: %4; %5", НомерУКДВФайле, Описание.Файл.Имя, Набор.Номер,
		ТекстСвязи, СтрСоединить(Изменения, "; "));

КонецФункции

// Строка УКД на строках набора: «после» становится строкой. КУПД - применить к
// строкам «УПД после УКД» (эталон), КПриходу - к строкам будущей приходной.
//
// Возвращаемое значение:
//   Строка - что изменилось и куда применено
//
Функция ПрименитьСтрокуУКДТеста(Набор, СтрокаУКД, КУПД, КПриходу, Закрыта)

	СуммаПосле = СуммаСНДССтрокиУПД(СтрокаУКД);
	КоличествоПосле = СтрокаУКД.Количество;
	Знак = ?(СтрокаУКД.ПризнакИзменения = "Уменьшение" ИЛИ СтрокаУКД.ПризнакИзменения = "Убрана", "▼",
		?(СтрокаУКД.ПризнакИзменения = "Увеличение", "▲", "="));
	Текст = СтрШаблон("строка %1 «%2» %3 %4: кол-во %5 -> %6, сумма %7 -> %8", СтрокаУКД.НомерСтроки,
		Лев(СтрокаУКД.Наименование, 40), Знак, СтрокаУКД.ПризнакИзменения,
		ЧислоТеста(СтрокаУКД.КоличествоДо), ЧислоТеста(КоличествоПосле),
		ЧислоТеста(СтрокаУКД.СуммаСНДСДо), ЧислоТеста(СуммаПосле));

	Если КУПД Тогда
		ПрименитьСтрокуУКДКСтрокам(Набор.СтрокиУПД, СтрокаУКД, Набор.Продавец.ИНН);
	КонецЕсли;

	Если КПриходу Тогда
		Возврат Текст + ПрименитьСтрокуУКДКСтрокам(Набор.Строки, СтрокаУКД, Набор.Продавец.ИНН)
			+ ?(Закрыта, " (УКД закрыта, а приходная по ней - по сценарию)", "");
	ИначеЕсли Закрыта Тогда
		Возврат Текст + " (УКД закрыта - не учитывается ни в УПД после корректировок, ни в приходной)";
	КонецЕсли;

	Возврат Текст + " (приходная остаётся по исходной УПД)";

КонецФункции

// Строка УКД на массиве строк теста: количество и сумма «после»; 0 и 0 - строки
// больше нет; строки не было - добавляется.
//
// Возвращаемое значение:
//   Строка - пометка для протокола
//
Функция ПрименитьСтрокуУКДКСтрокам(СтрокиТеста, СтрокаУКД, ИНН)

	Найдена = СтрокаТестаПоНомеру(СтрокиТеста, СтрокаУКД.НомерСтроки);
	СуммаПосле = СуммаСНДССтрокиУПД(СтрокаУКД);
	КоличествоПосле = СтрокаУКД.Количество;

	Если КоличествоПосле = 0 И СуммаПосле = 0 Тогда
		Если Найдена <> Неопределено Тогда
			СтрокиТеста.Удалить(СтрокиТеста.Найти(Найдена));
		КонецЕсли;
		Возврат " (в приходе строки нет)";
	КонецЕсли;

	Если Найдена = Неопределено Тогда
		СтрокиТеста.Добавить(СтрокаТестаИзXML(СтрокаУКД, ИНН, КоличествоПосле, СуммаПосле));
		Возврат " (новая строка прихода)";
	КонецЕсли;

	Если КоличествоПосле <> 0 Тогда
		Найдена.Количество = КоличествоПосле;
	КонецЕсли;
	Найдена.СуммаСНДС = СуммаПосле;
	Найдена.СуммаНДС = СтрокаУКД.СуммаНДС;

	Возврат "";

КонецФункции

// Строка теста (приходной или «УПД после УКД») из строки разбора XML УПД или УКД.
//
Функция СтрокаТестаИзXML(СтрокаXML, ИНН, Количество, СуммаСНДС)

	Штрихкод = СокрЛП(СтрокаXML.Штрихкод);

	Результат = Новый Структура;
	Результат.Вставить("НомерСтроки", СтрокаXML.НомерСтроки);
	Результат.Вставить("Наименование", СтрокаXML.Наименование);
	Результат.Вставить("Артикул", ?(ЗначениеЗаполнено(СтрокаXML.Артикул), СтрокаXML.Артикул, СтрокаXML.КодТовара));
	Результат.Вставить("Штрихкод", ?(ЗначениеЗаполнено(Штрихкод), Штрихкод, ШтрихкодТестаИзXML(ИНН, СтрокаXML)));
	Результат.Вставить("ШтрихкодИзXML", ЗначениеЗаполнено(Штрихкод));
	Результат.Вставить("Количество", Количество);
	Результат.Вставить("СуммаСНДС", СуммаСНДС);
	Результат.Вставить("СуммаНДС", СтрокаXML.СуммаНДС);

	Возврат Результат;

КонецФункции

Функция СтрокаТестаПоНомеру(СтрокиТеста, НомерСтроки)

	Для Каждого СтрокаТеста Из СтрокиТеста Цикл
		Если СтрокаТеста.НомерСтроки = НомерСтроки Тогда
			Возврат СтрокаТеста;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Состояние документа в СБИС по сценарию - как его пишет загрузка реестра: код и
// текст состояния. Было и стало - в трассу, запись проверяется чтением, и как
// правило ЭАрМ_УтверждениеСБИС понимает это состояние.
//
// Параметры:
//   ИмяРегистра   - Строка - ЭАрМ_УПД_Входящий или ЭАрМ_УКД_Входящий
//   Идентификатор - Строка
//   Представление - Строка - для трассы
//   Статус        - Структура - см. СтатусДокументаТеста
//
// Возвращаемое значение:
//   Булево - документ закрыт в СБИС (ЭАрМ_УтверждениеСБИС.ДокументЗакрытВСБИС)
//
Функция УстановитьСостояниеТеста(ИмяРегистра, Идентификатор, Представление, Статус)

	Запись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
	Запись.ИдентификаторСБИС = Идентификатор;
	Запись.Прочитать();
	Было = СтрШаблон("код «%1», состояние «%2»", СокрЛП(Запись.КодСостояния), СокрЛП(Запись.Состояние));

	ЭАрМ_ПриемПакетовДалион.Трасса(Идентификатор, СтрШаблон(
		"Тест: %1 - перед сменой состояния в СБИС по сценарию: %2; будет код «%3», состояние «%4»",
		Представление, Было, Статус.Код, Статус.Состояние));

	ЭАрМ_КорректировкиУПД.ИзменитьСтрокуРеестра(ИмяРегистра, Идентификатор,
		Новый Структура("КодСостояния, Состояние", Статус.Код, Статус.Состояние));
	ЭАрМ_ПриемПакетовДалион.ПроверитьЗаписьРегистра(Идентификатор, ИмяРегистра,
		Новый Структура("ИдентификаторСБИС", Идентификатор),
		Новый Структура("КодСостояния, Состояние", Статус.Код, Статус.Состояние));

	Закрыт = ЭАрМ_УтверждениеСБИС.ДокументЗакрытВСБИС(Статус.Код, Статус.Состояние);
	ЭАрМ_ПриемПакетовДалион.Трасса(Идентификатор, СтрШаблон(
		"Тест: %1 - состояние в СБИС сменено: было %2, стало код «%3», состояние «%4». КАК ОПРЕДЕЛЕНО: %5",
		Представление, Было, Статус.Код, Статус.Состояние, ПравилоСостоянияТеста(Статус)));

	Возврат Закрыт;

КонецФункции

// Как правило ЭАрМ_УтверждениеСБИС понимает состояние документа: закрыт ли он
// (тогда поиск УПД и сверка его не берут) и почему.
//
Функция ПравилоСостоянияТеста(Статус)

	Закрытые = СтрСоединить(ЭАрМ_УтверждениеСБИС.КодыЗакрытыхДокументов(), ", ");
	Закрыт = ЭАрМ_УтверждениеСБИС.ДокументЗакрытВСБИС(Статус.Код, Статус.Состояние);

	Если ЗначениеЗаполнено(Статус.Код) Тогда
		Если Закрыт Тогда
			Возврат СтрШаблон("код %1 входит в коды закрытых (%2) - документ ЗАКРЫТ: поиск УПД и сверка его не берут",
				Статус.Код, Закрытые);
		ИначеЕсли ЭАрМ_УтверждениеСБИС.ДокументОжидаетАннулирования(Статус.Код, Статус.Состояние) Тогда
			Возврат СтрШаблон("код %1 - ожидает аннулирования, в коды закрытых (%2) не входит - документ ДЕЙСТВУЕТ",
				Статус.Код, Закрытые);
		КонецЕсли;
		Возврат СтрШаблон("код %1 в коды закрытых (%2) не входит - документ ДЕЙСТВУЕТ", Статус.Код, Закрытые);
	КонецЕсли;

	Если Закрыт Тогда
		Возврат СтрШаблон("кода нет, текст «%1» начинается с «Аннулирован», «Удален» или «Отозван» - документ ЗАКРЫТ",
			Статус.Состояние);
	КонецЕсли;

	Возврат СтрШаблон("кода нет, текст «%1» не начинается с «Аннулирован», «Удален» или «Отозван» - документ ДЕЙСТВУЕТ",
		Статус.Состояние);

КонецФункции

// Какие УКД возьмёт сверка (ЭАрМ_КорректировкиУПД.КорректировкиУПД: без закрытых,
// из повторов одного номера и даты - один) против сценария: закрытая не должна
// попасть, из действующих с одним номером - ровно одна. По каждой УПД с УКД - в
// трассу; не так - «ОШИБКА ПРОВЕРКИ».
//
// Возвращаемое значение:
//   Строка - строка протокола
//
Функция ПроверитьУКДНаборовТеста(Наборы)

	Проверено = 0;
	СОшибкой = 0;

	Для Каждого Набор Из Наборы Цикл

		Если Набор.УКДИд.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Проверено = Проверено + 1;

		// УПД закрыта: её УКД без основания (см. СоздатьУКДИзXML), сверке брать нечего
		Если Набор.УПДАннулирована Тогда
			ЭАрМ_ПриемПакетовДалион.Трасса(Набор.Ид, СтрШаблон("Тест: УКД УПД № %1 - УПД закрыта в СБИС, УКД (%2) "
				+ "к ней не привязаны, сверка их не берёт - как в сценарии", Набор.Номер, СтрСоединить(Набор.УКД, ", ")));
			Продолжить;
		КонецЕсли;

		Попытка
			ВзятыеСверкой = ЭАрМ_КорректировкиУПД.КорректировкиУПД(Набор.Ид);
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(Набор.Ид,
				"Тест: УКД для сверки (КорректировкиУПД УПД № " + Набор.Номер + ")", ОшибкаИсключения);
			СОшибкой = СОшибкой + 1;
			Продолжить;
		КонецПопытки;

		Части = Новый Массив;
		Ошибки = Новый Массив;
		ВзятоПоНомеру = Новый Соответствие;
		Для Каждого УКД Из Набор.УКДИд Цикл
			Взята = ВзятыеСверкой.Найти(УКД.Ид) <> Неопределено;
			Части.Добавить(СтрШаблон("№ %1 (%2)%3%4 - сверка %5", УКД.Номер, УКД.Ид,
				?(УКД.Закрыта, " закрыта", " действует"), ?(УКД.Повтор, ", повтор номера", ""),
				?(Взята, "БЕРЁТ", "НЕ берёт")));
			Если УКД.Закрыта И Взята Тогда
				Ошибки.Добавить("закрытую УКД № " + УКД.Номер + " сверка берёт");
			ИначеЕсли НЕ УКД.Закрыта И Взята Тогда
				ДобавитьКСчетчику(ВзятоПоНомеру, УКД.Номер);
			КонецЕсли;
		КонецЦикла;

		Проверенные = Новый Соответствие;
		Для Каждого УКД Из Набор.УКДИд Цикл
			Если УКД.Закрыта ИЛИ Проверенные.Получить(УКД.Номер) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Проверенные.Вставить(УКД.Номер, Истина);
			Взято = ЗначениеСчетчика(ВзятоПоНомеру, УКД.Номер);
			Если Взято <> 1 Тогда
				Ошибки.Добавить(СтрШаблон("действующая УКД № %1 взята сверкой %2 раз (нужно 1)", УКД.Номер, Взято));
			КонецЕсли;
		КонецЦикла;

		Текст = СтрШаблон("Тест: УКД УПД № %1 - КАК ОПРЕДЕЛЕНО, что возьмёт сверка (КорректировкиУПД: без закрытых "
			+ "кодами %2 и текстом «Аннулирован/Удален/Отозван», из повторов номера и даты - один): %3",
			Набор.Номер, СтрСоединить(ЭАрМ_УтверждениеСБИС.КодыЗакрытыхДокументов(), ", "), СтрСоединить(Части, "; "));
		Если Ошибки.Количество() = 0 Тогда
			ЭАрМ_ПриемПакетовДалион.Трасса(Набор.Ид, Текст + " - как в сценарии");
		Иначе
			СОшибкой = СОшибкой + 1;
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(Набор.Ид, "Тест: УКД для сверки",
				Текст + " - НЕ как в сценарии: " + СтрСоединить(Ошибки, "; "));
		КонецЕсли;

	КонецЦикла;

	Возврат СтрШаблон("УКД для сверки проверены у %1 УПД: %2", Проверено,
		?(СОшибкой = 0, "все как в сценариях",
			СтрШаблон("НЕ как в сценариях у %1 - см. «ОШИБКА ПРОВЕРКИ» в трассе", СОшибкой)));

КонецФункции

// Заказ и приходная Далиона под УПД теста - из строк набора (с учётом УКД или по
// исходной). В ту же папку, что XML.
//
// Возвращаемое значение:
//   Строка - строка протокола
//
Функция СоздатьПриходнуюТеста(Набор, Каталог, ДатаТеста, Метка)

	// Отклонение сценария - только в строки приходной: «УПД после УКД» остаётся эталоном
	Если Набор.Отклонение <> Неопределено Тогда
		ТекстОтклонения = ПрименитьОтклонениеТеста(Набор.Строки, Набор.Отклонение, Набор.Продавец.ИНН);
		ЭАрМ_ПриемПакетовДалион.Трасса(Набор.Ид, СтрШаблон("Тест: УПД № %1 - отклонение приходной по сценарию «%2»: %3",
			Набор.Номер, Набор.Отклонение.Название, ТекстОтклонения));
	КонецЕсли;

	Товары = Новый Массив;
	СуммаПрихода = 0;
	Сгенерировано = 0;
	Для Каждого СтрокаПрихода Из Набор.Строки Цикл
		Количество = СтрокаПрихода.Количество;
		Описание = Новый Структура("Наименование, Артикул", СтрокаПрихода.Наименование, СтрокаПрихода.Артикул);
		СтрокаТовара = СтрокаДалиона(СтрокаПрихода.НомерСтроки, Описание, Неопределено,
			ЭАрМ_Служебный.ЗначениеВМассив(СтрокаПрихода.Штрихкод), Количество, 1,
			?(Количество <> 0, Окр(СтрокаПрихода.СуммаСНДС / Количество, 2), 0));
		// Сумма строки - ровно как в УПД / УКД, без округления цены
		СтрокаТовара.amount = СтрокаПрихода.СуммаСНДС;
		СтрокаТовара.vatAmount = СтрокаПрихода.СуммаНДС;
		Товары.Добавить(СтрокаТовара);
		СуммаПрихода = СуммаПрихода + СтрокаПрихода.СуммаСНДС;
		Если НЕ СтрокаПрихода.ШтрихкодИзXML Тогда
			Сгенерировано = Сгенерировано + 1;
		КонецЕсли;
	КонецЦикла;

	// Есть второй этап - сейчас ожидание первой сверки, итоговое - после него
	ОпределитьОжиданиеТеста(Набор, СуммаПрихода, НЕ Набор.ЕстьЭтапБ);
	Если Сгенерировано > 0 Тогда
		Набор.Ожидание = Набор.Ожидание + СтрШаблон(" (штрихкодов сгенерировано %1 - строкам УПД их назначит подбор по названию)",
			Сгенерировано);
	КонецЕсли;

	Время = Формат(ДатаТеста, "ДФ=HHmmss");
	Сценарий = Новый Структура("Номер, Ключ, Название", 91, "тестxml", "Тест из XML " + Набор.Файл);
	Набор.Заказ = Строка(Новый УникальныйИдентификатор);
	Набор.Приход = Строка(Новый УникальныйИдентификатор);
	Заказ = ПакетДалиона("ЗаказПоставщику", Набор.Заказ, "З-" + Набор.Номер + "-" + Время, ДатаТеста,
		Товары, Сценарий, "");
	Приход = ПакетДалиона("ПриходнаяНакладная", Набор.Приход, "П-" + Набор.Номер + "-" + Время, ДатаТеста,
		Товары, Сценарий, Набор.Заказ);

	КарточкаПоставщика = Новый Структура("uid, name, code, inn, kpp", Строка(Новый УникальныйИдентификатор),
		Набор.Продавец.Наименование, "C", Набор.Продавец.ИНН, Набор.Продавец.КПП);
	Для Каждого Пакет Из СтрРазделить("Заказ,Приход", ",") Цикл
		Данные = ?(Пакет = "Заказ", Заказ.data, Приход.data);
		Данные.Вставить("counterparty", КарточкаПоставщика);
		Данные.Вставить("comment", Лев("ТЕСТ из XML " + Набор.Файл + ": ожидается " + Набор.Ожидание, 500));
	КонецЦикла;
	Приход.data.Вставить("incomingNumber", Набор.Номер);

	ЗаписатьJSONВФайл(ОбъединитьПуть(Каталог,
		СтрШаблон("dalion_ЗаказПоставщику_%1_%2.json", Набор.Заказ, Метка)), Заказ);
	ЗаписатьJSONВФайл(ОбъединитьПуть(Каталог,
		СтрШаблон("dalion_ПриходнаяНакладная_%1_%2.json", Набор.Приход, Метка)), Приход);

	ЭАрМ_ПриемПакетовДалион.Трасса(Набор.Приход, СтрШаблон(
		"Тест: приходная П-%1-%2 (uid %3) под УПД № %1 (%4)%5; строки прихода: %6; ожидается: %7",
		Набор.Номер, Время, Набор.Приход, Набор.Ид,
		?(ЗначениеЗаполнено(Набор.Сценарий), " - " + Набор.Сценарий, ""),
		ТекстСтрокТеста(Набор.Строки), Набор.Ожидание));

	Возврат СтрШаблон("   приходная под УПД № %1 (uid %2): ожидается %3", Набор.Номер, Набор.Приход, Набор.Ожидание);

КонецФункции

// Ожидаемый итог поставки - по строкам, а не по названию сценария:
//   * УПД закрыта в СБИС - «не привязана»: поиск УПД по номеру и по товарам
//     закрытые не берёт (УсловиеДокументНеЗакрыт);
//   * строки приходной = строкам УПД после действующих УКД (по номеру строки:
//     количество и сумма с НДС до копейки) - «сошлось»;
//   * иначе - «расхождение», с перечнем различий.
// Группа сценария из плана должна совпасть с расчётом, иначе сценарий собран не
// так, как задуман - «ОШИБКА ПРОВЕРКИ».
//
// Статус «Ожидает УКД» ожидается при «расхождении», если в приходной нет строки
// УПД и число строк разное (то же правило, что ЭАрМ_СверкаТоваровЦепочки.УПДОжидаетУКД).
// Итоговое = Ложь - ожидание первой сверки при втором этапе: группа сценария
// (она про итог) не сверяется.
//
Процедура ОпределитьОжиданиеТеста(Набор, СуммаПрихода, Итоговое = Истина)

	Различия = РазличияСтрокТеста(Набор.СтрокиУПД, Набор.Строки);
	Действующих = 0;
	Закрытых = 0;
	Для Каждого УКД Из Набор.УКДИд Цикл
		Если УКД.Закрыта Тогда
			Закрытых = Закрытых + 1;
		Иначе
			Действующих = Действующих + 1;
		КонецЕсли;
	КонецЦикла;

	Если Набор.УПДАннулирована Тогда
		Набор.Ожидается = "не привязана";
		КакОпределено = "УПД закрыта в СБИС - поиск УПД по номеру и по товарам закрытые не берёт, приходной не к чему привязаться";
	ИначеЕсли Различия.Количество() > 0 Тогда
		Набор.Ожидается = "расхождение";
		КакОпределено = "строки приходной против УПД после действующих УКД: " + СтрСоединить(Различия, "; ");
	Иначе
		Набор.Ожидается = "сошлось";
		КакОпределено = СтрШаблон("строки приходной = строкам УПД после действующих УКД (строк %1, количество и сумма каждой совпали)",
			Набор.Строки.Количество());
	КонецЕсли;
	Набор.ОжидаетсяРасхождение = (Набор.Ожидается = "расхождение");
	Набор.ОжидаетсяСтатусУКД = Набор.ОжидаетсяРасхождение И ОжидаетУКДПоСтрокамТеста(Набор.СтрокиУПД, Набор.Строки);
	// То же правило, что ЭАрМ_СверкаТоваровЦепочки.УПДЖдётВозвратДалиона: действующая УКД
	// уменьшила количество, приходная больше УПД после УКД; «Нужна УКД» важнее
	Набор.ОжидаетсяНетВозврата = Набор.ОжидаетсяРасхождение И НЕ Набор.ОжидаетсяСтатусУКД
		И КоличествоУменьшеноУКДТеста(Набор) И СуммаСтрокТеста(Набор.Строки) > СуммаСтрокТеста(Набор.СтрокиУПД) + 0.01;

	Набор.Ожидание = СтрШаблон("«%1»%2: %3; УКД действующих %4, закрытых %5%6; сумма приходной %7, УПД после УКД %8",
		Набор.Ожидается, ?(Набор.ОжидаетсяСтатусУКД, " и статус «Нужна УКД от поставщика» (строки УПД нет в приходной, строк разное число)",
			?(Набор.ОжидаетсяНетВозврата, " и статус «УКД есть, нет возврата из Далиона» (УКД уменьшила количество, приходная больше)", "")),
		КакОпределено, Действующих, Закрытых,
		?(Набор.ПоИсходной, ", приходная по ИСХОДНОЙ УПД", ""), ЧислоТеста(СуммаПрихода),
		ЧислоТеста(СуммаСтрокТеста(Набор.СтрокиУПД)));

	ЭАрМ_ПриемПакетовДалион.Трасса(Набор.Ид, СтрШаблон("Тест: УПД № %1 - КАК ОПРЕДЕЛЁН ожидаемый итог%2: %3",
		Набор.Номер, ?(Итоговое, "", " ПЕРВОЙ сверки (дальше второй этап)"), Набор.Ожидание));

	Если Итоговое И ЗначениеЗаполнено(Набор.Группа) И Набор.Группа <> Набор.Ожидается Тогда
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(Набор.Ид, "Тест: сценарий собран не так, как задуман",
			СтрШаблон("УПД № %1, сценарий «%2» задуман как «%3», а по строкам выходит «%4»",
				Набор.Номер, Набор.Сценарий, Набор.Группа, Набор.Ожидается));
	КонецЕсли;

	// Сценарий и ожидание - в колонку «Документ» реестра УПД: в мониторе видно,
	// что проверяет каждая тестовая УПД
	ПоказатьСценарийВРеестре("ЭАрМ_УПД_Входящий", Набор.Ид, СтрШаблон("ТЕСТ УПД № %1 [должно: %2]: %3",
		Набор.Номер, ВРег(Набор.Ожидается), ?(ЗначениеЗаполнено(Набор.Сценарий), Набор.Сценарий, "свои XML")));

КонецПроцедуры

// Колонка «Документ» (Представление, 150 знаков) строки реестра УПД или УКД теста -
// сценарий. У тестовых строк Представление больше никто не пишет (его заполняет
// только загрузка реестра из СБИС). Сбой записи тест не останавливает.
//
Процедура ПоказатьСценарийВРеестре(ИмяРегистра, Идентификатор, Текст)

	Попытка
		ЭАрМ_КорректировкиУПД.ИзменитьСтрокуРеестра(ИмяРегистра, Идентификатор,
			Новый Структура("Представление", Лев(Текст, 150)));
		ЭАрМ_ПриемПакетовДалион.Трасса(Идентификатор, "Тест: в колонку «Документ» реестра записано «"
			+ Лев(Текст, 150) + "»");
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(Идентификатор,
			"Тест: сценарий в колонку «Документ» (" + ИмяРегистра + ")", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Различия строк приходной и строк УПД после действующих УКД - по номеру строки.
//
// Возвращаемое значение:
//   Массив из Строка
//
Функция РазличияСтрокТеста(СтрокиУПД, СтрокиПрихода)

	Различия = Новый Массив;

	Для Каждого СтрокаУПД Из СтрокиУПД Цикл
		СтрокаПрихода = СтрокаТестаПоНомеру(СтрокиПрихода, СтрокаУПД.НомерСтроки);
		Если СтрокаПрихода = Неопределено Тогда
			Различия.Добавить(СтрШаблон("строка %1 «%2» есть в УПД (%3 шт), в приходной НЕТ", СтрокаУПД.НомерСтроки,
				Лев(СтрокаУПД.Наименование, 40), ЧислоТеста(СтрокаУПД.Количество)));
			Продолжить;
		КонецЕсли;
		Если СтрокаПрихода.Количество <> СтрокаУПД.Количество Тогда
			Различия.Добавить(СтрШаблон("строка %1 «%2»: количество УПД %3, приходной %4 (%5)", СтрокаУПД.НомерСтроки,
				Лев(СтрокаУПД.Наименование, 40), ЧислоТеста(СтрокаУПД.Количество), ЧислоТеста(СтрокаПрихода.Количество),
				?(СтрокаПрихода.Количество < СтрокаУПД.Количество, "▼ недовоз", "▲ перевоз")));
		КонецЕсли;
		Если Макс(СтрокаПрихода.СуммаСНДС - СтрокаУПД.СуммаСНДС, СтрокаУПД.СуммаСНДС - СтрокаПрихода.СуммаСНДС) > 0.01 Тогда
			Различия.Добавить(СтрШаблон("строка %1 «%2»: сумма УПД %3, приходной %4", СтрокаУПД.НомерСтроки,
				Лев(СтрокаУПД.Наименование, 40), ЧислоТеста(СтрокаУПД.СуммаСНДС), ЧислоТеста(СтрокаПрихода.СуммаСНДС)));
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаПрихода Из СтрокиПрихода Цикл
		Если СтрокаТестаПоНомеру(СтрокиУПД, СтрокаПрихода.НомерСтроки) = Неопределено Тогда
			Различия.Добавить(СтрШаблон("строка %1 «%2» (%3 шт) есть в приходной, в УПД НЕТ", СтрокаПрихода.НомерСтроки,
				Лев(СтрокаПрихода.Наименование, 40), ЧислоТеста(СтрокаПрихода.Количество)));
		КонецЕсли;
	КонецЦикла;

	Возврат Различия;

КонецФункции

// Отклонение сценария на строках приходной (см. ОтклонениеТеста).
//
// Возвращаемое значение:
//   Строка - что изменилось
//
Функция ПрименитьОтклонениеТеста(СтрокиПрихода, Отклонение, ИНН)

	Если Отклонение.Вид = "ЛишняяСтрока" Тогда
		НомерСтроки = 0;
		Для Каждого СтрокаПрихода Из СтрокиПрихода Цикл
			НомерСтроки = Макс(НомерСтроки, СтрокаПрихода.НомерСтроки);
		КонецЦикла;
		Образец = Новый Структура("НомерСтроки, Наименование, Артикул, КодТовара, Штрихкод, СуммаНДС",
			НомерСтроки + 1, "Тест Творог 5% 200г", "ТС-004", "ТС-004", "", Окр(449.50 * 10 / 110, 2));
		СтрокиПрихода.Добавить(СтрокаТестаИзXML(Образец, ИНН, 5, 449.50));
		Возврат СтрШаблон("добавлена строка %1 «%2» 5 шт на 449,50 - в УПД её нет", Образец.НомерСтроки,
			Образец.Наименование);
	КонецЕсли;

	Всего = СтрокиПрихода.Количество();
	Если Всего = 0 Тогда
		Возврат "строк в приходной нет - отклонение не применено";
	КонецЕсли;

	Если Отклонение.Вид = "Недовоз" Тогда
		СтрокаПрихода = СтрокиПрихода[0];
		Возврат ИзменитьСтрокуОтклонением(СтрокаПрихода,
			СтрокаПрихода.Количество - ?(СтрокаПрихода.Количество > 2, 2, 1), ЦенаСтрокиТеста(СтрокаПрихода));
	ИначеЕсли Отклонение.Вид = "Перевоз" Тогда
		СтрокаПрихода = СтрокиПрихода[Мин(1, Всего - 1)];
		Возврат ИзменитьСтрокуОтклонением(СтрокаПрихода, СтрокаПрихода.Количество + 3, ЦенаСтрокиТеста(СтрокаПрихода));
	ИначеЕсли Отклонение.Вид = "ЦенаВыше" Тогда
		СтрокаПрихода = СтрокиПрихода[Всего - 1];
		Возврат ИзменитьСтрокуОтклонением(СтрокаПрихода, СтрокаПрихода.Количество, ЦенаСтрокиТеста(СтрокаПрихода) + 10);
	ИначеЕсли Отклонение.Вид = "ЦенаНиже" Тогда
		СтрокаПрихода = СтрокиПрихода[0];
		Возврат ИзменитьСтрокуОтклонением(СтрокаПрихода, СтрокаПрихода.Количество, ЦенаСтрокиТеста(СтрокаПрихода) - 5);
	ИначеЕсли Отклонение.Вид = "НетСтроки" Тогда
		Если Всего < 2 Тогда
			Возврат "в приходной одна строка - не убрана";
		КонецЕсли;
		СтрокаПрихода = СтрокиПрихода[Всего - 1];
		СтрокиПрихода.Удалить(Всего - 1);
		Возврат СтрШаблон("убрана строка %1 «%2» (%3 шт на %4)", СтрокаПрихода.НомерСтроки,
			Лев(СтрокаПрихода.Наименование, 40), ЧислоТеста(СтрокаПрихода.Количество), ЧислоТеста(СтрокаПрихода.СуммаСНДС));
	ИначеЕсли Отклонение.Вид = "УбратьСтроку" Тогда
		СтрокаПрихода = СтрокаТестаПоНомеру(СтрокиПрихода, Отклонение.НомерСтроки);
		Если СтрокаПрихода = Неопределено Тогда
			Возврат СтрШаблон("строки %1 в приходной нет - убирать нечего", Отклонение.НомерСтроки);
		КонецЕсли;
		СтрокиПрихода.Удалить(СтрокиПрихода.Найти(СтрокаПрихода));
		Возврат СтрШаблон("убрана строка %1 «%2» (%3 шт на %4) - поставщик её не довёз", СтрокаПрихода.НомерСтроки,
			Лев(СтрокаПрихода.Наименование, 40), ЧислоТеста(СтрокаПрихода.Количество), ЧислоТеста(СтрокаПрихода.СуммаСНДС));
	ИначеЕсли Отклонение.Вид = "Количество" Тогда
		СтрокаПрихода = СтрокаТестаПоНомеру(СтрокиПрихода, Отклонение.НомерСтроки);
		Если СтрокаПрихода = Неопределено Тогда
			Возврат СтрШаблон("строки %1 в приходной нет - отклонение не применено", Отклонение.НомерСтроки);
		КонецЕсли;
		Возврат ИзменитьСтрокуОтклонением(СтрокаПрихода, Отклонение.Значение, ЦенаСтрокиТеста(СтрокаПрихода));
	КонецЕсли;

	Возврат "неизвестный вид отклонения «" + Отклонение.Вид + "» - не применено";

КонецФункции

Функция ИзменитьСтрокуОтклонением(СтрокаПрихода, Количество, Цена)

	Было = СтрШаблон("%1 шт на %2", ЧислоТеста(СтрокаПрихода.Количество), ЧислоТеста(СтрокаПрихода.СуммаСНДС));
	СтрокаПрихода.Количество = Количество;
	СтрокаПрихода.СуммаСНДС = Окр(Количество * Цена, 2);
	СтрокаПрихода.СуммаНДС = Окр(СтрокаПрихода.СуммаСНДС * 10 / 110, 2);

	Возврат СтрШаблон("строка %1 «%2»: было %3, стало %4 шт на %5 (цена %6)", СтрокаПрихода.НомерСтроки,
		Лев(СтрокаПрихода.Наименование, 40), Было, ЧислоТеста(Количество), ЧислоТеста(СтрокаПрихода.СуммаСНДС),
		ЧислоТеста(Цена));

КонецФункции

Функция ЦенаСтрокиТеста(СтрокаТеста)

	Возврат ?(СтрокаТеста.Количество = 0, 0, СтрокаТеста.СуммаСНДС / СтрокаТеста.Количество);

КонецФункции

Функция СуммаСтрокТеста(СтрокиТеста)

	Сумма = 0;
	Для Каждого СтрокаТеста Из СтрокиТеста Цикл
		Сумма = Сумма + СтрокаТеста.СуммаСНДС;
	КонецЦикла;

	Возврат Сумма;

КонецФункции

// Действующая УКД уменьшила количество: строка УПД после УКД меньше исходной или
// убрана совсем (сравнение «УПД после УКД» со строками XML УПД).
//
Функция КоличествоУменьшеноУКДТеста(Набор)

	Для Каждого СтрокаИсходная Из Набор.СтрокиИсходные Цикл
		СтрокаПосле = СтрокаТестаПоНомеру(Набор.СтрокиУПД, СтрокаИсходная.НомерСтроки);
		Если СтрокаПосле = Неопределено ИЛИ СтрокаПосле.Количество < СтрокаИсходная.Количество Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Правило статуса «Ожидает УКД» на строках теста: есть строка УПД (после УКД), которой
// нет в приходной, и число строк УПД и приходной разное.
//
Функция ОжидаетУКДПоСтрокамТеста(СтрокиУПД, СтрокиПрихода)

	Если СтрокиПрихода.Количество() = 0 ИЛИ СтрокиУПД.Количество() = СтрокиПрихода.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого СтрокаУПД Из СтрокиУПД Цикл
		Если СтрокаТестаПоНомеру(СтрокиПрихода, СтрокаУПД.НомерСтроки) = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Что получилось у поставки после прохода: привязка, расхождения цепочки, статус
// УПД в реестре.
//
// Возвращаемое значение:
//   Структура - Исход («сошлось», «расхождение», «не привязана»), СтатусОжидает (Булево),
//               Статус (Строка), Получилось (Строка - подробно)
//
Функция СостояниеСверкиТеста(Набор)

	Результат = Новый Структура("Исход, СтатусОжидает, СтатусНетВозврата, Статус, Получилось", "не привязана", Ложь, Ложь, "", "");

	ДанныеУПД = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	ДанныеУПД.ИдентификаторСБИС = Набор.Ид;
	ДанныеУПД.Прочитать();
	Результат.СтатусОжидает = ДанныеУПД.Выбран()
		И ДанныеУПД.СтатусПодписания = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ОжидаетУКД;
	Результат.СтатусНетВозврата = ДанныеУПД.Выбран()
		И ДанныеУПД.СтатусПодписания = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.НетВозвратаДалиона;
	Результат.Статус = ?(ДанныеУПД.Выбран() И ЗначениеЗаполнено(ДанныеУПД.СтатусПодписания),
		Строка(ДанныеУПД.СтатусПодписания), "пусто");

	Цепочка = ЭАрМ_ЦепочкаЗакупки.ЦепочкаПоУПД(Набор.Ид);
	Если Цепочка = Неопределено Тогда
		Результат.Получилось = "приходная НЕ привязана к УПД; статус УПД «" + Результат.Статус + "»";
		Возврат Результат;
	КонецЕсли;

	Результат.Исход = ?(Цепочка.ЕстьРасхождения, "расхождение", "сошлось");
	Результат.Получилось = СтрШаблон("привязана, этап «%1», %2; в реестре УПД: расхождений нет %3, статус «%4», текст «%5»",
		Цепочка.Этап, ?(Цепочка.ЕстьРасхождения, "ЕСТЬ РАСХОЖДЕНИЯ", "расхождений нет"),
		?(ДанныеУПД.РасхожденийНет, "да", "нет"), Результат.Статус,
		Лев(СтрЗаменить(ДанныеУПД.ТекстСверки, Символы.ПС, " | "), 150));

	Возврат Результат;

КонецФункции

// Совпало ли состояние поставки с ожиданием: исход и статус «Ожидает УКД».
//
Функция СостояниеСовпалоТеста(Набор, ИтогСверки)

	Возврат ИтогСверки.Исход = Набор.Ожидается И ИтогСверки.СтатусОжидает = Набор.ОжидаетсяСтатусУКД
		И ИтогСверки.СтатусНетВозврата = Набор.ОжидаетсяНетВозврата;

КонецФункции

// Второй этап теста - после первой сверки, как бывает в жизни:
//   1. у поставок со вторым этапом фиксируется итог первой сверки (ожидалось /
//      получилось, статус «Ожидает УКД»);
//   2. приходят поздние УКД (боевая запись и связь, к приходной не применяются);
//   3. УКД меняют состояние в СБИС (аннулирована, ожидает, отказано);
//   4. «УПД после УКД» пересчитывается из строк XML с действующими УКД, ожидание -
//      заново (итоговое), цепочки отмечаются к пересверке;
//   5. второй проход приёма - только эти поставки.
//
// Возвращаемое значение:
//   Строка - протокол этапа
//
Функция ЭтапПозднихСобытийТеста(Наборы, ФайлыПозднихУКД, ПоздниеСтатусы, НомерУКД, ДатаТеста, Метка, Каталог)

	Строки = Новый Массив;
	Строки.Добавить("");
	Строки.Добавить("=== Второй этап: УКД после первой сверки и смена состояний УКД ===");

	// 1. Итог первой сверки
	ЭтапНаборы = Новый Массив;
	Для Каждого Набор Из Наборы Цикл
		Если НЕ Набор.ЕстьЭтапБ ИЛИ НЕ ЗначениеЗаполнено(Набор.Приход) Тогда
			Продолжить;
		КонецЕсли;
		ЭтапНаборы.Добавить(Набор);
		ИтогСверки = СостояниеСверкиТеста(Набор);
		Набор.ЭтапПройден = СостояниеСовпалоТеста(Набор, ИтогСверки);
		Набор.ИтогЭтапа = СтрШаблон("первая сверка %1: ожидалось «%2»%3, получилось «%4», статус «%5»",
			?(Набор.ЭтапПройден, "ПРОЙДЕНА", "НЕ ПРОЙДЕНА"), Набор.Ожидается,
			?(Набор.ОжидаетсяСтатусУКД, " и «Нужна УКД от поставщика»",
				?(Набор.ОжидаетсяНетВозврата, " и «УКД есть, нет возврата из Далиона»", "")),
			ИтогСверки.Исход, ИтогСверки.Статус);
		Строки.Добавить(СтрШаблон("УПД № %1: %2", Набор.Номер, Набор.ИтогЭтапа));
		Если Набор.ЭтапПройден Тогда
			ЭАрМ_ПриемПакетовДалион.Трасса(Набор.Ид, "Тест: " + Набор.ИтогЭтапа + "; " + ИтогСверки.Получилось);
		Иначе
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(Набор.Ид, "Тест: первая сверка",
				Набор.ИтогЭтапа + "; " + ИтогСверки.Получилось + "; ожидание: " + Набор.Ожидание);
		КонецЕсли;
	КонецЦикла;

	// Пересверка цепочки - по ДатаОбновления позже ДатаСверки: события второго
	// этапа - не в ту же секунду, что первая сверка
	Граница = ТекущаяДатаСеанса();
	Пока ТекущаяДатаСеанса() <= Граница Цикл
	КонецЦикла;

	// 2. Поздние УКД
	Для Каждого Описание Из ФайлыПозднихУКД Цикл
		НомерУКД = НомерУКД + 1;
		Попытка
			Строки.Добавить(СоздатьУКДИзXML(Описание, НомерУКД, ДатаТеста, Метка, Наборы, Новый Соответствие, Истина));
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"Тест: поздняя УКД из файла " + Описание.Файл.Имя + " не записана", ОшибкаИсключения);
			Строки.Добавить(СтрШаблон("Поздняя УКД %1: НЕ записана - %2", Описание.Файл.Имя,
				ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения)));
		КонецПопытки;
	КонецЦикла;

	// 3. Смена состояния УКД в СБИС
	Для Каждого Набор Из ЭтапНаборы Цикл
		Для Каждого УКД Из Набор.УКДИд Цикл
			Статус = ПоздниеСтатусы.Получить(УКД.Номер);
			Если Статус = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				БылаЗакрыта = УКД.Закрыта;
				УКД.Закрыта = УстановитьСостояниеТеста("ЭАрМ_УКД_Входящий", УКД.Ид,
					"УКД № " + УКД.Номер + " к УПД № " + Набор.Номер + " (после первой сверки)", Статус);
				ЭАрМ_КорректировкиУПД.ОбновитьПризнакУКД(Набор.Ид);
				Строки.Добавить(СтрШаблон("УКД № %1 к УПД № %2: состояние сменено на «%3» (код «%4») - %5 -> %6",
					УКД.Номер, Набор.Номер, Статус.Состояние, Статус.Код,
					?(БылаЗакрыта, "была закрыта", "действовала"), ?(УКД.Закрыта, "ЗАКРЫТА", "действует")));
				ПоказатьСценарийВРеестре("ЭАрМ_УКД_Входящий", УКД.Ид, СтрШаблон("ТЕСТ УКД № %1 к УПД № %2 [теперь %3, код «%4»]: %5",
					УКД.Номер, Набор.Номер, ВРег(?(УКД.Закрыта, "закрыта", "действует")), Статус.Код, Набор.Сценарий));
			Исключение
				ОшибкаИсключения = ИнформацияОбОшибке();
				ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(УКД.Ид,
					"Тест: смена состояния УКД № " + УКД.Номер, ОшибкаИсключения);
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	// 4. Итоговое ожидание и пометка цепочек к пересверке
	ТолькоОбъекты = Новый Массив;
	Для Каждого Набор Из ЭтапНаборы Цикл
		ПересчитатьСтрокиУПДТеста(Набор);
		ОпределитьОжиданиеТеста(Набор, СуммаСтрокТеста(Набор.Строки), Истина);
		ЭАрМ_ЦепочкаЗакупки.ОтметитьИзменениеУПД(Набор.Ид);
		ТолькоОбъекты.Добавить(Набор.Заказ);
		ТолькоОбъекты.Добавить(Набор.Приход);
	КонецЦикла;
	Если ТолькоОбъекты.Количество() = 0 Тогда
		Строки.Добавить("Поставок со вторым этапом нет - второй проход не нужен");
		Возврат СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;

	// 5. Второй проход
	Срок = ТекущаяДатаСеанса() + СекундНаПроходТеста(ЭтапНаборы.Количество());
	Ограничения = Новый Структура("ТолькоОбъекты, Срок", ТолькоОбъекты, Срок);
	Ограничения.Вставить("ПакетовЗаСеанс", Макс(ТолькоОбъекты.Количество(), 100));
	Ограничения.Вставить("ЦепочекЗаСеанс", Макс(ЭтапНаборы.Количество(), 30));
	Строки.Добавить(СтрШаблон("--- Второй проход приёма (поставок %1) ---", ЭтапНаборы.Количество()));
	Строки.Добавить(ЭАрМ_ПриемПакетовДалион.ВыполнитьВручную(Ложь, , , Каталог, Ограничения));

	ЭАрМ_ПриемПакетовДалион.Трасса("", "Тест: второй этап - " + СтрЗаменить(СтрСоединить(Строки, " | "), Символы.ПС, " "));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// «УПД после УКД» заново: строки XML УПД и по порядку все действующие (не
// закрытые) УКД набора - после поздней УКД или аннулирования.
//
Процедура ПересчитатьСтрокиУПДТеста(Набор)

	Набор.СтрокиУПД = Новый Массив;
	Для Каждого СтрокаИсходная Из Набор.СтрокиИсходные Цикл
		Копия = Новый Структура;
		Для Каждого Поле Из СтрокаИсходная Цикл
			Копия.Вставить(Поле.Ключ, Поле.Значение);
		КонецЦикла;
		Набор.СтрокиУПД.Добавить(Копия);
	КонецЦикла;

	Применено = Новый Массив;
	Для Каждого УКД Из Набор.УКДИд Цикл
		Если УКД.Закрыта Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаУКД Из УКД.Товары Цикл
			ПрименитьСтрокуУКДКСтрокам(Набор.СтрокиУПД, СтрокаУКД, Набор.Продавец.ИНН);
		КонецЦикла;
		Применено.Добавить(УКД.Номер);
	КонецЦикла;

	ЭАрМ_ПриемПакетовДалион.Трасса(Набор.Ид, СтрШаблон("Тест: УПД № %1 - строки «после УКД» пересчитаны, применены УКД: %2; строки: %3",
		Набор.Номер, ?(Применено.Количество() = 0, "нет", СтрСоединить(Применено, ", ")), ТекстСтрокТеста(Набор.СтрокиУПД)));

КонецПроцедуры

// Итог теста после прохода - по каждой поставке: привязалась ли приходная, есть
// ли расхождения; ожидалось («сошлось», «расхождение», «не привязана») и совпало
// ли (ПРОЙДЕН / НЕ ПРОЙДЕН), что с пакетом. Каждая поставка - в трассу; в протокол -
// все НЕ ПРОЙДЕН и первые 30 ПРОЙДЕН, затем сводка по ожидаемому итогу и по
// сценариям.
//
Функция ИтогНаборовТеста(Наборы)

	Строки = Новый Массив;
	Строки.Добавить("");
	Строки.Добавить("=== Итог по поставкам после прохода ===");
	Пройдено = 0;
	ПоказаноПройденных = 0;
	СкрытоПройденных = 0;
	БезПриходной = 0;
	ВсегоПоИтогу = Новый Соответствие;
	ПройденоПоИтогу = Новый Соответствие;
	ВсегоПоСценарию = Новый Соответствие;
	ПройденоПоСценарию = Новый Соответствие;
	ПорядокСценариев = Новый Массив;

	Для Каждого Набор Из Наборы Цикл

		Если НЕ ЗначениеЗаполнено(Набор.Приход) Тогда
			БезПриходной = БезПриходной + 1;
			Продолжить;
		КонецЕсли;

		// Исход, статус «Ожидает УКД» и, если был второй этап, итог первой сверки
		ИтогСверки = СостояниеСверкиТеста(Набор);
		Исход = ИтогСверки.Исход;
		Получилось = ИтогСверки.Получилось
			+ СтрШаблон("; «Нужна УКД от поставщика»: должен %1, стоит %2; «УКД есть, нет возврата из Далиона»: должен %3, стоит %4",
				?(Набор.ОжидаетсяСтатусУКД, "да", "нет"), ?(ИтогСверки.СтатусОжидает, "да", "нет"),
				?(Набор.ОжидаетсяНетВозврата, "да", "нет"), ?(ИтогСверки.СтатусНетВозврата, "да", "нет"))
			+ ?(Набор.ЕстьЭтапБ, "; " + Набор.ИтогЭтапа, "");
		Пройден = СостояниеСовпалоТеста(Набор, ИтогСверки) И Набор.ЭтапПройден;

		НазваниеСценария = ?(ЗначениеЗаполнено(Набор.Сценарий), Набор.Сценарий, "свои XML");
		Если ВсегоПоСценарию.Получить(НазваниеСценария) = Неопределено Тогда
			ПорядокСценариев.Добавить(НазваниеСценария);
		КонецЕсли;
		ДобавитьКСчетчику(ВсегоПоСценарию, НазваниеСценария);
		ДобавитьКСчетчику(ВсегоПоИтогу, Набор.Ожидается);
		Если Пройден Тогда
			Пройдено = Пройдено + 1;
			ДобавитьКСчетчику(ПройденоПоСценарию, НазваниеСценария);
			ДобавитьКСчетчику(ПройденоПоИтогу, Набор.Ожидается);
		КонецЕсли;

		ТекстНабора = СтрШаблон("%1 УПД № %2 (%3): ожидалось «%4», получилось «%5» - %6; %7",
			?(Пройден, "ПРОЙДЕН", "НЕ ПРОЙДЕН"), Набор.Номер, НазваниеСценария, Набор.Ожидается, Исход,
			Получилось, ЭАрМ_ПриемПакетовДалион.ОписаниеПакетовПриходнойПоНомеру(Набор.Номер));
		Если Пройден Тогда
			ЭАрМ_ПриемПакетовДалион.Трасса(Набор.Ид, "Тест: итог - " + ТекстНабора + "; ожидание: " + Набор.Ожидание);
			Если ПоказаноПройденных < 30 Тогда
				Строки.Добавить(ТекстНабора);
				ПоказаноПройденных = ПоказаноПройденных + 1;
			Иначе
				СкрытоПройденных = СкрытоПройденных + 1;
			КонецЕсли;
		Иначе
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(Набор.Ид, "Тест: итог", ТекстНабора + "; ожидание: " + Набор.Ожидание);
			Строки.Добавить(ТекстНабора);
			Строки.Добавить("      как определено ожидание: " + Набор.Ожидание);
		КонецЕсли;

	КонецЦикла;

	Если СкрытоПройденных > 0 Тогда
		Строки.Добавить(СтрШаблон("... и ещё ПРОЙДЕН %1 - каждая в ТрассаПриема.log («Тест: итог»)", СкрытоПройденных));
	КонецЕсли;
	Если БезПриходной > 0 Тогда
		Строки.Добавить(СтрШаблон("Без приходной (не создана - см. выше) %1 - считаются НЕ ПРОЙДЕН", БезПриходной));
	КонецЕсли;

	// Сводка - и в протокол, и в трассу (поставки по одной уже в трассе)
	Сводка = Новый Массив;
	СводкаПоИтогу = Новый Массив;
	Сводка.Добавить("--- По итогу, который должен быть ---");
	Для Каждого ОжидаемыйИтог Из СтрРазделить("сошлось,расхождение,не привязана", ",") Цикл
		Если ЗначениеСчетчика(ВсегоПоИтогу, ОжидаемыйИтог) > 0 Тогда
			СводкаПоИтогу.Добавить(СтрШаблон("должно «%1»: пройдено %2 из %3", ОжидаемыйИтог,
				ЗначениеСчетчика(ПройденоПоИтогу, ОжидаемыйИтог), ЗначениеСчетчика(ВсегоПоИтогу, ОжидаемыйИтог)));
			Сводка.Добавить("  " + СводкаПоИтогу[СводкаПоИтогу.ВГраница()]);
		КонецЕсли;
	КонецЦикла;

	Сводка.Добавить("--- По сценариям ---");
	Для Каждого НазваниеСценария Из ПорядокСценариев Цикл
		ВсегоСценария = ЗначениеСчетчика(ВсегоПоСценарию, НазваниеСценария);
		ПройденоСценария = ЗначениеСчетчика(ПройденоПоСценарию, НазваниеСценария);
		Сводка.Добавить(СтрШаблон("  %1 %2 из %3: %4", ?(ПройденоСценария = ВсегоСценария, "ok  ", "СБОЙ"),
			ПройденоСценария, ВсегоСценария, НазваниеСценария));
	КонецЦикла;

	ИтогТеста = СтрШаблон("ТЕСТ: пройдено %1 из %2", Пройдено, Наборы.Количество());
	Сводка.Добавить(ИтогТеста);
	// Одной строкой сводка не влезала в трассу (Сообщение - 1000 знаков, сценарии
	// обрезались): итог по исходам - одной строкой, каждый сценарий - своей
	ЭАрМ_ПриемПакетовДалион.Трасса("", "Тест: сводка - " + ИтогТеста + " | " + СтрСоединить(СводкаПоИтогу, " | "),
		Пройдено = Наборы.Количество());
	Для Каждого НазваниеСценария Из ПорядокСценариев Цикл
		ВсегоСценария = ЗначениеСчетчика(ВсегоПоСценарию, НазваниеСценария);
		ПройденоСценария = ЗначениеСчетчика(ПройденоПоСценарию, НазваниеСценария);
		ЭАрМ_ПриемПакетовДалион.Трасса("", СтрШаблон("Тест: сводка по сценарию - %1 %2 из %3: %4",
			?(ПройденоСценария = ВсегоСценария, "ok", "СБОЙ"), ПройденоСценария, ВсегоСценария, НазваниеСценария),
			ПройденоСценария = ВсегоСценария);
	КонецЦикла;

	Строки.Добавить("");
	Для Каждого СтрокаСводки Из Сводка Цикл
		Строки.Добавить(СтрокаСводки);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Замер этапа теста: сколько миллисекунд прошло с начала этапа; этап - в трассу.
//
Процедура ОтметитьЭтапТеста(Замеры, НачалоЭтапа, Этап)

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Замеры.Добавить(Новый Структура("Этап, Мс", Этап, Сейчас - НачалоЭтапа));
	ЭАрМ_ПриемПакетовДалион.Трасса("", СтрШаблон("Тест: этап «%1» - %2 с", Этап,
		Формат((Сейчас - НачалоЭтапа) / 1000, "ЧДЦ=1; ЧН=0; ЧГ=0")));
	НачалоЭтапа = Сейчас;

КонецПроцедуры

// Время теста по этапам и скорость: на одну поставку и поставок в минуту.
//
Функция ТекстЗамеровТеста(Замеры, НачалоТеста, Наборов)

	ВсегоМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоТеста;
	Строки = Новый Массив;
	Строки.Добавить("");
	Строки.Добавить(СтрШаблон("=== ВРЕМЯ теста: всего %1 с, поставок %2 ===",
		Формат(ВсегоМс / 1000, "ЧДЦ=1; ЧН=0; ЧГ=0"), Наборов));
	Для Каждого Замер Из Замеры Цикл
		// Знак процента - вне СтрШаблон: там «%» - начало параметра
		Строки.Добавить(СтрШаблон("  %1: %2 с (%3", Замер.Этап, Формат(Замер.Мс / 1000, "ЧДЦ=1; ЧН=0; ЧГ=0"),
			Формат(?(ВсегоМс = 0, 0, 100 * Замер.Мс / ВсегоМс), "ЧДЦ=0; ЧН=0")) + "%)");
	КонецЦикла;
	Если Наборов > 0 Тогда
		Строки.Добавить(СтрШаблон("  на одну поставку: %1 с, поставок в минуту: %2",
			Формат(ВсегоМс / 1000 / Наборов, "ЧДЦ=2; ЧН=0; ЧГ=0"),
			Формат(?(ВсегоМс = 0, 0, Наборов * 60000 / ВсегоМс), "ЧДЦ=1; ЧН=0; ЧГ=0")));
	КонецЕсли;

	Текст = СтрСоединить(Строки, Символы.ПС);
	ЭАрМ_ПриемПакетовДалион.Трасса("", "Тест: " + СтрЗаменить(СокрЛП(Текст), Символы.ПС, " | "));

	Возврат Текст;

КонецФункции

Функция ЧислоТеста(Значение)

	Возврат Формат(Значение, "ЧДЦ=2; ЧРД=,; ЧН=0; ЧГ=0");

КонецФункции

Функция ТекстСтрокТеста(СтрокиТеста)

	Части = Новый Массив;
	Для Каждого СтрокаТеста Из СтрокиТеста Цикл
		Части.Добавить(СтрШаблон("%1 «%2» %3 шт = %4 ШК %5", СтрокаТеста.НомерСтроки,
			Лев(СтрокаТеста.Наименование, 40), ЧислоТеста(СтрокаТеста.Количество),
			ЧислоТеста(СтрокаТеста.СуммаСНДС), СтрокаТеста.Штрихкод));
	КонецЦикла;

	Возврат СтрСоединить(Части, "; ");

КонецФункции

// Три позиции поставки теста. Штрихкоды свои у каждого набора.
//
// Параметры:
//   СерияШтрихкодов     - Число - серия ШтрихкодыСтроки
//   СтрокаМеньшеШтук    - Число - номер строки, где на 2 штуки меньше (0 - нет)
//   СтрокаДорожеЦена    - Число - номер строки, где цена на 5,00 выше (0 - нет)
//
Функция ПозицииТестаСверки(СерияШтрихкодов, СтрокаМеньшеШтук, СтрокаДорожеЦена)

	Образцы = Новый Массив;
	Образцы.Добавить(Новый Структура("Наименование, Артикул, Количество, Цена", "Тест Молоко 3,2% 1л", "ТС-001", 24, 62.50));
	Образцы.Добавить(Новый Структура("Наименование, Артикул, Количество, Цена", "Тест Кефир 1% 0,9л", "ТС-002", 12, 71.30));
	Образцы.Добавить(Новый Структура("Наименование, Артикул, Количество, Цена", "Тест Сыр Российский 50% 300г", "ТС-003", 6, 219.90));

	Позиции = Новый Массив;
	Для НомерСтроки = 1 По Образцы.Количество() Цикл
		Образец = Образцы[НомерСтроки - 1];
		Количество = Образец.Количество - ?(НомерСтроки = СтрокаМеньшеШтук, 2, 0);
		Цена = Образец.Цена + ?(НомерСтроки = СтрокаДорожеЦена, 5, 0);
		Позиции.Добавить(ПозицияТестаСверки(НомерСтроки, Образец.Наименование, Образец.Артикул,
			Количество, Цена, СерияШтрихкодов));
	КонецЦикла;

	Возврат Позиции;

КонецФункции

