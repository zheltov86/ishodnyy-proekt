Функция КаталогТеста()

	Каталог = ОбъединитьПуть(ЭАрМ_ТестоваяВыгрузкаДалион.КореньТеста(), "Упаковки");

	КаталогНаДиске = Новый Файл(Каталог);
	Если НЕ КаталогНаДиске.Существует() Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;

	Возврат Каталог;

КонецФункции

Процедура ОчиститьКаталог(Каталог)

	Для Каждого Файл Из НайтиФайлы(Каталог, "*.json", Ложь) Цикл
		УдалитьФайлы(Файл.ПолноеИмя);
	КонецЦикла;

КонецПроцедуры

Функция ОбъединитьПуть(Каталог, Имя)

	Если Прав(Каталог, 1) = "\" ИЛИ Прав(Каталог, 1) = "/" Тогда
		Возврат Каталог + Имя;
	КонецЕсли;

	Возврат Каталог + "\" + Имя;

КонецФункции

Процедура ЗаписатьJSONВФайл(Путь, Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто);
	ЗаписьJSON.ОткрытьФайл(Путь, "UTF-8", Ложь, ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Данные);
	ЗаписьJSON.Закрыть();

КонецПроцедуры

Функция ДатаISO(Значение)

	Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");

