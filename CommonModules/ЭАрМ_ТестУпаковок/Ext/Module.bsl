Функция ПозицияТестаСверки(Номер, Наименование, Артикул, Количество, Цена, СерияШтрихкодов = 90)

	Штрихкод = ШтрихкодыСтроки(СерияШтрихкодов, Номер).Штука;

	Результат = Новый Структура;
	Результат.Вставить("Номер", Номер);
	Результат.Вставить("Наименование", Наименование);
	Результат.Вставить("Артикул", Артикул);
	Результат.Вставить("Количество", Количество);
	Результат.Вставить("Цена", Цена);
	Результат.Вставить("Сумма", Окр(Количество * Цена, 2));
	Результат.Вставить("Штрихкод", Штрихкод);

	Возврат Результат;

КонецФункции

// Продавец из XML УПД формата ФНС: юрлицо (СвЮЛУч) или ИП (СвИП).
//
Функция ПродавецИзXMLУПД(Корень)

	Результат = Новый Структура("Наименование, ИНН, КПП", "", "", "");
	Если Корень = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Путь Из СтрРазделить("Документ.СвСчФакт.СвПрод.ИдСв,Документ.СвКСчФ.СвПрод.ИдСв,Документ.СвДокПТПрКорр.СвПрод.ИдСв,"
		+ "СвСчФакт.СвПрод.ИдСв", ",", Ложь) Цикл

		ИдСв = ЭАрМ_Служебный.ЗначениеПоПути(Корень, Путь);
		Если ИдСв = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЮЛ = ЭАрМ_Служебный.ЗначениеУзла(ИдСв, "СвЮЛУч");
		Если ЮЛ <> Неопределено Тогда
			Результат.ИНН = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ЮЛ, "ИННЮЛ", ""));
			Результат.КПП = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ЮЛ, "КПП", ""));
			Результат.Наименование = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ЮЛ, "НаимОрг", ""));
		КонецЕсли;

		ИП = ЭАрМ_Служебный.ЗначениеУзла(ИдСв, "СвИП");
		Если НЕ ЗначениеЗаполнено(Результат.ИНН) И ИП <> Неопределено Тогда
			Результат.ИНН = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ИП, "ИННФЛ", ""));
			ФИО = ЭАрМ_Служебный.ЗначениеУзла(ИП, "ФИО");
			Части = Новый Массив;
			Для Каждого Имя Из СтрРазделить("Фамилия,Имя,Отчество", ",") Цикл
				Часть = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ФИО, Имя, ""));
				Если ЗначениеЗаполнено(Часть) Тогда
					Части.Добавить(Часть);
				КонецЕсли;
			КонецЦикла;
			Результат.Наименование = "ИП " + СтрСоединить(Части, " ");
		КонецЕсли;

		Если ЗначениеЗаполнено(Результат.ИНН) Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(Результат.Наименование) Тогда
		Результат.Наименование = "Продавец ИНН " + Результат.ИНН;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Есть ли в реестре УПД документ с таким номером у этого ИНН (любой - и настоящий,
// и прошлого теста): тогда тестовой УПД нужен свой номер.
//
Функция ЕстьУПДСНомером(НомерУПД, ИНН)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.Номер = &Номер
	|	И УПД.ИННКонтрагента = &ИНН");
	Запрос.УстановитьПараметр("Номер", НомерУПД);
	Запрос.УстановитьПараметр("ИНН", ИНН);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

Функция СуммаСНДССтрокиУПД(СтрокаУПД)

	Если СтрокаУПД.СуммаСНДС <> 0 Тогда
		Возврат СтрокаУПД.СуммаСНДС;
	КонецЕсли;

	Возврат СтрокаУПД.СуммаБезНДС + СтрокаУПД.СуммаНДС;

КонецФункции

// EAN-13 для строки XML без штрихкода: префикс 200 (внутренний), 9 цифр от ИНН,
// наименования и кода, контрольная цифра. Один и тот же товар даёт один штрихкод.
//
Функция ШтрихкодТестаИзXML(ИНН, СтрокаУПД)

	Основа = ИНН + "|" + СтрокаУПД.Наименование + "|" + СтрокаУПД.КодТовара;
	Хеш = 0;
	Для Позиция = 1 По СтрДлина(Основа) Цикл
		Хеш = (Хеш * 31 + КодСимвола(Основа, Позиция)) % 1000000000;
	КонецЦикла;

	Цифры = "200" + Формат(Хеш, "ЧЦ=9; ЧВН=; ЧГ=0");

	Возврат Цифры + КонтрольнаяЦифра(Цифры);

КонецФункции

// Строка реестра УПД теста - поля, которые заполняет загрузка реестров из СБИС.
//
Процедура ЗаписатьСтрокуРеестраТеста(ИдентификаторУПД, НомерУПД, ДатаУПД, Поставщик, ИНН, СуммаУПД, Комментарий)

	Запись = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторСБИС = ИдентификаторУПД;
	Запись.Номер = НомерУПД;
	Запись.Дата = ДатаУПД;
	Запись.Наименование = Лев("УПД тест " + НомерУПД + " " + Поставщик, 150);
	Запись.Представление = Запись.Наименование;
	Запись.Формат = "УПД";
	Запись.Состояние = "Тест";
	Запись.Организация = "ООО Универсам Сегодня";
	Запись.Контрагент = Поставщик;
	Запись.ИННКонтрагента = ИНН;
	Запись.ТипРеестра = "Входящие";
	Запись.ДатаЗагрузки = ТекущаяДатаСеанса();
	Запись.СуммаУПД = СуммаУПД;
	Запись.КомментарийОператора = Комментарий;
	Запись.Записать(Истина);

	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторУПД, СтрШаблон(
		"Тест: УПД № %1 от %2 записана в реестр УПД (имитация СБИС), «%3» ИНН %4, сумма %5",
		НомерУПД, Формат(ДатаУПД, "ДЛФ=D"), Поставщик, ИНН, Формат(СуммаУПД, "ЧДЦ=2; ЧГ=0")));
	ЭАрМ_ПриемПакетовДалион.ПроверитьЗаписьРегистра(ИдентификаторУПД, "ЭАрМ_УПД_Входящий",
		Новый Структура("ИдентификаторСБИС", ИдентификаторУПД),
		Новый Структура("Номер, ИННКонтрагента, Состояние", НомерУПД, ИНН, "Тест"));

КонецПроцедуры

// Кнопка «Удалить тестовые данные» в настройках ЭДО: убирает всё, что создаёт
// «Тест приёма и сверки» (и прежние тесты), не трогая настоящие документы.
//   * УПД и ЭТрН с идентификатором «ТЕСТ…» (ТЕСТСВ-, ТЕСТXML-, ТЕСТУПД-, ТЕСТЭТРН-;
//     у настоящих идентификатор СБИС - GUID), их товары и коды маркировки;
//   * пакеты заказов и приходных тестов: номер «З-…» / «П-…» и в самом пакете
//     комментарий «ТЕСТ сверки» / «ТЕСТ из XML» / «ТЕСТ упаковок»; смотрятся пакеты,
//     принятые не раньше первой тестовой УПД;
//   * цепочки этих заказов и приходных с их сверкой и реестром товаров, документы
//     «Заказ поставщику» и «Приходная накладная» этих пакетов. Настоящая цепочка,
//     привязавшаяся к тестовой УПД, не удаляется - только отвязывается от неё;
//   * штрихкоды тестового поставщика (ИНН 7703000003) и его строки очереди номенклатуры.
// Трасса, журнал обмена и файлы в папке теста остаются.
//
// Возвращаемое значение:
//   Строка - протокол для поля статуса формы
//
Функция УдалитьТестовыеДанные() Экспорт

	Строки = Новый Массив;
	Строки.Добавить("Удаление тестовых данных:");

	// --- 1. Тестовые УПД и ЭТрН ---
	ТестовыеУПД = Новый Массив;
	НачалоТестов = ТекущаяДатаСеанса() - 2 * 86400;
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	УПД.ИдентификаторСБИС КАК Ид,
		|	УПД.ДатаЗагрузки КАК ДатаЗагрузки
		|ИЗ
		|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
		|ГДЕ
		|	УПД.ИдентификаторСБИС ПОДОБНО ""ТЕСТ%""");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ТестовыеУПД.Добавить(Выборка.Ид);
			Если ЗначениеЗаполнено(Выборка.ДатаЗагрузки) И Выборка.ДатаЗагрузки - 3600 < НачалоТестов Тогда
				НачалоТестов = Выборка.ДатаЗагрузки - 3600;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "УдалитьТестовыеДанные (тестовые УПД не прочитаны)",
			ИнформацияОбОшибке());
	КонецПопытки;

	// --- 2. Пакеты заказов и приходных тестов ---
	ЗаказыТеста = Новый Массив;
	ПриходыТеста = Новый Массив;
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Пакеты.ТипОбъекта КАК ТипОбъекта,
		|	Пакеты.ИдентификаторОбъекта КАК Ид,
		|	Пакеты.ДанныеПакета КАК ДанныеПакета
		|ИЗ
		|	РегистрСведений.ЭАрМ_ПакетыДалион КАК Пакеты
		|ГДЕ
		|	Пакеты.ТипОбъекта В (""ЗаказПоставщику"", ""ПриходнаяНакладная"")
		|	И (Пакеты.НомерОбъекта ПОДОБНО ""З-%"" ИЛИ Пакеты.НомерОбъекта ПОДОБНО ""П-%"")
		|	И Пакеты.ДатаПриема >= &НачалоТестов");
		Запрос.УстановитьПараметр("НачалоТестов", НачалоТестов);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Текст = Выборка.ДанныеПакета;
			Если СтрНайти(Текст, "ТЕСТ сверки") = 0 И СтрНайти(Текст, "ТЕСТ из XML") = 0
				И СтрНайти(Текст, "ТЕСТ упаковок") = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если Выборка.ТипОбъекта = "ЗаказПоставщику" Тогда
				ЗаказыТеста.Добавить(Выборка.Ид);
			Иначе
				ПриходыТеста.Добавить(Выборка.Ид);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "УдалитьТестовыеДанные (пакеты тестов не прочитаны)",
			ИнформацияОбОшибке());
	КонецПопытки;

	// --- 3. Цепочки: тестовые - удалить, настоящие при тестовой УПД - отвязать ---
	Удалено = 0;
	Отвязано = 0;
	Попытка
		КлючиБезЗаказа = Новый Массив;
		Для Каждого Ид Из ПриходыТеста Цикл
			КлючиБезЗаказа.Добавить("ПН:" + Ид);
		КонецЦикла;
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Цепочка.ИдентификаторЗаказа КАК Заказ,
		|	Цепочка.ИдентификаторПоступления КАК Поступление,
		|	Цепочка.ИдентификаторУПД КАК УПД
		|ИЗ
		|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
		|ГДЕ
		|	(Цепочка.ИдентификаторУПД ПОДОБНО ""ТЕСТ%""
		|		ИЛИ Цепочка.ИдентификаторЗаказа В (&Заказы)
		|		ИЛИ Цепочка.ИдентификаторЗаказа В (&КлючиБезЗаказа)
		|		ИЛИ Цепочка.ИдентификаторПоступления В (&Приходы))");
		Запрос.УстановитьПараметр("Заказы", ЗаказыТеста);
		Запрос.УстановитьПараметр("КлючиБезЗаказа", КлючиБезЗаказа);
		Запрос.УстановитьПараметр("Приходы", ПриходыТеста);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Тестовая = ЗаказыТеста.Найти(Выборка.Заказ) <> Неопределено
				ИЛИ КлючиБезЗаказа.Найти(Выборка.Заказ) <> Неопределено
				ИЛИ ПриходыТеста.Найти(Выборка.Поступление) <> Неопределено;
			Если Тестовая Тогда
				УдалитьЦепочкуТеста(Выборка.Заказ, Выборка.Поступление);
				Удалено = Удалено + 1;
			Иначе
				ОтвязатьЦепочкуОтТестовойУПД(Выборка.Заказ, Выборка.Поступление);
				Отвязано = Отвязано + 1;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "УдалитьТестовыеДанные (цепочки)", ИнформацияОбОшибке());
	КонецПопытки;
	Строки.Добавить(СтрШаблон("  цепочек удалено %1 (со сверкой и реестром товаров), настоящих отвязано от тестовых УПД %2",
		Удалено, Отвязано));

	// --- 4. Документы заказов и приходных тестов ---
	Строки.Добавить(СтрШаблон("  документов «Заказ поставщику» удалено %1, «Приходная накладная» - %2",
		УдалитьДокументыТеста("ЭАрМ_ЗаказПоставщику", ЗаказыТеста),
		УдалитьДокументыТеста("ЭАрМ_ПриходнаяНакладная", ПриходыТеста)));

	// --- 5. Пакеты ---
	Удалено = 0;
	Для Каждого Ид Из ЗаказыТеста Цикл
		Удалено = Удалено + УдалитьЗаписьТеста("ЭАрМ_ПакетыДалион",
			Новый Структура("ТипОбъекта, ИдентификаторОбъекта", "ЗаказПоставщику", Ид));
	КонецЦикла;
	Для Каждого Ид Из ПриходыТеста Цикл
		Удалено = Удалено + УдалитьЗаписьТеста("ЭАрМ_ПакетыДалион",
			Новый Структура("ТипОбъекта, ИдентификаторОбъекта", "ПриходнаяНакладная", Ид));
	КонецЦикла;
	Строки.Добавить(СтрШаблон("  пакетов Далиона удалено %1 (заказов %2, приходных %3)", Удалено,
		ЗаказыТеста.Количество(), ПриходыТеста.Количество()));

	// --- 6. УПД, ЭТрН, их товары и коды маркировки ---
	ДокументыЭДО = Новый Массив;
	Для Каждого Ид Из ТестовыеУПД Цикл
		ДокументыЭДО.Добавить(Ид);
	КонецЦикла;
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЭТрН.ИдентификаторСБИС КАК Ид
		|ИЗ
		|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
		|ГДЕ
		|	ЭТрН.ИдентификаторСБИС ПОДОБНО ""ТЕСТ%""");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДокументыЭДО.Добавить(Выборка.Ид);
			УдалитьЗаписьТеста("ЭАрМ_РеестрЭТрН", Новый Структура("ИдентификаторСБИС", Выборка.Ид));
		КонецЦикла;
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "УдалитьТестовыеДанные (реестр ЭТрН)", ИнформацияОбОшибке());
	КонецПопытки;
	// Тестовые УКД (ТЕСТУКД-): строка реестра корректировок и её товары
	УдаленоУКД = 0;
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	УКД.ИдентификаторСБИС КАК Ид
		|ИЗ
		|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
		|ГДЕ
		|	УКД.ИдентификаторСБИС ПОДОБНО ""ТЕСТ%""");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДокументыЭДО.Добавить(Выборка.Ид);
			УдаленоУКД = УдаленоУКД + УдалитьЗаписьТеста("ЭАрМ_УКД_Входящий", Новый Структура("ИдентификаторСБИС", Выборка.Ид));
		КонецЦикла;
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "УдалитьТестовыеДанные (реестр УКД)", ИнформацияОбОшибке());
	КонецПопытки;
	УдаленоУПД = 0;
	Для Каждого Ид Из ТестовыеУПД Цикл
		УдаленоУПД = УдаленоУПД + УдалитьЗаписьТеста("ЭАрМ_УПД_Входящий", Новый Структура("ИдентификаторСБИС", Ид));
	КонецЦикла;
	Для Каждого Ид Из ДокументыЭДО Цикл
		ОчиститьНаборТеста("ЭАрМ_ТоварыЭТрН", "ИдентификаторСБИС", Ид);
		ОчиститьНаборТеста("ЭАрМ_КодыМаркировкиСтрок", "ИдентификаторДокумента", Ид);
	КонецЦикла;
	Для Каждого Ид Из ПриходыТеста Цикл
		ОчиститьНаборТеста("ЭАрМ_КодыМаркировкиСтрок", "ИдентификаторДокумента", Ид);
	КонецЦикла;
	Строки.Добавить(СтрШаблон("  тестовых УПД удалено %1, УКД %2, ЭТрН %3 (с товарами и кодами маркировки)",
		УдаленоУПД, УдаленоУКД, ДокументыЭДО.Количество() - ТестовыеУПД.Количество() - УдаленоУКД));

	// --- 7. Штрихкоды тестового поставщика и его очередь номенклатуры ---
	Удалено = 0;
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Ш.Штрихкод КАК Штрихкод,
		|	Ш.КлючНаименования КАК КлючНаименования
		|ИЗ
		|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Ш
		|ГДЕ
		|	Ш.ИННПоставщика = &ИНН");
		Запрос.УстановитьПараметр("ИНН", ИННТестаСверки());
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Удалено = Удалено + УдалитьЗаписьТеста("ЭАрМ_ШтрихкодыПоставщиков",
				Новый Структура("Штрихкод, КлючНаименования", Выборка.Штрихкод, Выборка.КлючНаименования));
			УдалитьЗаписьТеста("ЭАрМ_ОчередьСозданияНоменклатуры", Новый Структура("Штрихкод", Выборка.Штрихкод));
		КонецЦикла;
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "УдалитьТестовыеДанные (штрихкоды тестового поставщика)",
			ИнформацияОбОшибке());
	КонецПопытки;
	Строки.Добавить(СтрШаблон("  штрихкодов тестового поставщика ИНН %1 удалено %2", ИННТестаСверки(), Удалено));

	Строки.Добавить("Трасса, журнал обмена и файлы в папке теста не тронуты.");
	ЭАрМ_ПриемПакетовДалион.Трасса("", "Тест: тестовые данные удалены - " + СтрСоединить(Строки, " "));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура УдалитьЦепочкуТеста(ИдентификаторЗаказа, ИдентификаторПоступления)

	Для Каждого ИмяРегистра Из СтрРазделить("ЭАрМ_ЦепочкаЗакупки,ЭАрМ_СверкаТоваровЦепочки,ЭАрМ_РеестрТоваровЗаказов", ",") Цикл
		Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		Набор.Отбор.ИдентификаторЗаказа.Установить(ИдентификаторЗаказа);
		Набор.Отбор.ИдентификаторПоступления.Установить(ИдентификаторПоступления);
		Набор.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Настоящая цепочка привязалась к тестовой УПД (тот же входящий номер и ИНН) -
// связь снимается, саму цепочку следующий проход свяжет заново.
//
Процедура ОтвязатьЦепочкуОтТестовойУПД(ИдентификаторЗаказа, ИдентификаторПоступления)

	Запись = РегистрыСведений.ЭАрМ_ЦепочкаЗакупки.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторЗаказа = ИдентификаторЗаказа;
	Запись.ИдентификаторПоступления = ИдентификаторПоступления;
	Запись.Прочитать();
	Если НЕ Запись.Выбран() Тогда
		Возврат;
	КонецЕсли;
	Запись.ИдентификаторУПД = "";
	Запись.НомерУПД = "";
	Запись.ДатаУПД = '00010101';
	Запись.СпособСвязиУПД = "";
	Запись.Записать(Истина);

	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления,
		"Тест: настоящая цепочка (заказ " + ИдентификаторЗаказа + ") отвязана от тестовой УПД");

КонецПроцедуры

Функция УдалитьДокументыТеста(ИмяДокумента, Идентификаторы)

	Если Идентификаторы.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Удалено = 0;
	Попытка
		Запрос = Новый Запрос(СтрШаблон(
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.%1 КАК Док
		|ГДЕ
		|	Док.ИдентификаторДалион В (&Идентификаторы)", ИмяДокумента));
		Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Удалить();
			Удалено = Удалено + 1;
		КонецЦикла;
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"УдалитьТестовыеДанные (документы " + ИмяДокумента + ")", ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Удалено;

КонецФункции

// Удаляет одну запись регистра сведений по значениям измерений.
//
// Возвращаемое значение:
//   Число - 1, если запись была и удалена, иначе 0
//
Функция УдалитьЗаписьТеста(ИмяРегистра, Измерения)

	Попытка
		Запись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
		Для Каждого КлючЗначение Из Измерения Цикл
			Запись[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЦикла;
		Запись.Прочитать();
		Если НЕ Запись.Выбран() Тогда
			Возврат 0;
		КонецЕсли;
		Запись.Удалить();
		Возврат 1;
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"УдалитьТестовыеДанные (" + ИмяРегистра + ")", ИнформацияОбОшибке());
		Возврат 0;
	КонецПопытки;

КонецФункции

Процедура ОчиститьНаборТеста(ИмяРегистра, ИмяИзмерения, Значение)

	Попытка
		Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		Набор.Отбор[ИмяИзмерения].Установить(Значение);
		Набор.Записать(Истина);
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(Значение,
			"УдалитьТестовыеДанные (" + ИмяРегистра + ")", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// УПД в формате ФНС (функция СЧФДОП), как её отдаёт СБИС. Цена в позиции
// включает НДС 10%, как в пакетах Далиона.
//
Процедура ЗаписатьXMLУПДТестаСверки(Путь, НомерУПД, ДатаТеста, Поставщик, ИННПоставщика, Позиции, Сумма,
	ВерсПрог = "Тест сверки")

	ДатаСтрокой = Формат(ДатаТеста, "ДФ=dd.MM.yyyy");
	ФорматЧисла = "ЧДЦ=2; ЧРД=.; ЧГ=0";

	ВсегоНДС = 0;
	Для Каждого Позиция Из Позиции Цикл
		ВсегоНДС = ВсегоНДС + Окр(Позиция.Сумма * 10 / 110, 2);
	КонецЦикла;

	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(Путь, "windows-1251");
	Запись.ЗаписатьОбъявлениеXML();

	НачатьЭлементXML(Запись, "Файл", Новый Структура("ИдФайл, ВерсФорм, ВерсПрог",
		"ON_NSCHFDOPPR_ТЕСТ_" + НомерУПД, "5.01", ВерсПрог));

	НачатьЭлементXML(Запись, "СвУчДокОбор", Новый Структура("ИдОтпр, ИдПол",
		"2BE-ТЕСТ-ПРОДАВЕЦ", "2BE-ТЕСТ-ПОКУПАТЕЛЬ"));
	ПустойЭлементXML(Запись, "СвОЭДОтпр", Новый Структура("НаимОрг, ИННЮЛ, ИдЭДО",
		"СБИС (тест)", "7605016030", "2BE"));
	Запись.ЗаписатьКонецЭлемента(); // СвУчДокОбор

	НачатьЭлементXML(Запись, "Документ", Новый Структура("КНД, ДатаДок, ВремДок, Функция",
		"1115131", ДатаСтрокой, "12.00.00", "СЧФДОП"));

	НачатьЭлементXML(Запись, "СвСчФакт", Новый Структура("НомерСчФ, ДатаСчФ, КодОКВ",
		НомерУПД, ДатаСтрокой, "643"));
	НачатьЭлементXML(Запись, "СвПрод");
	НачатьЭлементXML(Запись, "ИдСв");
	ПустойЭлементXML(Запись, "СвЮЛУч", Новый Структура("НаимОрг, ИННЮЛ, КПП",
		Поставщик, ИННПоставщика, "770301001"));
	Запись.ЗаписатьКонецЭлемента(); // ИдСв
	Запись.ЗаписатьКонецЭлемента(); // СвПрод
	НачатьЭлементXML(Запись, "СвПокуп");
	НачатьЭлементXML(Запись, "ИдСв");
	ПустойЭлементXML(Запись, "СвЮЛУч", Новый Структура("НаимОрг, ИННЮЛ, КПП",
		"Организация-Тест, ООО", "7700000000", "770001001"));
	Запись.ЗаписатьКонецЭлемента(); // ИдСв
	Запись.ЗаписатьКонецЭлемента(); // СвПокуп
	Запись.ЗаписатьКонецЭлемента(); // СвСчФакт

	НачатьЭлементXML(Запись, "ТаблСчФакт");
	Для Каждого Позиция Из Позиции Цикл

		НДСПозиции = Окр(Позиция.Сумма * 10 / 110, 2);
		БезНДС = Окр(Позиция.Сумма - НДСПозиции, 2);

		НачатьЭлементXML(Запись, "СведТов", Новый Структура(
			"НомСтр, НаимТов, ОКЕИ_Тов, КолТов, ЦенаТов, СтТовБезНДС, НалСт, СтТовУчНал",
			Формат(Позиция.Номер, "ЧГ=0"), Позиция.Наименование, "796",
			Формат(Позиция.Количество, ФорматЧисла), Формат(Окр(БезНДС / Позиция.Количество, 2), ФорматЧисла),
			Формат(БезНДС, ФорматЧисла), "10%", Формат(Позиция.Сумма, ФорматЧисла)));

		НачатьЭлементXML(Запись, "Акциз");
		ТекстовыйЭлементXML(Запись, "БезАкциз", "без акциза");
		Запись.ЗаписатьКонецЭлемента(); // Акциз

		НачатьЭлементXML(Запись, "СумНал");
		ТекстовыйЭлементXML(Запись, "СумНал", Формат(НДСПозиции, ФорматЧисла));
		Запись.ЗаписатьКонецЭлемента(); // СумНал

		ПустойЭлементXML(Запись, "ДопСведТов", Новый Структура("КодТов, ГТИН", Позиция.Артикул, Позиция.Штрихкод));
		ПустойЭлементXML(Запись, "ИнфПолФХЖ2", Новый Структура("Идентиф, Значен", "ШтрихКод", Позиция.Штрихкод));

		Запись.ЗаписатьКонецЭлемента(); // СведТов

	КонецЦикла;

	НачатьЭлементXML(Запись, "ВсегоОпл", Новый Структура("СтТовБезНДСВсего, СтТовУчНалВсего",
		Формат(Сумма - ВсегоНДС, ФорматЧисла), Формат(Сумма, ФорматЧисла)));
	НачатьЭлементXML(Запись, "СумНалВсего");
	ТекстовыйЭлементXML(Запись, "СумНал", Формат(ВсегоНДС, ФорматЧисла));
	Запись.ЗаписатьКонецЭлемента(); // СумНалВсего
	Запись.ЗаписатьКонецЭлемента(); // ВсегоОпл
	Запись.ЗаписатьКонецЭлемента(); // ТаблСчФакт

	НачатьЭлементXML(Запись, "СвПродПер");
	ПустойЭлементXML(Запись, "СвПер", Новый Структура("СодОпер, ДатаПер", "Товары переданы", ДатаСтрокой));
	Запись.ЗаписатьКонецЭлемента(); // СвПродПер

	Запись.ЗаписатьКонецЭлемента(); // Документ
	Запись.ЗаписатьКонецЭлемента(); // Файл
	Запись.Закрыть();

КонецПроцедуры

// Открывает элемент XML с атрибутами; закрывать вызывающему.
//
Процедура НачатьЭлементXML(Запись, Имя, Атрибуты = Неопределено)

	Запись.ЗаписатьНачалоЭлемента(Имя);

	Если Атрибуты <> Неопределено Тогда
		Для Каждого КлючЗначение Из Атрибуты Цикл
			Запись.ЗаписатьАтрибут(КлючЗначение.Ключ, Строка(КлючЗначение.Значение));
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Элемент без содержимого: открывается и сразу закрывается.
//
Процедура ПустойЭлементXML(Запись, Имя, Атрибуты = Неопределено)

	НачатьЭлементXML(Запись, Имя, Атрибуты);
	Запись.ЗаписатьКонецЭлемента();

КонецПроцедуры

// Элемент с текстом внутри: открывается, пишется текст, закрывается.
//
Процедура ТекстовыйЭлементXML(Запись, Имя, Текст)

	Запись.ЗаписатьНачалоЭлемента(Имя);
	Запись.ЗаписатьТекст(Текст);
	Запись.ЗаписатьКонецЭлемента();

КонецПроцедуры

