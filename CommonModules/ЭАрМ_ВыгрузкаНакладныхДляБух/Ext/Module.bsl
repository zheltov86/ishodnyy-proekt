КонецФункции

// --- Сборка JSON ---

// Возвращаемое значение:
//   Структура - Успех, Ошибка, ТекстJSON, Накладных, Строк,
//               Выгружены (Массив идентификаторов УПД, попавших в файл),
//               Описания (Соответствие: идентификатор - что отправлено),
//               Пропущены (Массив структур Идентификатор, Номер, Дата,
//                 Контрагент, ИНН, Причина - подписанные УПД, не попавшие в
//                 файл: нет строк товаров или ошибка сборки; 16.10.2026)
//
Функция СобратьJSON(Отбор)

	Результат = Новый Структура("Успех, Ошибка, ТекстJSON, Накладных, Строк, Выгружены, Описания, Пропущены",
		Ложь, "", "", 0, 0, Новый Массив, Новый Соответствие, Новый Массив);

	// Кэш идентификаторов ссылок на время сборки файла.
	// В общих модулях нельзя хранить состояние (Перем), поэтому кэш
	// создаётся здесь и передаётся параметром вниз по цепочке вызовов
	КэшИдентификаторов = Новый Соответствие;

	Попытка

		ТаблицаУПД = ДанныеУПД(Отбор);

		// Только УПД: идентификаторы ЭТрН-оснований не собираем,
		// строки ЭТрН в выгрузку не попадают
		Идентификаторы = ТаблицаУПД.ВыгрузитьКолонку("ИдентификаторСБИС");
		Груз = ТоварыПоИдентификаторам(Идентификаторы, Идентификаторы);

		Накладные = Новый Массив;
		ВсегоСтрок = 0;
		УжеВФайле = Новый Соответствие;
		Для Каждого СтрокаУПД Из ТаблицаУПД Цикл

			// Изоляция ошибок: сбой одной УПД не должен валить выгрузку остальных
			Попытка

				ИдентификаторУПД = ТекстИлиПусто(СтрокаУПД.ИдентификаторСБИС);
				Если УжеВФайле.Получить(ИдентификаторУПД) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;

				СтрокиГруза = СтрокиГрузаНакладной(СтрокаУПД, Груз);
				Если СтрокиГруза.Количество() = 0 Тогда
					// Груз ещё не раскрыт - без строк в БП3 нечего создавать.
					// Отметку не ставим: УПД уйдёт, когда груз загрузится
					ДобавитьПропущеннуюУПД(Результат, СтрокаУПД,
						НСтр("ru = 'нет строк товаров (груз не раскрыт)'"));
					Продолжить;
				КонецЕсли;

				Накладная = НакладнаяFormat1(СтрокаУПД, СтрокиГруза, КэшИдентификаторов);
				Накладные.Добавить(Накладная);
				УжеВФайле.Вставить(ИдентификаторУПД, Истина);
				ВсегоСтрок = ВсегоСтрок + Накладная.ТабличныеЧасти.Товары.Количество();
				Результат.Выгружены.Добавить(СтрокаУПД.ИдентификаторСБИС);
				Результат.Описания.Вставить(СтрокаУПД.ИдентификаторСБИС,
					ОписаниеОтправленного(Накладная));

			Исключение

				ТекстОшибкиУПД = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации("АРМ_ЭДО.ВыгрузкаНакладныхДляБух",
					УровеньЖурналаРегистрации.Ошибка, , ,
					СтрШаблон(НСтр("ru = 'УПД %1 не собрана для выгрузки: %2'"),
						СтрокаУПД.ИдентификаторСБИС, ТекстОшибкиУПД));
				ДобавитьПропущеннуюУПД(Результат, СтрокаУПД,
					НСтр("ru = 'ошибка сборки: '") + ТекстОшибкиУПД);

			КонецПопытки;

		КонецЦикла;

		Конверт = Новый Структура;
		Конверт.Вставить("выгружатьПриходнаяНакладная", Истина);
		Конверт.Вставить("ИдентификаторЗапроса", Строка(Новый УникальныйИдентификатор));
		Конверт.Вставить("ПериодС", Отбор.ПериодС);
		Конверт.Вставить("ПериодПо", Отбор.ПериодПо);
		Конверт.Вставить("Количество", Накладные.Количество());
		Конверт.Вставить("ПриходныеНакладные", Накладные);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Конверт);
		Результат.ТекстJSON = ЗаписьJSON.Закрыть();

	Исключение

		Результат.Ошибка = СтрШаблон(
			НСтр("ru = 'Не удалось собрать данные выгрузки: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ВыгрузкаНакладныхДляБух",
			УровеньЖурналаРегистрации.Ошибка, , , Результат.Ошибка);
		Возврат Результат;

	КонецПопытки;

	Результат.Накладных = Накладные.Количество();
	Результат.Строк = ВсегоСтрок;
	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// Что ушло по накладной: номер, строки по ставкам НДС, сумма.
//
Функция ОписаниеОтправленного(Накладная)

	Ставки = Новый Массив;
	Для Каждого СтрокаТовара Из Накладная.ТабличныеЧасти.Товары Цикл
		Ставки.Добавить(СтрШаблон("%1 %2", СтрокаТовара.СтавкаНДС,
			Формат(СтрокаТовара.Сумма, "ЧДЦ=2; ЧРД=.; ЧГ=0")));
	КонецЦикла;

	Возврат СтрШаблон(НСтр("ru = 'УПД № %1 на %2 (%3)'"),
		Накладная.Шапка.Номер,
		Формат(Накладная.Шапка.СуммаДокумента, "ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0.00"),
		СтрСоединить(Ставки, "; "));

КонецФункции

// --- Ответы Бухгалтерии ---

// Читает ответы Бухгалтерии из подпапки Ответы\ папки ПапкаВыгрузкиБух,
// пишет в очередь «Ожидает подтверждения ЭДО», принята ли накладная,
// и переносит прочитанный ответ в Ответы\Обработанные\.
//
// Возвращаемое значение:
//   Число - сколько накладных отмечено
//
Функция ПрочитатьОтветыБухгалтерии() Экспорт

	Отмечено = 0;

	ПапкаВыгрузки = ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПапкаВыгрузкиБух");
	Если НЕ ЗначениеЗаполнено(ПапкаВыгрузки) Тогда
		Возврат Отмечено;
	КонецЕсли;

	КаталогОтветов = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(ПапкаВыгрузки, "Ответы");
	Если НЕ ФайлСуществует(КаталогОтветов) Тогда
		Возврат Отмечено;
	КонецЕсли;

	// Без подкаталогов: в Ответы\Обработанные\ лежат уже прочитанные ответы
	Для Каждого Файл Из НайтиФайлы(КаталогОтветов, "*.json", Ложь) Цикл

		Попытка

			ЧтениеТекста = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
			ТекстJSON = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();

			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТекстJSON);
			Ответ = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();

			МоментОтвета = МоментОтветаБухгалтерии(Ответ, Файл);

			Накладные = Новый Массив;
			Если ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("Накладные") Тогда
				Накладные = Ответ.Накладные;
			КонецЕсли;

			Для Каждого Накладная Из Накладные Цикл
				Идентификатор = ТекстИлиПусто(ЗначениеПоля(Накладная, "ИдентификаторУПД"));
				Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
					Продолжить;
				КонецЕсли;
				ЗаписатьВОчередь(Идентификатор, ТекстОтветаБухгалтерии(Накладная, МоментОтвета));
				// Реестр УПД / УКД: «Отправлено в Бух» и что создано, журнал пакетов (16.10.2026)
				ОтметитьОтветВРеестре(Идентификатор, Накладная, ДатаОтветаБухгалтерии(Ответ, Файл), Файл.Имя,
					ФайлПакетаОтвета(Ответ, Накладная));
				Отмечено = Отмечено + 1;
			КонецЦикла;

			ПереместитьОтвет(Файл, КаталогОтветов);

		Исключение
			// Файл остаётся в папке: прочитается следующим проходом
			ЗаписьЖурналаРегистрации("АРМ_ЭДО.ВыгрузкаНакладныхДляБух",
				УровеньЖурналаРегистрации.Ошибка, , ,
				СтрШаблон(НСтр("ru = 'Ответ БП %1 не прочитан: %2'"),
					Файл.Имя, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

	Возврат Отмечено;

КонецФункции

Функция ТекстОтветаБухгалтерии(Накладная, МоментОтвета)

	Принята = ЗначениеПоля(Накладная, "Принята") = Истина;
	Статус = ТекстИлиПусто(ЗначениеПоля(Накладная, "Статус"));

	// «Уже получена…» и «срок оплаты дополнен» - не ошибка и не повод
	// слать накладную заново: отметка ВыгруженВБух не снимается
	Если НЕ Принята И НЕ СтатусБухгалтерииПринят(Статус) Тогда
		Возврат СтрШаблон(НСтр("ru = 'БП НЕ приняла %1: %2'"), МоментОтвета, Статус);
	КонецЕсли;

	Сумма = ЗначениеПоля(Накладная, "Сумма");
	Если ТипЗнч(Сумма) <> Тип("Число") Тогда
		Сумма = 0;
	КонецЕсли;

	// Статус от Монитора папок: номера и суммы документа в нём нет
	Если НЕ ЗначениеЗаполнено(ТекстИлиПусто(ЗначениеПоля(Накладная, "Номер"))) И Сумма = 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'Принято БП %1 (%2)'"), МоментОтвета, Статус);
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Принято БП %1 (%2): № %3 на %4'"),
		МоментОтвета, Статус,
		ТекстИлиПусто(ЗначениеПоля(Накладная, "Номер")),
		Формат(Сумма, "ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0.00"));

КонецФункции

// «Принята», «Уже получена в файле…», «Уже получена, документ создан»
// и тот же текст с хвостом «, срок оплаты дополнен».
//
Функция СтатусБухгалтерииПринят(Статус)

	Текст = НРег(СокрЛП(Статус));
	Если НЕ ЗначениеЗаполнено(Текст) ИЛИ СтрНайти(Текст, "не принят") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНачинаетсяС(Текст, "принята")
		ИЛИ СтрНайти(Текст, "уже получена") > 0
		ИЛИ СтрНайти(Текст, "срок оплаты дополнен") > 0;

КонецФункции

// Когда Бухгалтерия приняла файл; не прочиталось - время файла ответа.
//
Функция МоментОтветаБухгалтерии(Ответ, Файл)

	// ДатаПриема из JSON уже приходит типом Дата (1С сам конвертирует ISO)
	ЗначениеДаты = ЗначениеПоля(Ответ, "ДатаПриема");
	Если ТипЗнч(ЗначениеДаты) = Тип("Дата") И ЗначениеЗаполнено(ЗначениеДаты) Тогда
		Возврат Формат(ЗначениеДаты, "ДФ='dd.MM.yyyy HH:mm'");
	КонецЕсли;

	Если ТипЗнч(ЗначениеДаты) = Тип("Строка") И ЗначениеЗаполнено(ЗначениеДаты) Тогда
		Попытка
			Возврат Формат(XMLЗначение(Тип("Дата"), ЗначениеДаты), "ДФ='dd.MM.yyyy HH:mm'");
		Исключение
			// падаем на время файла ниже
		КонецПопытки;
	КонецЕсли;

	Возврат Формат(Файл.ПолучитьВремяИзменения(), "ДФ='dd.MM.yyyy HH:mm'");

КонецФункции

Процедура ПереместитьОтвет(Файл, КаталогОтветов)

	КаталогОбработанных = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(КаталогОтветов, "Обработанные");
	Если НЕ ФайлСуществует(КаталогОбработанных) Тогда
		СоздатьКаталог(КаталогОбработанных);
	КонецЕсли;

	// Коллизия имени: старый ответ не удаляем - переименовываем,
	// чтобы не потерять историю
	ПутьНазначения = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(КаталогОбработанных, Файл.Имя);
	Если ФайлСуществует(ПутьНазначения) Тогда
		ИмяБезРасширения = Файл.ИмяБезРасширения;
		Расширение = Файл.Расширение;
		ПутьНазначения = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(КаталогОбработанных,
			СтрШаблон("%1_%2%3", ИмяБезРасширения,
				Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss"), Расширение));
	КонецЕсли;

	ПереместитьФайл(Файл.ПолноеИмя, ПутьНазначения);

КонецПроцедуры

// Пишет в поле «Бухгалтерия» очереди «Ожидает подтверждения ЭДО» по всем
// строкам документа. Строки очереди нет - только журнал: отметка
// ВыгруженВБух в реестре УПД всё равно стоит.
//
Процедура ЗаписатьВОчередь(ИдентификаторУПД, Текст)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторСБИС = &ИдентификаторСБИС
	|	И Очередь.Реестр <> """"";
	Запрос.УстановитьПараметр("ИдентификаторСБИС", ИдентификаторУПД);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ВыгрузкаНакладныхДляБух",
			УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон(НСтр("ru = 'УПД %1 нет в очереди подтверждений: %2'"), ИдентификаторУПД, Текст));
		Возврат;
	КонецЕсли;

	Пока Выборка.Следующий() Цикл

		НачатьТранзакцию();
		Попытка

			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО");
			ЭлементБлокировки.УстановитьЗначение("ЭлектронныйДокумент", Выборка.ЭлектронныйДокумент);
			ЭлементБлокировки.УстановитьЗначение("ИдентификаторЗапроса", Выборка.ИдентификаторЗапроса);
			Блокировка.Заблокировать();

			МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ЭлектронныйДокумент = Выборка.ЭлектронныйДокумент;
			МенеджерЗаписи.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
			МенеджерЗаписи.Прочитать();

			Если МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.Бухгалтерия = Лев(Текст, 500);
				МенеджерЗаписи.Записать(Истина);
			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("АРМ_ЭДО.ВыгрузкаНакладныхДляБух",
				УровеньЖурналаРегистрации.Предупреждение, , ,
				СтрШаблон(НСтр("ru = 'УПД %1: поле «БП» в очереди не записано: %2'"),
					ИдентификаторУПД, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Файл или каталог существует. Отдельной функцией: вызвать метод прямо
// у выражения в скобках (Новый Файл ...) встроенный язык не даёт.
//
Функция ФайлСуществует(Путь)

	Файл = Новый Файл(Путь);
	Возврат Файл.Существует();

КонецФункции

Функция ЗначениеПоля(Данные, ИмяПоля)

	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Данные.Свойство(ИмяПоля, Значение);
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Данные.Получить(ИмяПоля);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// --- Источники данных ---

// Шапки подписанных и не закрытых в СБИС входящих УПД. Подпись - как в
// ЭАрМ_ОбработкаПодтвержденийЭДО: признак Подписано или статус «Подписан».
//
Функция ДанныеУПД(Отбор)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.Представление КАК Представление,
	|	УПД.Организация КАК Организация,
	|	УПД.Контрагент КАК Контрагент,
	|	УПД.ИННКонтрагента КАК ИННКонтрагента,
	|	УПД.ИННОрганизации КАК ИННОрганизации,
	|	УПД.ДатаЗагрузки КАК ДатаЗагрузки,
	|	УПД.ДатаВремяСБИС КАК ДатаВремяСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.Дата МЕЖДУ &ПериодС И &ПериодПо
	|	И УПД.ЗамененаНа = """"
	|	И НЕ УПД.ИдентификаторСБИС В (#Замененные)
	|	И (УПД.Подписано
	|		ИЛИ УПД.СтатусПодписания = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан))
	|	И &УсловиеНеЗакрыт
	|	И (НЕ &ТолькоНеВыгруженные
	|		ИЛИ НЕ УПД.ВыгруженВБух)
	|	И (&ИдентификаторУПД = """"
	|		ИЛИ УПД.ИдентификаторСБИС = &ИдентификаторУПД)
	|	И НЕ УПД.Формат В (&НеУПД)
	|
	|УПОРЯДОЧИТЬ ПО
	|	УПД.Дата,
	|	УПД.Номер";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНеЗакрыт", "(" +
		ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УПД") + ")");

	// Заменённая более поздней УПД с тем же номером не уходит: в Бухгалтерию
	// нужна последняя
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#Замененные", ТекстЗапросаЗамененныхУПД(
		"Старая.Дата МЕЖДУ &ПериодС И &ПериодПо"));

	// В выгрузку идут только УПД. Раньше формат сверялся с настройкой
	// СБИС_ТипВложенияУПД («УпдДоп,УпдСчфДоп,ЭДОНакл,СчФктр») - это коды
	// фильтра СБИС, а в реестре Формат - «УПД», «Счёт-фактура», «Накладная ЭДО»
	// (ЭАрМ_Служебный.ФорматДокументаПоВложениям). Совпадений не было ни одного,
	// и подписанные УПД молча не уходили в Бухгалтерию. Теперь отсекается то,
	// что точно не УПД: корректировки, ЭТрН, путевые листы
	НеУПД = Новый Массив;
	НеУПД.Добавить(ЭАрМ_КорректировкиУПД.ФорматКорректировки());
	НеУПД.Добавить("УКД");
	НеУПД.Добавить("ЭТрН");
	НеУПД.Добавить("ЭПЛ");

	Запрос.УстановитьПараметр("ПериодС", Отбор.ПериодС);
	Запрос.УстановитьПараметр("ПериодПо", Отбор.ПериодПо);
	Запрос.УстановитьПараметр("ТолькоНеВыгруженные", Отбор.ТолькоНеВыгруженные);
	Запрос.УстановитьПараметр("ИдентификаторУПД", СокрЛП(Отбор.ИдентификаторУПД));
	Запрос.УстановитьПараметр("НеУПД", НеУПД);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Подписанная УПД, не попавшая в файл, - в Пропущены результата сборки: по
// ним обработка выгрузки показывает, что в Бух не уйдёт и почему.
//
Процедура ДобавитьПропущеннуюУПД(Результат, СтрокаУПД, Причина)

	Результат.Пропущены.Добавить(Новый Структура("Идентификатор, Номер, Дата, Контрагент, ИНН, Причина",
		ТекстИлиПусто(СтрокаУПД.ИдентификаторСБИС), ТекстИлиПусто(СтрокаУПД.Номер), СтрокаУПД.Дата,
		ТекстИлиПусто(СтрокаУПД.Контрагент), ТекстИлиПусто(СтрокаУПД.ИННКонтрагента), Причина));

КонецПроцедуры

// Выбирает строки УПД и раскладывает их по двум ключам:
// собственному идентификатору УПД и ссылке на УПД (ИдентификаторУПД).
//
Функция ТоварыПоИдентификаторам(Идентификаторы, ИдентификаторыУПД)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Товары.ИдентификаторУПД КАК ИдентификаторУПД,
	|	Товары.ИсточникТоваров КАК ИсточникТоваров,
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.Наименование КАК Наименование,
	|	Товары.КодНоменклатуры КАК КодНоменклатуры,
	|	Товары.Артикул КАК Артикул,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.Алкоголь КАК Алкоголь
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	(Товары.ИдентификаторСБИС В (&Идентификаторы)
	|			ИЛИ Товары.ИдентификаторУПД В (&ИдентификаторыУПД))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.ИдентификаторСБИС,
	|	Товары.НомерПозиции";

	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Запрос.УстановитьПараметр("ИдентификаторыУПД", ИдентификаторыУПД);

	Груз = Новый Структура("ПоИдентификатору, ПоУПД",
		Новый Соответствие, Новый Соответствие);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		СтрокаГруза = Новый Структура(
			"НомерПозиции, Наименование, КодНоменклатуры, Артикул, ЕдиницаИзмерения,
			|ИсточникТоваров, Количество, Цена, Сумма, СтавкаНДС, СуммаНДС, Алкоголь",
			Выборка.НомерПозиции, Выборка.Наименование, Выборка.КодНоменклатуры,
			Выборка.Артикул, Выборка.ЕдиницаИзмерения, Выборка.ИсточникТоваров,
			Выборка.Количество, Выборка.Цена, Выборка.Сумма,
			Выборка.СтавкаНДС, Выборка.СуммаНДС, Выборка.Алкоголь);

		ДобавитьСтрокуГруза(Груз.ПоИдентификатору,
			Выборка.ИдентификаторСБИС, СтрокаГруза);
		Если ЗначениеЗаполнено(Выборка.ИдентификаторУПД) Тогда
			ДобавитьСтрокуГруза(Груз.ПоУПД,
				Выборка.ИдентификаторУПД, СтрокаГруза);
		КонецЕсли;

	КонецЦикла;

	Возврат Груз;

КонецФункции

Процедура ДобавитьСтрокуГруза(Корзина, Идентификатор, СтрокаГруза)

	Ключ = ВРег(СокрЛП(Строка(Идентификатор)));
	Строки = Корзина.Получить(Ключ);
	Если Строки = Неопределено Тогда
		Строки = Новый Массив;
		Корзина.Вставить(Ключ, Строки);
	КонецЕсли;
	Строки.Добавить(СтрокаГруза);

КонецПроцедуры

// Выбирает строки груза для накладной в порядке приоритета:
//  1) раскрытые строки УПД под его собственным идентификатором;
//  2) строки УПД, записанные под идентификатором ЭТрН (ИдентификаторУПД).
// Строки ЭТрН в выгрузку не берутся никогда.
//
Функция СтрокиГрузаНакладной(СтрокаУПД, Груз)

	Строки = СтрокиИзСоответствия(Груз.ПоИдентификатору,
		СтрокаУПД.ИдентификаторСБИС, "УПД");

	Если Строки.Количество() = 0 Тогда
		Строки = СтрокиИзСоответствия(Груз.ПоУПД,
			СтрокаУПД.ИдентификаторСБИС, "УПД");
	КонецЕсли;

	Возврат Строки;

КонецФункции

Функция СтрокиИзСоответствия(Корзина, Идентификатор, Источник)

	Результат = Новый Массив;

	Строки = Корзина.Получить(ВРег(СокрЛП(Строка(Идентификатор))));
	Если Строки = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого СтрокаГруза Из Строки Цикл
		Если НЕ ЗначениеЗаполнено(Источник)
			ИЛИ СтрокаГруза.ИсточникТоваров = Источник Тогда
			Результат.Добавить(СтрокаГруза);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// --- Формат 1 ---

// Собирает накладную формата 1: Шапка + ТабличныеЧасти.Товары.
//
Функция НакладнаяFormat1(СтрокаУПД, СтрокиГруза, КэшИдентификаторов)

	Номер = ТекстИлиПусто(СтрокаУПД.Номер);
	ПредставлениеДокумента = СтрШаблон("УПД №%1 от %2",
		Номер, Формат(СтрокаУПД.Дата, "ДФ=dd.MM.yyyy"));

	Комментарий = СтрШаблон(НСтр("ru = 'Выгружено из %1'"), ПредставлениеДокумента);

	НаименованиеКонтрагента = ТекстИлиПусто(СтрокаУПД.Контрагент);
	НаименованиеОрганизации = ТекстИлиПусто(СтрокаУПД.Организация);

	// В Бухгалтерии нет товарной номенклатуры: на её стороне строки
	// сворачиваются по ставке НДС (ОбменED_ПриемДанных). В файл идут
	// КАЖДАЯ товарная позиция - чтобы дерево УПД в Бухгалтерии показывало
	// реальные товары и сверяло их с документом
	Товары = СтрокиТоваровFormat1(СтрокиГруза);
	СуммаДокумента = 0;
	Для Каждого СтрокаГруза Из СтрокиГруза Цикл
		СуммаДокумента = СуммаДокумента + СтрокаГруза.Сумма;
	КонецЦикла;

	Шапка = Новый Структура;
	Шапка.Вставить("Ссылка", ОписаниеСсылки(ПредставлениеДокумента,
		ПсевдоУИД(СтрШаблон("УПД|%1", СтрокаУПД.ИдентификаторСБИС))));
	Шапка.Вставить("Номер", Номер);
	// По нему ответ Бухгалтерии находит строку УТ
	Шапка.Вставить("ИдентификаторУПД", ТекстИлиПусто(СтрокаУПД.ИдентификаторСБИС));
	Шапка.Вставить("ВходящийНомер", Номер);
	Шапка.Вставить("Дата", СтрокаУПД.Дата);
	// Когда УПД создана в СБИС (у старых записей - когда получена).
	// Поле информационное: выбор «последней» УПД с одним номером делает
	// сама выгрузка (ТекстЗапросаЗамененныхУПД), Бухгалтерия поле не читает
	Шапка.Вставить("ДатаПолучения", ?(ЗначениеЗаполнено(СтрокаУПД.ДатаВремяСБИС),
		СтрокаУПД.ДатаВремяСБИС, СтрокаУПД.ДатаЗагрузки));
	Шапка.Вставить("Проведен", Истина);
	Шапка.Вставить("ПометкаУдаления", Ложь);
	Контрагент = ОписаниеСсылки(НаименованиеКонтрагента,
		ИдентификаторКонтрагента(СтрокаУПД.ИННКонтрагента, НаименованиеКонтрагента, КэшИдентификаторов));
	// По ИНН Бухгалтерия находит контрагента: УИД из УТ там обычно нет
	Контрагент.Вставить("ИНН", ТекстИлиПусто(СтрокаУПД.ИННКонтрагента));
	Шапка.Вставить("Контрагент", Контрагент);
	// Договор поставщика - из УТ. Дата платежа = дата УПД + СрокОплаты
	// (дни отсрочки). Бухгалтерия пишет её в комментарий поступления
	// Организация - раньше договора: по ней же ищется договор поставщика.
	// Сначала по ИНН нашей стороны из СБИС, потом по названию
	// Расчёт один с реестром УПД (колонка «Дата оплаты»): РасчетДатыОплатыУПД
	Договор = РасчетДатыОплатыУПД(СтрокаУПД.ИННКонтрагента, НаименованиеОрганизации,
		СтрокаУПД.ИННОрганизации, СтрокаУПД.Дата, КэшИдентификаторов);
	РеквизитыФирмы = Договор.РеквизитыФирмы;
	Если НЕ Договор.Найден Тогда
		ОтметитьОтсутствиеДоговора(СтрокаУПД);
	КонецЕсли;
	Шапка.Вставить("ДоговорКонтрагента", ОписаниеСсылки(Договор.Представление, Договор.Идентификатор));
	Шапка.Вставить("ДатаПлатежа", Договор.ДатаПлатежа);
	// УПД заменяет приходную накладную: фирма - организация УПД.
	// ИНН нужен Бухгалтерии: УИД этой базы там не находится
	Фирма = ОписаниеСсылки(НаименованиеОрганизации, РеквизитыФирмы.Идентификатор);
	Фирма.Вставить("ИНН", РеквизитыФирмы.ИНН);
	Шапка.Вставить("Фирма", Фирма);
	// Склад БП3 подберёт сам
	Шапка.Вставить("Склад", ОписаниеСсылки("", ""));
	Шапка.Вставить("СуммаДокумента", СуммаДокумента);
	Шапка.Вставить("УчитыватьНДС", Истина);
	// Суммы строк содержат НДС (как в грузе СБИС), см. Пример_JSON
	Шапка.Вставить("СуммаВключаетНДС", Истина);
	Шапка.Вставить("Комментарий", Комментарий);

	ТабличныеЧасти = Новый Структура;
	ТабличныеЧасти.Вставить("Товары", Товары);

	Накладная = Новый Структура;
	Накладная.Вставить("Шапка", Шапка);
	Накладная.Вставить("ТабличныеЧасти", ТабличныеЧасти);

	Возврат Накладная;

КонецФункции

// Товарные позиции накладной - каждая строка груза отдельно, без свёртки
// по ставке НДС. Свёртку делает сторона Бухгалтерии при приёме
// (ОбменED_ПриемДанных.СвернутьТоварыПоСтавкам). Позиций = 1: строка
// соответствует одной товарной позиции, а не сводной строке ставки.
//
Функция СтрокиТоваровFormat1(СтрокиГруза)

	Результат = Новый Массив;

	Для Каждого СтрокаГруза Из СтрокиГруза Цикл

		СтавкаНДС = ТекстИлиПусто(СтрокаГруза.СтавкаНДС);
		Если НЕ ЗначениеЗаполнено(СтавкаНДС) Тогда
			СтавкаНДС = "БезНДС";
		КонецЕсли;

		Наименование = ТекстИлиПусто(СтрокаГруза.Наименование);
		Если НЕ ЗначениеЗаполнено(Наименование) Тогда
			Наименование = СтрШаблон(НСтр("ru = 'Позиция %1'"), СтрокаГруза.НомерПозиции);
		КонецЕсли;

		СтрокаТовара = Новый Структура;
		СтрокаТовара.Вставить("Номенклатура", ОписаниеСсылки(Наименование, ""));
		СтрокаТовара.Вставить("Позиций", 1);
		СтрокаТовара.Вставить("Количество", СтрокаГруза.Количество);
		СтрокаТовара.Вставить("Цена", СтрокаГруза.Цена);
		СтрокаТовара.Вставить("Сумма", СтрокаГруза.Сумма);
		СтрокаТовара.Вставить("СтавкаНДС", СтавкаНДС);
		СтрокаТовара.Вставить("СуммаНДС", СтрокаГруза.СуммаНДС);

		// Дополнительно: код/артикул/ЕИ - для дерева и сверки в Бухгалтерии
		СтрокаТовара.Вставить("КодНоменклатуры", ТекстИлиПусто(СтрокаГруза.КодНоменклатуры));
		СтрокаТовара.Вставить("Артикул", ТекстИлиПусто(СтрокаГруза.Артикул));
		СтрокаТовара.Вставить("ЕдиницаИзмерения", ТекстИлиПусто(СтрокаГруза.ЕдиницаИзмерения));
		// Признак алкоголя строки УПД (см. ЭАрМ_АлкогольЕГАИС.ПредставлениеСведений):
		// «Алкоголь 510 Водка, 40%, 0.5 л (алкокод ...)». Пусто - не алкоголь.
		СтрокаТовара.Вставить("Алкоголь", ТекстИлиПусто(СтрокаГруза.Алкоголь));

		Результат.Добавить(СтрокаТовара);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОписаниеСсылки(Представление, УникальныйИдентификатор)

	Возврат Новый Структура("Представление, УникальныйИдентификатор",
		ТекстИлиПусто(Представление), ТекстИлиПусто(УникальныйИдентификатор));

КонецФункции

// --- Идентификаторы ссылок ---

// Кэш идентификаторов контрагентов/организаций на время сборки файла
// создаётся в СобратьJSON и передаётся параметром (в общем модуле
// нельзя хранить состояние между вызовами через Перем).
// Идентификатор контрагента: реальный УИД справочника УТ (единого с БП3
// при обмене EnterpriseData), иначе детерминированный псевдо-УИД.
//
Функция ИдентификаторКонтрагента(ИНН, Наименование, Кэш)

	ИНН = ТекстИлиПусто(ИНН);
	Наименование = ТекстИлиПусто(Наименование);

	КлючКэша = "Контрагент|" + ВРег(ИНН) + "|" + ВРег(Наименование);
	Закэшировано = Кэш.Получить(КлючКэша);
	Если Закэшировано <> Неопределено Тогда
		Возврат Закэшировано;
	КонецЕсли;

	Результат = "";

	Если ЗначениеЗаполнено(ИНН) Тогда
		Идентификатор = УникальныйИдентификаторПоЗапросу(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Контрагенты
			|ГДЕ НЕ ЭтоГруппа И ИНН = &ИНН
			|УПОРЯДОЧИТЬ ПО Наименование",
			Новый Структура("ИНН", ИНН));
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Результат = Идентификатор;
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Результат) И ЗначениеЗаполнено(Наименование) Тогда
		Идентификатор = УникальныйИдентификаторПоЗапросу(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Контрагенты
			|ГДЕ НЕ ЭтоГруппа И Наименование = &Наименование
			|УПОРЯДОЧИТЬ ПО Наименование",
			Новый Структура("Наименование", Наименование));
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Результат = Идентификатор;
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = ПсевдоУИД(СтрШаблон("Контрагент|%1|%2", ИНН, Наименование));
	КонецЕсли;

	Кэш.Вставить(КлючКэша, Результат);
	Возврат Результат;

КонецФункции


// Договор с поставщиком в УТ и дата платежа.
// СрокОплаты в договоре - календарные дни отсрочки, не рабочие и не «до числа».
// 0 дней даёт дату платежа, равную дате УПД: это срок, а не его отсутствие.
// Нет договора - пустые ссылка и дата. Найден = Ложь.
//
Функция ДоговорПоставщикаУТ(ИНН, НаименованиеОрганизации, ДатаУПД, Кэш, ОрганизацияСсылка = Неопределено)

	Пустой = Новый Структура("Идентификатор, Представление, ДатаПлатежа, Найден", "", "", '00010101', Ложь);

	ИНН = ТекстИлиПусто(ИНН);
	НаименованиеОрганизации = ТекстИлиПусто(НаименованиеОрганизации);
	Если НЕ ЗначениеЗаполнено(ИНН) ИЛИ НЕ ЗначениеЗаполнено(ДатаУПД) Тогда
		Возврат Пустой;
	КонецЕсли;

	КлючКэша = "Договор|" + ВРег(ИНН) + "|" + ВРег(НаименованиеОрганизации) + "|"
		+ ?(ОрганизацияСсылка = Неопределено, "", Строка(ОрганизацияСсылка.УникальныйИдентификатор()));
	Закэшировано = Кэш.Получить(КлючКэша);
	Если Закэшировано <> Неопределено Тогда
		// Дата УПД у накладных разная, дни договора одни: дату считаем заново
		Результат = Новый Структура("Идентификатор, Представление, ДатаПлатежа, Найден",
			Закэшировано.Идентификатор, Закэшировано.Представление, '00010101', Закэшировано.Найден);
		Если Закэшировано.Найден Тогда
			Результат.ДатаПлатежа = НачалоДня(ДатаУПД) + Закэшировано.Дней * 86400;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Найденный = Новый Структура("Идентификатор, Представление, Дней, Найден", "", "", 0, Ложь);

	Попытка

		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Договоры.Ссылка КАК Ссылка,
			|	Договоры.Наименование КАК Наименование,
			|	Договоры.СрокОплаты КАК СрокОплаты
			|ИЗ
			|	Справочник.ДоговорыКонтрагентов КАК Договоры
			|ГДЕ
			|	Договоры.Контрагент.ИНН = &ИНН
			|	И Договоры.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПоставщиком)
			|	И Договоры.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.Действует)
			|	И НЕ Договоры.ПометкаУдаления
			|	И (&БезОрганизации
			|		ИЛИ Договоры.Организация = &ОрганизацияСсылка
			|		ИЛИ Договоры.Организация.Наименование = &Организация)
			|	И Договоры.ДатаНачалаДействия <= &Дата
			|	И (Договоры.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
			|		ИЛИ Договоры.ДатаОкончанияДействия >= &Дата)
			|
			|УПОРЯДОЧИТЬ ПО
			|	Договоры.УстановленСрокОплаты УБЫВ,
			|	Договоры.Дата УБЫВ");
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Запрос.УстановитьПараметр("Организация", НаименованиеОрганизации);
		Запрос.УстановитьПараметр("ОрганизацияСсылка", ОрганизацияСсылка);
		Запрос.УстановитьПараметр("БезОрганизации",
			НЕ ЗначениеЗаполнено(НаименованиеОрганизации) И ОрганизацияСсылка = Неопределено);
		Запрос.УстановитьПараметр("Дата", НачалоДня(ДатаУПД));

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Найденный.Идентификатор = Строка(Выборка.Ссылка.УникальныйИдентификатор());
			Найденный.Представление = ТекстИлиПусто(Выборка.Наименование);
			Найденный.Дней = ?(ТипЗнч(Выборка.СрокОплаты) = Тип("Число"), Выборка.СрокОплаты, 0);
			Найденный.Найден = Истина;
		КонецЕсли;

	Исключение
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ВыгрузкаНакладныхДляБух",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			СтрШаблон(НСтр("ru = 'Договор поставщика не прочитан, ИНН %1, организация %2, дата УПД %3: %4'"),
				ИНН, НаименованиеОрганизации, Формат(ДатаУПД, "ДЛФ=D"),
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ДоговорПоставщикаУТ (договор поставщика не прочитан, ИНН " + ИНН + ")", ИнформацияОбОшибке());
	КонецПопытки;

	Кэш.Вставить(КлючКэша, Найденный);

	Результат = Новый Структура("Идентификатор, Представление, ДатаПлатежа, Найден",
		Найденный.Идентификатор, Найденный.Представление, '00010101', Найденный.Найден);
	Если Найденный.Найден Тогда
		Результат.ДатаПлатежа = НачалоДня(ДатаУПД) + Найденный.Дней * 86400;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Договор поставщика в УТ и дата оплаты УПД - ЕДИНЫЙ расчёт.
//
// Его вызывают и выгрузка накладных в Бух (ДатаПлатежа), и реестр УПД
// (ресурс ДатаОплаты, ОбновитьДатыОплатыУПД), поэтому даты в УТ и в БП
// не расходятся.
//
// Правило: ДатаОплаты = НачалоДня(дата УПД) + СрокОплаты договора поставщика (календарные
// дни). Срок 0 при найденном договоре даёт дату УПД. Договоров несколько - берётся
// тот, где установлен срок оплаты, затем более поздний по дате (см. ДоговорПоставщикаУТ).
// Нет договора - дата пустая, Найден = Ложь.
//
// Параметры:
//   ИННКонтрагента         - Строка - ИНН поставщика
//   НаименованиеОрганизации - Строка - организация УПД (наша сторона)
//   ИННОрганизации         - Строка - ИНН нашей организации из СБИС
//   ДатаУПД                - Дата
//   Кэш                    - Соответствие, Неопределено - общий кэш прохода
//
// Возвращаемое значение:
//   Структура:
//     * Идентификатор  - Строка - УИД договора УТ
//     * Представление  - Строка - наименование договора
//     * ДатаПлатежа    - Дата - дата оплаты, пусто при Найден = Ложь
//     * Найден         - Булево
//     * РеквизитыФирмы - Структура - см. РеквизитыОрганизации
//
Функция РасчетДатыОплатыУПД(ИННКонтрагента, НаименованиеОрганизации, ИННОрганизации, ДатаУПД, Кэш = Неопределено) Экспорт

	Если Кэш = Неопределено Тогда
		Кэш = Новый Соответствие;
	КонецЕсли;

	РеквизитыФирмы = РеквизитыОрганизации(НаименованиеОрганизации, ТекстИлиПусто(ИННОрганизации), Кэш);
	Результат = ДоговорПоставщикаУТ(ИННКонтрагента, НаименованиеОрганизации, ДатаУПД, Кэш, РеквизитыФирмы.Ссылка);
	Результат.Вставить("РеквизитыФирмы", РеквизитыФирмы);

	Возврат Результат;

КонецФункции

// Пересчитывает ресурс ДатаОплаты реестра УПД по договору поставщика в УТ.
//
// Пишутся только изменившиеся строки (с блокировкой строки реестра). Зовут:
// сводка реестра УПД (ОбновитьСводкуРеестраУПД), приём договора из Далиона
// (по ИНН поставщиков) и приём самой УПД.
//
// Параметры:
//   Идентификаторы - Массив, Неопределено - УПД; Неопределено - по периоду и ИНН
//   ДатаС, ДатаПо  - Дата - период по дате УПД (пустые - без границы)
//   ИННы           - Массив, Неопределено - только УПД этих поставщиков
//   ТолькоПустые   - Булево - только УПД, у которых даты оплаты ещё нет (для частого
//                    пересчёта из сводки: заполненные меняет приём договора и приём УПД)
//
// Возвращаемое значение:
//   Число - сколько строк обновлено
//
Функция ОбновитьДатыОплатыУПД(Знач Идентификаторы = Неопределено, Знач ДатаС = Неопределено,
	Знач ДатаПо = Неопределено, Знач ИННы = Неопределено, Знач ТолькоПустые = Ложь) Экспорт

	Если ТипЗнч(Идентификаторы) = Тип("Массив") И Идентификаторы.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Если ТипЗнч(ИННы) = Тип("Массив") И ИННы.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УПД.Дата КАК Дата,
	|	УПД.ИННКонтрагента КАК ИННКонтрагента,
	|	УПД.Организация КАК Организация,
	|	УПД.ИННОрганизации КАК ИННОрганизации,
	|	УПД.ДатаОплаты КАК ДатаОплаты
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.ТипРеестра <> ""Отправленные""
	|	И (НЕ &ПоИдентификаторам ИЛИ УПД.ИдентификаторСБИС В (&Идентификаторы))
	|	И (НЕ &ПоИНН ИЛИ УПД.ИННКонтрагента В (&ИННы))
	|	И (НЕ &ТолькоПустые ИЛИ УПД.ДатаОплаты = ДАТАВРЕМЯ(1, 1, 1))
	|	И (&НачалоПериода = ДАТАВРЕМЯ(1, 1, 1) ИЛИ УПД.Дата >= &НачалоПериода)
	|	И (&КонецПериода = ДАТАВРЕМЯ(1, 1, 1) ИЛИ УПД.Дата <= &КонецПериода)";
	Запрос.УстановитьПараметр("ПоИдентификаторам", ТипЗнч(Идентификаторы) = Тип("Массив"));
	Запрос.УстановитьПараметр("Идентификаторы", ?(ТипЗнч(Идентификаторы) = Тип("Массив"), Идентификаторы, Новый Массив));
	Запрос.УстановитьПараметр("ТолькоПустые", ТолькоПустые = Истина);
	Запрос.УстановитьПараметр("ПоИНН", ТипЗнч(ИННы) = Тип("Массив"));
	Запрос.УстановитьПараметр("ИННы", ?(ТипЗнч(ИННы) = Тип("Массив"), ИННы, Новый Массив));
	Запрос.УстановитьПараметр("НачалоПериода", ?(ЗначениеЗаполнено(ДатаС), НачалоДня(ДатаС), Дата(1, 1, 1)));
	Запрос.УстановитьПараметр("КонецПериода", ?(ЗначениеЗаполнено(ДатаПо), КонецДня(ДатаПо), Дата(1, 1, 1)));

	Кэш = Новый Соответствие;
	Обновлено = 0;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Расчет = РасчетДатыОплатыУПД(Выборка.ИННКонтрагента, Выборка.Организация,
			Выборка.ИННОрганизации, Выборка.Дата, Кэш);
		НоваяДата = ?(Расчет.Найден, Расчет.ДатаПлатежа, Дата(1, 1, 1));

		Если НоваяДата = Выборка.ДатаОплаты Тогда
			Продолжить;
		КонецЕсли;

		НачатьТранзакцию();
		Попытка

			ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра("РегистрСведений.ЭАрМ_УПД_Входящий",
				Выборка.ИдентификаторСБИС);

			МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ИдентификаторСБИС = Выборка.ИдентификаторСБИС;
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.ДатаОплаты = НоваяДата;
				МенеджерЗаписи.Записать(Истина);
				Обновлено = Обновлено + 1;
			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ОтменитьТранзакцию();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(Выборка.ИдентификаторСБИС,
				"ОбновитьДатыОплатыУПД (дата оплаты УПД не записана)", ОшибкаИсключения);
		КонецПопытки;

	КонецЦикла;

	Возврат Обновлено;

КонецФункции

// В очереди и в журнале: Бухгалтерия без даты платежа документ не создаст.
//
Процедура ОтметитьОтсутствиеДоговора(СтрокаУПД)

	Текст = СтрШаблон(НСтр("ru = 'Договор поставщика не найден — срок оплаты не передан: %1, %2, дата УПД %3'"),
		ТекстИлиПусто(СтрокаУПД.ИННКонтрагента),
		ТекстИлиПусто(СтрокаУПД.Организация),
		Формат(СтрокаУПД.Дата, "ДЛФ=D"));

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ВыгрузкаНакладныхДляБух",
		УровеньЖурналаРегистрации.Предупреждение, , , Текст);

	ЗаписатьВОчередь(ТекстИлиПусто(СтрокаУПД.ИдентификаторСБИС), Текст);

КонецПроцедуры

// Подписанные УПД периода, у которых нет действующего договора поставщика.
// СрокОплаты = 0 договором считается: дата платежа равна дате УПД.
//
// Возвращаемое значение:
//   Строка - строки отчёта
//
Функция ТекстУПДБезДоговора(ПериодС = Неопределено, ПериодПо = Неопределено) Экспорт

	Отбор = НовыйОтборУПД();
	Если ЗначениеЗаполнено(ПериодС) Тогда
		Отбор.ПериодС = НачалоДня(ПериодС);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПериодПо) Тогда
		Отбор.ПериодПо = КонецДня(ПериодПо);
	КонецЕсли;

	Кэш = Новый Соответствие;
	Строки = Новый Массив;
	Строки.Добавить(НСтр("ru = 'УПД без договора поставщика'"));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Период: %1 — %2'"),
		Формат(Отбор.ПериодС, "ДЛФ=D"), Формат(Отбор.ПериодПо, "ДЛФ=D")));
	Строки.Добавить("");

	Количество = 0;
	Для Каждого СтрокаУПД Из ДанныеУПД(Отбор) Цикл

		Организация = ТекстИлиПусто(СтрокаУПД.Организация);
		Договор = РасчетДатыОплатыУПД(СтрокаУПД.ИННКонтрагента, Организация,
			СтрокаУПД.ИННОрганизации, СтрокаУПД.Дата, Кэш);
		Если Договор.Найден Тогда
			Продолжить;
		КонецЕсли;

		Количество = Количество + 1;
		Строки.Добавить(СтрШаблон("%1	%2	ИНН %3	%4	УПД № %5",
			Формат(СтрокаУПД.Дата, "ДЛФ=D"),
			ТекстИлиПусто(СтрокаУПД.Контрагент),
			ТекстИлиПусто(СтрокаУПД.ИННКонтрагента),
			Организация,
			ТекстИлиПусто(СтрокаУПД.Номер)));

	КонецЦикла;

	Если Количество = 0 Тогда
		Строки.Добавить(НСтр("ru = 'За период у подписанных УПД договор поставщика есть.'"));
	Иначе
		Строки.Добавить("");
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Всего: %1'"), Количество));
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// УИД и ИНН организации УПД: сначала по ИНН нашей стороны из СБИС (название
// в СБИС и в УТ часто пишут по-разному), затем по точному наименованию.
// УИД - реальный, иначе псевдо-УИД. Организации в УТ нет - ИНН остаётся тот,
// что дал СБИС (иначе Бухгалтерия искала бы организацию только по названию).
//
// Параметры:
//   Наименование - Строка - название организации в УПД
//   ИННСБИС      - Строка - ИНН нашей организации из документа СБИС
//   Кэш          - Соответствие
//
// Возвращаемое значение:
//   Структура - Идентификатор, ИНН (Строка), Ссылка (СправочникСсылка.Организации
//               или Неопределено)
//
Функция РеквизитыОрганизации(Наименование, ИННСБИС, Кэш)

	Пустые = Новый Структура("Идентификатор, ИНН, Ссылка", "", ТекстИлиПусто(ИННСБИС), Неопределено);

	Наименование = ТекстИлиПусто(Наименование);
	ИННСБИС = ТекстИлиПусто(ИННСБИС);
	Если НЕ ЗначениеЗаполнено(Наименование) И НЕ ЗначениеЗаполнено(ИННСБИС) Тогда
		// Без наименования БП3 возьмёт единственную организацию
		Возврат Пустые;
	КонецЕсли;

	КлючКэша = "Организация|" + ВРег(Наименование) + "|" + ВРег(ИННСБИС);
	Закэшировано = Кэш.Получить(КлючКэша);
	Если Закэшировано <> Неопределено Тогда
		Возврат Закэшировано;
	КонецЕсли;

	Результат = Новый Структура("Идентификатор, ИНН, Ссылка",
		ПсевдоУИД(СтрШаблон("Организация|%1", Наименование)), ИННСБИС, Неопределено);

	Попытка

		Выборка = Неопределено;

		Если ЗначениеЗаполнено(ИННСБИС) Тогда
			Запрос = Новый Запрос(
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Организации.Ссылка КАК Ссылка,
				|	Организации.ИНН КАК ИНН
				|ИЗ
				|	Справочник.Организации КАК Организации
				|ГДЕ
				|	Организации.ИНН = &ИНН
				|	И НЕ Организации.ПометкаУдаления
				|
				|УПОРЯДОЧИТЬ ПО
				|	Организации.Наименование");
			Запрос.УстановитьПараметр("ИНН", ИННСБИС);
			Выборка = Запрос.Выполнить().Выбрать();
		КонецЕсли;

		Если (Выборка = Неопределено ИЛИ НЕ Выборка.Следующий()) И ЗначениеЗаполнено(Наименование) Тогда
			Запрос = Новый Запрос(
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Организации.Ссылка КАК Ссылка,
				|	Организации.ИНН КАК ИНН
				|ИЗ
				|	Справочник.Организации КАК Организации
				|ГДЕ
				|	Организации.Наименование = &Наименование
				|
				|УПОРЯДОЧИТЬ ПО
				|	Организации.Наименование");
			Запрос.УстановитьПараметр("Наименование", Наименование);
			Выборка = Запрос.Выполнить().Выбрать();
			Если НЕ Выборка.Следующий() Тогда
				Выборка = Неопределено;
			КонецЕсли;
		КонецЕсли;

		Если Выборка <> Неопределено Тогда
			Результат.Идентификатор = Строка(Выборка.Ссылка.УникальныйИдентификатор());
			Результат.Ссылка = Выборка.Ссылка;
			// ИНН из справочника УТ; пуст - остаётся из СБИС
			Если ЗначениеЗаполнено(ТекстИлиПусто(Выборка.ИНН)) Тогда
				Результат.ИНН = ТекстИлиПусто(Выборка.ИНН);
			КонецЕсли;
		КонецЕсли;

	Исключение
		// Нет справочника или реквизита ИНН - остаётся псевдо-УИД и ИНН из СБИС
	КонецПопытки;

	Кэш.Вставить(КлючКэша, Результат);
	Возврат Результат;

КонецФункции

Функция УникальныйИдентификаторПоЗапросу(ТекстЗапроса, Параметры)

	Попытка

		Запрос = Новый Запрос(ТекстЗапроса);
		Для Каждого Параметр Из Параметры Цикл
			Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Строка(Выборка.Ссылка.УникальныйИдентификатор());
		КонецЕсли;

	Исключение
		// В конфигурации может не быть реквизита (например, ИНН) -
		// тогда уходим на псевдо-УИД
	КонецПопытки;

	Возврат "";

КонецФункции

// Детерминированный UUID из строки: один и тот же контрагент (номенклатура)
// в разных накладных получает один и тот же идентификатор, и свёртка
// КонтрагентУИД|СтавкаНДС в БП3 группирует их верно. UUID вымышленный:
// в БП3 ссылка по нему не находится, значение подбирается по наименованию.
//
Функция ПсевдоУИД(Знач Ключ)

	Ключ = ВРег(СокрЛП(Строка(Ключ)));
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат "";
	КонецЕсли;

	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеширование.Добавить(Ключ);
	Хеш = ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);

	Возврат СтрШаблон("%1-%2-%3-%4-%5",
		Сред(Хеш, 1, 8), Сред(Хеш, 9, 4), Сред(Хеш, 13, 4),
		Сред(Хеш, 17, 4), Сред(Хеш, 21, 12));

КонецФункции

Функция ТекстИлиПусто(Значение)

	Если Значение = Неопределено ИЛИ Значение = NULL Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции
