// Выгрузка подписанных входящих УПД и УКД в JSON для Бухгалтерии.
//
// С 16.10.2026 файл собирает логика обработки ВыгрузкаИзУт, перенесённая в
// расширение (обработка ЭАрМ_ВыгрузкаВБух): цепочки УПД -> УКД, склад и
// комментарий приходной Далиона, договор из приходной, цены с НДС, замечания
// УТ в шапке - решает Бухгалтерия (расширение ОбменED_ОбменСУТ / обработка
// ВыгрузкаБух). Автоотправка - подписанные и не выгруженные за ДнейАвтоотправки.
// Ответ Бухгалтерии ставит в реестре УПД / УКД «Отправлено в Бух»
// (ОтправленоВБух), ДокументБух и ДатаОтветаБух. Каждый шаг - в трассу приёма
// («Бух: …»). Старая сборка Format 1 (СобратьJSON) осталась только для
// ТекстJSONДляБух - из неё читает ЭАрМ_ВыгрузкаВБух.
//
// Когда: после подписи. ЭАрМ_УтверждениеСБИС.ОтметитьПодписанным запускает
// фоновое задание (ЗапуститьВыгрузкуВФоне); регламентное задание
// ЭАрМ_ОбновлениеРеестровЭДО добирает остальные подписанные и не выгруженные
// (фоновое не запустилось, груз раскрылся позже, папка была недоступна). Выгруженный УПД отмечается в реестре (ВыгруженВБух) и второй
// раз сам не уходит; ручная выгрузка за период - ВыгрузитьНакладные.
//
// Что уходит: только УПД, подписанные нами и не закрытые в СБИС
// (аннулированные, удалённые, отозванные - нет). Шапки из РС ЭАрМ_УПД_Входящий,
// строки из РС ЭАрМ_ТоварыЭТрН (только строки УПД). В файл идёт КАЖДАЯ
// товарная позиция - свёртку по ставке НДС делает сторона Бухгалтерии
// (ОбменED_ПриемДанных). Свёртка накладных по контрагенту - тоже на стороне
// Бухгалтерии (ОбменED).
//
// Формат файла:
//   { "выгружатьПриходнаяНакладная": Истина,
//     "ИдентификаторЗапроса", "ПериодС", "ПериодПо", "Количество",
//     "ПриходныеНакладные": [{ "Шапка", "ТабличныеЧасти": { "Товары" } }] }
//
// Папка - настройка ПапкаВыгрузкиБух (она же входящая папка Бухгалтерии,
// константа ОбменED_ПапкаВходящихНакладных на её стороне).
//
// Обратная связь: Бухгалтерия после приёма файла кладёт ответ в подпапку
// Ответы\ той же папки - по каждой накладной, принята ли. Что отправлено
// и что ответила Бухгалтерия, видно в очереди «Ожидает подтверждения ЭДО»
// (поле Бухгалтерия). Ответы читает ПрочитатьОтветыБухгалтерии.

// Запускает выгрузку подписанных УПД фоновым заданием: подпись не ждёт
// записи файла. Уходят все подписанные и не выгруженные, не только
// последний. Задание одно на базу (по ключу): если оно уже идёт, новое не
// запускается - что не успело, доберёт регламентное задание
// ЭАрМ_ОбновлениеРеестровЭДО. Не падает: подпись от выгрузки не зависит.
//
// Параметры:
//   Вручную - Булево - Истина: кнопка «Отправить сейчас», настройка
//             «Автообмен с Бухгалтерией» не проверяется
//
Процедура ЗапуститьВыгрузкуВФоне(Вручную = Ложь) Экспорт

	Если ЭАрМ_НастройкиСервер.ФоновыеЗаданияОтключены() Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПапкаВыгрузкиБух")) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Вручную И НЕ АвтообменСБух() Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Если ВыгрузкаИдетВФоне() Тогда
			Возврат;
		КонецЕсли;

		ФоновыеЗадания.Выполнить("ЭАрМ_ВыгрузкаНакладныхДляБух.ВыгрузитьПодписанныеУПД",
			, КлючФоновойВыгрузки(), НСтр("ru = 'Выгрузка подписанных УПД в БП'"));

	Исключение
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ВыгрузкаНакладныхДляБух",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			СтрШаблон(НСтр("ru = 'Фоновая выгрузка в БП не запущена, УПД уйдут с регламентным заданием: %1'"),
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

// Истина - фоновая выгрузка в Бухгалтерию сейчас выполняется.
//
Функция ВыгрузкаИдетВФоне() Экспорт

	Отбор = Новый Структура("Ключ, Состояние",
		КлючФоновойВыгрузки(), СостояниеФоновогоЗадания.Активно);

	Возврат ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0;

КонецФункции

Функция КлючФоновойВыгрузки()

	Возврат "ЭАрМ_ВыгрузкаНакладныхДляБух";

КонецФункции

// Текст вложенного запроса: идентификаторы УПД, которые заменила более
// поздняя. Поставщик может прислать УПД с тем же номером ещё раз - на
// замену, не аннулируя первую, в том числе в тот же день; нужна последняя.
// Заменённой считается УПД, у которой есть другая УПД того же поставщика
// (ИНН) с тем же номером и форматом, более поздняя и не закрытая в СБИС.
// «Позже» - по времени создания в СБИС (ДатаВремяСБИС); у записей без него
// - по времени получения (ДатаЗагрузки), затем по дате документа.
// Аннулированную цепочка отмечает ЗамененаНа - её вызывающий проверяет сам.
//
// Параметры:
//   УсловиеСтарой - Строка - доп. условие на таблицу «Старая» (например
//                   период); пусто - без условия
//
// Возвращаемое значение:
//   Строка - ВЫБРАТЬ РАЗЛИЧНЫЕ Старая.ИдентификаторСБИС КАК ИдентификаторСБИС ...
//
Функция ТекстЗапросаЗамененныхУПД(УсловиеСтарой = "") Экспорт

	Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Старая.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК Старая
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК Новая
	|		ПО Старая.Номер = Новая.Номер
	|			И Старая.ИННКонтрагента = Новая.ИННКонтрагента
	|			И Старая.Формат = Новая.Формат
	|			И Старая.ИдентификаторСБИС <> Новая.ИдентификаторСБИС
	|			И (#МоментНовой > #МоментСтарой
	|				ИЛИ #МоментНовой = #МоментСтарой
	|					И Новая.Дата > Старая.Дата
	|				ИЛИ #МоментНовой = #МоментСтарой
	|					И Новая.Дата = Старая.Дата
	|					И Новая.ИдентификаторСБИС > Старая.ИдентификаторСБИС)
	|ГДЕ
	|	Старая.Номер <> """"
	|	И (#НоваяНеЗакрыта)
	|	И (#УсловиеСтарой)";

	// Момент УПД: время создания в СБИС, у старых записей без него - время
	// получения. Сравнивать моменты надёжнее, чем одну ДатаЗагрузки: две УПД,
	// полученные одним обновлением реестра, загружены в одну секунду
	Момент =
	"ВЫБОР
	|				КОГДА #.ДатаВремяСБИС > ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА #.ДатаВремяСБИС
	|				ИНАЧЕ #.ДатаЗагрузки
	|			КОНЕЦ";
	Текст = СтрЗаменить(Текст, "#МоментНовой", СтрЗаменить(Момент, "#", "Новая"));
	Текст = СтрЗаменить(Текст, "#МоментСтарой", СтрЗаменить(Момент, "#", "Старая"));

	Текст = СтрЗаменить(Текст, "#НоваяНеЗакрыта",
		ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("Новая"));
	Текст = СтрЗаменить(Текст, "#УсловиеСтарой",
		?(ЗначениеЗаполнено(УсловиеСтарой), УсловиеСтарой, "ИСТИНА"));

	Возврат Текст;

КонецФункции

// Выгружает подписанные и ещё не выгруженные УПД и УКД в папку Бухгалтерии
// логикой обработки ВыгрузкаИзУт (ЭАрМ_ВыгрузкаВБух) и отмечает их в реестрах.
// Выполняется фоновым заданием после подписи (ЗапуститьВыгрузкуВФоне) и
// регламентным заданием обновления реестров. Уходят подписанные УПД и УКД,
// ещё не выгруженные, и звенья их цепочек, которых Бухгалтерия ещё не
// подтвердила (ОтправленоВБух): БП второй раз не создаёт, но без них УКД не к
// чему привязать.
//
// Параметры:
//   ИдентификаторУПД - Строка - не используется (оставлен для совместимости
//                      вызовов): уходят все ожидающие
//
// Возвращаемое значение:
//   Структура - см. ВыгрузитьНакладные
//
Функция ВыгрузитьПодписанныеУПД(ИдентификаторУПД = "") Экспорт

	ПапкаВыгрузки = ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПапкаВыгрузкиБух");
	Если НЕ ЗначениеЗаполнено(ПапкаВыгрузки) Тогда
		// Обмен с Бухгалтерией не настроен - подпись от этого не страдает
		Возврат НовыйРезультатВыгрузки();
	КонецЕсли;

	Возврат ОтправитьЛогикойВыгрузкиИзУт(ПапкаВыгрузки, Неопределено, Неопределено, Истина);

КонецФункции

// Выгружает подписанные УПД и УКД за период в JSON-файл папки обмена с БП3 -
// ручная выгрузка, в том числе повторная: всё за период, отметку ВыгруженВБух
// не проверяет, но ставит. Бухгалтерия уже созданное второй раз не создаёт.
// Логика и формат файла - обработки ВыгрузкаИзУт (ЭАрМ_ВыгрузкаВБух).
//
// Параметры:
//   ПапкаВыгрузки - Строка - входящая папка БП3; если пусто - настройка ПапкаВыгрузкиБух
//   ПериодС  - Дата - начало периода по дате УПД / УКД; Неопределено - ДнейАвтоотправки назад
//   ПериодПо - Дата - конец периода; Неопределено - сегодня
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, ИмяФайла, ПутьКФайлу, НакладныхВыгружено,
//               СтрокВыгружено, Выгружены (Массив идентификаторов УПД и УКД),
//               КорректировокВыгружено
//
Функция ВыгрузитьНакладные(ПапкаВыгрузки = "", ПериодС = Неопределено, ПериодПо = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(ПапкаВыгрузки) Тогда
		ПапкаВыгрузки = ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПапкаВыгрузкиБух");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПапкаВыгрузки) Тогда
		Результат = НовыйРезультатВыгрузки();
		Результат.Успех = Ложь;
		Результат.Ошибка = НСтр(
			"ru = 'Не задана настройка ПапкаВыгрузкиБух (входящая папка БП3)'");
		Возврат Результат;
	КонецЕсли;

	Возврат ОтправитьЛогикойВыгрузкиИзУт(ПапкаВыгрузки, ПериодС, ПериодПо, Ложь);

КонецФункции

// Настройка «Автообмен с Бухгалтерией» (16.10.2026): Истина - подписанное
// уходит само (после подписи и регламентом) и ответы читаются регламентом;
// Ложь - только вручную. Не прочиталась - Истина (как было до настройки).
//
Функция АвтообменСБух() Экспорт

	Попытка
		Значение = ЭАрМ_НастройкиСервер.ЗначениеНастройки("АвтообменСБух");
	Исключение
		Возврат Истина;
	КонецПопытки;

	Возврат Значение <> Ложь;

КонецФункции

// Сколько дней назад автоотправка ищет неотправленные подписанные УПД и УКД.
// Старше - только вручную (обработка ВыгрузкаИзУт или «Выгрузить повторно»).
//
Функция ДнейАвтоотправки() Экспорт

	Возврат 60;

КонецФункции

// --- Отправка логикой ВыгрузкаИзУт ---

// Читает документы обработкой ЭАрМ_ВыгрузкаВБух (как «Показать» в
// ВыгрузкаИзУт), отбирает и пишет одним файлом (как «Выгрузить в папку»).
// Каждый шаг - в трассу (ЭАрМ_ПриемПакетовДалион.Трасса), ошибки - «ОШИБКА
// ПРОВЕРКИ».
//
// Параметры:
//   ТолькоНовые - Булево - Истина: автоотправка (подписанные и не выгруженные
//                 и неподтверждённые звенья их цепочек); Ложь - всё за период
//
Функция ОтправитьЛогикойВыгрузкиИзУт(Знач ПапкаВыгрузки, Знач ПериодС, Знач ПериодПо, Знач ТолькоНовые)

	Результат = НовыйРезультатВыгрузки();
	Где = ?(ТолькоНовые, "Автоотправка в Бух", "Выгрузка в Бух за период");

	Если ТолькоНовые Тогда
		ПериодС = НачалоОжидающихОтправки();
		Если ПериодС = Неопределено Тогда
			// Неотправленных подписанных нет - ни файл, ни трасса не нужны
			Возврат Результат;
		КонецЕсли;
		ПериодПо = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПериодС) Тогда
		ПериодС = НачалоДня(ТекущаяДатаСеанса()) - ДнейАвтоотправки() * 86400;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПериодПо) Тогда
		ПериодПо = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;

	ТрассаБух("", СтрШаблон(НСтр("ru = '%1: начало, период %2 - %3, папка %4'"),
		Где, Формат(ПериодС, "ДЛФ=D"), Формат(ПериодПо, "ДЛФ=D"), ПапкаВыгрузки));

	Попытка

		Обработка = Обработки.ЭАрМ_ВыгрузкаВБух.Создать();
		Обработка.ПапкаОбмена = СокрЛП(ПапкаВыгрузки);
		// Из УТ уходит всё, проверки - в БП (решение 15.10.2026): без договора
		// тоже, замечания УТ - в шапке файла
		Обработка.ОтправлятьБезДоговора = Истина;
		Обработка.Автоматически = ТолькоНовые;

		Прочитано = Обработка.ПрочитатьДокументы(ПериодС, ПериодПо, Ложь, Ложь);

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		Результат.Успех = Ложь;
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Документы для БП не прочитаны: %1'"),
			КраткоеПредставлениеОшибки(ОшибкаИсключения));
		ОшибкаПроверкиИсключениеБух("", Где + ": чтение (ЭАрМ_ВыгрузкаВБух.ПрочитатьДокументы)", ОшибкаИсключения);
		Возврат Результат;
	КонецПопытки;

	Если НЕ Прочитано.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = Прочитано.Ошибка;
		ОшибкаПроверкиБух("", Где + ": чтение", Прочитано.Ошибка);
		Возврат Результат;
	КонецЕсли;

	Для Каждого Пояснение Из Прочитано.Пояснения Цикл
		ТрассаБух("", Где + ": " + Пояснение);
	КонецЦикла;

	// Цепочки, в которых есть подписанный и ещё не выгруженный документ
	Подтвержденные = Новый Соответствие;
	НовыеЦепочки = Новый Соответствие;
	ВыгруженныеУКДБезОтметки = Новый Массив;
	Если ТолькоНовые Тогда
		Подтвержденные = ПодтвержденныеБухгалтерией(Прочитано.Документы);
		Для Каждого Элемент Из Прочитано.Документы Цикл
			Описание = Элемент.Описание;
			Если Элемент.Данные <> Неопределено И НЕ Описание.Выгружена И Описание.Подписан Тогда
				НовыеЦепочки.Вставить(Описание.КлючЦепочки, Истина);
			КонецЕсли;
			Если Элемент.Вид = "УКД" И Описание.Выгружена Тогда
				ВыгруженныеУКДБезОтметки.Добавить(Элемент.Идентификатор);
			КонецЕсли;
		КонецЦикла;
		// УКД, выгруженные вручную раньше (отметка была только у пользователя /
		// в очереди), - отметка в реестр: иначе автоотправка ищет их каждый раз
		ОтметитьВыгруженнымиУКД(ВыгруженныеУКДБезОтметки);
	КонецЕсли;

	Накладные = Новый Массив;
	Корректировки = Новый Массив;
	Отправленные = Новый Массив;
	НеСобраны = 0;
	ЗвеньевЦепочки = 0;
	Для Каждого Элемент Из Прочитано.Документы Цикл

		Описание = Элемент.Описание;
		Если ТолькоНовые И НовыеЦепочки.Получить(Описание.КлючЦепочки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Не собранная УКД (ошибка при чтении) - данных для файла нет
		Если Элемент.Данные = Неопределено Тогда
			НеСобраны = НеСобраны + 1;
			ОшибкаПроверкиБух(Элемент.Идентификатор, Где, СтрШаблон(
				НСтр("ru = '%1 № %2 не собрана для файла - не отправлена: %3'"),
				Элемент.Вид, Описание.Номер, Описание.Проверка));
			Продолжить;
		КонецЕсли;

		Если ТолькоНовые Тогда
			// Неподписанное автоматически не уходит - только по подписи
			Если НЕ Описание.Подписан Тогда
				Продолжить;
			КонецЕсли;
			// Звено цепочки, которое Бухгалтерия уже подтвердила, второй раз не шлём
			Если Описание.Выгружена
				И Подтвержденные.Получить(ВРег(СокрЛП(Элемент.Идентификатор))) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Описание.Выгружена Тогда
				ЗвеньевЦепочки = ЗвеньевЦепочки + 1;
			КонецЕсли;
		КонецЕсли;

		Если Элемент.Вид = "УКД" Тогда
			Корректировки.Добавить(Элемент.Данные);
		Иначе
			Накладные.Добавить(Элемент.Данные);
		КонецЕсли;
		Отправленные.Добавить(Новый Структура("Идентификатор, Вид, Номер, Дата, Контрагент",
			СокрЛП(Элемент.Идентификатор), Элемент.Вид, Описание.Номер, Описание.Дата, Описание.Контрагент));

		ТрассаБух(Элемент.Идентификатор, СтрШаблон(НСтр("ru = '%1: %2 № %3 от %4 (%5) - в файл%6%7'"),
			Где, Элемент.Вид, Описание.Номер, Формат(Описание.Дата, "ДЛФ=D"), Описание.Контрагент,
			?(Описание.Выгружена, НСтр("ru = ' повторно (звено цепочки, БП ещё не подтвердила)'"), ""),
			?(ЗначениеЗаполнено(Описание.Проверка) И (Описание.Ошибка ИЛИ Описание.Внимание),
				НСтр("ru = '; замечания УТ (решит БП): '") + Описание.Проверка, "")));

	КонецЦикла;

	Если Накладные.Количество() + Корректировки.Количество() = 0 Тогда
		ТрассаБух("", СтрШаблон(НСтр("ru = '%1: отправлять нечего (прочитано документов %2, не собрано %3)'"),
			Где, Прочитано.Документы.Количество(), НеСобраны));
		Возврат Результат;
	КонецЕсли;

	Попытка
		Итог = Обработка.ВыгрузитьВПапку(ПапкаВыгрузки, Накладные, Корректировки, ПериодС, ПериодПо);
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		Результат.Успех = Ложь;
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Файл для БП не записан: %1'"),
			КраткоеПредставлениеОшибки(ОшибкаИсключения));
		ОшибкаПроверкиИсключениеБух("", Где + ": запись файла (ЭАрМ_ВыгрузкаВБух.ВыгрузитьВПапку)", ОшибкаИсключения);
		Возврат Результат;
	КонецПопытки;

	Если НЕ Итог.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = Итог.Ошибка;
		ОшибкаПроверкиБух("", Где + ": запись файла", Итог.Ошибка);
		Возврат Результат;
	КонецЕсли;

	Результат.ИмяФайла = Итог.ИмяФайла;
	Результат.ПутьКФайлу = Итог.ПутьКФайлу;
	Результат.НакладныхВыгружено = Итог.Накладных;
	Результат.КорректировокВыгружено = Итог.Корректировок;
	Результат.СтрокВыгружено = Итог.Строк;
	Результат.Выгружены = Итог.Выгружены;

	Если Итог.Свойство("ЗамечанияУКД") И ТипЗнч(Итог.ЗамечанияУКД) = Тип("Массив") Тогда
		Для Каждого Замечание Из Итог.ЗамечанияУКД Цикл
			ТрассаБух("", Где + НСтр("ru = ': сверка УКД с файлом СБИС - '") + Строка(Замечание), Ложь);
		КонецЦикла;
	КонецЕсли;

	Для Каждого Идентификатор Из Итог.Выгружены Цикл
		ТрассаБух(Идентификатор, СтрШаблон(НСтр("ru = '%1: отправлено файлом %2, ждём ответ БП'"),
			Где, Итог.ИмяФайла));
	КонецЦикла;

	// Журнал пакетов (форма «Пакеты в Бухгалтерию»): ответ допишет, что создано
	ЗаписатьПакетБух(Итог.ИмяФайла, Отправленные, ТолькоНовые);

	ТрассаБух("", СтрШаблон(НСтр("ru = '%1: файл %2 - УПД %3, УКД %4, строк %5 (звеньев цепочек повторно %6, не собрано %7)'"),
		Где, Итог.ПутьКФайлу, Итог.Накладных, Итог.Корректировок, Итог.Строк, ЗвеньевЦепочки, НеСобраны));

	Возврат Результат;

КонецФункции

// Дата самого раннего подписанного, не закрытого в СБИС и ещё не выгруженного
// УПД или УКД (УКД - привязанной к УПД) не старше ДнейАвтоотправки.
//
// Возвращаемое значение:
//   Дата - начало дня; Неопределено - ждущих отправки нет
//
Функция НачалоОжидающихОтправки()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МИНИМУМ(УПД.Дата) КАК Дата
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.Дата >= &Граница
	|	И НЕ УПД.ВыгруженВБух
	|	И УПД.ЗамененаНа = """"
	|	И (УПД.Подписано
	|		ИЛИ УПД.СтатусПодписания = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан))
	|	И &УсловиеНеЗакрытУПД
	|	И НЕ УПД.Формат В (&НеУПД)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	МИНИМУМ(УКД.Дата)
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.Дата >= &Граница
	|	И НЕ УКД.ВыгруженВБух
	|	И УКД.ИдентификаторОснования <> """"
	|	И (УКД.Подписано
	|		ИЛИ УКД.СтатусПодписания = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан))
	|	И &УсловиеНеЗакрытУКД";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНеЗакрытУПД", "(" +
		ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УПД") + ")");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНеЗакрытУКД", "(" +
		ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УКД") + ")");

	НеУПД = Новый Массив;
	НеУПД.Добавить(ЭАрМ_КорректировкиУПД.ФорматКорректировки());
	НеУПД.Добавить("УКД");
	НеУПД.Добавить("ЭТрН");
	НеУПД.Добавить("ЭПЛ");
	Запрос.УстановитьПараметр("НеУПД", НеУПД);
	Запрос.УстановитьПараметр("Граница", НачалоДня(ТекущаяДатаСеанса()) - ДнейАвтоотправки() * 86400);

	Начало = Неопределено;
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Дата) И (Начало = Неопределено ИЛИ Выборка.Дата < Начало) Тогда
				Начало = Выборка.Дата;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ОшибкаПроверкиИсключениеБух("", "Автоотправка в Бух: поиск неотправленных", ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

	Возврат ?(Начало = Неопределено, Неопределено, НачалоДня(Начало));

КонецФункции

// Документы чтения, по которым Бухгалтерия уже ответила «документ есть»
// (ОтправленоВБух в реестре УПД / УКД).
//
// Возвращаемое значение:
//   Соответствие - ВРег(идентификатор СБИС): Истина
//
Функция ПодтвержденныеБухгалтерией(Документы)

	Результат = Новый Соответствие;

	Идентификаторы = Новый Массив;
	Для Каждого Элемент Из Документы Цикл
		Если ЗначениеЗаполнено(Элемент.Идентификатор) Тогда
			Идентификаторы.Добавить(СокрЛП(Элемент.Идентификатор));
		КонецЕсли;
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.ИдентификаторСБИС В (&Идентификаторы)
	|	И УПД.ОтправленоВБух
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УКД.ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.ИдентификаторСБИС В (&Идентификаторы)
	|	И УКД.ОтправленоВБух";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(ВРег(СокрЛП(Выборка.ИдентификаторСБИС)), Истина);
		КонецЦикла;
	Исключение
		// Не прочиталось - звенья уйдут ещё раз: БП второй раз не создаст
		ОшибкаПроверкиИсключениеБух("", "Автоотправка в Бух: подтверждённые Бухгалтерией", ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Отметка ВыгруженВБух в реестре УКД (поле с 16.10.2026) - для УКД, которые
// обработка считает выгруженными, а в реестре отметки нет.
//
Процедура ОтметитьВыгруженнымиУКД(Идентификаторы)

	Для Каждого Идентификатор Из Идентификаторы Цикл

		Записано = Ложь;
		НачатьТранзакцию();
		Попытка

			ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра(
				"РегистрСведений.ЭАрМ_УКД_Входящий", Идентификатор);

			МенеджерЗаписи = РегистрыСведений.ЭАрМ_УКД_Входящий.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
			МенеджерЗаписи.Прочитать();

			Если МенеджерЗаписи.Выбран() И НЕ МенеджерЗаписи.ВыгруженВБух Тогда
				МенеджерЗаписи.ВыгруженВБух = Истина;
				МенеджерЗаписи.Записать(Истина);
				Записано = Истина;
			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ОтменитьТранзакцию();
			ОшибкаПроверкиИсключениеБух(Идентификатор, "Отметка ВыгруженВБух в реестре УКД", ОшибкаИсключения);
			Продолжить;
		КонецПопытки;

		Если Записано Тогда
			ТрассаБух(Идентификатор, НСтр("ru = 'УКД выгружалась раньше (отметка у пользователя / в очереди) - ВыгруженВБух в реестр УКД'"));
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// --- Ответ Бухгалтерии в реестр ---

// Ответ Бухгалтерии - в реестр УПД или УКД: ОтправленоВБух (документ в
// Бухгалтерии есть: создан сейчас или был раньше), ДокументБух (что создано
// или почему нет), ДатаОтветаБух, ПроведенВБух (16.10.2026: ответ расширения
// БП несёт ПроведенВБух). Ответ «не создан» снимает ОтправленоВБух.
// После записи - проверка чтением (ПроверитьЗаписьРегистра).
//
Процедура ОтметитьОтветВРеестре(Идентификатор, Накладная, ДатаОтвета, ИмяФайлаОтвета, ФайлПакета = "")

	Где = "Ответ Бухгалтерии в реестр";
	Статус = ТекстИлиПусто(ЗначениеПоля(Накладная, "Статус"));
	ЕстьВБух = ДокументЕстьВБухгалтерии(Накладная, Статус);
	ПроведенВБух = ЕстьВБух И ЗначениеПоля(Накладная, "ПроведенВБух") = Истина;
	ТекстДокумента = ТекстИлиПусто(ЗначениеПоля(Накладная, "Документ"));
	Если НЕ ЗначениеЗаполнено(ТекстДокумента) Тогда
		ТекстДокумента = Статус;
	КонецЕсли;
	ТекстДокумента = Лев(ТекстДокумента, 300);

	// Журнал пакетов - и когда документа в реестрах нет
	ОтметитьОтветВПакете(Идентификатор, Накладная, ДатаОтвета, ИмяФайлаОтвета, ФайлПакета, ЕстьВБух, ТекстДокумента);

	ИмяРегистра = "";
	ИменаРегистров = Новый Массив;
	// Сначала УКД: старые УКД бывают и в реестре УПД (до переноса), УПД в реестре УКД нет
	ИменаРегистров.Добавить("ЭАрМ_УКД_Входящий");
	ИменаРегистров.Добавить("ЭАрМ_УПД_Входящий");

	Для Каждого Имя Из ИменаРегистров Цикл

		НачатьТранзакцию();
		Попытка

			ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра("РегистрСведений." + Имя, Идентификатор);

			МенеджерЗаписи = РегистрыСведений[Имя].СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
			МенеджерЗаписи.Прочитать();

			Если МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.ОтправленоВБух = ЕстьВБух;
				МенеджерЗаписи.ДокументБух = ТекстДокумента;
				МенеджерЗаписи.ДатаОтветаБух = ДатаОтвета;
				МенеджерЗаписи.ПроведенВБух = ПроведенВБух;
				// Ответ пришёл - файл точно был: отметка выгрузки, если её не было
				МенеджерЗаписи.ВыгруженВБух = Истина;
				МенеджерЗаписи.Записать(Истина);
				ИмяРегистра = Имя;
			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ОтменитьТранзакцию();
			ОшибкаПроверкиИсключениеБух(Идентификатор, Где + " " + Имя, ОшибкаИсключения);
			Возврат;
		КонецПопытки;

		Если ЗначениеЗаполнено(ИмяРегистра) Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(ИмяРегистра) Тогда
		ОшибкаПроверкиБух(Идентификатор, Где, СтрШаблон(
			НСтр("ru = 'документа нет ни в реестре УПД, ни в реестре УКД - «Отправлено в БП» не поставлено (ответ %1: %2)'"),
			ИмяФайлаОтвета, Статус));
		Возврат;
	КонецЕсли;

	ТрассаБух(Идентификатор, СтрШаблон(НСтр("ru = 'ответ %1 (%2): %3 - в %4: Отправлено в БП = %5, Проведён в БП = %6'"),
		ИмяФайлаОтвета, Формат(ДатаОтвета, "ДФ='dd.MM.yyyy HH:mm'"), Статус, ИмяРегистра,
		?(ЕстьВБух, НСтр("ru = 'да'"), НСтр("ru = 'нет'")),
		?(ПроведенВБух, НСтр("ru = 'да'"), НСтр("ru = 'нет'"))), ЕстьВБух);

	Попытка
		ЭАрМ_ПриемПакетовДалион.ПроверитьЗаписьРегистра(Идентификатор, ИмяРегистра,
			Новый Структура("ИдентификаторСБИС", Идентификатор),
			Новый Структура("ОтправленоВБух, ДокументБух, ДатаОтветаБух, ПроведенВБух", ЕстьВБух, ТекстДокумента, ДатаОтвета, ПроведенВБух));
	Исключение
		ОшибкаПроверкиИсключениеБух(Идентификатор, Где + ": проверка записи", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Есть ли документ в Бухгалтерии по ответу. Ответ расширения Бухгалтерии
// (ОбменED_ОбменСУТ) несёт СозданВБух; старый ответ - по статусу: «Принята,
// создан …», «УКД принята, создана …», «Уже получена…» - есть; «Не принята»,
// «не создан», «ждёт» - нет.
//
Функция ДокументЕстьВБухгалтерии(Накладная, Статус)

	СозданВБух = ЗначениеПоля(Накладная, "СозданВБух");
	Если ТипЗнч(СозданВБух) = Тип("Булево") Тогда
		Возврат СозданВБух;
	КонецЕсли;

	Если ЗначениеПоля(Накладная, "Принята") <> Истина И НЕ СтатусБухгалтерииПринят(Статус) Тогда
		Возврат Ложь;
	КонецЕсли;

	Текст = НРег(Статус);
	Возврат СтрНайти(Текст, "не создан") = 0
		И СтрНайти(Текст, "ждёт") = 0
		И СтрНайти(Текст, "ждет") = 0;

КонецФункции

// Файл пакета, на который отвечает Бухгалтерия: у строки ответа расширения БП -
// ФайлПакета, у ответа обработки ВыгрузкаБух - Файл в корне ответа.
//
Функция ФайлПакетаОтвета(Ответ, Накладная)

	ФайлПакета = ТекстИлиПусто(ЗначениеПоля(Накладная, "ФайлПакета"));
	Если ЗначениеЗаполнено(ФайлПакета) Тогда
		Возврат ФайлПакета;
	КонецЕсли;

	ФайлПакета = ТекстИлиПусто(ЗначениеПоля(Ответ, "Файл"));
	Если СтрНачинаетсяС(ВРег(ФайлПакета), ВРег("ПриходныеНакладные")) Тогда
		Возврат ФайлПакета;
	КонецЕсли;

	Возврат "";

КонецФункции

// Когда Бухгалтерия ответила (ДатаПриема ответа); не прочиталось - время файла.
//
Функция ДатаОтветаБухгалтерии(Ответ, Файл)

	ЗначениеДаты = ЗначениеПоля(Ответ, "ДатаПриема");
	Если ТипЗнч(ЗначениеДаты) = Тип("Дата") И ЗначениеЗаполнено(ЗначениеДаты) Тогда
		Возврат ЗначениеДаты;
	КонецЕсли;

	Если ТипЗнч(ЗначениеДаты) = Тип("Строка") И ЗначениеЗаполнено(ЗначениеДаты) Тогда
		Попытка
			Возврат XMLЗначение(Тип("Дата"), ЗначениеДаты);
		Исключение
			ТрассаБух("", СтрШаблон(НСтр("ru = 'ответ %1: дата приёма «%2» не разобрана - берётся время файла'"),
				Файл.Имя, ЗначениеДаты), Ложь);
		КонецПопытки;
	КонецЕсли;

	Возврат Файл.ПолучитьВремяИзменения();

КонецФункции

// --- Журнал пакетов в Бухгалтерию (ЭАрМ_ПакетыБух) ---

// Отправленный пакет - в журнал: строка на каждый документ файла. Ответ
// Бухгалтерии дописывает в те же строки, что принято и что создано
// (ОтметитьОтветВПакете).
//
// Параметры:
//   ИмяФайла     - Строка - файл ПриходныеНакладные_*.json
//   Отправленные - Массив структур: Идентификатор, Вид, Номер, Дата, Контрагент
//   Автоматически - Булево
//
Процедура ЗаписатьПакетБух(ИмяФайла, Отправленные, Автоматически)

	МоментОтправки = ТекущаяДатаСеанса();
	Записано = 0;

	Для Каждого Документ Из Отправленные Цикл
		Попытка
			Запись = РегистрыСведений.ЭАрМ_ПакетыБух.СоздатьМенеджерЗаписи();
			Запись.Файл = Лев(ИмяФайла, 200);
			Запись.Идентификатор = Лев(Документ.Идентификатор, 100);
			Запись.Вид = Документ.Вид;
			Запись.Номер = Лев(Документ.Номер, 50);
			Запись.ДатаДокумента = Документ.Дата;
			Запись.Контрагент = Лев(Документ.Контрагент, 150);
			Запись.ДатаОтправки = МоментОтправки;
			Запись.Отправка = ?(Автоматически, НСтр("ru = 'автоматически'"), НСтр("ru = 'вручную'"));
			Запись.Статус = НСтр("ru = 'Отправлен, ответа БП нет'");
			Запись.Записать(Истина);
			Записано = Записано + 1;
		Исключение
			ОшибкаПроверкиИсключениеБух(Документ.Идентификатор, "Журнал пакетов ЭАрМ_ПакетыБух: запись отправки", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;

	Попытка
		ЭАрМ_ПриемПакетовДалион.ПроверитьЗаписьРегистра("", "ЭАрМ_ПакетыБух",
			Новый Структура("Файл", Лев(ИмяФайла, 200)), , Записано);
	Исключение
		ОшибкаПроверкиИсключениеБух("", "Журнал пакетов ЭАрМ_ПакетыБух: проверка записи", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Ответ Бухгалтерии по документу - в журнал пакетов. Строка ищется по файлу
// пакета (ответ его называет) и идентификатору; файла нет - последняя отправка
// документа; не отправлялся из расширения (вручную обработкой) - новая строка.
//
Процедура ОтметитьОтветВПакете(Идентификатор, Накладная, ДатаОтвета, ИмяФайлаОтвета, ФайлПакета, ЕстьВБух, ТекстДокумента)

	Где = "Журнал пакетов ЭАрМ_ПакетыБух: ответ";
	Статус = ТекстИлиПусто(ЗначениеПоля(Накладная, "Статус"));
	Принята = ЗначениеПоля(Накладная, "Принята") = Истина ИЛИ СтатусБухгалтерииПринят(Статус);

	Попытка

		Файл = "";
		Если ЗначениеЗаполнено(ФайлПакета) Тогда
			Запись = РегистрыСведений.ЭАрМ_ПакетыБух.СоздатьМенеджерЗаписи();
			Запись.Файл = Лев(ФайлПакета, 200);
			Запись.Идентификатор = Лев(Идентификатор, 100);
			Запись.Прочитать();
			Если Запись.Выбран() Тогда
				Файл = Запись.Файл;
			КонецЕсли;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Файл) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Пакеты.Файл КАК Файл
			|ИЗ
			|	РегистрСведений.ЭАрМ_ПакетыБух КАК Пакеты
			|ГДЕ
			|	Пакеты.Идентификатор = &Идентификатор
			|
			|УПОРЯДОЧИТЬ ПО
			|	Пакеты.ДатаОтправки УБЫВ";
			Запрос.УстановитьПараметр("Идентификатор", Лев(Идентификатор, 100));
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Файл = Выборка.Файл;
			КонецЕсли;
		КонецЕсли;

		Запись = РегистрыСведений.ЭАрМ_ПакетыБух.СоздатьМенеджерЗаписи();
		Если ЗначениеЗаполнено(Файл) Тогда
			Запись.Файл = Файл;
			Запись.Идентификатор = Лев(Идентификатор, 100);
			Запись.Прочитать();
		КонецЕсли;
		Если НЕ Запись.Выбран() Тогда
			// Отправка не из расширения (обработкой ВыгрузкаИзУт) - строка по ответу
			Запись.Файл = Лев(?(ЗначениеЗаполнено(ФайлПакета), ФайлПакета, ИмяФайлаОтвета), 200);
			Запись.Идентификатор = Лев(Идентификатор, 100);
			Запись.Номер = Лев(ТекстИлиПусто(ЗначениеПоля(Накладная, "Номер")), 50);
			Запись.Отправка = НСтр("ru = 'нет в журнале'");
		КонецЕсли;

		Запись.ОтветПолучен = Истина;
		Запись.Принята = Принята;
		Запись.ОтправленоВБух = ЕстьВБух;
		Запись.ДатаОтвета = ДатаОтвета;
		Запись.ДокументБух = Лев(ТекстДокумента, 300);
		Запись.Статус = Лев(Статус, 500);
		Запись.ФайлОтвета = Лев(ИмяФайлаОтвета, 200);
		Запись.Записать(Истина);

	Исключение
		ОшибкаПроверкиИсключениеБух(Идентификатор, Где, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Попытка
		ЭАрМ_ПриемПакетовДалион.ПроверитьЗаписьРегистра(Идентификатор, "ЭАрМ_ПакетыБух",
			Новый Структура("Файл, Идентификатор", Запись.Файл, Запись.Идентификатор),
			Новый Структура("ОтветПолучен, Принята, ОтправленоВБух", Истина, Принята, ЕстьВБух));
	Исключение
		ОшибкаПроверкиИсключениеБух(Идентификатор, Где + ": проверка записи", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// --- Статусы от Монитора папок и сверка «что есть в Бух» ---

// Строка статуса от Монитора (файл ut_Статусы_*.json) - в реестры УКД / УПД.
//
// Реестр ищется как в ОтметитьОтветВРеестре: сначала УКД, потом УПД.
//   «Загружено в Бух»  - ОтправленоВБух = Истина, ДокументБух (или Текст), ДатаОтветаБух = Дата,
//                        ВыгруженВБух; журнал пакетов ЭАрМ_ПакетыБух как при ответе БП;
//   «Не создано в Бух» - ОтправленоВБух = Ложь, ДокументБух = Текст, ДатаОтветаБух = Дата
//                        (не затирает более свежую отметку «в Бух есть»);
//   «В обработке» и «Ответа Бух нет …» - только ДокументБух («В обработке (порция N)» /
//                        текст состояния); ОтправленоВБух и ДатаОтветаБух не трогаются,
//                        уже отмеченное «в Бух есть» не меняется.
// В очередь подтверждений (поле «Бухгалтерия») идёт тот же текст, что и при ответе БП.
//
// Параметры:
//   Элемент        - Структура - строка items файла статусов
//   ДатаСтатуса    - Дата - местное время статуса
//   ИмяФайла       - Строка - файл статусов (в журнал пакетов как «файл ответа»)
//
// Возвращаемое значение:
//   Структура: Применено (Булево), Пояснение (Строка - почему не применено)
//
Функция ПрименитьСтатусМонитора(Элемент, ДатаСтатуса, ИмяФайла) Экспорт

	Результат = Новый Структура("Применено, Пояснение", Ложь, "");

	Идентификатор = СокрЛП(ТекстИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "Идентификатор")));
	Состояние = СокрЛП(ТекстИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "Состояние")));
	ТекстСтатуса = ТекстИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "Текст"));
	ТекстДокумента = ТекстИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "ДокументБух"));
	Порция = ЭАрМ_Служебный.ЗначениеУзла(Элемент, "Порция");
	ФайлПакета = ТекстИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "ФайлПакета"));

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Результат.Пояснение = НСтр("ru = 'в строке нет идентификатора'");
		Возврат Результат;
	КонецЕсли;

	// 1 - загружено, 2 - не создано, 3 - ещё в работе
	Если Состояние = "Загружено в Бух" Тогда
		Вид = 1;
		ТекстДляРеестра = ?(ЗначениеЗаполнено(ТекстДокумента), ТекстДокумента, ТекстСтатуса);
	ИначеЕсли Состояние = "Не создано в Бух" Тогда
		Вид = 2;
		ТекстДляРеестра = ?(ЗначениеЗаполнено(ТекстСтатуса), ТекстСтатуса, ТекстДокумента);
	ИначеЕсли Состояние = "В обработке" Тогда
		Вид = 3;
		ТекстДляРеестра = ?(ТипЗнч(Порция) = Тип("Число"),
			СтрШаблон(НСтр("ru = 'В обработке (порция %1)'"), Формат(Порция, "ЧГ=0")), Состояние);
	ИначеЕсли СтрНачинаетсяС(Состояние, "Ответа Бух нет") Тогда
		Вид = 3;
		ТекстДляРеестра = Состояние;
	Иначе
		Результат.Пояснение = СтрШаблон(НСтр("ru = 'неизвестное состояние «%1»'"), Состояние);
		Возврат Результат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекстДляРеестра) Тогда
		ТекстДляРеестра = Состояние;
	КонецЕсли;
	ТекстДляРеестра = Лев(ТекстДляРеестра, 300);

	ИмяРегистра = "";
	Изменено = Ложь;

	Для Каждого Имя Из СтрРазделить("ЭАрМ_УКД_Входящий,ЭАрМ_УПД_Входящий", ",") Цикл

		НачатьТранзакцию();
		Попытка

			ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра("РегистрСведений." + Имя, Идентификатор);

			МенеджерЗаписи = РегистрыСведений[Имя].СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
			МенеджерЗаписи.Прочитать();

			Если МенеджерЗаписи.Выбран() Тогда
				ИмяРегистра = Имя;
				Изменено = ПрименитьСостояниеКСтроке(МенеджерЗаписи, Вид, ТекстДляРеестра, ДатаСтатуса);
				Если Изменено Тогда
					МенеджерЗаписи.Записать(Истина);
				КонецЕсли;
			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;

		Если ЗначениеЗаполнено(ИмяРегистра) Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(ИмяРегистра) Тогда
		Результат.Пояснение = НСтр("ru = 'документа нет ни в реестре УПД, ни в реестре УКД'");
		Возврат Результат;
	КонецЕсли;

	Если НЕ Изменено Тогда
		Результат.Пояснение = НСтр("ru = 'в реестре уже более свежая отметка'");
		Возврат Результат;
	КонецЕсли;

	// Очередь подтверждений и журнал пакетов - тем же текстом, что при ответе БП
	МоментТекст = Формат(ДатаСтатуса, "ДФ='dd.MM.yyyy HH:mm'");
	Накладная = Новый Структура("Статус, Принята, Номер", ТекстДляРеестра, Вид = 1, "");

	Если Вид = 3 Тогда
		ТекстОчереди = ТекстДляРеестра;
	Иначе
		ТекстОчереди = ТекстОтветаБухгалтерии(Накладная, МоментТекст);
		ОтметитьОтветВПакете(Идентификатор, Накладная, ДатаСтатуса, ИмяФайла, ФайлПакета, Вид = 1, ТекстДляРеестра);
	КонецЕсли;
	ЗаписатьВОчередь(Идентификатор, ТекстОчереди);

	ТрассаБух(Идентификатор, СтрШаблон(НСтр("ru = 'статус монитора «%1» (%2): %3 - в %4'"),
		Состояние, МоментТекст, ТекстДляРеестра, ИмяРегистра), Вид <> 2);

	ОжидаемыеПоля = Новый Структура("ДокументБух", ТекстДляРеестра);
	Если Вид = 1 Тогда
		ОжидаемыеПоля.Вставить("ОтправленоВБух", Истина);
	ИначеЕсли Вид = 2 Тогда
		ОжидаемыеПоля.Вставить("ОтправленоВБух", Ложь);
	КонецЕсли;
	ЭАрМ_ПриемПакетовДалион.ПроверитьЗаписьРегистра(Идентификатор, ИмяРегистра,
		Новый Структура("ИдентификаторСБИС", Идентификатор), ОжидаемыеПоля);

	Результат.Применено = Истина;

	Возврат Результат;

КонецФункции

// Состояние от Монитора - в прочитанную строку реестра. Возвращает Истина, если
// строку надо записать (есть что менять и данные не устарели).
//
Функция ПрименитьСостояниеКСтроке(МенеджерЗаписи, Вид, ТекстДляРеестра, ДатаСтатуса)

	Если Вид = 1 Тогда
		МенеджерЗаписи.ОтправленоВБух = Истина;
		МенеджерЗаписи.ДокументБух = ТекстДляРеестра;
		МенеджерЗаписи.ДатаОтветаБух = ДатаСтатуса;
		// Ответ пришёл - файл точно был: отметка выгрузки, если её не было
		МенеджерЗаписи.ВыгруженВБух = Истина;
		Возврат Истина;
	КонецЕсли;

	Если Вид = 2 Тогда
		// «Нет» старше уже стоящей отметки «в Бух есть» (сверка по файлу БП) не затирает её
		Если МенеджерЗаписи.ОтправленоВБух И ЗначениеЗаполнено(МенеджерЗаписи.ДатаОтветаБух)
			И МенеджерЗаписи.ДатаОтветаБух >= ДатаСтатуса Тогда
			Возврат Ложь;
		КонецЕсли;
		МенеджерЗаписи.ОтправленоВБух = Ложь;
		МенеджерЗаписи.ДокументБух = ТекстДляРеестра;
		МенеджерЗаписи.ДатаОтветаБух = ДатаСтатуса;
		Возврат Истина;
	КонецЕсли;

	// Ещё в работе: уже отмеченное «в Бух есть» не меняется, тот же текст не переписывается
	Если МенеджерЗаписи.ОтправленоВБух ИЛИ МенеджерЗаписи.ДокументБух = ТекстДляРеестра Тогда
		Возврат Ложь;
	КонецЕсли;
	МенеджерЗаписи.ДокументБух = ТекстДляРеестра;

	Возврат Истина;

КонецФункции

// Сверка «что есть в Бух» по результату ЭАрМ_ВыгрузкаВБух.СопоставитьПоступленияБП
// (файл ПоступленияБП_*_авто.json):
//   - УПД и УКД с парой в БП: ОтправленоВБух = Истина, ДокументБух = представление
//     пары, ПроведенВБух, ДатаОтветаБух - только у тех, у кого ОтправленоВБух ещё Ложь;
//   - подписанная УПД, выгруженная в БП больше суток назад (и до формирования файла),
//     без пары в БП при контрагенте в охвате файла: ДокументБух = «Нет в Бух - отправить снова»
//     (если там нет ответа БП);
//   - возвраты БП (ВозвратыБП файла): у УПД поставщика - ВозвратВБух (номер, дата, сумма).
//
// Параметры:
//   Сверка - Структура - результат СопоставитьПоступленияБП (с полем Возвраты)
//
// Возвращаемое значение:
//   Структура: УПД, УКД (новых отметок), СопоставленоУПД, СопоставленоУКД, НетВБух,
//              Возвратов, ОтмеченоВозвратов, Ошибки (Массив из Строка)
//
Функция ОтметитьСверкуСБух(Сверка) Экспорт

	Итог = Новый Структура("УПД, УКД, СопоставленоУПД, СопоставленоУКД, НетВБух, Возвратов, ОтмеченоВозвратов, Ошибки",
		0, 0, Сверка.УПДвБП.Количество(), Сверка.УКДвБП.Количество(), 0, 0, 0, Новый Массив);

	Сейчас = ТекущаяДатаСеанса();

	Итог.УПД = ОтметитьПарыСверкиСБух("ЭАрМ_УПД_Входящий", Сверка.УПДвБП, Сейчас, Итог.Ошибки);
	Итог.УКД = ОтметитьПарыСверкиСБух("ЭАрМ_УКД_Входящий", Сверка.УКДвБП, Сейчас, Итог.Ошибки);
	Итог.НетВБух = ОтметитьНетВБух(Сверка, Сейчас, Итог.Ошибки);

	Возвраты = Неопределено;
	Если Сверка.Свойство("Возвраты", Возвраты) И ТипЗнч(Возвраты) = Тип("Массив") Тогда
		Итог.Возвратов = Возвраты.Количество();
		Итог.ОтмеченоВозвратов = ОтметитьВозвратыВБух(Сверка, Возвраты, Итог.Ошибки);
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Пары «документ УТ - документ БП» -> реестр. Пишет только строки, у которых
// «Отправлено в БП» ещё не стоит.
//
Функция ОтметитьПарыСверкиСБух(ИмяРегистра, Пары, Сейчас, Ошибки)

	Отмечено = 0;
	Если Пары.Количество() = 0 Тогда
		Возврат Отмечено;
	КонецЕсли;

	Идентификаторы = Новый Массив;
	Для Каждого КлючИЗначение Из Пары Цикл
		Идентификаторы.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	Для Начало = 0 По Цел((Идентификаторы.Количество() - 1) / 500) Цикл

		Часть = Новый Массив;
		Для Номер = Начало * 500 По Мин(Начало * 500 + 499, Идентификаторы.Количество() - 1) Цикл
			Часть.Добавить(Идентификаторы[Номер]);
		КонецЦикла;

		Запрос = Новый Запрос;
		Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		|	Реестр.ИдентификаторСБИС КАК ИдентификаторСБИС
		|ИЗ
		|	РегистрСведений.%1 КАК Реестр
		|ГДЕ
		|	Реестр.ИдентификаторСБИС В (&Идентификаторы)
		|	И НЕ Реестр.ОтправленоВБух", ИмяРегистра);
		Запрос.УстановитьПараметр("Идентификаторы", Часть);

		//@skip-check query-in-loop
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл

			Пара = Пары.Получить(ВРег(СокрЛП(Выборка.ИдентификаторСБИС)));
			Если Пара = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			НачатьТранзакцию();
			Попытка

				ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра("РегистрСведений." + ИмяРегистра,
					Выборка.ИдентификаторСБИС);

				МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
				МенеджерЗаписи.ИдентификаторСБИС = Выборка.ИдентификаторСБИС;
				МенеджерЗаписи.Прочитать();

				// Пока читали, отметку мог поставить ответ БП: не затираем
				Если МенеджерЗаписи.Выбран() И НЕ МенеджерЗаписи.ОтправленоВБух Тогда
					МенеджерЗаписи.ОтправленоВБух = Истина;
					МенеджерЗаписи.ДокументБух = Лев(ТекстИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Пара, "Представление")), 300);
					МенеджерЗаписи.ПроведенВБух = ЭАрМ_Служебный.ЗначениеУзла(Пара, "Проведен", Ложь) = Истина;
					МенеджерЗаписи.ДатаОтветаБух = Сейчас;
					МенеджерЗаписи.Записать(Истина);
					Отмечено = Отмечено + 1;
				КонецЕсли;

				ЗафиксироватьТранзакцию();

			Исключение
				ОтменитьТранзакцию();
				Ошибки.Добавить(СтрШаблон("%1 %2: %3", ИмяРегистра, Выборка.ИдентификаторСБИС,
					ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
			КонецПопытки;

		КонецЦикла;

	КонецЦикла;

	Возврат Отмечено;

КонецФункции

Функция ТекстНетВБух()

	Возврат НСтр("ru = 'Нет в Бух — отправить снова'");

КонецФункции

// Подписанные УПД, выгруженные в БП давно, а поступления в файле БП нет.
//
Функция ОтметитьНетВБух(Сверка, Сейчас, Ошибки)

	Отмечено = 0;
	ТекстНет = ТекстНетВБух();
	Граница = Сейчас - 86400;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УПД.ИННКонтрагента КАК ИННКонтрагента,
	|	УПД.ДокументБух КАК ДокументБух,
	|	ЕСТЬNULL(Пакеты.ДатаОтправки, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОтправки
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Журнал.Идентификатор КАК Идентификатор,
	|			МАКСИМУМ(Журнал.ДатаОтправки) КАК ДатаОтправки
	|		ИЗ
	|			РегистрСведений.ЭАрМ_ПакетыБух КАК Журнал
	|		СГРУППИРОВАТЬ ПО
	|			Журнал.Идентификатор) КАК Пакеты
	|		ПО УПД.ИдентификаторСБИС = Пакеты.Идентификатор
	|ГДЕ
	|	УПД.Подписано
	|	И УПД.ВыгруженВБух
	|	И НЕ УПД.ОтправленоВБух
	|	И НЕ УПД.Аннулирована
	|	И УПД.ЗамененаНа = """"
	|	И УПД.ТипРеестра <> ""Отправленные""
	|	И УПД.Дата >= &ПериодС";
	Запрос.УстановитьПараметр("ПериодС", Сверка.ПериодС);

	Охват = Неопределено;
	Сверка.Свойство("ОхватИНН", Охват);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Сверка.УПДвБП.Получить(ВРег(СокрЛП(Выборка.ИдентификаторСБИС))) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Контрагента нет в файле БП (выгрузка с отбором) - «нет в Бух» не проверено
		Если Охват <> Неопределено И Охват.Получить(СокрЛП(ТекстИлиПусто(Выборка.ИННКонтрагента))) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Ушла давно и до формирования файла: иначе БП могла ещё не успеть
		Если НЕ ЗначениеЗаполнено(Выборка.ДатаОтправки) ИЛИ Выборка.ДатаОтправки >= Граница
			ИЛИ (ЗначениеЗаполнено(Сверка.Сформирован) И Выборка.ДатаОтправки >= Сверка.Сформирован) Тогда
			Продолжить;
		КонецЕсли;
		// Ответ БП («Не создан: …») важнее: тут только пусто, «в работе» и прежняя наша отметка
		Текущий = СокрЛП(Выборка.ДокументБух);
		Если ЗначениеЗаполнено(Текущий) И Текущий <> ТекстНет
			И НЕ СтрНачинаетсяС(Текущий, "В обработке") И НЕ СтрНачинаетсяС(Текущий, "Ответа Бух нет") Тогда
			Продолжить;
		КонецЕсли;
		Если Текущий = ТекстНет Тогда
			Отмечено = Отмечено + 1;
			Продолжить;
		КонецЕсли;

		НачатьТранзакцию();
		Попытка

			ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра("РегистрСведений.ЭАрМ_УПД_Входящий",
				Выборка.ИдентификаторСБИС);

			МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ИдентификаторСБИС = Выборка.ИдентификаторСБИС;
			МенеджерЗаписи.Прочитать();

			Если МенеджерЗаписи.Выбран() И НЕ МенеджерЗаписи.ОтправленоВБух Тогда
				МенеджерЗаписи.ДокументБух = ТекстНет;
				МенеджерЗаписи.Записать(Истина);
				Отмечено = Отмечено + 1;
			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			Ошибки.Добавить(СтрШаблон("УПД %1: %2", Выборка.ИдентификаторСБИС,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

	Возврат Отмечено;

КонецФункции

// Возвраты БП -> «Возврат в Бух» реестра УПД. УПД находится по поступлению БП,
// к которому относится возврат (пара УПД из сверки), иначе по ИНН поставщика и
// входящему номеру поступления (с допуском 200 дней по дате).
//
Функция ОтметитьВозвратыВБух(Сверка, Возвраты, Ошибки)

	Если Возвраты.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	// Поступление БП (УИД) -> УПД, у которых это пара
	УПДПоПоступлению = Новый Соответствие;
	Для Каждого КлючИЗначение Из Сверка.УПДвБП Цикл
		УИД = ВРег(СокрЛП(ТекстИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(КлючИЗначение.Значение, "УИД"))));
		Если НЕ ЗначениеЗаполнено(УИД) Тогда
			Продолжить;
		КонецЕсли;
		Список = УПДПоПоступлению.Получить(УИД);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			УПДПоПоступлению.Вставить(УИД, Список);
		КонецЕсли;
		Список.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	// УПД поставщиков, у которых есть возвраты без пары по поступлению
	ИННыБезПары = Новый Массив;
	Для Каждого ВозвратБП Из Возвраты Цикл
		УИД = ВРег(СокрЛП(ТекстИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ВозвратБП, "ПоступлениеБП"))));
		ИНН = СокрЛП(ТекстИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ВозвратБП, "КонтрагентИНН")));
		Если (НЕ ЗначениеЗаполнено(УИД) ИЛИ УПДПоПоступлению.Получить(УИД) = Неопределено)
			И ЗначениеЗаполнено(ИНН) И ИННыБезПары.Найти(ИНН) = Неопределено Тогда
			ИННыБезПары.Добавить(ИНН);
		КонецЕсли;
	КонецЦикла;

	КандидатыПоИНН = Новый Соответствие;
	Если ИННыБезПары.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
		|	УПД.ИННКонтрагента КАК ИННКонтрагента,
		|	УПД.Номер КАК Номер,
		|	УПД.Дата КАК Дата
		|ИЗ
		|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
		|ГДЕ
		|	УПД.ИННКонтрагента В (&ИННы)
		|	И УПД.ТипРеестра <> ""Отправленные""";
		Запрос.УстановитьПараметр("ИННы", ИННыБезПары);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Список = КандидатыПоИНН.Получить(СокрЛП(Выборка.ИННКонтрагента));
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				КандидатыПоИНН.Вставить(СокрЛП(Выборка.ИННКонтрагента), Список);
			КонецЕсли;
			Список.Добавить(Новый Структура("Идентификатор, НомерСравнения, Дата",
				Выборка.ИдентификаторСБИС, ЭАрМ_Служебный.НомерДляСравнения(Выборка.Номер), Выборка.Дата));
		КонецЦикла;
	КонецЕсли;

	// УПД (ВРег идентификатора) -> тексты возвратов
	ТекстыПоУПД = Новый Соответствие;
	Для Каждого ВозвратБП Из Возвраты Цикл

		Адресаты = Новый Массив;
		УИД = ВРег(СокрЛП(ТекстИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ВозвратБП, "ПоступлениеБП"))));
		Если ЗначениеЗаполнено(УИД) И УПДПоПоступлению.Получить(УИД) <> Неопределено Тогда
			Адресаты = УПДПоПоступлению.Получить(УИД);
		Иначе
			Адресаты = УПДДляВозвратаПоНомеру(ВозвратБП, КандидатыПоИНН);
		КонецЕсли;

		ТекстВозврата = ТекстВозвратаВБух(ВозвратБП);
		Для Каждого Адресат Из Адресаты Цикл
			Тексты = ТекстыПоУПД.Получить(ВРег(СокрЛП(Адресат)));
			Если Тексты = Неопределено Тогда
				Тексты = Новый Массив;
				ТекстыПоУПД.Вставить(ВРег(СокрЛП(Адресат)), Тексты);
			КонецЕсли;
			Если Тексты.Найти(ТекстВозврата) = Неопределено Тогда
				Тексты.Добавить(ТекстВозврата);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Если ТекстыПоУПД.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Идентификаторы = Новый Массив;
	Для Каждого КлючИЗначение Из ТекстыПоУПД Цикл
		Идентификаторы.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	Отмечено = 0;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УПД.ВозвратВБух КАК ВозвратВБух
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.ИдентификаторСБИС В (&Идентификаторы)";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		НовыйТекст = Лев(СтрСоединить(ТекстыПоУПД.Получить(ВРег(СокрЛП(Выборка.ИдентификаторСБИС))), "; "), 200);
		Если СокрЛП(Выборка.ВозвратВБух) = НовыйТекст Тогда
			Продолжить;
		КонецЕсли;

		НачатьТранзакцию();
		Попытка

			ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра("РегистрСведений.ЭАрМ_УПД_Входящий",
				Выборка.ИдентификаторСБИС);

			МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ИдентификаторСБИС = Выборка.ИдентификаторСБИС;
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.ВозвратВБух = НовыйТекст;
				МенеджерЗаписи.Записать(Истина);
				Отмечено = Отмечено + 1;
			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			Ошибки.Добавить(СтрШаблон("УПД %1 (возврат): %2", Выборка.ИдентификаторСБИС,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

	Возврат Отмечено;

КонецФункции

// УПД поставщика по входящему номеру поступления, к которому относится возврат:
// тот же номер «как читает человек», дата не дальше 200 дней, из нескольких -
// ближайшая; две одинаково близкие - не угадываем.
//
Функция УПДДляВозвратаПоНомеру(ВозвратБП, КандидатыПоИНН)

	Результат = Новый Массив;

	ИНН = СокрЛП(ТекстИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ВозвратБП, "КонтрагентИНН")));
	Номер = ЭАрМ_Служебный.НомерДляСравнения(
		ТекстИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ВозвратБП, "ПоступлениеНомерВходящий")));
	Кандидаты = КандидатыПоИНН.Получить(ИНН);
	Если Кандидаты = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Номер) Тогда
		Возврат Результат;
	КонецЕсли;

	ДатаПоступления = ЭАрМ_Служебный.ЗначениеУзла(ВозвратБП, "ПоступлениеДатаВходящая");
	Если ТипЗнч(ДатаПоступления) <> Тип("Дата") Тогда
		ДатаПоступления = '00010101';
	КонецЕсли;

	Лучший = Неопределено;
	ЛучшиеДни = 0;
	Ничья = Ложь;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.НомерСравнения <> Номер Тогда
			Продолжить;
		КонецЕсли;
		Дней = ?(ЗначениеЗаполнено(ДатаПоступления),
			Цел(Окр(Макс(Кандидат.Дата, ДатаПоступления) - Мин(Кандидат.Дата, ДатаПоступления)) / 86400), 0);
		Если Дней > 200 Тогда
			Продолжить;
		КонецЕсли;
		Если Лучший = Неопределено ИЛИ Дней < ЛучшиеДни Тогда
			Лучший = Кандидат;
			ЛучшиеДни = Дней;
			Ничья = Ложь;
		ИначеЕсли Дней = ЛучшиеДни Тогда
			Ничья = Истина;
		КонецЕсли;
	КонецЦикла;

	Если Лучший <> Неопределено И НЕ Ничья Тогда
		Результат.Добавить(Лучший.Идентификатор);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// «возврат № 5 от 16.10.2026, 220.00» (+ «, не проведён»).
//
Функция ТекстВозвратаВБух(ВозвратБП)

	Номер = СокрЛП(ТекстИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ВозвратБП, "Номер")));
	ДатаВозврата = ЭАрМ_Служебный.ЗначениеУзла(ВозвратБП, "Дата");
	Сумма = ЭАрМ_Служебный.ЗначениеУзла(ВозвратБП, "Сумма", 0);

	Возврат СтрШаблон(НСтр("ru = 'возврат %1 от %2, %3%4'"),
		?(ЗначениеЗаполнено(Номер), "№ " + Номер, НСтр("ru = 'б/н'")),
		?(ТипЗнч(ДатаВозврата) = Тип("Дата") И ЗначениеЗаполнено(ДатаВозврата),
			Формат(ДатаВозврата, "ДФ=dd.MM.yyyy"), "?"),
		Формат(?(ТипЗнч(Сумма) = Тип("Число"), Сумма, 0), "ЧДЦ=2; ЧРД=.; ЧГ=0"),
		?(ЭАрМ_Служебный.ЗначениеУзла(ВозвратБП, "Проведен", Ложь) = Истина, "", НСтр("ru = ', не проведён'")));

КонецФункции

// Пакеты в Бухгалтерию за период отправки - для формы: по файлу сколько
// документов, сколько ответов, сколько в Бух есть и не создано.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Файл, ДатаОтправки, Отправка, Документов, Ответов, ВБух,
//                     НеСоздано, БезОтвета, ДатаОтвета, Итог
//
Функция ПакетыБух(Знач ПериодС, Знач ПериодПо) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пакеты.Файл КАК Файл,
	|	МАКСИМУМ(Пакеты.ДатаОтправки) КАК ДатаОтправки,
	|	МАКСИМУМ(Пакеты.Отправка) КАК Отправка,
	|	КОЛИЧЕСТВО(*) КАК Документов,
	|	СУММА(ВЫБОР
	|			КОГДА Пакеты.ОтветПолучен
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Ответов,
	|	СУММА(ВЫБОР
	|			КОГДА Пакеты.ОтправленоВБух
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ВБух,
	|	СУММА(ВЫБОР
	|			КОГДА Пакеты.ОтветПолучен
	|					И НЕ Пакеты.ОтправленоВБух
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК НеСоздано,
	|	СУММА(ВЫБОР
	|			КОГДА Пакеты.ОтветПолучен
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК БезОтвета,
	|	МАКСИМУМ(Пакеты.ДатаОтвета) КАК ДатаОтвета
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПакетыБух КАК Пакеты
	|ГДЕ
	|	(Пакеты.ДатаОтправки МЕЖДУ &ПериодС И &ПериодПо
	|		ИЛИ Пакеты.ДатаОтправки = ДАТАВРЕМЯ(1, 1, 1)
	|			И Пакеты.ДатаОтвета МЕЖДУ &ПериодС И &ПериодПо)
	|
	|СГРУППИРОВАТЬ ПО
	|	Пакеты.Файл
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОтправки УБЫВ,
	|	ДатаОтвета УБЫВ";
	Запрос.УстановитьПараметр("ПериодС", ?(ЗначениеЗаполнено(ПериодС), НачалоДня(ПериодС), '00010101'));
	Запрос.УстановитьПараметр("ПериодПо", ?(ЗначениеЗаполнено(ПериодПо), КонецДня(ПериодПо), '39991231235959'));

	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("Итог", Новый ОписаниеТипов("Строка"));
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.БезОтвета = СтрокаТаблицы.Документов Тогда
			СтрокаТаблицы.Итог = НСтр("ru = 'Ответа БП нет'");
		ИначеЕсли СтрокаТаблицы.ВБух = СтрокаТаблицы.Документов Тогда
			СтрокаТаблицы.Итог = НСтр("ru = 'Всё есть в БП'");
		Иначе
			СтрокаТаблицы.Итог = СтрШаблон(НСтр("ru = 'В БП: %1 из %2; не создано: %3; без ответа: %4'"),
				СтрокаТаблицы.ВБух, СтрокаТаблицы.Документов, СтрокаТаблицы.НеСоздано, СтрокаТаблицы.БезОтвета);
		КонецЕсли;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Документы пакета - для формы.
//
Функция ДокументыПакетаБух(Знач ИмяФайла) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пакеты.Идентификатор КАК Идентификатор,
	|	Пакеты.Вид КАК Вид,
	|	Пакеты.Номер КАК Номер,
	|	Пакеты.ДатаДокумента КАК ДатаДокумента,
	|	Пакеты.Контрагент КАК Контрагент,
	|	Пакеты.ДатаОтправки КАК ДатаОтправки,
	|	Пакеты.ОтветПолучен КАК ОтветПолучен,
	|	Пакеты.Принята КАК Принята,
	|	Пакеты.ОтправленоВБух КАК ОтправленоВБух,
	|	Пакеты.ДокументБух КАК ДокументБух,
	|	Пакеты.Статус КАК Статус,
	|	Пакеты.ДатаОтвета КАК ДатаОтвета,
	|	Пакеты.ФайлОтвета КАК ФайлОтвета
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПакетыБух КАК Пакеты
	|ГДЕ
	|	Пакеты.Файл = &Файл
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пакеты.Вид УБЫВ,
	|	Пакеты.ДатаДокумента,
	|	Пакеты.Номер";
	Запрос.УстановитьПараметр("Файл", ИмяФайла);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Очистка журнала пакетов в Бухгалтерию (кнопка «Очистить журнал» формы
// «Пакеты в Бухгалтерию»): удаляются строки, по которым Бухгалтерия ответила,
// что документ у неё есть, старше ДнейХранить дней. Без ответа и «не создано»
// остаются. Отметки в реестрах УПД / УКД («Отправлено в Бух») не трогаются.
//
// Возвращаемое значение:
//   Строка - сколько удалено
//
Функция ОчиститьЖурналПакетовБух(Знач ДнейХранить = 30) Экспорт

	Граница = НачалоДня(ТекущаяДатаСеанса()) - ДнейХранить * 86400;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пакеты.Файл КАК Файл,
	|	Пакеты.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПакетыБух КАК Пакеты
	|ГДЕ
	|	Пакеты.ОтправленоВБух
	|	И Пакеты.ДатаОтвета < &Граница";
	Запрос.УстановитьПараметр("Граница", Граница);

	Удалено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			Набор = РегистрыСведений.ЭАрМ_ПакетыБух.СоздатьНаборЗаписей();
			Набор.Отбор.Файл.Установить(Выборка.Файл);
			Набор.Отбор.Идентификатор.Установить(Выборка.Идентификатор);
			Набор.Записать(Истина);
			Удалено = Удалено + 1;
		Исключение
			ОшибкаПроверкиИсключениеБух(Выборка.Идентификатор, "Очистка журнала ЭАрМ_ПакетыБух", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;

	Текст = СтрШаблон(НСтр("ru = 'Журнал пакетов очищен (старше %1 дн., документ в БП есть): удалено строк %2. Без ответа и не созданные оставлены'"),
		ДнейХранить, Удалено);
	ТрассаБух("", Текст);

	Возврат Текст;

КонецФункции

// --- Трасса обмена с Бухгалтерией ---

// Шаг обмена с Бухгалтерией - во все логи приёма (ЭАрМ_ПриемПакетовДалион.Трасса:
// журнал обмена, регистр ЭАрМ_ТрассаПриема, ТрассаПриема.log, журнал регистрации).
//
Процедура ТрассаБух(Идентификатор, Текст, Успех = Истина)

	Попытка
		ЭАрМ_ПриемПакетовДалион.Трасса(Идентификатор, НСтр("ru = 'Бух: '") + Текст, Успех);
	Исключение
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ВыгрузкаНакладныхДляБух",
			?(Успех, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Предупреждение), , ,
			СтрШаблон("%1 %2 (трасса не записана: %3)", Идентификатор, Текст,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

Процедура ОшибкаПроверкиБух(Идентификатор, Где, Текст)

	Попытка
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(Идентификатор, "Бух: " + Где, Текст);
	Исключение
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ВыгрузкаНакладныхДляБух", УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон("ОШИБКА ПРОВЕРКИ [Бух: %1] %2: %3 (трасса не записана: %4)", Где, Идентификатор, Текст,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

Процедура ОшибкаПроверкиИсключениеБух(Идентификатор, Где, Информация)

	ОшибкаПроверкиБух(Идентификатор, Где, ЭАрМ_Служебный.ТекстИсключения(Информация));

КонецПроцедуры

// Собирает текст JSON (Format 1) по подписанным УПД за период - без записи
// файла и без отметок.
//
// Параметры:
//   ПериодС  - Дата - начало периода по дате УПД; Неопределено - без ограничения
//   ПериодПо - Дата - конец периода по дате УПД; Неопределено - без ограничения
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, ТекстJSON, Накладных, Строк, Выгружены
//
Функция ТекстJSONДляБух(ПериодС = Неопределено, ПериодПо = Неопределено) Экспорт

	Отбор = НовыйОтборУПД();
	Если ЗначениеЗаполнено(ПериодС) Тогда
		Отбор.ПериодС = ПериодС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПериодПо) Тогда
		Отбор.ПериодПо = ПериодПо;
	КонецЕсли;

	Возврат СобратьJSON(Отбор);

КонецФункции

// --- Запись файла и отметки ---

Функция ВыгрузитьВПапку(ПапкаВыгрузки, Отбор)

	Результат = НовыйРезультатВыгрузки();

	Данные = СобратьJSON(Отбор);
	Если НЕ Данные.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = Данные.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Если Данные.Накладных = 0 Тогда
		// Файл не создаём: БП3 разбирает папку целиком, пустой файл - лишний шаг
		Возврат Результат;
	КонецЕсли;

	Попытка

		ФайлПапки = Новый Файл(ПапкаВыгрузки);
		Если НЕ ФайлПапки.Существует() Тогда
			СоздатьКаталог(ПапкаВыгрузки);
		КонецЕсли;

		// Выгрузки после подписи идут одна за другой в ту же секунду:
		// хвост из идентификатора не даёт второй затереть первую
		Результат.ИмяФайла = СтрШаблон("ПриходныеНакладные_%1_%2.json",
			Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss"),
			Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 8));
		Результат.ПутьКФайлу = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(
			ПапкаВыгрузки, Результат.ИмяФайла);

		ЗаписьТекста = Новый ЗаписьТекста(Результат.ПутьКФайлу, КодировкаТекста.UTF8);
		Попытка
			ЗаписьТекста.Записать(Данные.ТекстJSON);
		Исключение
			// Файл закрываем всегда - иначе он останется занятым
			ЗаписьТекста.Закрыть();
			ВызватьИсключение;
		КонецПопытки;
		ЗаписьТекста.Закрыть();

	Исключение

		Результат.Успех = Ложь;
		Результат.Ошибка = СтрШаблон(
			НСтр("ru = 'Не удалось записать файл выгрузки в БП: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ВыгрузкаНакладныхДляБух",
			УровеньЖурналаРегистрации.Ошибка, , , Результат.Ошибка);
		Возврат Результат;

	КонецПопытки;

	Результат.НакладныхВыгружено = Данные.Накладных;
	Результат.СтрокВыгружено = Данные.Строк;
	Результат.Выгружены = Данные.Выгружены;

	МоментОтправки = Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'");
	Для Каждого Идентификатор Из Данные.Выгружены Цикл
		ЗаписатьВОчередь(Идентификатор, СтрШаблон(
			НСтр("ru = 'Отправлено %1: %2. Ждём ответ БП'"),
			МоментОтправки, Данные.Описания.Получить(Идентификатор)));
	КонецЦикла;

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ВыгрузкаНакладныхДляБух",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон(НСтр("ru = 'Выгружено в БП накладных: %1, строк: %2, файл: %3'"),
			Данные.Накладных, Данные.Строк, Результат.ПутьКФайлу));

	Возврат Результат;

КонецФункции

// Ставит отметку ВыгруженВБух. Файл уже в папке: ошибка отметки не отменяет
// выгрузку - в худшем случае УПД уйдёт ещё раз, и Бухгалтерия его пропустит
// как уже полученный.
//
Процедура ОтметитьВыгруженными(Идентификаторы)

	Для Каждого Идентификатор Из Идентификаторы Цикл

		НачатьТранзакцию();
		Попытка

			ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра(
				"РегистрСведений.ЭАрМ_УПД_Входящий", Идентификатор);

			МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
			МенеджерЗаписи.Прочитать();

			Если МенеджерЗаписи.Выбран() И НЕ МенеджерЗаписи.ВыгруженВБух Тогда
				МенеджерЗаписи.ВыгруженВБух = Истина;
				МенеджерЗаписи.Записать(Истина);
			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("АРМ_ЭДО.ВыгрузкаНакладныхДляБух",
				УровеньЖурналаРегистрации.Предупреждение, , ,
				СтрШаблон(НСтр("ru = 'УПД %1 выгружен, но отметка не записана: %2'"),
					Идентификатор, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

