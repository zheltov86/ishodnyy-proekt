// Честный знак: коды маркировки строк документов (регистр ЭАрМ_КодыМаркировкиСтрок),
// сверка количества марок со штуками по линиям реестра товаров и GTIN из марок
// в штрихкоды номенклатуры УТ.
//
// Источники кодов: строки УПД и ЭТрН (ЭАрМ_ТоварыЭТрН.Маркировки) и строки
// прихода Далиона (goods[].markingCodes -> линии сверки). Раскрытие агрегатов
// (SSCC, коды упаковок) и проверка статуса кода требуют ГИС МТ (True API с
// токеном по УКЭП) - здесь не делаются: агрегаты только считаются отдельно.

#Область ПрограммныйИнтерфейс

// Перезаписывает коды маркировки документа в регистре по его строкам товаров.
//
// Параметры:
//   ИдентификаторСБИС - Строка - документ УПД или ЭТрН (ЭАрМ_ТоварыЭТрН.ИдентификаторСБИС)
//
// Возвращаемое значение:
//   Число - записано кодов
//
Функция ЗаписатьКодыДокумента(ИдентификаторСБИС) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторСБИС) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.ИсточникТоваров КАК ИсточникТоваров,
	|	Товары.Маркировки КАК Маркировки
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &ИдентификаторСБИС
	|	И Товары.Маркировок > 0";
	Запрос.УстановитьПараметр("ИдентификаторСБИС", ИдентификаторСБИС);
	Выборка = Запрос.Выполнить().Выбрать();

	Строки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Строки.Добавить(Новый Структура("Источник, НомерПозиции, Коды",
			Выборка.ИсточникТоваров, Выборка.НомерПозиции, Выборка.Маркировки));
	КонецЦикла;

	Возврат ЗаписатьКоды(ИдентификаторСБИС, Строки);

КонецФункции

// Перезаписывает коды маркировки прихода Далиона по линиям сверки цепочки.
//
// Параметры:
//   ИдентификаторПоступления - Строка
//   Линии - Массив из Структура - линии сверки (поле Поступление с Маркировки)
//
// Возвращаемое значение:
//   Число - записано кодов
//
Функция ЗаписатьКодыПрихода(ИдентификаторПоступления, Линии) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторПоступления) ИЛИ Линии = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого Линия Из Линии Цикл
		Коды = КодыСтроки(Линия.Поступление);
		Если Коды.Количество() > 0 Тогда
			Строки.Добавить(Новый Структура("Источник, НомерПозиции, Коды", "Приход", Линия.НомерСтроки, Коды));
		КонецЕсли;
	КонецЦикла;

	Возврат ЗаписатьКоды(ИдентификаторПоступления, Строки);

КонецФункции

// Переносит в регистр коды всех документов, у строк которых есть маркировка.
//
// Возвращаемое значение:
//   Структура - Документов, Кодов, Ошибок (Число)
//
Функция ПеренестиВсеКоды() Экспорт

	Итог = Новый Структура("Документов, Кодов, Ошибок", 0, 0, 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Товары.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.Маркировок > 0";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			Итог.Кодов = Итог.Кодов + ЗаписатьКодыДокумента(Выборка.ИдентификаторСБИС);
			Итог.Документов = Итог.Документов + 1;
		Исключение
			Итог.Ошибок = Итог.Ошибок + 1;
			ЗаписьЖурналаРегистрации("ЭАрМ.ЧестныйЗнак", УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Сверка марок линии реестра товаров: коды Честного знака УПД/ЭТрН и прихода
// Далиона против количества штук.
//
// Параметры:
//   Линия - Структура - линия сверки (УПД, ЭТрН, Поступление с полями Маркировки, Количество)
//
// Возвращаемое значение:
//   Структура:
//     * МарокУПД   - Число - поштучных кодов в УПД и ЭТрН
//     * МарокПН    - Число - поштучных кодов в приходе Далиона
//     * Агрегатов  - Число - кодов упаковок и SSCC (без раскрытия в ГИС МТ)
//     * Текст      - Строка - итог; с «⚠» - есть что проверить; пусто - товар без марок
//
Функция СверкаМарокЛинии(Линия) Экспорт

	Результат = Новый Структура("МарокУПД, МарокПН, Агрегатов, Текст", 0, 0, 0, "");

	КодыУПД = Новый Соответствие;
	КодыПН  = Новый Соответствие;
	Агрегаты = Новый Соответствие;
	ДобавитьПоштучные(КодыУПД, Агрегаты, КодыСтроки(Линия.УПД));
	ДобавитьПоштучные(КодыУПД, Агрегаты, КодыСтроки(Линия.ЭТрН));
	ДобавитьПоштучные(КодыПН, Агрегаты, КодыСтроки(Линия.Поступление));

	Результат.МарокУПД  = КодыУПД.Количество();
	Результат.МарокПН   = КодыПН.Количество();
	Результат.Агрегатов = Агрегаты.Количество();

	Если Результат.МарокУПД = 0 И Результат.МарокПН = 0 И Результат.Агрегатов = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Штук = КоличествоСтроки(Линия.УПД);
	Если Штук = 0 Тогда
		Штук = КоличествоСтроки(Линия.Поступление);
	КонецЕсли;

	Замечания = Новый Массив;
	Если Результат.МарокУПД = 0 И Результат.Агрегатов > 0 Тогда
		Замечания.Добавить(СтрШаблон("в УПД только агрегаты (%1) - раскрыть в ГИС МТ", Результат.Агрегатов));
	ИначеЕсли Штук > 0 И Результат.МарокУПД > 0 И Результат.МарокУПД <> Штук Тогда
		Замечания.Добавить(СтрШаблон("в УПД марок %1, штук %2", Результат.МарокУПД, Штук));
	КонецЕсли;

	Если Результат.МарокПН > 0 Тогда
		Если Штук > 0 И Результат.МарокПН < Штук Тогда
			Замечания.Добавить(СтрШаблон("в приходе не отсканировано %1", Штук - Результат.МарокПН));
		КонецЕсли;
		Если Результат.МарокУПД > 0 Тогда
			Чужих = 0;
			Для Каждого КлючЗначение Из КодыПН Цикл
				Если КодыУПД.Получить(КлючЗначение.Ключ) = Неопределено Тогда
					Чужих = Чужих + 1;
				КонецЕсли;
			КонецЦикла;
			Если Чужих > 0 Тогда
				Замечания.Добавить(СтрШаблон("в приходе %1 марок, которых нет в УПД", Чужих));
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Результат.МарокУПД > 0 И ЕстьПриход(Линия) Тогда
		Замечания.Добавить("в приходе марки не отсканированы");
	КонецЕсли;

	Если Замечания.Количество() = 0 Тогда
		Результат.Текст = СтрШаблон("марки сходятся: %1", Макс(Результат.МарокУПД, Результат.МарокПН));
	Иначе
		Результат.Текст = "⚠ " + СтрСоединить(Замечания, "; ");
	КонецЕсли;
	Результат.Текст = Лев(Результат.Текст, 100);

	Возврат Результат;

КонецФункции

// Где встречается код маркировки: документы и позиции из регистра кодов.
//
// Параметры:
//   Код - Строка - код целиком (как в документе)
//
// Возвращаемое значение:
//   ТаблицаЗначений - ИдентификаторДокумента, Источник, НомерПозиции, Вид, GTIN, Серийный, Наименование
//
Функция ДокументыПоКоду(Знач Код) Экспорт

	Код = СокрЛП(Код);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Коды.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	Коды.Источник КАК Источник,
	|	Коды.НомерПозиции КАК НомерПозиции,
	|	Коды.Вид КАК Вид,
	|	Коды.GTIN КАК GTIN,
	|	Коды.Серийный КАК Серийный,
	|	ЕСТЬNULL(Товары.Наименование, """") КАК Наименование
	|ИЗ
	|	РегистрСведений.ЭАрМ_КодыМаркировкиСтрок КАК Коды
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ПО Коды.ИдентификаторДокумента = Товары.ИдентификаторСБИС
	|			И Коды.НомерПозиции = Товары.НомерПозиции
	|			И Коды.Источник = Товары.ИсточникТоваров
	|ГДЕ
	|	(Коды.Код = &Код
	|			ИЛИ &ЕстьGTIN
	|				И Коды.GTIN = &GTIN
	|				И Коды.Серийный = &Серийный)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИдентификаторДокумента,
	|	НомерПозиции";
	Запрос.УстановитьПараметр("Код", Лев(Код, ДлинаКода()));
	// Сканер часто отдаёт код без разделителя GS и криптохвоста - товар тот же,
	// если совпали GTIN и серийный номер
	Разбор = ЭАрМ_КодыМаркировки.РазобратьКод(Код);
	Запрос.УстановитьПараметр("ЕстьGTIN", ЗначениеЗаполнено(Разбор.GTIN) И ЗначениеЗаполнено(Разбор.Серийный));
	Запрос.УстановитьПараметр("GTIN", Разбор.GTIN);
	Запрос.УстановитьПараметр("Серийный", Разбор.Серийный);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// GTIN из марок Честного знака - в штрихкоды номенклатуры УТ. Номенклатура
// находится по штрихкоду линии реестра или по самому GTIN. Занятый чужой
// номенклатурой штрихкод не перебивается. Заодно проверяется, что номенклатура
// готова к маркировке: особенность учёта маркируемого товара и код ТН ВЭД.
//
// Параметры:
//   ТолькоПроверка - Булево - ничего не записывать, только показать
//
// Возвращаемое значение:
//   Структура - Линий, Добавлено, ЕстьУже (Число), Замечания (Массив из Строка)
//
Функция ПривязатьGTINКНоменклатуре(ТолькоПроверка = Истина) Экспорт

	Итог = Новый Структура("Линий, Добавлено, ЕстьУже, Замечания", 0, 0, 0, Новый Массив);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Коды.GTIN КАК GTIN,
	|	ЕСТЬNULL(Товары.Наименование, """") КАК Наименование,
	|	ЕСТЬNULL(Товары.Штрихкод, """") КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ЭАрМ_КодыМаркировкиСтрок КАК Коды
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ПО Коды.ИдентификаторДокумента = Товары.ИдентификаторСБИС
	|			И Коды.НомерПозиции = Товары.НомерПозиции
	|			И Коды.Источник = Товары.ИсточникТоваров
	|ГДЕ
	|	Коды.GTIN <> """"
	|	И Коды.Вид В (""ЧестныйЗнак"", ""ЧестныйЗнакПачка"")";
	ПоGTIN = Запрос.Выполнить().Выгрузить();

	Обработанные = Новый Соответствие;
	Для Каждого СтрокаGTIN Из ПоGTIN Цикл

		EAN = EANИзGTIN(СтрокаGTIN.GTIN);
		Если Обработанные.Получить(EAN) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обработанные.Вставить(EAN, Истина);
		Итог.Линий = Итог.Линий + 1;

		ПоКоду = НоменклатураПоШтрихкоду(EAN);
		ПоСтроке = НоменклатураПоШтрихкоду(СтрокаGTIN.Штрихкод);
		Представление = ?(ЗначениеЗаполнено(СтрокаGTIN.Наименование), СтрокаGTIN.Наименование, EAN);

		Если ЗначениеЗаполнено(ПоКоду) Тогда
			Итог.ЕстьУже = Итог.ЕстьУже + 1;
			Если ЗначениеЗаполнено(ПоСтроке) И ПоСтроке <> ПоКоду Тогда
				ДобавитьЗамечание(Итог, СтрШаблон("%1: GTIN %2 у «%3», а штрихкод строки у «%4» - дубль номенклатуры?",
					Представление, EAN, ПоКоду, ПоСтроке));
			КонецЕсли;
			ПроверитьГотовность(ПоКоду, Представление, Итог);
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(ПоСтроке) Тогда
			ДобавитьЗамечание(Итог, СтрШаблон("%1: GTIN %2 - номенклатуры УТ нет ни по GTIN, ни по штрихкоду строки",
				Представление, EAN));
			Продолжить;
		КонецЕсли;

		ПроверитьГотовность(ПоСтроке, Представление, Итог);
		Если ТолькоПроверка Тогда
			ДобавитьЗамечание(Итог, СтрШаблон("%1: GTIN %2 будет добавлен к «%3»", Представление, EAN, ПоСтроке));
			Продолжить;
		КонецЕсли;

		Попытка
			Менеджер = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
			Менеджер.Штрихкод     = EAN;
			Менеджер.Номенклатура = ПоСтроке;
			Менеджер.Записать(Ложь);
			Итог.Добавлено = Итог.Добавлено + 1;
		Исключение
			ДобавитьЗамечание(Итог, СтрШаблон("%1: GTIN %2 не записан - %3", Представление, EAN,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаписатьКоды(ИдентификаторДокумента, Строки)

	Набор = РегистрыСведений.ЭАрМ_КодыМаркировкиСтрок.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторДокумента.Установить(Лев(ИдентификаторДокумента, 100));

	Уже = Новый Соответствие;
	ДатаЗаписи = ТекущаяДатаСеанса();
	Для Каждого СтрокаКодов Из Строки Цикл
		Для Каждого Код Из КодыКакМассив(СтрокаКодов.Коды) Цикл
			Текст = Лев(СокрЛП(Код), ДлинаКода());
			Если НЕ ЗначениеЗаполнено(Текст) Тогда
				Продолжить;
			КонецЕсли;
			Ключ = СтрокаКодов.Источник + "|" + Формат(СтрокаКодов.НомерПозиции, "ЧГ=0") + "|" + Текст;
			Если Уже.Получить(Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Уже.Вставить(Ключ, Истина);

			Разбор = ЭАрМ_КодыМаркировки.РазобратьКод(Текст);
			Запись = Набор.Добавить();
			Запись.ИдентификаторДокумента = Лев(ИдентификаторДокумента, 100);
			Запись.Источник     = Лев(СтрокаКодов.Источник, 20);
			Запись.НомерПозиции = СтрокаКодов.НомерПозиции;
			Запись.Код          = Текст;
			Запись.Вид          = Лев(Разбор.Вид, 20);
			Запись.GTIN         = Лев(Разбор.GTIN, 14);
			Запись.Серийный     = Лев(Разбор.Серийный, 50);
			Запись.ДатаЗаписи   = ДатаЗаписи;
		КонецЦикла;
	КонецЦикла;

	Набор.Записать(Истина);
	Возврат Набор.Количество();

КонецФункции

Процедура ДобавитьПоштучные(Поштучные, Агрегаты, Коды)

	Для Каждого Код Из Коды Цикл
		Разбор = ЭАрМ_КодыМаркировки.РазобратьКод(Код);
		Если Разбор.Вид = "ЧестныйЗнак" ИЛИ Разбор.Вид = "ЧестныйЗнакПачка" Тогда
			// Один и тот же товар - по коду идентификации (GTIN + серийный), без криптохвоста
			Ключ = ?(ЗначениеЗаполнено(Разбор.КодИдентификации), Разбор.КодИдентификации,
				Разбор.GTIN + "|" + Разбор.Серийный);
			Поштучные.Вставить(Ключ, Истина);
		ИначеЕсли Разбор.Вид = "SSCC" ИЛИ Разбор.Вид = "Неизвестно" Тогда
			Агрегаты.Вставить(СокрЛП(Код), Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция КодыСтроки(СтрокаДокумента)

	Если СтрокаДокумента = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Маркировки = Неопределено;
	Если ТипЗнч(СтрокаДокумента) = Тип("Структура") Тогда
		СтрокаДокумента.Свойство("Маркировки", Маркировки);
	Иначе
		Попытка
			Маркировки = СтрокаДокумента.Маркировки;
		Исключение
			Маркировки = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат КодыКакМассив(Маркировки);

КонецФункции

Функция КодыКакМассив(Коды)

	Результат = Новый Массив;
	Если ТипЗнч(Коды) = Тип("Массив") Тогда
		Для Каждого Код Из Коды Цикл
			Если ЗначениеЗаполнено(Код) Тогда
				Результат.Добавить(СокрЛП(Код));
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Коды) = Тип("Строка") Тогда
		Для Каждого Код Из СтрРазделить(Коды, Символы.ПС, Ложь) Цикл
			Если ЗначениеЗаполнено(СокрЛП(Код)) Тогда
				Результат.Добавить(СокрЛП(Код));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция КоличествоСтроки(СтрокаДокумента)

	Если ТипЗнч(СтрокаДокумента) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;
	Количество = 0;
	СтрокаДокумента.Свойство("Количество", Количество);
	Возврат ?(ТипЗнч(Количество) = Тип("Число"), Количество, 0);

КонецФункции

Функция ЕстьПриход(Линия)

	Возврат ТипЗнч(Линия.Поступление) = Тип("Структура") И КоличествоСтроки(Линия.Поступление) > 0;

КонецФункции

Процедура ПроверитьГотовность(Номенклатура, Представление, Итог)

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "ОсобенностьУчета, КодТНВЭД", Истина);
	Если Реквизиты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Реквизиты.ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры.БезОсобенностейУчета
		ИЛИ НЕ ЗначениеЗаполнено(Реквизиты.ОсобенностьУчета) Тогда
		ДобавитьЗамечание(Итог, СтрШаблон("%1: у «%2» нет особенности учёта маркируемого товара - сменить вид номенклатуры",
			Представление, Номенклатура));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Реквизиты.КодТНВЭД) Тогда
		ДобавитьЗамечание(Итог, СтрШаблон("%1: у «%2» не заполнен код ТН ВЭД", Представление, Номенклатура));
	КонецЕсли;

КонецПроцедуры

// Фасад: делегирует в ЭАрМ_ПодборНоменклатуры (единая точка входа).
Функция НоменклатураПоШтрихкоду(Штрихкод)

	Возврат ЭАрМ_ПодборНоменклатуры.НоменклатураПоШтрихкоду(Штрихкод);

КонецФункции

// GTIN-14 с ведущим нулём - EAN-13, как штрихкоды хранит УТ.
Функция EANИзGTIN(GTIN)

	Код = ТолькоЦифры(GTIN);
	Если СтрДлина(Код) = 14 И СтрНачинаетсяС(Код, "0") Тогда
		Возврат Сред(Код, 2);
	КонецЕсли;
	Возврат Код;

КонецФункции

// Фасад: делегирует в ЭАрМ_ПодборНоменклатуры (единая реализация).
Функция ТолькоЦифры(Значение)

	Возврат ЭАрМ_ПодборНоменклатуры.ТолькоЦифры(Значение);

КонецФункции

Процедура ДобавитьЗамечание(Итог, Текст)

	Если Итог.Замечания.Количество() < 200 Тогда
		Итог.Замечания.Добавить(Текст);
	КонецЕсли;

КонецПроцедуры

Функция ДлинаКода()

	Возврат 200;

КонецФункции

#КонецОбласти
