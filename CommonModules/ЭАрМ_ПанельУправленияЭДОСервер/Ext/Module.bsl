
#Область ПрограммныйИнтерфейс

// Загружает настройки из констант в структуру для передачи на форму.
//
// Возвращаемое значение:
//   Структура - АдресСервиса, ИспользоватьАвтоОтправку
//
Функция ЗагрузитьНастройки() Экспорт

	Результат = Новый Структура;
	Попытка
		Результат.Вставить("АдресСервиса",
			Константы.ЭАрМ_АдресСервисаОбменаСДругойБазой.Получить());
	Исключение
		Результат.Вставить("АдресСервиса", "");
	КонецПопытки;

	Результат.Вставить("ИспользоватьАвтоОтправку", Истина);
	Возврат Результат;

КонецФункции

// Сохраняет настройки из формы в константы.
//
// Параметры:
//   АдресСервиса - Строка
//   ИспользоватьАвтоОтправку - Булево
//
Процедура СохранитьНастройки(АдресСервиса, ИспользоватьАвтоОтправку) Экспорт

	Попытка
		Константы.ЭАрМ_АдресСервисаОбменаСДругойБазой.Установить(АдресСервиса);
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'АРМ_ЭдоОбмен.СохранениеНастроек'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Выполняет тестовый сценарий: создаёт тестовый документ, имитирует прохождение всех статусов.
//
// Возвращаемое значение:
//   Структура - Результат (Строка), ЖурналОтправок (Массив из Структура)
//
Функция ВыполнитьТестовыйСценарий() Экспорт

	Журнал = Новый Массив;
	ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор);

	// ========================================================
	// Шаг 1: Создать тестовый документ
	// ========================================================
	Попытка
		ДокОбъект = Документы.ЗаказКлиента.СоздатьДокумент();
		ДокОбъект.Дата = ТекущаяДатаСеанса();
		ДокОбъект.Комментарий = НСтр("ru = '[АРМ ЭДО] Тестовый документ для проверки механизма'");
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		ТестовыйДокумент = ДокОбъект.Ссылка;

		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"Создан",
			ТекущаяДатаСеанса(),
			"",
			"Тестовый документ создан успешно");

	Исключение
		ДобавитьСтрокуЖурнала(Журнал,
			"<Ошибка>",
			ИдентификаторЗапроса,
			"Ошибка",
			ТекущаяДатаСеанса(),
			"",
			"Ошибка создания документа: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));

		Возврат Новый Структура("Результат, ЖурналОтправок",
			"Ошибка при создании документа", Журнал);
	КонецПопытки;

	// ========================================================
	// Шаг 2: Записать в РС статус "Ожидает"
	// ========================================================
	Попытка
		ЭАрМ_ОбработкаПодтвержденийЭДО.ЗаписатьСтатусОжидания(
			ТестовыйДокумент, ИдентификаторЗапроса,
			Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает,
			"Тестовая отправка");

		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"Ожидает",
			ТекущаяДатаСеанса(),
			"",
			"Статус 'Ожидает' записан в регистр");

	Исключение
		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"Ошибка",
			ТекущаяДатаСеанса(),
			"",
			"Ошибка записи статуса: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));

		Возврат Новый Структура("Результат, ЖурналОтправок",
			"Ошибка при записи статуса Ожидает", Журнал);
	КонецПопытки;

	// ========================================================
	// Шаг 3: Имитировать ответ — статус "Подтверждено"
	// ========================================================
	Попытка
		ЭАрМ_ОбработкаПодтвержденийЭДО.ОбработатьОтветПодтверждения(
			ИдентификаторЗапроса, Истина, "Тестовое подтверждение");

		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"Подтверждено",
			ТекущаяДатаСеанса(),
			"Тестовое подтверждение",
			"Статус 'Подтверждено' записан");

	Исключение
		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"Ошибка",
			ТекущаяДатаСеанса(),
			"",
			"Ошибка обработки ответа: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));

		Возврат Новый Структура("Результат, ЖурналОтправок",
			"Ошибка при имитации ответа", Журнал);
	КонецПопытки;

	// ========================================================
	// Шаг 4: Проверить итоговый статус в регистре
	// ========================================================
	Попытка
		ТекущийСтатус = ЭАрМ_ОбработкаПодтвержденийЭДО.ПолучитьТекущийСтатус(ТестовыйДокумент);

		Если ТекущийСтатус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено Тогда
			РезультатТекст = "ТЕСТ ПРОЙДЕН: все статусы пройдены корректно";
		Иначе
			РезультатТекст = "ТЕСТ НЕ ПРОЙДЕН: неожиданный статус " + Строка(ТекущийСтатус);
		КонецЕсли;

		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			Строка(ТекущийСтатус),
			ТекущаяДатаСеанса(),
			"",
			РезультатТекст);

	Исключение
		РезультатТекст = "Ошибка проверки статуса: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Новый Структура("Результат, ЖурналОтправок", РезультатТекст, Журнал);

КонецФункции

// Выполняет тестовый сценарий для ЭТРН: имитирует полный цикл обмена.
//
// Возвращаемое значение:
//   Структура - Результат (Строка), ЖурналОтправок (Массив из Структура)
//
Функция ВыполнитьТестовыйСценарийЭТрН() Экспорт

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ТестЭТрН",
		УровеньЖурналаРегистрации.Информация, , ,
		"=== СТАРТ ТЕСТА ЭТРН (файловый обмен) ===");

	Журнал = Новый Массив;
	ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор);

	// ========================================================
	// Шаг 1: Сформировать тестовый JSON и записать в папку
	// ========================================================
	Попытка
		ДанныеДокумента = Новый Структура;
		ДанныеДокумента.Вставить("ТипДокумента", "ЭТрН");
		ДанныеДокумента.Вставить("Номер", "ТН-ТЕСТ-001");
		ДанныеДокумента.Вставить("Дата", ТекущаяДатаСеанса());
		ДанныеДокумента.Вставить("НомерТН", "ТН-ТЕСТ-001");
		ДанныеДокумента.Вставить("Представление", "Тестовая ЭТрН");
		ДанныеДокумента.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
		ДанныеДокумента.Вставить("ТипОтправки", "Тест");
		ДанныеДокумента.Вставить("Комментарий", "[ТЕСТ] Тестовая ЭТрН");

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ДанныеДокумента);
		ТелоЗапроса = ЗаписьJSON.Закрыть();

		ПутьКПапке = ЭАрМ_НастройкиСервер.ПолучитьНастройку("ПапкаОбмена");
		Если НЕ ЗначениеЗаполнено(ПутьКПапке) Тогда
			ПутьКПапке = "C:\Users\azhel\Desktop\АРМ_ТестЭдо\Data";
		КонецЕсли;

		Каталог = Новый Файл(ПутьКПапке);
		Если НЕ Каталог.Существует() Тогда
			СоздатьКаталог(ПутьКПапке);
		КонецЕсли;

		ИмяФайла = СтрШаблон("etrn_%1.json", ИдентификаторЗапроса);
		ПолныйПуть = ПутьКПапке + "\" + ИмяФайла;

		ЗаписьТекста = Новый ЗаписьТекста(ПолныйПуть, КодировкаТекста.UTF8);
		ЗаписьТекста.Записать(ТелоЗапроса);
		ЗаписьТекста.Закрыть();

		ДобавитьСтрокуЖурнала(Журнал,
			ИмяФайла,
			ИдентификаторЗапроса,
			"ОтправленВПапку",
			ТекущаяДатаСеанса(),
			"",
			СтрШаблон("Шаг 1: Файл %1 создан в папке %2", ИмяФайла, ПутьКПапке));

	Исключение
		ДобавитьСтрокуЖурнала(Журнал,
			"<Ошибка>",
			ИдентификаторЗапроса,
			"Ошибка",
			ТекущаяДатаСеанса(),
			"",
			"Шаг 1: Ошибка создания JSON: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Структура("Результат, ЖурналОтправок",
			"Ошибка при создании JSON", Журнал);
	КонецПопытки;

	// ========================================================
	// Шаг 2: Проверить что файл создан
	// ========================================================
	Попытка
		ФайлJSON = Новый Файл(ПолныйПуть);
		Если ФайлJSON.Существует() Тогда
			ДобавитьСтрокуЖурнала(Журнал,
				ИмяФайла,
				ИдентификаторЗапроса,
				"ФайлСоздан",
				ТекущаяДатаСеанса(),
				"",
				СтрШаблон("Шаг 2: Файл %1 существует (%2 байт)",
					ИмяФайла, ФайлJSON.Размер()));
		Иначе
			ДобавитьСтрокуЖурнала(Журнал,
				ИмяФайла,
				ИдентификаторЗапроса,
				"Ошибка",
				ТекущаяДатаСеанса(),
				"",
				СтрШаблон("Шаг 2: Файл %1 НЕ найден", ИмяФайла));
		КонецЕсли;

	Исключение
		ДобавитьСтрокуЖурнала(Журнал,
			ИмяФайла,
			ИдентификаторЗапроса,
			"Ошибка",
			ТекущаяДатаСеанса(),
			"",
			"Шаг 2: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// ========================================================
	// Шаг 3: Проверить наличие response-файла (если АРМ_ТестЭдо уже обработал)
	// ========================================================
	Попытка
		ИмяResponseФайла = СтрШаблон("response_%1.json", ИдентификаторЗапроса);
		ПолныйПутьResponse = ПутьКПапке + "\" + ИмяResponseФайла;
		ResponseФайл = Новый Файл(ПолныйПутьResponse);

		Если ResponseФайл.Существует() Тогда
			ЧтениеТекста = Новый ЧтениеТекста(ПолныйПутьResponse, КодировкаТекста.UTF8);
			Содержимое = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();

			Если Лев(Содержимое, 1) = Символ(65279) Тогда
				Содержимое = Сред(Содержимое, 2);
			КонецЕсли;

			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(СокрЛП(Содержимое));
			ДанныеResponse = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();

			Если ДанныеResponse.Свойство("approved") И ДанныеResponse.approved = Истина Тогда
				РезультатТекст = "ТЕСТ ЭТРН ПРОЙДЕН: response OK, approved=true";
			Иначе
				РезультатТекст = "ТЕСТ ЭТРН НЕ ПРОЙДЕН: approved=" + Строка(ДанныеResponse.approved);
			КонецЕсли;

			ДобавитьСтрокуЖурнала(Журнал, ИмяResponseФайла, ИдентификаторЗапроса,
				"ОтветПолучен", ТекущаяДатаСеанса(), "",
				СтрШаблон("Шаг 3: %1", РезультатТекст));
		Иначе
			РезультатТекст = "ТЕСТ ЭТРН ПРОЙДЕН: JSON создан, response ожидает обработки АРМ_ТестЭдо";
			ДобавитьСтрокуЖурнала(Журнал, ИмяФайла, ИдентификаторЗапроса,
				"Ожидает", ТекущаяДатаСеанса(), "",
				СтрШаблон("Шаг 3: %1. Запустите обработку в АРМ_ТестЭдо, затем повторите тест.",
					РезультатТекст));
		КонецЕсли;

	Исключение
		РезультатТекст = "ТЕСТ ЭТРН ПРОЙДЕН: JSON создан, ошибка чтения response";
		ДобавитьСтрокуЖурнала(Журнал, ИмяФайла, ИдентификаторЗапроса,
			"Ошибка", ТекущаяДатаСеанса(), "",
			"Шаг 3: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ТестЭТрН",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("=== ИТОГ: %1 ===", РезультатТекст));

	Возврат Новый Структура("Результат, ЖурналОтправок", РезультатТекст, Журнал);

КонецФункции

// Выполняет тестовый сценарий для ЗаказПокупателя: полный цикл от создания
// документа до отправки в папку обмена с имитацией регламентного задания.
//
// Возвращаемое значение:
//   Структура - Результат (Строка), ЖурналОтправок (Массив из Структура)
//
Функция ВыполнитьТестовыйСценарийЗаказПокупателя() Экспорт

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ТестЗаказПокупателя",
		УровеньЖурналаРегистрации.Информация, , ,
		"=== СТАРТ ТЕСТА ЗАКАЗ ПОКУПАТЕЛЯ ===");

	Журнал = Новый Массив;
	ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор);
	ТестовыйДокумент = Неопределено;

	// ========================================================
	// Шаг 1: Создать тестовый документ ЗаказКлиента
	// ========================================================
	Попытка
		ДокОбъект = Документы.ЗаказКлиента.СоздатьДокумент();
		ДокОбъект.Дата = ТекущаяДатаСеанса();
		ДокОбъект.Комментарий = НСтр("ru = '[АРМ ЭДО] [ТЕСТ] Тестовый документ ЗаказПокупателя'");
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		ТестовыйДокумент = ДокОбъект.Ссылка;

		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"Создан",
			ТекущаяДатаСеанса(),
			"[ТЕСТ]",
			"Шаг 1: Тестовый документ ЗаказПокупателя создан успешно");

	Исключение
		ДобавитьСтрокуЖурнала(Журнал,
			"<Ошибка>",
			ИдентификаторЗапроса,
			"Ошибка",
			ТекущаяДатаСеанса(),
			"",
			"Шаг 1: Ошибка создания документа: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Структура("Результат, ЖурналОтправок",
			"Ошибка при создании документа", Журнал);
	КонецПопытки;

	// ========================================================
	// Шаг 2: Записать в РС статус "Ожидает" с префиксом [ТЕСТ]
	// ========================================================
	Попытка
		ЭАрМ_ОбработкаПодтвержденийЭДО.ЗаписатьСтатусОжидания(
			ТестовыйДокумент, ИдентификаторЗапроса,
			Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает,
			"[ТЕСТ] Тестовая отправка ЗаказПокупателя");

		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"Ожидает",
			ТекущаяДатаСеанса(),
			"[ТЕСТ]",
			"Шаг 2: Статус 'Ожидает' записан в регистр сведений");

	Исключение
		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"Ошибка",
			ТекущаяДатаСеанса(),
			"",
			"Шаг 2: Ошибка записи статуса: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Структура("Результат, ЖурналОтправок",
			"Ошибка при записи статуса Ожидает", Журнал);
	КонецПопытки;

	// ========================================================
	// Шаг 3: Проверить запись в регистре сведений (верификация)
	// ========================================================
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Статус КАК Статус,
		|	Т.Комментарий КАК Комментарий,
		|	Т.ДатаОтправки КАК ДатаОтправки
		|ИЗ
		|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
		|ГДЕ
		|	Т.ЭлектронныйДокумент = &ЭлектронныйДокумент
		|	И Т.ИдентификаторЗапроса = &ИдентификаторЗапроса";
		Запрос.УстановитьПараметр("ЭлектронныйДокумент", ТестовыйДокумент);
		Запрос.УстановитьПараметр("ИдентификаторЗапроса", ИдентификаторЗапроса);

		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			ВызватьИсключение "Запись в регистре не найдена после записи";
		КонецЕсли;

		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();

		// Проверяем статус
		Если Выборка.Статус <> Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает Тогда
			ВызватьИсключение СтрШаблон("Неожиданный статус: %1 (ожидался 'Ожидает')",
				Строка(Выборка.Статус));
		КонецЕсли;

		// Проверяем префикс [ТЕСТ] в комментарии
		Если СтрНайти(Выборка.Комментарий, "[ТЕСТ]") = 0 Тогда
			ВызватьИсключение "Префикс [ТЕСТ] не найден в комментарии";
		КонецЕсли;

		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"Проверен",
			ТекущаяДатаСеанса(),
			"[ТЕСТ]",
			СтрШаблон("Шаг 3: Регистр проверен — статус '%1', комментарий корректен",
				Строка(Выборка.Статус)));

	Исключение
		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"Ошибка",
			ТекущаяДатаСеанса(),
			"",
			"Шаг 3: Ошибка проверки регистра: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Структура("Результат, ЖурналОтправок",
			"Ошибка проверки записи в регистре", Журнал);
	КонецПопытки;

	// ========================================================
	// Шаг 4: Имитировать callback — подтверждено
	// ========================================================
	Попытка
		ЭАрМ_ОбработкаПодтвержденийЭДО.ОбработатьОтветПодтверждения(
			ИдентификаторЗапроса, Истина, "[ТЕСТ] Тестовое подтверждение ЗаказПокупателя");

		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"Подтверждено",
			ТекущаяДатаСеанса(),
			"[ТЕСТ] Подтверждение",
			"Шаг 4: Callback обработан, статус 'Подтверждено'");

	Исключение
		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"Ошибка",
			ТекущаяДатаСеанса(),
			"",
			"Шаг 4: Ошибка обработки callback: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Структура("Результат, ЖурналОтправок",
			"Ошибка при имитации callback", Журнал);
	КонецПопытки;

	// ========================================================
	// Шаг 5: Проверить итоговый статус в регистре
	// ========================================================
	Попытка
		ТекущийСтатус = ЭАрМ_ОбработкаПодтвержденийЭДО.ПолучитьТекущийСтатус(ТестовыйДокумент);

		Если ТекущийСтатус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено Тогда
			РезультатТекст = "Шаг 5: Итоговый статус = Подтверждено (корректно)";
		Иначе
			РезультатТекст = СтрШаблон("Шаг 5: Неожиданный итоговый статус: %1",
				Строка(ТекущийСтатус));
		КонецЕсли;

		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			Строка(ТекущийСтатус),
			ТекущаяДатаСеанса(),
			"[ТЕСТ]",
			РезультатТекст);

	Исключение
		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"Ошибка",
			ТекущаяДатаСеанса(),
			"",
			"Шаг 5: Ошибка проверки статуса: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Структура("Результат, ЖурналОтправок",
			"Ошибка проверки итогового статуса", Журнал);
	КонецПопытки;

	// ========================================================
	// Шаг 6: Отправить тестовый документ в папку обмена
	// ========================================================
	Попытка
		ДанныеДокумента = ЭАрМ_ОбменСДругойБазой.ПодготовитьДанныеДокумента(ТестовыйДокумент);
		ДанныеДокумента.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
		ДанныеДокумента.Вставить("ТипОтправки", "Тест");
		ДанныеДокумента.Вставить("Комментарий", "[ТЕСТ] Тестовая отправка ЗаказПокупателя");

		// Формируем JSON
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ДанныеДокумента);
		ТелоЗапроса = ЗаписьJSON.Закрыть();

		// Получаем путь к папке (по умолчанию — тестовая папка)
		ПутьКПапке = ЭАрМ_НастройкиСервер.ПолучитьНастройку("ПапкаОбмена");
		Если НЕ ЗначениеЗаполнено(ПутьКПапке) Тогда
			ПутьКПапке = "C:\Users\azhel\Desktop\АРМ_ТестЭдо\Data";
		КонецЕсли;

		// Создаем папку если не существует
		Каталог = Новый Файл(ПутьКПапке);
		Если НЕ Каталог.Существует() Тогда
			СоздатьКаталог(ПутьКПапке);
		КонецЕсли;

		// Сохраняем файл
		ИмяФайла = СтрШаблон("etrn_%1.json", ИдентификаторЗапроса);
		ПолныйПуть = ПутьКПапке + "\" + ИмяФайла;

		ЗаписьТекста = Новый ЗаписьТекста(ПолныйПуть, КодировкаТекста.UTF8);
		ЗаписьТекста.Записать(ТелоЗапроса);
		ЗаписьТекста.Закрыть();

		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ТестЗаказПокупателя.Папка",
			УровеньЖурналаРегистрации.Информация, , ТестовыйДокумент,
			СтрШаблон("Тестовый файл %1 сохранен в папку %2", ИмяФайла, ПутьКПапке));

		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"ОтправленВПапку",
			ТекущаяДатаСеанса(),
			"[ТЕСТ] Папка",
			СтрШаблон("Шаг 6: Тестовый файл %1 отправлен в папку %2",
				ИмяФайла, ПутьКПапке));

	Исключение
		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"Ошибка",
			ТекущаяДатаСеанса(),
			"",
			"Шаг 6: Ошибка отправки в папку: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Структура("Результат, ЖурналОтправок",
			"Ошибка отправки в папку обмена", Журнал);
	КонецПопытки;

	// ========================================================
	// Шаг 7: Сымитировать регламентное задание (проверка папки)
	// ========================================================
	Попытка
		ЭАрМ_ОбработкаПодтвержденийЭДО.ПроверитьПапкуОбмена();

		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"РегламентноеВыполнено",
			ТекущаяДатаСеанса(),
			"[ТЕСТ] Регламентное задание",
			"Шаг 7: Регламентное задание проверки папки выполнено");

	Исключение
		ДобавитьСтрокуЖурнала(Журнал,
			Строка(ТестовыйДокумент),
			ИдентификаторЗапроса,
			"Ошибка",
			ТекущаяДатаСеанса(),
			"",
			"Шаг 7: Ошибка регламентного задания: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// ========================================================
	// ИТОГ
	// ========================================================
	ИтоговыйРезультат = "ТЕСТ ЗАКАЗ ПОКУПАТЕЛЯ ПРОЙДЕН: "
		+ "документ создан → регистр записан → регистр проверен → "
		+ "callback обработан → статус Подтверждено → "
		+ "файл отправлен в папку → регламентное задание выполнено";

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ТестЗаказПокупателя",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("=== ИТОГ: %1 ===", ИтоговыйРезультат));

	Возврат Новый Структура("Результат, ЖурналОтправок", ИтоговыйРезультат, Журнал);

КонецФункции

// Загружает текущий журнал отправок из регистра.
//
// Возвращаемое значение:
//   Массив из Структура - строки журнала
//
Функция ЗагрузитьЖурналОтправок() Экспорт

	Журнал = Новый Массив;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.ЭлектронныйДокумент КАК Документ,
		|	Т.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
		|	Т.Статус КАК Статус,
		|	Т.ДатаОтправки КАК ДатаОтправки,
		|	Т.ДатаОтвета КАК ДатаОтвета,
		|	Т.Комментарий КАК Комментарий
		|ИЗ
		|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаОтправки УБЫВ";

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Строка = Новый Структура;
			Строка.Вставить("Документ", Строка(Выборка.Документ));
			Строка.Вставить("ИдентификаторЗапроса", Выборка.ИдентификаторЗапроса);
			Строка.Вставить("Статус", Строка(Выборка.Статус));
			Строка.Вставить("ДатаОтправки", Выборка.ДатаОтправки);
			Строка.Вставить("ДатаОтвета", Выборка.ДатаОтвета);
			Строка.Вставить("Комментарий", Выборка.Комментарий);
			Строка.Вставить("Результат", "");
			Журнал.Добавить(Строка);
		КонецЦикла;

	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'АРМ_ЭдоОбмен.ЗагрузкаЖурнала'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Журнал;

КонецФункции

// Проверяет доступность web-сервиса другой базы.
//
// Возвращаемое значение:
//   Структура - Доступен (Булево), Ошибка (Строка)
//
Функция ПроверитьПодключениеКСервису() Экспорт

	Результат = Новый Структура("Доступен, Ошибка", Ложь, "");

	Попытка
		АдресСервиса = Константы.ЭАрМ_АдресСервисаОбменаСДругойБазой.Получить();
		Если НЕ ЗначениеЗаполнено(АдресСервиса) Тогда
			Результат.Ошибка = "Адрес сервиса не задан";
			Возврат Результат;
		КонецЕсли;

		АдресWSDL = АдресСервиса + "/ws/Exchange_3_0_2_2?wsdl";
		Определения = Новый WSОпределения(АдресWSDL, "", "");
		Результат.Доступен = Истина;

	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Создает тестовый файл ответа response_*.json в папке обмена.
// Используется для имитации ответа от базы 2 при тестировании.
//
// Параметры:
//   ИдентификаторЗапроса - Строка - UUID запроса для ответа
//   Подтверждено - Булево - Истина если подтверждено, Ложь если отклонено
//   Комментарий - Строка - комментарий к ответу
//
// Возвращаемое значение:
//   Структура - Результат (Строка), ПутьКФайлу (Строка)
//
Функция СоздатьТестовыйОтвет(ИдентификаторЗапроса, Подтверждено = Истина,
	Комментарий = "[ТЕСТ] Ответ от базы 2") Экспорт

	Результат = Новый Структура("Результат, ПутьКФайлу", "", "");

	// Получаем путь к папке
	ПутьКПапке = ЭАрМ_НастройкиСервер.ПолучитьНастройку("ПапкаОбмена");
	Если НЕ ЗначениеЗаполнено(ПутьКПапке) Тогда
		ПутьКПапке = "C:\Users\azhel\Desktop\АРМ_ТестЭдо\Data";
	КонецЕсли;

	// Создаем папку если не существует
	Каталог = Новый Файл(ПутьКПапке);
	Если НЕ Каталог.Существует() Тогда
		СоздатьКаталог(ПутьКПапке);
	КонецЕсли;

	// Формируем JSON ответа
	ДанныеОтвета = Новый Структура;
	ДанныеОтвета.Вставить("requestId", ИдентификаторЗапроса);
	ДанныеОтвета.Вставить("approved", Подтверждено);
	ДанныеОтвета.Вставить("comment", Комментарий);
	ДанныеОтвета.Вставить("processedAt", ТекущаяДатаСеанса());
	ДанныеОтвета.Вставить("source", "База2_Далион");

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеОтвета);
	ТелоОтвета = ЗаписьJSON.Закрыть();

	// Сохраняем файл
	ИмяФайла = СтрШаблон("response_%1.json", ИдентификаторЗапроса);
	ПолныйПуть = ПутьКПапке + "\" + ИмяФайла;

	Попытка
		ЗаписьТекста = Новый ЗаписьТекста(ПолныйПуть, КодировкаТекста.UTF8);
		ЗаписьТекста.Записать(ТелоОтвета);
		ЗаписьТекста.Закрыть();

		ЗаписьЖурналаРегистрации("АРМ_ЭДО.СозданиеТестовогоОтвета",
			УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон("Создан тестовый ответ: %1 (approved=%2)", ИмяФайла, Подтверждено));

		Результат.Результат = СтрШаблон("Файл ответа создан: %1", ПолныйПуть);
		Результат.ПутьКФайлу = ПолныйПуть;

	Исключение
		Результат.Результат = "Ошибка: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());

		ЗаписьЖурналаРегистрации("АРМ_ЭДО.СозданиеТестовогоОтвета",
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Имитирует регламентное задание: проверяет папку обмена на наличие
// ответных файлов response_*.json от базы 2 и обрабатывает их.
//
// Возвращаемое значение:
//   Структура - Результат (Строка), ЖурналОтправок (Массив из Структура)
//
Функция ИмитироватьРегламентноеЗадание() Экспорт

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ИмитацияРеглЗадания",
		УровеньЖурналаРегистрации.Информация, , ,
		"=== СТАРТ: Имитация регламентного задания ===");

	Журнал = Новый Массив;
	КоличествоОбработано = 0;
	КоличествоОшибок = 0;

	// Получаем путь к папке (по умолчанию — тестовая папка)
	ПутьКПапке = ЭАрМ_НастройкиСервер.ПолучитьНастройку("ПапкаОбмена");
	Если НЕ ЗначениеЗаполнено(ПутьКПапке) Тогда
		ПутьКПапке = "C:\Users\azhel\Desktop\АРМ_ТестЭдо\Data";
	КонецЕсли;

	Каталог = Новый Файл(ПутьКПапке);
	Если НЕ Каталог.Существует() Тогда
		ДобавитьСтрокуЖурнала(Журнал,
			"<Папка не найдена>",
			"",
			"Пропущен",
			ТекущаяДатаСеанса(),
			"",
			СтрШаблон("Папка %1 не существует", ПутьКПапке));
		Возврат Новый Структура("Результат, ЖурналОтправок",
			"Папка обмена не найдена: " + ПутьКПапке, Журнал);
	КонецЕсли;

	// Ищем файлы ответов response_*.json
	НайденныеФайлы = НайтиФайлы(ПутьКПапке, "response_*.json");

	Если НайденныеФайлы.Количество() = 0 Тогда
		ДобавитьСтрокуЖурнала(Журнал,
			"<Нет ответов>",
			"",
			"Пропущен",
			ТекущаяДатаСеанса(),
			"",
			СтрШаблон("В папке %1 нет файлов response_*.json от базы 2", ПутьКПапке));
		Возврат Новый Структура("Результат, ЖурналОтправок",
			"Нет ответных файлов от базы 2", Журнал);
	КонецЕсли;

	Для Каждого Файл Из НайденныеФайлы Цикл

		// Тот же захват, что у регламента (ЭАрМ_РегламентныйОбменЭДО.
		// РазобратьОтветыКаталога): файл уже разбирает регламент - пропускаем,
		// иначе подтверждение применялось бы дважды
		ФайлЗахвата = ЭАрМ_РегламентныйОбменЭДО.ЗахватитьФайлОтвета(Файл);
		Если ФайлЗахвата = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			// Читаем файл ответа
			ЧтениеТекста = Новый ЧтениеТекста(ФайлЗахвата.ПолноеИмя, КодировкаТекста.UTF8);
			Содержимое = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();

			// Убираем BOM если есть
			Если Лев(Содержимое, 1) = Символ(65279) Тогда
				Содержимое = Сред(Содержимое, 2);
			КонецЕсли;

			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(СокрЛП(Содержимое));
			Данные = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();

			Если НЕ Данные.Свойство("requestId") ИЛИ НЕ Данные.Свойство("approved") Тогда
				ДобавитьСтрокуЖурнала(Журнал,
					Файл.Имя,
					"",
					"Пропущен",
					ТекущаяДатаСеанса(),
					"",
					"Файл не содержит requestId или approved");
				ОсвободитьФайлОтвета(ФайлЗахвата, Файл);
				Продолжить;
			КонецЕсли;

			// Обрабатываем ответ от базы 2
			ЭАрМ_ОбработкаПодтвержденийЭДО.ОбработатьОтветПодтверждения(
				Данные.requestId,
				Данные.approved,
				?(Данные.Свойство("comment"), Данные.comment, ""));

			// Архивируем обработанный файл
			АрхивПуть = ПутьКПапке + "\archive";
			АрхивКаталог = Новый Файл(АрхивПуть);
			Если НЕ АрхивКаталог.Существует() Тогда
				СоздатьКаталог(АрхивПуть);
			КонецЕсли;
			ПереместитьФайл(ФайлЗахвата.ПолноеИмя, АрхивПуть + "\" + Файл.Имя);

			КоличествоОбработано = КоличествоОбработано + 1;

			СтатусОтвета = ?(Данные.approved, "Подтверждено", "Отклонено");

			ДобавитьСтрокуЖурнала(Журнал,
				Данные.requestId,
				Данные.requestId,
				СтатусОтвета,
				ТекущаяДатаСеанса(),
				?(Данные.Свойство("comment"), Данные.comment, ""),
				СтрШаблон("Ответ от базы 2 обработан: %1 (файл %2)", СтатусОтвета, Файл.Имя));

			ЗаписьЖурналаРегистрации("АРМ_ЭДО.ИмитацияРеглЗадания",
				УровеньЖурналаРегистрации.Информация, , ,
				СтрШаблон("Обработан ответ: requestId=%1, approved=%2",
					Данные.requestId, Данные.approved));

		Исключение
			КоличествоОшибок = КоличествоОшибок + 1;

			ЗаписьЖурналаРегистрации("АРМ_ЭДО.ИмитацияРеглЗадания",
				УровеньЖурналаРегистрации.Ошибка, , ,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			ДобавитьСтрокуЖурнала(Журнал,
				Файл.Имя,
				"",
				"Ошибка",
				ТекущаяДатаСеанса(),
				"",
				"Ошибка обработки: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			// Как и раньше, файл остаётся в папке - захват снимается
			ОсвободитьФайлОтвета(ФайлЗахвата, Файл);
		КонецПопытки;

	КонецЦикла;

	Итог = СтрШаблон("Обработано ответов: %1, ошибок: %2 (папка: %3)",
		КоличествоОбработано, КоличествоОшибок, ПутьКПапке);

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ИмитацияРеглЗадания",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("=== ИТОГ: %1 ===", Итог));

	Возврат Новый Структура("Результат, ЖурналОтправок", Итог, Журнал);

КонецФункции

// Отправляет в папку обмена все документы из регистра, находящиеся в статусе "Ожидает".
// Используется когда документ уже создан и записан в регистр, и нужно вызвать отправку в папку.
//
// Возвращаемое значение:
//   Структура - Результат (Строка), ЖурналОтправок (Массив из Структура)
//
Функция ОтправитьОжидаемыеВПапку() Экспорт

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ОтправкаОжидавшихВПапку",
		УровеньЖурналаРегистрации.Информация, , ,
		"=== СТАРТ: Отправка ожидающих документов в папку ===");

	Журнал = Новый Массив;
	КоличествоОправлено = 0;
	КоличествоОшибок = 0;
	МассивДокументов = Новый Массив;
	ИдентификаторФайла = Строка(Новый УникальныйИдентификатор);

	// Находим все документы в статусе "Ожидает"
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Т.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
	|	Т.ДатаОтправки КАК ДатаОтправки,
	|	Т.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
	|ГДЕ
	|	Т.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает)";

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ДобавитьСтрокуЖурнала(Журнал, "<Нет документов>", "", "Пропущен", ТекущаяДатаСеанса(), "", "Нет документов в статусе 'Ожидает'");
		Возврат Новый Структура("Результат, ЖурналОтправок", "Нет документов в статусе Ожидает", Журнал);
	КонецЕсли;

	// Собираем все документы в массив
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭлектронныйДокумент = Выборка.ЭлектронныйДокумент;
		ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;

		Попытка
			Попытка
				ДанныеДокумента = ЭАрМ_ОбменСДругойБазой.ПодготовитьДанныеДокумента(ЭлектронныйДокумент);
			Исключение
				ДанныеДокумента = ПодготовитьДанныеНеЭДОДокумента(ЭлектронныйДокумент);
			КонецПопытки;
			ДанныеДокумента.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
			ДанныеДокумента.Вставить("ТипОтправки", "Тест");
			ДанныеДокумента.Вставить("Комментарий", ?(ЗначениеЗаполнено(Выборка.Комментарий), Выборка.Комментарий, "[ТЕСТ] Отправка в папку"));
			МассивДокументов.Добавить(ДанныеДокумента);
			КоличествоОправлено = КоличествоОправлено + 1;
		Исключение
			КоличествоОшибок = КоличествоОшибок + 1;
			ДобавитьСтрокуЖурнала(Журнал, Строка(ЭлектронныйДокумент), ИдентификаторЗапроса, "Ошибка", ТекущаяДатаСеанса(), "", "Ошибка: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	// Формируем JSON-массив
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивДокументов);
	ТелоЗапроса = ЗаписьJSON.Закрыть();

	// Получаем путь к папке
	ПутьКПапке = ЭАрМ_НастройкиСервер.ПолучитьНастройку("ПапкаОбмена");
	Если НЕ ЗначениеЗаполнено(ПутьКПапке) Тогда
		ПутьКПапке = "C:\Users\azhel\Desktop\АРМ_ТестЭдо\Data";
	КонецЕсли;

	Каталог = Новый Файл(ПутьКПапке);
	Если НЕ Каталог.Существует() Тогда
		СоздатьКаталог(ПутьКПапке);
	КонецЕсли;

	// Сохраняем файл с именем etrn_{UUID}.json
	ИмяФайла = СтрШаблон("etrn_%1.json", ИдентификаторФайла);
	ПолныйПуть = ПутьКПапке + "\" + ИмяФайла;

	ЗаписьТекста = Новый ЗаписьТекста(ПолныйПуть, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(ТелоЗапроса);
	ЗаписьТекста.Закрыть();

	ДобавитьСтрокуЖурнала(Журнал, "Всего: " + КоличествоОправлено, ИдентификаторФайла, "ОтправленВПапку", ТекущаяДатаСеанса(), "[ТЕСТ]", СтрШаблон("Файл %1 (%2 док.) в папку %3", ИмяФайла, КоличествоОправлено, ПутьКПапке));

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ОтправкаОжидавшихВПапку", УровеньЖурналаРегистрации.Информация, , , СтрШаблон("=== ИТОГ: отправлено %1, ошибок %2 ===", КоличествоОправлено, КоличествоОшибок));

	Возврат Новый Структура("Результат, ЖурналОтправок", СтрШаблон("Отправлено: %1, ошибок: %2", КоличествоОправлено, КоличествоОшибок), Журнал);

КонецФункции

// Читает JSON-файл и возвращает ТаблицаЗначений.
// Параметры:
//   ПутьКФайлу - Строка - полный путь к JSON-файлу
// Возвращаемое значение:
//   Структура - Таблица (ТаблицаЗначений), КоличествоСтрок (Число), Ошибка (Строка)
//
Функция ПрочитатьФайлВТаблицуЗначений(ПутьКФайлу) Экспорт

	Результат = Новый Структура("Таблица, КоличествоСтрок, Ошибка", Неопределено, 0, "");

	Попытка
		Файл = Новый Файл(ПутьКФайлу);
		Если НЕ Файл.Существует() Тогда
			Результат.Ошибка = СтрШаблон("Файл не найден: %1", ПутьКФайлу);
			Возврат Результат;
		КонецЕсли;

		ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
		Содержимое = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Содержимое);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		// Если данные — массив, берём первый элемент
		ДокументДляОбработки = ?(ТипЗнч(Данные) = Тип("Массив"), Данные[0], Данные);

		// Формируем таблицу значений
		Таблица = Новый ТаблицаЗначений;
		ТабличныеЧастиДанных = Неопределено;

		// Добавляем колонки из реквизитов шапки
		Для Каждого КлючЗначение Из ДокументДляОбработки Цикл
			Если КлючЗначение.Ключ = "ТабличныеЧасти" Тогда
				ТабличныеЧастиДанных = КлючЗначение.Значение;
				Продолжить;
			КонецЕсли;
			ТипЗначения = ТипЗнч(КлючЗначение.Значение);
			Таблица.Колонки.Добавить(КлючЗначение.Ключ, Новый ОписаниеТипов(Новый Массив(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗначения))));
		КонецЦикла;

		// Добавляем строку шапки
		НоваяСтрока = Таблица.Добавить();
		Для Каждого КлючЗначение Из ДокументДляОбработки Цикл
			Если КлючЗначение.Ключ = "ТабличныеЧасти" Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЦикла;

		// Если есть табличные части — добавляем их как отдельные таблицы
		Если ТабличныеЧастиДанных <> Неопределено Тогда
			Для Каждого КлючТЧ Из ТабличныеЧастиДанных Цикл
				ИмяТЧ = КлючТЧ.Ключ;
				СтрокиТЧ = КлючТЧ.Значение;

				Если ТипЗнч(СтрокиТЧ) = Тип("Массив") И СтрокиТЧ.Количество() > 0 Тогда
					Для Каждого Колонка Из СтрокиТЧ[0] Цикл
						Таблица.Колонки.Добавить(ИмяТЧ + "_" + Колонка.Ключ);
					КонецЦикла;

					// Заполняем данные ТЧ в первые строки
					Для Сч = 0 По СтрокиТЧ.ВГраница() Цикл
						Если Сч >= Таблица.Количество() Тогда
							Таблица.Добавить();
						КонецЕсли;
						Для Каждого Колонка Из СтрокиТЧ[Сч] Цикл
							Таблица[Сч][ИмяТЧ + "_" + Колонка.Ключ] = Колонка.Значение;
						КонецЦикла;
				КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Результат.Таблица = Таблица;
		Результат.КоличествоСтрок = Таблица.Количество();

	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Имитирует событие изменения статуса: создаёт response-файл и меняет статус в регистре.
// Возвращаемое значение:
//   Структура - Результат (Строка), ЖурналОтправок (Массив)
//
Функция ИмитироватьСобытиеИзмененияСтатуса() Экспорт

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ИмитацияСобытияСтатуса", УровеньЖурналаРегистрации.Информация, , , "=== СТАРТ: Имитация события изменения статуса ===");

	Журнал = Новый Массив;
	КоличествоОбработано = 0;

	// Находим все документы в статусе "Ожидает"
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|Т.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|Т.ИдентификаторЗапроса КАК ИдентификаторЗапроса
	|ИЗ
	|РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
	|ГДЕ
	|Т.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает)";

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ДобавитьСтрокуЖурнала(Журнал, "<Нет документов>", "", "Пропущен", ТекущаяДатаСеанса(), "", "Нет документов в статусе 'Ожидает'");
		Возврат Новый Структура("Результат, ЖурналОтправок", "Нет документов для обработки", Журнал);
	КонецЕсли;

	// Получаем путь к папке
	ПутьКПапке = ЭАрМ_НастройкиСервер.ПолучитьНастройку("ПапкаОбмена");
	Если НЕ ЗначениеЗаполнено(ПутьКПапке) Тогда
		ПутьКПапке = "C:\Users\azhel\Desktop\АРМ_ТестЭдо\Data";
	КонецЕсли;

	Каталог = Новый Файл(ПутьКПапке);
	Если НЕ Каталог.Существует() Тогда
		СоздатьКаталог(ПутьКПапке);
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл

		ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;

		Попытка
			// Создаём response-файл
			ДанныеОтвета = Новый Структура;
			ДанныеОтвета.Вставить("requestId", ИдентификаторЗапроса);
			ДанныеОтвета.Вставить("approved", Истина);
			ДанныеОтвета.Вставить("comment", "[ТЕСТ] Обработано базой 2");
			ДанныеОтвета.Вставить("processedAt", ТекущаяДатаСеанса());
			ДанныеОтвета.Вставить("source", "База2_Далион");

			ЗаписьJSON = Новый ЗаписьJSON;
			ЗаписьJSON.УстановитьСтроку();
			ЗаписатьJSON(ЗаписьJSON, ДанныеОтвета);
			ТелоОтвета = ЗаписьJSON.Закрыть();

			ИмяФайла = СтрШаблон("response_%1.json", ИдентификаторЗапроса);
			ПолныйПуть = ПутьКПапке + "\" + ИмяФайла;

			ЗаписьТекста = Новый ЗаписьТекста(ПолныйПуть, КодировкаТекста.UTF8);
			ЗаписьТекста.Записать(ТелоОтвета);
			ЗаписьТекста.Закрыть();

			// Обрабатываем ответ — меняем статус
			ЭАрМ_ОбработкаПодтвержденийЭДО.ОбработатьОтветПодтверждения(ИдентификаторЗапроса, Истина, "[ТЕСТ] Статус изменён");

			КоличествоОбработано = КоличествоОбработано + 1;

			ДобавитьСтрокуЖурнала(Журнал, Строка(Выборка.ЭлектронныйДокумент), ИдентификаторЗапроса, "Подтверждено", ТекущаяДатаСеанса(), "[ТЕСТ]", СтрШаблон("Статус изменён, response создан: %1", ИмяФайла));

		Исключение
			ДобавитьСтрокуЖурнала(Журнал, "", ИдентификаторЗапроса, "Ошибка", ТекущаяДатаСеанса(), "", "Ошибка: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Итог = СтрШаблон("Обработано: %1", КоличествоОбработано);
	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ИмитацияСобытияСтатуса", УровеньЖурналаРегистрации.Информация, , , СтрШаблон("=== ИТОГ: %1 ===", Итог));

	Возврат Новый Структура("Результат, ЖурналОтправок", Итог, Журнал);

КонецФункции

// Очищает регистры сведений расширения и файлы в папках обмена - сброс
// состояния перед новым прогоном обмена.
//
// Папки обмена чистит именно эта база: она их и наполняет. АРМ_ТестЭдо по
// команде сбрасывает только свои регистры, иначе обе базы удаляли бы файлы
// друг у друга и вычищали команду до того, как её прочитают.
//
// Регистр СостоянияПоОбъектамУчетаЭДО сюда не входит: он заимствован из
// основной конфигурации и хранит рабочие состояния ЭДО всей базы. Его очистка
// была бы потерей данных базы, а не сбросом обмена.
//
// Параметры:
//   ВключаяНастройки - Булево - очищать ли ЭАрМ_НастройкиЭДО. По умолчанию
//     настройки остаются: без адреса сервиса и ключей следующий прогон
//     обмена не поедет, а восстанавливать их придётся руками.
//
// Возвращаемое значение:
//   Структура:
//     * Результат      - Строка - отчёт для показа пользователю
//     * Очищено        - Число  - сколько регистров очищено
//     * Записей        - Число  - сколько записей удалено всего
//     * ФайловУдалено  - Число  - сколько файлов удалено в папках обмена
//     * Ошибки         - Массив из Строка
//
Функция ОчиститьРегистрыЭДО(ВключаяНастройки = Ложь) Экспорт

	Итоги = Новый Структура("Результат, Очищено, Записей, ФайловУдалено, Ошибки",
		"", 0, 0, 0, Новый Массив);
	СтрокиОтчета = Новый Массив;

	Для Каждого ИмяРегистра Из РегистрыДляОчистки(ВключаяНастройки) Цикл

		Попытка
			//@skip-check query-in-loop
			УдаленоЗаписей = ОчиститьРегистрСведений(ИмяРегистра);
			Итоги.Очищено = Итоги.Очищено + 1;
			Итоги.Записей = Итоги.Записей + УдаленоЗаписей;
			СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = '%1: удалено %2'"),
				ИмяРегистра, УдаленоЗаписей));
		Исключение
			ТекстОшибки = СтрШаблон("%1: %2", ИмяРегистра,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Итоги.Ошибки.Добавить(ТекстОшибки);
			СтрокиОтчета.Добавить(ТекстОшибки);
		КонецПопытки;

	КонецЦикла;

	Попытка
		Итоги.ФайловУдалено = УдалитьФайлыПапокОбмена(Итоги.Ошибки);
		СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Удалено файлов в папках обмена: %1'"),
			Итоги.ФайловУдалено));
	Исключение
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Удаление файлов: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Итоги.Ошибки.Добавить(ТекстОшибки);
		СтрокиОтчета.Добавить(ТекстОшибки);
	КонецПопытки;

	СтрокиОтчета.Вставить(0, СтрШаблон(
		НСтр("ru = 'Очищено регистров: %1, удалено записей: %2'"),
		Итоги.Очищено, Итоги.Записей));

	// Команду пишем последней: чистка папок выше стёрла бы её вместе
	// с остальными файлами обмена
	ОтправитьКомандуОчистки(СтрокиОтчета, Итоги.Ошибки);

	Итоги.Результат = СтрСоединить(СтрокиОтчета, Символы.ПС);

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ОчисткаРегистров",
		?(Итоги.Ошибки.Количество() = 0,
			УровеньЖурналаРегистрации.Информация,
			УровеньЖурналаРегистрации.Ошибка),
		, , Итоги.Результат);

	Возврат Итоги;

КонецФункции


// Удаляет старые записи технических регистров: журнал обмена, лог запросов
// и обработанные пакеты Далион. Реестры документов, товары, цепочку закупки
// и настройки не трогает - для полного сброса есть ОчиститьРегистрыЭДО.
//
// Параметры:
//   ГлубинаДней - Число - сколько дней технической информации хранить
//
// Возвращаемое значение:
//   Структура:
//     * Результат - Строка - отчёт для показа пользователю
//     * Очищено   - Число  - сколько регистров очищено
//     * Записей   - Число  - сколько записей удалено всего
//     * Ошибки    - Массив из Строка
//
Функция ОчиститьТехническуюИнформацию(ГлубинаДней = 30) Экспорт

	ГлубинаДней = Макс(1, ГлубинаДней);
	ДатаОчистки = ТекущаяДатаСеанса() - ГлубинаДней * 86400;

	Итоги = Новый Структура("Результат, Очищено, Записей, Ошибки",
		"", 0, 0, Новый Массив);
	СтрокиОтчета = Новый Массив;

	Для Каждого Описание Из ТехническиеРегистры() Цикл

		Попытка
			УдаленоЗаписей = ОчиститьТехническийРегистр(Описание, ДатаОчистки);
			Итоги.Очищено = Итоги.Очищено + 1;
			Итоги.Записей = Итоги.Записей + УдаленоЗаписей;
			СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = '%1: удалено %2'"),
				Описание.Представление, УдаленоЗаписей));
		Исключение
			ТекстОшибки = СтрШаблон("%1: %2", Описание.Представление,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Итоги.Ошибки.Добавить(ТекстОшибки);
			СтрокиОтчета.Добавить(ТекстОшибки);
		КонецПопытки;

	КонецЦикла;

	СтрокиОтчета.Вставить(0, СтрШаблон(
		НСтр("ru = 'Техническая информация старше %1 дн.: удалено записей %2'"),
		ГлубинаДней, Итоги.Записей));

	Итоги.Результат = СтрСоединить(СтрокиОтчета, Символы.ПС);

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ОчисткаТехническойИнформации",
		?(Итоги.Ошибки.Количество() = 0,
			УровеньЖурналаРегистрации.Информация,
			УровеньЖурналаРегистрации.Ошибка),
		, , Итоги.Результат);

	Возврат Итоги;

КонецФункции


// Сколько записей журнала обмена ЭДО (ЭАрМ_ЖурналОбменаЭДО) попадает в период
// очистки - для вопроса перед ОчиститьЖурналОбмена (страница «Админка» формы
// настроек ЭДО).
//
// Параметры:
//   НачалоПериода - Дата - с какого дня удалять; пустая - с самой первой записи
//   КонецПериода  - Дата - по какой день удалять включительно; обязательна
//
// Возвращаемое значение:
//   Структура:
//     * Количество - Число  - сколько записей в периоде
//     * Период     - Строка - период словами для вопроса и итога
//     * Ошибка     - Строка - почему период не годится; пусто - годится
//
Функция ЗаписиЖурналаОбменаЗаПериод(Знач НачалоПериода, Знач КонецПериода) Экспорт

	Итог = Новый Структура("Количество, Период, Ошибка", 0, "", "");
	Итог.Ошибка = ОшибкаПериодаОчисткиЖурнала(НачалоПериода, КонецПериода);
	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Возврат Итог;
	КонецЕсли;

	Итог.Период = ПредставлениеПериодаОчисткиЖурнала(НачалоПериода, КонецПериода);

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Всего
		|ИЗ
		|	РегистрСведений.ЭАрМ_ЖурналОбменаЭДО КАК Журнал
		|ГДЕ
		|	Журнал.Период МЕЖДУ &НачалоПериода И &КонецПериода");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));

	Выборка = Запрос.Выполнить().Выбрать();
	Итог.Количество = ?(Выборка.Следующий(), Выборка.Всего, 0);

	Возврат Итог;

КонецФункции

// Удаляет записи журнала обмена ЭДО за период - страница «Админка» формы
// настроек, после вопроса с числом записей (см. ЗаписиЖурналаОбменаЗаПериод).
//
// Удаляет порциями по ПорцияОчисткиЖурнала() записей, каждую - своей
// транзакцией: большой журнал не держит одну длинную транзакцию, а ошибка
// откатывает только свою порцию; удалённые до неё порции остаются удалёнными.
// Начало, итог и ошибки - в журнал регистрации («АРМ_ЭДО.ОчисткаЖурналаОбмена»).
//
// Параметры:
//   НачалоПериода - Дата - с какого дня удалять; пустая - с самой первой записи
//   КонецПериода  - Дата - по какой день удалять включительно; обязательна
//   Подтверждено  - Булево - Истина только после ответа «Да» в форме; без неё
//                   ничего не удаляется
//
// Возвращаемое значение:
//   Структура:
//     * Результат - Строка - итог для показа пользователю
//     * Удалено   - Число  - сколько записей удалено
//     * Ошибки    - Массив из Строка
//
Функция ОчиститьЖурналОбмена(Знач НачалоПериода, Знач КонецПериода, Знач Подтверждено = Ложь) Экспорт

	Итоги = Новый Структура("Результат, Удалено, Ошибки", "", 0, Новый Массив);

	Если Подтверждено <> Истина Тогда
		Итоги.Результат = НСтр("ru = 'Журнал обмена ЭДО не очищен: удаление не подтверждено.'");
		Возврат Итоги;
	КонецЕсли;

	ТекстОшибки = ОшибкаПериодаОчисткиЖурнала(НачалоПериода, КонецПериода);
	Если Не ЗначениеЗаполнено(ТекстОшибки)
		И Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ЭАрМ_ЖурналОбменаЭДО) Тогда
		ТекстОшибки = НСтр("ru = 'нет права изменять журнал обмена ЭДО.'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Итоги.Ошибки.Добавить(ТекстОшибки);
		Итоги.Результат = НСтр("ru = 'Журнал обмена ЭДО не очищен: '") + ТекстОшибки;
		Возврат Итоги;
	КонецЕсли;

	ПериодСловами = ПредставлениеПериодаОчисткиЖурнала(НачалоПериода, КонецПериода);
	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ОчисткаЖурналаОбмена", УровеньЖурналаРегистрации.Информация,
		Метаданные.РегистрыСведений.ЭАрМ_ЖурналОбменаЭДО, ,
		СтрШаблон(НСтр("ru = 'Начата очистка журнала обмена ЭДО %1, порциями по %2'"),
			ПериодСловами, ПорцияОчисткиЖурнала()));

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Журнал.Период КАК Период,
		|	Журнал.ИдентификаторСБИС КАК ИдентификаторСБИС,
		|	Журнал.Операция КАК Операция
		|ИЗ
		|	РегистрСведений.ЭАрМ_ЖурналОбменаЭДО КАК Журнал
		|ГДЕ
		|	Журнал.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));

	// Ключи выбираются один раз и режутся на порции: повторный запрос «первых N»
	// после неудачной порции выбирал бы её же снова
	Выборка = Запрос.Выполнить().Выбрать();
	Порция = Новый Массив;
	РазмерПорции = ПорцияОчисткиЖурнала();

	Пока Выборка.Следующий() Цикл

		Порция.Добавить(Новый Структура("Период, ИдентификаторСБИС, Операция",
			Выборка.Период, Выборка.ИдентификаторСБИС, Выборка.Операция));

		Если Порция.Количество() >= РазмерПорции Тогда
			Если Не УдалитьПорциюЖурналаОбмена(Порция, Итоги) Тогда
				Прервать;
			КонецЕсли;
			Порция.Очистить();
		КонецЕсли;

	КонецЦикла;

	Если Порция.Количество() > 0 И Итоги.Ошибки.Количество() = 0 Тогда
		УдалитьПорциюЖурналаОбмена(Порция, Итоги);
	КонецЕсли;

	Итоги.Результат = СтрШаблон(НСтр("ru = 'Журнал обмена ЭДО %1: удалено записей - %2.'"),
		ПериодСловами, Итоги.Удалено);
	Если Итоги.Ошибки.Количество() > 0 Тогда
		Итоги.Результат = Итоги.Результат + Символы.ПС
			+ НСтр("ru = 'Очистка остановлена на ошибке, порция с ошибкой откачена:'") + Символы.ПС
			+ СтрСоединить(Итоги.Ошибки, Символы.ПС);
	КонецЕсли;

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ОчисткаЖурналаОбмена",
		?(Итоги.Ошибки.Количество() = 0,
			УровеньЖурналаРегистрации.Информация,
			УровеньЖурналаРегистрации.Ошибка),
		Метаданные.РегистрыСведений.ЭАрМ_ЖурналОбменаЭДО, , Итоги.Результат);

	Возврат Итоги;

КонецФункции

// Подписанты из настроек ЭДО для выбора на клиенте перед подписанием.
//
// Возвращаемое значение:
//   Массив из Структура - см. ЭАрМ_НастройкиСервер.ПодписантыСБИС
//
Функция ПодписантыСБИС() Экспорт

	Возврат ЭАрМ_НастройкиСервер.ПодписантыСБИС();

КонецФункции

// Подписанты из настроек ЭДО с отпечатком в Base64 - для поиска сертификата
// на клиенте (см. ЭАрМ_ПанельУправленияЭДОКлиент.ПоказатьПодписантовИСертификаты).
//
// Возвращаемое значение:
//   Массив из Структура - Номер, Отпечаток, ФИО, ИНН, Должность,
//     Представление, ОтпечатокBase64
//
Функция ПодписантыДляПросмотра() Экспорт

	Подписанты = ЭАрМ_НастройкиСервер.ПодписантыСБИС();
	Для Каждого Подписант Из Подписанты Цикл
		Подписант.Вставить("ОтпечатокBase64", ?(ЗначениеЗаполнено(Подписант.Отпечаток),
			ЭАрМ_УтверждениеСБИС.ОтпечатокВBase64(Подписант.Отпечаток), ""));
	КонецЦикла;

	Возврат Подписанты;

КонецФункции

// --- Подписант рабочего места ---
//
// Выбирается в форме «Ожидают отправки» и хранится в общих настройках
// пользователя по имени компьютера: с этого рабочего места дальше подписывает
// он, без вопроса «Кто подписывает?» (см. ЭАрМ_ПанельУправленияЭДОКлиент.ВыбратьПодписанта).

// Номер подписанта рабочего места; 0 - не выбран.
//
Функция ПодписантРабочегоМеста(ИмяКомпьютера) Экспорт

	Попытка
		Номер = ХранилищеОбщихНастроек.Загрузить("ЭАрМ_ПодписантРабочегоМеста", ИмяКомпьютера);
	Исключение
		Номер = 0;
	КонецПопытки;

	Если ТипЗнч(Номер) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;

	// Подписанта могли убрать из настроек - тогда он не выбран
	Для Каждого Подписант Из ЭАрМ_НастройкиСервер.ПодписантыСБИС() Цикл
		Если Подписант.Номер = Номер Тогда
			Возврат Номер;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

// Подписант без вопроса: выбранный на рабочем месте, иначе подписант по
// умолчанию из настроек ЭДО; 0 - спрашивать.
//
Функция ПодписантБезВопроса(ИмяКомпьютера) Экспорт

	Номер = ПодписантРабочегоМеста(ИмяКомпьютера);
	Если Номер > 0 Тогда
		Возврат Номер;
	КонецЕсли;

	ПоУмолчанию = ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПодписантПоУмолчанию");
	Если ТипЗнч(ПоУмолчанию) <> Тип("Число") ИЛИ ПоУмолчанию <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	Для Каждого Подписант Из ЭАрМ_НастройкиСервер.ПодписантыСБИС() Цикл
		Если Подписант.Номер = ПоУмолчанию Тогда
			Возврат ПоУмолчанию;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

// Запоминает подписанта рабочего места; 0 - снова спрашивать при подписании.
//
Процедура СохранитьПодписантаРабочегоМеста(ИмяКомпьютера, Номер) Экспорт

	ХранилищеОбщихНастроек.Сохранить("ЭАрМ_ПодписантРабочегоМеста", ИмяКомпьютера,
		?(ТипЗнч(Номер) = Тип("Число"), Номер, 0));

КонецПроцедуры

// --- Автоотправка в СБИС (см. ЭАрМ_ПанельУправленияЭДОКлиент.ЗапуститьАвтоПачку) ---

// --- Отправка очереди с сервера (шапка формы «Ожидают отправки») ---

// Состояние для шапки формы очереди.
//
// Возвращаемое значение:
//   Структура - Подписант (Число), Подписанты (Массив из Структура Номер,
//               Представление), Счетчики (см. ЭАрМ_ОбработкаПодтвержденийЭДО.СчетчикиОчереди;
//               Неопределено - не посчитались), НаСервере (Булево),
//               Пояснение (Строка; пустая - подпись на сервере не проверялась)
//
// Параметры:
//   ПроверитьПодписьНаСервере - Булево - проверять ключ и криптопровайдер на
//     сервере. Проверка создаёт менеджер криптографии и долгая, поэтому форма
//     очереди делает её при открытии и при смене настроек подписи, а не на
//     каждом обновлении списка
//
Функция СостояниеОтправкиОчереди(ПроверитьПодписьНаСервере = Истина) Экспорт

	Результат = Новый Структура("Подписант, Подписанты, Счетчики, НаСервере, Пояснение, Интервал, Идёт, Место, Норма",
		ЭАрМ_ОбработкаПодтвержденийЭДО.ПодписантОтправкиОчереди(), Новый Массив, Неопределено, Ложь, "",
		ЭАрМ_ОбработкаПодтвержденийЭДО.ИнтервалОтправкиОчереди(), Ложь,
		ЭАрМ_ОбработкаПодтвержденийЭДО.МестоПодписиОчереди(), Ложь);

	// Новая база: у задания отправки ещё нет расписания - ставим интервал
	// из настройки (по умолчанию 5 минут)
	Если ПроверитьПодписьНаСервере Тогда
		Попытка
			ЭАрМ_ОбработкаПодтвержденийЭДО.ПроверитьРасписаниеОтправкиОчереди();
		Исключение
			ЭАрМ_Служебный.ЗаписатьОшибку("ПроверитьРасписаниеОтправкиОчереди",
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Результат.Идёт = ОтправкаОчередиИдёт();

	Для Каждого Подписант Из ЭАрМ_НастройкиСервер.ПодписантыСБИС() Цикл
		Результат.Подписанты.Добавить(Новый Структура("Номер, Представление",
			Подписант.Номер, Подписант.Представление));
	КонецЦикла;

	Попытка
		Результат.Счетчики = ЭАрМ_ОбработкаПодтвержденийЭДО.СчетчикиОчереди();
	Исключение
		Результат.Счетчики = Неопределено;
	КонецПопытки;

	ТекстОшибки = "";
	Если ПроверитьПодписьНаСервере Тогда
		Попытка
			Результат.НаСервере = ЭАрМ_ОбработкаПодтвержденийЭДО.ОтправкаОчередиНаСервереНастроена(ТекстОшибки);
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	// Норма - зелёная надпись: выбранный способ подписи работает
	Если НЕ АвтоотправкаВключена() Тогда
		Результат.Норма = Ложь;
		Результат.Пояснение = НСтр("ru = 'Автоотправка выключена: очередь отправляют кнопками'");
	ИначеЕсли Результат.Место = "Клиент" Тогда
		Результат.Норма = Истина;
		Результат.Пояснение = СтрШаблон(
			НСтр("ru = 'Подпись на клиенте: подписывает открытая форма очереди или реестра УПД ключом своего компьютера. Сервер каждые %1 мин сверяет цепочки и ставит готовые в очередь'"),
			Результат.Интервал);
	ИначеЕсли НЕ ПроверитьПодписьНаСервере Тогда
		// Подпись на сервере не проверяли - надпись в форме остаётся прежней
		Результат.Пояснение = "";
	ИначеЕсли Результат.НаСервере Тогда
		Результат.Норма = Истина;
		Результат.Пояснение = СтрШаблон(
			НСтр("ru = 'Подпись на сервере: отправка сразу после попадания в очередь и каждые %1 мин, формы открывать не нужно'"),
			Результат.Интервал);
	Иначе
		Результат.Норма = Ложь;
		Результат.Пояснение = НСтр("ru = 'Выбрана подпись на сервере, но сервер подписать не может - отправка стоит: '")
			+ ТекстОшибки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Подписант, от имени которого очередь уходит в СБИС (общая настройка).
//
Процедура СохранитьПодписантаОтправкиОчереди(Номер) Экспорт

	ЭАрМ_НастройкиСервер.СохранитьНастройку("ПодписантОтправкиОчереди",
		?(Номер = 2, "2", "1"));

КонецПроцедуры

// Пароль контейнера ключа подписанта для подписи на сервере - в безопасное
// хранилище. Только для полноправного пользователя.
//
Процедура ЗаписатьПарольКлючаНаСервере(Номер, Пароль) Экспорт

	Если НЕ Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Пароль ключа на сервере может записать только администратор'");
	КонецЕсли;

	ЭАрМ_УтверждениеСБИС.ЗаписатьПарольКлючаНаСервере(?(Номер = 2, 2, 1), Пароль);

КонецПроцедуры

// Отправить очередь сейчас (фоном, с сервера).
//
Процедура ЗапуститьОтправкуОчереди() Экспорт

	ЭАрМ_ОбработкаПодтвержденийЭДО.ЗапуститьОтправкуОчередиВФоне();

КонецПроцедуры

// Идёт ли отправка очереди - индикатор загрузки в шапке формы очереди.
//
Функция ОтправкаОчередиИдёт() Экспорт

	Попытка
		Возврат ЭАрМ_ОбработкаПодтвержденийЭДО.ОтправкаОчередиИдёт();
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Индикатор отправки в шапке формы очереди - см.
// ЭАрМ_ОбработкаПодтвержденийЭДО.СостояниеИндикатораОтправки. Не падает:
// индикатор не должен ломать форму.
//
Функция СостояниеИндикатораОтправки() Экспорт

	Попытка
		Возврат ЭАрМ_ОбработкаПодтвержденийЭДО.СостояниеИндикатораОтправки();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Где подписывать очередь: "Сервер" или "Клиент" (общая настройка).
//
Процедура СохранитьМестоПодписиОчереди(Место) Экспорт

	ЭАрМ_ОбработкаПодтвержденийЭДО.УстановитьМестоПодписиОчереди(Место);

КонецПроцедуры

// Интервал регламентной отправки очереди, минут - сразу в расписание задания.
//
Процедура УстановитьИнтервалОтправкиОчереди(Минуты) Экспорт

	ЭАрМ_ОбработкаПодтвержденийЭДО.УстановитьИнтервалОтправкиОчереди(Минуты);

КонецПроцедуры

// Включена ли автоотправка (настройка АвтоотправкаУПД).
//
Функция АвтоотправкаВключена() Экспорт

	Возврат ЭАрМ_НастройкиСервер.ЗначениеНастройки("АвтоотправкаУПД") = Истина;

КонецФункции

// Истина только на компьютере, где включили флажок. Остальные открытые
// формы очередь не подписывают и криптографию не создают.
//
Функция АвтоотправкаЭтогоКомпьютера(ИмяКомпьютера) Экспорт

	Если НЕ АвтоотправкаВключена() Тогда
		Возврат Ложь;
	КонецЕсли;

	Хозяин = АвтоотправкаКомпьютер();

	Возврат ЗначениеЗаполнено(Хозяин)
		И ВРег(Хозяин) = ВРег(СокрЛП(Строка(ИмяКомпьютера)));

КонецФункции

// Компьютер, который подписывает автоотправкой (где включили флажок); пусто - не задан.
//
Функция АвтоотправкаКомпьютер() Экспорт

	Возврат СокрЛП(Строка(ЭАрМ_НастройкиСервер.ЗначениеНастройки("Автоотправка_Компьютер")));

КонецФункции

// Подсказка флажка «Автоотправка» в формах: кто подписывает.
//
// Параметры:
//   ИмяКомпьютера - Строка - компьютер формы (ИмяКомпьютера() с клиента)
//
Функция ПодсказкаАвтоотправки(ИмяКомпьютера) Экспорт

	Если НЕ АвтоотправкаВключена() Тогда
		Возврат НСтр("ru = 'Автоотправка выключена'");
	КонецЕсли;
	Хозяин = АвтоотправкаКомпьютер();
	Если НЕ ЗначениеЗаполнено(Хозяин) Тогда
		Возврат НСтр("ru = 'Автоотправка включена, но компьютер, который подписывает, не задан - снимите и поставьте флажок на нужном компьютере'");
	ИначеЕсли ВРег(Хозяин) = ВРег(СокрЛП(Строка(ИмяКомпьютера))) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Автоотправка включена: подписывает этот компьютер (%1)'"), Хозяин);
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Автоотправка включена: подписывает компьютер %1, этот (%2) не подписывает'"),
		Хозяин, СокрЛП(Строка(ИмяКомпьютера)));

КонецФункции

// Флажок «Автоотправка» формы очереди и реестра УПД - одна настройка.
// Сразу же - функциональная опция ЭАрМ_ОчередьОтправкиСБИС и задание отправки.
// Имя компьютера запоминается: подписывает только этот компьютер.
// Каждое изменение флажка - в журнал обмена (операция «АвтоотправкаУПД»): кто,
// с какого компьютера и откуда, - чтобы было видно, кто снял галочку.
//
// Параметры:
//   Включена      - Булево
//   ИмяКомпьютера - Строка - компьютер, который будет подписывать (ИмяКомпьютера() с клиента)
//   Откуда        - Строка - форма / действие для журнала
//
Процедура УстановитьАвтоотправку(Включена, ИмяКомпьютера = "", Откуда = "") Экспорт

	БылаВключена = АвтоотправкаВключена();
	БылХозяин = АвтоотправкаКомпьютер();

	ЭАрМ_НастройкиСервер.СохранитьНастройку("АвтоотправкаУПД", Включена = Истина);
	Если Включена = Истина И ЗначениеЗаполнено(ИмяКомпьютера) Тогда
		ЭАрМ_НастройкиСервер.СохранитьНастройку("Автоотправка_Компьютер", СокрЛП(ИмяКомпьютера));
	ИначеЕсли Включена <> Истина Тогда
		ЭАрМ_НастройкиСервер.СохранитьНастройку("Автоотправка_Компьютер", "");
	КонецЕсли;

	Если БылаВключена <> (Включена = Истина) ИЛИ Включена = Истина И ЗначениеЗаполнено(ИмяКомпьютера)
		И ВРег(БылХозяин) <> ВРег(СокрЛП(ИмяКомпьютера)) Тогда
		Попытка
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "АвтоотправкаУПД", Истина, СтрШаблон(
				НСтр("ru = 'Автоотправка %1: пользователь %2, компьютер %3, откуда: %4 (было: %5, подписывал %6)'"),
				?(Включена = Истина, НСтр("ru = 'включена'"), НСтр("ru = 'ВЫКЛЮЧЕНА'")),
				Строка(ПользователиИнформационнойБазы.ТекущийПользователь()),
				?(ЗначениеЗаполнено(ИмяКомпьютера), СокрЛП(ИмяКомпьютера), НСтр("ru = 'не передан'")),
				?(ЗначениеЗаполнено(Откуда), Откуда, НСтр("ru = 'не указано'")),
				?(БылаВключена, НСтр("ru = 'включена'"), НСтр("ru = 'выключена'")),
				?(ЗначениеЗаполнено(БылХозяин), БылХозяин, "-")));
		Исключение
			ЭАрМ_Служебный.ЗаписатьОшибку("УстановитьАвтоотправку (журнал)",
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Попытка
		ЭАрМ_ОбработкаПодтвержденийЭДО.ПроверитьРасписаниеОтправкиОчереди();
	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("ПроверитьРасписаниеОтправкиОчереди",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// --- Очистка логов (страница «Админка» формы настроек) ---
//
// Логи АРМ ЭДО: регистр «Трасса приёма» (ЭАрМ_ТрассаПриема) и текстовые файлы -
// ТрассаПриема_*.log (логи сеансов и архивы трассы) в папке пакетов Далиона,
// СБИС\СБИС_Запросы_*.jsonl, выгрузки логов error\Логи_/Ошибки_/Расхождения_*.txt,
// замеры zamery_*.csv. Удаляется то, что старше заданного числа дней (файлы - по
// времени изменения). Сам ТрассаПриема.log пишется постоянно: больше 50 МБ - он
// переименовывается в архив ТрассаПриема_<дата>.log и удалится, когда устареет.
// Журнал обмена ЭДО чистится отдельно (группа «Очистка журнала обмена ЭДО»).

// Сколько удалит очистка логов старше Дней дней.
//
// Возвращаемое значение:
//   Структура - Граница (Дата), Записей, Файлов, Байт (Число), Ротация (Строка - путь
//               ТрассаПриема.log, если он будет переименован), Текст, Ошибка (Строка)
//
Функция ЛогиДляОчистки(Знач Дней) Экспорт

	Итог = Новый Структура("Граница, Записей, Файлов, Байт, Ротация, Текст, Ошибка, Файлы",
		Дата(1, 1, 1), 0, 0, 0, "", "", "", Новый Массив);
	Дней = Макс(1, Окр(?(ТипЗнч(Дней) = Тип("Число"), Дней, 30)));
	Итог.Граница = НачалоДня(ТекущаяДатаСеанса()) - Дней * 86400;

	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(*) КАК Записей
			|ИЗ
			|	РегистрСведений.ЭАрМ_ТрассаПриема КАК Трасса
			|ГДЕ
			|	Трасса.ДатаШага < &Граница");
		Запрос.УстановитьПараметр("Граница", Итог.Граница);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Итог.Записей = Выборка.Записей;
		КонецЕсли;
	Исключение
		Итог.Ошибка = НСтр("ru = 'Трасса приёма не прочитана: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Итог;
	КонецПопытки;

	Для Каждого ФайлЛога Из ФайлыЛоговДляОчистки(Итог.Граница, Итог) Цикл
		Итог.Файлы.Добавить(ФайлЛога);
		Итог.Файлов = Итог.Файлов + 1;
		Итог.Байт = Итог.Байт + ФайлЛога.Размер;
	КонецЦикла;

	Итог.Текст = СтрШаблон(НСтр("ru = 'Логи старше %1 дн. (до %2): записей трассы приёма - %3, файлов логов - %4 (%5 МБ)%6.'"),
		Дней, Формат(Итог.Граница, "ДЛФ=D"), Итог.Записей, Итог.Файлов, Формат(Итог.Байт / 1048576, "ЧДЦ=1; ЧН=0"),
		?(ЗначениеЗаполнено(Итог.Ротация), НСтр("ru = '; ТрассаПриема.log больше 50 МБ - будет переименован в архив'"), ""));

	Возврат Итог;

КонецФункции

// Удаляет логи старше Дней дней (см. ЛогиДляОчистки) - только после ответа «Да» в форме.
// Записи трассы - порциями, каждая своей транзакцией; файл, который занят, пропускается.
//
// Возвращаемое значение:
//   Строка - итог для пользователя
//
Функция ОчиститьЛоги(Знач Дней, Знач Подтверждено = Ложь) Экспорт

	Если Подтверждено <> Истина Тогда
		Возврат НСтр("ru = 'Логи не очищены: удаление не подтверждено.'");
	КонецЕсли;
	Если НЕ ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ЭАрМ_ТрассаПриема) Тогда
		Возврат НСтр("ru = 'Логи не очищены: нет права изменять трассу приёма.'");
	КонецЕсли;

	Логи = ЛогиДляОчистки(Дней);
	Если ЗначениеЗаполнено(Логи.Ошибка) Тогда
		Возврат Логи.Ошибка;
	КонецЕсли;

	Ошибки = Новый Массив;
	УдаленоЗаписей = 0;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Трасса.Запись КАК Запись
		|ИЗ
		|	РегистрСведений.ЭАрМ_ТрассаПриема КАК Трасса
		|ГДЕ
		|	Трасса.ДатаШага < &Граница");
	Запрос.УстановитьПараметр("Граница", Логи.Граница);
	Ключи = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Запись");
	Порция = ПорцияОчисткиЖурнала();
	Индекс = 0;
	Пока Индекс < Ключи.Количество() Цикл
		НачатьТранзакцию();
		Попытка
			Конец = Мин(Индекс + Порция, Ключи.Количество()) - 1;
			Для Номер = Индекс По Конец Цикл
				Набор = РегистрыСведений.ЭАрМ_ТрассаПриема.СоздатьНаборЗаписей();
				Набор.Отбор.Запись.Установить(Ключи[Номер]);
				Набор.Записать(Истина);
			КонецЦикла;
			ЗафиксироватьТранзакцию();
			УдаленоЗаписей = УдаленоЗаписей + Конец - Индекс + 1;
		Исключение
			ОтменитьТранзакцию();
			Ошибки.Добавить(НСтр("ru = 'трасса приёма: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Прервать;
		КонецПопытки;
		Индекс = Индекс + Порция;
	КонецЦикла;

	УдаленоФайлов = 0;
	УдаленоБайт = 0;
	Для Каждого ФайлЛога Из Логи.Файлы Цикл
		Попытка
			УдалитьФайлы(ФайлЛога.Путь);
			УдаленоФайлов = УдаленоФайлов + 1;
			УдаленоБайт = УдаленоБайт + ФайлЛога.Размер;
		Исключение
			Если Ошибки.Количество() < 10 Тогда
				Ошибки.Добавить(ФайлЛога.Путь + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

	Ротация = "";
	Если ЗначениеЗаполнено(Логи.Ротация) Тогда
		Архив = Лев(Логи.Ротация, СтрДлина(Логи.Ротация) - 4) + "_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmmss") + ".log";
		Попытка
			ПереместитьФайл(Логи.Ротация, Архив);
			Ротация = НСтр("ru = '; ТрассаПриема.log переименован в '") + Архив;
		Исключение
			Ошибки.Добавить(НСтр("ru = 'ТрассаПриема.log не переименован (занят?): '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Результат = СтрШаблон(НСтр("ru = 'Логи до %1 очищены: записей трассы приёма - %2, файлов - %3 (%4 МБ)%5.'"),
		Формат(Логи.Граница, "ДЛФ=D"), УдаленоЗаписей, УдаленоФайлов, Формат(УдаленоБайт / 1048576, "ЧДЦ=1; ЧН=0"), Ротация);
	Если Ошибки.Количество() > 0 Тогда
		Результат = Результат + Символы.ПС + НСтр("ru = 'Не удалено:'") + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ОчисткаЛогов",
		?(Ошибки.Количество() = 0, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Предупреждение),
		Метаданные.РегистрыСведений.ЭАрМ_ТрассаПриема, , Результат);

	Возврат Результат;

КонецФункции

// Файлы логов старше Граница; ТрассаПриема.log больше 50 МБ - в Итог.Ротация.
//
Функция ФайлыЛоговДляОчистки(Граница, Итог)

	Файлы = Новый Массив;
	Места = Новый Массив;
	Каталог = "";
	Попытка
		Каталог = СокрЛП(ЭАрМ_НастройкиСервер.НастройкиЦепочки().КаталогПакетов);
	Исключение
		Каталог = "";
	КонецПопытки;
	Если ЗначениеЗаполнено(Каталог) Тогда
		Места.Добавить(Новый Структура("Папка, Маска", Каталог, "ТрассаПриема_*.log"));
		Места.Добавить(Новый Структура("Папка, Маска", ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Каталог, "СБИС"), "СБИС_Запросы_*.jsonl"));
		Трасса = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Каталог, "ТрассаПриема.log");
		ФайлТрассы = Новый Файл(Трасса);
		Если ФайлТрассы.Существует() И ФайлТрассы.Размер() > 50 * 1048576 Тогда
			Итог.Ротация = Трасса;
		КонецЕсли;
	КонецЕсли;
	Попытка
		ПапкаОшибок = ЭАрМ_НастройкиСервер.ПодпапкаОбмена("error");
		Для Каждого Маска Из СтрРазделить("Логи_*.txt,Ошибки_*.txt,Расхождения_*.txt", ",") Цикл
			Места.Добавить(Новый Структура("Папка, Маска", ПапкаОшибок, Маска));
		КонецЦикла;
	Исключение
		// папка обмена не задана - выгрузок логов нет
	КонецПопытки;
	Замеры = СокрЛП(Строка(ЭАрМ_НастройкиСервер.ЗначениеНастройки("Замеры_Папка")));
	Если ЗначениеЗаполнено(Замеры) Тогда
		Места.Добавить(Новый Структура("Папка, Маска", Замеры, "zamery_*.csv"));
	КонецЕсли;

	Для Каждого Место Из Места Цикл
		Попытка
			Найденные = НайтиФайлы(Место.Папка, Место.Маска, Ложь);
		Исключение
			Продолжить;
		КонецПопытки;
		Для Каждого Файл Из Найденные Цикл
			Попытка
				Если Файл.ЭтоФайл() И Файл.ПолучитьВремяИзменения() < Граница Тогда
					Файлы.Добавить(Новый Структура("Путь, Размер", Файл.ПолноеИмя, Файл.Размер()));
				КонецЕсли;
			Исключение
				// файл пропал или занят - пропускаем
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	Возврат Файлы;

КонецФункции

// --- Регламентные задания расширения (вкладка «Отправка и регламенты» формы настроек) ---

// Все регламентные задания расширения (ЭАрМ_*): включено ли, как часто, последний
// запуск и его итог.
//
// Возвращаемое значение:
//   Массив из Структура - Имя, Представление, Включено, КаждыеМинут (0 - не по
//   интервалу), ПоследнийЗапуск, Итог, Управление (кто ещё меняет задание)
//
Функция РегламентныеЗаданияРасширения() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Результат = Новый Массив;
	Для Каждого МетаданныеЗадания Из Метаданные.РегламентныеЗадания Цикл

		Если НЕ СтрНачинаетсяС(МетаданныеЗадания.Имя, "ЭАрМ_") Тогда
			Продолжить;
		КонецЕсли;

		Строка = Новый Структура("Имя, Представление, Включено, КаждыеМинут, ПоследнийЗапуск, Итог, Управление",
			МетаданныеЗадания.Имя, МетаданныеЗадания.Представление(), Ложь, 0, "", "", "");
		Результат.Добавить(Строка);

		Задание = РегламентныеЗадания.НайтиПредопределенное(МетаданныеЗадания);
		Если Задание = Неопределено Тогда
			Строка.Итог = НСтр("ru = 'задание не найдено в базе'");
			Продолжить;
		КонецЕсли;

		Строка.Включено = Задание.Использование;
		Если Задание.Расписание.ПериодПовтораВТечениеДня > 0 Тогда
			Строка.КаждыеМинут = Окр(Задание.Расписание.ПериодПовтораВТечениеДня / 60, 1);
		Иначе
			Строка.Управление = НСтр("ru = 'расписание: '") + Строка(Задание.Расписание);
		КонецЕсли;
		Если МетаданныеЗадания.Имя = "ЭАрМ_ОтправкаОчередиСБИС" Тогда
			Строка.Управление = НСтр("ru = 'включает флажок «Собирать и отправлять неотправленное», интервал - поле «Запуск каждые» выше'");
		КонецЕсли;

		ПоследнееЗадание = Неопределено;
		Попытка
			Для Каждого Фоновое Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("РегламентноеЗадание", Задание)) Цикл
				Если ПоследнееЗадание = Неопределено ИЛИ Фоновое.Начало > ПоследнееЗадание.Начало Тогда
					ПоследнееЗадание = Фоновое;
				КонецЕсли;
			КонецЦикла;
		Исключение
			Строка.Итог = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Если ПоследнееЗадание <> Неопределено Тогда
			Строка.ПоследнийЗапуск = Формат(ПоследнееЗадание.Начало, "ДФ='dd.MM.yyyy HH:mm:ss'");
			Строка.Итог = Строка(ПоследнееЗадание.Состояние);
			Если ПоследнееЗадание.ИнформацияОбОшибке <> Неопределено Тогда
				Строка.Итог = Строка.Итог + ": " + КраткоеПредставлениеОшибки(ПоследнееЗадание.ИнформацияОбОшибке);
			КонецЕсли;
		ИначеЕсли НЕ ЗначениеЗаполнено(Строка.Итог) Тогда
			Строка.Итог = НСтр("ru = 'запусков нет (в файловой базе регламент идёт, пока открыт хотя бы один сеанс)'");
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Записывает включение и интервал заданий, изменённых в форме настроек.
// Отправку неотправленного (ЭАрМ_ОтправкаОчередиСБИС) не трогает: её ведут флажок
// и интервал отправки (ПроверитьРасписаниеОтправкиОчереди).
//
// Параметры:
//   Изменения - Массив из Структура - Имя, Включено, КаждыеМинут (0 - расписание не менять)
//
// Возвращаемое значение:
//   Строка - что изменено
//
Функция ЗаписатьРегламентныеЗадания(Изменения) Экспорт

	Если НЕ Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Регламентные задания может менять только администратор'");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);

	Записано = Новый Массив;
	Для Каждого Изменение Из Изменения Цикл

		Если Изменение.Имя = "ЭАрМ_ОтправкаОчередиСБИС" Тогда
			Продолжить;
		КонецЕсли;
		МетаданныеЗадания = Метаданные.РегламентныеЗадания.Найти(Изменение.Имя);
		Если МетаданныеЗадания = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Задание = РегламентныеЗадания.НайтиПредопределенное(МетаданныеЗадания);
		Если Задание = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Секунд = Окр(Макс(0, Изменение.КаждыеМинут) * 60);
		НовоеРасписание = Секунд > 0
			И (Задание.Расписание.ПериодПовтораДней <> 1 ИЛИ Задание.Расписание.ПериодПовтораВТечениеДня <> Секунд);
		Если Задание.Использование = Изменение.Включено И НЕ НовоеРасписание Тогда
			Продолжить;
		КонецЕсли;

		Задание.Использование = Изменение.Включено;
		Если НовоеРасписание Тогда
			Расписание = Новый РасписаниеРегламентногоЗадания;
			Расписание.ПериодПовтораДней = 1;
			Расписание.ПериодПовтораВТечениеДня = Секунд;
			Задание.Расписание = Расписание;
		КонецЕсли;
		Задание.Записать();

		Записано.Добавить(СтрШаблон("%1: %2%3", МетаданныеЗадания.Представление(),
			?(Изменение.Включено, НСтр("ru = 'включено'"), НСтр("ru = 'выключено'")),
			?(НовоеРасписание, СтрШаблон(НСтр("ru = ', каждые %1 мин'"), Изменение.КаждыеМинут), "")));
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "РегламентныеЗадания", Истина,
			Записано[Записано.ВГраница()] + " (" + ИмяПользователя() + ")");

	КонецЦикла;

	Возврат ?(Записано.Количество() = 0, "",
		НСтр("ru = 'Регламентные задания: '") + СтрСоединить(Записано, "; "));

КонецФункции

// Кнопка «Запустить сейчас»: тот же метод, что у задания, фоновым заданием.
// Отправку неотправленного запускает форма своей кнопкой (с ходом).
//
// Возвращаемое значение:
//   Строка - что запущено или почему нет
//
Функция ЗапуститьРегламентноеЗаданиеСейчас(Имя) Экспорт

	МетаданныеЗадания = Метаданные.РегламентныеЗадания.Найти(Имя);
	Если МетаданныеЗадания = Неопределено Тогда
		Возврат НСтр("ru = 'Нет такого регламентного задания: '") + Имя;
	КонецЕсли;

	// В метаданных - «CommonModule.Модуль.Метод» или «Модуль.Метод»: для запуска - последние две части
	Части = СтрРазделить(МетаданныеЗадания.ИмяМетода, ".");
	Метод = ?(Части.Количество() >= 2, Части[Части.Количество() - 2] + "." + Части[Части.Количество() - 1],
		МетаданныеЗадания.ИмяМетода);
	Попытка
		ФоновыеЗадания.Выполнить(Метод, , "ЭАрМ_Сейчас_" + Имя, МетаданныеЗадания.Представление() + НСтр("ru = ' (запуск из настроек)'"));
	Исключение
		Возврат СтрШаблон(НСтр("ru = '%1 не запущено: %2'"), МетаданныеЗадания.Представление(),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат СтрШаблон(НСтр("ru = '%1: запущено фоном, итог - в колонке «Итог» после «Обновить»'"), МетаданныеЗадания.Представление());

КонецФункции

// --- Форма настроек очереди отправки (Обработка.ЭАрМ_ПанельУправленияЭДО) ---

// Все настройки очереди одним вызовом.
//
// Возвращаемое значение:
//   Структура - Включена, Подписант, Интервал, Модуль, Путь, Тип (Строка),
//               ЕстьПароль (Булево), плюс поля СостояниеОтправкиОчереди
//
Функция НастройкиОчередиОтправки() Экспорт

	Результат = СостояниеОтправкиОчереди();
	Результат.Вставить("Включена", АвтоотправкаВключена());
	Результат.Вставить("Модуль", СокрЛП(Строка(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПодписьСервер_Модуль"))));
	Результат.Вставить("Путь",   СокрЛП(Строка(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПодписьСервер_Путь"))));
	Результат.Вставить("Тип",    СокрЛП(Строка(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПодписьСервер_Тип"))));
	Результат.Вставить("ИмяСервера", ИмяКомпьютера());

	Возврат Результат;

КонецФункции

// Записывает настройки очереди из формы настроек. Только для полноправного
// пользователя: включает регламентное задание и подпись на сервере.
//
// Параметры:
//   Настройки - Структура - Включена, Подписант, Интервал, Модуль, Путь, Тип
//
Процедура ЗаписатьНастройкиОчередиОтправки(Настройки) Экспорт

	Если НЕ Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Настройки очереди отправки может менять только администратор'");
	КонецЕсли;

	ЭАрМ_НастройкиСервер.СохранитьНастройку("ПодписьСервер_Модуль", СокрЛП(Настройки.Модуль));
	ЭАрМ_НастройкиСервер.СохранитьНастройку("ПодписьСервер_Путь",   СокрЛП(Настройки.Путь));
	ЭАрМ_НастройкиСервер.СохранитьНастройку("ПодписьСервер_Тип",    СокрЛП(Настройки.Тип));
	СохранитьПодписантаОтправкиОчереди(Настройки.Подписант);
	Если Настройки.Свойство("Место") Тогда
		ЭАрМ_ОбработкаПодтвержденийЭДО.УстановитьМестоПодписиОчереди(Настройки.Место);
	КонецЕсли;
	ЭАрМ_НастройкиСервер.СохранитьНастройку("ИнтервалОтправкиОчереди",
		Формат(Макс(1, Мин(Настройки.Интервал, 1440)), "ЧГ=0"));

	// Флажок последним: он же ставит опцию и расписание по новому интервалу.
	// Пишется, только если его поменяли в этой форме: Включена прочитана при
	// открытии настроек, а галочку за это время могли включить в реестре - раньше
	// «Записать» её снимал. Компьютер - с клиента формы (кто будет подписывать)
	Компьютер = "";
	Если Настройки.Свойство("Компьютер") Тогда
		Компьютер = СокрЛП(Строка(Настройки.Компьютер));
	КонецЕсли;
	Если (Настройки.Включена = Истина) <> АвтоотправкаВключена() Тогда
		УстановитьАвтоотправку(Настройки.Включена, Компьютер, НСтр("ru = 'Настройки очереди отправки: Записать'"));
	Иначе
		Если Настройки.Включена = Истина И НЕ ЗначениеЗаполнено(АвтоотправкаКомпьютер())
			И ЗначениеЗаполнено(Компьютер) Тогда
			ЭАрМ_НастройкиСервер.СохранитьНастройку("Автоотправка_Компьютер", Компьютер);
		КонецЕсли;
		Попытка
			ЭАрМ_ОбработкаПодтвержденийЭДО.ПроверитьРасписаниеОтправкиОчереди();
		Исключение
			ЭАрМ_Служебный.ЗаписатьОшибку("ПроверитьРасписаниеОтправкиОчереди",
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Запускает фоновую подготовку следующей пачки автоотправки: реестр УПД ->
// очередь -> подготовка в СБИС (ЭАрМ_ОбработкаПодтвержденийЭДО.ПодготовитьАвтоПачку).
//
// Пачку ведёт одна форма: пока другая форма (очередь или реестр УПД) не
// закончила свою, возвращается Неопределено - иначе обе подписали бы одни и
// те же документы.
//
// Возвращаемое значение:
//   Структура - длительная операция БСП;
//   Строка - почему не запустилась;
//   Неопределено - автоотправку сейчас ведёт другая форма
//
Функция ЗапуститьАвтоПачкуВФоне(ИдентификаторФормы, Исключить, НомерПодписанта) Экспорт

	// Выбрана подпись на сервере и сервер подписать может - форма не
	// подписывает, чтобы одни документы не ушли дважды; только подталкивает
	// серверную отправку. Сервер подписать не может (нет ключа или
	// криптопровайдера) - подписывает форма: иначе очередь стояла бы совсем
	Если ЭАрМ_ОбработкаПодтвержденийЭДО.МестоПодписиОчереди() = "Сервер" Тогда
		ТекстОшибкиСервера = "";
		Попытка
			СерверПодписывает = ЭАрМ_ОбработкаПодтвержденийЭДО.ОтправкаОчередиНаСервереНастроена(ТекстОшибкиСервера);
		Исключение
			СерверПодписывает = Ложь;
		КонецПопытки;
		Если СерверПодписывает Тогда
			ЭАрМ_ОбработкаПодтвержденийЭДО.ЗапуститьОтправкуОчередиВФоне();
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗанятьАвтоотправку(ИдентификаторФормы) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Автоотправка в СБИС: подготовка пачки'");
	ПараметрыВыполнения.СРасширениямиБазыДанных = Истина;
	// Ключ - вторая защита рядом с ЗанятьАвтоотправку (запись настройки -
	// не атомарна): одновременно идёт только одна подготовка пачки на базу
	ПараметрыВыполнения.КлючФоновогоЗадания = "ЭАрМ_АвтоПачка";

	Попытка
		Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"ЭАрМ_ОбработкаПодтвержденийЭДО.ПодготовитьАвтоПачку", Исключить, НомерПодписанта);
	Исключение
		ОсвободитьАвтоотправку(ИдентификаторФормы);
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Если СтрНайти(НРег(ТекстОшибки), "уже выполняется") > 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'Автоотправка: фоновое задание не запущено: %1'"), ТекстОшибки);
	КонецПопытки;

КонецФункции

// Снимает захват ответа: «.processing» - обратно под исходное имя.
//
Процедура ОсвободитьФайлОтвета(ФайлЗахвата, ИсходныйФайл)

	Попытка
		ПереместитьФайл(ФайлЗахвата.ПолноеИмя, ИсходныйФайл.ПолноеИмя);
	Исключение
		// Вернёт регламент (ВернутьЗависшиеОтветы) через 30 минут
	КонецПопытки;

КонецПроцедуры

// Ключ фонового задания СБИС по действию и составу документов: одно и то же
// действие над теми же документами не запускается вторым заданием, пока
// идёт первое (второй запуск получит ошибку «уже выполняется»).
//
// Параметры:
//   ИмяФункции - Строка - метод фонового задания
//   Документы  - Произвольный - первый параметр метода (документы/пакет)
//
// Возвращаемое значение:
//   Строка - «ЭАрМ_СБИС|<метод>|<MD5 состава>»
//
Функция КлючФоновогоЗаданияСБИС(ИмяФункции, Документы) Экспорт

	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Попытка
		Хеширование.Добавить(ЗначениеВСтрокуВнутр(Документы));
	Исключение
		Хеширование.Добавить(Строка(Документы));
	КонецПопытки;

	Возврат Лев(СтрШаблон("ЭАрМ_СБИС|%1|%2", ИмяФункции,
		ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма)), 120);

КонецФункции

// Запускает фоновую отправку подписей пачки автоотправки.
//
// Возвращаемое значение:
//   Структура - длительная операция БСП; Строка - почему не запустилась
//
Функция ЗапуститьОтправкуАвтоПачкиВФоне(ИдентификаторФормы, Пакет) Экспорт

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Автоотправка в СБИС: отправка подписей'");
	ПараметрыВыполнения.СРасширениямиБазыДанных = Истина;
	// Раньше защиты не было вовсе: две отправки одной пачки одновременно
	ПараметрыВыполнения.КлючФоновогоЗадания = "ЭАрМ_АвтоПачкаОтправка";

	Попытка
		Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"ЭАрМ_УтверждениеСБИС.ВыполнитьПакетДействий", Пакет);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Если СтрНайти(НРег(ТекстОшибки), "уже выполняется") > 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'Автоотправка: отправка подписей не запущена: %1'"), ТекстОшибки);
	КонецПопытки;

КонецФункции

// Отмечает, что пачку ведёт эта форма. Чужая отметка старше
// МинутЗанятостиАвтоотправки() считается брошенной (форму закрыли посреди пачки).
//
// Возвращаемое значение:
//   Булево - Истина, если пачку можно вести этой форме
//
Функция ЗанятьАвтоотправку(ИдентификаторФормы)

	Своя = Строка(ИдентификаторФормы);
	Отметка = СтрРазделить(Строка(ЭАрМ_НастройкиСервер.ЗначениеНастройки("Автоотправка_Занята")), "|");

	Если Отметка.Количество() = 2 И Отметка[0] <> Своя Тогда
		Попытка
			Занята = Дата(Отметка[1]);
		Исключение
			Занята = '00010101';
		КонецПопытки;
		Если ТекущаяДатаСеанса() - Занята < МинутЗанятостиАвтоотправки() * 60 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	ЭАрМ_НастройкиСервер.СохранитьНастройку("Автоотправка_Занята",
		Своя + "|" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss"));

	Возврат Истина;

КонецФункции

// Снимает отметку, если её ставила эта форма.
//
Процедура ОсвободитьАвтоотправку(ИдентификаторФормы) Экспорт

	Отметка = СтрРазделить(Строка(ЭАрМ_НастройкиСервер.ЗначениеНастройки("Автоотправка_Занята")), "|");
	Если Отметка.Количество() > 0 И Отметка[0] = Строка(ИдентификаторФормы) Тогда
		ЭАрМ_НастройкиСервер.СохранитьНастройку("Автоотправка_Занята", "");
	КонецЕсли;

КонецПроцедуры

Функция МинутЗанятостиАвтоотправки()

	Возврат 10;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Регистры, которые чистит ОчиститьРегистрыЭДО.
//
// Возвращаемое значение:
//   Массив из Строка - имена регистров сведений
//
Функция РегистрыДляОчистки(ВключаяНастройки)

	Регистры = Новый Массив;
	Регистры.Добавить("ЭАрМ_РеестрЭТрН");
	Регистры.Добавить("ЭАрМ_ТоварыЭТрН");
	Регистры.Добавить("ЭАрМ_УПД_Входящий");
	Регистры.Добавить("ЭАрМ_УКД_Входящий");
	Регистры.Добавить("ЭАрМ_ОжидаемыеПодтвержденияЭДО");
	Регистры.Добавить("ЭАрМ_ЖурналОбменаЭДО");

	Если ВключаяНастройки Тогда
		Регистры.Добавить("ЭАрМ_НастройкиЭДО");
	КонецЕсли;

	Возврат Регистры;

КонецФункции

// Очищает один регистр сведений целиком.
//
// Все регистры расширения независимые, поэтому запись пустого набора без
// отбора удаляет из них всё.
//
// Возвращаемое значение:
//   Число - сколько записей было до очистки
//
Функция ОчиститьРегистрСведений(ИмяРегистра)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Всего
		|ИЗ
		|	РегистрСведений.%1 КАК Регистр", ИмяРегистра);

	Выборка = Запрос.Выполнить().Выбрать();
	Всего = ?(Выборка.Следующий(), Выборка.Всего, 0);

	НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	НаборЗаписей.Записать(Истина);

	Возврат Всего;

КонецФункции

// Технические регистры, которые чистит ОчиститьТехническуюИнформацию:
// служебные журналы и данные обмена, но не реестры документов и настройки.
//
// Новый технический регистр добавляется строкой описания: какими полями
// запись уникальна и каким признаком считать её старой. Ошибочные и
// необработанные пакеты сознательно не входят - они ещё могут попасть
// в очередь обработки (см. ЭАрМ_ПриемПакетовДалион.ПринятьПакеты).
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Имя           - Строка - имя регистра сведений
//     * Представление - Строка - название регистра для отчёта
//     * ПоПериоду     - Булево - Истина для периодического регистра:
//                       его период входит в ключ записи
//     * Условие       - Строка - условие запроса для отбора старых записей,
//                       параметр &ДатаОчистки подставляется автоматически
//     * Параметры     - Структура - дополнительные параметры запроса
//
Функция ТехническиеРегистры()

	Регистры = Новый Массив;
	Регистры.Добавить(Новый Структура(
		"Имя, Представление, ПоПериоду, Условие, Параметры",
		"ЭАрМ_ЖурналОбменаЭДО", НСтр("ru = 'Журнал обмена ЭДО'"), Истина,
		"Данные.Период < &ДатаОчистки", Новый Структура));
	Регистры.Добавить(Новый Структура(
		"Имя, Представление, ПоПериоду, Условие, Параметры",
		"ЭАрМ_ЗапросыДалион", НСтр("ru = 'Запросы Далион'"), Ложь,
		"Данные.ДатаОтправки > ДАТАВРЕМЯ(1, 1, 1) И Данные.ДатаОтправки < &ДатаОчистки",
		Новый Структура));
	Регистры.Добавить(Новый Структура(
		"Имя, Представление, ПоПериоду, Условие, Параметры",
		"ЭАрМ_ПакетыДалион", НСтр("ru = 'Пакеты Далион (обработанные)'"), Ложь,
		"Данные.Статус = &Обработан И Данные.ДатаОбработки < &ДатаОчистки",
		Новый Структура("Обработан", ЭАрМ_ПриемПакетовДалион.Статусы().Обработан)));

	Возврат Регистры;

КонецФункции

// Удаляет старые записи одного технического регистра построчно.
//
// Построчно, а не пустым набором с замещением: у периодического регистра
// такой набор стёр бы и свежие записи с теми же измерениями.
//
// Параметры:
//   Описание    - Структура - см. ТехническиеРегистры
//   ДатаОчистки - Дата - записи старше этой даты удаляются
//
// Возвращаемое значение:
//   Число - сколько записей удалено
//
Функция ОчиститьТехническийРегистр(Описание, ДатаОчистки)

	// Ключ записи: период (у периодического регистра) и измерения
	КлючевыеПоля = Новый Массив;
	Если Описание.ПоПериоду Тогда
		КлючевыеПоля.Добавить("Период");
	КонецЕсли;
	Для Каждого Измерение Из Метаданные.РегистрыСведений[Описание.Имя].Измерения Цикл
		КлючевыеПоля.Добавить(Измерение.Имя);
	КонецЦикла;

	Если КлючевыеПоля.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	ПоляВыборки = "Данные." + СтрСоединить(КлючевыеПоля,
		"," + Символы.ПС + Символы.Таб + "Данные.");

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		|	%1
		|ИЗ
		|	РегистрСведений.%2 КАК Данные
		|ГДЕ
		|	%3",
		ПоляВыборки, Описание.Имя, Описание.Условие);
	Запрос.УстановитьПараметр("ДатаОчистки", ДатаОчистки);
	Для Каждого Параметр Из Описание.Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	Выборка = Запрос.Выполнить().Выбрать();
	Удалено = 0;

	Пока Выборка.Следующий() Цикл

		МенеджерЗаписи = РегистрыСведений[Описание.Имя].СоздатьМенеджерЗаписи();
		Для Каждого ИмяПоля Из КлючевыеПоля Цикл
			МенеджерЗаписи[ИмяПоля] = Выборка[ИмяПоля];
		КонецЦикла;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
			Удалено = Удалено + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Удалено;

КонецФункции

// Кладёт системный JSON с Очистить = Истина в корень папки выгрузки.
// Обмен с Далионом здесь идёт через папку, FTP не используем.
//
// Корень, а не подкаталог command: приёмная база сканирует именно корень,
// а файлы с префиксом command_ отсеивает из входящих документов по имени.
//
Процедура ОтправитьКомандуОчистки(СтрокиОтчета, Ошибки)

	НастройкиОбмена = ЭАрМ_НастройкиСервер.НастройкиОбмена();
	РезультатПапки = ЗаписатьКомандуОчисткиВПапку(
		НастройкиОбмена.ПапкаВыгрузки, "command_clear.json", ТекстJSONКомандыОчистки());

	Если РезультатПапки.Успех Тогда
		СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Команда очистки: %1'"), РезультатПапки.Путь));
		Возврат;
	КонецЕсли;

	ТекстОшибки = ?(ЗначениеЗаполнено(РезультатПапки.Ошибка),
		РезультатПапки.Ошибка,
		НСтр("ru = 'Команда очистки не записана: не задана папка выгрузки'"));
	Ошибки.Добавить(ТекстОшибки);
	СтрокиОтчета.Добавить(ТекстОшибки);

КонецПроцедуры

// Тело системной команды сброса обмена для АРМ_ТестЭдо.
//
Функция ТекстJSONКомандыОчистки()

	Данные = Новый Структура;
	Данные.Вставить("ТипДокумента", "Системный");
	Данные.Вставить("Очистить", Истина);
	Данные.Вставить("Дата", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Пишет command_clear.json в корень папки выгрузки. Папку не удаляет.
//
Функция ЗаписатьКомандуОчисткиВПапку(ПапкаОбмена, ИмяФайла, ТекстJSON)

	Результат = Новый Структура("Успех, Ошибка, Путь", Ложь, "", "");

	База = БезРазделителяВКонце(ПапкаОбмена);
	Если НЕ ЗначениеЗаполнено(База) Тогда
		Результат.Ошибка = НСтр("ru = 'Не указана папка выгрузки в настройках ЭДО'");
		Возврат Результат;
	КонецЕсли;

	Попытка

		ФайлКаталога = Новый Файл(База);
		Если НЕ ФайлКаталога.Существует() Тогда
			СоздатьКаталог(База);
		КонецЕсли;

		ПолныйПуть = База + "\" + ИмяФайла;
		ЭАрМ_Служебный.ЗаписатьТекстВФайл(ТекстJSON, ПолныйПуть);

		Результат.Успех = Истина;
		Результат.Путь  = ПолныйПуть;

	Исключение
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Команда очистки, папка: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Убирает завершающий слэш - пути в настройках вводят как придётся.
//
Функция БезРазделителяВКонце(Путь)

	Результат = СокрЛП(Путь);

	Пока СтрДлина(Результат) > 0
		И (Прав(Результат, 1) = "\" ИЛИ Прав(Результат, 1) = "/") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Удаляет файлы во всех подкаталогах папок обмена. Каталоги оставляет:
// приёмная база и регламентное задание рассчитывают, что incoming, result
// и archive на месте.
//
// Чистим и папку выгрузки, и папку ответов - в настройках это два разных
// ключа, даже когда указывают на один каталог. Повтор отсекаем по пути.
//
// Возвращаемое значение:
//   Число - сколько файлов удалено
//
Функция УдалитьФайлыПапокОбмена(Ошибки)

	Удалено = 0;
	НастройкиОбмена = ЭАрМ_НастройкиСервер.НастройкиОбмена();

	ПапкиОбмена = Новый Массив;
	ПапкиОбмена.Добавить(НастройкиОбмена.ПапкаВыгрузки);
	ПапкиОбмена.Добавить(НастройкиОбмена.ПапкаОбмена);

	Обработанные = Новый Соответствие;

	Для Каждого Папка Из ПапкиОбмена Цикл

		Путь = БезРазделителяВКонце(Папка);
		Если НЕ ЗначениеЗаполнено(Путь) Тогда
			Продолжить;
		КонецЕсли;

		Ключ = ВРег(Путь);
		Если Обработанные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обработанные.Вставить(Ключ, Истина);

		Удалено = Удалено + УдалитьФайлыВКаталоге(Путь, Ошибки);

	КонецЦикла;

	Возврат Удалено;

КонецФункции

// Удаляет файлы каталога вместе с вложенными, сами каталоги не трогает.
//
Функция УдалитьФайлыВКаталоге(ПутьКаталога, Ошибки)

	Удалено = 0;

	Каталог = Новый Файл(ПутьКаталога);
	Если НЕ Каталог.Существует() Тогда
		Возврат 0;
	КонецЕсли;

	Для Каждого Файл Из НайтиФайлы(ПутьКаталога, "*", Истина) Цикл

		Если Файл.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			УдалитьФайлы(Файл.ПолноеИмя);
			Удалено = Удалено + 1;
		Исключение
			Ошибки.Добавить(СтрШаблон(НСтр("ru = '%1: %2'"), Файл.ПолноеИмя,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

	Возврат Удалено;

КонецФункции

// Подготавливает данные для не-ЭДО документа (ЗаказКлиента и т.п.).
//
Функция ПодготовитьДанныеНеЭДОДокумента(ДокументСсылка)

	МетаДокумент = ДокументСсылка.Метаданные();
	Данные = Новый Структура;

	// Стандартные реквизиты
	Для Каждого Рекв Из МетаДокумент.СтандартныеРеквизиты Цикл
		Попытка
			ЗначениеРекв = ДокументСсылка[Рекв.Имя];
			Если ТипЗнч(ЗначениеРекв) = Тип("СсылкаНаОбъектМетаданных") Тогда
				Данные.Вставить(Рекв.Имя, Строка(ЗначениеРекв));
			Иначе
				Данные.Вставить(Рекв.Имя, ЗначениеРекв);
			КонецЕсли;
		Исключение
			Данные.Вставить(Рекв.Имя, Неопределено);
		КонецПопытки;
	КонецЦикла;

	// Реквизиты шапки документа
	ИменаРеквизитов = Новый Массив;
	Для Каждого Рекв Из МетаДокумент.Реквизиты Цикл
		ИменаРеквизитов.Добавить(Рекв.Имя);
	КонецЦикла;

	Если ИменаРеквизитов.Количество() > 0 Тогда
		Попытка
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
				СтрСоединить(ИменаРеквизитов, ", "));
			Для Каждого КлючЗначение Из ЗначенияРеквизитов Цикл
				ЗначениеРекв = КлючЗначение.Значение;
				Если ТипЗнч(ЗначениеРекв) = Тип("СсылкаНаОбъектМетаданных") Тогда
					Данные.Вставить(КлючЗначение.Ключ, Строка(ЗначениеРекв));
				Иначе
					Данные.Вставить(КлючЗначение.Ключ, ЗначениеРекв);
				КонецЕсли;
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Данные.Вставить("СсылкаСтрока", ПолучитьНавигационнуюСсылку(ДокументСсылка));
	Данные.Вставить("ТипДокумента", МетаДокумент.Имя);
	Данные.Вставить("Представление", Строка(ДокументСсылка));
	Данные.Вставить("ЭтоТест", Истина);

	// Табличные части
	ТабличныеЧасти = Новый Структура;

	Для Каждого ТабличнаяЧасть Из МетаДокумент.ТабличныеЧасти Цикл
		ИмяТЧ = ТабличнаяЧасть.Имя;

		ИменаКолонок = Новый Массив;
		Для Каждого РеквТЧ Из ТабличнаяЧасть.Реквизиты Цикл
			ИменаКолонок.Добавить(РеквТЧ.Имя);
		КонецЦикла;

		Попытка
			Выборка = ДокументСсылка[ИмяТЧ].Выбрать();
			СтрокиТЧ = Новый Массив;

			Пока Выборка.Следующий() Цикл
				СтрокаДанных = Новый Структура("НомерСтроки", Выборка.НомерСтроки);
				Для Каждого ИмяКолонки Из ИменаКолонок Цикл
					Попытка
						ЗначениеКолонки = Выборка[ИмяКолонки];
						Если ТипЗнч(ЗначениеКолонки) = Тип("СсылкаНаОбъектМетаданных") Тогда
							СтрокаДанных.Вставить(ИмяКолонки, Строка(ЗначениеКолонки));
						Иначе
							СтрокаДанных.Вставить(ИмяКолонки, ЗначениеКолонки);
						КонецЕсли;
					Исключение
						СтрокаДанных.Вставить(ИмяКолонки, Неопределено);
					КонецПопытки;
				КонецЦикла;
				СтрокиТЧ.Добавить(СтрокаДанных);
			КонецЦикла;

			ТабличныеЧасти.Вставить(ИмяТЧ, СтрокиТЧ);
		Исключение
			ТабличныеЧасти.Вставить(ИмяТЧ, Новый Массив);
		КонецПопытки;
	КонецЦикла;

	Данные.Вставить("ТабличныеЧасти", ТабличныеЧасти);

	Возврат Данные;

КонецФункции

Процедура ДобавитьСтрокуЖурнала(Журнал, Документ, ИдентификаторЗапроса, Статус, Дата, Комментарий, Результат)

	Строка = Новый Структура;
	Строка.Вставить("Документ", Строка(Документ));
	Строка.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
	Строка.Вставить("Статус", Статус);
	Строка.Вставить("ДатаОтправки", Дата);
	Строка.Вставить("ДатаОтвета", Неопределено);
	Строка.Вставить("Комментарий", Комментарий);
	Строка.Вставить("Результат", Результат);
	Журнал.Добавить(Строка);

КонецПроцедуры

// Удаляет одну порцию записей журнала обмена ЭДО своей транзакцией.
//
// Параметры:
//   Порция - Массив из Структура - ключи записей: Период, ИдентификаторСБИС, Операция
//   Итоги  - Структура - см. ОчиститьЖурналОбмена; дополняются Удалено и Ошибки
//
// Возвращаемое значение:
//   Булево - Ложь, если порция откачена из-за ошибки
//
Функция УдалитьПорциюЖурналаОбмена(Порция, Итоги)

	НачатьТранзакцию();
	Попытка

		Для Каждого СтрокаПорции Из Порция Цикл
			// Отбор по всему ключу записи: пустой набор с замещением удаляет ровно её
			НаборЗаписей = РегистрыСведений.ЭАрМ_ЖурналОбменаЭДО.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Период.Установить(СтрокаПорции.Период);
			НаборЗаписей.Отбор.ИдентификаторСБИС.Установить(СтрокаПорции.ИдентификаторСБИС);
			НаборЗаписей.Отбор.Операция.Установить(СтрокаПорции.Операция);
			НаборЗаписей.Записать(Истина);
		КонецЦикла;

		ЗафиксироватьТранзакцию();

	Исключение

		ОшибкаПорции = ИнформацияОбОшибке();
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;

		Итоги.Ошибки.Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(ОшибкаПорции));
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ОчисткаЖурналаОбмена", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.ЭАрМ_ЖурналОбменаЭДО, ,
			СтрШаблон(НСтр("ru = 'Порция из %1 записей не удалена (откат), до неё удалено %2: %3'"),
				Порция.Количество(), Итоги.Удалено, ПодробноеПредставлениеОшибки(ОшибкаПорции)));
		Возврат Ложь;

	КонецПопытки;

	Итоги.Удалено = Итоги.Удалено + Порция.Количество();
	Возврат Истина;

КонецФункции

// Почему период очистки журнала обмена не годится.
//
// Возвращаемое значение:
//   Строка - текст для пользователя; пусто - период годится
//
Функция ОшибкаПериодаОчисткиЖурнала(НачалоПериода, КонецПериода)

	Если ТипЗнч(КонецПериода) <> Тип("Дата") Или Не ЗначениеЗаполнено(КонецПериода) Тогда
		Возврат НСтр("ru = 'Укажите дату «По»: по какой день удалять записи журнала обмена.'");
	КонецЕсли;

	Если ТипЗнч(НачалоПериода) <> Тип("Дата") Тогда
		Возврат НСтр("ru = 'Дата «С» должна быть датой или пустой.'");
	КонецЕсли;

	Если ЗначениеЗаполнено(НачалоПериода) И НачалоДня(НачалоПериода) > НачалоДня(КонецПериода) Тогда
		Возврат НСтр("ru = 'Дата «С» позже даты «По».'");
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПредставлениеПериодаОчисткиЖурнала(НачалоПериода, КонецПериода)

	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		Возврат СтрШаблон(НСтр("ru = 'с %1 по %2 включительно'"),
			Формат(НачалоПериода, "ДФ=dd.MM.yyyy"), Формат(КонецПериода, "ДФ=dd.MM.yyyy"));
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'по %1 включительно (со всеми более старыми)'"),
		Формат(КонецПериода, "ДФ=dd.MM.yyyy"));

КонецФункции

