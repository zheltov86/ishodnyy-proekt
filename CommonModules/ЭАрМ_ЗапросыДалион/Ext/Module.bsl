////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_ЗапросыДалион: исходящие запросы к Далиону и разбор папки обмена.
//
// УТ пишет в incoming JSON header.type = dataRequest со списком объектов.
// Далион отвечает выгрузкой dalion_<тип>_*.json в result. Регламент читает
// папку, раскладывает пакеты по регистрам и обновляет статусы запросов.
//
// После сверки без расхождений команда setSeal уходит тем же каналом
// (см. ЭАрМ_ЦепочкаЗакупки.ЗапроситьПломбы).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Точка входа регламентного задания ЭАрМ_ОбработкаПакетовДалион:
// читает папку обмена, раскладывает пакеты, сверяет, при авторежиме
// запрашивает пломбу и обновляет статусы запросов.
//
Процедура ВыполнитьОбработкуПапки() Экспорт

	ЭАрМ_ПриемПакетовДалион.ВыполнитьЗадание();

КонецПроцедуры

// Кладёт JSON «что хотим получить» в канал Далиона (FTP incoming или папка).
//
// Параметры:
//   Объекты - Массив из Строка - типы: Контрагент, Номенклатура,
//             ДоговорКонтрагента, Касса, ЗаказПоставщику, ПриходнаяНакладная,
//             ВозвратПоставщику (возврат товаров поставщику),
//             КорректировкаПоставщика (корректировочный документ входящий)
//   ПараметрыЗапроса - Структура, Неопределено - необязательные поля data:
//     * periodDays - Число - глубина в днях для заказов, приходных, возвратов и корректировок
//     * periods    - Структура - своя глубина по типу: ЗаказПоставщику = 7
//     * dateFrom, dateTo - Дата, Строка - явный период
//     * barcodes   - Массив из Строка - номенклатура только по этим штрихкодам
//     * counterpartyInns - Массив из Строка - ИНН поставщиков: договоры (ДоговорКонтрагента)
//                    только по ним. Пусто - Далион отдаёт ВСЕ договоры (большой ответ),
//                    поэтому для точечного запроса см. ЗапроситьДоговорыПоИНН
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, ИдентификаторЗапроса, ИмяФайла, Путь
//
Функция ОтправитьЗапросДанных(Объекты, ПараметрыЗапроса = Неопределено) Экспорт

	Результат = Новый Структура("Успех, Ошибка, ИдентификаторЗапроса, ИмяФайла, Путь",
		Ложь, "", Строка(Новый УникальныйИдентификатор), "", "");

	СписокОбъектов = НормализоватьСписокОбъектов(Объекты);
	Если СписокОбъектов.Количество() = 0 Тогда
		Результат.Ошибка = "Не выбран ни один тип данных для запроса";
		Возврат Результат;
	КонецЕсли;

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();

	Заголовок = Новый Структура;
	Заголовок.Вставить("type",      "dataRequest");
	Заголовок.Вставить("export",    "dataRequest");
	Заголовок.Вставить("version",   "1.0");
	Заголовок.Вставить("source",    "UT");
	Заголовок.Вставить("created",   Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Заголовок.Вставить("requestId", Результат.ИдентификаторЗапроса);
	Заголовок.Вставить("versionFormat",  "2");
	Заголовок.Вставить("correlationId",  Результат.ИдентификаторЗапроса);

	Данные = Новый Структура;
	Данные.Вставить("action",  "dump");
	Данные.Вставить("objects", СписокОбъектов);
	ДополнитьДанныеЗапроса(Данные, ПараметрыЗапроса);
	ОбеспечитьПериодДокументов(Данные);

	Пакет = Новый Структура("header, data", Заголовок, Данные);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Пакет);
	ТекстJSON = ЗаписьJSON.Закрыть();

	Результат.ИмяФайла = СтрШаблон("dalion_dataRequest_%1_%2.json",
		Результат.ИдентификаторЗапроса, Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss"));

	Отправка = ОтправитьТекстВДалион(ТекстJSON, Результат.ИмяФайла, Настройки);
	Результат.Успех  = Отправка.Успех;
	Результат.Ошибка = Отправка.Ошибка;
	Результат.Путь   = Отправка.Путь;

	ЗафиксироватьИсходящий(Результат.ИдентификаторЗапроса, "dataRequest",
		СтрСоединить(СписокОбъектов, ","), Результат.ИмяФайла, ТекстJSON,
		?(Результат.Успех, "Отправлен" + ОписаниеСоставаЗапроса(Данные), Результат.Ошибка),
		?(Результат.Успех, СтатусыЗапроса().Отправлен, СтатусыЗапроса().Ошибка));

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Результат.ИдентификаторЗапроса,
		ОперацияЖурнала(), Результат.Успех,
		?(Результат.Успех, "Запрос данных: " + СтрСоединить(СписокОбъектов, ", "), Результат.Ошибка),
		Результат.ИмяФайла);

	Возврат Результат;

КонецФункции

// Запрос приходной накладной Далиона по номеру (со строки УПД).
//
// Далион ищет номер среди входящего номера, номера ЭДО, номера счёта-фактуры
// и номера самого документа; ИНН сужает поиск до поставщика. Период нужен,
// чтобы не перебирать всю базу: от даты УПД минус 90 дней до сегодня.
//
// Параметры:
//   Номер - Строка - номер УПД
//   ИНН   - Строка - ИНН контрагента (необязательно)
//   Дата  - Дата   - дата УПД (необязательно)
//
// Возвращаемое значение:
//   Структура - как у ОтправитьЗапросДанных
//
Функция ЗапроситьПриходнуюПоНомеру(Номер, ИНН = "", Дата = Неопределено) Экспорт

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("numbers", ЭАрМ_Служебный.ЗначениеВМассив(СокрЛП(Номер)));
	Если ЗначениеЗаполнено(ИНН) Тогда
		ПараметрыЗапроса.Вставить("inn", СокрЛП(ИНН));
	КонецЕсли;
	Если ТипЗнч(Дата) = Тип("Дата") И ЗначениеЗаполнено(Дата) Тогда
		ПараметрыЗапроса.Вставить("dateFrom", НачалоДня(Дата - 90 * 86400));
		ПараметрыЗапроса.Вставить("dateTo", КонецДня(ТекущаяДатаСеанса()));
	КонецЕсли;

	Возврат ОтправитьЗапросДанных("ПриходнаяНакладная", ПараметрыЗапроса);

КонецФункции

// Запрос возврата и корректировки поставщика из Далиона по номеру УПД или УКД.
//
// Нужен для УКД с уменьшением: Далион присылает корректировку
// (КорректировочныйДокументВходящий) и возврат товаров поставщику
// (ВозвратТоваровПоставщику). Номер ищется в номере самого документа и в номерах
// документов-оснований (приходная, исходный и исправляемый документы), ИНН
// сужает поиск до поставщика. Период - от даты УПД минус 90 дней до сегодня.
//
// Параметры:
//   Номер - Строка - номер УПД или УКД поставщика
//   ИНН   - Строка - ИНН контрагента (необязательно)
//   Дата  - Дата   - дата УПД или УКД (необязательно)
//
// Возвращаемое значение:
//   Структура - как у ОтправитьЗапросДанных
//
Функция ЗапроситьВозвратИКорректировкуПоНомеру(Номер, ИНН = "", Дата = Неопределено) Экспорт

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("numbers", ЭАрМ_Служебный.ЗначениеВМассив(СокрЛП(Номер)));
	Если ЗначениеЗаполнено(ИНН) Тогда
		ПараметрыЗапроса.Вставить("inn", СокрЛП(ИНН));
	КонецЕсли;
	Если ТипЗнч(Дата) = Тип("Дата") И ЗначениеЗаполнено(Дата) Тогда
		ПараметрыЗапроса.Вставить("dateFrom", НачалоДня(Дата - 90 * 86400));
		ПараметрыЗапроса.Вставить("dateTo", КонецДня(ТекущаяДатаСеанса()));
	КонецЕсли;

	Типы = Новый Массив;
	Типы.Добавить("ВозвратПоставщику");
	Типы.Добавить("КорректировкаПоставщика");

	Возврат ОтправитьЗапросДанных(Типы, ПараметрыЗапроса);

КонецФункции

// Запрос договоров поставщиков в Далионе по ИНН (команда «Запросить договор
// в Далионе» реестра УПД).
//
// Кладёт тот же dalion_dataRequest_<GUID>_<ггггММддЧЧммсс>.json, что и остальные
// запросы данных, тем же каналом (FTP или папка запросов, см. ОтправитьТекстВДалион):
//   data = {action: dump, objects: [ДоговорКонтрагента], counterpartyInns: [...]}
// Ответ Далиона (dalion_ДоговорКонтрагента_*) примет обычный регламент приёма
// пакетов, договор запишется в УТ вместе со сроком оплаты (paymentDays).
//
// Пустой список ИНН не отправляется: Далион отдал бы все договоры.
//
// Параметры:
//   ИННы - Массив из Строка - ИНН поставщиков (мусор и повторы отбрасываются)
//
// Возвращаемое значение:
//   Структура - как у ОтправитьЗапросДанных, плюс ИННы (Массив из Строка) - что ушло в запрос
//
Функция ЗапроситьДоговорыПоИНН(ИННы) Экспорт

	Список = НормализоватьИННы(ИННы);

	Если Список.Количество() = 0 Тогда
		Результат = Новый Структура("Успех, Ошибка, ИдентификаторЗапроса, ИмяФайла, Путь, ИННы",
			Ложь, НСтр("ru = 'Нет ИНН поставщика (10 или 12 цифр): запрос договора не отправлен'"),
			"", "", "", Список);
		Возврат Результат;
	КонецЕсли;

	Результат = ОтправитьЗапросДанных("ДоговорКонтрагента",
		Новый Структура("counterpartyInns", Список));
	Результат = Новый Структура("Успех, Ошибка, ИдентификаторЗапроса, ИмяФайла, Путь, ИННы",
		Результат.Успех, Результат.Ошибка, Результат.ИдентификаторЗапроса,
		Результат.ИмяФайла, Результат.Путь, Список);

	Если НЕ Результат.Успех Тогда
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(Результат.ИдентификаторЗапроса,
			"ЗапроситьДоговорыПоИНН (запрос договоров не отправлен)", Результат.Ошибка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Ручной запрос пломбы по сверенным цепочкам (команда setSeal).
//
Функция ЗапроситьПломбыСейчас() Экспорт

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	ЭАрМ_ЦепочкаЗакупки.ЗапроситьПломбы(Настройки);
	ОбновитьСтатусыЗапросов();

	Возврат "Запросы пломбы отправлены по цепочкам на этапе «Сверено» без расхождений";

КонецФункции

// Отмечает, что по исходящему запросу пришёл пакет указанного типа.
//
Процедура ОтметитьПоступлениеПакета(ИдентификаторЗапроса, ТипОбъекта) Экспорт

	Если НЕ ЭтоИдентификаторЗапросаУТ(ИдентификаторЗапроса) Тогда
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЭАрМ_ЗапросыДалион");
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторЗапроса", ИдентификаторЗапроса);
		Блокировка.Заблокировать();

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ЗапросыДалион.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторЗапроса = ИдентификаторЗапроса;
		МенеджерЗаписи.Прочитать();

		Если НЕ МенеджерЗаписи.Выбран() Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		Если МенеджерЗаписи.ТипЗапроса = "setSeal" Тогда
			Если ТипОбъекта = "serviceResponse" Тогда
				МенеджерЗаписи.Статус = СтатусыЗапроса().Получен;
				МенеджерЗаписи.ДатаОтвета = ТекущаяДатаСеанса();
			КонецЕсли;
		Иначе
			МенеджерЗаписи.Получено = ДобавитьТипВСписок(МенеджерЗаписи.Получено, ТипОбъекта);
			Если МенеджерЗаписи.Статус = СтатусыЗапроса().Отправлен Тогда
				МенеджерЗаписи.Статус = СтатусыЗапроса().Получен;
			КонецЕсли;
			МенеджерЗаписи.ДатаОтвета = ТекущаяДатаСеанса();
		КонецЕсли;

		МенеджерЗаписи.Записать(Истина);
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЭАрМ_Служебный.ЗаписатьОшибку("ЗапросыДалион",
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Фиксирует исходящий запрос пломбы в регистре статусов.
//
Процедура ЗафиксироватьЗапросПломбы(ИдентификаторЗапроса, ИдентификаторПоступления, ИмяФайла, Успех, Ошибка) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		Возврат;
	КонецЕсли;

	ЗафиксироватьИсходящий(ИдентификаторЗапроса, "setSeal", ИдентификаторПоступления,
		ИмяФайла, "", ?(Успех, "Запрошена пломба", Ошибка),
		?(Успех, СтатусыЗапроса().ПломбаЗапрошена, СтатусыЗапроса().Ошибка));

КонецПроцедуры

// Фиксирует исходящий serviceRequest editReceiptPrices (правка цены прихода).
//
Процедура ЗафиксироватьЗапросПравкиЦены(ИдентификаторЗапроса, ИдентификаторПоступления, ИмяФайла, Успех, Ошибка) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		Возврат;
	КонецЕсли;

	ЗафиксироватьИсходящий(ИдентификаторЗапроса, "editReceiptPrices", ИдентификаторПоступления,
		ИмяФайла, "", ?(Успех, "Запрошена правка цены прихода", Ошибка),
		?(Успех, СтатусыЗапроса().Отправлен, СтатусыЗапроса().Ошибка));

КонецПроцедуры

// Применяет итог ответа Далиона на editReceiptPrices.
//
Процедура ОтметитьОтветПравкиЦены(ИдентификаторЗапроса, Подтверждено, Комментарий) Экспорт

	Если НЕ ЭтоИдентификаторЗапросаУТ(ИдентификаторЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Статусы = СтатусыЗапроса();
	НовыйСтатус = ?(Подтверждено, Статусы.Обработан, Статусы.Отказ);
	ИзменитьСтатусЗапроса(ИдентификаторЗапроса, НовыйСтатус, Комментарий);

КонецПроцедуры

// Пишет serviceRequest в канал Далиона (FTP incoming или папка запросов).
//
// Параметры:
//   Данные - Структура - поля data пакета (action, documents, …)
//   ИдентификаторСвязи - Строка - для журнала (обычно uid приходной)
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, Путь, ИмяФайла, ИдентификаторЗапроса
//
Функция ОтправитьServiceRequest(Данные, ИдентификаторСвязи = "") Экспорт

	Результат = Новый Структура(
		"Успех, Ошибка, Путь, ИмяФайла, ИдентификаторЗапроса",
		Ложь, "", "", "", Строка(Новый УникальныйИдентификатор));

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();

	Заголовок = Новый Структура;
	Заголовок.Вставить("type",      "serviceRequest");
	Заголовок.Вставить("version",   "1.0");
	Заголовок.Вставить("source",    "UT");
	Заголовок.Вставить("created",   Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Заголовок.Вставить("requestId", Результат.ИдентификаторЗапроса);

	Пакет = Новый Структура("header, data", Заголовок, Данные);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Пакет);
	ТекстJSON = ЗаписьJSON.Закрыть();

	Результат.ИмяФайла = СтрШаблон("dalion_serviceRequest_%1_%2.json",
		Результат.ИдентификаторЗапроса, Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss"));

	Отправка = ОтправитьТекстВДалион(ТекстJSON, Результат.ИмяФайла, Настройки);
	Результат.Успех  = Отправка.Успех;
	Результат.Ошибка = Отправка.Ошибка;
	Результат.Путь   = Отправка.Путь;

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(?(ЗначениеЗаполнено(ИдентификаторСвязи),
			ИдентификаторСвязи, Результат.ИдентификаторЗапроса), 100),
		ОперацияЖурнала(), Результат.Успех,
		?(Результат.Успех, "serviceRequest: " + ЭАрМ_Служебный.СтрокойИлиПусто(Данные.action),
			Результат.Ошибка),
		Результат.ИмяФайла);

	Возврат Результат;

КонецФункции

// Применяет итог ответа пломбы к записи запроса.
//
Процедура ОтметитьОтветПломбы(ИдентификаторЗапроса, СтатусПломбы, Комментарий) Экспорт

	Если НЕ ЭтоИдентификаторЗапросаУТ(ИдентификаторЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Статусы = СтатусыЗапроса();
	НовыйСтатус = Статусы.ПломбаНеУстановлена;
	Если СтатусПломбы = "Установлена" Тогда
		НовыйСтатус = Статусы.ПломбаУстановлена;
	ИначеЕсли СтатусПломбы = "Отказ" Тогда
		НовыйСтатус = Статусы.Отказ;
	КонецЕсли;

	ИзменитьСтатусЗапроса(ИдентификаторЗапроса, НовыйСтатус, Комментарий);

КонецПроцедуры

// Сверяет запрошенные типы с принятыми пакетами и доводит статусы.
//
Процедура ОбновитьСтатусыЗапросов() Экспорт

	Статусы = СтатусыЗапроса();
	СтатусыПакета = ЭАрМ_ПриемПакетовДалион.Статусы();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Запросы.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
	|	Запросы.ТипЗапроса КАК ТипЗапроса,
	|	Запросы.Объекты КАК Объекты,
	|	Запросы.Получено КАК Получено,
	|	Запросы.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЗапросыДалион КАК Запросы
	|ГДЕ
	|	Запросы.Статус В (&Отправлен, &Получен, &ПломбаЗапрошена)";
	Запрос.УстановитьПараметр("Отправлен", Статусы.Отправлен);
	Запрос.УстановитьПараметр("Получен", Статусы.Получен);
	Запрос.УстановитьПараметр("ПломбаЗапрошена", Статусы.ПломбаЗапрошена);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Выборка.ТипЗапроса = "setSeal" Тогда
			Продолжить;
		КонецЕсли;

		Запрошено = СтрРазделить(Выборка.Объекты, ",", Ложь);
		Получено  = СтрРазделить(Выборка.Получено, ",", Ложь);
		ВсеПришли = Запрошено.Количество() > 0;
		ЕстьОшибка = Ложь;
		ВсеОбработаны = Получено.Количество() > 0;

		Для Каждого ТипОбъекта Из Запрошено Цикл
			ТипОбъекта = СокрЛП(ТипОбъекта);
			Если Получено.Найти(ТипОбъекта) = Неопределено Тогда
				ВсеПришли = Ложь;
			КонецЕсли;
			//@skip-check query-in-loop
			ИтогТипа = ИтогПакетовПоЗапросу(Выборка.ИдентификаторЗапроса, ТипОбъекта, СтатусыПакета);
			Если ИтогТипа.Ошибка Тогда
				ЕстьОшибка = Истина;
			КонецЕсли;
			Если НЕ ИтогТипа.Обработан Тогда
				ВсеОбработаны = Ложь;
			КонецЕсли;
		КонецЦикла;

		Если ЕстьОшибка Тогда
			ИзменитьСтатусЗапроса(Выборка.ИдентификаторЗапроса, Статусы.Ошибка,
				"Ошибка обработки пакета ответа");
		ИначеЕсли ВсеПришли И ВсеОбработаны Тогда
			ИзменитьСтатусЗапроса(Выборка.ИдентификаторЗапроса, Статусы.Обработан,
				"Все запрошенные типы получены и разобраны");
		ИначеЕсли ВсеПришли И Выборка.Статус = Статусы.Отправлен Тогда
			ИзменитьСтатусЗапроса(Выборка.ИдентификаторЗапроса, Статусы.Получен,
				"Пакеты ответа приняты");
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

