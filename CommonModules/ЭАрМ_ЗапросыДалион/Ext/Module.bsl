#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Переносит в data запроса только известные Далиону поля: action и objects
// не перезаписываются, даты уходят строкой ISO, штрихкоды - строками.
//
Процедура ДополнитьДанныеЗапроса(Данные, ПараметрыЗапроса)

	Если ТипЗнч(ПараметрыЗапроса) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Значение = Неопределено;

	Если ПараметрыЗапроса.Свойство("periodDays", Значение) И ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
		Данные.Вставить("periodDays", Цел(Значение));
	КонецЕсли;

	Если ПараметрыЗапроса.Свойство("periods", Значение) И ТипЗнч(Значение) = Тип("Структура") Тогда
		Периоды = Новый Структура;
		Для Каждого КлючИЗначение Из Значение Цикл
			Если ТипЗнч(КлючИЗначение.Значение) = Тип("Число") И КлючИЗначение.Значение > 0 Тогда
				Периоды.Вставить(КлючИЗначение.Ключ, Цел(КлючИЗначение.Значение));
			КонецЕсли;
		КонецЦикла;
		Если Периоды.Количество() > 0 Тогда
			Данные.Вставить("periods", Периоды);
		КонецЕсли;
	КонецЕсли;

	Для Каждого ИмяПоля Из СтрРазделить("dateFrom,dateTo", ",", Ложь) Цикл
		Если НЕ ПараметрыЗапроса.Свойство(ИмяПоля, Значение) Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Значение) = Тип("Дата") И ЗначениеЗаполнено(Значение) Тогда
			Данные.Вставить(ИмяПоля, Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
			Данные.Вставить(ИмяПоля, СокрЛП(Значение));
		КонецЕсли;
	КонецЦикла;

	Если ПараметрыЗапроса.Свойство("numbers", Значение) Тогда
		Номера = Новый Массив;
		Для Каждого Номер Из ЭАрМ_Служебный.ЗначениеВМассив(Значение) Цикл
			Текст = СокрЛП(Строка(Номер));
			Если ЗначениеЗаполнено(Текст) И Номера.Найти(Текст) = Неопределено Тогда
				Номера.Добавить(Текст);
			КонецЕсли;
		КонецЦикла;
		Если Номера.Количество() > 0 Тогда
			Данные.Вставить("numbers", Номера);
		КонецЕсли;
	КонецЕсли;

	Если ПараметрыЗапроса.Свойство("inn", Значение) И ЗначениеЗаполнено(СокрЛП(Строка(Значение))) Тогда
		Данные.Вставить("inn", СокрЛП(Строка(Значение)));
	КонецЕсли;

	Если ПараметрыЗапроса.Свойство("counterpartyInns", Значение) Тогда
		ИННы = НормализоватьИННы(Значение);
		Если ИННы.Количество() > 0 Тогда
			Данные.Вставить("counterpartyInns", ИННы);
		КонецЕсли;
	КонецЕсли;

	Если ПараметрыЗапроса.Свойство("barcodes", Значение) Тогда
		Штрихкоды = Новый Массив;
		Для Каждого Штрихкод Из ЭАрМ_Служебный.ЗначениеВМассив(Значение) Цикл
			Текст = ?(ТипЗнч(Штрихкод) = Тип("Число"), Формат(Штрихкод, "ЧГ=0"), СокрЛП(Строка(Штрихкод)));
			Если ЗначениеЗаполнено(Текст) И Штрихкоды.Найти(Текст) = Неопределено Тогда
				Штрихкоды.Добавить(Текст);
			КонецЕсли;
		КонецЦикла;
		Если Штрихкоды.Количество() > 0 Тогда
			Данные.Вставить("barcodes", Штрихкоды);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Далион выгружает заказы и приходные только за дату из запроса.
// Форма раньше слала objects без dateFrom/dateTo - Далион отвечал ошибкой.
//
Процедура ОбеспечитьПериодДокументов(Данные)

	НуженПериод = Ложь;
	Для Каждого ТипОбъекта Из Данные.objects Цикл
		Если ТипОбъекта = "ЗаказПоставщику" ИЛИ ТипОбъекта = "ПриходнаяНакладная"
			ИЛИ ТипОбъекта = "ВозвратПоставщику" ИЛИ ТипОбъекта = "КорректировкаПоставщика" Тогда
			НуженПериод = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НЕ НуженПериод Тогда
		Возврат;
	КонецЕсли;

	Если Данные.Свойство("dateFrom") ИЛИ Данные.Свойство("dateTo")
		ИЛИ Данные.Свойство("periodDays") ИЛИ Данные.Свойство("periods")
		ИЛИ Данные.Свойство("numbers") Тогда
		Возврат;
	КонецЕсли;

	ГлубинаДней = ЭАрМ_НастройкиСервер.ПериодЗапросаДалионаДней();
	ДатаПо = ТекущаяДатаСеанса();
	ДатаС  = НачалоДня(ДатаПо - ГлубинаДней * 86400);

	Данные.Вставить("dateFrom",   Формат(ДатаС, "ДФ=yyyy-MM-dd"));
	Данные.Вставить("dateTo",     Формат(ДатаПо, "ДФ=yyyy-MM-dd"));
	Данные.Вставить("periodDays", ГлубинаДней);

КонецПроцедуры

// Что именно запрошено сверх списка типов: число штрихкодов и период.
// Идёт в комментарий записи регистра запросов.
Функция ОписаниеСоставаЗапроса(Данные)

	Части = Новый Массив;

	Штрихкоды = Неопределено;
	Если Данные.Свойство("barcodes", Штрихкоды) Тогда
		Части.Добавить(СтрШаблон("штрихкодов: %1", Штрихкоды.Количество()));
	КонецЕсли;

	Номера = Неопределено;
	Если Данные.Свойство("numbers", Номера) Тогда
		Части.Добавить("номер " + СтрСоединить(Номера, ", "));
	КонецЕсли;

	ИННы = Неопределено;
	Если Данные.Свойство("counterpartyInns", ИННы) Тогда
		Части.Добавить(СтрШаблон("ИНН поставщиков: %1", СтрСоединить(ИННы, ", ")));
	КонецЕсли;

	ДатаС = Неопределено;
	Если Данные.Свойство("dateFrom", ДатаС) Тогда
		Части.Добавить(СтрШаблон("период %1 - %2", Лев(Строка(ДатаС), 10),
			?(Данные.Свойство("dateTo"), Лев(Строка(Данные.dateTo), 10), "")));
	КонецЕсли;

	Возврат ?(Части.Количество() = 0, "", ": " + СтрСоединить(Части, ", "));

КонецФункции

// ИНН для запроса: только цифры, 10 (юрлицо) или 12 (ИП) знаков, без повторов.
//
Функция НормализоватьИННы(Значение)

	Результат = Новый Массив;

	Для Каждого Элемент Из ЭАрМ_Служебный.ЗначениеВМассив(Значение) Цикл
		ИНН = "";
		Для НомерСимвола = 1 По СтрДлина(Строка(Элемент)) Цикл
			Символ = Сред(Строка(Элемент), НомерСимвола, 1);
			Если Символ >= "0" И Символ <= "9" Тогда
				ИНН = ИНН + Символ;
			КонецЕсли;
		КонецЦикла;
		Если (СтрДлина(ИНН) = 10 ИЛИ СтрДлина(ИНН) = 12) И Результат.Найти(ИНН) = Неопределено Тогда
			Результат.Добавить(ИНН);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НормализоватьСписокОбъектов(Объекты)

	// «Номенклатура» исключена: запрос справочника целиком заваливал очередь
	// обработки пакетов, и приходные не доходили до сопоставления. Карточки
	// товаров приходят внутри заказов и приходных (goods.nomenclature)
	Допустимые = СтрРазделить(
		"Контрагент,ДоговорКонтрагента,Касса,ЗаказПоставщику,ПриходнаяНакладная,"
		+ "ВозвратПоставщику,КорректировкаПоставщика", ",", Ложь);
	Результат = Новый Массив;
	Добавленные = Новый Соответствие;

	Для Каждого Значение Из ЭАрМ_Служебный.ЗначениеВМассив(Объекты) Цикл
		ТипОбъекта = СокрЛП(Строка(Значение));
		Если Допустимые.Найти(ТипОбъекта) = Неопределено ИЛИ Добавленные.Получить(ТипОбъекта) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(ТипОбъекта);
		Добавленные.Вставить(ТипОбъекта, Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОтправитьТекстВДалион(ТекстJSON, ИмяФайла, Настройки)

	Результат = Новый Структура("Успех, Ошибка, Путь", Ложь, "", "");

	Попытка

		Если ВРег(СокрЛП(Настройки.Транспорт)) = "FTP" Тогда

			Отправка = ЭАрМ_ОбщийМодульОбмен.ОтправитьТекстНаFTP(ТекстJSON, ИмяФайла);
			Результат.Успех  = Отправка.Успех;
			Результат.Ошибка = Отправка.Ошибка;
			Результат.Путь   = Отправка.ПутьНаFTP;

		Иначе

			Каталог = СокрЛП(Настройки.КаталогЗапросовДалион);
			Если НЕ ЗначениеЗаполнено(Каталог) Тогда
				ВызватьИсключение "Не указана папка запросов к Далиону";
			КонецЕсли;
			ФайлКаталога = Новый Файл(Каталог);
			Если НЕ ФайлКаталога.Существует() Тогда
				СоздатьКаталог(Каталог);
			КонецЕсли;

			Путь = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Каталог, ИмяФайла);
			ЭАрМ_Служебный.ЗаписатьТекстВФайл(ТекстJSON, Путь + ".tmp");
			ПереместитьФайл(Путь + ".tmp", Путь);

			Результат.Успех = Истина;
			Результат.Путь  = Путь;

		КонецЕсли;

	Исключение
		Результат.Ошибка = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

Процедура ЗафиксироватьИсходящий(ИдентификаторЗапроса, ТипЗапроса, Объекты, ИмяФайла, Тело, Комментарий, Статус)

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_ЗапросыДалион.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторЗапроса = ИдентификаторЗапроса;
	МенеджерЗаписи.ТипЗапроса   = Лев(ТипЗапроса, 50);
	МенеджерЗаписи.Объекты      = Лев(Объекты, 250);
	МенеджерЗаписи.Получено     = "";
	МенеджерЗаписи.Статус       = Лев(Статус, 30);
	МенеджерЗаписи.ДатаОтправки = ТекущаяДатаСеанса();
	МенеджерЗаписи.ДатаОтвета   = '00010101';
	МенеджерЗаписи.ИмяФайла     = Лев(ИмяФайла, 150);
	МенеджерЗаписи.Комментарий  = Лев(Комментарий, 500);
	МенеджерЗаписи.ТелоЗапроса  = Тело;
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

Процедура ИзменитьСтатусЗапроса(ИдентификаторЗапроса, Статус, Комментарий)

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЭАрМ_ЗапросыДалион");
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторЗапроса", ИдентификаторЗапроса);
		Блокировка.Заблокировать();

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ЗапросыДалион.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторЗапроса = ИдентификаторЗапроса;
		МенеджерЗаписи.Прочитать();

		Если НЕ МенеджерЗаписи.Выбран() Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		МенеджерЗаписи.Статус = Статус;
		Если ЗначениеЗаполнено(Комментарий) Тогда
			МенеджерЗаписи.Комментарий = Лев(Комментарий, 500);
		КонецЕсли;
		Если Статус <> СтатусыЗапроса().Отправлен Тогда
			МенеджерЗаписи.ДатаОтвета = ТекущаяДатаСеанса();
		КонецЕсли;

		МенеджерЗаписи.Записать(Истина);
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЭАрМ_Служебный.ЗаписатьОшибку("ЗапросыДалион",
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция ИтогПакетовПоЗапросу(ИдентификаторЗапроса, ТипОбъекта, СтатусыПакета)

	Результат = Новый Структура("Обработан, Ошибка", Ложь, Ложь);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 50
	|	Пакеты.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПакетыДалион КАК Пакеты
	|ГДЕ
	|	Пакеты.ТипОбъекта = &ТипОбъекта
	|	И Пакеты.НомерОбъекта = &ИдентификаторЗапроса";
	Запрос.УстановитьПараметр("ТипОбъекта", ТипОбъекта);
	Запрос.УстановитьПараметр("ИдентификаторЗапроса", Лев(ИдентификаторЗапроса, 50));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		// Документы кладут в НомерОбъекта номер документа, а не requestId.
		// Тип уже попал в Получено при приёме — считаем его закрытым этим проходом.
		Результат.Обработан = Истина;
		Возврат Результат;
	КонецЕсли;

	Результат.Обработан = Истина;
	Пока Выборка.Следующий() Цикл
		Если Выборка.Статус = СтатусыПакета.Ошибка Тогда
			Результат.Ошибка = Истина;
			Результат.Обработан = Ложь;
		ИначеЕсли Выборка.Статус <> СтатусыПакета.Обработан Тогда
			Результат.Обработан = Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЭтоИдентификаторЗапросаУТ(ИдентификаторЗапроса)

	Значение = СокрЛП(Строка(ИдентификаторЗапроса));
	Возврат СтрДлина(Значение) = 36 И СтрНайти(Значение, "-") > 0;

КонецФункции

Функция ДобавитьТипВСписок(ТекущийСписок, ТипОбъекта)

	Части = СтрРазделить(Строка(ТекущийСписок), ",", Ложь);
	Если Части.Найти(ТипОбъекта) = Неопределено Тогда
		Части.Добавить(ТипОбъекта);
	КонецЕсли;

	Возврат Лев(СтрСоединить(Части, ","), 250);

КонецФункции

Функция ТаблицаЗапросов()

