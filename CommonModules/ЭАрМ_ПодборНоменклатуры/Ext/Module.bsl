		РезультатНовый.Номенклатура, РезультатНовый.Score, РезультатНовый.Источник,
		РезультатСтарый.Номенклатура, РезультатСтарый.Score, РезультатСтарый.Источник);
	
	ЗаписьЖурналаРегистрации(
		"АРМ_ЭДО.ДвойнойПрогон",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		Текст);
	
КонецПроцедуры

#КонецОбласти

#Область Вспомогательные

// Новый результат подбора.
//
Функция НовыйРезультатПодбора()
	
	Результат = Новый Структура;
	Результат.Вставить("Номенклатура", Неопределено);
	Результат.Вставить("Score", 0);
	Результат.Вставить("Источник", "");
	Результат.Вставить("Статус", "");
	Результат.Вставить("Кандидаты", Новый Массив);
	Результат.Вставить("Расхождение", Неопределено);
	Возврат Результат;
	
КонецФункции

// Заполнение результата подбора.
//
Процедура ЗаполнитьРезультат(Результат, Номенклатура, Score, Источник, Статус)
	
	Результат.Номенклатура = Номенклатура;
	Результат.Score = Score;
	Результат.Источник = Источник;
	Результат.Статус = Статус;
	
КонецПроцедуры

