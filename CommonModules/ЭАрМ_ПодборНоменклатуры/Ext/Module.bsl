// Поиск номенклатуры по коду/артикулу поставщика.
//
Функция НоменклатураПоКодуПоставщика(КодТовара, ИННПоставщика)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Штрихкоды.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.КодТовараПоставщика = &КодТовара
	|	И (&ИННПоставщика = """" Или Штрихкоды.ИННПоставщика = &ИННПоставщика)";
	Запрос.УстановитьПараметр("КодТовара", КодТовара);
	Запрос.УстановитьПараметр("ИННПоставщика", ИННПоставщика);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Номенклатура, Неопределено);
	
КонецФункции

// Поиск номенклатуры по нормализованному наименованию.
//
Функция НоменклатураПоНаименованию(НормИмя)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	ВРег(Номенклатура.Наименование) = &НормИмя
	|	И НЕ Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("НормИмя", НормИмя);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Номенклатура, Неопределено);
	
КонецФункции

// Поиск по имени с учётом веса/объёма/процентов.
// Разбирает токены «1 л», «3,2%», «500 г», «0,5кг» и ищет точное совпадение
// имени БЕЗ весовых токенов + совпадение весовых параметров.
//
Функция НоменклатураПоИмениСВесом(НормИмя)
	
	Части = РазобратьИмяСВесом(НормИмя);
	Если Части.БезВеса = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 5
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	ВРег(Номенклатура.Наименование) ПОДОБНО &Маска
	|	И НЕ Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("Маска", "%" + Части.БезВеса + "%");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЧастиКандидата = РазобратьИмяСВесом(ВРег(Выборка.Наименование));
		Если ЧастиКандидата.Вес = Части.Вес
			И ЧастиКандидата.Единица = Части.Единица
			И ЧастиКандидата.БезВеса = Части.БезВеса Тогда
			Возврат Выборка.Номенклатура;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Разбор имени на базовую часть и весовые токены.
// Возвращает: {БезВеса, Вес, Единица, Процент}
//
Функция РазобратьИмяСВесом(НормИмя) Экспорт
	
	Результат = Новый Структура("БезВеса, Вес, Единица, Процент", НормИмя, "", "", "");
	
	// Паттерны весовых токенов в конце или середине имени
	// «500 г», «1 л», «3,2%», «0,5кг», «250 мл», «1,5 Л»
	МассивПаттернов = Новый Массив;
	МассивПаттернов.Добавить("(\d+[.,]?\d*)\s*(%|ПРОЦ|ПРОЦЕНТ[А-Я]*)$");
	МассивПаттернов.Добавить("(\d+[.,]?\d*)\s*(КГ|Г|КГР|ГР|Т)$");
	МассивПаттернов.Добавить("(\d+[.,]?\d*)\s*(Л|МЛ|ЛТР|ЛИТР[А-Я]*)$");
	МассивПаттернов.Добавить("(\d+[.,]?\d*)\s*(ШТ|ШТУК[А-Я]*|УП|УПАК[А-Я]*)$");
	
	Для Каждого Паттерн Из МассивПаттернов Цикл
		// Упрощённый поиск: ищем число + единицу в конце строки
		Слова = СтрРазделить(СокрЛП(НормИмя), " ");
		Если Слова.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		
		Последнее = Слова[Слова.Количество() - 1];
		Предпоследнее = Слова[Слова.Количество() - 2];
		
		// Проверяем: предпоследнее = число, последнее = единица
		Вес = ТолькоЦифры(Предпоследнее);
		Единица = ВРег(Последнее);
		Допустимые = "КГ,Г,КГР,ГР,Т,Л,МЛ,ЛТР,ЛИТР,ШТ,ШТУК,УП,УПАК,%,ПРОЦ,ПРОЦЕНТ";
		
		Если СтрДлина(Вес) > 0 И СтрНайти(Допустимые, Единица) > 0 Тогда
			Результат.Вес = Вес;
			Результат.Единица = Единица;
			Если Единица = "%" Или Единица = "ПРОЦ" Тогда
				Результат.Процент = Вес;
			КонецЕсли;
			// Убираем весовой токен из имени
			БезВеса = "";
			Для Индекс = 0 По Слова.Количество() - 3 Цикл
				БезВеса = БезВеса + ?(Индекс > 0, " ", "") + Слова[Индекс];
			КонецЦикла;
			Результат.БезВеса = СокрЛП(БезВеса);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Поиск по пересечению токенов имени.
// Порог: ≥ 0.8 от меньшего набора токенов (Jaccard-подобная мера).
//
Функция НоменклатураПоПересечениюТокенов(НормИмя)
	
	ТокеныЭталона = ТокеныИмени(НормИмя);
	Если ТокеныЭталона.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Ищем кандидатов с общими токенами
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 20
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления
	|	И (";
	
	Условия = Новый Массив;
	Для Индекс = 0 По Мин(ТокеныЭталона.Количество(), 5) - 1 Цикл
		Условия.Добавить("ВРег(Номенклатура.Наименование) ПОДОБНО &Токен" + Индекс);
	КонецЦикла;
	Запрос.Текст = Запрос.Текст + СтрСоединить(Условия, " ИЛИ ") + ")";
	
	Для Индекс = 0 По Мин(ТокеныЭталона.Количество(), 5) - 1 Цикл
		Запрос.УстановитьПараметр("Токен" + Индекс, "%" + ТокеныЭталона[Индекс] + "%");
	КонецЦикла;
	
	Выборка = Запрос.Выполнить().Выбрать();
	ЛучшийScore = 0;
	Лучший = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		ТокеныКандидата = ТокеныИмени(ВРег(Выборка.Наименование));
		Score = ДоляПересеченияТокенов(ТокеныЭталона, ТокеныКандидата);
		Если Score >= 0.8 И Score > ЛучшийScore Тогда
			ЛучшийScore = Score;
			Лучший = Выборка.Номенклатура;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Лучший;
	
КонецФункции

// Разбиение имени на токены (слова без стоп-слов).
//
Функция ТокеныИмени(НормИмя) Экспорт
	
	СтопСлова = " И , С , ДЛЯ , В , НА , ПО , ИЗ , К , О , БЕЗ , ДО , ПОСЛЕ , ЧЕРЕЗ ";
	Токены = Новый Массив;
	Слова = СтрРазделить(СокрЛП(НормИмя), " ");
	
	Для Каждого Слово Из Слова Цикл
		Токен = СокрЛП(Слово);
		Если СтрДлина(Токен) < 2 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(СтопСлова, " " + Токен + " ") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Токены.Добавить(Токен);
	КонецЦикла;
	
	Возврат Токены;
	
КонецФункции

// Доля пересечения токенов (от меньшего набора).
//
Функция ДоляПересеченияТокенов(ТокеныА, ТокеныБ) Экспорт
	
	Если ТокеныА.Количество() = 0 Или ТокеныБ.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Минимум = Мин(ТокеныА.Количество(), ТокеныБ.Количество());
	Пересечение = 0;
	
	Для Каждого Токен Из ТокеныА Цикл
		Если ТокеныБ.Найти(Токен) <> Неопределено Тогда
			Пересечение = Пересечение + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Пересечение / Минимум;
	
КонецФункции

// Кандидаты по поставщику и категории из РС ЭАрМ_ШтрихкодыПоставщиков.
//
Функция КандидатыПоПоставщику(Строка)
	
	Кандидаты = Новый Массив;
	
	Если Не ЗначениеЗаполнено(Строка.ИННПоставщика) Тогда
		Возврат Кандидаты;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 10
	|	Штрихкоды.Номенклатура КАК Номенклатура,
	|	Штрихкоды.НазваниеУПоставщика КАК Название,
	|	Штрихкоды.КодТовараПоставщика КАК Код
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.ИННПоставщика = &ИНН
	|	И НЕ Штрихкоды.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И (Штрихкоды.НазваниеУПоставщика ПОДОБНО &Маска
	|		ИЛИ Штрихкоды.КодТовараПоставщика = &Код)";
	Запрос.УстановитьПараметр("ИНН", Строка.ИННПоставщика);
	Запрос.УстановитьПараметр("Маска", "%" + Лев(Строка.Наименование, 20) + "%");
	Запрос.УстановитьПараметр("Код", Строка.КодТовара);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Кандидат = Новый Структура;
		Кандидат.Вставить("Номенклатура", Выборка.Номенклатура);
		Кандидат.Вставить("Название", Выборка.Название);
		Кандидат.Вставить("Код", Выборка.Код);
		Кандидат.Вставить("Score", 0.60);
		Кандидаты.Добавить(Кандидат);
	КонецЦикла;
	
	Возврат Кандидаты;
	
КонецФункции

// Запись ошибки подбора.
//
Процедура ЗаписатьОшибкуПодбора(ИмяМетода, ИнформацияОбОшибке)
	
	ЗаписьЖурналаРегистрации(
		"АРМ_ЭДО.ПодборНоменклатуры",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		СтрШаблон("%1: %2", ИмяМетода, КраткоеПредставлениеОшибки(ИнформацияОбОшибке)));
	
КонецПроцедуры

#КонецОбласти
