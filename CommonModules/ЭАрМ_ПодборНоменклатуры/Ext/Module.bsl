// Паттерн «Фасад над хаосом» + «Двойной прогон».
// Единая точка входа для поиска/сопоставления номенклатуры.
// Заменяет разрозненные: НоменклатураПоШтрихкоду (×2), НайтиПару (×5),
// НайтиНоменклатуруПоШК, НайтиТоварыПрихода, НазначитьШтрихкоды, СоздатьПоКатегории.
//
// Режим «ТолькоЛог» (двойной прогон): новый каскад считает результат,
// сравнивает со старой логикой и пишет расхождения, НЕ применяя решение.
// Включается настройкой Подбор_ТолькоЛог = Истина.

#Область ПрограммныйИнтерфейс

// Единая точка входа: каскад подбора номенклатуры с уровнем уверенности (score).
//
// Параметры:
//   Строка - Структура - данные строки товара:
//     * Штрихкод        - Строка
//     * КодТовара       - Строка - код/артикул поставщика
//     * Наименование    - Строка
//     * ИННПоставщика   - Строка
//     * Категория       - Строка - необязательно
//   Режим  - Строка - "Автомат" (по умолчанию) или "ТолькоЛог" (двойной прогон)
//
// Возвращаемое значение:
//   Структура:
//     * Номенклатура - СправочникСсылка.Номенклатура - Неопределено если не найдено
//     * Score        - Число  - 0.00 … 1.00
//     * Источник     - Строка - "Штрихкод", "КодПоставщика", "Наименование", ...
//     * Статус       - Строка - "Найдено", "Кандидат", "Создать", "ТолькоЛог"
//     * Кандидаты    - Массив - если Статус = "Кандидат"
//     * Расхождение  - Структура - если двойной прогон нашёл расхождение
//
Функция НайтиТовар(Строка, Режим = "Автомат") Экспорт
	
	Результат = НовыйРезультатПодбора();
	
	// Двойной прогон: считаем по-новому и по-старому, сравниваем
	Если Режим = "ТолькоЛог" Или Подбор_ТолькоЛог() Тогда
		Возврат ДвойнойПрогон(Строка, Результат);
	КонецЕсли;
	
	// Основной каскад 1-7
	КаскадПодбора(Строка, Результат);
	
	Возврат Результат;
	
КонецФункции

// Быстрый поиск только по штрихкоду (замена НоменклатураПоШтрихкоду ×2).
//
// Параметры:
//   Штрихкод - Строка - штрихкод или GTIN (возможно несколько через ;)
//
// Возвращаемое значение:
//   СправочникСсылка.Номенклатура или Неопределено
//
Функция НоменклатураПоШтрихкоду(Штрихкод) Экспорт
	
	Варианты = ВариантыШтрихкода(Штрихкод);
	Если Варианты.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Штрихкоды.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод В (&Штрихкоды)";
	Запрос.УстановитьПараметр("Штрихкоды", Варианты);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Номенклатура, Неопределено);
	
КонецФункции

// Канонический штрихкод: EAN-13 / GTIN-14 с ведущим нулём / GS1 AI 01.
// Единая реализация (заменяет дубли из СверкаТоваровЦепочки и АСЭДО_Штрихкоды).
//
Функция КаноническийШтрихкод(Штрихкод) Экспорт
	
	Цифры = ТолькоЦифры(Штрихкод);
	
	// GS1 AI 01 (GTIN-14 в составе кода маркировки)
	Если СтрДлина(Цифры) >= 16 И Лев(Цифры, 2) = "01" Тогда
		Цифры = Сред(Цифры, 3, 14);
	КонецЕсли;
	
	// UPC-A (12 цифр) → EAN-13
	Если СтрДлина(Цифры) = 12 Тогда
		Цифры = "0" + Цифры;
	КонецЕсли;
	
	// GTIN-14 с ведущим нулём → EAN-13
	Если СтрДлина(Цифры) = 14 И Лев(Цифры, 1) = "0" Тогда
		Возврат Сред(Цифры, 2);
	КонецЕсли;
	
	Возврат Цифры;
	
КонецФункции

// Ключ записи регистра штрихкодов: канонический ШК + нормализованное имя.
// Один штрихкод не ляжет дважды.
//
Функция КлючЗаписиШтрихкода(Штрихкод, КлючНаименования) Экспорт
	
	Канон = КаноническийШтрихкод(Штрихкод);
	Если Не ЗначениеЗаполнено(Канон) Тогда
		Канон = ВРег(СокрЛП(Штрихкод));
	КонецЕсли;
	
	Возврат Канон + "|" + СокрЛП(КлючНаименования);
	
КонецФункции

// Пакетный подбор: сопоставление массива эталонов с массивом кандидатов.
// Замена/обёртка для НайтиПару в ЭАрМ_СверкаТоваровЦепочки.
//
// Параметры:
//   Эталоны   - Массив - строки эталонов (Структура: Штрихкод, Наименование, КодТовара, ...)
//   Кандидаты - Массив - строки кандидатов (та же структура + Использована)
//   Настройки - Структура - настройки сверки (ТолькоШтрихкодИКод и т.д.)
//
// Возвращаемое значение:
//   Массив - пары [{Эталон, Кандидат, Score, Источник}]
//
Функция НайтиПарыПакетом(Эталоны, Кандидаты, Настройки = Неопределено) Экспорт

	Пары = Новый Массив;

	Для Каждого Эталон Из Эталоны Цикл

		ЛучшийКандидат = Неопределено;
		ЛучшийScore = 0;
		ЛучшийИсточник = "";

		Для Каждого Кандидат Из Кандидаты Цикл

			Если Кандидат.Свойство("Использована") И Кандидат.Использована Тогда
				Продолжить;
			КонецЕсли;

			// Каскад сравнения (по убыванию надёжности)
			Если ШтрихкодыСовпадают(Эталон.Штрихкод, Кандидат.Штрихкод) Тогда
				Если 1.00 > ЛучшийScore Тогда
					ЛучшийScore = 1.00;
					ЛучшийКандидат = Кандидат;
					ЛучшийИсточник = "Штрихкод";
				КонецЕсли;
			ИначеЕсли ЗначениеЗаполнено(Эталон.КодТовара)
				И Эталон.КодТовара = Кандидат.КодТовара Тогда
				Если 0.95 > ЛучшийScore Тогда
					ЛучшийScore = 0.95;
					ЛучшийКандидат = Кандидат;
					ЛучшийИсточник = "КодПоставщика";
				КонецЕсли;
			ИначеЕсли НормализоватьИмя(Эталон.Наименование) = НормализоватьИмя(Кандидат.Наименование) Тогда
				Если 0.90 > ЛучшийScore Тогда
					ЛучшийScore = 0.90;
					ЛучшийКандидат = Кандидат;
					ЛучшийИсточник = "Наименование";
				КонецЕсли;
			Иначе
				ТокеныА = ТокеныИмени(НормализоватьИмя(Эталон.Наименование));
				ТокеныБ = ТокеныИмени(НормализоватьИмя(Кандидат.Наименование));
				Score = ДоляПересеченияТокенов(ТокеныА, ТокеныБ);
				Если Score >= 0.8 И Score > ЛучшийScore Тогда
					ЛучшийScore = Score;
					ЛучшийКандидат = Кандидат;
					ЛучшийИсточник = "Токены";
				КонецЕсли;
			КонецЕсли;

		КонецЦикла;

		Если ЛучшийКандидат <> Неопределено Тогда
			Пара = Новый Структура;
			Пара.Вставить("Эталон", Эталон);
			Пара.Вставить("Кандидат", ЛучшийКандидат);
			Пара.Вставить("Score", ЛучшийScore);
			Пара.Вставить("Источник", ЛучшийИсточник);
			Пары.Добавить(Пара);

			// Помечаем кандидата как использованного
			Если ЛучшийКандидат.Свойство("Использована") Тогда
				ЛучшийКандидат.Использована = Истина;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Возврат Пары;

КонецФункции

// Проверка совпадения штрихкодов (с учётом канонизации).
//
Функция ШтрихкодыСовпадают(ШК1, ШК2)

	Если Не ЗначениеЗаполнено(ШК1) Или Не ЗначениеЗаполнено(ШК2) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат КаноническийШтрихкод(ШК1) = КаноническийШтрихкод(ШК2);

КонецФункции

// Только цифры из строки. Единая реализация (заменяет 7 копий).
// Если через ";" — берётся первый код (как в ЭАрМ_ЧестныйЗнак).
//
Функция ТолькоЦифры(Значение) Экспорт
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Текст = СокрЛП(Строка(Значение));
	// Несколько штрихкодов через ";" - берётся первый
	Если СтрНайти(Текст, ";") > 0 Тогда
		Текст = Лев(Текст, СтрНайти(Текст, ";") - 1);
	КонецЕсли;
	Результат = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Варианты штрихкода для поиска: GTIN-14 → EAN-13 и наоборот.
// Единая реализация (заменяет дубли).
//
Функция ВариантыШтрихкода(Штрихкод) Экспорт
	
	Варианты = Новый Массив;
	Текст = СтрЗаменить(СокрЛП(Штрихкод), ",", ";");
	Для Каждого Часть Из СтрРазделить(Текст, ";", Ложь) Цикл
		Код = СокрЛП(Часть);
		Если Не ЗначениеЗаполнено(Код) Тогда
			Продолжить;
		КонецЕсли;
		Варианты.Добавить(Код);
		Если СтрДлина(Код) = 14 И СтрНачинаетсяС(Код, "0") Тогда
			Варианты.Добавить(Сред(Код, 2));
		ИначеЕсли СтрДлина(Код) = 13 Тогда
			Варианты.Добавить("0" + Код);
		КонецЕсли;
	КонецЦикла;
	Возврат Варианты;
	
КонецФункции

// Нормализация наименования: Ё→Е, латиница→кириллица, без пунктуации.
//
Функция НормализоватьИмя(Наименование) Экспорт
	
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Возврат "";
	КонецЕсли;
	
	Текст = ВРег(СокрЛП(Строка(Наименование)));
	Текст = СтрЗаменить(Текст, "Ё", "Е");
	
	// Убираем пунктуацию
	Текст = СтрЗаменить(Текст, ".", " ");
	Текст = СтрЗаменить(Текст, ",", " ");
	Текст = СтрЗаменить(Текст, "-", " ");
	Текст = СтрЗаменить(Текст, "/", " ");
	Текст = СтрЗаменить(Текст, "\", " ");
	Текст = СтрЗаменить(Текст, "(", " ");
	Текст = СтрЗаменить(Текст, ")", " ");
	Текст = СтрЗаменить(Текст, """", " ");
	
	// Схлопываем пробелы
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	
	Возврат СокрЛП(Текст);
	
КонецФункции

#КонецОбласти

#Область КаскадПодбора

// Основной каскад: 7 уровней с убыванием score.
//
Процедура КаскадПодбора(Строка, Результат)
	
	// 1. Канонический штрихкод (score = 1.00)
	Если ЗначениеЗаполнено(Строка.Штрихкод) Тогда
		Ном = НоменклатураПоШтрихкоду(Строка.Штрихкод);
		Если ЗначениеЗаполнено(Ном) Тогда
			ЗаполнитьРезультат(Результат, Ном, 1.00, "Штрихкод", "Найдено");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// 2. Артикул / код поставщика (score = 0.95)
	Если ЗначениеЗаполнено(Строка.КодТовара) Тогда
		Ном = НоменклатураПоКодуПоставщика(Строка.КодТовара, Строка.ИННПоставщика);
		Если ЗначениеЗаполнено(Ном) Тогда
			ЗаполнитьРезультат(Результат, Ном, 0.95, "КодПоставщика", "Найдено");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// 3. Точное нормализованное имя (score = 0.90)
	НормИмя = НормализоватьИмя(Строка.Наименование);
	Если ЗначениеЗаполнено(НормИмя) Тогда
		Ном = НоменклатураПоНаименованию(НормИмя);
		Если ЗначениеЗаполнено(Ном) Тогда
			ЗаполнитьРезультат(Результат, Ном, 0.90, "Наименование", "Найдено");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// 4. Имя + вес/объём/проценты (score = 0.85)
	Если ЗначениеЗаполнено(НормИмя) Тогда
		Ном = НоменклатураПоИмениСВесом(НормИмя);
		Если ЗначениеЗаполнено(Ном) Тогда
			ЗаполнитьРезультат(Результат, Ном, 0.85, "ИмяСВесом", "Найдено");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// 5. Пересечение токенов имени (score = 0.75)
	Если ЗначениеЗаполнено(НормИмя) Тогда
		Ном = НоменклатураПоПересечениюТокенов(НормИмя);
		Если ЗначениеЗаполнено(Ном) Тогда
			ЗаполнитьРезультат(Результат, Ном, 0.75, "ПересечениеТокенов", "Найдено");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// 6. Косвенная связь: тот же поставщик + категория (score = 0.60)
	Кандидаты = КандидатыПоПоставщику(Строка);
	Если Кандидаты.Количество() > 0 Тогда
		Результат.Кандидаты = Кандидаты;
		ЗаполнитьРезультат(Результат, Неопределено, 0.60, "ПоставщикКатегория", "Кандидат");
		Возврат;
	КонецЕсли;
	
	// 7. Ничего не найдено → создать карточку (только с решением оператора)
	ЗаполнитьРезультат(Результат, Неопределено, 0.00, "", "Создать");
	
КонецПроцедуры

#КонецОбласти

#Область ДвойнойПрогон

// Двойной прогон: считает по новому каскаду И по старой логике,
// пишет расхождения в журнал, возвращает результат СТАРОЙ логики
// (чтобы не сломать текущее поведение).
//
Функция ДвойнойПрогон(Строка, Результат)
	
	// Новый каскад
	РезультатНовый = НовыйРезультатПодбора();
	КаскадПодбора(Строка, РезультатНовый);
	
	// Старая логика (заглушка — вызывать существующие функции)
	РезультатСтарый = СтарыйПоиск(Строка);
	
	// Сравнение
	Если РезультатНовый.Номенклатура <> РезультатСтарый.Номенклатура
		Или РезультатНовый.Статус <> РезультатСтарый.Статус Тогда
		
		Расхождение = Новый Структура;
		Расхождение.Вставить("Строка", Строка);
		Расхождение.Вставить("Новый", РезультатНовый);
		Расхождение.Вставить("Старый", РезультатСтарый);
		
		Результат.Расхождение = Расхождение;
		ЗаписатьРасхождениеДвойногоПрогона(Строка, РезультатНовый, РезультатСтарый);
	КонецЕсли;
	
	// Возвращаем СТАРЫЙ результат (не ломаем текущее поведение)
	Результат.Номенклатура = РезультатСтарый.Номенклатура;
	Результат.Score = РезультатСтарый.Score;
	Результат.Источник = РезультатСтарый.Источник;
	Результат.Статус = "ТолькоЛог";
	
	Возврат Результат;
	
КонецФункции

// Старая логика поиска (точка подключения существующего кода).
// Пока заглушка — постепенно переносить сюда вызовы из старых модулей.
//
Функция СтарыйПоиск(Строка)
	
	Результат = НовыйРезультатПодбора();
	
	// Старый путь: прямой поиск по штрихкоду через существующую логику
	Попытка
		Если ЗначениеЗаполнено(Строка.Штрихкод) Тогда
			Ном = НоменклатураПоШтрихкоду(Строка.Штрихкод);
			Если ЗначениеЗаполнено(Ном) Тогда
				ЗаполнитьРезультат(Результат, Ном, 1.00, "Штрихкод(старый)", "Найдено");
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.Наименование) Тогда
			Ном = НоменклатураПоНаименованию(ВРег(СокрЛП(Строка.Наименование)));
			Если ЗначениеЗаполнено(Ном) Тогда
				ЗаполнитьРезультат(Результат, Ном, 0.90, "Наименование(старый)", "Найдено");
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписатьОшибкуПодбора("СтарыйПоиск", ИнформацияОбОшибке());
	КонецПопытки;
	
	ЗаполнитьРезультат(Результат, Неопределено, 0.00, "", "Создать");
	Возврат Результат;
	
КонецФункции

// Запись расхождения двойного прогона в журнал.
//
Процедура ЗаписатьРасхождениеДвойногоПрогона(Строка, РезультатНовый, РезультатСтарый)
	
