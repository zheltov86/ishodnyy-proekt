////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_СверкаТоваровЦепочки: штрихкоды поставщиков и построчная сверка
// заказа поставщику, поступления Далиона, УПД и ЭТрН.
//
// Номенклатуру в Далионе вводят люди, наименования у поставщика свои, поэтому
// строки сопоставляются по убыванию надёжности:
//   1. штрихкод        - общий у строк (у Далиона свой, у УПД - GTIN или
//                        назначенный по регистру ЭАрМ_ШтрихкодыПоставщиков);
//   2. номенклатура    - один uid Далиона (заказ и поступление одной базы);
//   3. код / артикул;
//   4. словарь пар     - уже сходившиеся имена из ЭАрМ_ПарыНоменклатурыПоИмени;
//   5. наименование    - точное после нормализации (способ Наименование),
//                        иначе оценка 0–1 с опечатками и склейкой слов
//                        (способ НаименованиеПохоже, порог 0.8): «Киндер
//                        Молочный ломтик 27,9% 28гр (20шт)» = «БЗМЖ Пирожное
//                        Киндер Молочный ломтик 28гр». Отличающее слово с
//                        обеих сторон («яблоко» ↔ «апельсин») пару закрывает.
//                        Из нескольких кандидатов берётся лучшая оценка,
//                        не первый подходящий;
//   6. цена и количество - только для пары заказ-поступление и только если
//                        кандидат единственный.
// Эталон номенклатуры - заказ. Строка поступления, совпавшая со строкой заказа,
// но с другой номенклатурой, помечается "НоменклатураПНОшибочна", а с УПД
// сравнивается уже номенклатура заказа.
//
// УПД считается сошедшейся (зелёная, можно утверждать), если есть приходная
// и ЭТрН — само наличие, без сверки строк. Либо все строки прихода и УПД
// сопоставлены и совпали количество и цена. Штрихкод —
// первый ключ (EAN-13, GTIN-14, UPC-A и префикс GS1 01 считаются одним).
// Если штрихкоды разные или их нет, пара ищется по имени: словарь известных
// пар, точное после очистки знаков, затем оценка похожести (опечатки,
// склейка «Молокопитьевое», штраф за отличающее слово).
// Расхождения ЭТрН и заказа (недовоз, лишние строки) на цвет УПД, признак
// расхождений цепочки и запрос пломбы не влияют - они только в тексте сверки.
//
// Цена единицы - из табчасти: у прихода поле Цена (price / ratio), у УПД
// ЦенаТов. Сходится, если цены в допуске или (для веса) суммы не дальше
// цены × допуск количества. Сумму для упаковки берём с НДС.
// Количество штук сходится при равенстве или как упаковка: целое кратное ≥ 2
// и суммы в допуске цены. Сумма сама по себе количество не закрывает.
// Вес (кг/г/л или дробное количество): допуск 50 г или 1% от большей стороны.
// Коробка УПД против штук Далиона закрывается через quantity и ratio прихода.
// Одинаковый штрихкод (иначе имя) в УПД и приходе склеивается в одну линию:
// строка реестра и зелёная УПД считают одно количество.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Сверяет цепочки, в которых что-то поменялось после прошлой сверки, и
// цепочки, сверенные до смены правил или настроек сверки (см.
// ДатаАктуальностиСверки). Закрытые цепочки (пломба стоит) не берутся.
//
// За проход - не больше Настройки.ЦепочекЗаСеанс. Сначала УПД, у которых
// приходная уже есть, а строка реестра ещё не зелёная: выгрузка истории
// иначе занимает весь проход старыми цепочками. Дальше - свежие изменения.
// ДатаСверкиС и ДатаСверкиПо, если заданы, - тот же период, что открыт
// в реестре УПД: сверяются только УПД с датой внутри него.
//
// Параметры:
//   Настройки - Структура - см. ЭАрМ_НастройкиСервер.НастройкиЦепочки
//
Процедура СверитьЦепочки(Настройки) Экспорт

	ЦепочекЗаСеанс = Неопределено;
	Если НЕ Настройки.Свойство("ЦепочекЗаСеанс", ЦепочекЗаСеанс) ИЛИ НЕ ЗначениеЗаполнено(ЦепочекЗаСеанс) Тогда
		ЦепочекЗаСеанс = 200;
	КонецЕсли;

	ДатаСверкиС = '00010101';
	ДатаСверкиПо = '00010101';
	Если Настройки.Свойство("ДатаСверкиС") И ЗначениеЗаполнено(Настройки.ДатаСверкиС) Тогда
		ДатаСверкиС = НачалоДня(Настройки.ДатаСверкиС);
	КонецЕсли;
	Если Настройки.Свойство("ДатаСверкиПо") И ЗначениеЗаполнено(Настройки.ДатаСверкиПо) Тогда
		ДатаСверкиПо = КонецДня(Настройки.ДатаСверкиПо);
	КонецЕсли;

	Запрос = Новый Запрос;
	// УПД с уже пришедшей приходной, у которой в реестре ещё нет итога сверки,
	// идут первыми. Иначе выгрузка истории заполняет все 200 мест старыми
	// цепочками, и строка с приходом остаётся незелёной до клика.
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ ПЕРВЫЕ %1
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО Цепочка.ИдентификаторУПД = УПД.ИдентификаторСБИС
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления <> """"
	|	И Цепочка.Этап <> ""Закрыто""
	|	И (Цепочка.ДатаСверки < Цепочка.ДатаОбновления
	|			ИЛИ Цепочка.ДатаСверки < &ДатаАктуальности
	|			ИЛИ Цепочка.ИдентификаторУПД <> """"
	|				И ЕСТЬNULL(УПД.РасхожденийНет, ЛОЖЬ) = ЛОЖЬ
	|				И ЕСТЬNULL(УПД.ТекстСверки, """") = """")
	|	И (&НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ УПД.Дата >= &НачалоПериода)
	|	И (&КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ УПД.Дата <= &КонецПериода)
	|	И (НЕ &Ограничено
	|			ИЛИ Цепочка.ИдентификаторПоступления В (&ТолькоОбъекты))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА Цепочка.ИдентификаторУПД <> """"
	|				И ЕСТЬNULL(УПД.РасхожденийНет, ЛОЖЬ) = ЛОЖЬ
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ,
	|	Цепочка.ДатаОбновления УБЫВ", Формат(ЦепочекЗаСеанс, "ЧГ=0"));
	Запрос.УстановитьПараметр("ДатаАктуальности", ДатаАктуальностиСверки(Настройки));
	Запрос.УстановитьПараметр("НачалоПериода", ДатаСверкиС);
	Запрос.УстановитьПараметр("КонецПериода", ДатаСверкиПо);
	// Тест приёма и сверки сверяет только свои цепочки (ЭАрМ_ПриемПакетовДалион.ВыполнитьВручную)
	ТолькоОбъекты = Неопределено;
	Настройки.Свойство("ТолькоОбъекты", ТолькоОбъекты);
	Запрос.УстановитьПараметр("Ограничено", ТипЗнч(ТолькоОбъекты) = Тип("Массив"));
	Запрос.УстановитьПараметр("ТолькоОбъекты", ?(ТипЗнч(ТолькоОбъекты) = Тип("Массив"), ТолькоОбъекты, Новый Массив));

	Выборка = Запрос.Выполнить().Выбрать();
	ЭАрМ_ПриемПакетовДалион.Трасса("", СтрШаблон("Сверка: цепочек к сверке %1 (не больше %2 за проход)",
		Выборка.Количество(), ЦепочекЗаСеанс), Истина, , Выборка.Количество());

	Пока Выборка.Следующий() Цикл
		Если ЭАрМ_ПриемПакетовДалион.ВремяВышло(Настройки, "Сверка товаров") Тогда
			Прервать;
		КонецЕсли;
		//@skip-check query-in-loop
		СверитьЦепочкуБезИсключений(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, Настройки);
	КонецЦикла;

КонецПроцедуры

// Сверка для открытой формы реестра УПД: те же ожидающие цепочки, без клика
// по строке. «К отправке» не ставит - галочку ставит человек.
// ДатаС и ДатаПо - период, который открыт в реестре. Пустые даты - без
// ограничения, так сверка идёт из очереди отправки.
//
Функция СверитьОжидающиеДляФормы(ДатаС = Неопределено, ДатаПо = Неопределено) Экспорт

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	Настройки.Вставить("ЦепочекЗаСеанс", 30);
	Настройки.Вставить("ДатаСверкиС", ДатаС);
	Настройки.Вставить("ДатаСверкиПо", ДатаПо);
	СверитьЦепочки(Настройки);

	// Галочка «Есть ЭТрН» - по факту наличия ЭТрН, в том числе у УПД без
	// прихода и вне цепочки
	ЭАрМ_РегламентныйОбменЭДО.ОбновитьПризнакЭТрНРеестраУПД();

	Возврат Истина;

КонецФункции

// Сверка только этих УПД (очередь событий, строки «СверкаУПД»): те же ожидающие
// цепочки, что и СверитьОжидающиеДляФормы, но отобранные по списку документов,
// а не по всему реестру за период.
//
// Параметры:
//   Идентификаторы - Массив из Строка - ИдентификаторСБИС УПД
//
// Возвращаемое значение:
//   Число - сколько цепочек у этих УПД (сверялись те, у которых что-то поменялось)
//
Функция СверитьОжидающиеПоУПД(Идентификаторы) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторУПД В (&Идентификаторы)
	|	И Цепочка.ИдентификаторПоступления <> """"";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат 0;
	КонецЕсли;

	Поступления = Результат.Выгрузить().ВыгрузитьКолонку("ИдентификаторПоступления");

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	Настройки.Вставить("ЦепочекЗаСеанс", Макс(30, Поступления.Количество()));
	Настройки.Вставить("ТолькоОбъекты", Поступления);
	СверитьЦепочки(Настройки);

	Возврат Поступления.Количество();

КонецФункции

// Пересверяет цепочку, если её сверка сделана до смены версии сверки (см.
// ДатаАктуальностиСверки) и задание до неё ещё не дошло - в том числе
// закрытую. Для форм: реестр товаров и итог сверки хранятся, и без этого
// форма сравнила бы цены документов с ценами реестра, посчитанными по
// старым правилам (цена прихода без НДС).
//
// Возвращаемое значение:
//   Булево - Истина, если цепочка пересверялась и её нужно перечитать
//
Функция АктуализироватьСверку(ИдентификаторЗаказа, ИдентификаторПоступления) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторПоступления) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ДатаСверки КАК ДатаСверки
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторЗаказа = &ИдентификаторЗаказа
	|	И Цепочка.ИдентификаторПоступления = &ИдентификаторПоступления";
	Запрос.УстановитьПараметр("ИдентификаторЗаказа", ИдентификаторЗаказа);
	Запрос.УстановитьПараметр("ИдентификаторПоступления", ИдентификаторПоступления);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	Если Выборка.ДатаСверки >= ДатаАктуальностиСверки(Настройки) Тогда
		Возврат Ложь;
	КонецЕсли;

	СверитьЦепочкуБезИсключений(ИдентификаторЗаказа, ИдентификаторПоступления, Настройки);

	Возврат Истина;

КонецФункции

// Сверка одной цепочки для пакетных вызовов: ошибка уходит в журнал и в итог
// цепочки, остальные цепочки продолжают сверяться.
//
Процедура СверитьЦепочкуБезИсключений(ИдентификаторЗаказа, ИдентификаторПоступления, Настройки)

	Попытка
		СверитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Настройки);
	Исключение
		ТекстОшибки = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторПоступления, 100),
			ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(), Ложь, "Сверка: " + ТекстОшибки);
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(ИдентификаторПоступления, "СверитьЦепочкуБезИсключений",
			"сверка цепочки прервана, ошибка записана в строку УПД: " + ТекстОшибки);
		ЗафиксироватьОшибкуСверки(ИдентификаторЗаказа, ИдентификаторПоступления, ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Сверяет одну цепочку и записывает результат.
//
// Параметры:
//   ИдентификаторЗаказа      - Строка - uid заказа Далиона или "ПН:<uid>"
//   ИдентификаторПоступления - Строка - uid поступления Далиона
//   Настройки                - Структура, Неопределено
//
Процедура СверитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Настройки = Неопределено) Экспорт

	Если Настройки = Неопределено Тогда
		Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	КонецЕсли;

	// Этап обновляется перед каждым шагом: при обрыве в логе видно, на каком
	// именно шаге и каким исключением оборвалась сверка
	Этап = "ЗаписьЦепочки";
	Попытка

	Цепочка = ЗаписьЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления);
	Если Цепочка = Неопределено Тогда
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(ИдентификаторПоступления, "Сверка / ЗаписьЦепочки",
			"записи цепочки нет в ЭАрМ_ЦепочкаЗакупки (заказ " + ИдентификаторЗаказа + ") - сверять нечего");
		Возврат;
	КонецЕсли;

	// В ЗаписьЦепочки этого модуля только идентификаторы и поставщик
	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
		"Сверка начата: поступление %1, УПД %2, ЭТрН %3, поставщик «%4» ИНН %5",
		ИдентификаторПоступления,
		?(ЗначениеЗаполнено(Цепочка.ИдентификаторУПД), Цепочка.ИдентификаторУПД, "нет"),
		?(ЗначениеЗаполнено(Цепочка.ИдентификаторЭТрН), Цепочка.ИдентификаторЭТрН, "нет"),
		Цепочка.Поставщик, Цепочка.ИННПоставщика));

	Этап = "ПостроитьЛинии";
	Линии = ПостроитьЛинии(Цепочка, ИдентификаторЗаказа, ИдентификаторПоступления, Настройки);

	СчётчикиЛиний = Новый Соответствие;
	Для Каждого Линия Из Линии Цикл
		СчётчикиЛиний.Вставить(Линия.Результат, ?(СчётчикиЛиний[Линия.Результат] = Неопределено, 1,
			СчётчикиЛиний[Линия.Результат] + 1));
	КонецЦикла;
	ЧастиСчётчиков = Новый Массив;
	Для Каждого КлючЗначение Из СчётчикиЛиний Цикл
		ЧастиСчётчиков.Добавить(КлючЗначение.Ключ + " " + Формат(КлючЗначение.Значение, "ЧГ=0"));
	КонецЦикла;
	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
		"Сверка: строк %1 (%2)", Линии.Количество(), СтрСоединить(ЧастиСчётчиков, ", ")),
		Истина, , Линии.Количество());

	// Каждая строка сверки - в трассу: что с чем сравнили и почему такой результат
	Для Каждого Линия Из Линии Цикл
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
			"Сверка строка %1: «%2»%3; УПД: %4; приход: %5; пара %6%7 | КАК РЕШЕНО: %8",
			Линия.НомерСтроки, ?(Линия.Результат = "Совпадает", "совпала", ТекстКомментарияСверки(Линия.Результат)), ?(Линия.Критично, " (критично)", ""),
			ТекстСтрокиСверкиДляТрассы(Линия.УПД), ТекстСтрокиСверкиДляТрассы(Линия.Поступление),
			?(ЗначениеЗаполнено(Линия.СпособУПД), Линия.СпособУПД,
				?(ЗначениеЗаполнено(Линия.Способ), Линия.Способ, "не найдена")),
			?(ЗначениеЗаполнено(Линия.Комментарий), " - " + Лев(Линия.Комментарий, 200), ""), Линия.Пояснение),
			Линия.Результат = "Совпадает");
	КонецЦикла;

	Этап = "ЗаписатьСверку";
	ЗаписатьСверку(ИдентификаторЗаказа, ИдентификаторПоступления, Линии);
	Этап = "ЗапомнитьПарыПоИмени";
	ЗапомнитьПарыПоИмени(Линии);
	Этап = "ЗапомнитьШтрихкодыИзСверки";
	ЗапомнитьШтрихкодыИзСверки(Линии, Цепочка);
	Этап = "ОтразитьЦепочку (реестр товаров)";
	ЭАрМ_РеестрТоваровЗаказов.ОтразитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Линии, Настройки);

	Этап = "РасчётИтога";
	Итог = Новый Структура("ЕстьРасхождения, РасхожденийСтрок, ТекстРасхождений, УПДУчтена, УПДСошлась, ЭТрНСошлась",
		Ложь, 0, "", ЗначениеЗаполнено(Цепочка.ИдентификаторУПД), Ложь, Ложь);

	ЧастиРасхождений = Новый Массив;
	ЧастиЗамечаний   = Новый Массив;
	Для Каждого Линия Из Линии Цикл
		Если Линия.Результат = "Совпадает" Тогда
			Продолжить;
		КонецЕсли;
		Итог.РасхожденийСтрок = Итог.РасхожденийСтрок + 1;
		// Словами, с числами: код результата («НетВПоступлении») читался непонятно
		ТекстЛинии = ТекстРасхожденияЛинии(Линия);
		Если Линия.Критично Тогда
			ЧастиРасхождений.Добавить(ТекстЛинии);
		Иначе
			ЧастиЗамечаний.Добавить(ТекстЛинии);
		КонецЕсли;
	КонецЦикла;

	Итог.УПДСошлась = УПДСошласьПоШтрихкодам(Линии, Итог.УПДУчтена, Настройки);
	Итог.ЭТрНСошлась = ЭТрНСошласьСПриходом(Линии, ЗначениеЗаполнено(Цепочка.ИдентификаторЭТрН));

	ИтогиДокументов = ИтогиУПДиПрихода(Линии);
	ДокументныеРасхождения = РасхожденияИтоговДокументов(ИтогиДокументов, Настройки);

	// Разная итоговая сумма запрещает отправку и тогда, когда УПД готова
	// по наличию прихода и ЭТрН (см. ЭАрМ_ЦепочкаЗакупки.ЗафиксироватьСверку)
	Итог.Вставить("СуммыСошлись",
		НЕ ЗначениеЗаполнено(ТекстРасхожденияИтоговойСуммы(ИтогиДокументов, Настройки)));
	Итог.Вставить("ОжидаетУКД", Итог.УПДУчтена И УПДОжидаетУКД(Линии, ИтогиДокументов));
	Итог.Вставить("НетВозвратаДалиона", Итог.УПДУчтена И НЕ Итог.СуммыСошлись
		И УПДЖдётВозвратДалиона(Цепочка.ИдентификаторУПД, Линии, ИтогиДокументов));
	Если ДокументныеРасхождения.Количество() > 0 Тогда
		Итог.УПДСошлась = Ложь;
		ИндексИтога = ДокументныеРасхождения.ВГраница();
		Пока ИндексИтога >= 0 Цикл
			ЧастиРасхождений.Вставить(0, ДокументныеРасхождения[ИндексИтога]);
			ИндексИтога = ИндексИтога - 1;
		КонецЦикла;
	КонецЕсли;

	// С УПД признак расхождений - это "УПД не сошлась с приходом": по нему
	// держатся утверждение и пломба, а недовоз по заказу и замечания ЭТрН
	// остаются в тексте. Без УПД сверять приход не с чем - считаем все замечания
	// С 29.09.2026 решает итоговая сумма: сошлась до копейки - расхождений
	// нет, несовпадения строк остаются в тексте справкой
	Если Итог.УПДУчтена Тогда
		Итог.ЕстьРасхождения = НЕ Итог.СуммыСошлись;
		Если Итог.ЕстьРасхождения И ЧастиРасхождений.Количество() = 0 Тогда
			ЧастиРасхождений.Добавить("Состав УПД не сошёлся с приходом");
		КонецЕсли;
	Иначе
		Итог.ЕстьРасхождения = Итог.РасхожденийСтрок > 0;
	КонецЕсли;

	Если ЧастиЗамечаний.Количество() > 0 Тогда
		Если ЧастиРасхождений.Количество() > 0 Тогда
			ЧастиРасхождений.Добавить("");
		КонецЕсли;
		ЧастиРасхождений.Добавить("Замечания (заказ, ЭТрН):");
		Для Каждого ТекстЛинии Из ЧастиЗамечаний Цикл
			ЧастиРасхождений.Добавить(ТекстЛинии);
		КонецЦикла;
	КонецЕсли;
	Итог.ТекстРасхождений = Лев(СтрСоединить(ЧастиРасхождений, Символы.ПС), 1024);

	// Как решён итог - в трассу: суммы, допуск, правило и что из этого вышло
	ДопускИтога = ДопускИтоговойСуммы(Настройки);
	Если Итог.УПДУчтена Тогда
		Правило = СтрШаблон("УПД привязана -> расхождения = итоговые суммы не сошлись (с 29.09.2026 решает итоговая сумма; несовпадающих строк %1 - справка в тексте)",
			Итог.РасхожденийСтрок);
	Иначе
		Правило = СтрШаблон("УПД не привязана -> расхождения = есть несовпадающие строки (%1)", Итог.РасхожденийСтрок);
	КонецЕсли;
	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
		"Сверка / КАК РЕШЁН ИТОГ: сумма УПД %1 (позиций %2), прихода %3 (позиций %4), разница %5; допуск итоговой суммы %6 (%7) -> суммы %8; строки по штрихкодам сошлись: %9; нужна УКД от поставщика: %10",
		ЧислоДляТрассы(ИтогиДокументов.СуммаУПД), ИтогиДокументов.ПозицийУПД, ЧислоДляТрассы(ИтогиДокументов.СуммаПН),
		ИтогиДокументов.ПозицийПН, РазницаДляТрассы(ИтогиДокументов.СуммаПН - ИтогиДокументов.СуммаУПД),
		ЧислоДляТрассы(ДопускИтога), ?(ДопускИтога = 0, "точно до копейки", "погрешность из настроек"),
		?(Итог.СуммыСошлись, "СОШЛИСЬ", "НЕ СОШЛИСЬ"), ?(Итог.УПДСошлась, "да", "нет"), ?(Итог.ОжидаетУКД, "да", "нет"))
			+ "; УКД есть, нет возврата из Далиона: " + ?(Итог.НетВозвратаДалиона, "да", "нет"),
		Итог.СуммыСошлись);
	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон("Сверка / ПРАВИЛО: %1 -> %2",
		Правило, ?(Итог.ЕстьРасхождения, "ЕСТЬ РАСХОЖДЕНИЯ", "РАСХОЖДЕНИЙ НЕТ")), НЕ Итог.ЕстьРасхождения);

	Этап = "ЗафиксироватьСверку";
	ЭАрМ_ЦепочкаЗакупки.ЗафиксироватьСверку(ИдентификаторЗаказа, ИдентификаторПоступления, Итог);

	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
		"Сверка окончена: УПД учтена %1, сошлась %2, суммы сошлись %3, расхождения %4 (строк %5)%6",
		Итог.УПДУчтена, Итог.УПДСошлась, Итог.СуммыСошлись, Итог.ЕстьРасхождения, Итог.РасхожденийСтрок,
		?(ЗначениеЗаполнено(Итог.ТекстРасхождений), ": " + СтрЗаменить(Лев(Итог.ТекстРасхождений, 600), Символы.ПС, " | "), "")),
		НЕ Итог.ЕстьРасхождения);

	// Протокол сверки - в журнал обмена (операция «Сверка») под приходной и под УПД
	Этап = "Протокол сверки в журнал";
	ЗаписатьПротоколСверкиВЖурнал(Цепочка, ИдентификаторЗаказа, ИдентификаторПоступления, Линии, Итог,
		ИтогиДокументов);

	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторПоступления,
			"Сверка / этап «" + Этап + "»", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Дата, раньше которой сверка цепочки считается устаревшей.
//
// Версия сверки - версия правил плюс настройки, от которых зависит итог. При
// её смене запоминается текущая дата, и все открытые цепочки уходят на
// пересверку порциями (см. СверитьЦепочки). Регистр цепочек не меняется.
//
// Возвращаемое значение:
//   Дата - пустая, если версия не менялась с первого запуска
//
Функция ДатаАктуальностиСверки(Настройки)

	Версия = ВерсияПравилСверки()
		+ "|" + Формат(Настройки.ДопускЦены, "ЧДЦ=2; ЧРД=.; ЧН=0; ЧГ=0")
		+ "|" + Формат(Настройки.ДопускКоличества, "ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=0");

	Если ЭАрМ_НастройкиСервер.ЗначениеНастройки("Цепочка_ВерсияСверки") <> Версия Тогда

		ДатаВерсии = ТекущаяДатаСеанса();

		Сохраняемые = Новый Структура;
		Сохраняемые.Вставить("Цепочка_ВерсияСверки", Версия);
		Сохраняемые.Вставить("Цепочка_ДатаВерсииСверки", Формат(ДатаВерсии, "ДФ=yyyyMMddHHmmss"));
		ЭАрМ_НастройкиСервер.СохранитьВсеНастройки(Сохраняемые);

		Возврат ДатаВерсии;

	КонецЕсли;

	Попытка
		Возврат Дата(ЭАрМ_НастройкиСервер.ЗначениеНастройки("Цепочка_ДатаВерсииСверки"));
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ДатаАктуальностиСверки (настройка Цепочка_ДатаВерсииСверки не дата)", ОшибкаИсключения);
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// Версия правил сопоставления и оценки строк. Поднимать при каждом изменении,
// которое меняет итог сверки: уже сверенные цепочки пересверятся сами.
//
Функция ВерсияПравилСверки()

	// 2026-09-17: имя даже при разных штрихкодах; остаток УПД клеится к приходу
	// 2026-09-18: вес и объём в граммах/миллилитрах (0,95 л = 950 мл, 1 кг = 1000 г),
	//             процент - отдельный признак (2,5% не пара 3,2%), латиница-двойники
	//             в русских словах; в мягком проходе вес и процент - запрет
	// 2026-09-18.2: Массив.Сортировать() падал в КлючПарыПоИмени и обрывал сверку
	//             при любой паре по названию - такие цепочки стоят с «Ошибка сверки»
	//             и должны пересвериться
	// 2026-09-18.3: оценка похожести 0–1 (опечатки, склейка слов), штраф за
	//             отличающее слово, лучшая пара вместо первой, словарь пар читается
	// 2026-09-18.4: удачная сверка учит ЭАрМ_ШтрихкодыПоставщиков (штрихкод и
	//             уверенное имя), чтобы следующая УПД брала товар из регистра
	// 2026-09-18.5: количество штук и веса раздельно; коробка через ratio;
	//             сумма не закрывает штуки; одна свёртка для строки и УПД
	// 2026-09-18.6: склейка не складывает разные карточки Далиона с общим EAN
	//             (штука и короб) - из-за этого количество прихода двоилось
	// 2026-09-18.7: цена прихода в сверке - Цена табчасти (price / ratio),
	//             не сумма/количество: иначе 71,90 становилась 75,90 из-за НДС
	// 2026-09-18.8: кроме количества и цены - НДС, итоговая сумма строки
	//             и число позиций УПД против приходной накладной
	// 2026-09-18.9: НДС не сравниваем; финал документа - сумма и число строк
	// 2026-09-21.1: позиции после склейки по штрихкоду, не сырые строки XML
	// 2026-09-21.2: пары подбираются проходами по всем строкам - сначала
	//             штрихкод, потом имя; раньше строка без общего штрихкода
	//             забирала по имени пару, чей штрихкод совпадал с другой строкой
	// 2026-09-21.3: разная итоговая сумма снимает «Расхождений нет» и при
	//             наличии прихода и ЭТрН; допуск суммы - допуск цены, не на строку
	// 2026-09-21.4: приход и ЭТрН делают готовой только ЭТрН; УПД с
	//             расхождениями ждёт УКД («Ждёт УКД: ...»)
	// 2026-09-21.5: строкам УПД и ЭТрН - все штрихкоды товара и uid номенклатуры
	//             Далиона из ЭАрМ_ШтрихкодыПоставщиков; пара УПД по номенклатуре
	// 2026-09-21.6: номенклатура Далиона для всех линий сразу после штрихкода,
	//             линии одной номенклатуры склеиваются; позиции строк - в реестр
	// 2026-09-25.1: статус УПД «Ожидает УКД» - товара из УПД нет в приходе и
	//             число позиций не сходится
	// 2026-09-29.1: пара по подставленному регистром штрихкоду или номенклатуре
	//             не берётся, если названия не похожи и не сошлись ни
	//             количество, ни цена, ни сумма (крест-накрест)
	// 2026-09-29.2: сошлась итоговая сумма УПД и прихода до копейки - УПД
	//             сошлась (строки - справкой); статус «Ожидает УКД» снят
	// 2026-10-05.1: цена прихода с ручной правкой (ЭАрМ_ПравкиЦен); в реестр товаров
	//             идут только товары УПД и приходной - цепочки перезаписывают реестр
	Возврат "2026-10-05.1";

КонецФункции

// Сбойная цепочка получает дату сверки с пометкой об ошибке: иначе она падала
// бы на каждом проходе задания и забивала журнал, а УПД оставалась бы с
// прежней отметкой "Расхождений нет". Снова сверится, когда изменятся её
// документы или версия сверки.
//
Процедура ЗафиксироватьОшибкуСверки(ИдентификаторЗаказа, ИдентификаторПоступления, ТекстОшибки)

	Итог = Новый Структура("ЕстьРасхождения, РасхожденийСтрок, ТекстРасхождений, УПДУчтена, УПДСошлась, ЭТрНСошлась, СуммыСошлись",
		Истина, 0, Лев("Ошибка сверки: " + ТекстОшибки, 1024), Ложь, Ложь, Ложь, Ложь);

	Попытка
		ЭАрМ_ЦепочкаЗакупки.ЗафиксироватьСверку(ИдентификаторЗаказа, ИдентификаторПоступления, Итог);
	Исключение
		// Ошибка уже в журнале; отметка не записалась - цепочка сверится на следующем проходе
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторПоступления, 100),
			ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(), Ложь,
			"Сверка, запись ошибки: " + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Линии сверки цепочки без записи результата - для реестра товаров. Штрихкоды
// строкам УПД и ЭТрН при этом назначаются, как и при сверке.
//
// Возвращаемое значение:
//   Массив из Структура - см. НоваяЛиния; Неопределено - цепочки нет
//
Функция ЛинииЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления, Настройки = Неопределено) Экспорт

	Если Настройки = Неопределено Тогда
		Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	КонецЕсли;

	Цепочка = ЗаписьЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления);
	Если Цепочка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПостроитьЛинии(Цепочка, ИдентификаторЗаказа, ИдентификаторПоступления, Настройки);

КонецФункции

// Второй проход сопоставления по названию для цепочек периода: строки, которым
// сверка пары не нашла ("нет в УПД" и "нет в приходе"), спариваются по доле
// общих значимых слов названия. Обычная сверка так не делает - ей нужны ядро
// слов и совпадающая фасовка, поэтому «Молоко Домик в деревне 3,2% 950мл» и
// «Молоко ДВД у/паст 3.2% 0.95л» остаются порознь.
//
// Цепочка пересверяется целиком, поэтому регистр сверки, реестр товаров и
// итог цепочки не расходятся. Сопоставление живёт до следующей обычной
// пересверки цепочки - она вернёт строгие правила.
//
// Параметры:
//   ДатаНачала    - Дата - пустая: без ограничения снизу
//   ДатаОкончания - Дата - пустая: без ограничения сверху
//
// Возвращаемое значение:
//   Структура - Цепочек, Сопоставлено, Осталось, Ошибок, Сообщения (Массив из Строка)
//
Функция ПересопоставитьПоНазванию(Знач ДатаНачала = '00010101', Знач ДатаОкончания = '00010101') Экспорт

	Итоги = Новый Структура("Цепочек, Сопоставлено, Осталось, Ошибок, Сообщения", 0, 0, 0, 0, Новый Массив);

	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = '39991231';
	КонецЕсли;
	ДатаОкончания = КонецДня(ДатаОкончания);

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	Настройки.Вставить("СклеиватьПоДолеСлов", Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления <> """"
	|	И (Цепочка.ДатаЗаказа МЕЖДУ &ДатаНачала И &ДатаОкончания
	|			ИЛИ Цепочка.ДатаПоступления МЕЖДУ &ДатаНачала И &ДатаОкончания)";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Попытка

			//@skip-check query-in-loop
			БылоБезПары = СтрокБезПары(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления);

			//@skip-check query-in-loop
			СверитьЦепочку(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, Настройки);

			//@skip-check query-in-loop
			СталоБезПары = СтрокБезПары(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления);

			Итоги.Цепочек      = Итоги.Цепочек + 1;
			Итоги.Сопоставлено = Итоги.Сопоставлено + Макс(БылоБезПары - СталоБезПары, 0);
			Итоги.Осталось     = Итоги.Осталось + СталоБезПары;

		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(Выборка.ИдентификаторПоступления,
				"ПересопоставитьПоНазванию (заказ " + Выборка.ИдентификаторЗаказа + ")", ОшибкаИсключения);
			Итоги.Ошибок = Итоги.Ошибок + 1;
			Итоги.Сообщения.Добавить(Лев(СтрШаблон("%1 / %2: %3",
				Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления,
				ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения)), 300));
		КонецПопытки;

	КонецЦикла;

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(),
		Итоги.Ошибок = 0, СтрШаблон(
			"Сопоставление по названию: цепочек %1, сопоставлено строк %2, осталось без пары %3, ошибок %4. %5",
			Итоги.Цепочек, Итоги.Сопоставлено, Итоги.Осталось, Итоги.Ошибок,
			СтрСоединить(Итоги.Сообщения, "; ")));

	Возврат Итоги;

КонецФункции

// Пересверяет цепочки закупки одной УПД по выбранному правилу связи строк.
// Вызывается кнопками «Переделать связь» над деревом цепочки в реестре УПД.
//
// Режимы:
//   "Штрихкод" - сначала заново назначаются штрихкоды поставщика строкам УПД
//                (регистр ЭАрМ_ШтрихкодыПоставщиков мог пополниться), затем
//                строки связываются только по штрихкоду, uid номенклатуры и
//                коду/артикулу. Пары по названию и по цене снимаются - режим
//                для случая, когда по названию связали не то;
//   "Название" - обычная сверка плюс мягкий проход по доле общих слов
//                (как «Перестроить по названию» реестра товаров, но для одной УПД).
//
// Результат живёт до следующей обычной пересверки цепочки: она вернёт
// стандартные правила. Цепочки, закрытые пломбой, не трогаются.
//
// Параметры:
//   ИдентификаторУПД - Строка - документ СБИС
//   Режим            - Строка - "Штрихкод" или "Название"
//
// Возвращаемое значение:
//   Структура - Цепочек, Закрытых, БылоБезПары, СталоБезПары, Ошибок, Текст
//
Функция ПересверитьЦепочкиУПД(ИдентификаторУПД, Режим) Экспорт

	Итоги = Новый Структура("Цепочек, Закрытых, БылоБезПары, СталоБезПары, Ошибок, Текст",
		0, 0, 0, 0, 0, "");

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Итоги.Текст = НСтр("ru = 'Выберите УПД в списке'");
		Возврат Итоги;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Цепочка.ИННПоставщика КАК ИННПоставщика,
	|	Цепочка.Этап КАК Этап
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторУПД = &ИдентификаторУПД
	|	И Цепочка.ИдентификаторПоступления <> """"";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);
	Цепочки = Запрос.Выполнить().Выгрузить();

	Если Цепочки.Количество() = 0 Тогда
		Итоги.Текст = НСтр("ru = 'У этой УПД нет цепочки закупки с приходной накладной - сверять не с чем.'");
		Возврат Итоги;
	КонецЕсли;

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	Если Режим = "Штрихкод" Тогда
		Настройки.Вставить("ТолькоШтрихкодИКод", Истина);
		Попытка
			НазначитьШтрихкоды(ИдентификаторУПД, Цепочки[0].ИННПоставщика);
		Исключение
			// Без свежих штрихкодов сверка всё равно пойдёт по уже назначенным
			ЭАрМ_Служебный.ЗаписатьОшибку("ПересверкаЦепочки", СтрШаблон(
				НСтр("ru = 'УПД %1: штрихкоды поставщика не назначены: %2'"),
				ИдентификаторУПД, ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
		КонецПопытки;
	Иначе
		Настройки.Вставить("СклеиватьПоДолеСлов", Истина);
	КонецЕсли;

	Сообщения = Новый Массив;

	Для Каждого Цепочка Из Цепочки Цикл

		Если Цепочка.Этап = "Закрыто" Тогда
			Итоги.Закрытых = Итоги.Закрытых + 1;
			Продолжить;
		КонецЕсли;

		Попытка

			//@skip-check query-in-loop
			Было = СтрокБезПары(Цепочка.ИдентификаторЗаказа, Цепочка.ИдентификаторПоступления);

			//@skip-check query-in-loop
			СверитьЦепочку(Цепочка.ИдентификаторЗаказа, Цепочка.ИдентификаторПоступления, Настройки);

			//@skip-check query-in-loop
			Стало = СтрокБезПары(Цепочка.ИдентификаторЗаказа, Цепочка.ИдентификаторПоступления);

			Итоги.Цепочек      = Итоги.Цепочек + 1;
			Итоги.БылоБезПары  = Итоги.БылоБезПары + Было;
			Итоги.СталоБезПары = Итоги.СталоБезПары + Стало;

		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(Цепочка.ИдентификаторПоступления,
				"ПересверитьЦепочкиУПД (заказ " + Цепочка.ИдентификаторЗаказа + ")", ОшибкаИсключения);
			Итоги.Ошибок = Итоги.Ошибок + 1;
			Сообщения.Добавить(Лев(ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения), 300));
		КонецПопытки;

	КонецЦикла;

	ИмяРежима = ?(Режим = "Штрихкод", НСтр("ru = 'по штрихкоду'"), НСтр("ru = 'по названию'"));
	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = 'Связь %1: пересверено цепочек %2, строк без пары было %3, стало %4.'"),
		ИмяРежима, Итоги.Цепочек, Итоги.БылоБезПары, Итоги.СталоБезПары));
	Если Итоги.Закрытых > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'Закрыто пломбой и не тронуто: %1.'"), Итоги.Закрытых));
	КонецЕсли;
	Если Итоги.Ошибок > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'Ошибок: %1. %2'"), Итоги.Ошибок, СтрСоединить(Сообщения, "; ")));
	КонецЕсли;
	Итоги.Текст = СтрСоединить(Части, " ");

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(ИдентификаторУПД, ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(),
		Итоги.Ошибок = 0, Итоги.Текст);

	Возврат Итоги;

КонецФункции

// Прогоняет несверенные строки по названию, пока цепочка не сойдётся.
// Кнопка «Прогнать несверенные по названию» формы регистра сверки товаров.
//
// Берутся открытые цепочки со строками «Нет в УПД» / «Нет в поступлении».
// Повторять сверку с тем же порогом бессмысленно: она детерминирована и вернёт
// то же самое. Поэтому для каждой цепочки мягкий проход по доле общих слов
// повторяется с понижением порога - от настройки «Порог совпадения товаров, %»
// шагом 10% до НижнийПорогПоНазванию() - и останавливается, как только
// несверенных строк не осталось.
//
// Цепочка остаётся на самом строгом пороге, при котором несверенных строк
// стало меньше всего: каждая ступень вниз - риск связать не тот товар, и
// спускаться ниже нужного незачем. Вес, объём и процент не смягчаются никогда:
// разные у обеих сторон - не пара на любом пороге.
//
// Результат живёт до следующей обычной пересверки цепочки (как у
// ПересопоставитьПоНазванию). Закрытые пломбой цепочки не берутся.
// За нажатие - не больше ЦепочекЗаНажатиеПоНазванию(), свежие первыми:
// остальные - следующим нажатием.
//
// Возвращаемое значение:
//   Структура - Цепочек, Сошлось, СталоЛучше, БезИзменений, СтрокБыло,
//               СтрокСтало, МинимальныйПорог, Осталось, Ошибок, Текст
//
Функция ПрогнатьНесверенныеПоНазванию() Экспорт

	Итоги = Новый Структура(
		"Цепочек, Сошлось, СталоЛучше, БезИзменений, СтрокБыло, СтрокСтало, МинимальныйПорог, Осталось, Ошибок, Текст",
		0, 0, 0, 0, 0, 0, Неопределено, 0, 0, "");

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	Настройки.Вставить("СклеиватьПоДолеСлов", Истина);
	Лестница = ЛестницаПороговПоНазванию(Настройки.ПорогСовпадения);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Сверка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Сверка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Цепочка.ДатаОбновления КАК ДатаОбновления
	|ИЗ
	|	РегистрСведений.ЭАрМ_СверкаТоваровЦепочки КАК Сверка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ПО Сверка.ИдентификаторЗаказа = Цепочка.ИдентификаторЗаказа
	|			И Сверка.ИдентификаторПоступления = Цепочка.ИдентификаторПоступления
	|ГДЕ
	|	Сверка.Результат В (""НетВУПД"", ""НетВПоступлении"")
	|	И Цепочка.Этап <> ""Закрыто""
	|	И Цепочка.ИдентификаторПоступления <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОбновления УБЫВ";
	Цепочки = Запрос.Выполнить().Выгрузить();

	Лимит = ЦепочекЗаНажатиеПоНазванию();
	Сообщения = Новый Массив;

	Для Каждого Цепочка Из Цепочки Цикл

		Если Итоги.Цепочек + Итоги.Ошибок >= Лимит Тогда
			Итоги.Осталось = Итоги.Осталось + 1;
			Продолжить;
		КонецЕсли;

		Попытка

			//@skip-check query-in-loop
			Было = СтрокБезПары(Цепочка.ИдентификаторЗаказа, Цепочка.ИдентификаторПоступления);

			ЛучшийПорог    = Неопределено;
			ЛучшееСтало    = Неопределено;
			ПоследнийПорог = Неопределено;

			Для Каждого Порог Из Лестница Цикл

				Настройки.ПорогСовпадения = Порог;
				//@skip-check query-in-loop
				СверитьЦепочку(Цепочка.ИдентификаторЗаказа, Цепочка.ИдентификаторПоступления, Настройки);
				ПоследнийПорог = Порог;

				//@skip-check query-in-loop
				Стало = СтрокБезПары(Цепочка.ИдентификаторЗаказа, Цепочка.ИдентификаторПоступления);

				// Строгий порог перебирается первым, поэтому при равенстве
				// остаётся он: мягче, чем нужно, не спускаемся
				Если ЛучшееСтало = Неопределено ИЛИ Стало < ЛучшееСтало Тогда
					ЛучшееСтало = Стало;
					ЛучшийПорог = Порог;
				КонецЕсли;

				Если Стало = 0 Тогда
					Прервать;
				КонецЕсли;

			КонецЦикла;

			// Последний прогон был мягче лучшего и ничего не добавил - возвращаем
			// цепочку на лучший, более строгий порог
			Если ЛучшийПорог <> ПоследнийПорог Тогда
				Настройки.ПорогСовпадения = ЛучшийПорог;
				//@skip-check query-in-loop
				СверитьЦепочку(Цепочка.ИдентификаторЗаказа, Цепочка.ИдентификаторПоступления, Настройки);
			КонецЕсли;

			Итоги.Цепочек    = Итоги.Цепочек + 1;
			Итоги.СтрокБыло  = Итоги.СтрокБыло + Было;
			Итоги.СтрокСтало = Итоги.СтрокСтало + ЛучшееСтало;

			Если ЛучшееСтало = 0 Тогда
				Итоги.Сошлось = Итоги.Сошлось + 1;
			ИначеЕсли ЛучшееСтало < Было Тогда
				Итоги.СталоЛучше = Итоги.СталоЛучше + 1;
			Иначе
				Итоги.БезИзменений = Итоги.БезИзменений + 1;
			КонецЕсли;

			Если ЛучшееСтало < Было
				И (Итоги.МинимальныйПорог = Неопределено ИЛИ ЛучшийПорог < Итоги.МинимальныйПорог) Тогда
				Итоги.МинимальныйПорог = ЛучшийПорог;
			КонецЕсли;

		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(Цепочка.ИдентификаторПоступления,
				"ПрогнатьНесверенныеПоНазванию (заказ " + Цепочка.ИдентификаторЗаказа + ")", ОшибкаИсключения);
			Итоги.Ошибок = Итоги.Ошибок + 1;
			Сообщения.Добавить(Лев(СтрШаблон("%1 / %2: %3",
				Цепочка.ИдентификаторЗаказа, Цепочка.ИдентификаторПоступления,
				ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения)), 300));
		КонецПопытки;

	КонецЦикла;

	Части = Новый Массив;
	Если Цепочки.Количество() = 0 Тогда
		Части.Добавить(НСтр("ru = 'Несверенных строк в открытых цепочках нет.'"));
	Иначе
		Части.Добавить(СтрШаблон(
			НСтр("ru = 'Прогнано цепочек: %1. Сошлись полностью: %2, стало лучше: %3, без изменений: %4.'"),
			Итоги.Цепочек, Итоги.Сошлось, Итоги.СталоЛучше, Итоги.БезИзменений));
		Части.Добавить(СтрШаблон(
			НСтр("ru = 'Несверенных строк было %1, стало %2.'"), Итоги.СтрокБыло, Итоги.СтрокСтало));
		Если Итоги.МинимальныйПорог <> Неопределено Тогда
			Части.Добавить(СтрШаблон(НСтр("ru = 'Самый мягкий понадобившийся порог: %1.'"),
				Формат(Итоги.МинимальныйПорог * 100, "ЧДЦ=0; ЧГ=0") + "%"));
		КонецЕсли;
		Если Итоги.Осталось > 0 Тогда
			Части.Добавить(СтрШаблон(
				НСтр("ru = 'Ещё %1 цепочек не прогнано - нажмите кнопку ещё раз.'"), Итоги.Осталось));
		КонецЕсли;
		Если Итоги.Ошибок > 0 Тогда
			Части.Добавить(СтрШаблон(НСтр("ru = 'Ошибок: %1. %2'"),
				Итоги.Ошибок, СтрСоединить(Сообщения, "; ")));
		КонецЕсли;
	КонецЕсли;
	Итоги.Текст = СтрСоединить(Части, " ");

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(),
		Итоги.Ошибок = 0, НСтр("ru = 'Прогон по названию: '") + Итоги.Текст);

	Возврат Итоги;

КонецФункции

// Пороги доли общих слов для прогона по названию: от настройки вниз шагом
// 10% до нижней границы. Настройка ниже границы - единственная ступень.
//
Функция ЛестницаПороговПоНазванию(ПорогНастройки)

	Лестница = Новый Массив;
	Лестница.Добавить(ПорогНастройки);

	Нижний = НижнийПорогПоНазванию();
	Порог = Окр(ПорогНастройки - 0.1, 2);
	Пока Порог >= Нижний Цикл
		Лестница.Добавить(Порог);
		Порог = Окр(Порог - 0.1, 2);
	КонецЦикла;

	Возврат Лестница;

КонецФункции

// Ниже половины общих значимых слов пара по названию - уже угадывание.
//
Функция НижнийПорогПоНазванию()

	Возврат 0.5;

КонецФункции

