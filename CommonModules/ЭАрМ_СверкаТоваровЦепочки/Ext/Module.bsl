// в регистр штрихкодов и воспроизводила себя. Строку УПД без общего штрихкода
// связывает человек - ручной парой (СвязатьСтрокуУПДСПриходом).
// Строки УПД и прихода сводятся по штрихкоду и по номенклатуре Далиона из
// регистра штрихкодов поставщиков; строки заказа и прихода Далиона - ещё и по
// коду и артикулу его же карточки.
//
Функция ТолькоШтрихкодИКод(Настройки)

	Возврат Истина;

КонецФункции

// Строки сверки цепочки, оставшиеся без пары.
//
// Возвращаемое значение:
//   Число
//
Функция СтрокБезПары(ИдентификаторЗаказа, ИдентификаторПоступления)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Строк
	|ИЗ
	|	РегистрСведений.ЭАрМ_СверкаТоваровЦепочки КАК Сверка
	|ГДЕ
	|	Сверка.ИдентификаторЗаказа = &ИдентификаторЗаказа
	|	И Сверка.ИдентификаторПоступления = &ИдентификаторПоступления
	|	И Сверка.Результат В (""НетВУПД"", ""НетВПоступлении"")";
	Запрос.УстановитьПараметр("ИдентификаторЗаказа", ИдентификаторЗаказа);
	Запрос.УстановитьПараметр("ИдентификаторПоступления", ИдентификаторПоступления);

	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Строк, 0);

КонецФункции

// Записывает штрихкод в регистр ЭАрМ_ШтрихкодыПоставщиков. Заполненные поля
// пустыми не затираются.
//
// Параметры:
//   Описание - Структура - см. НовоеОписаниеШтрихкода
//
Процедура ЗаписатьШтрихкодПоставщика(Описание) Экспорт

	ЗаписатьШтрихкод(Описание);

КонецПроцедуры

// Загружает JSON номенклатуры в ЭАрМ_ШтрихкодыПоставщиков.
// Массив строк ищется в товары / items / goods / data.items / data.goods /
// data.nomenclature, либо это корневой массив. Штрихкод берётся из
// штрихкод / barcode / barcodes, имя - из наименование / name / nomenclature.
//
// Параметры:
//   АдресФайла - Строка - двоичные данные во временном хранилище
//   ИмяФайла   - Строка
//
// Возвращаемое значение:
//   Структура - Загружено, Пропущено, Всего
//
Функция ЗагрузитьШтрихкодыИзФайла(АдресФайла, ИмяФайла) Экспорт

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Файл штрихкодов не передан на сервер";
	КонецЕсли;

	Возврат ЗаписатьТоварыШтрихкодов(ТоварыИзФайлаНоменклатуры(ДвоичныеДанные, ИмяФайла), ИмяФайла);

КонецФункции

// Читает JSON штрихкодов из выбранной папки. Пакеты Далиона не отбираются
// по имени: грузятся все *.json, которые разбираются как товары.
//
// Параметры:
//   ПутьКПапке - Строка - каталог с JSON
//
// Возвращаемое значение:
//   Структура - Загружено, Пропущено, Файлов, Ошибок, Сообщения
//
Функция ЗагрузитьШтрихкодыИзПапки(ПутьКПапке) Экспорт

	Итоги = Новый Структура("Загружено, Пропущено, Файлов, Ошибок, Сообщения",
		0, 0, 0, 0, Новый Массив);

	Папка = СокрЛП(ПутьКПапке);
	Если НЕ ЗначениеЗаполнено(Папка) Тогда
		Итоги.Ошибок = 1;
		Итоги.Сообщения.Добавить("Папка не выбрана");
		Возврат Итоги;
	КонецЕсли;

	Каталог = Новый Файл(Папка);
	Если НЕ Каталог.Существует() ИЛИ НЕ Каталог.ЭтоКаталог() Тогда
		Итоги.Ошибок = 1;
		Итоги.Сообщения.Добавить("Папка не найдена: " + Папка);
		Возврат Итоги;
	КонецЕсли;

	Для Каждого ФайлJSON Из НайтиФайлы(Папка, "*.json") Цикл

		Итоги.Файлов = Итоги.Файлов + 1;

		Попытка
			ИтогФайла = ЗаписатьТоварыШтрихкодов(
				ТоварыИзПутиФайлаНоменклатуры(ФайлJSON.ПолноеИмя), ФайлJSON.Имя);
			Итоги.Загружено = Итоги.Загружено + ИтогФайла.Загружено;
			Итоги.Пропущено = Итоги.Пропущено + ИтогФайла.Пропущено;
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"ЗагрузитьШтрихкодыИзПапки (файл " + ФайлJSON.Имя + ")", ОшибкаИсключения);
			Итоги.Ошибок = Итоги.Ошибок + 1;
			Итоги.Сообщения.Добавить(ФайлJSON.Имя + ": "
				+ ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения));
		КонецПопытки;

	КонецЦикла;

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ШтрихкодыПоставщиков", Итоги.Ошибок = 0,
		СтрШаблон("Папка %1: файлов %2, загружено %3, пропущено %4, ошибок %5",
			Папка, Итоги.Файлов, Итоги.Загружено, Итоги.Пропущено, Итоги.Ошибок),
		Лев(Папка, 150));

	Возврат Итоги;

КонецФункции

// Читает один JSON штрихкодов по полному пути. Файл выбирает пользователь.
//
// Параметры:
//   ПутьКФайлу - Строка
//
// Возвращаемое значение:
//   Структура - Загружено, Пропущено, Файлов, Ошибок, Сообщения
//
Функция ЗагрузитьШтрихкодыИзПути(ПутьКФайлу) Экспорт

	Итоги = Новый Структура("Загружено, Пропущено, Файлов, Ошибок, Сообщения",
		0, 0, 0, 0, Новый Массив);

	Путь = СокрЛП(ПутьКФайлу);
	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Итоги.Ошибок = 1;
		Итоги.Сообщения.Добавить("Файл не выбран");
		Возврат Итоги;
	КонецЕсли;

	ФайлJSON = Новый Файл(Путь);
	Если НЕ ФайлJSON.Существует() ИЛИ ФайлJSON.ЭтоКаталог() Тогда
		Итоги.Ошибок = 1;
		Итоги.Сообщения.Добавить("Файл не найден: " + Путь);
		Возврат Итоги;
	КонецЕсли;

	Итоги.Файлов = 1;

	Попытка
		ИтогФайла = ЗаписатьТоварыШтрихкодов(
			ТоварыИзПутиФайлаНоменклатуры(ФайлJSON.ПолноеИмя), ФайлJSON.Имя);
		Итоги.Загружено = ИтогФайла.Загружено;
		Итоги.Пропущено = ИтогФайла.Пропущено;
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ЗагрузитьШтрихкодыИзПути (файл " + ФайлJSON.Имя + ")", ОшибкаИсключения);
		Итоги.Ошибок = 1;
		Итоги.Сообщения.Добавить(ФайлJSON.Имя + ": "
			+ ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения));
	КонецПопытки;

	Возврат Итоги;

КонецФункции

// Цены УПД и прихода по дням для графика динамики.
// Дата — ДатаПоступления цепочки, иначе ДатаУПД. Без штрихкода и имени —
// средняя цена по всем строкам сверки за день.
//
// Параметры:
//   Штрихкод     - Строка
//   Номенклатура - Строка - подстрока наименования УПД / прихода / заказа
//
// Возвращаемое значение:
//   Массив структур Дата, ЦенаУПД, ЦенаПоступления
//
Функция ДанныеГрафикаЦен(Знач Штрихкод = "", Знач Номенклатура = "") Экспорт

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(
	|		ВЫБОР
	|			КОГДА Цепочка.ДатаПоступления > ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА Цепочка.ДатаПоступления
	|			ИНАЧЕ Цепочка.ДатаУПД
	|		КОНЕЦ, ДЕНЬ) КАК Дата,
	|	Сверка.ЦенаУПД КАК ЦенаУПД,
	|	Сверка.ЦенаПоступления КАК ЦенаПоступления
	|ПОМЕСТИТЬ СтрокиГрафика
	|ИЗ
	|	РегистрСведений.ЭАрМ_СверкаТоваровЦепочки КАК Сверка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ПО Сверка.ИдентификаторЗаказа = Цепочка.ИдентификаторЗаказа
	|			И Сверка.ИдентификаторПоступления = Цепочка.ИдентификаторПоступления
	|ГДЕ
	|	(Сверка.ЦенаУПД <> 0
	|			ИЛИ Сверка.ЦенаПоступления <> 0)
	|	И (&Штрихкод = """"
	|			ИЛИ Сверка.Штрихкод = &Штрихкод)
	|	И (&Номенклатура = """"
	|			ИЛИ Сверка.НаименованиеУПД ПОДОБНО &Номенклатура
	|			ИЛИ Сверка.НоменклатураПоступления ПОДОБНО &Номенклатура
	|			ИЛИ Сверка.НоменклатураЗаказа ПОДОБНО &Номенклатура)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтрокиГрафика.Дата КАК Дата,
	|	СРЕДНЕЕ(СтрокиГрафика.ЦенаУПД) КАК ЦенаУПД,
	|	СРЕДНЕЕ(СтрокиГрафика.ЦенаПоступления) КАК ЦенаПоступления
	|ИЗ
	|	СтрокиГрафика КАК СтрокиГрафика
	|ГДЕ
	|	СтрокиГрафика.Дата > ДАТАВРЕМЯ(1, 1, 1)
	|
	|СГРУППИРОВАТЬ ПО
	|	СтрокиГрафика.Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

	Запрос.УстановитьПараметр("Штрихкод", СокрЛП(Штрихкод));
	ШаблонИмени = СокрЛП(Номенклатура);
	Если ЗначениеЗаполнено(ШаблонИмени) Тогда
		ШаблонИмени = "%" + ШаблонИмени + "%";
	КонецЕсли;
	Запрос.УстановитьПараметр("Номенклатура", ШаблонИмени);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Точка = Новый Структура("Дата, ЦенаУПД, ЦенаПоступления",
			Выборка.Дата, Выборка.ЦенаУПД, Выборка.ЦенаПоступления);
		Результат.Добавить(Точка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Назначает штрихкоды строкам УПД или ЭТрН в регистре ЭАрМ_ТоварыЭТрН.
//
// GTIN из самой УПД не трогаем. Остальным строкам штрихкод ищется в регистре
// штрихкодов поставщиков: по коду товара у этого поставщика, затем по
// нормализованному наименованию. Всё - одним запросом на документ.
//
// Параметры:
//   ИдентификаторСБИС - Строка - документ в СБИС
//   ИННПоставщика     - Строка - для поиска по коду товара; может быть пустым
//
Процедура НазначитьШтрихкоды(ИдентификаторСБИС, ИННПоставщика = "") Экспорт

	НачатьТранзакцию();
	Попытка

		ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра(
			"РегистрСведений.ЭАрМ_ТоварыЭТрН", ИдентификаторСБИС);

		НаборЗаписей = РегистрыСведений.ЭАрМ_ТоварыЭТрН.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдентификаторСБИС.Установить(ИдентификаторСБИС);
		НаборЗаписей.Прочитать();

		Коды  = Новый Массив;
		Ключи = Новый Массив;
		СGTIN = 0;
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Запись.ИсточникТоваров = "База2" Тогда
				Продолжить;
			КонецЕсли;
			Если Запись.СпособПоискаШК = "GTIN" Тогда
				СGTIN = СGTIN + 1;
				Продолжить;
			КонецЕсли;
			Если ЗначениеЗаполнено(Запись.КодТовараПоставщика) Тогда
				Коды.Добавить(Запись.КодТовараПоставщика);
			КонецЕсли;
			Ключи.Добавить(КлючНаименования(Запись.Наименование));
		КонецЦикла;

		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторСБИС, СтрШаблон(
			"Штрихкоды строк документа: с GTIN из самого документа %1 (их не трогаем), без GTIN %2 - ищем в штрихкодах поставщиков ИНН %3: сначала по коду товара поставщика, затем по наименованию этого ИНН, затем любого поставщика",
			СGTIN, Ключи.Количество(), ИННПоставщика));

		Если Ключи.Количество() = 0 Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		Справочник = ШтрихкодыДляПоиска(Коды, Ключи, ИННПоставщика);

		Изменено = Ложь;
		Для Каждого Запись Из НаборЗаписей Цикл

			Если Запись.ИсточникТоваров = "База2" ИЛИ Запись.СпособПоискаШК = "GTIN" Тогда
				Продолжить;
			КонецЕсли;

			Штрихкод = "";
			Способ   = "";
			КакНайден = "";

			Если ЗначениеЗаполнено(Запись.КодТовараПоставщика) Тогда
				Штрихкод = СтрокаИлиПусто(Справочник.ПоКоду.Получить(Запись.КодТовараПоставщика));
				Способ = "КодТовара";
			КонецЕсли;

			Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
				Ключ = КлючНаименования(Запись.Наименование);
				Штрихкод = СтрокаИлиПусто(Справочник.ПоНаименованиюИНН.Получить(Ключ));
				КакНайден = "по наименованию у этого ИНН (ключ «" + Ключ + "»)";
				Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
					Штрихкод = СтрокаИлиПусто(Справочник.ПоНаименованию.Получить(Ключ));
					КакНайден = "по наименованию у любого поставщика (ключ «" + Ключ + "»)";
				КонецЕсли;
				Способ = "Наименование";
			КонецЕсли;

			Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
				Способ = "";
			КонецЕсли;

			// Как назначен штрихкод строки - в трассу
			ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторСБИС, СтрШаблон(
				"Штрихкод строки %1 «%2» (код поставщика «%3»): %4 | КАК ОПРЕДЕЛЕНО: %5",
				Запись.НомерПозиции, Лев(Запись.Наименование, 60), Запись.КодТовараПоставщика,
				?(ЗначениеЗаполнено(Штрихкод), Штрихкод, "НЕ НАЙДЕН - строка останется без ШК, пары по ШК не будет"),
				?(НЕ ЗначениеЗаполнено(Штрихкод), "в штрихкодах поставщиков нет ни по коду товара, ни по наименованию",
					?(Способ = "КодТовара", "по коду товара поставщика у этого ИНН", КакНайден))),
				ЗначениеЗаполнено(Штрихкод));

			Если Запись.Штрихкод <> Штрихкод ИЛИ Запись.СпособПоискаШК <> Способ Тогда
				Запись.Штрихкод       = Лев(Штрихкод, 200);
				Запись.СпособПоискаШК = Способ;
				Изменено = Истина;
			КонецЕсли;

		КонецЦикла;

		Если Изменено Тогда
			НаборЗаписей.Записать(Истина);
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторСБИС,
			"НазначитьШтрихкоды (штрихкоды строк не назначены)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Загружает порцию регистра ШтрихкодыПоставщика Далиона.
//
// Формат: data.items[] = { "name": наименование у поставщика, "barcode": штрихкод,
// "inn": ИНН поставщика (необязательно), "code": код товара (необязательно) }.
//
Процедура ЗагрузитьШтрихкодыПоставщика(Объект) Экспорт

	Элементы = ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "items"));

	НачатьТранзакцию();
	Попытка

		Для Каждого Элемент Из Элементы Цикл

			Описание = НовоеОписаниеШтрихкода();
			Описание.Штрихкод               = ЗначениеСтрокой(Элемент, "barcode");
			Описание.НаименованиеПоставщика = ЗначениеСтрокой(Элемент, "name");
			Описание.ИННПоставщика          = ЗначениеСтрокой(Элемент, "inn");
			Описание.КодТовараПоставщика    = ЗначениеСтрокой(Элемент, "code");
			Описание.Источник               = "ШтрихкодыПоставщикаДалион";

			ЗаписатьШтрихкод(Описание);

		КонецЦикла;

		ЗафиксироватьТранзакцию();

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ЗагрузитьШтрихкодыПоставщика (штрихкоды не записаны)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Пакет header.export = Номенклатура: карточки Далиона со штрихкодами.
//
// Сохраняет карточку номенклатуры Далиона в регистр пакетов: тип
// «НоменклатураДалион», ключ - uid, статус «Обработан» (обработка пакетов её не
// берёт). Читается ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта. Новая карточка
// дополняется полями прежней, которых в ней нет: ответ на запрос по штрихкодам
// беднее выгрузки приходных (там группы, единицы, реквизиты).
//
Процедура СохранитьКарточкуНоменклатурыДалион(Идентификатор, Карточка) Экспорт

	Если НЕ ЗначениеЗаполнено(Идентификатор) ИЛИ ТипЗнч(Карточка) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Прежняя = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("НоменклатураДалион", Идентификатор);
	Если ТипЗнч(Прежняя) = Тип("Соответствие") Тогда
		Для Каждого КлючЗначение Из Прежняя Цикл
			Если Карточка.Получить(КлючЗначение.Ключ) = Неопределено Тогда
				Карточка.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Новый Структура("data", Карточка));
	Текст = Запись.Закрыть();

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_ПакетыДалион.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ТипОбъекта           = "НоменклатураДалион";
	МенеджерЗаписи.ИдентификаторОбъекта = Идентификатор;
	МенеджерЗаписи.Прочитать();
	МенеджерЗаписи.ТипОбъекта           = "НоменклатураДалион";
	МенеджерЗаписи.ИдентификаторОбъекта = Идентификатор;
	МенеджерЗаписи.НомерОбъекта         = Лев(ЗначениеСтрокой(Карточка, "code"), 50);
	МенеджерЗаписи.ДанныеПакета         = Текст;
	МенеджерЗаписи.Статус               = ЭАрМ_ПриемПакетовДалион.Статусы().Обработан;
	МенеджерЗаписи.ДатаПриема           = ТекущаяДатаСеанса();
	МенеджерЗаписи.ДатаОбработки        = ТекущаяДатаСеанса();
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

Процедура ЗагрузитьНоменклатуруДалион(Объект) Экспорт

	Элементы = ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "items"));
	Если Элементы.Количество() = 0 Тогда
		Элементы.Добавить(Объект);
	КонецЕсли;

	// Штрихкоды, которых Далион не нашёл: очередь запроса закрывает их сразу
	НеНайденные = Новый Массив;
	Для Каждого Результат Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "barcodeSearch")) Цикл
		Если ЭАрМ_Служебный.ЗначениеУзла(Результат, "found") = Ложь Тогда
			НеНайденные.Добавить(ЗначениеСтрокой(Результат, "barcode"));
		КонецЕсли;
	КонецЦикла;

	НачатьТранзакцию();
	Попытка

		Для Каждого Элемент Из Элементы Цикл

			Наименование = ЗначениеСтрокой(Элемент, "name");
			Код          = ЗначениеСтрокой(Элемент, "code");
			Идентификатор = ЗначениеСтрокой(Элемент, "uid");

			Для Каждого Штрихкод Из ШтрихкодыСтрокиДалиона(Элемент) Цикл

				Описание = НовоеОписаниеШтрихкода();
				Описание.Штрихкод                        = Штрихкод;
				Описание.НаименованиеПоставщика          = Наименование;
				Описание.НоменклатураДалион              = Наименование;
				Описание.КодНоменклатурыДалион           = Код;
				Описание.ИдентификаторНоменклатурыДалион = Идентификатор;
				Описание.Источник                        = "НоменклатураДалион";

				ЗаписатьШтрихкод(Описание);

			КонецЦикла;

			// Карточка целиком - для создания номенклатуры УТ (ЭАрМ_КатегорииТоваров)
			СохранитьКарточкуНоменклатурыДалион(Идентификатор, Элемент);

			// «Номенклатура поставщиков» карточки: код и наименование у поставщика
			ЗагрузитьПоставщиковКарточки(Элемент);

		КонецЦикла;

		ЗафиксироватьТранзакцию();

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ЗагрузитьНоменклатуруДалион (номенклатура Далиона не записана)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

	Если НеНайденные.Количество() > 0 Тогда
		ЭАрМ_КатегорииТоваров.ОтметитьНеНайденоеВДалионе(НеНайденные);
	КонецЕсли;

КонецПроцедуры

// Пересверка цепочек, где штрихкод пришедшей номенклатуры остался без пары.
//
// Номенклатура Далиона пополняет регистр штрихкодов поставщиков, а сверка
// берёт цепочку повторно, только когда изменилась сама цепочка. Строка «без
// пары», которой не хватало как раз этой карточки, так и оставалась
// несопоставленной. Здесь открытым цепочкам с такими строками ставится дата
// обновления (ЭАрМ_ЦепочкаЗакупки.ПометитьОткрытыеЦепочкиНаСверку) - задание
// их пересверит. Подписанные УПД, ручные связи и закрытые цепочки не трогаются.
//
// Параметры:
//   Объект - Соответствие - секция data пакета Номенклатура или supplierBarcodes
//
Процедура ПометитьНаСверкуПоШтрихкодамНоменклатуры(Объект) Экспорт

	Элементы = ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "items"));
	Если Элементы.Количество() = 0 Тогда
		Элементы.Добавить(Объект);
	КонецЕсли;

	КлючиПакета = Новый Соответствие;
	Для Каждого Элемент Из Элементы Цикл
		Для Каждого Штрихкод Из ШтрихкодыСтрокиДалиона(Элемент) Цикл
			Для Каждого КлючЗначение Из КлючиШтрихкода(Штрихкод) Цикл
				КлючиПакета.Вставить(КлючЗначение.Ключ, Истина);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Если КлючиПакета.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Цепочка.ИдентификаторУПД КАК ИдентификаторУПД,
	|	Сверка.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ЭАрМ_СверкаТоваровЦепочки КАК Сверка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ПО Сверка.ИдентификаторЗаказа = Цепочка.ИдентификаторЗаказа
	|			И Сверка.ИдентификаторПоступления = Цепочка.ИдентификаторПоступления
	|ГДЕ
	|	Сверка.Результат В (""НетВУПД"", ""НетВПоступлении"")
	|	И Сверка.Штрихкод <> """"
	|	И Цепочка.ИдентификаторУПД <> """"
	|	И Цепочка.Этап <> ""Закрыто""";

	Помеченные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ИдентификаторУПД = СокрЛП(Выборка.ИдентификаторУПД);
		Если Помеченные.Получить(ИдентификаторУПД) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// В строке сверки бывает несколько штрихкодов через «;»
		ЕстьВПакете = Ложь;
		Для Каждого Штрихкод Из СтрРазделить(Выборка.Штрихкод, ";,", Ложь) Цикл
			Для Каждого КлючЗначение Из КлючиШтрихкода(Штрихкод) Цикл
				Если КлючиПакета.Получить(КлючЗначение.Ключ) <> Неопределено Тогда
					ЕстьВПакете = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЕстьВПакете Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ЕстьВПакете Тогда
			Помеченные.Вставить(ИдентификаторУПД, Истина);
			//@skip-check query-in-loop
			ЭАрМ_ЦепочкаЗакупки.ПометитьОткрытыеЦепочкиНаСверку(ИдентификаторУПД);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Пополняет регистр штрихкодов из строк заказа или поступления Далиона.
//
// Каждая строка пишется отдельно. Общая транзакция на весь заказ роняла пакет:
// повтор того же штрихкода и названия (две строки одного товара или названия,
// которые после нормализации совпадают) не находил ещё не зафиксированную
// запись и Записать падал. Ошибка одной строки не откатывает остальные.
//
// Параметры:
//   Товары        - Массив - data.goods пакета
//   ИННПоставщика - Строка
//   Поставщик     - Строка - наименование
//   Источник      - Строка - "ЗаказДалион", "ПоступлениеДалион"
//
Процедура ЗагрузитьШтрихкодыИзСтрок(Товары, ИННПоставщика, Поставщик, Источник) Экспорт

	Ошибки = Новый Массив;

	Для Каждого Товар Из ЭАрМ_Служебный.ЗначениеВМассив(Товары) Цикл

		Номенклатура = ЭАрМ_Служебный.ЗначениеУзла(Товар, "nomenclature");

		Для Каждого Штрихкод Из ШтрихкодыСтрокиДалиона(Товар) Цикл

			Описание = НовоеОписаниеШтрихкода();
			Описание.Штрихкод                        = Штрихкод;
			Описание.НаименованиеПоставщика          = ЗначениеСтрокой(Номенклатура, "name");
			Описание.ИННПоставщика                   = ИННПоставщика;
			Описание.Поставщик                       = Поставщик;
			Описание.НоменклатураДалион              = ЗначениеСтрокой(Номенклатура, "name");
			Описание.КодНоменклатурыДалион           = ЗначениеСтрокой(Номенклатура, "code");
			Описание.ИдентификаторНоменклатурыДалион = ЗначениеСтрокой(Номенклатура, "uid");
			Описание.Источник                        = Источник;

			Попытка
				ЗаписатьШтрихкод(Описание);
			Исключение
				ОшибкаИсключения = ИнформацияОбОшибке();
				ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
					"ЗагрузитьШтрихкодыИзСтрок (штрихкод " + Описание.Штрихкод + " не записан в ЭАрМ_ШтрихкодыПоставщиков)",
					ОшибкаИсключения);
				Ошибки.Добавить(ЭАрМ_Служебный.КраткийТекстОшибки(ОшибкаИсключения));
			КонецПопытки;

		КонецЦикла;

		// Приходная несёт расширенную карточку (единицы, реквизиты, папки,
		// поставщики): сохраняем её для создания номенклатуры УТ и сверки
		Если ТипЗнч(Номенклатура) = Тип("Соответствие")
			И (Номенклатура.Получить("units") <> Неопределено
				ИЛИ Номенклатура.Получить("attributes") <> Неопределено) Тогда
			Попытка
				СохранитьКарточкуНоменклатурыДалион(ЗначениеСтрокой(Номенклатура, "uid"), Номенклатура);
				ЗагрузитьПоставщиковКарточки(Номенклатура);
			Исключение
				ОшибкаИсключения = ИнформацияОбОшибке();
				ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
					"ЗагрузитьШтрихкодыИзСтрок (карточка номенклатуры Далиона не сохранена)", ОшибкаИсключения);
				Ошибки.Добавить(ЭАрМ_Служебный.КраткийТекстОшибки(ОшибкаИсключения));
			КонецПопытки;
		КонецЕсли;

	КонецЦикла;

	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(Ошибки, "; ");
	КонецЕсли;

КонецПроцедуры

// «Номенклатура поставщиков» карточки Далиона (suppliers[]) - в регистр штрихкодов
// поставщиков: штрихкод карточки + наименование, код и ИНН поставщика. По ним
// сверка находит товар по коду и названию поставщика из УПД, а команда переноса
// ЭАрМ_НоменклатураПоставщиковУТ создаёт из них номенклатуру контрагентов УТ.
//
// Параметры:
//   Карточка - Соответствие - узел nomenclature (карточка номенклатуры Далиона)
//
Процедура ЗагрузитьПоставщиковКарточки(Карточка)

	Поставщики = ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Карточка, "suppliers"));
	Если Поставщики.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Штрихкод = ПредпочтительныйШтрихкод(ШтрихкодыСтрокиДалиона(Карточка));
	Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат;
	КонецЕсли;

	НаименованиеКарточки = ЗначениеСтрокой(Карточка, "name");

	Для Каждого Поставщик Из Поставщики Цикл

		ИмяУПоставщика = ЗначениеСтрокой(Поставщик, "name");
		Если НЕ ЗначениеЗаполнено(ИмяУПоставщика) Тогда
			ИмяУПоставщика = НаименованиеКарточки;
		КонецЕсли;

		Узел = ЭАрМ_Служебный.ЗначениеУзла(Поставщик, "supplier");

		Описание = НовоеОписаниеШтрихкода();
		Описание.Штрихкод                        = Штрихкод;
		Описание.НаименованиеПоставщика          = ИмяУПоставщика;
		Описание.ИННПоставщика                   = ЗначениеСтрокой(Узел, "inn");
		Описание.Поставщик                       = ЗначениеСтрокой(Узел, "name");
		Описание.КодТовараПоставщика             = ЗначениеСтрокой(Поставщик, "code");
		Описание.НоменклатураДалион              = НаименованиеКарточки;
		Описание.КодНоменклатурыДалион           = ЗначениеСтрокой(Карточка, "code");
		Описание.ИдентификаторНоменклатурыДалион = ЗначениеСтрокой(Карточка, "uid");
		Описание.Источник                        = "ПоставщикиДалион";

		ЗаписатьШтрихкод(Описание);

	КонецЦикла;

КонецПроцедуры

// Нормализованное наименование: верхний регистр, только буквы и цифры.
// "Молоко 3,2% 1л." и "МОЛОКО 3.2 % 1 Л" дают одно и то же.
//
Функция НормализованноеНаименование(Наименование) Экспорт

	Текст = ВРег(СокрЛП(СтрокаИлиПусто(Наименование)));
	Текст = СтрЗаменить(Текст, "Ё", "Е");

	Результат = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZАБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Одинаковые названия: точная нормализация или те же значимые слова.
// Основы слов - как у склада в адресе ЭТрН (ЭАрМ_ЦепочкаЗакупки.СкладВАдресе):
// первые пять букв слова из трёх и длиннее должны найтись в другом названии.
// Цифры короткого имени (жир, вес, объём) должны быть и в длинном, иначе
// «молоко 3.2» совпадёт с «молоко 2.5».
//
Функция НаименованияСовпадают(НаименованиеА, НаименованиеБ) Экспорт

	НормА = НормализованноеНаименование(НаименованиеА);
	НормБ = НормализованноеНаименование(НаименованиеБ);
	Если НЕ ЗначениеЗаполнено(НормА) ИЛИ НЕ ЗначениеЗаполнено(НормБ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НормА = НормБ Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат НаименованияПохожиПоСловам(НаименованиеА, НаименованиеБ, НормА, НормБ);

КонецФункции

// MD5 нормализованного наименования - короткий индексируемый ключ поиска.
//
Функция КлючНаименования(Наименование) Экспорт

	Нормализованное = НормализованноеНаименование(Наименование);
	Если НЕ ЗначениеЗаполнено(Нормализованное) Тогда
		Возврат "";
	КонецЕсли;

	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеширование.Добавить(Нормализованное);

	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

// Ядро названия без категорий, жира и фасовки.
//
// «Киндер Молочный ломтик 27,9% 28гр (20шт)» и
// «БЗМЖ Пирожное Киндер Молочный ломтик 28гр» сходятся: общее ядро
// КИНДЕ+МОЛОЧ+ЛОМТИ и вес 28. БЗМЖ/пирожное, 27,9% и 20 шт в пару не входят.
//
Функция НаименованияПохожиПоСловам(НаименованиеА, НаименованиеБ, НормА, НормБ)

	Возврат ОценкаПохожестиНаименований(НаименованиеА, НаименованиеБ) >= 0.8;

КонецФункции

// Оценка 0–1, как в тесте распознавания названий: доля сопоставленных слов
// с опечатками и склейкой, минус штраф, если с обеих сторон осталось
// отличающее слово («яблоко» ↔ «апельсин»).
//
// 0 - другой товар (в том числе разный вес или жирность). 1 - то же имя.
// Автосверка берёт пары от 0.8; ручной прогон - от ПорогСовпадения (до 0.5).
//
Функция ОценкаПохожестиНаименований(НаименованиеА, НаименованиеБ) Экспорт

	НормА = НормализованноеНаименование(НаименованиеА);
	НормБ = НормализованноеНаименование(НаименованиеБ);
	Если НЕ ЗначениеЗаполнено(НормА) ИЛИ НЕ ЗначениеЗаполнено(НормБ) Тогда
		Возврат 0;
	КонецЕсли;
	Если НормА = НормБ Тогда
		Возврат 1;
	КонецЕсли;

	РазборА = РазборНаименованияДляСлов(НаименованиеА);
	РазборБ = РазборНаименованияДляСлов(НаименованиеБ);
	Если НЕ ВесаНаименованийСовместимы(РазборА.Веса, РазборБ.Веса) Тогда
		Возврат 0;
	КонецЕсли;
	Если НЕ ВесаНаименованийСовместимы(РазборА.Проценты, РазборБ.Проценты) Тогда
		Возврат 0;
	КонецЕсли;

	СловаА = ?(РазборА.ПолныеСлова.Количество() > 0, РазборА.ПолныеСлова, РазборА.Слова);
	СловаБ = ?(РазборБ.ПолныеСлова.Количество() > 0, РазборБ.ПолныеСлова, РазборБ.Слова);
	МеньшеСлов = Мин(СловаА.Количество(), СловаБ.Количество());
	Если МеньшеСлов = 0 Тогда
		Возврат ОценкаСжатыхНаименований(НормА, НормБ);
	КонецЕсли;

	Сопоставление = СопоставитьСловаНаименований(СловаА, СловаБ, НормА, НормБ);
	Доля = Сопоставление.Совпало / МеньшеСлов;
	Сжатая = ОценкаСжатыхНаименований(НормА, НормБ);
	Если Сжатая > Доля Тогда
		Доля = Сжатая;
	КонецЕсли;
	Если Сопоставление.ОтличающееСлово Тогда
		Доля = Доля - 0.45;
	КонецЕсли;
	Если Доля < 0 Тогда
		Возврат 0;
	КонецЕсли;
	Если Доля > 1 Тогда
		Возврат 1;
	КонецЕсли;

	Возврат Доля;

КонецФункции

Функция СопоставитьСловаНаименований(СловаА, СловаБ, НормА, НормБ)

	Результат = Новый Структура("Совпало, ОтличающееСлово", 0, Ложь);
	ЗанятыеБ = Новый Соответствие;
	НесовпавшиеА = Новый Массив;

	Для Каждого СловоА Из СловаА Цикл
		ИндексБ = ИндексПохожегоСлова(СловоА, СловаБ, ЗанятыеБ, НормБ);
		Если ИндексБ >= 0 Тогда
			ЗанятыеБ.Вставить(ИндексБ, Истина);
			Результат.Совпало = Результат.Совпало + 1;
		ИначеЕсли ИндексБ = -2 Тогда
			Результат.Совпало = Результат.Совпало + 1;
		Иначе
			НесовпавшиеА.Добавить(СловоА);
		КонецЕсли;
	КонецЦикла;

	НесовпавшиеБ = Новый Массив;
	Для Индекс = 0 По СловаБ.ВГраница() Цикл
		Если ЗанятыеБ.Получить(Индекс) = Неопределено Тогда
			НесовпавшиеБ.Добавить(СловаБ[Индекс]);
		КонецЕсли;
	КонецЦикла;

	ЕстьА = Ложь;
	ЕстьБ = Ложь;
	Для Каждого Слово Из НесовпавшиеА Цикл
		Если СтрДлина(Слово) >= 4 Тогда
			ЕстьА = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Слово Из НесовпавшиеБ Цикл
		Если СтрДлина(Слово) >= 4 Тогда
			ЕстьБ = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НЕ (ЕстьА И ЕстьБ) Тогда
		Возврат Результат;
	КонецЕсли;

	ЕстьПохожиеОстатки = Ложь;
	Для Каждого СловоА Из НесовпавшиеА Цикл
		Для Каждого СловоБ Из НесовпавшиеБ Цикл
			Если СловаНаименованияПохожи(СловоА, СловоБ) Тогда
				ЕстьПохожиеОстатки = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьПохожиеОстатки Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Результат.ОтличающееСлово = НЕ ЕстьПохожиеОстатки;

	Возврат Результат;

КонецФункции

// -1 нет пары, -2 слово нашлось внутри сжатого имени другой стороны (склейка),
// иначе индекс слова в СловаБ.
//
Функция ИндексПохожегоСлова(СловоА, СловаБ, ЗанятыеБ, НормБ)

	Для Индекс = 0 По СловаБ.ВГраница() Цикл
		Если ЗанятыеБ.Получить(Индекс) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СловаНаименованияПохожи(СловоА, СловаБ[Индекс]) Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	Если СтрДлина(СловоА) >= 4 И СтрНайти(НормБ, СловоА) > 0 Тогда
		Возврат -2;
	КонецЕсли;

	Возврат -1;

КонецФункции

Функция СловаНаименованияПохожи(СловоА, СловоБ)

	Если СловоА = СловоБ Тогда
		Возврат Истина;
	КонецЕсли;

	ДлинаА = СтрДлина(СловоА);
	ДлинаБ = СтрДлина(СловоБ);
	Меньше = Мин(ДлинаА, ДлинаБ);
	Если Меньше < 4 Тогда
		Возврат Ложь;
	КонецЕсли;

	Длиннее = ?(ДлинаА >= ДлинаБ, СловоА, СловоБ);
	Короче  = ?(ДлинаА < ДлинаБ, СловоА, СловоБ);
	Если СтрНайти(Длиннее, Короче) > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Расстояние = РасстояниеЛевенштейна(СловоА, СловоБ);
	Если Расстояние <= 1 Тогда
		Возврат Истина;
	КонецЕсли;
	Если Меньше >= 7 И Расстояние <= 2 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ОценкаСжатыхНаименований(НормА, НормБ)

	ДлинаА = СтрДлина(НормА);
	ДлинаБ = СтрДлина(НормБ);
	Больше = Макс(ДлинаА, ДлинаБ);
	Если Больше = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Если СтрНайти(НормА, НормБ) > 0 ИЛИ СтрНайти(НормБ, НормА) > 0 Тогда
		Меньше = Мин(ДлинаА, ДлинаБ);
		Если Меньше >= 8 Тогда
			Возврат Мин(1, Меньше / Больше);
		КонецЕсли;
	КонецЕсли;

	Возврат Макс(0, 1 - РасстояниеЛевенштейна(НормА, НормБ) / Больше);

КонецФункции

Функция РасстояниеЛевенштейна(СтрокаА, СтрокаБ)

	ДлинаА = СтрДлина(СтрокаА);
	ДлинаБ = СтрДлина(СтрокаБ);
	Если ДлинаА = 0 Тогда
		Возврат ДлинаБ;
	КонецЕсли;
	Если ДлинаБ = 0 Тогда
		Возврат ДлинаА;
	КонецЕсли;
	Если Макс(ДлинаА, ДлинаБ) - Мин(ДлинаА, ДлинаБ) > 8 Тогда
		Возврат Макс(ДлинаА, ДлинаБ);
	КонецЕсли;

	Предыдущая = Новый Массив;
	Текущая = Новый Массив;
	Для Индекс = 0 По ДлинаБ Цикл
		Предыдущая.Добавить(Индекс);
		Текущая.Добавить(0);
	КонецЦикла;

	Для ПозицияА = 1 По ДлинаА Цикл
		Текущая[0] = ПозицияА;
		СимволА = Сред(СтрокаА, ПозицияА, 1);
		Для ПозицияБ = 1 По ДлинаБ Цикл
			Цена = ?(СимволА = Сред(СтрокаБ, ПозицияБ, 1), 0, 1);
			Текущая[ПозицияБ] = Мин(Мин(Текущая[ПозицияБ - 1] + 1, Предыдущая[ПозицияБ] + 1),
				Предыдущая[ПозицияБ - 1] + Цена);
		КонецЦикла;
		Для ПозицияБ = 0 По ДлинаБ Цикл
			Предыдущая[ПозицияБ] = Текущая[ПозицияБ];
		КонецЦикла;
	КонецЦикла;

	Возврат Предыдущая[ДлинаБ];

КонецФункции

// Разбор названия на признаки для сравнения: основы слов, вес или объём и
// процент (жирность, доля сока, какао).
//
// Вес и объём переводятся в граммы и миллилитры: «0,95 л» = «950 мл»,
// «1 кг» = «1000 г». Запятая и точка между цифрами - десятичный разделитель,
// а не граница слова: раньше «0,95 л» распадалось на «0» и «95 л», а
// «1,5 л» давало вес «5».
//
// Процент - отдельный признак: «кефир 2,5%» и «кефир 3,2%» - разные товары.
// Раньше процент выбрасывался, и такие строки считались одним товаром.
//
// Латинские буквы-двойники внутри русского слова заменяются кириллицей:
// «Cыр» с латинской C - тот же «Сыр». Слова целиком латиницей (бренды)
// не трогаются. Только для сравнения: НормализованноеНаименование и ключи
// в регистрах (КлючНаименования) остаются прежними.
//
// Возвращаемое значение:
//   Структура:
//     * Слова       - Массив из Строка - основы значимых слов, первые пять букв
//     * ПолныеСлова - Массив из Строка - те же слова целиком (опечатки, склейка)
//     * Веса        - Массив из Строка - вес или объём в граммах/миллилитрах
//     * Проценты    - Массив из Строка - числа перед знаком процента
//     * Текст       - Строка - название в верхнем регистре
//
Функция РазборНаименованияДляСлов(Наименование)

	Результат = Новый Структура("Слова, ПолныеСлова, Веса, Проценты, Текст",
		Новый Массив, Новый Массив, Новый Массив, Новый Массив, "");
	Текст = ТекстНаименованияДляСлов(Наименование);
	Результат.Текст = Текст;
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	ТекстРазбора = ЗащититьДробныеЧисла(Текст);
	ТекстРазбора = СтрЗаменить(ТекстРазбора, "%", " ПРОЦ ");
	Знаки = ",.;:()""'-/\№#+*&";
	Для Позиция = 1 По СтрДлина(Знаки) Цикл
		ТекстРазбора = СтрЗаменить(ТекстРазбора, Сред(Знаки, Позиция, 1), " ");
	КонецЦикла;

	Служебные = "|ДЛЯ|БЕЗ|ПРИ|ИЛИ|ПРО|ПОД|НАД|ШТ|КГ|МЛ|Л|Г|ГР|УП|УПАК|УПАКОВКА|КОРОБКА|КОРОБ|ПАЧКА|"
		+ "ВЕСОВОЙ|ТОВАР|ПРОДУКТ|БЗМЖ|ПИРОЖНОЕ|ПИРОЖ|ТОРТ|КОНФЕТЫ|ПЕЧЕНЬЕ|НАПИТОК|НОВИНКА|ФАСОВКА|"
		+ "ОХЛАЖДЕННЫЙ|СВЕЖИЙ|ПРОЦ|";
	ЕдиницыВеса = "|Г|ГР|КГ|МЛ|Л|";
	ЕдиницыУпак = "|ШТ|УП|УПАК|УПАКОВКА|КОРОБ|КОРОБКА|ПАЧКА|";

	ДобавленныеСлова    = Новый Соответствие;
	ДобавленныеВеса     = Новый Соответствие;
	ДобавленныеПроценты = Новый Соответствие;
	Слова = СтрРазделить(ТекстРазбора, " ", Ложь);
	Индекс = 0;

	Пока Индекс < Слова.Количество() Цикл

		Слово = Слова[Индекс];
		Индекс = Индекс + 1;
		Если Слово = "ПРОЦ" Тогда
			Продолжить;
		КонецЕсли;

		ЧислоТокена = "";
		Хвост = "";
		ОтделитьЧислоТокена(Слово, ЧислоТокена, Хвост);

		Если ЗначениеЗаполнено(ЧислоТокена) Тогда

			Единица = Хвост;
			Если НЕ ЗначениеЗаполнено(Единица) И Индекс < Слова.Количество() Тогда
				Следующее = Слова[Индекс];
				Если СтрНайти(ЕдиницыВеса + ЕдиницыУпак + "|ПРОЦ|", "|" + Следующее + "|") > 0 Тогда
					Единица = Следующее;
					Индекс = Индекс + 1;
				КонецЕсли;
			КонецЕсли;

			Если Единица = "ПРОЦ" Тогда
				Значение = ЧислоПризнака(ЧислоТокена, 1);
				Если ЗначениеЗаполнено(Значение) И ДобавленныеПроценты.Получить(Значение) = Неопределено Тогда
					ДобавленныеПроценты.Вставить(Значение, Истина);
					Результат.Проценты.Добавить(Значение);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если СтрНайти(ЕдиницыУпак, "|" + Единица + "|") > 0 Тогда
				Продолжить;
			КонецЕсли;
			Если СтрНайти(ЕдиницыВеса, "|" + Единица + "|") > 0 Тогда
				Множитель = ?(Единица = "КГ" ИЛИ Единица = "Л", 1000, 1);
				Значение = ЧислоПризнака(ЧислоТокена, Множитель);
				Если ЗначениеЗаполнено(Значение) И ДобавленныеВеса.Получить(Значение) = Неопределено Тогда
					ДобавленныеВеса.Вставить(Значение, Истина);
					Результат.Веса.Добавить(Значение);
				КонецЕсли;
			КонецЕсли;
			Продолжить;

		КонецЕсли;

		Слово = КириллицаВместоДвойников(Слово);

		Если СтрДлина(Слово) < 3 ИЛИ СтрНайти(Служебные, "|" + Слово + "|") > 0 Тогда
			Продолжить;
		КонецЕсли;

		Основа = Лев(Слово, 5);
		Если ДобавленныеСлова.Получить(Основа) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавленныеСлова.Вставить(Основа, Истина);
		Результат.Слова.Добавить(Основа);
		Результат.ПолныеСлова.Добавить(Слово);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Помечает десятичный разделитель между цифрами знаком «_», чтобы разбор по
// знакам препинания не разрезал число: «0,95» -> «0_95», «3.2» -> «3_2».
//
Функция ЗащититьДробныеЧисла(Текст)

	Результат = "";
	Цифры = "0123456789";
	Длина = СтрДлина(Текст);

	Для Позиция = 1 По Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если (Символ = "," ИЛИ Символ = ".")
			И Позиция > 1 И Позиция < Длина
			И СтрНайти(Цифры, Сред(Текст, Позиция - 1, 1)) > 0
			И СтрНайти(Цифры, Сред(Текст, Позиция + 1, 1)) > 0 Тогда
			Результат = Результат + "_";
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Число в начале токена (цифры и помеченный разделитель) и остаток за ним:
// «0_95Л» -> «0_95» и «Л».
//
Процедура ОтделитьЧислоТокена(Слово, ЧислоТокена, Хвост)

	ЧислоТокена = "";
	Хвост = "";
	Для Позиция = 1 По СтрДлина(Слово) Цикл
		Символ = Сред(Слово, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 ИЛИ Символ = "_" И Позиция > 1 Тогда
			ЧислоТокена = ЧислоТокена + Символ;
		Иначе
			Хвост = Сред(Слово, Позиция);
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Число признака строкой, одинаковой записи для обеих сторон: «0_95» с
// множителем 1000 -> «950», «2_50» -> «2.5». Нулевое число - пустая строка.
//
// Разбирается вручную, без Число() над дробью: там десятичный разделитель
// зависит от настроек, а здесь он всегда «_».
//
Функция ЧислоПризнака(ЧислоТокена, Множитель)

	Части = СтрРазделить(ЧислоТокена, "_", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Значение = Число(Части[0]);
	Если Части.Количество() > 1 Тогда
		Делитель = 1;
		Для Позиция = 1 По СтрДлина(Части[1]) Цикл
			Делитель = Делитель * 10;
		КонецЦикла;
		Значение = Значение + Число(Части[1]) / Делитель;
	КонецЕсли;

	Значение = Окр(Значение * Множитель, 3);
	Если Значение = 0 Тогда
		Возврат "";
	КонецЕсли;

	Если Значение = Цел(Значение) Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;

	Возврат Формат(Значение, "ЧГ=0; ЧРД=.");

КонецФункции

// Латинские буквы, неотличимые от русских, внутри русского слова заменяются
// кириллицей. Слово без единой русской буквы (бренд латиницей) не меняется.
//
Функция КириллицаВместоДвойников(Слово)

	Кириллица = "АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ";
	ЕстьКириллица = Ложь;
	Для Позиция = 1 По СтрДлина(Слово) Цикл
		Если СтрНайти(Кириллица, Сред(Слово, Позиция, 1)) > 0 Тогда
			ЕстьКириллица = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЕстьКириллица Тогда
		Возврат Слово;
	КонецЕсли;

	Латиница = "ABCEHKMOPTXY";
	Двойники = "АВСЕНКМОРТХУ";
	Результат = "";
	Для Позиция = 1 По СтрДлина(Слово) Цикл
		Символ = Сред(Слово, Позиция, 1);
		Номер = СтрНайти(Латиница, Символ);
		Результат = Результат + ?(Номер > 0, Сред(Двойники, Номер, 1), Символ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПересечениеСтрок(Первый, Второй)

	Результат = Новый Массив;
	Для Каждого Значение Из Первый Цикл
		Если Второй.Найти(Значение) <> Неопределено И Результат.Найти(Значение) = Неопределено Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Признаки двух названий совместимы: у одной из сторон признака нет или есть
// общее значение. Годится и для весов, и для процентов.
//
Функция ВесаНаименованийСовместимы(ВесаА, ВесаБ)

	Если ВесаА.Количество() = 0 ИЛИ ВесаБ.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ПересечениеСтрок(ВесаА, ВесаБ).Количество() > 0;

КонецФункции

Функция КлючПарыПоИмени(НаименованиеА, НаименованиеБ) Экспорт

	РазборА = РазборНаименованияДляСлов(НаименованиеА);
	РазборБ = РазборНаименованияДляСлов(НаименованиеБ);
	Части = ПересечениеСтрок(РазборА.Слова, РазборБ.Слова);
	Для Каждого Вес Из ПересечениеСтрок(РазборА.Веса, РазборБ.Веса) Цикл
		Части.Добавить("#" + Вес);
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Части = ОтсортированныеСтроки(Части);

	Возврат КлючИзСтроки(СтрСоединить(Части, "|"));

КонецФункции

// Массив строк по возрастанию.
//
// У Массива метода Сортировать нет - он есть только у списка значений и
// таблицы значений. Вызов Массив.Сортировать() падал с «Метод объекта не
// обнаружен» и обрывал всю сверку цепочки, как только находилась пара по
// названию.
//
Функция ОтсортированныеСтроки(Строки)

	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Строки);
	Список.СортироватьПоЗначению();

	Возврат Список.ВыгрузитьЗначения();

КонецФункции

Функция КлючИзСтроки(Текст)

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеширование.Добавить(Текст);

	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

// Значимые основы названия без категорий, единиц и фасовки.
//
Функция ЗначимыеСловаНаименования(Наименование)

	Возврат РазборНаименованияДляСлов(Наименование).Слова;

КонецФункции

Функция ТекстНаименованияДляСлов(Наименование)

	Возврат СтрЗаменить(ВРег(СокрЛП(СтрокаИлиПусто(Наименование))), "Ё", "Е");

КонецФункции

Функция ЦифрыНаименования(Нормализованное)

	Результат = Новый Массив;
	Текущее = "";

	Для Позиция = 1 По СтрДлина(Нормализованное) Цикл
		Символ = Сред(Нормализованное, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Текущее = Текущее + Символ;
		ИначеЕсли ЗначениеЗаполнено(Текущее) Тогда
			Результат.Добавить(Текущее);
			Текущее = "";
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(Текущее) Тогда
		Результат.Добавить(Текущее);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Сопоставление

// Собирает строки четырёх документов цепочки и сопоставляет их.
//
Функция ПостроитьЛинии(Цепочка, ИдентификаторЗаказа, ИдентификаторПоступления, Настройки)

	Если ЗначениеЗаполнено(Цепочка.ИдентификаторУПД) Тогда
		НазначитьШтрихкоды(Цепочка.ИдентификаторУПД, Цепочка.ИННПоставщика);
	КонецЕсли;
	Если ЗначениеЗаполнено(Цепочка.ИдентификаторЭТрН) Тогда
		НазначитьШтрихкоды(Цепочка.ИдентификаторЭТрН, Цепочка.ИННПоставщика);
	КонецЕсли;

	СтрокиЗаказа = Новый Массив;
	Если НЕ СтрНачинаетсяС(ИдентификаторЗаказа, "ПН:") Тогда
		СтрокиЗаказа = СтрокиДалиона(
			ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ЗаказПоставщику", ИдентификаторЗаказа), "Заказ");
	КонецЕсли;

	СтрокиПоступления = Новый Массив;
	Если ЗначениеЗаполнено(ИдентификаторПоступления) Тогда
		СтрокиПоступления = СтрокиДалиона(
			ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ПриходнаяНакладная", ИдентификаторПоступления), "Поступление");
		// Цена, исправленная вручную с комментарием, заменяет цену пакета
		ЭАрМ_ПравкиЦен.ПрименитьКСтрокамПоступления(СтрокиПоступления, ИдентификаторПоступления);
	КонецЕсли;

	СтрокиУПД  = СтрокиЭДО(Цепочка.ИдентификаторУПД, "УПД");
	СтрокиЭТрН = СтрокиЭДО(Цепочка.ИдентификаторЭТрН, "ЭТрН");

	// НазначитьШтрихкоды даёт строке один штрихкод, а у Далиона может стоять
	// другой штрихкод той же номенклатуры: добавляем все штрихкоды товара и
	// номенклатуру Далиона из регистра штрихкодов поставщиков
	ДополнитьСтрокиЭДОИзШтрихкодовПоставщика(СтрокиУПД, Цепочка.ИННПоставщика);
	ДополнитьСтрокиЭДОИзШтрихкодовПоставщика(СтрокиЭТрН, Цепочка.ИННПоставщика);

	// Строки ЭТрН со строками УПД по наименованию сходятся плохо, а коды
	// маркировки у поставщика часто только в ЭТрН
	ПеренестиМаркировкиПоGTIN(СтрокиУПД, СтрокиЭТрН);

	Линии = СопоставитьСтроки(СтрокиЗаказа, СтрокиПоступления, СтрокиУПД, СтрокиЭТрН,
		ЗначениеЗаполнено(Цепочка.ИдентификаторУПД),
		ЗначениеЗаполнено(Цепочка.ИдентификаторЭТрН), Настройки);
	ПрименитьСверкуСтрокВручную(Линии, Цепочка.ИдентификаторУПД);

	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
		"Сверка / ПостроитьЛинии: построено строк сверки %1 (УПД %2, ЭТрН %3, заказ %4)",
		Линии.Количество(), ?(ЗначениеЗаполнено(Цепочка.ИдентификаторУПД), "есть", "нет"),
		?(ЗначениеЗаполнено(Цепочка.ИдентификаторЭТрН), "есть", "нет"), ИдентификаторЗаказа),
		Линии.Количество() > 0, , Линии.Количество());

	Возврат Линии;

КонецФункции

// Строка, которую человек отметил в таблице товаров УПД, не возвращается
// в расхождения пересверкой. Количество и сумма линии не меняются: итоговая
// сумма УПД и прихода считается как была.
//
Процедура ПрименитьСверкуСтрокВручную(Линии, ИдентификаторУПД)

	Отметки = ЭАрМ_КорректировкиУПД.ОтметкиСтрокСверкиВручную(ИдентификаторУПД);
	Если Отметки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Линия Из Линии Цикл

		Если Линия.УПД = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Позиции = Новый Массив;
		Для Каждого Номер Из Линия.УПД.Позиции Цикл
			Позиции.Добавить(Формат(Номер, "ЧГ=0"));
		КонецЦикла;
		Если Позиции.Количество() = 0 И Линия.УПД.НомерПозиции > 0 Тогда
			Позиции.Добавить(Формат(Линия.УПД.НомерПозиции, "ЧГ=0"));
		КонецЕсли;

		Отметка = ЭАрМ_КорректировкиУПД.ОтметкаСтрокиСверкиВручную(Отметки,
			СтрСоединить(Позиции, ";"), Линия.УПД.Наименование);
		Если Отметка = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Было = СокрЛП(Линия.Комментарий);
		Линия.Критично = Ложь;
		Линия.Результат = "Совпадает";
		Линия.Комментарий = СтрШаблон("сверено вручную (%1: %2)", Отметка.Кем, Отметка.Комментарий);
		Если ЗначениеЗаполнено(Было) Тогда
			Линия.Комментарий = Линия.Комментарий + ". Было: " + Было;
		КонецЕсли;
		Линия.Пояснение = СтрШаблон("СВЕРЕНО ВРУЧНУЮ (%1) - результат принудительно «Совпадает»; автоматически было: %2",
			Отметка.Кем, ?(ЗначениеЗаполнено(Линия.Пояснение), Линия.Пояснение, Было));

	КонецЦикла;

КонецПроцедуры

// Переносит коды маркировки строк-источников в строки УПД без кодов по GTIN,
// зашитому в код (см. ЭАрМ_КодыМаркировки.РазложитьКодыПоGTIN). У источника
// перенесённые коды убираются: в реестре товаров код не должен стоять на двух
// линиях сразу.
//
Процедура ПеренестиМаркировкиПоGTIN(СтрокиУПД, СтрокиИсточника)

	Занятые = Новый Соответствие;
	Получатели = Новый Массив;
	ОписанияПолучателей = Новый Массив;

	Для Каждого Строка Из СтрокиУПД Цикл

		Если Строка.Маркировки.Количество() > 0 Тогда
			Для Каждого Код Из Строка.Маркировки Цикл
				Занятые.Вставить(Код, Истина);
			КонецЦикла;
			Продолжить;
		КонецЕсли;

		Если Строка.Штрихкоды.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Штрихкоды = Новый Массив;
		Для Каждого КлючЗначение Из Строка.Штрихкоды Цикл
			Штрихкоды.Добавить(КлючЗначение.Ключ);
		КонецЦикла;

		Получатели.Добавить(Строка);
		ОписанияПолучателей.Добавить(Новый Структура("Штрихкоды, Количество", Штрихкоды, Строка.Количество));

	КонецЦикла;

	Если Получатели.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Свободные = Новый Массив;
	Для Каждого Строка Из СтрокиИсточника Цикл
		Для Каждого Код Из Строка.Маркировки Цикл
			Если Занятые.Получить(Код) = Неопределено Тогда
				Свободные.Добавить(Код);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Разложенные = ЭАрМ_КодыМаркировки.РазложитьКодыПоGTIN(ОписанияПолучателей, Свободные);

	Перенесенные = Новый Соответствие;
	Для Индекс = 0 По Получатели.ВГраница() Цикл
		Для Каждого Код Из Разложенные[Индекс] Цикл
			Получатели[Индекс].Маркировки.Добавить(Код);
			Перенесенные.Вставить(Код, Истина);
		КонецЦикла;
		Если Разложенные[Индекс].Количество() > 0 Тогда
			Получатели[Индекс].Маркирован = Истина;
		КонецЕсли;
	КонецЦикла;

	Если Перенесенные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Строка Из СтрокиИсточника Цикл
		Оставшиеся = Новый Массив;
		Для Каждого Код Из Строка.Маркировки Цикл
			Если Перенесенные.Получить(Код) = Неопределено Тогда
				Оставшиеся.Добавить(Код);
			КонецЕсли;
		КонецЦикла;
		Строка.Маркировки = Оставшиеся;
	КонецЦикла;

КонецПроцедуры

// Строит линии сверки: одна линия - один товар, у которого может быть строка
// в каждом из четырёх документов.
//
// Возвращаемое значение:
//   Массив из Структура - см. НоваяЛиния
//
Функция СопоставитьСтроки(СтрокиЗаказа, СтрокиПоступления, СтрокиУПД, СтрокиЭТрН,
	УПДСвязана, ЭТрНСвязана, Настройки)

	ПодготовитьКешПарПоИмени(Настройки);

	Линии = Новый Массив;

	// Эталон - заказ; цепочка без заказа сверяется от поступления
	ЕстьЗаказ = СтрокиЗаказа.Количество() > 0;
	Эталоны = ?(ЕстьЗаказ, СтрокиЗаказа, СтрокиПоступления);

	// Пары подбираются не строка за строкой, а проходами по всем линиям:
	// сначала только штрихкоды, потом остальные способы. Иначе строка без
	// общего штрихкода забирала по имени или по сумме строку, штрихкод
	// которой совпадал со следующей строкой, и та оставалась без пары.
	Для Каждого СтрокаЭталона Из Эталоны Цикл

		Линия = НоваяЛиния(Линии.Количество() + 1);

		Если ЕстьЗаказ Тогда
			Линия.Заказ = СтрокаЭталона;
			Пара = НайтиПару(ЗначениеВМассиве(СтрокаЭталона), СтрокиПоступления, Ложь, Настройки, Истина);
			Если Пара <> Неопределено Тогда
				Линия.Поступление = Пара.Строка;
				Линия.Способ      = Пара.Способ;
			КонецЕсли;
		Иначе
			Линия.Поступление = СтрокаЭталона;
			СтрокаЭталона.Использована = Истина;
		КонецЕсли;

		Линии.Добавить(Линия);

	КонецЦикла;

	Если ЕстьЗаказ Тогда
		Для Каждого Линия Из Линии Цикл
			Если Линия.Поступление <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Пара = НайтиПару(ЗначениеВМассиве(Линия.Заказ), СтрокиПоступления, Истина, Настройки);
			Если Пара <> Неопределено Тогда
				Линия.Поступление = Пара.Строка;
				Линия.Способ      = Пара.Способ;
			КонецЕсли;
		КонецЦикла;

		// Остатки: строки, которых нет в заказе
		Для Каждого СтрокаПоступления Из СтрокиПоступления Цикл
			Если НЕ СтрокаПоступления.Использована Тогда
				Линия = НоваяЛиния(Линии.Количество() + 1);
				Линия.Поступление = СтрокаПоступления;
				СтрокаПоступления.Использована = Истина;
				Линии.Добавить(Линия);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Линия Из Линии Цикл
		Пара = НайтиПаруУПДПоШтрихкоду(КлючиЛинииДляПодбора(Линия), СтрокиУПД, Истина);
		УстановитьПаруУПДЛинии(Линия, Пара);
		Пара = НайтиПару(КлючиЛинииДляПодбора(Линия), СтрокиЭТрН, Ложь, Настройки, Истина);
		Если Пара <> Неопределено Тогда
			Линия.ЭТрН = Пара.Строка;
		КонецЕсли;
	КонецЦикла;

	// Номенклатура Далиона - так же надёжно, как штрихкод, и тоже для всех
	// линий до подбора по имени и цифрам
	Для Каждого Линия Из Линии Цикл
		Если Линия.УПД = Неопределено Тогда
			Пара = НайтиПаруУПДПоНоменклатуре(КлючиЛинииДляПодбора(Линия), СтрокиУПД);
			УстановитьПаруУПДЛинии(Линия, Пара);
		КонецЕсли;
		Если Линия.ЭТрН = Неопределено Тогда
			Пара = НайтиПаруУПДПоНоменклатуре(КлючиЛинииДляПодбора(Линия), СтрокиЭТрН);
			Если Пара <> Неопределено Тогда
				Линия.ЭТрН = Пара.Строка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Линия Из Линии Цикл
		Если Линия.УПД = Неопределено Тогда
			Пара = НайтиПаруУПД(КлючиЛинииДляПодбора(Линия), СтрокиУПД, Настройки);
			УстановитьПаруУПДЛинии(Линия, Пара);
		КонецЕсли;
		Если Линия.ЭТрН = Неопределено Тогда
			Пара = НайтиПару(КлючиЛинииДляПодбора(Линия), СтрокиЭТрН, Ложь, Настройки);
			Если Пара <> Неопределено Тогда
				Линия.ЭТрН = Пара.Строка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаУПД Из СтрокиУПД Цикл
		Если НЕ СтрокаУПД.Использована Тогда
			Линия = НоваяЛиния(Линии.Количество() + 1);
			Линия.УПД = СтрокаУПД;
			СтрокаУПД.Использована = Истина;
			Линии.Добавить(Линия);
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаЭТрН Из СтрокиЭТрН Цикл
		Если НЕ СтрокаЭТрН.Использована Тогда
			Линия = НоваяЛиния(Линии.Количество() + 1);
			Линия.ЭТрН = СтрокаЭТрН;
			СтрокаЭТрН.Использована = Истина;
			Линии.Добавить(Линия);
		КонецЕсли;
	КонецЦикла;

	// Набор поставщика (коробка из нескольких наших товаров) - приход этих товаров
	// в одну линию со строкой УПД
	СклеитьСоставныеСтрокиУПД(Линии);

	// Строка прихода без УПД и строка УПД без прихода с тем же именем —
	// один товар: штрихкоды не сошлись, а 1:1 остатки раньше не склеивались.
	Если НЕ ТолькоШтрихкодИКод(Настройки) Тогда
		СклеитьОстаткиУПДСПриходом(Линии);
	КонецЕсли;

	// Ручной второй проход по названию (кнопка реестра товаров) - только если
	// сверка не ограничена штрихкодом
	Если Настройки.Свойство("СклеиватьПоДолеСлов") И Настройки.СклеиватьПоДолеСлов = Истина
		И НЕ ТолькоШтрихкодИКод(Настройки) Тогда
		СклеитьОстаткиПоДолеСлов(Линии, Настройки);
	КонецЕсли;

	СклеитьЛинииОдногоТовара(Линии, ТолькоШтрихкодИКод(Настройки));

	Для Каждого Линия Из Линии Цикл
		ОценитьЛинию(Линия, ЕстьЗаказ, СтрокиПоступления.Количество() > 0,
			УПДСвязана, ЭТрНСвязана, Настройки);
	КонецЦикла;

	Возврат Линии;

КонецФункции

// Ищет среди кандидатов строку, соответствующую эталонам.
//
// Возвращаемое значение:
//   Структура - Строка, Способ; Неопределено, если пары нет
//
Функция НайтиПару(Эталоны, Кандидаты, ПоЦенеИКоличеству, Настройки, ТолькоШтрихкод = Ложь)

	МаксПроход = ?(ТолькоШтрихкод, 1, 5);
	Если ТолькоШтрихкодИКод(Настройки) Тогда
		МаксПроход = Мин(МаксПроход, 3);
	КонецЕсли;

	// Проходы по убыванию надёжности. Для похожих имён - лучшая оценка,
	// не первый подходящий кандидат.
	Для Проход = 1 По МаксПроход Цикл

		Если Проход = 4 Тогда
			ПараСловаря = НайтиПаруПоСловарю(Эталоны, Кандидаты, Настройки);
			Если ПараСловаря <> Неопределено Тогда
				Возврат ПараСловаря;
			КонецЕсли;
		КонецЕсли;

		Если Проход = 5 Тогда
			ПараПоОценке = НайтиЛучшуюПаруПоОценке(Эталоны, Кандидаты, 0.8);
			Если ПараПоОценке <> Неопределено Тогда
				Возврат ПараПоОценке;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Для Каждого Кандидат Из Кандидаты Цикл

			Если Кандидат.Использована Тогда
				Продолжить;
			КонецЕсли;

			Для Каждого Эталон Из Эталоны Цикл

				Способ = СпособСовпадения(Эталон, Кандидат, Проход);
				Если ЗначениеЗаполнено(Способ) Тогда
					Кандидат.Использована = Истина;
					Возврат Новый Структура("Строка, Способ", Кандидат, Способ);
				КонецЕсли;

			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

	Если НЕ ПоЦенеИКоличеству ИЛИ ТолькоШтрихкодИКод(Настройки) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Номенклатуру в поступлении могли выбрать не ту: единственный свободный
	// кандидат с тем же количеством и ценой считаем той же строкой
	Найденный = Неопределено;
	Эталон = Эталоны[0];
	Для Каждого Кандидат Из Кандидаты Цикл
		Если НЕ Кандидат.Использована
			И Макс(Эталон.Количество - Кандидат.Количество, Кандидат.Количество - Эталон.Количество) < 0.001
			И Макс(Эталон.Цена - Кандидат.Цена, Кандидат.Цена - Эталон.Цена) <= Настройки.ДопускЦены Тогда
			Если Найденный <> Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Найденный = Кандидат;
		КонецЕсли;
	КонецЦикла;

	Если Найденный = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Найденный.Использована = Истина;
	Возврат Новый Структура("Строка, Способ", Найденный, "ЦенаКоличество");

КонецФункции

// Пара УПД и прихода: сначала штрихкод (EAN-13, GTIN-14, UPC-A, GS1 01),
// затем словарь уже сходившихся имён, точное имя и оценка похожести.
// Если похожих имён несколько, берётся лучшая оценка, при равенстве -
// ближайшие по количеству и цене. Пара только по сумме и количеству —
// когда штрихкод заполнен не у обеих сторон.
//
Функция НайтиПаруУПД(Эталоны, Кандидаты, Настройки)

	ПараПоШтрихкоду = НайтиПаруУПДПоШтрихкоду(Эталоны, Кандидаты);
	Если ПараПоШтрихкоду <> Неопределено Тогда
		Возврат ПараПоШтрихкоду;
	КонецЕсли;

	Если ТолькоШтрихкодИКод(Настройки) Тогда
		Возврат НайтиПаруАлкоголяПоНазванию(Эталоны, Кандидаты, Настройки);
	КонецЕсли;

	ПараСловаря = НайтиПаруПоСловарю(Эталоны, Кандидаты, Настройки);
	Если ПараСловаря <> Неопределено Тогда
		Возврат ПараСловаря;
	КонецЕсли;

	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Использована Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Эталон Из Эталоны Цикл
			Если СпособСовпадения(Эталон, Кандидат, 4) <> "Наименование" Тогда
				Продолжить;
			КонецЕсли;
			Сравнение = СравнитьКоличествоИЦену(Эталон, Кандидат, Настройки);
			Если Сравнение.Количество И Сравнение.Цена Тогда
				Кандидат.Использована = Истина;
				Возврат Новый Структура("Строка, Способ", Кандидат, "Наименование");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Использована Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Эталон Из Эталоны Цикл
			Если СпособСовпадения(Эталон, Кандидат, 4) = "Наименование" Тогда
				Кандидат.Использована = Истина;
				Возврат Новый Структура("Строка, Способ", Кандидат, "Наименование");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ПараПоОценке = НайтиЛучшуюПаруПоОценке(Эталоны, Кандидаты, 0.8);
	Если ПараПоОценке <> Неопределено Тогда
		Возврат ПараПоОценке;
	КонецЕсли;

	Если Эталоны.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Найденный = Неопределено;
	Эталон = Эталоны[0];
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Использована ИЛИ ОбаШтрихкодаЗаполнены(Эталон, Кандидат) Тогда
			Продолжить;
		КонецЕсли;
		Сравнение = СравнитьКоличествоИЦену(Эталон, Кандидат, Настройки);
		Если Сравнение.Количество И Сравнение.Цена Тогда
			Если Найденный <> Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Найденный = Кандидат;
		КонецЕсли;
	КонецЦикла;

	Если Найденный = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Найденный.Использована = Истина;
	Возврат Новый Структура("Строка, Способ", Найденный, "СуммаКоличество");

КонецФункции

// Исключение из правила «только штрихкод» для алкоголя: в строках УПД на
// алкоголь штрихкода почти нет (марка ЕГАИС GTIN не содержит), и пары не
// строятся вовсе. Работает только при включённой настройке
// ЕГАИС_СверкаПоНазванию (по умолчанию выключена) и очень строго:
//   * строка УПД помечена алкоголем точно («Алкоголь...», не «Возможно»);
//   * штрихкоды не заданы одновременно у обеих строк (иначе это разные товары);
//   * числа в названии те же (объём, крепость) и есть хотя бы одно;
//   * названия похожи на 0,8 и выше;
//   * сходятся и количество, и цена;
//   * подходящая строка УПД ровно одна.
// Такая пара помечена способом «НаименованиеАлкоголь» и в регистр штрихкодов
// поставщиков и в словарь пар по имени не запоминается.
//
Функция НайтиПаруАлкоголяПоНазванию(Эталоны, Кандидаты, Настройки)

	Если ТипЗнч(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ЕГАИС_СверкаПоНазванию")) <> Тип("Булево")
		ИЛИ НЕ ЭАрМ_НастройкиСервер.ЗначениеНастройки("ЕГАИС_СверкаПоНазванию") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Найденный = Неопределено;

	Для Каждого Эталон Из Эталоны Цикл

		ЦифрыЭталона = СтрСоединить(ЦифрыНаименования(Эталон.НаименованиеНорм), ",");
		Если НЕ ЗначениеЗаполнено(ЦифрыЭталона) Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Кандидат Из Кандидаты Цикл

			Если Кандидат.Использована ИЛИ НЕ СтрНачинаетсяС(Кандидат.Алкоголь, "Алкоголь")
				ИЛИ ОбаШтрихкодаЗаполнены(Эталон, Кандидат) Тогда
				Продолжить;
			КонецЕсли;

			Если СтрСоединить(ЦифрыНаименования(Кандидат.НаименованиеНорм), ",") <> ЦифрыЭталона Тогда
				Продолжить;
			КонецЕсли;

			Если ОценкаПохожестиНаименований(Эталон.Наименование, Кандидат.Наименование) < 0.8 Тогда
				Продолжить;
			КонецЕсли;

			Сравнение = СравнитьКоличествоИЦену(Эталон, Кандидат, Настройки);
			Если НЕ (Сравнение.Количество И Сравнение.Цена) Тогда
				Продолжить;
			КонецЕсли;

			// Вторая подходящая строка - пара неоднозначна, оставляем человеку
			Если Найденный <> Неопределено И Найденный <> Кандидат Тогда
				Возврат Неопределено;
			КонецЕсли;
			Найденный = Кандидат;

		КонецЦикла;

	КонецЦикла;

	Если Найденный = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Найденный.Использована = Истина;
	Возврат Новый Структура("Строка, Способ", Найденный, "НаименованиеАлкоголь");

КонецФункции

Функция НайтиПаруУПДПоШтрихкоду(Эталоны, Кандидаты, ТолькоШтрихкод = Ложь)

	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Использована Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Эталон Из Эталоны Цикл
			Если СпособСовпадения(Эталон, Кандидат, 1) = "Штрихкод"
				И ПараПравдоподобна(Эталон, Кандидат) Тогда
				Кандидат.Использована = Истина;
				Возврат Новый Структура("Строка, Способ", Кандидат, "Штрихкод");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если ТолькоШтрихкод Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат НайтиПаруУПДПоНоменклатуре(Эталоны, Кандидаты);

КонецФункции

// Та же номенклатура Далиона по регистру штрихкодов поставщиков - так же
// надёжно, как штрихкод: регистр связал товар поставщика с карточкой.
//
Функция НайтиПаруУПДПоНоменклатуре(Эталоны, Кандидаты)

	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Использована Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Эталон Из Эталоны Цикл
			Если СпособСовпадения(Эталон, Кандидат, 2) = "Номенклатура"
				И ПараПравдоподобна(Эталон, Кандидат) Тогда
				Кандидат.Использована = Истина;
				Возврат Новый Структура("Строка, Способ", Кандидат, "Номенклатура");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Защита от пар «крест-накрест». Строке УПД без собственного GTIN штрихкод
// и номенклатуру Далиона подставляет регистр штрихкодов поставщиков - по
// коду товара или названию, в том числе из ошибочной записи. Тогда товар
// «конфеты в глазури 2 кг, 250 по 52,41» сходился по штрихкоду со строкой
// прихода «сухарики, 5 по 37,10». Такую пару не берём: названия совсем не
// похожи и не сошлись ни количество, ни цена, ни сумма строки. Пара по
// собственному GTIN строки УПД надёжна всегда.
//
// Параметры:
//   Эталон   - Структура - строка заказа или прихода (см. НоваяСтрока)
//   Кандидат - Структура - строка УПД
//
// Возвращаемое значение:
//   Булево - Ложь, если пара явно неверная
//
Функция ПараПравдоподобна(Эталон, Кандидат)

	Если ЗначениеЗаполнено(Кандидат.ШтрихкодGTIN) Тогда
		Для Каждого КлючЗначение Из Эталон.Штрихкоды Цикл
			Если ШтрихкодыСовпадают(КлючЗначение.Ключ, Кандидат.ШтрихкодGTIN) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат ПараСтрокПравдоподобна(Эталон, Кандидат);

КонецФункции

// То же для любых строк с полями Наименование, Количество, Цена, Сумма -
// в том числе для строк дерева реестра УПД.
//
// Возвращаемое значение:
//   Булево - Ложь: названия не похожи (оценка < 0,2) и не сошлись ни
//            количество, ни цена, ни сумма строки (допуск 1%)
//
Функция ПараСтрокПравдоподобна(СтрокаА, СтрокаБ) Экспорт

	Если ОценкаПохожестиНаименований(СтрокаА.Наименование, СтрокаБ.Наименование) >= 0.2 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЧислаБлизки(СтрокаА.Количество, СтрокаБ.Количество)
		ИЛИ ЧислаБлизки(СтрокаА.Цена, СтрокаБ.Цена)
		ИЛИ ЧислаБлизки(СтрокаА.Сумма, СтрокаБ.Сумма);

КонецФункции

// Два числа отличаются не больше чем на 1% (для нулей - равны).
//
Функция ЧислаБлизки(Знач ЧислоА, Знач ЧислоБ)

	ЧислоА = ?(ТипЗнч(ЧислоА) = Тип("Число"), ЧислоА, 0);
	ЧислоБ = ?(ТипЗнч(ЧислоБ) = Тип("Число"), ЧислоБ, 0);

	Разница = Макс(ЧислоА - ЧислоБ, ЧислоБ - ЧислоА);
	Возврат Разница <= Макс(0.01, Макс(ЧислоА, ЧислоБ) * 0.01);

КонецФункции

// Строки, по которым линия ищет пару в УПД и ЭТрН: заказ и поступление.
//
Функция КлючиЛинииДляПодбора(Линия)

	Ключи = Новый Массив;
	Если Линия.Заказ <> Неопределено Тогда
		Ключи.Добавить(Линия.Заказ);
	КонецЕсли;
	Если Линия.Поступление <> Неопределено Тогда
		Ключи.Добавить(Линия.Поступление);
	КонецЕсли;

	Возврат Ключи;

КонецФункции

Процедура УстановитьПаруУПДЛинии(Линия, Пара)

	Если Пара = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Линия.УПД = Пара.Строка;
	Линия.СпособУПД = Пара.Способ;
	Если НЕ ЗначениеЗаполнено(Линия.Способ) Тогда
		Линия.Способ = Пара.Способ;
	КонецЕсли;

КонецПроцедуры

Функция ОбаШтрихкодаЗаполнены(СтрокаА, СтрокаБ)

	Возврат СтрокаА.Штрихкоды.Количество() > 0 И СтрокаБ.Штрихкоды.Количество() > 0;

КонецФункции

// Из свободных кандидатов берётся тот, у кого оценка имени выше порога.
// При равной оценке - ближе по количеству и цене.
//
Функция НайтиЛучшуюПаруПоОценке(Эталоны, Кандидаты, Порог)

	Если Эталоны.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЛучшийКандидат = Неопределено;
	ЛучшаяОценка   = 0;
	ЛучшаяРазница  = Неопределено;
	ЭталонСравнения = Эталоны[Эталоны.ВГраница()];

	Для Каждого Кандидат Из Кандидаты Цикл

		Если Кандидат.Использована Тогда
			Продолжить;
		КонецЕсли;

		Оценка = 0;
		Для Каждого Эталон Из Эталоны Цикл
			Текущая = ОценкаПохожестиНаименований(Эталон.Наименование, Кандидат.Наименование);
			Если Текущая > Оценка Тогда
				Оценка = Текущая;
			КонецЕсли;
		КонецЦикла;

		Если Оценка < Порог Тогда
			Продолжить;
		КонецЕсли;

		Разница = РазницаСтрокДляВыбора(ЭталонСравнения, Кандидат);
		Если ЛучшийКандидат = Неопределено
			ИЛИ Оценка > ЛучшаяОценка
			ИЛИ Оценка = ЛучшаяОценка И Разница < ЛучшаяРазница Тогда
			ЛучшийКандидат = Кандидат;
			ЛучшаяОценка   = Оценка;
			ЛучшаяРазница  = Разница;
		КонецЕсли;

	КонецЦикла;

	Если ЛучшийКандидат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЛучшийКандидат.Использована = Истина;
	Возврат Новый Структура("Строка, Способ", ЛучшийКандидат, "НаименованиеПохоже");

КонецФункции

Функция НайтиПаруПоСловарю(Эталоны, Кандидаты, Настройки)

	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Использована Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Эталон Из Эталоны Цикл
			Если СпособИзСловаряПар(Эталон.Наименование, Кандидат.Наименование, Настройки) = "Словарь" Тогда
				Кандидат.Использована = Истина;
				Возврат Новый Структура("Строка, Способ", Кандидат, "Словарь");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура ПодготовитьКешПарПоИмени(Настройки)

	Кеш = Неопределено;
	Если Настройки.Свойство("КешПарПоИмени", Кеш) И Кеш <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Настройки.Вставить("КешПарПоИмени", ЗагрузитьКешПарПоИмени());

КонецПроцедуры

Функция ЗагрузитьКешПарПоИмени()

	Кеш = Новый Структура("ПоХешу, ПоНорме", Новый Соответствие, Новый Соответствие);

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Пары.ХешИмен КАК ХешИмен,
		|	Пары.НаименованиеДалион КАК НаименованиеДалион,
		|	Пары.НаименованиеЭДО КАК НаименованиеЭДО
		|ИЗ
		|	РегистрСведений.ЭАрМ_ПарыНоменклатурыПоИмени КАК Пары";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Кеш.ПоХешу.Вставить(Выборка.ХешИмен, Истина);
			НормДалион = НормализованноеНаименование(Выборка.НаименованиеДалион);
			НормЭДО    = НормализованноеНаименование(Выборка.НаименованиеЭДО);
			Если ЗначениеЗаполнено(НормДалион) И ЗначениеЗаполнено(НормЭДО) Тогда
				Кеш.ПоНорме.Вставить(НормДалион + "|" + НормЭДО, Истина);
				Кеш.ПоНорме.Вставить(НормЭДО + "|" + НормДалион, Истина);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ЗагрузитьКешПарПоИмени (кеш пар по имени не прочитан)", ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Кеш;

КонецФункции

Функция СпособИзСловаряПар(НаименованиеА, НаименованиеБ, Настройки)

	Кеш = Неопределено;
	Если НЕ Настройки.Свойство("КешПарПоИмени", Кеш) ИЛИ Кеш = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Хеш = ХешИменПары(НаименованиеА, НаименованиеБ);
	Если ЗначениеЗаполнено(Хеш) И Кеш.ПоХешу.Получить(Хеш) <> Неопределено Тогда
		Возврат "Словарь";
	КонецЕсли;

	НормА = НормализованноеНаименование(НаименованиеА);
	НормБ = НормализованноеНаименование(НаименованиеБ);
	Если ЗначениеЗаполнено(НормА) И ЗначениеЗаполнено(НормБ)
		И Кеш.ПоНорме.Получить(НормА + "|" + НормБ) <> Неопределено Тогда
		Возврат "Словарь";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ХешИменПары(НаименованиеА, НаименованиеБ)

	ИмяА = СокрЛП(НаименованиеА);
	ИмяБ = СокрЛП(НаименованиеБ);
	Если НЕ ЗначениеЗаполнено(ИмяА) ИЛИ НЕ ЗначениеЗаполнено(ИмяБ) Тогда
		Возврат "";
	КонецЕсли;

	Имена = Новый Массив;
	Имена.Добавить(ВРег(ИмяА));
	Имена.Добавить(ВРег(ИмяБ));
	Имена = ОтсортированныеСтроки(Имена);

	Возврат КлючИзСтроки(СтрСоединить(Имена, Символы.ПС));

КонецФункции

// Остаток «нет в УПД» и остаток «нет в приходе» с тем же именем — одна позиция.
// После 1:1 сопоставления они жили разными линиями, и в реестре сверки товар
// был и зелёный, и красный одновременно.
//
Процедура СклеитьОстаткиУПДСПриходом(Линии)

	УдаляемыеИндексы = Новый Массив;

	Для ИндексОстатка = 0 По Линии.ВГраница() Цикл

		Остаток = Линии[ИндексОстатка];
		Если Остаток.УПД = Неопределено ИЛИ Остаток.Поступление <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЛучшаяЛиния   = Неопределено;
		ЛучшаяРазница = Неопределено;

		Для Каждого Линия Из Линии Цикл

			Если Линия.УПД <> Неопределено ИЛИ Линия.Поступление = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Совпало = НаименованияСовпадают(Линия.Поступление.Наименование, Остаток.УПД.Наименование);
			Если НЕ Совпало И Линия.Заказ <> Неопределено Тогда
				Совпало = НаименованияСовпадают(Линия.Заказ.Наименование, Остаток.УПД.Наименование);
			КонецЕсли;
			Если НЕ Совпало Тогда
				Продолжить;
			КонецЕсли;

			Разница = РазницаСтрокДляВыбора(Линия.Поступление, Остаток.УПД);
			Если ЛучшаяЛиния = Неопределено ИЛИ Разница < ЛучшаяРазница Тогда
				ЛучшаяЛиния   = Линия;
				ЛучшаяРазница = Разница;
			КонецЕсли;

		КонецЦикла;

		Если ЛучшаяЛиния = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЛучшаяЛиния.УПД = Остаток.УПД;
		Способ = "НаименованиеПохоже";
		Если ЗначениеЗаполнено(ЛучшаяЛиния.Поступление.НаименованиеНорм)
			И ЛучшаяЛиния.Поступление.НаименованиеНорм = Остаток.УПД.НаименованиеНорм Тогда
			Способ = "Наименование";
		КонецЕсли;
		ЛучшаяЛиния.СпособУПД = Способ;
		Если НЕ ЗначениеЗаполнено(ЛучшаяЛиния.Способ) Тогда
			ЛучшаяЛиния.Способ = Способ;
		КонецЕсли;
		УдаляемыеИндексы.Добавить(ИндексОстатка);

	КонецЦикла;

	// Индексы собраны по возрастанию, удаляем с конца: иначе следующий сдвинется
	Индекс = УдаляемыеИндексы.ВГраница();
	Пока Индекс >= 0 Цикл
		Линии.Удалить(УдаляемыеИндексы[Индекс]);
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

// Остатки, не сошедшиеся ни штрихкодом, ни ядром слов: пара по оценке
// похожести имени (опечатки, склейка, штраф за отличающее слово), порог -
// Настройки.ПорогСовпадения ("Порог совпадения товаров, %").
//
// Вес, объём и процент здесь - запрет: разные у обеих сторон значит разные
// товары, как бы ни совпадали слова. Раньше они не проверялись вовсе, потому
// что разбирались неверно («0,95 л» против «950 мл»).
//
Процедура СклеитьОстаткиПоДолеСлов(Линии, Настройки)

	УдаляемыеИндексы = Новый Массив;

	Для ИндексОстатка = 0 По Линии.ВГраница() Цикл

		Остаток = Линии[ИндексОстатка];
		Если Остаток.УПД = Неопределено ИЛИ Остаток.Поступление <> Неопределено
			ИЛИ Остаток.Заказ <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЛучшаяЛиния   = Неопределено;
		ЛучшаяДоля    = 0;
		ЛучшаяРазница = 0;

		Для Каждого Линия Из Линии Цикл

			Если Линия.УПД <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			СтрокаДалиона = ?(Линия.Поступление <> Неопределено, Линия.Поступление, Линия.Заказ);
			Если СтрокаДалиона = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Если НЕ ПризнакиНаименованийСовместимы(СтрокаДалиона.Наименование, Остаток.УПД.Наименование) Тогда
				Продолжить;
			КонецЕсли;

			Доля = ДоляОбщихСлов(СтрокаДалиона.Наименование, Остаток.УПД.Наименование);
			Если Доля < Настройки.ПорогСовпадения Тогда
				Продолжить;
			КонецЕсли;

			Разница = РазницаСтрокДляВыбора(СтрокаДалиона, Остаток.УПД);
			Если ЛучшаяЛиния = Неопределено ИЛИ Доля > ЛучшаяДоля
				ИЛИ Доля = ЛучшаяДоля И Разница < ЛучшаяРазница Тогда
				ЛучшаяЛиния   = Линия;
				ЛучшаяДоля    = Доля;
				ЛучшаяРазница = Разница;
			КонецЕсли;

		КонецЦикла;

		Если ЛучшаяЛиния = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЛучшаяЛиния.УПД       = Остаток.УПД;
		ЛучшаяЛиния.СпособУПД = "НазваниеБлизко";
		Если НЕ ЗначениеЗаполнено(ЛучшаяЛиния.Способ) Тогда
			ЛучшаяЛиния.Способ = "НазваниеБлизко";
		КонецЕсли;
		УдаляемыеИндексы.Добавить(ИндексОстатка);

	КонецЦикла;

	// Индексы собраны по возрастанию, удаляем с конца: иначе следующий сдвинется
	Индекс = УдаляемыеИндексы.ВГраница();
	Пока Индекс >= 0 Цикл
		Линии.Удалить(УдаляемыеИндексы[Индекс]);
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

// Один товар на нескольких строках УПД или прихода - одна линия: иначе
// реестр красный по 1:1, а зелёная УПД смотрит свёртку.
//
Процедура СклеитьЛинииОдногоТовара(Линии, БезНаименований = Ложь)

	Индекс = 0;
	Пока Индекс < Линии.Количество() Цикл

		Пока Истина Цикл

			Склеили = Ложь;
			ДругойИндекс = Линии.Количество() - 1;
			Пока ДругойИндекс > Индекс Цикл
				Если ЛинииОдногоТовара(Линии[Индекс], Линии[ДругойИндекс], БезНаименований) Тогда
					ВлитьЛинию(Линии[Индекс], Линии[ДругойИндекс]);
					Линии.Удалить(ДругойИндекс);
					Склеили = Истина;
				КонецЕсли;
				ДругойИндекс = ДругойИндекс - 1;
			КонецЦикла;

			Если НЕ Склеили Тогда
				Прервать;
			КонецЕсли;

		КонецЦикла;

		Индекс = Индекс + 1;

	КонецЦикла;

	Номер = 1;
	Для Каждого Линия Из Линии Цикл
		Линия.НомерСтроки = Номер;
		Номер = Номер + 1;
	КонецЦикла;

КонецПроцедуры

// БезНаименований - Булево - сверка только по штрихкоду: линии без общего
//   штрихкода и номенклатуры по совпадению имён не склеиваются.
//
Функция ЛинииОдногоТовара(ЛинияА, ЛинияБ, БезНаименований = Ложь)

	Если ЭтоРазныеКарточкиДалиона(ЛинияА.Поступление, ЛинияБ.Поступление)
		ИЛИ ЭтоРазныеКарточкиДалиона(ЛинияА.Заказ, ЛинияБ.Заказ) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрокиДалионаОднойКарточки(ЛинияА.Поступление, ЛинияБ.Поступление)
		ИЛИ СтрокиДалионаОднойКарточки(ЛинияА.Заказ, ЛинияБ.Заказ) Тогда
		Возврат Истина;
	КонецЕсли;

	// Склейка сводит в пару строку УПД одной линии и строку прихода другой -
	// та же защита от пар крест-накрест, что у прохода по штрихкоду
	Если ЛинииСводятНеправдоподобнуюПару(ЛинияА, ЛинияБ)
		ИЛИ ЛинииСводятНеправдоподобнуюПару(ЛинияБ, ЛинияА) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Строка УПД одной линии и строка прихода другой - одна номенклатура
	// Далиона (у УПД - по регистру штрихкодов поставщиков): один товар
	УидыА = УидыНоменклатурыЛинии(ЛинияА);
	Для Каждого Уид Из УидыНоменклатурыЛинии(ЛинияБ) Цикл
		Если УидыА.Найти(Уид) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	КаноныА = КаноныШтрихкодовЛинии(ЛинияА);
	КаноныБ = КаноныШтрихкодовЛинии(ЛинияБ);

	Если КаноныА.Количество() > 0 И КаноныБ.Количество() > 0 Тогда
		Для Каждого Канон Из КаноныА Цикл
			Если КаноныБ.Получить(Канон.Ключ) <> Неопределено Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;

	Если БезНаименований Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НаименованияЛинийСовпадают(ЛинияА, ЛинияБ);

КонецФункции

// Линия только с УПД и линия только с приходом: склейка сделает из них пару.
// Истина - пара явно неверная (см. ПараПравдоподобна).
//
Функция ЛинииСводятНеправдоподобнуюПару(ЛинияУПД, ЛинияПрихода)

	Если ЛинияУПД.УПД = Неопределено ИЛИ ЛинияУПД.Поступление <> Неопределено
		ИЛИ ЛинияПрихода.Поступление = Неопределено ИЛИ ЛинияПрихода.УПД <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НЕ ПараПравдоподобна(ЛинияПрихода.Поступление, ЛинияУПД.УПД);

КонецФункции

Функция УидыНоменклатурыЛинии(Линия)

	Результат = Новый Массив;
	Для Каждого Строка Из ЗначениеВМассиве(Линия.УПД, Линия.Поступление, Линия.Заказ, Линия.ЭТрН) Цикл
		Если Строка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уид = СокрЛП(Строка.ИдентификаторНоменклатуры);
		Если ЗначениеЗаполнено(Уид) И Результат.Найти(Уид) = Неопределено Тогда
			Результат.Добавить(Уид);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Номера строк документа через ";" - для реестра товаров (ПозицииУПД,
// СтрокиПН). Пустая строка - строки документа в линии нет.
//
Функция ПозицииСтрокиСтрокой(Строка) Экспорт

	Если Строка = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Позиция Из Строка.Позиции Цикл
		Части.Добавить(Формат(Позиция, "ЧГ=0"));
	КонецЦикла;

	Возврат СтрСоединить(Части, ";");

КонецФункции

// Штука и короб в Далионе часто несут один EAN. Это разные строки прихода,
// их количества нельзя складывать.
//
Функция ЭтоРазныеКарточкиДалиона(СтрокаА, СтрокаБ)

	Если СтрокаА = Неопределено ИЛИ СтрокаБ = Неопределено ИЛИ СтрокаА = СтрокаБ Тогда
		Возврат Ложь;
	КонецЕсли;

	УидА = СокрЛП(СтрокаА.ИдентификаторНоменклатуры);
	УидБ = СокрЛП(СтрокаБ.ИдентификаторНоменклатуры);
	Если НЕ ЗначениеЗаполнено(УидА) ИЛИ НЕ ЗначениеЗаполнено(УидБ) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат УидА <> УидБ;

КонецФункции

Функция СтрокиДалионаОднойКарточки(СтрокаА, СтрокаБ)

	Если СтрокаА = Неопределено ИЛИ СтрокаБ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрокаА = СтрокаБ Тогда
		Возврат Истина;
	КонецЕсли;

	УидА = СокрЛП(СтрокаА.ИдентификаторНоменклатуры);
	УидБ = СокрЛП(СтрокаБ.ИдентификаторНоменклатуры);
	Возврат ЗначениеЗаполнено(УидА) И УидА = УидБ;

КонецФункции

Функция КаноныШтрихкодовЛинии(Линия)

	Результат = Новый Соответствие;
	Для Каждого Строка Из ЗначениеВМассиве(Линия.УПД, Линия.Поступление, Линия.Заказ, Линия.ЭТрН) Цикл
		Если Строка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Элемент Из Строка.Штрихкоды Цикл
			Канон = КаноническийШтрихкод(?(ТипЗнч(Элемент) = Тип("КлючИЗначение"), Элемент.Ключ, Элемент));
			Если ЗначениеЗаполнено(Канон) Тогда
				Результат.Вставить(Канон, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НаименованияЛинийСовпадают(ЛинияА, ЛинияБ)

	Для Каждого СтрокаА Из ЗначениеВМассиве(ЛинияА.УПД, ЛинияА.Поступление, ЛинияА.Заказ) Цикл
		НормА = "";
		Если СтрокаА <> Неопределено Тогда
			НормА = СтрокаА.НаименованиеНорм;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НормА) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаБ Из ЗначениеВМассиве(ЛинияБ.УПД, ЛинияБ.Поступление, ЛинияБ.Заказ) Цикл
			НормБ = "";
			Если СтрокаБ <> Неопределено Тогда
				НормБ = СтрокаБ.НаименованиеНорм;
			КонецЕсли;
			Если НормА = НормБ Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ВлитьЛинию(Приёмник, Источник)

	Приёмник.Заказ       = СложитьСтрокиДокумента(Приёмник.Заказ, Источник.Заказ);
	Приёмник.Поступление = СложитьСтрокиДокумента(Приёмник.Поступление, Источник.Поступление);
	Приёмник.УПД         = СложитьСтрокиДокумента(Приёмник.УПД, Источник.УПД);
	Приёмник.ЭТрН        = СложитьСтрокиДокумента(Приёмник.ЭТрН, Источник.ЭТрН);

	Если НЕ ЗначениеЗаполнено(Приёмник.Способ) Тогда
		Приёмник.Способ = Источник.Способ;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Приёмник.СпособУПД) Тогда
		Приёмник.СпособУПД = Источник.СпособУПД;
	КонецЕсли;

КонецПроцедуры

Функция СложитьСтрокиДокумента(Приёмник, Источник)

	Если Источник = Неопределено Тогда
		Возврат Приёмник;
	КонецЕсли;
	Если Приёмник = Неопределено Тогда
		Возврат Источник;
	КонецЕсли;
	Если Приёмник = Источник Тогда
		Возврат Приёмник;
	КонецЕсли;

	Сумма = СуммаСтрокиСверки(Приёмник) + СуммаСтрокиСверки(Источник);
	Количество = Приёмник.Количество + Источник.Количество;
	ЦенаВзвешенная = 0;
	Если Количество <> 0 Тогда
		ЦенаВзвешенная = (Приёмник.Цена * Приёмник.Количество + Источник.Цена * Источник.Количество)
			/ Количество;
	КонецЕсли;
	Приёмник.Количество = Количество;
	Приёмник.КоличествоДокумента = Приёмник.КоличествоДокумента + Источник.КоличествоДокумента;
	Приёмник.Сумма = Сумма;
	Приёмник.СуммаНДС = ЧислоПоляСтроки(Приёмник, "СуммаНДС", 0)
		+ ЧислоПоляСтроки(Источник, "СуммаНДС", 0);
	Если НЕ ЗначениеЗаполнено(Приёмник.СтавкаНДС) Тогда
		Приёмник.СтавкаНДС = СтрокаПоляСтроки(Источник, "СтавкаНДС");
	КонецЕсли;
	Если ЦенаВзвешенная <> 0 Тогда
		Приёмник.Цена = ЦенаВзвешенная;
	ИначеЕсли Количество <> 0 Тогда
		Приёмник.Цена = Сумма / Количество;
	КонецЕсли;

	Для Каждого Элемент Из Источник.Штрихкоды Цикл
		Ключ = ?(ТипЗнч(Элемент) = Тип("КлючИЗначение"), Элемент.Ключ, Элемент);
		Приёмник.Штрихкоды.Вставить(Ключ, Истина);
	КонецЦикла;

	Для Каждого Код Из Источник.Маркировки Цикл
		Если Приёмник.Маркировки.Найти(Код) = Неопределено Тогда
			Приёмник.Маркировки.Добавить(Код);
		КонецЕсли;
	КонецЦикла;
	Если Источник.Маркирован Тогда
		Приёмник.Маркирован = Истина;
	КонецЕсли;

	Для Каждого Позиция Из Источник.Позиции Цикл
		Если Приёмник.Позиции.Найти(Позиция) = Неопределено Тогда
			Приёмник.Позиции.Добавить(Позиция);
		КонецЕсли;
	КонецЦикла;

	Возврат Приёмник;

КонецФункции

// Вес, объём и процент двух названий не противоречат друг другу.
//
Функция ПризнакиНаименованийСовместимы(НаименованиеА, НаименованиеБ)

	РазборА = РазборНаименованияДляСлов(НаименованиеА);
	РазборБ = РазборНаименованияДляСлов(НаименованиеБ);

	Возврат ВесаНаименованийСовместимы(РазборА.Веса, РазборБ.Веса)
		И ВесаНаименованийСовместимы(РазборА.Проценты, РазборБ.Проценты);

КонецФункции

// Доля общих значимых слов в меньшем из названий: 1 - все слова меньшего
// названия нашлись в большем.
//
Функция ДоляОбщихСлов(НаименованиеА, НаименованиеБ)

	Возврат ОценкаПохожестиНаименований(НаименованиеА, НаименованиеБ);

КонецФункции

Функция РазницаСтрокДляВыбора(СтрокаА, СтрокаБ)

	РазницаКоличества = Макс(СтрокаА.Количество - СтрокаБ.Количество,
		СтрокаБ.Количество - СтрокаА.Количество);
	РазницаЦены = Макс(СтрокаА.Цена - СтрокаБ.Цена, СтрокаБ.Цена - СтрокаА.Цена);

	Возврат РазницаКоличества * 1000000 + РазницаЦены;

КонецФункции

Функция СпособСовпадения(Эталон, Кандидат, Проход)

	Если Проход = 1 Тогда
		Для Каждого КлючЗначение Из Эталон.Штрихкоды Цикл
			Для Каждого КлючКандидата Из Кандидат.Штрихкоды Цикл
				Если ШтрихкодыСовпадают(КлючЗначение.Ключ, КлючКандидата.Ключ) Тогда
					Возврат "Штрихкод";
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

	ИначеЕсли Проход = 2 Тогда
		// Списки uid, а не равенство одиночных: у строки УПД uid приходит из
		// регистра штрихкодов поставщика и часто неоднозначен
		Если ИдентификаторыНоменклатурыСовпадают(Эталон, Кандидат) Тогда
			Возврат "Номенклатура";
		КонецЕсли;

	ИначеЕсли Проход = 3 Тогда
		Если ЗначениеЗаполнено(Эталон.Код) И ВРег(Эталон.Код) = ВРег(Кандидат.Код) Тогда
			Возврат "Код";
		КонецЕсли;
		Если ЗначениеЗаполнено(Эталон.Артикул) И ВРег(Эталон.Артикул) = ВРег(Кандидат.Артикул) Тогда
			Возврат "Артикул";
		КонецЕсли;

	ИначеЕсли Проход = 4 Тогда
		Если ЗначениеЗаполнено(Эталон.НаименованиеНорм)
			И Эталон.НаименованиеНорм = Кандидат.НаименованиеНорм Тогда
			Возврат "Наименование";
		КонецЕсли;

	ИначеЕсли Проход = 5 Тогда
		Если НаименованияСовпадают(Эталон.Наименование, Кандидат.Наименование)
			И (НЕ ЗначениеЗаполнено(Эталон.НаименованиеНорм)
				ИЛИ Эталон.НаименованиеНорм <> Кандидат.НаименованиеНорм) Тогда
			Возврат "НаименованиеПохоже";
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

// Номенклатура Далиона одной строки - одиночный uid и/или список
// ИдентификаторыНоменклатуры. Совпадение - непустое пересечение списков.
//
Функция ИдентификаторыНоменклатурыСовпадают(СтрокаА, СтрокаБ)

	ИдентификаторыА = ИдентификаторыНоменклатурыСтроки(СтрокаА);
	Если ИдентификаторыА.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Уид Из ИдентификаторыНоменклатурыСтроки(СтрокаБ) Цикл
		Если ИдентификаторыА.Найти(Уид) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ИдентификаторыНоменклатурыСтроки(Строка)

	Результат = Новый Массив;
	ДобавитьУникальнуюСтроку(Результат, Строка.ИдентификаторНоменклатуры);

	Если Строка.Свойство("ИдентификаторыНоменклатуры") Тогда
		Для Каждого Уид Из Строка.ИдентификаторыНоменклатуры Цикл
			ДобавитьУникальнуюСтроку(Результат, Уид);
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Один и тот же штрихкод в разных написаниях: EAN-13, GTIN-14 с нулём,
// UPC-A (12 цифр) и GS1 «01» + GTIN.
//
Функция ШтрихкодыСовпадают(ШтрихкодА, ШтрихкодБ) Экспорт

	ТекстА = СокрЛП(ШтрихкодА);
	ТекстБ = СокрЛП(ШтрихкодБ);
	Если НЕ ЗначениеЗаполнено(ТекстА) ИЛИ НЕ ЗначениеЗаполнено(ТекстБ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТекстА = ТекстБ ИЛИ ВРег(ТекстА) = ВРег(ТекстБ) Тогда
		Возврат Истина;
	КонецЕсли;

	КлючиА = КлючиШтрихкода(ТекстА);
	Для Каждого КлючБ Из КлючиШтрихкода(ТекстБ) Цикл
		Если КлючиА.Получить(КлючБ.Ключ) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция КлючиШтрихкода(Штрихкод) Экспорт

	Результат = Новый Соответствие;
	Текст = СокрЛП(Штрихкод);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Вставить(Текст, Истина);
	Результат.Вставить(ВРег(Текст), Истина);

	Цифры = ЦифрыШтрихкода(Текст);
	Если НЕ ЗначениеЗаполнено(Цифры) Тогда
		Возврат Результат;
	КонецЕсли;

	ДобавитьВариантыGTIN(Результат, Цифры);
	Если СтрДлина(Цифры) >= 16 И Лев(Цифры, 2) = "01" Тогда
		ДобавитьВариантыGTIN(Результат, Сред(Цифры, 3, 14));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ДобавитьВариантыGTIN(Результат, Цифры)

	Если НЕ ЗначениеЗаполнено(Цифры) Тогда
		Возврат;
	КонецЕсли;

	Результат.Вставить(Цифры, Истина);
	Длина = СтрДлина(Цифры);

	Если Длина = 12 Тогда
		Результат.Вставить("0" + Цифры, Истина);
		Результат.Вставить("00" + Цифры, Истина);
	ИначеЕсли Длина = 13 Тогда
		Результат.Вставить("0" + Цифры, Истина);
		Если Лев(Цифры, 1) = "0" Тогда
			Результат.Вставить(Сред(Цифры, 2), Истина);
		КонецЕсли;
	ИначеЕсли Длина = 14 И Лев(Цифры, 1) = "0" Тогда
		EAN = Сред(Цифры, 2);
		Результат.Вставить(EAN, Истина);
		Если Лев(EAN, 1) = "0" Тогда
			Результат.Вставить(Сред(EAN, 2), Истина);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ЦифрыШтрихкода(Штрихкод)

	Цифры = "";
	Текст = СокрЛП(Штрихкод);
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Цифры;

КонецФункции

Функция ПредпочтительныйШтрихкод(Штрихкоды) Экспорт

	Лучший = "";
	ЛучшийВес = -1;

	Для Каждого Элемент Из Штрихкоды Цикл

		Если ТипЗнч(Элемент) = Тип("КлючИЗначение") Тогда
			Текст = СокрЛП(Элемент.Ключ);
		Иначе
			Текст = СокрЛП(Элемент);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Текст) Тогда
			Продолжить;
		КонецЕсли;

		Вес = ВесКанонаШтрихкода(КаноническийШтрихкод(Текст));
		Если Вес > ЛучшийВес Тогда
			ЛучшийВес = Вес;
			Лучший = Текст;
		КонецЕсли;

	КонецЦикла;

	Возврат Лучший;

КонецФункции

// Выставляет результат линии. Одна линия - один итог: берём самое важное
// расхождение, остальные - в комментарий.
//
// Критичны только расхождения УПД с приходом (количество, цена, строка есть
// лишь в одном из двух документов) - они идут первыми и ставят Критично.
// Недовоз по заказу, строки не из заказа, ошибка номенклатуры в приходе и
// ЭТрН - замечания.
//
Процедура ОценитьЛинию(Линия, ЕстьЗаказ, ЕстьПоступление, УПДСвязана, ЭТрНСвязана, Настройки)

	Расхождения = Новый Массив;
	Замечания   = Новый Массив;
	Кратность   = 1;
	ПоСумме     = Ложь;
	КакРешено   = "";

	Если Линия.Поступление <> Неопределено И Линия.УПД <> Неопределено Тогда
		Сравнение = СравнитьКоличествоИЦену(Линия.Поступление, Линия.УПД, Настройки, "приход", "УПД");
		Если НЕ Сравнение.Количество Тогда
			Расхождения.Добавить("Количество");
		КонецЕсли;
		Если НЕ Сравнение.Цена Тогда
			Расхождения.Добавить("Цена");
		КонецЕсли;
		Кратность = Сравнение.Кратность;
		ПоСумме   = Сравнение.ПоСумме;
		КакРешено = Сравнение.Пояснение;
	ИначеЕсли Линия.Поступление <> Неопределено И УПДСвязана Тогда
		Расхождения.Добавить("НетВУПД");
	ИначеЕсли Линия.УПД <> Неопределено И ЕстьПоступление Тогда
		Расхождения.Добавить("НетВПоступлении");
	КонецЕсли;

	Если ЕстьЗаказ И Линия.Заказ <> Неопределено И Линия.Поступление <> Неопределено
		И ЗначениеЗаполнено(Линия.Заказ.ИдентификаторНоменклатуры)
		И Линия.Заказ.ИдентификаторНоменклатуры <> Линия.Поступление.ИдентификаторНоменклатуры Тогда
		Замечания.Добавить("НоменклатураПНОшибочна");
	КонецЕсли;

	// Строка только заказа или только ЭТрН: недовоз или лишнее в ЭТрН
	Если Линия.Поступление = Неопределено И Линия.УПД = Неопределено Тогда
		Если ЕстьПоступление Тогда
			Замечания.Добавить("НетВПоступлении");
		КонецЕсли;
		Если УПДСвязана Тогда
			Замечания.Добавить("НетВУПД");
		КонецЕсли;
	КонецЕсли;

	Если ЭТрНСвязана И Линия.ЭТрН = Неопределено Тогда
		Замечания.Добавить("НетВЭТрН");
	КонецЕсли;

	Если ЕстьЗаказ И Линия.Заказ = Неопределено Тогда
		Замечания.Добавить("НетВЗаказе");
	КонецЕсли;

	Если Линия.Поступление <> Неопределено И Линия.ЭТрН <> Неопределено
		И Макс(Линия.Поступление.Количество - Линия.ЭТрН.Количество,
			Линия.ЭТрН.Количество - Линия.Поступление.Количество) >= 0.001 Тогда
		Замечания.Добавить("КоличествоЭТрН");
	КонецЕсли;

	Линия.Критично = Расхождения.Количество() > 0;

	// Как решено - в трассу и протокол сверки: пара, сравнение и правило результата
	Если Линия.Поступление <> Неопределено И Линия.УПД <> Неопределено Тогда
		Линия.Пояснение = СтрШаблон("пара %1; %2", ОписаниеСпособаПары(?(ЗначениеЗаполнено(Линия.СпособУПД),
			Линия.СпособУПД, Линия.Способ)), КакРешено);
	ИначеЕсли Линия.Поступление <> Неопределено И УПДСвязана Тогда
		Линия.Пояснение = "строка прихода: в УПД пары не нашлось ни по одному способу - «нет в УПД»";
	ИначеЕсли Линия.УПД <> Неопределено И ЕстьПоступление Тогда
		Линия.Пояснение = "строка УПД: в приходе пары не нашлось ни по одному способу - «нет в поступлении»";
	Иначе
		Линия.Пояснение = "строка только заказа или ЭТрН - сравнивать УПД с приходом нечего";
	КонецЕсли;
	Если Расхождения.Количество() > 0 Тогда
		Линия.Пояснение = Линия.Пояснение + "; расхождения: " + СтрСоединить(Расхождения, ", ");
	КонецЕсли;
	Если Замечания.Количество() > 0 Тогда
		Линия.Пояснение = Линия.Пояснение + "; замечания (не критично): " + СтрСоединить(Замечания, ", ");
	КонецЕсли;

	Если Линия.Критично Тогда
		Линия.Результат = Расхождения[0];
	ИначеЕсли Линия.Поступление <> Неопределено И Линия.УПД <> Неопределено Тогда
		Линия.Результат = "Совпадает";
	Иначе
		Линия.Результат = ?(Замечания.Количество() = 0, "Совпадает", Замечания[0]);
	КонецЕсли;

	Для Каждого Замечание Из Замечания Цикл
		Расхождения.Добавить(Замечание);
	КонецЦикла;

	ЧастиКомментария = Новый Массив;
	Для Каждого КодРасхождения Из Расхождения Цикл
		ЧастиКомментария.Добавить(ТекстКомментарияСверки(КодРасхождения));
	КонецЦикла;
	Линия.Комментарий = СтрСоединить(ЧастиКомментария, ", ");

	Если Кратность > 1 Тогда
		Линия.Комментарий = СокрЛП(Линия.Комментарий + " упаковка x" + Формат(Кратность, "ЧГ=0"));
	ИначеЕсли ПоСумме Тогда
		Линия.Комментарий = СокрЛП(Линия.Комментарий + " сумма");
	КонецЕсли;

	Если Линия.УПД <> Неопределено И ЗначениеЗаполнено(Линия.УПД.Корректировка) Тогда
		Линия.Комментарий = СокрЛП(Линия.Комментарий + " (с учётом " + Линия.УПД.Корректировка + ")");
		// Уменьшение количества корректировкой - возврат или снятие товара:
		// оператор видит, что разрыв против исходной УПД объяснён УКД
		Если Линия.УПД.КоличествоДо <> 0 И Линия.УПД.Количество < Линия.УПД.КоличествоДо Тогда
			Линия.Комментарий = СокрЛП(Линия.Комментарий + ", уменьшение по УКД (возможен возврат)");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Строка расхождения для текста сверки (реестр УПД, цепочка, трасса): номер,
// товар и что не так - словами и с числами из УПД и приходной.
//   НетВПоступлении - «есть в УПД, НЕТ в приходной: не довезли или нет пары по штрихкоду»
//   НетВУПД         - «есть в приходной, НЕТ в УПД»
//   Количество/Цена - числа обеих сторон
//
Функция ТекстРасхожденияЛинии(Линия)

	Товар = СтрШаблон("%1. «%2»", Линия.НомерСтроки, Лев(ЛучшееНаименование(Линия), 60));
	УПД = Линия.УПД;
	Приход = Линия.Поступление;

	Если Линия.Результат = "НетВПоступлении" Тогда
		Если УПД <> Неопределено Тогда
			Возврат СтрШаблон("%1: есть в УПД (%2 шт на %3), НЕТ в приходной Далиона - не довезли или нет пары по штрихкоду",
				Товар, ЧислоДляТрассы(УПД.Количество), ЧислоДляТрассы(СуммаСтрокиСверки(УПД)));
		КонецЕсли;
		Возврат Товар + ": нет в приходной Далиона (есть только в заказе или ЭТрН - недовоз)";
	ИначеЕсли Линия.Результат = "НетВУПД" Тогда
		Если Приход <> Неопределено Тогда
			Возврат СтрШаблон("%1: есть в приходной (%2 шт на %3), НЕТ в УПД - лишний товар или нет пары по штрихкоду",
				Товар, ЧислоДляТрассы(Приход.Количество), ЧислоДляТрассы(СуммаСтрокиСверки(Приход)));
		КонецЕсли;
		Возврат Товар + ": нет в УПД (есть только в заказе или ЭТрН)";
	ИначеЕсли Линия.Результат = "Количество" И УПД <> Неопределено И Приход <> Неопределено Тогда
		Возврат СтрШаблон("%1: не сошлось количество - УПД %2 шт, приходная %3 шт (%4)", Товар,
			ЧислоДляТрассы(УПД.Количество), ЧислоДляТрассы(Приход.Количество),
			?(Приход.Количество < УПД.Количество, "недовоз", "перевоз"));
	ИначеЕсли Линия.Результат = "Цена" И УПД <> Неопределено И Приход <> Неопределено Тогда
		Возврат СтрШаблон("%1: не сошлась цена - УПД %2, приходная %3 (сумма УПД %4, приходной %5)", Товар,
			ЧислоДляТрассы(УПД.Цена), ЧислоДляТрассы(Приход.Цена),
			ЧислоДляТрассы(СуммаСтрокиСверки(УПД)), ЧислоДляТрассы(СуммаСтрокиСверки(Приход)));
	КонецЕсли;

	Возврат СтрШаблон("%1: %2", Товар, ТекстКомментарияСверки(Линия.Результат));

КонецФункции

Функция ТекстКомментарияСверки(КодРасхождения)

	Если КодРасхождения = "НетВУПД" Тогда
		Возврат "нет в УПД";
	ИначеЕсли КодРасхождения = "НетВПоступлении" Тогда
		Возврат "нет в приходе";
	ИначеЕсли КодРасхождения = "Количество" Тогда
		Возврат "не сошлось количество";
	ИначеЕсли КодРасхождения = "Цена" Тогда
		Возврат "не сошлась цена";
	ИначеЕсли КодРасхождения = "НоменклатураПНОшибочна" Тогда
		Возврат "номенклатура прихода не совпала с заказом";
	ИначеЕсли КодРасхождения = "НетВЭТрН" Тогда
		Возврат "нет в ЭТрН";
	ИначеЕсли КодРасхождения = "НетВЗаказе" Тогда
		Возврат "нет в заказе";
	ИначеЕсли КодРасхождения = "КоличествоЭТрН" Тогда
		Возврат "не сошлось количество ЭТрН";
	КонецЕсли;

	Возврат КодРасхождения;

КонецФункции

// Сравнивает количество и цену двух строк или групп сверки (нужны поля
// Количество, Цена, Сумма; сумма с НДС, 0 - неизвестна, тогда берётся
// количество × цена). Необязательны КоличествоДокумента, Коэффициент,
// ЕдиницаИзмерения.
//
// Штуки: равны или упаковка (целое кратное ≥ 2 и суммы в допуске цены).
// Сумма сама по себе количество не закрывает.
// Вес (кг/г/л или дробное ≥ 0,01): допуск 50 г или 1% от большей стороны.
// Коробка УПД против штук Далиона: сравниваются и базовое количество, и
// количество документа (quantity до умножения на ratio).
// НДС и сумма строки в расхождение не идут: итог документа - общая сумма
// и число позиций.
//
// Возвращаемое значение:
//   Структура - Количество, Цена, НДС, Сумма (Булево), Кратность (Число),
//               ПоСумме (Булево)
//
Функция СравнитьКоличествоИЦену(СтрокаА, СтрокаБ, Настройки, ИмяА = "первая", ИмяБ = "вторая") Экспорт

	// Пояснение - как именно решено: какие количества, цены, суммы и допуски сравнивались
	Результат = Новый Структура("Количество, Цена, НДС, Сумма, Кратность, ПоСумме, Пояснение",
		Ложь, Ложь, Истина, Истина, 1, Ложь, "");

	ДопускЦены = Настройки.ДопускЦены;
	ДопускКоличества = 0.05;
	Если Настройки.Свойство("ДопускКоличества") Тогда
		ДопускКоличества = Настройки.ДопускКоличества;
	КонецЕсли;

	СуммаА = СуммаСтрокиСверки(СтрокаА);
	СуммаБ = СуммаСтрокиСверки(СтрокаБ);
	ЕстьСуммы = СуммаА <> 0 И СуммаБ <> 0;
	РазницаСумм = Макс(СуммаА - СуммаБ, СуммаБ - СуммаА);
	ЦенаА = ЧислоПоляСтроки(СтрокаА, "Цена", 0);
	ЦенаБ = ЧислоПоляСтроки(СтрокаБ, "Цена", 0);
	ЦенаВДопуске = Макс(ЦенаА - ЦенаБ, ЦенаБ - ЦенаА) <= ДопускЦены;

	ВариантыА = ВариантыКоличестваСтроки(СтрокаА);
	ВариантыБ = ВариантыКоличестваСтроки(СтрокаБ);
	Весовой = ЭтоВесовоеСравнение(СтрокаА, СтрокаБ, ВариантыА, ВариантыБ);

	ПодобраннаяКратность = 1;
	Для Каждого КоличествоА Из ВариантыА Цикл
		Для Каждого КоличествоБ Из ВариантыБ Цикл

			Если КоличестваСошлись(КоличествоА, КоличествоБ, Весовой, ДопускКоличества) Тогда
				Результат.Количество = Истина;
				БольшеКоличества = Макс(КоличествоА, КоличествоБ);
				ДопускСуммы = Макс(ДопускЦены, ДопускЦены * Макс(БольшеКоличества, 1));
				Если Весовой Тогда
					ДопускВеса = ДопускКоличестваАбсолютный(БольшеКоличества, ДопускКоличества);
					СредняяЦена = Макс(ЦенаА, ЦенаБ);
					ДопускСуммы = Макс(ДопускСуммы, СредняяЦена * ДопускВеса);
				КонецЕсли;
				Результат.Цена = ЦенаВДопуске ИЛИ ЕстьСуммы И РазницаСумм <= ДопускСуммы;
				Результат.Пояснение = СтрШаблон("кол-во %1 %2 = %3 %4 (%5); %6",
					ИмяА, ЧислоДляТрассы(КоличествоА), ИмяБ, ЧислоДляТрассы(КоличествоБ),
					?(Весовой, "весовое, допуск " + ЧислоДляТрассы(ДопускКоличестваАбсолютный(БольшеКоличества, ДопускКоличества)), "штучное, точно"),
					ПояснениеЦены(ИмяА, ИмяБ, ЦенаА, ЦенаБ, ДопускЦены, ЦенаВДопуске, ЕстьСуммы, СуммаА, СуммаБ, РазницаСумм, ДопускСуммы));
				ЗаполнитьСравнениеНДСиСуммы(Результат, СтрокаА, СтрокаБ, Настройки, ДопускСуммы);
				Возврат Результат;
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	Если ЕстьСуммы Тогда
		Для Каждого КоличествоА Из ВариантыА Цикл
			Для Каждого КоличествоБ Из ВариантыБ Цикл

				Кратность = КратностьУпаковки(КоличествоА, КоличествоБ);
				Если Кратность < 2 Тогда
					Продолжить;
				КонецЕсли;
				ДопускСуммы = Макс(ДопускЦены, ДопускЦены * Макс(КоличествоА, КоличествоБ, 1));
				Если РазницаСумм <= ДопускСуммы Тогда
					Результат.Количество = Истина;
					Результат.Цена       = Истина;
					Результат.Кратность  = Кратность;
					Результат.Пояснение = СтрШаблон("кол-во %1 %2 и %3 %4 - упаковка x%5; суммы %6 и %7 (разница %8, допуск %9) - сошлось как упаковка",
						ИмяА, ЧислоДляТрассы(КоличествоА), ИмяБ, ЧислоДляТрассы(КоличествоБ), Кратность,
						ЧислоДляТрассы(СуммаА), ЧислоДляТрассы(СуммаБ), ЧислоДляТрассы(РазницаСумм), ЧислоДляТрассы(ДопускСуммы));
					ДопускСуммыУпаковки = Макс(ДопускЦены, ДопускЦены * Макс(КоличествоА, КоличествоБ, 1));
					ЗаполнитьСравнениеНДСиСуммы(Результат, СтрокаА, СтрокаБ, Настройки, ДопускСуммыУпаковки);
					Возврат Результат;
				КонецЕсли;
				ПодобраннаяКратность = Макс(ПодобраннаяКратность, Кратность);

			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Результат.Цена = ЦенаВДопуске;
	Если ПодобраннаяКратность >= 2 Тогда
		Результат.Кратность = ПодобраннаяКратность;
	КонецЕсли;
	Результат.Пояснение = СтрШаблон("кол-во НЕ сошлось: %1 %2 против %3 %4%5; цена %6 и %7 %8 (допуск %9)",
		ИмяА, ТекстВариантовКоличества(ВариантыА), ИмяБ, ТекстВариантовКоличества(ВариантыБ),
		?(ПодобраннаяКратность >= 2, СтрШаблон(" (похоже на упаковку x%1, но суммы %2 и %3 разошлись на %4)", ПодобраннаяКратность,
			ЧислоДляТрассы(СуммаА), ЧислоДляТрассы(СуммаБ), ЧислоДляТрассы(РазницаСумм)), ""),
		ЧислоДляТрассы(ЦенаА), ЧислоДляТрассы(ЦенаБ), ?(ЦенаВДопуске, "в допуске", "НЕ в допуске"), ЧислоДляТрассы(ДопускЦены));
	ДопускСуммыИтога = Макс(ДопускЦены, ДопускЦены * Макс(
		ЧислоПоляСтроки(СтрокаА, "Количество", 0), ЧислоПоляСтроки(СтрокаБ, "Количество", 0), 1));
	ЗаполнитьСравнениеНДСиСуммы(Результат, СтрокаА, СтрокаБ, Настройки, ДопускСуммыИтога);

	Возврат Результат;

КонецФункции

Процедура ЗаполнитьСравнениеНДСиСуммы(Результат, СтрокаА, СтрокаБ, Настройки, ДопускСуммы)

	СуммаА = СуммаСтрокиСверки(СтрокаА);
	СуммаБ = СуммаСтрокиСверки(СтрокаБ);

	Если СуммаА = 0 И СуммаБ = 0 Тогда
		Результат.Сумма = Результат.Количество И Результат.Цена;
	Иначе
		Результат.Сумма = Макс(СуммаА - СуммаБ, СуммаБ - СуммаА) <= ДопускСуммы;
	КонецЕсли;
	Результат.НДС = Истина;

КонецПроцедуры

Функция ВариантыКоличестваСтроки(Строка)

	Варианты = Новый Массив;
	ДобавитьВариантКоличества(Варианты, ЧислоПоляСтроки(Строка, "Количество", 0));

	КоличествоДокумента = ЧислоПоляСтроки(Строка, "КоличествоДокумента", 0);
	Если КоличествоДокумента <> 0 Тогда
		ДобавитьВариантКоличества(Варианты, КоличествоДокумента);
		Коэффициент = ЧислоПоляСтроки(Строка, "Коэффициент", 1);
		Если Коэффициент > 1 Тогда
			ДобавитьВариантКоличества(Варианты, КоличествоДокумента * Коэффициент);
		КонецЕсли;
	КонецЕсли;

	Если Варианты.Количество() = 0 Тогда
		Варианты.Добавить(0);
	КонецЕсли;

	Возврат Варианты;

КонецФункции

Процедура ДобавитьВариантКоличества(Варианты, Количество)

	Для Каждого УжеЕсть Из Варианты Цикл
		Если Макс(УжеЕсть - Количество, Количество - УжеЕсть) < 0.0001 Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Варианты.Добавить(Количество);

КонецПроцедуры

Функция ЭтоВесовоеСравнение(СтрокаА, СтрокаБ, ВариантыА, ВариантыБ)

	Если ЭтоВесоваяЕдиница(СтрокаПоляСтроки(СтрокаА, "ЕдиницаИзмерения"))
		ИЛИ ЭтоВесоваяЕдиница(СтрокаПоляСтроки(СтрокаБ, "ЕдиницаИзмерения")) Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Количество Из ВариантыА Цикл
		Если КоличествоДробное(Количество) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Количество Из ВариантыБ Цикл
		Если КоличествоДробное(Количество) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЭтоВесоваяЕдиница(Единица)

	Текст = ВРег(СокрЛП(Единица));
	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, " ", ""), ".", ""), ",", "");
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Текст = "166" ИЛИ Текст = "163" ИЛИ Текст = "112" ИЛИ Текст = "111"
		ИЛИ Текст = "113" ИЛИ Текст = "KGM" ИЛИ Текст = "GRM" ИЛИ Текст = "LTR"
		ИЛИ Текст = "MLT" ИЛИ Текст = "КГ" ИЛИ Текст = "Г" ИЛИ Текст = "ГР"
		ИЛИ Текст = "Л" ИЛИ Текст = "МЛ" Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрНачинаетсяС(Текст, "КИЛОГ") ИЛИ СтрНачинаетсяС(Текст, "ГРАМ")
		ИЛИ СтрНачинаетсяС(Текст, "ЛИТР");

КонецФункции

Функция КоличествоДробное(Количество)

	Возврат Макс(Количество - Окр(Количество, 0), Окр(Количество, 0) - Количество) >= 0.01;

КонецФункции

Функция КоличестваСошлись(КоличествоА, КоличествоБ, Весовой, ДопускКоличества)

	Разница = Макс(КоличествоА - КоличествоБ, КоличествоБ - КоличествоА);
	Если Разница < 0.001 Тогда
		Возврат Истина;
	КонецЕсли;
	Если НЕ Весовой Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Разница <= ДопускКоличестваАбсолютный(Макс(КоличествоА, КоличествоБ), ДопускКоличества);

КонецФункции

Функция ДопускКоличестваАбсолютный(Количество, ДопускКоличества)

	Возврат Макс(ДопускКоличества, 0.01 * Макс(Количество, 0));

КонецФункции

Функция КратностьУпаковки(КоличествоА, КоличествоБ)

	Меньше = Мин(КоличествоА, КоличествоБ);
	Больше = Макс(КоличествоА, КоличествоБ);
	Если Меньше <= 0 Тогда
		Возврат 1;
	КонецЕсли;

	Кратность = Окр(Больше / Меньше, 0);
	Если Кратность < 2 Тогда
		Возврат 1;
	КонецЕсли;
	Если Макс(Больше - Меньше * Кратность, Меньше * Кратность - Больше) >= 0.001 Тогда
		Возврат 1;
	КонецЕсли;

	Возврат Кратность;

КонецФункции

Функция ЧислоПоляСтроки(Строка, ИмяПоля, ЗначениеПоУмолчанию)

	Если ТипЗнч(Строка) = Тип("Структура") И Строка.Свойство(ИмяПоля) Тогда
		Возврат Строка[ИмяПоля];
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция СтрокаПоляСтроки(Строка, ИмяПоля)

	Если ТипЗнч(Строка) = Тип("Структура") И Строка.Свойство(ИмяПоля) Тогда
		Возврат Строка[ИмяПоля];
	КонецЕсли;

	Возврат "";

КонецФункции

Функция СуммаСтрокиСверки(Строка)

	Если Строка.Сумма <> 0 Тогда
		Возврат Строка.Сумма;
	КонецЕсли;

	Возврат Строка.Количество * Строка.Цена;

КонецФункции

// УПД зелёная, если все линии с приходом или УПД не критичны: после склейки
// одного товара это тот же вердикт, что у строки реестра.
//
Функция УПДСошласьПоШтрихкодам(Линии, УПДУчтена, Настройки)

	Если НЕ УПДУчтена Тогда
		Возврат Ложь;
	КонецЕсли;

	ЕстьУПД = Ложь;
	ЕстьПН  = Ложь;

	Для Каждого Линия Из Линии Цикл

		Если Линия.УПД <> Неопределено Тогда
			ЕстьУПД = Истина;
		КонецЕсли;
		Если Линия.Поступление <> Неопределено Тогда
			ЕстьПН = Истина;
		КонецЕсли;
		Если Линия.Критично Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат ЕстьУПД И ЕстьПН;

КонецФункции

// УПД ждёт корректировку: в приходной Далиона нет товара, который есть в УПД
// (строка УПД без пары в приходе), и число позиций УПД и прихода не сходится.
// УПД здесь уже с учётом пришедших УКД (см. ПрименитьКорректировки): когда
// корректировка уберёт лишний товар, позиции сойдутся и ожидание снимется.
//
// Параметры:
//   Линии           - Массив из Структура - см. НоваяЛиния, уже оценённые
//   ИтогиДокументов - Структура - см. ИтогиУПДиПрихода
//
// Возвращаемое значение:
//   Булево
//
Функция УПДОжидаетУКД(Линии, ИтогиДокументов)

	Если ИтогиДокументов.ПозицийПН = 0
		ИЛИ ИтогиДокументов.ПозицийУПД = ИтогиДокументов.ПозицийПН Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Линия Из Линии Цикл
		Если Линия.УПД <> Неопределено И Линия.Поступление = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// УКД уже есть, Далион возврат не провёл: действующая УКД уменьшила количество
// (строка УПД после УКД меньше, чем до неё, или убрана - возврат, снятый товар), а
// сумма приходной Далиона больше суммы УПД после УКД. Корректировка одной цены
// возвратом не считается. Статус УПД «УКД есть, нет возврата из Далиона»; Далион
// проведёт возврат (приходная уменьшится) - суммы сойдутся.
//
// Параметры:
//   ИдентификаторУПД - Строка
//   Линии            - Массив - линии сверки после ПрименитьКорректировки (УПД.КоличествоДо)
//   ИтогиДокументов  - Структура - см. ИтогиУПДиПрихода (УПД уже с учётом УКД)
//
// Возвращаемое значение:
//   Булево
//
Функция УПДЖдётВозвратДалиона(ИдентификаторУПД, Линии, ИтогиДокументов)

	Если ИтогиДокументов.ПозицийПН = 0 ИЛИ ИтогиДокументов.СуммаПН <= ИтогиДокументов.СуммаУПД Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Линия Из Линии Цикл
		Если Линия.УПД <> Неопределено И Линия.УПД.Свойство("КоличествоДо")
			И Линия.УПД.КоличествоДо <> 0 И Линия.УПД.Количество < Линия.УПД.КоличествоДо Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	// Строка, убранная УКД целиком, могла уйти из линий УПД
	Для Каждого СтрокаУКД Из ЭАрМ_КорректировкиУПД.СтрокиКорректировок(ИдентификаторУПД) Цикл
		Если СтрокаУКД.ПризнакИзменения = "Убрана" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ИтогиУПДиПрихода(Линии)

	Итоги = Новый Структура("ПозицийУПД, ПозицийПН, СуммаУПД, СуммаПН", 0, 0, 0, 0);

	Для Каждого Линия Из Линии Цикл

		Если Линия.УПД <> Неопределено Тогда
			Итоги.ПозицийУПД = Итоги.ПозицийУПД + 1;
			Итоги.СуммаУПД   = Итоги.СуммаУПД + СуммаСтрокиСверки(Линия.УПД);
		КонецЕсли;

		Если Линия.Поступление <> Неопределено Тогда
			Итоги.ПозицийПН = Итоги.ПозицийПН + 1;
			Итоги.СуммаПН   = Итоги.СуммаПН + СуммаСтрокиСверки(Линия.Поступление);
		КонецЕсли;

	КонецЦикла;

	Возврат Итоги;

КонецФункции

Функция РасхожденияИтоговДокументов(Итоги, Настройки)

	Результат = Новый Массив;

	Если Итоги.ПозицийУПД = 0 ИЛИ Итоги.ПозицийПН = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ПозицийУПД = Итоги.ПозицийУПД;
	ПозицийПН  = Итоги.ПозицийПН;

	Если ПозицийУПД <> ПозицийПН Тогда
		Результат.Добавить(СтрШаблон("позиций строк: УПД %1, приход %2",
			ПозицийУПД, ПозицийПН));
	КонецЕсли;

	ТекстСуммы = ТекстРасхожденияИтоговойСуммы(Итоги, Настройки);
	Если ЗначениеЗаполнено(ТекстСуммы) Тогда
		Результат.Добавить(ТекстСуммы);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Допуск итоговой суммы УПД и прихода, в рублях.
//
// Галочка «Точно» - ноль: суммы должны совпасть до копейки. Снята - допускается
// погрешность из шапки реестра (копейки). Допуск цены строки сюда не входит.
//
Функция ДопускИтоговойСуммы(Настройки) Экспорт

	Если Настройки = Неопределено
		ИЛИ НЕ Настройки.Свойство("СуммаТочно")
		ИЛИ Настройки.СуммаТочно = Истина Тогда
		Возврат 0;
	КонецЕсли;

	Копеек = 0;
	Если Настройки.Свойство("ПогрешностьКопеек") Тогда
		Копеек = Макс(Настройки.ПогрешностьКопеек, 0);
	КонецЕсли;

	Возврат Копеек / 100;

КонецФункции

// Какая сумма больше и на сколько. Пустая строка - суммы равны до копейки.
//
Функция ТекстКудаБольшеСумма(СуммаУПД, СуммаПН) Экспорт

	Разница = Окр(СуммаУПД, 2) - Окр(СуммаПН, 2);
	Если Разница = 0 Тогда
		Возврат "";
	КонецЕсли;

	СуммаТекстом = Формат(Макс(Разница, -Разница), "ЧДЦ=2; ЧН=0; ЧГ=0");
	Если Разница > 0 Тогда
		Возврат СтрШаблон("УПД больше на %1", СуммаТекстом);
	КонецЕсли;

	Возврат СтрШаблон("приход больше на %1", СуммаТекстом);

КонецФункции

// Истина, если разница итогов не больше допуска (при «Точно» допуск нулевой).
//
Функция СуммыИтогаВДопуске(СуммаУПД, СуммаПН, Настройки) Экспорт

	Возврат Макс(Окр(СуммаУПД, 2) - Окр(СуммаПН, 2), Окр(СуммаПН, 2) - Окр(СуммаУПД, 2))
		<= ДопускИтоговойСуммы(Настройки);

КонецФункции

// Итоговые суммы УПД (с учётом УКД) и прихода Далиона по строкам цепочки.
//
// Возвращаемое значение:
//   Строка - текст расхождения; пустая, если суммы сошлись
//
Функция ТекстРасхожденияИтоговойСуммы(Итоги, Настройки)

	Если Итоги.ПозицийУПД = 0 Тогда
		Возврат "итоговая сумма: в УПД нет строк товаров";
	КонецЕсли;
	Если Итоги.ПозицийПН = 0 Тогда
		Возврат "итоговая сумма: в приходе Далиона нет строк товаров";
	КонецЕсли;

	ТекстРазницы = ТекстКудаБольшеСумма(Итоги.СуммаУПД, Итоги.СуммаПН);
	Если НЕ ЗначениеЗаполнено(ТекстРазницы) Тогда
		Возврат "";
	КонецЕсли;

	Если НЕ СуммыИтогаВДопуске(Итоги.СуммаУПД, Итоги.СуммаПН, Настройки) Тогда
		Возврат СтрШаблон("%1 (УПД %2, приход %3) — больше допуска, к утверждению не готова",
			ТекстРазницы,
			Формат(Итоги.СуммаУПД, "ЧДЦ=2; ЧН=0; ЧГ=0"),
			Формат(Итоги.СуммаПН, "ЧДЦ=2; ЧН=0; ЧГ=0"));
	КонецЕсли;

	Возврат "";

КонецФункции

// Проверка перед отправкой: итоговая сумма УПД с учётом корректировок
// против приходной накладной Далиона, пересчитанная по текущим документам.
// Отметки «Расхождений нет» для отправки мало: её ставили и по одному
// наличию прихода и ЭТрН.
//
// Параметры:
//   ИдентификаторУПД - Строка - УПД в СБИС (для УКД - её исходная УПД)
//
// Возвращаемое значение:
//   Строка - причина запрета; пустая, если суммы сошлись
//
Функция РасхождениеИтоговойСуммыУПД(ИдентификаторУПД) Экспорт

	Цепочка = ЭАрМ_ЦепочкаЗакупки.ЦепочкаПоУПД(ИдентификаторУПД);
	Если Цепочка = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Цепочка.ИдентификаторПоступления) Тогда
		Возврат "к УПД не найдена приходная накладная Далиона, итоговую сумму не с чем сравнить";
	КонецЕсли;

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	Линии = ЛинииЦепочки(Цепочка.ИдентификаторЗаказа, Цепочка.ИдентификаторПоступления, Настройки);
	Если Линии = Неопределено Тогда
		Возврат "к УПД не найдена приходная накладная Далиона, итоговую сумму не с чем сравнить";
	КонецЕсли;

	Возврат ТекстРасхожденияИтоговойСуммы(ИтогиУПДиПрихода(Линии), Настройки);

КонецФункции

// ЭТрН готова к утверждению, если есть приход и все строки ЭТрН нашлись
// в нём по штрихкоду с тем же количеством. По имени - нет: сверка только по
// штрихкоду (см. ТолькоШтрихкодИКод).
// Лишние строки прихода на ЭТрН не влияют: полный состав живёт в УПД.
//
Функция ЭТрНСошласьСПриходом(Линии, ЭТрНСвязана)

	Если НЕ ЭТрНСвязана Тогда
		Возврат Ложь;
	КонецЕсли;

	СтрокиЭТрН = Новый Массив;
	СтрокиПН   = Новый Массив;

	Для Каждого Линия Из Линии Цикл
		Если Линия.ЭТрН <> Неопределено Тогда
			СтрокиЭТрН.Добавить(Линия.ЭТрН);
		КонецЕсли;
		Если Линия.Поступление <> Неопределено Тогда
			СтрокиПН.Добавить(Линия.Поступление);
		КонецЕсли;
	КонецЦикла;

	Если СтрокиЭТрН.Количество() = 0 ИЛИ СтрокиПН.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ГруппыЭТрН = СвернутьСтрокиДляСверкиУПД(СтрокиЭТрН);
	ГруппыПН   = СвернутьСтрокиДляСверкиУПД(СтрокиПН);
	Использованные = Новый Соответствие;

	Для Каждого ГруппаЭТрН Из ГруппыЭТрН Цикл

		Пара = НайтиГруппуПриходаДляУПД(ГруппаЭТрН, ГруппыПН, Использованные, Неопределено,
			ТолькоШтрихкодИКод(Неопределено));
		Если Пара = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Если Макс(ГруппаЭТрН.Количество - Пара.Количество, Пара.Количество - ГруппаЭТрН.Количество) >= 0.001 Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция НаборыУПДиПриходаСошлись(СтрокиУПД, СтрокиПН, Настройки)

	Если СтрокиУПД.Количество() = 0 ИЛИ СтрокиПН.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ГруппыУПД = СвернутьСтрокиДляСверкиУПД(СтрокиУПД);
	ГруппыПН  = СвернутьСтрокиДляСверкиУПД(СтрокиПН);
	Использованные = Новый Соответствие;
	ЕстьРасхождениеСтрок = Ложь;

	// Сначала штрихкоды всех групп, потом имена: иначе группа без общего
	// штрихкода забирала по имени чужую группу прихода
	ПарыПоШтрихкоду = Новый Соответствие;
	Для Каждого ГруппаУПД Из ГруппыУПД Цикл
		Пара = НайтиГруппуПриходаДляУПД(ГруппаУПД, ГруппыПН, Использованные, Настройки, Истина);
		Если Пара <> Неопределено Тогда
			ПарыПоШтрихкоду.Вставить(ГруппаУПД.Ключ, Пара);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ГруппаУПД Из ГруппыУПД Цикл

		Пара = ПарыПоШтрихкоду.Получить(ГруппаУПД.Ключ);
		Если Пара = Неопределено Тогда
			Пара = НайтиГруппуПриходаДляУПД(ГруппаУПД, ГруппыПН, Использованные, Настройки,
				ТолькоШтрихкодИКод(Настройки));
		КонецЕсли;
		Если Пара = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Сравнение = СравнитьКоличествоИЦену(ГруппаУПД, Пара, Настройки);
		Если НЕ Сравнение.Количество ИЛИ НЕ Сравнение.Цена Тогда
			ЕстьРасхождениеСтрок = Истина;
		КонецЕсли;

	КонецЦикла;

	Для Каждого ГруппаПН Из ГруппыПН Цикл
		Если Использованные.Получить(ГруппаПН.Ключ) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьРасхождениеСтрок Тогда
		Возврат ИтогиКоличестваИСуммыСошлись(ГруппыУПД, ГруппыПН, Настройки);
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ИтогиКоличестваИСуммыСошлись(ГруппыА, ГруппыБ, Настройки)

	ИтогА = Новый Структура("Количество, Цена, Сумма", 0, 0, 0);
	ИтогБ = Новый Структура("Количество, Цена, Сумма", 0, 0, 0);

	Для Каждого Группа Из ГруппыА Цикл
		ИтогА.Количество = ИтогА.Количество + Группа.Количество;
		ИтогА.Сумма      = ИтогА.Сумма + СуммаСтрокиСверки(Группа);
	КонецЦикла;
	Для Каждого Группа Из ГруппыБ Цикл
		ИтогБ.Количество = ИтогБ.Количество + Группа.Количество;
		ИтогБ.Сумма      = ИтогБ.Сумма + СуммаСтрокиСверки(Группа);
	КонецЦикла;

	Если ИтогА.Количество > 0 Тогда
		ИтогА.Цена = ИтогА.Сумма / ИтогА.Количество;
	КонецЕсли;
	Если ИтогБ.Количество > 0 Тогда
		ИтогБ.Цена = ИтогБ.Сумма / ИтогБ.Количество;
	КонецЕсли;

	Сравнение = СравнитьКоличествоИЦену(ИтогА, ИтогБ, Настройки);
	Возврат Сравнение.Количество И Сравнение.Цена;

КонецФункции

Функция СвернутьСтрокиДляСверкиУПД(Строки)

	Группы = Новый Массив;
	Индекс = Новый Соответствие;

	Для Каждого Строка Из Строки Цикл

		Ключ = КлючГруппыСверкиУПД(Строка);
		Группа = Индекс.Получить(Ключ);

		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Ключ, Наименование, НаименованиеНорм, Штрихкоды, Количество, КоличествоДокумента, Коэффициент, ЕдиницаИзмерения, Цена, Сумма, СуммаНДС, СтавкаНДС",
				Ключ, Строка.Наименование, Строка.НаименованиеНорм, Строка.Штрихкоды, 0,
				0, ЧислоПоляСтроки(Строка, "Коэффициент", 1),
				СтрокаПоляСтроки(Строка, "ЕдиницаИзмерения"), Строка.Цена, 0, 0,
				СтрокаПоляСтроки(Строка, "СтавкаНДС"));
			Индекс.Вставить(Ключ, Группа);
			Группы.Добавить(Группа);
		КонецЕсли;

		Группа.Количество = Группа.Количество + Строка.Количество;
		Группа.КоличествоДокумента = Группа.КоличествоДокумента
			+ ЧислоПоляСтроки(Строка, "КоличествоДокумента", Строка.Количество);
		Группа.Сумма      = Группа.Сумма + ?(Строка.Сумма <> 0, Строка.Сумма, Строка.Количество * Строка.Цена);
		Группа.СуммаНДС   = Группа.СуммаНДС + ЧислоПоляСтроки(Строка, "СуммаНДС", 0);

	КонецЦикла;

	Для Каждого Группа Из Группы Цикл
		Если Группа.Количество > 0 Тогда
			Группа.Цена = Группа.Сумма / Группа.Количество;
		КонецЕсли;
	КонецЦикла;

	Возврат Группы;

КонецФункции

Функция КлючГруппыСверкиУПД(Строка)

	Канон = КаноническийШтрихкод(ПредпочтительныйШтрихкод(Строка.Штрихкоды));
	Если ЗначениеЗаполнено(Канон) Тогда
		Возврат "ШК|" + Канон;
	КонецЕсли;

	Возврат "ИМЯ|" + Строка.НаименованиеНорм + "|" + Формат(Строка.Цена, "ЧЦ=19; ЧДЦ=11; ЧН=0; ЧГ=0");

КонецФункции

Функция КаноническийШтрихкод(Штрихкод) Экспорт

	Цифры = ЦифрыШтрихкода(Штрихкод);
	Если СтрДлина(Цифры) >= 16 И Лев(Цифры, 2) = "01" Тогда
		Цифры = Сред(Цифры, 3, 14);
	КонецЕсли;
	Если СтрДлина(Цифры) = 12 Тогда
		Цифры = "0" + Цифры;
	КонецЕсли;
	Если СтрДлина(Цифры) = 14 И Лев(Цифры, 1) = "0" Тогда
		Возврат Сред(Цифры, 2);
	КонецЕсли;

	Возврат Цифры;

КонецФункции

Функция ВесКанонаШтрихкода(Канон)

	Длина = СтрДлина(Канон);
	Если Длина = 13 Тогда
		Возврат ?(Лев(Канон, 1) = "2", 10, 30);
	ИначеЕсли Длина = 14 Тогда
		Возврат 20;
	ИначеЕсли Длина = 8 Тогда
		Возврат 15;
	КонецЕсли;

	Возврат Длина;

КонецФункции

Функция НайтиГруппуПриходаДляУПД(ГруппаУПД, ГруппыПН, Использованные, Настройки, ТолькоШтрихкод = Ложь)

	Для Каждого ГруппаПН Из ГруппыПН Цикл
		Если Использованные.Получить(ГруппаПН.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ШтрихкодыГруппСовпадают(ГруппаУПД, ГруппаПН) Тогда
			Использованные.Вставить(ГруппаПН.Ключ, Истина);
			Возврат ГруппаПН;
		КонецЕсли;
	КонецЦикла;

	Если ТолькоШтрихкод Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого ГруппаПН Из ГруппыПН Цикл
		Если Использованные.Получить(ГруппаПН.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ГруппаУПД.НаименованиеНорм)
			И ГруппаУПД.НаименованиеНорм = ГруппаПН.НаименованиеНорм Тогда
			Использованные.Вставить(ГруппаПН.Ключ, Истина);
			Возврат ГруппаПН;
		КонецЕсли;
	КонецЦикла;

	Для Каждого ГруппаПН Из ГруппыПН Цикл
		Если Использованные.Получить(ГруппаПН.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если НаименованияСовпадают(ГруппаУПД.Наименование, ГруппаПН.Наименование) Тогда
			Использованные.Вставить(ГруппаПН.Ключ, Истина);
			Возврат ГруппаПН;
		КонецЕсли;
	КонецЦикла;

	Если Настройки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Найденная = Неопределено;
	Для Каждого ГруппаПН Из ГруппыПН Цикл
		Если Использованные.Получить(ГруппаПН.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ГруппаУПД.Штрихкоды.Количество() > 0 И ГруппаПН.Штрихкоды.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		Сравнение = СравнитьКоличествоИЦену(ГруппаУПД, ГруппаПН, Настройки);
		Если Сравнение.Количество И Сравнение.Цена Тогда
			Если Найденная <> Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Найденная = ГруппаПН;
		КонецЕсли;
	КонецЦикла;

	Если Найденная = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Использованные.Вставить(Найденная.Ключ, Истина);
	Возврат Найденная;

КонецФункции

Функция ШтрихкодыГруппСовпадают(ГруппаА, ГруппаБ)

	Если ГруппаА.Штрихкоды.Количество() = 0 ИЛИ ГруппаБ.Штрихкоды.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого КлючА Из ГруппаА.Штрихкоды Цикл
		Для Каждого КлючБ Из ГруппаБ.Штрихкоды Цикл
			Если ШтрихкодыСовпадают(КлючА.Ключ, КлючБ.Ключ) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция НоваяЛиния(НомерСтроки)

	Линия = Новый Структура;
	Линия.Вставить("НомерСтроки", НомерСтроки);
	Линия.Вставить("Заказ",       Неопределено);
	Линия.Вставить("Поступление", Неопределено);
	Линия.Вставить("УПД",         Неопределено);
	Линия.Вставить("ЭТрН",        Неопределено);
	Линия.Вставить("Способ",      "");
	Линия.Вставить("СпособУПД",   "");
	Линия.Вставить("Результат",   "");
	Линия.Вставить("Критично",    Ложь);
	Линия.Вставить("Комментарий", "");
	Линия.Вставить("Пояснение",   "");

	Возврат Линия;

КонецФункции

#КонецОбласти

#Область СтрокиДокументов

// Строки заказа или поступления из пакета Далиона в общем виде.
//
// Количество приводится к базовым единицам (quantity x ratio). Цена - из
// табчасти Далиона (price / ratio): так видит кладовщик. Сумму для проверки
// упаковки берём с НДС (amount, плюс vatAmount если сумма без налога).
// Не считаем цену как сумма/количество: при сумме без НДС и флаге НДС
// 71,90 из табчасти превращались в 75,90.
//
Функция СтрокиДалиона(Объект, Источник)

	Результат = Новый Массив;

	Если Объект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	УчитыватьНДС     = ЭАрМ_Служебный.ЗначениеУзла(Объект, "useVat", Ложь) = Истина;
	СуммаВключаетНДС = ЭАрМ_Служебный.ЗначениеУзла(Объект, "vatIncluded", Ложь) = Истина;

	Для Каждого Товар Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "goods")) Цикл

		Номенклатура = ЭАрМ_Служебный.ЗначениеУзла(Товар, "nomenclature");
		Карточка     = ЭАрМ_Служебный.ЗначениеУзла(Товар, "item");

		Коэффициент = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "ratio", 1));
		Если Коэффициент <= 0 Тогда
			Коэффициент = 1;
		КонецЕсли;

		КоличествоДокумента = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "quantity", 0));
		Количество = КоличествоДокумента * Коэффициент;
		Сумма = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "amount", 0));
		Если УчитыватьНДС И НЕ СуммаВключаетНДС Тогда
			Сумма = Сумма + ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "vatAmount", 0));
		КонецЕсли;

		УзелЕдиницы = ЭАрМ_Служебный.ЗначениеУзла(Номенклатура, "unit");
		Если ТипЗнч(УзелЕдиницы) = Тип("Строка") Тогда
			ЕдиницаИзмерения = СокрЛП(УзелЕдиницы);
		Иначе
			ЕдиницаИзмерения = ЗначениеСтрокой(УзелЕдиницы, "name");
		КонецЕсли;

		Строка = НоваяСтрока(Источник, Результат.Количество() + 1);
		Строка.Наименование              = ЗначениеСтрокой(Номенклатура, "name");
		Строка.Код                       = ЗначениеСтрокой(Номенклатура, "code");
		Строка.Артикул                   = ЗначениеСтрокой(Карточка, "article");
		Строка.ИдентификаторНоменклатуры = ЗначениеСтрокой(Номенклатура, "uid");
		Если ЗначениеЗаполнено(Строка.ИдентификаторНоменклатуры) Тогда
			Строка.ИдентификаторыНоменклатуры.Добавить(Строка.ИдентификаторНоменклатуры);
		КонецЕсли;
		Строка.Количество                = Количество;
		Строка.КоличествоДокумента       = КоличествоДокумента;
		Строка.Коэффициент               = Коэффициент;
		Строка.ЕдиницаИзмерения          = ЕдиницаИзмерения;
		Строка.Сумма                     = Сумма;
		Строка.СуммаНДС                  = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "vatAmount", 0));
		Строка.СтавкаНДС                 = ЗначениеСтрокой(Товар, "vatRate");
		ЦенаПакета = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "price", 0));
		Если ЦенаПакета <> 0 Тогда
			Строка.Цена = ЦенаПакета / Коэффициент;
		ИначеЕсли Количество <> 0 И Сумма <> 0 Тогда
			Строка.Цена = Сумма / Количество;
		КонецЕсли;
		Строка.НаименованиеНорм          = НормализованноеНаименование(Строка.Наименование);

		Для Каждого Штрихкод Из ШтрихкодыСтрокиДалиона(Товар) Цикл
			Строка.Штрихкоды.Вставить(Штрихкод, Истина);
		КонецЦикла;
		Строка.СпособШтрихкода = ?(Строка.Штрихкоды.Количество() > 0, "Далион", "");

		// Коды, считанные при приёмке в Далионе (ШтрихкодыУпаковок приходной)
		Строка.Маркировки = КодыМаркировкиДалиона(Товар);
		Строка.Маркирован = Строка.Маркировки.Количество() > 0;
		Строка.Позиции.Добавить(Строка.Номер);

		Результат.Добавить(Строка);

	КонецЦикла;

	ДополнитьШтрихкодыИзУТ(Результат);

	Возврат Результат;

КонецФункции

// Коды маркировки строки пакета Далиона (markingCodes). Элемент - объект с
// полем code, на всякий случай принимаем и просто строку кода.
//
Функция КодыМаркировкиДалиона(Товар)

	Результат = Новый Массив;
	Добавленные = Новый Соответствие;

	Для Каждого Элемент Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Товар, "markingCodes")) Цикл

		Код = ?(ТипЗнч(Элемент) = Тип("Строка"), СокрЛП(Элемент), ЗначениеСтрокой(Элемент, "code"));
		Если ЗначениеЗаполнено(Код) И Добавленные.Получить(Код) = Неопределено Тогда
			Добавленные.Вставить(Код, Истина);
			Результат.Добавить(Код);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Итоговая сумма УПД с учётом её корректировок (УКД) - та же, что сверка
// сравнивает с приходом: строки УПД, к которым по порядку применены УКД
// (СтрокиЭДО, ПрименитьКорректировки). Корректировка правит строки, а не
// шапку, поэтому одним запросом по суммам её не посчитать.
//
// Возвращаемое значение:
//   Число - сумма с НДС;
//   Неопределено - своих строк у УПД в регистре нет (они лежат под ЭТрН),
//     применить корректировки не к чему
//
Функция СуммаУПДСУчетомУКД(ИдентификаторУПД) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Найдено
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &ИдентификаторУПД
	|	И Товары.ИсточникТоваров = ""УПД""";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сумма = 0;
	Для Каждого Строка Из СтрокиЭДО(ИдентификаторУПД, "УПД") Цикл
		Сумма = Сумма + Строка.Сумма;
	КонецЦикла;

	Возврат Сумма;

КонецФункции

// Строки документа ЭДО из регистра ЭАрМ_ТоварыЭТрН. Строки Далиона ("База2"),
// лежащие под тем же идентификатором, в сверку не берём - они придут пакетом.
//
Функция СтрокиЭДО(ИдентификаторСБИС, Источник)

	Результат = Новый Массив;

	Если НЕ ЗначениеЗаполнено(ИдентификаторСБИС) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.Наименование КАК Наименование,
	|	Товары.КодНоменклатуры КАК КодНоменклатуры,
	|	Товары.КодТовараПоставщика КАК КодТовараПоставщика,
	|	Товары.Артикул КАК Артикул,
	|	Товары.Штрихкод КАК Штрихкод,
	|	Товары.СпособПоискаШК КАК СпособПоискаШК,
	|	Товары.Маркировок КАК Маркировок,
	|	Товары.Маркировки КАК Маркировки,
	|	Товары.Количество КАК Количество,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.Алкоголь КАК Алкоголь
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &ИдентификаторСБИС
	|	И Товары.ИсточникТоваров <> ""База2""
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерПозиции";
	Запрос.УстановитьПараметр("ИдентификаторСБИС", ИдентификаторСБИС);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Строка = НоваяСтрока(Источник, Результат.Количество() + 1);
		Строка.Наименование     = СокрЛП(Выборка.Наименование);
		Строка.Код              = СокрЛП(?(ЗначениеЗаполнено(Выборка.КодТовараПоставщика),
			Выборка.КодТовараПоставщика, Выборка.КодНоменклатуры));
		Строка.Артикул          = СокрЛП(Выборка.Артикул);
		Строка.Количество       = Выборка.Количество;
		Строка.КоличествоДокумента = Выборка.Количество;
		Строка.Коэффициент      = 1;
		Строка.ЕдиницаИзмерения = СокрЛП(Выборка.ЕдиницаИзмерения);
		// Цена в регистре - ЦенаТов УПД (без НДС), Сумма - СтТовУчНал (с НДС).
		// Цену единицы не пересчитываем из суммы: иначе расходится с табчастью.
		Строка.Сумма            = Выборка.Сумма;
		Строка.СуммаНДС         = Выборка.СуммаНДС;
		Строка.СтавкаНДС        = СокрЛП(Выборка.СтавкаНДС);
		Строка.Цена             = Выборка.Цена;
		Если Строка.Цена = 0 И Выборка.Количество <> 0 И Выборка.Сумма <> 0 Тогда
			Строка.Цена = Выборка.Сумма / Выборка.Количество;
		КонецЕсли;
		Строка.НаименованиеНорм = НормализованноеНаименование(Строка.Наименование);
		Строка.Алкоголь         = СокрЛП(Выборка.Алкоголь);

		Если ЗначениеЗаполнено(Выборка.Штрихкод) Тогда
			Строка.Штрихкоды.Вставить(СокрЛП(Выборка.Штрихкод), Истина);
			Строка.СпособШтрихкода = СокрЛП(Выборка.СпособПоискаШК);
			Если Строка.СпособШтрихкода = "GTIN" Тогда
				Строка.ШтрихкодGTIN = СокрЛП(Выборка.Штрихкод);
			КонецЕсли;
		КонецЕсли;

		// Коды маркировки есть только у маркируемого товара
		Строка.Маркировки = КодыМаркировкиВыборки(Выборка.Маркировки);
		Строка.Маркирован = Выборка.Маркировок > 0 ИЛИ Строка.Маркировки.Количество() > 0;
		Строка.НомерПозиции = Выборка.НомерПозиции;
		Строка.Позиции.Добавить(Выборка.НомерПозиции);

		Результат.Добавить(Строка);

	КонецЦикла;

	// С приходом сравнивается УПД с учётом её корректировок
	Если Источник = "УПД" Тогда
		ПрименитьКорректировки(Результат, ИдентификаторСБИС);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Подменяет строки УПД значениями её корректировок (УКД).
//
// Корректировки применяются по порядку дат - следующая правит уже исправленное.
// Строка УКД находит строку УПД по номеру позиции (номер строки исходной УПД),
// затем по штрихкоду, при несовпадении - по наименованию. Нулевое количество
// после изменения - товар из накладной убран. Строка без пары добавляется:
// так расхождение будет видно, а не потеряется. Значения до первой
// корректировки остаются в КоличествоДо и ЦенаДо - для отчёта сверки.
//
Процедура ПрименитьКорректировки(СтрокиУПД, ИдентификаторУПД)

	СтрокиУКД = ЭАрМ_КорректировкиУПД.СтрокиКорректировок(ИдентификаторУПД);
	Если СтрокиУКД.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Каждая строка УКД - в трассу: что уменьшила или увеличила и на сколько
	СуммаДо = 0;
	Для Каждого СтрокаДо Из СтрокиУПД Цикл
		СуммаДо = СуммаДо + СтрокаДо.Сумма;
	КонецЦикла;
	Счётчики = Новый Структура("Уменьшение, Увеличение, Цена, Убрана, Новая, БезИзменений", 0, 0, 0, 0, 0, 0);
	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторУПД, СтрШаблон(
		"УКД: к УПД применяются корректировки - строк УКД %1, строк УПД %2, сумма УПД до корректировок %3",
		СтрокиУКД.Количество(), СтрокиУПД.Количество(), ЧислоДляТрассы(СуммаДо)));

	Для Каждого СтрокаУКД Из СтрокиУКД Цикл

		СпособНайдена = "";
		Строка = НайтиСтрокуУПДДляКорректировки(СтрокиУПД, СтрокаУКД, СпособНайдена);
		БылоКоличество = ?(Строка = Неопределено, 0, Строка.Количество);
		БылаЦена       = ?(Строка = Неопределено, 0, Строка.Цена);
		БылаСумма      = ?(Строка = Неопределено, 0, Строка.Сумма);
		НоваяСтрокаУКД = Строка = Неопределено;

		Если Строка = Неопределено Тогда
			Строка = НоваяСтрока("УПД", СтрокиУПД.Количество() + 1);
			Строка.НомерПозиции     = СтрокаУКД.НомерПозиции;
			Строка.Позиции.Добавить(СтрокаУКД.НомерПозиции);
			Строка.Наименование     = СокрЛП(СтрокаУКД.Наименование);
			Строка.НаименованиеНорм = НормализованноеНаименование(Строка.Наименование);
			СтрокиУПД.Добавить(Строка);
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаУКД.Штрихкод) И Строка.Штрихкоды.Количество() = 0 Тогда
			Строка.Штрихкоды.Вставить(СтрокаУКД.Штрихкод, Истина);
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Строка.Корректировка) Тогда
			Строка.КоличествоДо = Строка.Количество;
			Строка.ЦенаДо       = Строка.Цена;
		КонецЕсли;

		Строка.Корректировка = СтрШаблон("УКД %1 от %2", СокрЛП(СтрокаУКД.Номер), Формат(СтрокаУКД.Дата, "ДЛФ=D"));

		// ▼ - УКД уменьшил строку или убрал товар: возврат по корректировке.
		// Признак проставлен при загрузке УКД (ЭАрМ_Служебный.СтрокаТовараУКД);
		// у строк, загруженных до появления признака, он пуст
		Если СтрокаУКД.ПризнакИзменения = "Уменьшение"
			ИЛИ СтрокаУКД.ПризнакИзменения = "Убрана" Тогда
			Строка.Корректировка = "▼ " + Строка.Корректировка;
		КонецЕсли;

		// Нулевое количество при ненулевой стоимости - корректировка только цены,
		// количество в файле не указано: строка остаётся с прежним количеством
		Если СтрокаУКД.Количество = 0 И СтрокаУКД.Сумма = 0 Тогда
			СтрокиУПД.Удалить(СтрокиУПД.Найти(Строка));
			Счётчики.Убрана = Счётчики.Убрана + 1;
			ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторУПД, СтрШаблон(
				"УКД № %1 от %2, позиция %3 «%4»: ▼ ТОВАР УБРАН - было %5 x %6 = %7, стало 0 (строка найдена %8)",
				СокрЛП(СтрокаУКД.Номер), Формат(СтрокаУКД.Дата, "ДЛФ=D"), СтрокаУКД.НомерПозиции,
				Лев(СокрЛП(СтрокаУКД.Наименование), 80), ЧислоДляТрассы(БылоКоличество), ЧислоДляТрассы(БылаЦена),
				ЧислоДляТрассы(БылаСумма), СпособНайдена));
			Продолжить;
		КонецЕсли;

		Если СтрокаУКД.Количество <> 0 Тогда
			Строка.Количество = СтрокаУКД.Количество;
			Строка.КоличествоДокумента = СтрокаУКД.Количество;
		КонецЕсли;
		Строка.Сумма = СтрокаУКД.Сумма;
		Строка.Цена = ?(Строка.Количество = 0, 0, СтрокаУКД.Сумма / Строка.Количество);

		// Что сделала строка УКД: уменьшение / увеличение количества, только цена, новая строка
		РазницаКоличества = Строка.Количество - БылоКоличество;
		РазницаСуммы = Строка.Сумма - БылаСумма;
		Если НоваяСтрокаУКД Тогда
			Вид = "▲ НОВАЯ СТРОКА (в УПД такой не было)";
			Счётчики.Новая = Счётчики.Новая + 1;
		ИначеЕсли РазницаКоличества < 0 ИЛИ РазницаКоличества = 0 И РазницаСуммы < 0 Тогда
			Вид = ?(РазницаКоличества < 0, "▼ УМЕНЬШЕНИЕ количества", "▼ УМЕНЬШЕНИЕ цены");
			Счётчики.Уменьшение = Счётчики.Уменьшение + 1;
		ИначеЕсли РазницаКоличества > 0 ИЛИ РазницаСуммы > 0 Тогда
			Вид = ?(РазницаКоличества > 0, "▲ УВЕЛИЧЕНИЕ количества", "▲ УВЕЛИЧЕНИЕ цены");
			Счётчики.Увеличение = Счётчики.Увеличение + 1;
		Иначе
			Вид = "без изменений";
			Счётчики.БезИзменений = Счётчики.БезИзменений + 1;
		КонецЕсли;
		// Как определён вид: сравниваем строку УПД «до» (с учётом прежних УКД) и «после» этой УКД
		Если НоваяСтрокаУКД Тогда
			КакОпределено = "строки с таким номером позиции, штрихкодом или наименованием в УПД нет";
		ИначеЕсли РазницаКоличества <> 0 Тогда
			КакОпределено = СтрШаблон("количество %1 -> %2: %3", ЧислоДляТрассы(БылоКоличество),
				ЧислоДляТрассы(Строка.Количество), ?(РазницаКоличества < 0, "меньше - уменьшение", "больше - увеличение"));
		ИначеЕсли РазницаСуммы <> 0 Тогда
			КакОпределено = СтрШаблон("количество то же (%1), сумма с НДС %2 -> %3: %4", ЧислоДляТрассы(Строка.Количество),
				ЧислоДляТрассы(БылаСумма), ЧислоДляТрассы(Строка.Сумма), ?(РазницаСуммы < 0, "цена ниже", "цена выше"));
		Иначе
			КакОпределено = "количество и сумма не изменились";
		КонецЕсли;
		// СтрШаблон принимает не больше 10 параметров - строка собирается из частей
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторУПД, СтрШаблон(
			"УКД № %1 от %2, позиция %3 «%4»: %5 - было %6 x %7 = %8, ",
			СокрЛП(СтрокаУКД.Номер), Формат(СтрокаУКД.Дата, "ДЛФ=D"), СтрокаУКД.НомерПозиции,
			Лев(СокрЛП(СтрокаУКД.Наименование), 80), Вид,
			ЧислоДляТрассы(БылоКоличество), ЧислоДляТрассы(БылаЦена), ЧислоДляТрассы(БылаСумма))
			+ СтрШаблон("стало %1 x %2 = %3 (кол-во %4, сумма %5; признак в файле «%6»; строка УПД найдена %7) | КАК ОПРЕДЕЛЕНО: %8",
			ЧислоДляТрассы(Строка.Количество), ЧислоДляТрассы(Строка.Цена), ЧислоДляТрассы(Строка.Сумма),
			РазницаДляТрассы(РазницаКоличества), РазницаДляТрассы(РазницаСуммы),
			СокрЛП(СтрокаУКД.ПризнакИзменения), ?(НоваяСтрокаУКД, "- нет, добавлена", СпособНайдена), КакОпределено));

	КонецЦикла;

	СуммаПосле = 0;
	Для Каждого СтрокаПосле Из СтрокиУПД Цикл
		СуммаПосле = СуммаПосле + СтрокаПосле.Сумма;
	КонецЦикла;
	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторУПД, СтрШаблон(
		"УКД: итог - уменьшений %1, увеличений %2, убрано товаров %3, новых строк %4, без изменений %5; сумма УПД %6 -> %7 (%8), строк %9",
		Счётчики.Уменьшение, Счётчики.Увеличение, Счётчики.Убрана, Счётчики.Новая, Счётчики.БезИзменений,
		ЧислоДляТрассы(СуммаДо), ЧислоДляТрассы(СуммаПосле), РазницаДляТрассы(СуммаПосле - СуммаДо),
		СтрокиУПД.Количество()));

КонецПроцедуры

// Протокол сверки цепочки - в журнал обмена ЭДО, операция «Сверка», под uid
// приходной и под идентификатором УПД: с чем сверяли, итоги документов, решение,
// каждая строка (что с чем сравнили и результат) и что сверка записала - строки
// в регистр сверки, итог в цепочку и в строку реестра УПД (прочитано обратно).
//
Процедура ЗаписатьПротоколСверкиВЖурнал(Цепочка, ИдентификаторЗаказа, ИдентификаторПоступления, Линии, Итог,
	ИтогиДокументов)

	Попытка

		Строки = Новый Массив;

		НомерУПД = "";
		СтрокаУПД = Неопределено;
		Если ЗначениеЗаполнено(Цепочка.ИдентификаторУПД) Тогда
			СтрокаУПД = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
			СтрокаУПД.ИдентификаторСБИС = Цепочка.ИдентификаторУПД;
			СтрокаУПД.Прочитать();
			Если СтрокаУПД.Выбран() Тогда
				НомерУПД = СтрокаУПД.Номер;
			Иначе
				СтрокаУПД = Неопределено;
			КонецЕсли;
		КонецЕсли;

		Строки.Добавить(СтрШаблон("СВЕРКА приходной %1 (заказ %2) с УПД № %3 (%4); поставщик «%5» ИНН %6",
			ИдентификаторПоступления, ИдентификаторЗаказа, ?(ЗначениеЗаполнено(НомерУПД), НомерУПД, "-"),
			?(ЗначениеЗаполнено(Цепочка.ИдентификаторУПД), Цепочка.ИдентификаторУПД, "УПД не привязана"),
			Цепочка.Поставщик, Цепочка.ИННПоставщика));

		Счётчики = Новый Соответствие;
		Для Каждого Линия Из Линии Цикл
			Счётчики.Вставить(Линия.Результат, ?(Счётчики[Линия.Результат] = Неопределено, 0,
				Счётчики[Линия.Результат]) + 1);
		КонецЦикла;
		ЧастиСчётчиков = Новый Массив;
		Для Каждого КлючЗначение Из Счётчики Цикл
			ЧастиСчётчиков.Добавить(КлючЗначение.Ключ + " " + КлючЗначение.Значение);
		КонецЦикла;
		Строки.Добавить(СтрШаблон("Строк сверки %1: %2", Линии.Количество(), СтрСоединить(ЧастиСчётчиков, ", ")));
		Строки.Добавить(СтрШаблон("Итоги: позиций УПД %1, прихода %2; сумма УПД %3, прихода %4, разница %5; суммы сошлись: %6",
			ИтогиДокументов.ПозицийУПД, ИтогиДокументов.ПозицийПН, ЧислоДляТрассы(ИтогиДокументов.СуммаУПД),
			ЧислоДляТрассы(ИтогиДокументов.СуммаПН), РазницаДляТрассы(ИтогиДокументов.СуммаПН - ИтогиДокументов.СуммаУПД),
			?(Итог.СуммыСошлись, "да", "НЕТ")));
		Строки.Добавить(СтрШаблон("Решение: УПД учтена %1, сошлась по строкам %2, ЭТрН сошлась %3, ожидает УКД %4 -> %5",
			?(Итог.УПДУчтена, "да", "нет"), ?(Итог.УПДСошлась, "да", "нет"), ?(Итог.ЭТрНСошлась, "да", "нет"),
			?(Итог.ОжидаетУКД, "да", "нет"), ?(Итог.ЕстьРасхождения, "ЕСТЬ РАСХОЖДЕНИЯ", "РАСХОЖДЕНИЙ НЕТ")));

		Строки.Добавить("Строки (результат | УПД | приход | пара):");
		Для Каждого Линия Из Линии Цикл
			Строки.Добавить(СтрШаблон("  %1. %2%3 | УПД: %4 | приход: %5 | %6%7 | как решено: %8",
				Линия.НомерСтроки, Линия.Результат, ?(Линия.Критично, " (критично)", ""),
				ТекстСтрокиСверкиДляТрассы(Линия.УПД), ТекстСтрокиСверкиДляТрассы(Линия.Поступление),
				?(ЗначениеЗаполнено(Линия.СпособУПД), Линия.СпособУПД,
					?(ЗначениеЗаполнено(Линия.Способ), Линия.Способ, "пара не найдена")),
				?(ЗначениеЗаполнено(Линия.Комментарий), " - " + Лев(Линия.Комментарий, 200), ""), Линия.Пояснение));
		КонецЦикла;

		Если ЗначениеЗаполнено(Итог.ТекстРасхождений) Тогда
			Строки.Добавить("Текст расхождений:");
			Строки.Добавить(Итог.ТекстРасхождений);
		КонецЕсли;

		// Что записано - читаем обратно из регистров
		Строки.Добавить("ЗАПИСАНО сверкой:");
		Набор = РегистрыСведений.ЭАрМ_СверкаТоваровЦепочки.СоздатьНаборЗаписей();
		Набор.Отбор.ИдентификаторЗаказа.Установить(ИдентификаторЗаказа);
		Набор.Отбор.ИдентификаторПоступления.Установить(ИдентификаторПоступления);
		Набор.Прочитать();
		Строки.Добавить(СтрШаблон("  ЭАрМ_СверкаТоваровЦепочки: строк %1", Набор.Количество()));

		ЗаписьЦепочкиПосле = РегистрыСведений.ЭАрМ_ЦепочкаЗакупки.СоздатьМенеджерЗаписи();
		ЗаписьЦепочкиПосле.ИдентификаторЗаказа = ИдентификаторЗаказа;
		ЗаписьЦепочкиПосле.ИдентификаторПоступления = ИдентификаторПоступления;
		ЗаписьЦепочкиПосле.Прочитать();
		Если ЗаписьЦепочкиПосле.Выбран() Тогда
			Строки.Добавить(СтрШаблон("  ЭАрМ_ЦепочкаЗакупки: этап «%1», есть расхождения %2, дата сверки %3",
				ЗаписьЦепочкиПосле.Этап, ?(ЗаписьЦепочкиПосле.ЕстьРасхождения, "да", "нет"),
				Формат(ЗаписьЦепочкиПосле.ДатаСверки, "ДЛФ=DT")));
		Иначе
			Строки.Добавить("  ЭАрМ_ЦепочкаЗакупки: ЗАПИСИ НЕТ");
		КонецЕсли;

		Если СтрокаУПД <> Неопределено Тогда
			СтрокаУПД.Прочитать();
			Строки.Добавить(СтрШаблон("  Реестр УПД № %1: расхождений нет %2, статус подписания «%3», «К отправке» %4, приход Далиона «%5» на %6",
				СтрокаУПД.Номер, ?(СтрокаУПД.РасхожденийНет, "да", "НЕТ"), СтрокаУПД.СтатусПодписания,
				?(СтрокаУПД.КОтправке, "да", "нет"), СтрокаУПД.НомерДокументаДалион,
				ЧислоДляТрассы(СтрокаУПД.СуммаДокументаДалион)));
			Строки.Добавить("  Текст сверки в реестре УПД: " + СтрЗаменить(СтрокаУПД.ТекстСверки, Символы.ПС, " | "));
		ИначеЕсли ЗначениеЗаполнено(Цепочка.ИдентификаторУПД) Тогда
			Строки.Добавить("  Реестр УПД: строки УПД " + Цепочка.ИдентификаторУПД + " НЕТ - итог записать некуда");
		Иначе
			Строки.Добавить("  Реестр УПД: УПД к приходной не привязана - итог в реестр УПД не пишется");
		КонецЕсли;

		Текст = СтрСоединить(Строки, Символы.ПС);
		ЭАрМ_ПриемПакетовДалион.ЗаписатьВЖурналПодробно(ИдентификаторПоступления, "Сверка", НЕ Итог.ЕстьРасхождения, Текст);
		Если ЗначениеЗаполнено(Цепочка.ИдентификаторУПД) Тогда
			ЭАрМ_ПриемПакетовДалион.ЗаписатьВЖурналПодробно(Цепочка.ИдентификаторУПД, "Сверка",
				НЕ Итог.ЕстьРасхождения, Текст);
		КонецЕсли;

	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторПоступления,
			"ЗаписатьПротоколСверкиВЖурнал (протокол сверки в журнал не записан)", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Строка документа в сверке одной фразой: наименование, кол-во x цена = сумма,
// штрихкод и, если правила УКД, - что было до неё.
//
Функция ТекстСтрокиСверкиДляТрассы(СтрокаДокумента)

	Если СтрокаДокумента = Неопределено Тогда
		Возврат "нет строки";
	КонецЕсли;

	Штрихкоды = Новый Массив;
	Если СтрокаДокумента.Свойство("Штрихкоды") И ТипЗнч(СтрокаДокумента.Штрихкоды) = Тип("Соответствие") Тогда
		Для Каждого КлючЗначение Из СтрокаДокумента.Штрихкоды Цикл
			Штрихкоды.Добавить(КлючЗначение.Ключ);
			Если Штрихкоды.Количество() = 2 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Текст = СтрШаблон("«%1» %2 x %3 = %4%5", Лев(СокрЛП(СтрокаДокумента.Наименование), 60),
		ЧислоДляТрассы(СтрокаДокумента.Количество), ЧислоДляТрассы(СтрокаДокумента.Цена),
		ЧислоДляТрассы(СтрокаДокумента.Сумма),
		?(Штрихкоды.Количество() > 0, " ШК " + СтрСоединить(Штрихкоды, ","), " без ШК"));

	Если СтрокаДокумента.Свойство("Корректировка") И ЗначениеЗаполнено(СтрокаДокумента.Корректировка) Тогда
		Текст = Текст + СтрШаблон(" [%1: было %2 x %3]", СтрокаДокумента.Корректировка,
			ЧислоДляТрассы(СтрокаДокумента.КоличествоДо), ЧислоДляТрассы(СтрокаДокумента.ЦенаДо));
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Как решена цена строки: в допуске по цене, по сумме или расходится - с числами.
//
Функция ПояснениеЦены(ИмяА, ИмяБ, ЦенаА, ЦенаБ, ДопускЦены, ЦенаВДопуске, ЕстьСуммы, СуммаА, СуммаБ,
	РазницаСумм, ДопускСуммы)

	Если ЦенаВДопуске Тогда
		Возврат СтрШаблон("цена %1 %2 и %3 %4 - разница %5 в допуске %6 - цена сошлась", ИмяА, ЧислоДляТрассы(ЦенаА),
			ИмяБ, ЧислоДляТрассы(ЦенаБ), ЧислоДляТрассы(Макс(ЦенаА - ЦенаБ, ЦенаБ - ЦенаА)), ЧислоДляТрассы(ДопускЦены));
	ИначеЕсли ЕстьСуммы И РазницаСумм <= ДопускСуммы Тогда
		Возврат СтрШаблон("цена %1 %2 и %3 %4 не в допуске %5, но суммы строк %6 и %7 (разница %8 в допуске суммы %9) - цена засчитана по сумме",
			ИмяА, ЧислоДляТрассы(ЦенаА), ИмяБ, ЧислоДляТрассы(ЦенаБ), ЧислоДляТрассы(ДопускЦены),
			ЧислоДляТрассы(СуммаА), ЧислоДляТрассы(СуммаБ), ЧислоДляТрассы(РазницаСумм), ЧислоДляТрассы(ДопускСуммы));
	КонецЕсли;

	Возврат СтрШаблон("ЦЕНА РАСХОДИТСЯ: %1 %2 и %3 %4 (допуск %5)%6", ИмяА, ЧислоДляТрассы(ЦенаА), ИмяБ,
		ЧислоДляТрассы(ЦенаБ), ЧислоДляТрассы(ДопускЦены),
		?(ЕстьСуммы, СтрШаблон(", суммы %1 и %2 разошлись на %3 (допуск суммы %4)", ЧислоДляТрассы(СуммаА),
			ЧислоДляТрассы(СуммаБ), ЧислоДляТрассы(РазницаСумм), ЧислоДляТрассы(ДопускСуммы)), ", сумм нет"));

КонецФункции

Функция ТекстВариантовКоличества(Варианты)

	Части = Новый Массив;
	Для Каждого Вариант Из Варианты Цикл
		Части.Добавить(ЧислоДляТрассы(Вариант));
	КонецЦикла;

	Возврат ?(Части.Количество() > 1, "[" + СтрСоединить(Части, " / ") + "]", СтрСоединить(Части, ""));

КонецФункции

// Способ пары строк сверки человеческими словами - по чему строки нашли друг друга.
//
Функция ОписаниеСпособаПары(Способ)

	Описания = Новый Соответствие;
	Описания.Вставить("Штрихкод",           "по штрихкоду: ШК строки прихода совпал со ШК строки УПД");
	Описания.Вставить("Номенклатура",       "по номенклатуре Далиона (один uid номенклатуры)");
	Описания.Вставить("Код",                "по коду номенклатуры");
	Описания.Вставить("КодТовара",          "по коду товара поставщика");
	Описания.Вставить("Артикул",            "по артикулу");
	Описания.Вставить("Наименование",       "по наименованию (совпало после нормализации)");
	Описания.Вставить("НаименованиеПохоже", "по похожему наименованию");
	Описания.Вставить("НазваниеБлизко",     "по близкому названию");
	Описания.Вставить("Словарь",            "по словарю пар наименований");
	Описания.Вставить("Набор",              "набор: несколько строк одной против одной строки другой");
	Описания.Вставить("Вручную",            "сопоставлено вручную");

	Если НЕ ЗначениеЗаполнено(Способ) Тогда
		Возврат "пара не найдена";
	КонецЕсли;
	Описание = Описания.Получить(Способ);

	Возврат ?(Описание = Неопределено, Способ, Описание);

КонецФункции

Функция ЧислоДляТрассы(Значение)

	Возврат Формат(Значение, "ЧДЦ=3; ЧРД=,; ЧН=0; ЧГ=0");

КонецФункции

Функция РазницаДляТрассы(Значение)

	Возврат ?(Значение > 0, "+", "") + Формат(Значение, "ЧДЦ=3; ЧРД=,; ЧН=0; ЧГ=0");

КонецФункции

Функция НайтиСтрокуУПДДляКорректировки(СтрокиУПД, СтрокаУКД, Способ = "")

	Если ЗначениеЗаполнено(СтрокаУКД.НомерПозиции) Тогда
		Для Каждого Кандидат Из СтрокиУПД Цикл
			Если Кандидат.НомерПозиции <> СтрокаУКД.НомерПозиции Тогда
				Продолжить;
			КонецЕсли;
			Если ШтрихкодУКДПодходитКСтроке(Кандидат, СтрокаУКД.Штрихкод) Тогда
				Способ = "по номеру позиции";
				Возврат Кандидат;
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;

	Если ЗначениеЗаполнено(СтрокаУКД.Штрихкод) Тогда
		Для Каждого Кандидат Из СтрокиУПД Цикл
			Если ШтрихкодУКДПодходитКСтроке(Кандидат, СтрокаУКД.Штрихкод)
				И Кандидат.Штрихкоды.Количество() > 0 Тогда
				Способ = "по штрихкоду " + СтрокаУКД.Штрихкод;
				Возврат Кандидат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	НаименованиеНорм = НормализованноеНаименование(СтрокаУКД.Наименование);
	Если ЗначениеЗаполнено(НаименованиеНорм) Тогда
		Для Каждого Кандидат Из СтрокиУПД Цикл
			Если Кандидат.НаименованиеНорм = НаименованиеНорм Тогда
				Способ = "по наименованию";
				Возврат Кандидат;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Кандидат Из СтрокиУПД Цикл
			Если НаименованияСовпадают(Кандидат.Наименование, СтрокаУКД.Наименование) Тогда
				Способ = "по похожему наименованию";
				Возврат Кандидат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Способ = "не найдена";
	Возврат Неопределено;

КонецФункции

Функция ШтрихкодУКДПодходитКСтроке(СтрокаУПД, ШтрихкодУКД)

	Если НЕ ЗначениеЗаполнено(ШтрихкодУКД) ИЛИ СтрокаУПД.Штрихкоды.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого КлючЗначение Из СтрокаУПД.Штрихкоды Цикл
		Если ШтрихкодыСовпадают(КлючЗначение.Ключ, ШтрихкодУКД) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция НоваяСтрока(Источник, Номер)

	Строка = Новый Структура;
	Строка.Вставить("Источник",                  Источник);
	Строка.Вставить("Номер",                     Номер);
	Строка.Вставить("Наименование",              "");
	Строка.Вставить("НаименованиеНорм",          "");
	Строка.Вставить("Код",                       "");
	Строка.Вставить("Артикул",                   "");
	Строка.Вставить("ИдентификаторНоменклатуры", "");
	// Все uid Далиона строки: у штрихкода поставщика бывает несколько
	// карточек. Проход «Номенклатура» ищет пересечение списков, а не
	// равенство одиночных uid (см. ИдентификаторыНоменклатурыСовпадают).
	Строка.Вставить("ИдентификаторыНоменклатуры", Новый Массив);
	Строка.Вставить("Штрихкоды",                 Новый Соответствие);
	Строка.Вставить("СпособШтрихкода",           "");
	Строка.Вставить("Маркирован",                Ложь);
	Строка.Вставить("Маркировки",                Новый Массив);
	Строка.Вставить("НомерПозиции",              0);
	Строка.Вставить("КоличествоДо",              0);
	Строка.Вставить("ЦенаДо",                    0);
	Строка.Вставить("Корректировка",             "");
	Строка.Вставить("Количество",                0);
	Строка.Вставить("КоличествоДокумента",       0);
	Строка.Вставить("Коэффициент",               1);
	Строка.Вставить("ЕдиницаИзмерения",          "");
	Строка.Вставить("Цена",                      0);
	Строка.Вставить("Сумма",                     0);
	Строка.Вставить("СуммаНДС",                  0);
	Строка.Вставить("СтавкаНДС",                 "");
	Строка.Вставить("Использована",              Ложь);
	// Номера строк документа, из которых собрана строка сверки: позиция УПД
	// или ЭТрН, номер товара в пакете Далиона. Реестр товаров хранит их,
	// и форма реестра УПД показывает пары сверки, а не подбирает свои.
	Строка.Вставить("Позиции",                   Новый Массив);
	// Собственный GTIN строки из XML УПД (не подставленный регистром
	// штрихкодов поставщиков) - пара по нему надёжна всегда
	Строка.Вставить("ШтрихкодGTIN",              "");
	// Состав единицы поставщика (набор): uid Далиона -> штук в единице. Задаётся
	// ручной парой; две и больше позиции - строки прихода этих товаров вливаются
	// в линию строки УПД (СклеитьСоставныеСтрокиУПД)
	Строка.Вставить("Состав",                    Неопределено);
	// Признак алкоголя строки УПД из ЭАрМ_ТоварыЭТрН.Алкоголь
	Строка.Вставить("Алкоголь",                  "");

	Возврат Строка;

КонецФункции

Функция КодыМаркировкиВыборки(Маркировки)

	Результат = Новый Массив;
	Если ТипЗнч(Маркировки) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(Маркировки) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Код Из СтрРазделить(Маркировки, Символы.ПС, Ложь) Цикл
		Текст = СокрЛП(Код);
		Если ЗначениеЗаполнено(Текст) Тогда
			Результат.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Штрихкоды строки Далиона: основной штрихкод строки, все barcodes строки
// и карточки номенклатуры.
//
Функция ШтрихкодыСтрокиДалиона(Товар) Экспорт

	Результат = Новый Массив;
	Добавленные = Новый Соответствие;

	Кандидаты = Новый Массив;
	ДобавитьШтрихкодыУзлаВСписок(Кандидаты, Товар);
	ДобавитьШтрихкодыУзлаВСписок(Кандидаты, ЭАрМ_Служебный.ЗначениеУзла(Товар, "nomenclature"));

	Для Каждого Штрихкод Из Кандидаты Цикл
		Если ЗначениеЗаполнено(Штрихкод) И Добавленные.Получить(Штрихкод) = Неопределено Тогда
			Добавленные.Вставить(Штрихкод, Истина);
			Результат.Добавить(Штрихкод);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьШтрихкодыУзлаВСписок(Кандидаты, Узел)

	Кандидаты.Добавить(ЗначениеСтрокой(Узел, "barcode"));
	Для Каждого ОписаниеШтрихкода Из ЭАрМ_Служебный.ЗначениеВМассив(
		ЭАрМ_Служебный.ЗначениеУзла(Узел, "barcodes")) Цикл
		Кандидаты.Добавить(ЗначениеСтрокой(ОписаниеШтрихкода, "barcode"));
		Если ТипЗнч(ОписаниеШтрихкода) = Тип("Строка") Тогда
			Кандидаты.Добавить(СокрЛП(ОписаниеШтрихкода));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ЗаписьРезультата

Процедура ЗаписатьСверку(ИдентификаторЗаказа, ИдентификаторПоступления, Линии)

	НаборЗаписей = РегистрыСведений.ЭАрМ_СверкаТоваровЦепочки.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторЗаказа.Установить(ИдентификаторЗаказа);
	НаборЗаписей.Отбор.ИдентификаторПоступления.Установить(ИдентификаторПоступления);

	// ПЕРЕД записью: сколько строк сверки цепочки лежит сейчас (набор перезапишется целиком)
	НаборЗаписей.Прочитать();
	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
		"Запись: ЭАрМ_СверкаТоваровЦепочки ПЕРЕД записью - в регистре было строк %1, будет %2 (заказ %3)",
		НаборЗаписей.Количество(), Линии.Количество(), ИдентификаторЗаказа));
	НаборЗаписей.Очистить();

	Для Каждого Линия Из Линии Цикл

		Запись = НаборЗаписей.Добавить();
		Запись.ИдентификаторЗаказа      = ИдентификаторЗаказа;
		Запись.ИдентификаторПоступления = ИдентификаторПоступления;
		Запись.ПозицияСверки            = Линия.НомерСтроки;
		Запись.Штрихкод                 = Лев(ОбщийШтрихкод(Линия), 200);
		Запись.СпособСопоставления      = Лев(Линия.Способ, 20);
		Запись.Результат                = Лев(Линия.Результат, 30);
		Запись.Комментарий              = Лев(Линия.Комментарий, 500);

		Если Линия.Заказ <> Неопределено Тогда
			Запись.НоменклатураЗаказа = Лев(Линия.Заказ.Наименование, 500);
			Запись.КоличествоЗаказа   = Линия.Заказ.Количество;
			Запись.ЦенаЗаказа         = Линия.Заказ.Цена;
		КонецЕсли;
		Если Линия.Поступление <> Неопределено Тогда
			Запись.НоменклатураПоступления = Лев(Линия.Поступление.Наименование, 500);
			Запись.КоличествоПоступления   = Линия.Поступление.Количество;
			Запись.ЦенаПоступления         = Линия.Поступление.Цена;
		КонецЕсли;
		Если Линия.УПД <> Неопределено Тогда
			Запись.НаименованиеУПД = Лев(Линия.УПД.Наименование, 500);
			Запись.КоличествоУПД   = Линия.УПД.Количество;
			Запись.ЦенаУПД         = Линия.УПД.Цена;
		КонецЕсли;
		Если Линия.ЭТрН <> Неопределено Тогда
			Запись.НаименованиеЭТрН = Лев(Линия.ЭТрН.Наименование, 500);
			Запись.КоличествоЭТрН   = Линия.ЭТрН.Количество;
		КонецЕсли;

	КонецЦикла;

	НаборЗаписей.Записать(Истина);

	СЭТрН = 0;
	Для Каждого Линия Из Линии Цикл
		Если Линия.ЭТрН <> Неопределено Тогда
			СЭТрН = СЭТрН + 1;
		КонецЕсли;
	КонецЦикла;
	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
		"Запись: ЭАрМ_СверкаТоваровЦепочки - строк %1 (из них со строкой ЭТрН %2)", Линии.Количество(), СЭТрН));

	// Набор читаем обратно: строк в регистре должно быть столько, сколько записали
	ЭАрМ_ПриемПакетовДалион.ПроверитьЗаписьРегистра(ИдентификаторПоступления, "ЭАрМ_СверкаТоваровЦепочки",
		Новый Структура("ИдентификаторЗаказа, ИдентификаторПоступления", ИдентификаторЗаказа, ИдентификаторПоступления),
		Неопределено, Линии.Количество());

КонецПроцедуры

// Копит пары, которые сошлись по имени, оценке или словарю, и по
// количеству/цене. Ключ - общие основы + вес. Регистр читается при следующей
// сверке (способ «Словарь»).
//
Процедура ЗапомнитьПарыПоИмени(Линии)

	Для Каждого Линия Из Линии Цикл

		Способ = Линия.Способ;
		Если Способ <> "Наименование" И Способ <> "НаименованиеПохоже"
			И Способ <> "НазваниеБлизко" И Способ <> "Словарь" Тогда
			Способ = Линия.СпособУПД;
		КонецЕсли;
		Если Способ <> "Наименование" И Способ <> "НаименованиеПохоже"
			И Способ <> "НазваниеБлизко" И Способ <> "Словарь" Тогда
			Продолжить;
		КонецЕсли;
		Если Линия.Результат <> "Совпадает" Тогда
			Продолжить;
		КонецЕсли;

		СтрокаДалиона = ?(Линия.Заказ <> Неопределено, Линия.Заказ, Линия.Поступление);
		Если СтрокаДалиона = Неопределено ИЛИ Линия.УПД = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИмяДалион = СокрЛП(СтрокаДалиона.Наименование);
		ИмяЭДО    = СокрЛП(Линия.УПД.Наименование);
		Если НЕ ЗначениеЗаполнено(ИмяДалион) ИЛИ НЕ ЗначениеЗаполнено(ИмяЭДО) Тогда
			Продолжить;
		КонецЕсли;

		КлючПары = КлючПарыПоИмени(ИмяДалион, ИмяЭДО);
		Если НЕ ЗначениеЗаполнено(КлючПары) Тогда
			Продолжить;
		КонецЕсли;

		ХешИмен = ХешИменПары(ИмяДалион, ИмяЭДО);

		РазборА = РазборНаименованияДляСлов(ИмяДалион);
		РазборБ = РазборНаименованияДляСлов(ИмяЭДО);
		ОбщиеСлова = ПересечениеСтрок(РазборА.Слова, РазборБ.Слова);
		ОбщиеВеса  = ПересечениеСтрок(РазборА.Веса, РазборБ.Веса);

		Попытка
			Запись = РегистрыСведений.ЭАрМ_ПарыНоменклатурыПоИмени.СоздатьМенеджерЗаписи();
			Запись.КлючПары = КлючПары;
			Запись.ХешИмен  = ХешИмен;
			Запись.Прочитать();
			НовыйСвязка = НЕ Запись.Выбран();
			Если НовыйСвязка Тогда
				Запись.КлючПары = КлючПары;
				Запись.ХешИмен  = ХешИмен;
				Запись.КоличествоНаходок = 0;
			КонецЕсли;
			Запись.НаименованиеДалион = Лев(ИмяДалион, 500);
			Запись.НаименованиеЭДО    = Лев(ИмяЭДО, 500);
			Запись.Способ             = Лев(Способ, 20);
			Запись.СовпавшиеСлова     = Лев(СтрСоединить(ОбщиеСлова, " "), 200);
			Запись.Вес                = Лев(СтрСоединить(ОбщиеВеса, " "), 50);
			Запись.Количество         = ?(Линия.УПД <> Неопределено, Линия.УПД.Количество, СтрокаДалиона.Количество);
			Запись.ЦенаДалион         = СтрокаДалиона.Цена;
			Запись.ЦенаЭДО            = Линия.УПД.Цена;
			Запись.Штрихкод           = Лев(ОбщийШтрихкод(Линия), 200);
			Запись.КоличествоНаходок  = Запись.КоличествоНаходок + 1;
			Запись.ДатаОбновления     = ТекущаяДатаСеанса();
			Запись.Записать(Истина);
			// Новая связка по имени - штрихкод общей строки запрашиваем у Далиона
			Если НовыйСвязка Тогда
				ЭАрМ_КатегорииТоваров.ПоставитьВОчередьЗапросаДалиона(Запись.Штрихкод);
			КонецЕсли;
		Исключение
			// Сверку из-за сборщика пар не останавливаем, но обрыв пишем в лог:
			// раньше здесь было молчание, и несохранённые пары не были видны
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"ЗапомнитьПарыПоИмени (пара не записана в ЭАрМ_ПарыНоменклатурыПоИмени)", ИнформацияОбОшибке());
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Удачная пара УПД-Далион учит ЭАрМ_ШтрихкодыПоставщиков: имя поставщика
// получает штрихкод, следующая УПД без GTIN в XML найдёт его через
// НазначитьШтрихкоды. Пишем:
//   * сошлось по штрихкоду - даже если у УПД GTIN уже был (раньше такие
//     строки пропускались, и словарь не пополнялся);
//   * код / артикул / uid, если у Далиона есть штрихкод;
//   * уверенное имя (точное, похожее от 0.8, словарь пар), если у Далиона
//     есть штрихкод.
// Мягкий прогон «НазваниеБлизко» и пары только по сумме не пишем.
// В регистр уходит предпочтительный штрихкод (EAN, не внутренний «2…»),
// плюс GTIN УПД, если он другой.
//
Процедура ЗапомнитьШтрихкодыИзСверки(Линии, Цепочка)

	Записано = 0;

	Для Каждого Линия Из Линии Цикл

		Если Линия.УПД = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Способ = Линия.СпособУПД;
		Если НЕ ЗначениеЗаполнено(Способ) Тогда
			Способ = Линия.Способ;
		КонецЕсли;
		Если НЕ СпособУчитШтрихкодПоставщика(Способ) Тогда
			Продолжить;
		КонецЕсли;

		// Пара с расхождением количества или цены - всё равно тот же товар,
		// если связана надёжно (штрихкод, номенклатура, код, артикул, точное
		// имя). Раньше словарь учился только на сошедшихся строках и пополнялся
		// медленно. Похожие имена и словарь пар - только при полном совпадении
		Если Линия.Результат <> "Совпадает" И НЕ НадёжныйСпособСвязи(Способ) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаДалиона = ?(Линия.Заказ <> Неопределено, Линия.Заказ, Линия.Поступление);
		Если СтрокаДалиона = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИмяПоставщика = СокрЛП(Линия.УПД.Наименование);
		Если НЕ ЗначениеЗаполнено(ИмяПоставщика) Тогда
			Продолжить;
		КонецЕсли;

		ЕстьШтрихкодДалиона = СтрокаДалиона.Штрихкоды.Количество() > 0;
		Если Способ <> "Штрихкод" И НЕ ЕстьШтрихкодДалиона Тогда
			Продолжить;
		КонецЕсли;

		Штрихкоды = Новый Массив;
		ДобавитьУникальныйШтрихкод(Штрихкоды, ПредпочтительныйШтрихкод(СтрокаДалиона.Штрихкоды));
		ДобавитьУникальныйШтрихкод(Штрихкоды, ПредпочтительныйШтрихкод(Линия.УПД.Штрихкоды));
		Если Штрихкоды.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Штрихкод Из Штрихкоды Цикл

			Описание = НовоеОписаниеШтрихкода();
			Описание.Штрихкод                        = Штрихкод;
			Описание.НаименованиеПоставщика          = ИмяПоставщика;
			Описание.ИННПоставщика                   = Цепочка.ИННПоставщика;
			Описание.Поставщик                       = Цепочка.Поставщик;
			Описание.КодТовараПоставщика             = Линия.УПД.Код;
			Описание.НоменклатураДалион              = СтрокаДалиона.Наименование;
			Описание.КодНоменклатурыДалион           = СтрокаДалиона.Код;
			Описание.ИдентификаторНоменклатурыДалион = СтрокаДалиона.ИдентификаторНоменклатуры;
			Описание.Источник                        = "Сверка";

			ЗаписатьШтрихкод(Описание);
			Записано = Записано + 1;

		КонецЦикла;

	КонецЦикла;

	ЭАрМ_ПриемПакетовДалион.Трасса(Цепочка.ИдентификаторУПД, СтрШаблон(
		"Запись: ЭАрМ_ШтрихкодыПоставщиков из сверки - записано штрихкодов %1 (строк сверки %2)",
		Записано, Линии.Количество()));

КонецПроцедуры

Функция НадёжныйСпособСвязи(Способ)

	Возврат Способ = "Штрихкод"
		ИЛИ Способ = "Номенклатура"
		ИЛИ Способ = "Код"
		ИЛИ Способ = "Артикул"
		ИЛИ Способ = "Наименование";

КонецФункции

Функция СпособУчитШтрихкодПоставщика(Способ)

	Возврат Способ = "Штрихкод"
		ИЛИ Способ = "Номенклатура"
		ИЛИ Способ = "Код"
		ИЛИ Способ = "Артикул"
		ИЛИ Способ = "Наименование"
		ИЛИ Способ = "НаименованиеПохоже"
		ИЛИ Способ = "Словарь";

КонецФункции

Процедура ДобавитьУникальныйШтрихкод(Штрихкоды, Штрихкод)

	Текст = СокрЛП(Штрихкод);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат;
	КонецЕсли;
	Если Штрихкоды.Найти(Текст) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Штрихкоды.Добавить(Текст);

КонецПроцедуры

Функция ОбщийШтрихкод(Линия)

	Для Каждого Строка Из ЗначениеВМассиве(Линия.УПД, Линия.Поступление, Линия.Заказ) Цикл
		Штрихкод = ПредпочтительныйШтрихкод(Строка.Штрихкоды);
		Если ЗначениеЗаполнено(Штрихкод) Тогда
			Возврат Штрихкод;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЛучшееНаименование(Линия)

	Для Каждого Строка Из ЗначениеВМассиве(Линия.Заказ, Линия.Поступление, Линия.УПД, Линия.ЭТрН) Цикл
		Если ЗначениеЗаполнено(Строка.Наименование) Тогда
			Возврат Строка.Наименование;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

#КонецОбласти

#Область ШтрихкодыПоставщиков

// Пополняет ЭАрМ_ШтрихкодыПоставщиков товарами, которые к нам поступили, по
// реестру товаров (итог сверки цепочек). Сверка сама учит регистр только
// сошедшимися линиями («Совпадает»), и товар, пришедший с расхождением по
// количеству или цене, в регистр не попадал, хотя пара найдена надёжно.
//
// Берутся линии с приходом (КоличествоПН > 0) и штрихкодом линии. Пишется:
//   * наименование поставщика из строк УПД линии (ПозицииУПД), если пара с
//     УПД надёжная - штрихкод, номенклатура, код, артикул, имя;
//   * наименование Далиона, если строки УПД нет или пара слабая (по сумме,
//     по цене и количеству) - так штрихкод хотя бы свяжется с номенклатурой.
// Дублей нет: запись пропускается, если в регистре уже есть этот штрихкод
// (в любом написании GTIN) с тем же ключом наименования.
//
// Возвращаемое значение:
//   Структура - Линий, Добавлено, УжеЕсть, БезШтрихкода
//
Функция ЗагрузитьШтрихкодыИзРеестраТоваров(ТолькоПросмотр = Ложь) Экспорт

	Итоги = Новый Структура("Линий, Добавлено, УжеЕсть, БезШтрихкода, Предпросмотр", 0, 0, 0, 0, Новый Массив);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реестр.Номенклатура КАК Номенклатура,
	|	Реестр.КодНоменклатуры КАК КодНоменклатуры,
	|	Реестр.ИдентификаторНоменклатуры КАК ИдентификаторНоменклатуры,
	|	Реестр.Штрихкод КАК Штрихкод,
	|	Реестр.ИННПоставщика КАК ИННПоставщика,
	|	Реестр.Поставщик КАК Поставщик,
	|	Реестр.ИдентификаторУПД КАК ИдентификаторУПД,
	|	Реестр.ПозицииУПД КАК ПозицииУПД,
	|	Реестр.СпособСопоставления КАК СпособСопоставления
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр
	|ГДЕ
	|	Реестр.КоличествоПН > 0
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.КлючНаименования КАК КлючНаименования
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды";

	Результаты = Запрос.ВыполнитьПакет();
	Линии = Результаты[0].Выгрузить();

	// Что уже есть в регистре: канон штрихкода | ключ наименования
	Есть = Новый Соответствие;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Есть.Вставить(КлючЗаписиШтрихкода(Выборка.Штрихкод, Выборка.КлючНаименования), Истина);
	КонецЦикла;

	СтрокиУПД = СтрокиУПДДляРеестра(Линии);

	Для Каждого Линия Из Линии Цикл

		Итоги.Линий = Итоги.Линий + 1;

		Штрихкод = СокрЛП(Линия.Штрихкод);
		Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
			Итоги.БезШтрихкода = Итоги.БезШтрихкода + 1;
			Продолжить;
		КонецЕсли;

		// Наименования, под которыми товар придёт в следующий раз
		Имена = Новый Массив;
		Если СпособУчитШтрихкодПоставщика(СокрЛП(Линия.СпособСопоставления)) Тогда
			Для Каждого Часть Из СтрРазделить(СокрЛП(Линия.ПозицииУПД), ";", Ложь) Цикл
				СтрокаУПД = СтрокиУПД.Получить(СокрЛП(Линия.ИдентификаторУПД) + "|" + СокрЛП(Часть));
				Если СтрокаУПД <> Неопределено Тогда
					Имена.Добавить(СтрокаУПД);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Имена.Количество() = 0 И ЗначениеЗаполнено(Линия.Номенклатура) Тогда
			Имена.Добавить(Новый Структура("Наименование, Код", СокрЛП(Линия.Номенклатура), ""));
		КонецЕсли;

		Для Каждого Имя Из Имена Цикл

			КлючИмени = КлючНаименования(Имя.Наименование);
			Если НЕ ЗначениеЗаполнено(КлючИмени) Тогда
				Продолжить;
			КонецЕсли;
			КлючЗаписи = КлючЗаписиШтрихкода(Штрихкод, КлючИмени);
			Если Есть.Получить(КлючЗаписи) <> Неопределено Тогда
				Итоги.УжеЕсть = Итоги.УжеЕсть + 1;
				Продолжить;
			КонецЕсли;
			Есть.Вставить(КлючЗаписи, Истина);

			Описание = НовоеОписаниеШтрихкода();
			Описание.Штрихкод                        = Штрихкод;
			Описание.НаименованиеПоставщика          = Имя.Наименование;
			Описание.ИННПоставщика                   = Линия.ИННПоставщика;
			Описание.Поставщик                       = Линия.Поставщик;
			Описание.КодТовараПоставщика             = Имя.Код;
			Описание.НоменклатураДалион              = Линия.Номенклатура;
			Описание.КодНоменклатурыДалион           = Линия.КодНоменклатуры;
			Описание.ИдентификаторНоменклатурыДалион = Линия.ИдентификаторНоменклатуры;
			Описание.Источник                        = "РеестрТоваров";

			Если ТолькоПросмотр Тогда
				Итоги.Предпросмотр.Добавить(Описание);
			Иначе
				ЗаписатьШтрихкод(Описание);
			КонецЕсли;
			Итоги.Добавлено = Итоги.Добавлено + 1;

		КонецЦикла;

	КонецЦикла;

	Возврат Итоги;

КонецФункции

// Штрихкоды, пришедшие в самих УПД (GTIN из XML), - в регистр штрихкодов
// поставщиков, если их там нет: следующая УПД этого поставщика без GTIN
// найдёт товар по наименованию или коду. Штрихкоды, которые строке УПД
// подставил сам регистр, не переписываются.
//
// Параметры:
//   ИдентификаторУПД - Строка - одна УПД; пустая - все УПД реестра
//
// Возвращаемое значение:
//   Структура - Строк, Добавлено, УжеЕсть
//
Функция ДобавитьШтрихкодыИзУПД(ИдентификаторУПД = "", ТолькоПросмотр = Ложь) Экспорт

	Итоги = Новый Структура("Строк, Добавлено, УжеЕсть, Предпросмотр", 0, 0, 0, Новый Массив);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Наименование КАК Наименование,
	|	Товары.Штрихкод КАК Штрихкод,
	|	Товары.КодТовараПоставщика КАК КодТовараПоставщика,
	|	Товары.СпособПоискаШК КАК СпособПоискаШК,
	|	Товары.Маркировки КАК Маркировки,
	|	ЕСТЬNULL(УПД.ИННКонтрагента, """") КАК ИННПоставщика,
	|	ЕСТЬNULL(УПД.Контрагент, """") КАК Поставщик
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО Товары.ИдентификаторСБИС = УПД.ИдентификаторСБИС
	|ГДЕ
	|	Товары.ИсточникТоваров = ""УПД""
	|	И (Товары.СпособПоискаШК = ""GTIN""
	|				И Товары.Штрихкод <> """"
	|			ИЛИ Товары.Маркировок > 0)
	|	И (&ВсеУПД ИЛИ Товары.ИдентификаторСБИС = &ИдентификаторУПД)";
	Запрос.УстановитьПараметр("ВсеУПД", НЕ ЗначениеЗаполнено(ИдентификаторУПД));
	Запрос.УстановитьПараметр("ИдентификаторУПД", СтрокаИлиПусто(ИдентификаторУПД));

	Строки = Запрос.Выполнить().Выгрузить();

	// Штрихкод строки: GTIN из XML, а если его нет - GTIN из кода маркировки
	// (Честный знак: 01 + 14 цифр). Многие поставщики не пишут штрихкод в
	// строку УПД, но марки передают - товар всё равно можно запомнить
	Строки.Колонки.Добавить("ИсточникЗаписи", Новый ОписаниеТипов("Строка"));
	Для Индекс = -(Строки.Количество() - 1) По 0 Цикл
		Строка = Строки[-Индекс];
		Если Строка.СпособПоискаШК = "GTIN" И ЗначениеЗаполнено(Строка.Штрихкод) Тогда
			Строка.ИсточникЗаписи = "УПД";
			Продолжить;
		КонецЕсли;
		Строка.Штрихкод = ШтрихкодИзМаркировок(Строка.Маркировки);
		Если ЗначениеЗаполнено(Строка.Штрихкод) Тогда
			Строка.ИсточникЗаписи = "УПДМаркировка";
		Иначе
			Строки.Удалить(Строка);
		КонецЕсли;
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		Возврат Итоги;
	КонецЕсли;

	// Что уже есть в регистре - только по штрихкодам этих строк, во всех
	// написаниях GTIN: при записи товаров одной УПД весь регистр не читаем
	Варианты = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Для Каждого КлючЗначение Из КлючиШтрихкода(Строка.Штрихкод) Цикл
			Варианты.Добавить(Лев(КлючЗначение.Ключ, 200));
		КонецЦикла;
	КонецЦикла;

	ЗапросЕсть = Новый Запрос;
	ЗапросЕсть.Текст =
	"ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.КлючНаименования КАК КлючНаименования
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод В (&Варианты)";
	ЗапросЕсть.УстановитьПараметр("Варианты", Варианты);

	Есть = Новый Соответствие;
	ВыборкаЕсть = ЗапросЕсть.Выполнить().Выбрать();
	Пока ВыборкаЕсть.Следующий() Цикл
		Есть.Вставить(КлючЗаписиШтрихкода(ВыборкаЕсть.Штрихкод, ВыборкаЕсть.КлючНаименования), Истина);
	КонецЦикла;

	Для Каждого Выборка Из Строки Цикл

		Итоги.Строк = Итоги.Строк + 1;

		КлючИмени = КлючНаименования(Выборка.Наименование);
		Если НЕ ЗначениеЗаполнено(КлючИмени) Тогда
			Продолжить;
		КонецЕсли;

		КлючЗаписи = КлючЗаписиШтрихкода(Выборка.Штрихкод, КлючИмени);
		Если Есть.Получить(КлючЗаписи) <> Неопределено Тогда
			Итоги.УжеЕсть = Итоги.УжеЕсть + 1;
			Продолжить;
		КонецЕсли;
		Есть.Вставить(КлючЗаписи, Истина);

		Описание = НовоеОписаниеШтрихкода();
		Описание.Штрихкод               = СокрЛП(Выборка.Штрихкод);
		Описание.НаименованиеПоставщика = СокрЛП(Выборка.Наименование);
		Описание.ИННПоставщика          = СокрЛП(Выборка.ИННПоставщика);
		Описание.Поставщик              = СокрЛП(Выборка.Поставщик);
		Описание.КодТовараПоставщика    = СокрЛП(Выборка.КодТовараПоставщика);
		Описание.Источник               = Выборка.ИсточникЗаписи;

		Если ТолькоПросмотр Тогда
			Итоги.Предпросмотр.Добавить(Описание);
		Иначе
			ЗаписатьШтрихкод(Описание);
		КонецЕсли;
		Итоги.Добавлено = Итоги.Добавлено + 1;

	КонецЦикла;

	Возврат Итоги;

КонецФункции

// EAN-13 (или GTIN-14, если он не с нуля) из первого кода маркировки строки,
// в котором есть GTIN. Пустая строка - GTIN в марках нет.
//
Функция ШтрихкодИзМаркировок(Маркировки)

	Для Каждого Код Из СтрРазделить(СтрокаИлиПусто(Маркировки), Символы.ПС, Ложь) Цикл
		Попытка
			Разбор = ЭАрМ_КодыМаркировки.РазобратьКод(Код);
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"ШтрихкодИзМаркировок (код маркировки не разобран - пропущен)", ОшибкаИсключения);
			Продолжить;
		КонецПопытки;
		GTIN = СокрЛП(Разбор.GTIN);
		Если СтрДлина(GTIN) = 14 И СтрНачинаетсяС(GTIN, "0") Тогда
			Возврат Сред(GTIN, 2);
		ИначеЕсли ЗначениеЗаполнено(GTIN) Тогда
			Возврат GTIN;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Ключ записи регистра штрихкодов без учёта написания GTIN (13 или 14 цифр,
// ведущие нули) - чтобы один штрихкод не лёг дважды.
//
Функция КлючЗаписиШтрихкода(Штрихкод, КлючНаименования)

	Канон = КаноническийШтрихкод(Штрихкод);
	Если НЕ ЗначениеЗаполнено(Канон) Тогда
		Канон = ВРег(СокрЛП(СтрокаИлиПусто(Штрихкод)));
	КонецЕсли;

	Возврат Канон + "|" + СокрЛП(СтрокаИлиПусто(КлючНаименования));

КонецФункции

// Наименования и коды строк УПД, попавших в линии реестра, одним запросом.
//
// Возвращаемое значение:
//   Соответствие - "ИдентификаторУПД|НомерПозиции" -> Структура (Наименование, Код)
//
Функция СтрокиУПДДляРеестра(Линии)

	Результат = Новый Соответствие;

	Идентификаторы = Новый Массив;
	Для Каждого Линия Из Линии Цикл
		Если ЗначениеЗаполнено(Линия.ИдентификаторУПД) И ЗначениеЗаполнено(Линия.ПозицииУПД)
			И Идентификаторы.Найти(Линия.ИдентификаторУПД) = Неопределено Тогда
			Идентификаторы.Добавить(Линия.ИдентификаторУПД);
		КонецЕсли;
	КонецЦикла;

	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.Наименование КАК Наименование,
	|	Товары.КодТовараПоставщика КАК КодТовараПоставщика,
	|	Товары.КодНоменклатуры КАК КодНоменклатуры
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС В (&Идентификаторы)
	|	И Товары.ИсточникТоваров = ""УПД""";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Наименование) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(СокрЛП(Выборка.ИдентификаторСБИС) + "|" + Формат(Выборка.НомерПозиции, "ЧГ=0"),
			Новый Структура("Наименование, Код", СокрЛП(Выборка.Наименование),
				СокрЛП(?(ЗначениеЗаполнено(Выборка.КодТовараПоставщика),
					Выборка.КодТовараПоставщика, Выборка.КодНоменклатуры))));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ручная пара из дерева реестра УПД: строке УПД без пары человек выбрал
// строку прихода Далиона. Пара ложится в регистр штрихкодов поставщиков,
// чтобы дальше находиться сама - в этой цепочке и в следующих поставках:
//   - штрихкоды строки прихода под наименованием поставщика (ключ имени
//     строки УПД) - НазначитьШтрихкоды отдаст их строкам УПД без GTIN;
//   - собственные штрихкоды строки УПД (GTIN из XML) с номенклатурой
//     Далиона - строка УПД со своим GTIN свяжется по uid/коду номенклатуры.
// После записи штрихкоды назначаются заново и открытые цепочки УПД
// пересверяются обычными правилами (пары по названию не снимаются).
//
// Параметры:
//   ИдентификаторУПД - Строка
//   СтрокаУПД        - Структура - Наименование, КодТовараПоставщика,
//                      Штрихкоды (Строка через ";")
//   СтрокаПрихода    - Структура - Наименование, Штрихкоды (Строка через ";"),
//                      КлючиНоменклатуры (Строка "uid:..;код:..")
//   ИННПоставщика    - Строка
//   Поставщик        - Строка
//   Принудительно    - Булево - перед записью убрать записи регистра, которые
//                      спорят с выбранной номенклатурой Далиона (см.
//                      УдалитьСпорныеЗаписиПары)
//
// Возвращаемое значение:
//   Структура:
//     * Успех - Булево
//     * Текст - Строка - итог для пользователя
//
// Строка УПД в единицах поставщика (коробка, набор) -> штуки Далиона по ручной паре:
// количество умножается на штук в единице, цена делится. Так сверка сравнивает
// штуки со штуками. Набор из нескольких товаров запоминается в Состав.
//
Процедура ПрименитьКратностьПоставщика(Строка, Кратности)

	Если Строка.Источник <> "УПД" ИЛИ ТипЗнч(Кратности) <> Тип("Соответствие")
		ИЛИ Кратности.Количество() = 0 ИЛИ Строка.Коэффициент > 1 Тогда
		Возврат;
	КонецЕсли;

	Всего = 0;
	Для Каждого КлючЗначение Из Кратности Цикл
		Всего = Всего + КлючЗначение.Значение;
	КонецЦикла;
	Если Всего <= 0 ИЛИ Всего = 1 И Кратности.Количество() = 1 Тогда
		Возврат;
	КонецЕсли;

	Строка.КоличествоДокумента = Строка.Количество;
	Строка.Коэффициент = Всего;
	Строка.Количество = Строка.Количество * Всего;
	Если Строка.Цена <> 0 Тогда
		Строка.Цена = Строка.Цена / Всего;
	КонецЕсли;
	Если Кратности.Количество() > 1 Тогда
		Строка.Состав = Кратности;
	КонецЕсли;

КонецПроцедуры

// Набор поставщика: строка УПД, в которую по ручной паре входит несколько товаров
// Далиона. Строки прихода этих товаров, оставшиеся без УПД, вливаются в её линию:
// сверяются сумма и штуки набора целиком.
//
Процедура СклеитьСоставныеСтрокиУПД(Линии)

	Индекс = 0;
	Пока Индекс < Линии.Количество() Цикл

		Линия = Линии[Индекс];
		Состав = Неопределено;
		Если Линия.УПД <> Неопределено Тогда
			Линия.УПД.Свойство("Состав", Состав);
		КонецЕсли;
		Если ТипЗнч(Состав) <> Тип("Соответствие") ИЛИ Состав.Количество() < 2 Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Другая = Линии.Количество() - 1;
		Пока Другая >= 0 Цикл
			ЛинияПрихода = Линии[Другая];
			Если Другая <> Индекс И ЛинияПрихода.УПД = Неопределено И ЛинияПрихода.Поступление <> Неопределено
				И Состав.Получить(ЛинияПрихода.Поступление.ИдентификаторНоменклатуры) <> Неопределено Тогда
				Линия.Поступление = СложитьСтрокиДокумента(Линия.Поступление, ЛинияПрихода.Поступление);
				Линия.Заказ = СложитьСтрокиДокумента(Линия.Заказ, ЛинияПрихода.Заказ);
				Линии.Удалить(Другая);
				Если Другая < Индекс Тогда
					Индекс = Индекс - 1;
				КонецЕсли;
			КонецЕсли;
			Другая = Другая - 1;
		КонецЦикла;

		Если НЕ ЗначениеЗаполнено(Линия.СпособУПД) Тогда
			Линия.СпособУПД = "Набор";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Линия.Способ) Тогда
			Линия.Способ = "Набор";
		КонецЕсли;
		Индекс = Индекс + 1;

	КонецЦикла;

КонецПроцедуры

Функция СвязатьСтрокуУПДСПриходом(ИдентификаторУПД, СтрокаУПД, СтрокаПрихода,
	ИННПоставщика = "", Поставщик = "", Принудительно = Ложь) Экспорт

	Результат = Новый Структура("Успех, Текст", Ложь, "");

	НаименованиеУПД = СокрЛП(СтрокаИлиПусто(СтрокаУПД.Наименование));
	Если НЕ ЗначениеЗаполнено(КлючНаименования(НаименованиеУПД)) Тогда
		Результат.Текст = НСтр("ru = 'У строки УПД нет наименования - связать не по чему'");
		Возврат Результат;
	КонецЕсли;

	ШтрихкодыПрихода = СписокИзСтроки(СтрокаПрихода.Штрихкоды);
	ШтрихкодыУПД     = СписокИзСтроки(СтрокаУПД.Штрихкоды);

	Уид = "";
	КодДалион = "";
	Для Каждого Ключ Из СписокИзСтроки(СтрокаПрихода.КлючиНоменклатуры) Цикл
		Если СтрНачинаетсяС(Ключ, "uid:") И НЕ ЗначениеЗаполнено(Уид) Тогда
			Уид = Сред(Ключ, 5);
		ИначеЕсли СтрНачинаетсяС(Ключ, "код:") И НЕ ЗначениеЗаполнено(КодДалион) Тогда
			КодДалион = Сред(Ключ, 5);
		КонецЕсли;
	КонецЦикла;

	Если ШтрихкодыПрихода.Количество() = 0 И НЕ ЗначениеЗаполнено(Уид + КодДалион) Тогда
		Результат.Текст = НСтр("ru = 'У строки прихода Далиона нет ни штрихкода, ни номенклатуры Далиона (uid или кода): связать строку УПД не с чем'");
		Возврат Результат;
	КонецЕсли;

	// Штрихкода нет ни у прихода, ни у строки УПД, но номенклатура Далиона
	// известна. Раньше здесь был отказ, и такую пару было не записать вовсе,
	// хотя сверка находит запись регистра и по наименованию поставщика и
	// сводит строки по uid или коду (СведенияШтрихкодовПоставщика). Берём
	// настоящие штрихкоды этой номенклатуры из регистра, а если их нет -
	// ключ без штрихкода
	БезШтрихкода = Ложь;
	Если ШтрихкодыПрихода.Количество() = 0 И ШтрихкодыУПД.Количество() = 0 Тогда
		ШтрихкодыПрихода = ШтрихкодыНоменклатурыДалион(Уид, КодДалион);
		Если ШтрихкодыПрихода.Количество() = 0 Тогда
			ШтрихкодыПрихода.Добавить(КлючБезШтрихкода(Уид, КодДалион));
			БезШтрихкода = Истина;
		КонецЕсли;
	КонецЕсли;

	// Штук Далиона в единице УПД: по количествам пары в документах (УПД 2 коробки,
	// приход 24 штуки - 12). Набор: вторая пара той же строки УПД с другим товаром
	// прихода даёт свою долю
	КоличествоВЕдинице = 0;
	Если СтрокаУПД.Свойство("Количество") И СтрокаПрихода.Свойство("Количество")
		И ТипЗнч(СтрокаУПД.Количество) = Тип("Число") И ТипЗнч(СтрокаПрихода.Количество) = Тип("Число")
		И СтрокаУПД.Количество > 0 И СтрокаПрихода.Количество > 0 Тогда
		Отношение = Окр(СтрокаПрихода.Количество / СтрокаУПД.Количество, 3);
		Если Отношение <> 1 Тогда
			КоличествоВЕдинице = Отношение;
		КонецЕсли;
	КонецЕсли;

	Записано = 0;
	УдаленоСпорных = 0;

	НачатьТранзакцию();
	Попытка

		Если Принудительно Тогда
			НовыеШтрихкоды = Новый Массив;
			Для Каждого Штрихкод Из ШтрихкодыПрихода Цикл
				НовыеШтрихкоды.Добавить(Штрихкод);
			КонецЦикла;
			Для Каждого Штрихкод Из ШтрихкодыУПД Цикл
				НовыеШтрихкоды.Добавить(Штрихкод);
			КонецЦикла;
			УдаленоСпорных = УдалитьСпорныеЗаписиПары(КлючНаименования(НаименованиеУПД),
				СокрЛП(СтрокаИлиПусто(ИННПоставщика)), ШтрихкодыУПД, НовыеШтрихкоды, Уид, КодДалион);
		КонецЕсли;

		Для Каждого Штрихкод Из ШтрихкодыПрихода Цикл
			Описание = НовоеОписаниеШтрихкода();
			Описание.Штрихкод                        = Штрихкод;
			Описание.НаименованиеПоставщика          = НаименованиеУПД;
			Описание.ИННПоставщика                   = ИННПоставщика;
			Описание.Поставщик                       = Поставщик;
			Описание.КодТовараПоставщика             = СтрокаИлиПусто(СтрокаУПД.КодТовараПоставщика);
			Описание.НоменклатураДалион              = СтрокаИлиПусто(СтрокаПрихода.Наименование);
			Описание.КодНоменклатурыДалион           = КодДалион;
			Описание.ИдентификаторНоменклатурыДалион = Уид;
			Описание.Источник                        = "РучнаяПара";
			Описание.КоличествоВЕдинице              = КоличествоВЕдинице;
			ЗаписатьШтрихкод(Описание);
			Записано = Записано + 1;
		КонецЦикла;

		Если ЗначениеЗаполнено(Уид + КодДалион) Тогда
			Для Каждого Штрихкод Из ШтрихкодыУПД Цикл
				Если ШтрихкодыПрихода.Найти(Штрихкод) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Описание = НовоеОписаниеШтрихкода();
				Описание.Штрихкод                        = Штрихкод;
				Описание.НаименованиеПоставщика          = НаименованиеУПД;
				Описание.ИННПоставщика                   = ИННПоставщика;
				Описание.Поставщик                       = Поставщик;
				Описание.КодТовараПоставщика             = СтрокаИлиПусто(СтрокаУПД.КодТовараПоставщика);
				Описание.НоменклатураДалион              = СтрокаИлиПусто(СтрокаПрихода.Наименование);
				Описание.КодНоменклатурыДалион           = КодДалион;
				Описание.ИдентификаторНоменклатурыДалион = Уид;
				Описание.Источник                        = "РучнаяПара";
				Описание.КоличествоВЕдинице              = КоличествоВЕдинице;
				ЗаписатьШтрихкод(Описание);
				Записано = Записано + 1;
			КонецЦикла;
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторУПД,
			"СвязатьСтрокуУПДСПриходом (ручная связь строки не записана)", ОшибкаИсключения);
		Результат.Текст = ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения);
		Возврат Результат;
	КонецПопытки;

	// Вне транзакции записи: назначение штрихкодов и сверка сами блокируют
	// и пишут регистры
	Попытка
		НазначитьШтрихкоды(ИдентификаторУПД, ИННПоставщика);
	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("РучнаяПара", СтрШаблон(
			НСтр("ru = 'УПД %1: штрихкоды поставщика не назначены: %2'"),
			ИдентификаторУПД, ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
	КонецПопытки;

	Пересверено = ПересверитьОткрытыеЦепочкиУПД(ИдентификаторУПД);

	Результат.Успех = Истина;
	Результат.Текст = СтрШаблон(
		НСтр("ru = '«%1» связан с «%2»: записей штрихкодов %3, пересверено цепочек %4.'"),
		НаименованиеУПД, СтрокаИлиПусто(СтрокаПрихода.Наименование), Записано, Пересверено);
	Если БезШтрихкода Тогда
		Результат.Текст = Результат.Текст + " " + НСтр(
			"ru = 'Штрихкода у товара нет - пара записана по номенклатуре Далиона.'");
	КонецЕсли;
	Если КоличествоВЕдинице > 0 Тогда
		Результат.Текст = Результат.Текст + " " + СтрШаблон(
			НСтр("ru = 'В единице поставщика - %1 шт. товара Далиона (по количествам документов).'"),
			КоличествоВЕдинице);
	КонецЕсли;
	Если УдаленоСпорных > 0 Тогда
		Результат.Текст = Результат.Текст + " " + СтрШаблон(
			НСтр("ru = 'Принудительно убрано спорных записей: %1.'"), УдаленоСпорных);
	КонецЕсли;

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(ИдентификаторУПД, "РучнаяПара", Истина, Результат.Текст);

	Возврат Результат;

КонецФункции

// Пересверяет обычными правилами цепочки УПД с приходом - после ручной пары.
//
// Цепочки с установленной пломбой (этап «Закрыто») тоже: пару связал
// человек, и её результат должен сразу лечь в реестр товаров, итог сверки и
// цвет строк. Раньше закрытая цепочка не пересверялась, и после связки
// строка в дереве реестра УПД оставалась красной.
//
// Возвращаемое значение:
//   Число - сколько цепочек пересверено
//
// Пересверка цепочек УПД обычными правилами - после снятия ручной отметки
// «Сверилось». Возвращает, сколько цепочек пересверено.
//
Функция ПересверитьЦепочкиУПДОбычно(ИдентификаторУПД) Экспорт

	Возврат ПересверитьОткрытыеЦепочкиУПД(ИдентификаторУПД);

КонецФункции

Функция ПересверитьОткрытыеЦепочкиУПД(ИдентификаторУПД)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторУПД = &ИдентификаторУПД
	|	И Цепочка.ИдентификаторПоступления <> """"";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	Пересверено = 0;
	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			//@skip-check query-in-loop
			СверитьЦепочку(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, Настройки);
			Пересверено = Пересверено + 1;
		Исключение
			ЭАрМ_Служебный.ЗаписатьОшибку("РучнаяПара", СтрШаблон(
				НСтр("ru = 'УПД %1: цепочка не пересверена: %2'"),
				ИдентификаторУПД, ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЦикла;

	Возврат Пересверено;

КонецФункции

// Непустые значения строки через ";" без повторов.
//
Функция СписокИзСтроки(Текст)

	Результат = Новый Массив;
	Для Каждого Часть Из СтрРазделить(СтрокаИлиПусто(Текст), ";", Ложь) Цикл
		Часть = СокрЛП(Часть);
		Если ЗначениеЗаполнено(Часть) И Результат.Найти(Часть) = Неопределено Тогда
			Результат.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НовоеОписаниеШтрихкода() Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Штрихкод",                        "");
	Описание.Вставить("НаименованиеПоставщика",          "");
	Описание.Вставить("ИННПоставщика",                   "");
	Описание.Вставить("Поставщик",                       "");
	Описание.Вставить("КодТовараПоставщика",             "");
	Описание.Вставить("НоменклатураДалион",              "");
	Описание.Вставить("КодНоменклатурыДалион",           "");
	Описание.Вставить("ИдентификаторНоменклатурыДалион", "");
	Описание.Вставить("Источник",                        "");
	// Штук номенклатуры Далиона в одной единице товара поставщика (коробка из N
	// штук, набор из нескольких товаров). 0 - не задано
	Описание.Вставить("КоличествоВЕдинице",              0);

	Возврат Описание;

КонецФункции

// Записывает штрихкод. Уже заполненные поля не затираются пустыми: пакет
// Далиона не знает кода товара поставщика, а сверка - номенклатуры Далиона.
//
// Набор с отбором, а не менеджер записи: менеджер в той же транзакции не видит
// строку, которую только что записал другой менеджер, и вторая Записать(Истина)
// падает («запись с такими ключевыми полями уже существует»). Так бывает на
// заказе, где один товар стоит двумя строками или названия отличаются только
// знаками, которые нормализация выбрасывает.
//
Процедура ЗаписатьШтрихкод(Описание)

	Наименование = ТекстПоляШтрихкода(Описание.НаименованиеПоставщика, 500);
	Штрихкод     = ТекстПоляШтрихкода(Описание.Штрихкод, 200);
	Ключ         = КлючНаименования(Наименование);

	Если НЕ ЗначениеЗаполнено(Штрихкод) ИЛИ НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;

	// Блокировка ставится только в транзакции. Своя - когда вызывающий пишет
	// по одной строке; чужая (пакет номенклатуры) остаётся его.
	СвояТранзакция = НЕ ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;

	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков");
		ЭлементБлокировки.УстановитьЗначение("Штрихкод", Штрихкод);
		ЭлементБлокировки.УстановитьЗначение("КлючНаименования", Ключ);
		Блокировка.Заблокировать();

		Набор = РегистрыСведений.ЭАрМ_ШтрихкодыПоставщиков.СоздатьНаборЗаписей();
		Набор.Отбор.Штрихкод.Установить(Штрихкод);
		Набор.Отбор.КлючНаименования.Установить(Ключ);
		Набор.Прочитать();

		БылаЗапись = Набор.Количество() > 0;
		Если БылаЗапись Тогда
			Запись = Набор[0];
		Иначе
			Запись = Набор.Добавить();
		КонецЕсли;

		// Запись новая или у неё сменилась номенклатура Далиона - данные карточки
		// запрашиваются у Далиона. Свои же записи из ответа Далиона запрос не повторяют.
		БылИдентификатор = СокрЛП(Запись.ИдентификаторНоменклатурыДалион);
		БылКод = СокрЛП(Запись.КодНоменклатурыДалион);

		Запись.НаименованиеПоставщика = Наименование;
		Запись.НаименованиеНорм       = ТекстПоляШтрихкода(НормализованноеНаименование(Наименование), 500);

		ЗаполнитьНепустым(Запись, "ИННПоставщика",                   Описание.ИННПоставщика, 12);
		ЗаполнитьНепустым(Запись, "Поставщик",                       Описание.Поставщик, 200);
		ЗаполнитьНепустым(Запись, "КодТовараПоставщика",             Описание.КодТовараПоставщика, 50);
		ЗаполнитьНепустым(Запись, "НоменклатураДалион",              Описание.НоменклатураДалион, 500);
		ЗаполнитьНепустым(Запись, "КодНоменклатурыДалион",           Описание.КодНоменклатурыДалион, 50);
		ЗаполнитьНепустым(Запись, "ИдентификаторНоменклатурыДалион", Описание.ИдентификаторНоменклатурыДалион, 36);
		ЗаполнитьНепустым(Запись, "Источник",                        Описание.Источник, 30);
		Если Описание.Свойство("КоличествоВЕдинице") И ТипЗнч(Описание.КоличествоВЕдинице) = Тип("Число")
			И ЗначениеЗаполнено(Описание.КоличествоВЕдинице)
			И Описание.КоличествоВЕдинице < 1000000000000
			И Описание.КоличествоВЕдинице > -1000000000000 Тогда
			Запись.КоличествоВЕдинице = Описание.КоличествоВЕдинице;
		КонецЕсли;

		// Уже лежащие в базе строки длиннее реквизита или с NUL роняют Записать,
		// хотя новые значения мы обрезаем. Подгоняем всю строку под метаданные.
		ОбрезатьПоляЗаписиШтрихкода(Запись);
		Запись.Штрихкод         = Штрихкод;
		Запись.КлючНаименования = Ключ;
		Запись.ДатаОбновления   = ТекущаяДатаСеанса();
		Набор.Записать();

		Если Описание.Источник <> "НоменклатураДалион" И Описание.Источник <> "ПоставщикиДалион"
			И НЕ ЭтоКлючБезШтрихкода(Штрихкод)
			И (НЕ БылаЗапись
				ИЛИ БылИдентификатор <> СокрЛП(Запись.ИдентификаторНоменклатурыДалион)
				ИЛИ БылКод <> СокрЛП(Запись.КодНоменклатурыДалион)) Тогда
			ЭАрМ_КатегорииТоваров.ПоставитьВОчередьЗапросаДалиона(Штрихкод);
		КонецЕсли;

		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;

	Исключение
		ТекстОшибки = СтрШаблон("%1. Штрихкод «%2», наименование «%3»",
			ЭАрМ_Служебный.КраткийТекстОшибки(ИнформацияОбОшибке()),
			Лев(Штрихкод, 40), Лев(Наименование, 80));
		Если СвояТранзакция И ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки("",
			"ЗаписатьШтрихкод (штрихкод не записан в ЭАрМ_ШтрихкодыПоставщиков)", ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

КонецПроцедуры

// Ключ записи регистра штрихкодов для товара без штрихкода.
//
// Ключ регистра - штрихкод и наименование поставщика, и пару без штрихкода
// было не записать, хотя сверка находит запись и по наименованию и берёт
// из неё номенклатуру Далиона. Вместо штрихкода - номенклатура Далиона с
// приставкой. Штрихкодом такой ключ не считается: назначение штрихкодов
// строкам, штрихкоды прихода и сравнение по штрихкоду его пропускают -
// после нормализации до цифр он мог бы совпасть с настоящим штрихкодом.
//
Функция КлючБезШтрихкода(Уид, КодДалион)

	Возврат ПрефиксКлючаБезШтрихкода()
		+ ?(ЗначениеЗаполнено(Уид), СокрЛП(Уид), "код:" + СокрЛП(КодДалион));

КонецФункции

Функция ПрефиксКлючаБезШтрихкода()

	Возврат "БЕЗШК:";

КонецФункции

// Истина, если в поле штрихкода регистра лежит ключ товара без штрихкода.
//
Функция ЭтоКлючБезШтрихкода(Штрихкод) Экспорт

	Возврат СтрНачинаетсяС(ВРег(СокрЛП(СтрокаИлиПусто(Штрихкод))), ПрефиксКлючаБезШтрихкода());

КонецФункции

// Настоящие штрихкоды номенклатуры Далиона из регистра - для пары, у
// которой штрихкода нет ни у строки прихода, ни у строки УПД.
//
Функция ШтрихкодыНоменклатурыДалион(Уид, КодДалион)

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	// Две части объединения, а не ИЛИ: иначе индекс по полю не берётся
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.ИдентификаторНоменклатурыДалион = &Уид
	|	И &Уид <> """"
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Штрихкоды.Штрихкод
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.КодНоменклатурыДалион = &Код
	|	И &Код <> """"
	|	И &Уид = """"";
	Запрос.УстановитьПараметр("Уид", СокрЛП(СтрокаИлиПусто(Уид)));
	Запрос.УстановитьПараметр("Код", СокрЛП(СтрокаИлиПусто(КодДалион)));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Штрихкод = СокрЛП(Выборка.Штрихкод);
		Если ЗначениеЗаполнено(Штрихкод)
			И НЕ ЭтоКлючБезШтрихкода(Штрихкод)
			И Результат.Найти(Штрихкод) = Неопределено Тогда
			Результат.Добавить(Штрихкод);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Принудительная перезапись ручной пары: убирает записи регистра, которые
// спорят с выбранной номенклатурой Далиона. Вызывается в транзакции записи
// пары.
//
// Спорят записи под тем же наименованием поставщика (своего ИНН или без ИНН)
// с другой номенклатурой, и записи со штрихкодами самой строки УПД,
// привязанные к другой номенклатуре. Именно они мешали новой паре: сверка
// берёт uid из всех подошедших записей, и пара становилась неоднозначной
// или побеждала старая ошибочная запись.
//
// Возвращаемое значение:
//   Число - сколько записей удалено
//
Функция УдалитьСпорныеЗаписиПары(КлючИмени, ИННПоставщика, ШтрихкодыУПД, НовыеШтрихкоды, Уид, КодДалион)

	Если НЕ ЗначениеЗаполнено(КлючИмени) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.КлючНаименования КАК КлючНаименования,
	|	Штрихкоды.ИННПоставщика КАК ИННПоставщика,
	|	Штрихкоды.ИдентификаторНоменклатурыДалион КАК Уид,
	|	Штрихкоды.КодНоменклатурыДалион КАК Код
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.КлючНаименования = &Ключ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Штрихкоды.Штрихкод,
	|	Штрихкоды.КлючНаименования,
	|	Штрихкоды.ИННПоставщика,
	|	Штрихкоды.ИдентификаторНоменклатурыДалион,
	|	Штрихкоды.КодНоменклатурыДалион
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод В (&ШтрихкодыУПД)";
	Запрос.УстановитьПараметр("Ключ", КлючИмени);
	Запрос.УстановитьПараметр("ШтрихкодыУПД", ШтрихкодыУПД);

	Удалено = 0;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если ТаЖеНоменклатураДалион(Выборка.Уид, Выборка.Код, Уид, КодДалион) Тогда
			Продолжить;
		КонецЕсли;

		Штрихкод = СокрЛП(Выборка.Штрихкод);
		ИННЗаписи = СокрЛП(Выборка.ИННПоставщика);
		БезНоменклатуры = НЕ ЗначениеЗаполнено(СокрЛП(Выборка.Уид) + СокрЛП(Выборка.Код));

		ПодИменем = Выборка.КлючНаименования = КлючИмени
			И (НЕ ЗначениеЗаполнено(ИННПоставщика) ИЛИ НЕ ЗначениеЗаполнено(ИННЗаписи)
				ИЛИ ИННЗаписи = ИННПоставщика);

		Если ПодИменем Тогда
			// Запись без номенклатуры с тем же штрихкодом перезапишется новой парой
			Если БезНоменклатуры И НовыеШтрихкоды.Найти(Штрихкод) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
		ИначеЕсли БезНоменклатуры ИЛИ ШтрихкодыУПД.Найти(Штрихкод) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ШтрихкодыПоставщиков.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Штрихкод         = Выборка.Штрихкод;
		МенеджерЗаписи.КлючНаименования = Выборка.КлючНаименования;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
			Удалено = Удалено + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Удалено;

КонецФункции

// Одна ли номенклатура Далиона: по uid, если он есть у обеих сторон, иначе
// по коду. Без uid и кода у записи - не та же.
//
Функция ТаЖеНоменклатураДалион(УидЗаписи, КодЗаписи, Уид, КодДалион)

	УидЗаписи = СокрЛП(СтрокаИлиПусто(УидЗаписи));
	КодЗаписи = СокрЛП(СтрокаИлиПусто(КодЗаписи));

	Если ЗначениеЗаполнено(УидЗаписи) И ЗначениеЗаполнено(Уид) Тогда
		Возврат УидЗаписи = СокрЛП(Уид);
	КонецЕсли;

	Если ЗначениеЗаполнено(КодЗаписи) И ЗначениеЗаполнено(КодДалион) Тогда
		Возврат КодЗаписи = СокрЛП(КодДалион);
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Процедура ЗаполнитьНепустым(Запись, ИмяПоля, Значение, Длина)

	Текст = ТекстПоляШтрихкода(Значение, Длина);
	Если ЗначениеЗаполнено(Текст) Тогда
		Запись[ИмяПоля] = Текст;
	КонецЕсли;

КонецПроцедуры

// Строка реквизита регистра: без управляющих символов и не длиннее поля.
// NUL и прочие символы с кодом меньше 32 платформа кладёт в строку, а
// Записать на них падает. Эмодзи - один символ и два кода UTF-16, поэтому
// длина считается в кодах, а не через Лев.
//
Функция ТекстПоляШтрихкода(Значение, Длина)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Текст = Формат(Значение, "ЧГ=0");
	Иначе
		Текст = СокрЛП(СтрокаИлиПусто(Значение));
	КонецЕсли;

	Результат = "";
	Набрано = 0;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Код = КодСимвола(Текст, Позиция);
		Если Код < 32 ИЛИ Код = 127 ИЛИ Код = 65279 Тогда
			Продолжить;
		КонецЕсли;
		Ширина = ?(Код > 65535, 2, 1);
		Если Набрано + Ширина > Длина Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + Сред(Текст, Позиция, 1);
		Набрано = Набрано + Ширина;
	КонецЦикла;

	Возврат СокрЛП(Результат);

КонецФункции

// Подгоняет уже прочитанную строку под длины реквизитов. Иначе Записать
// падает на старом значении, которое новое описание не затирает.
//
Процедура ОбрезатьПоляЗаписиШтрихкода(Запись)

	Запись.НаименованиеПоставщика = ТекстПоляШтрихкода(Запись.НаименованиеПоставщика, 500);
	Запись.НаименованиеНорм       = ТекстПоляШтрихкода(Запись.НаименованиеНорм, 500);
	Запись.ИННПоставщика          = ТекстПоляШтрихкода(Запись.ИННПоставщика, 12);
	Запись.Поставщик              = ТекстПоляШтрихкода(Запись.Поставщик, 200);
	Запись.КодТовараПоставщика    = ТекстПоляШтрихкода(Запись.КодТовараПоставщика, 50);
	Запись.НоменклатураДалион     = ТекстПоляШтрихкода(Запись.НоменклатураДалион, 500);
	Запись.КодНоменклатурыДалион  = ТекстПоляШтрихкода(Запись.КодНоменклатурыДалион, 50);
	Запись.ИдентификаторНоменклатурыДалион = ТекстПоляШтрихкода(Запись.ИдентификаторНоменклатурыДалион, 36);
	Запись.Источник               = ТекстПоляШтрихкода(Запись.Источник, 30);
	Запись.ВидНоменклатуры        = ТекстПоляШтрихкода(Запись.ВидНоменклатуры, 36);

	Если ТипЗнч(Запись.КоличествоВЕдинице) <> Тип("Число")
		ИЛИ Запись.КоличествоВЕдинице >= 1000000000000
		ИЛИ Запись.КоличествоВЕдинице <= -1000000000000 Тогда
		Запись.КоличествоВЕдинице = 0;
	КонецЕсли;

КонецПроцедуры

Функция ЗаписатьТоварыШтрихкодов(Товары, ИмяФайла)

	Итоги = Новый Структура("Загружено, Пропущено, Всего", 0, 0, Товары.Количество());
	Добавленные = Новый Соответствие;

	НачатьТранзакцию();
	Попытка

		Для Каждого Товар Из Товары Цикл

			Ключ = Товар.Штрихкод + "|" + ВРег(Товар.Наименование);
			Если НЕ ЭтоШтрихкодФайла(Товар.Штрихкод)
				ИЛИ НЕ ЗначениеЗаполнено(Товар.Наименование)
				ИЛИ Добавленные.Получить(Ключ) <> Неопределено Тогда
				Итоги.Пропущено = Итоги.Пропущено + 1;
				Продолжить;
			КонецЕсли;
			Добавленные.Вставить(Ключ, Истина);

			Описание = НовоеОписаниеШтрихкода();
			Описание.Штрихкод               = Товар.Штрихкод;
			Описание.НаименованиеПоставщика = Товар.Наименование;
			Описание.НоменклатураДалион     = Товар.Наименование;
			Описание.КодНоменклатурыДалион           = Товар.Код;
			Описание.ИдентификаторНоменклатурыДалион = Товар.Идентификатор;
			Описание.ИННПоставщика                   = Товар.ИНН;
			Описание.КодТовараПоставщика    = Товар.КодПоставщика;
			Описание.Источник               = "ФайлНоменклатуры";

			ЗаписатьШтрихкод(Описание);
			Итоги.Загружено = Итоги.Загружено + 1;

		КонецЦикла;

		ЗафиксироватьТранзакцию();

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ЗаписатьТоварыШтрихкодов (файл " + ИмяФайла + ")", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ШтрихкодыПоставщиков", Истина,
		СтрШаблон("Файл номенклатуры: загружено %1, пропущено %2 из %3",
			Итоги.Загружено, Итоги.Пропущено, Итоги.Всего),
		Лев(ИмяФайла, 150));

	Возврат Итоги;

КонецФункции

Функция ТоварыИзФайлаНоменклатуры(ДвоичныеДанные, ИмяФайла)

	Файл = Новый Файл(ИмяФайла);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(СтрЗаменить(Файл.Расширение, ".", ""));
	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	Попытка
		ЧтениеТекста = Новый ЧтениеТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
		Текст = ЭАрМ_Служебный.СтрокойИлиПусто(ЧтениеТекста.Прочитать());
		ЧтениеТекста.Закрыть();
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ТоварыИзФайлаНоменклатуры (файл " + ИмяФайла + " не прочитан)", ОшибкаИсключения);
		ЭАрМ_Служебный.УдалитьВременныйФайл(ИмяВременногоФайла);
		ВызватьИсключение;
	КонецПопытки;

	ЭАрМ_Служебный.УдалитьВременныйФайл(ИмяВременногоФайла);

	Возврат ТоварыИзТекстаJSON(Текст);

КонецФункции

Функция ТоварыИзПутиФайлаНоменклатуры(ПутьКФайлу)

	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Попытка
		Текст = ЭАрМ_Служебный.СтрокойИлиПусто(ЧтениеТекста.Прочитать());
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ТоварыИзПутиФайлаНоменклатуры (файл " + ПутьКФайлу + " не прочитан)", ОшибкаИсключения);
		ЧтениеТекста.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	ЧтениеТекста.Закрыть();

	Возврат ТоварыИзТекстаJSON(Текст);

КонецФункции

Функция ТоварыИзТекстаJSON(Знач Текст)

	Если Лев(Текст, 1) = Символ(65279) Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	Текст = СокрЛП(Текст);

	Если НЕ СтрНачинаетсяС(Текст, "{") И НЕ СтрНачинаетсяС(Текст, "[") Тогда
		ВызватьИсключение "Ожидается JSON с товарами и штрихкодами";
	КонецЕсли;

	Данные = ЭАрМ_Служебный.ПрочитатьОтветJSON(Текст);
	Если Данные = Неопределено Тогда
		ВызватьИсключение "Файл не разобран как JSON. Проверьте, что файл целый и в UTF-8";
	КонецЕсли;

	Элементы = МассивСтрокТоваровИзJSON(Данные, 0);
	Если ТипЗнч(Элементы) <> Тип("Массив") ИЛИ Элементы.Количество() = 0 Тогда
		ВызватьИсключение "В JSON не найдены строки товаров со штрихкодом";
	КонецЕсли;

	Товары = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Для Каждого Товар Из ТоварыИзЭлементаJSON(Элемент) Цикл
			Товары.Добавить(Товар);
		КонецЦикла;
	КонецЦикла;

	Если Товары.Количество() = 0 Тогда
		ВызватьИсключение "В JSON есть строки, но без штрихкода и наименования";
	КонецЕсли;

	Возврат Товары;

КонецФункции

Функция МассивСтрокТоваровИзJSON(Данные, Глубина)

	Если Глубина > 6 ИЛИ Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Если ЭтоМассивСтрокТоваров(Данные) Тогда
			Возврат Данные;
		КонецЕсли;
		Для Каждого Элемент Из Данные Цикл
			Найденный = МассивСтрокТоваровИзJSON(Элемент, Глубина + 1);
			Если Найденный <> Неопределено Тогда
				Возврат Найденный;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ЭтоУзелJSON(Данные) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Путь Из СтрРазделить("товары,items,goods,nomenclature,products,data.items,data.goods,data.товары,data.nomenclature", ",") Цикл
		Узел = УзелПоПутиИгнорРегистра(Данные, Путь);
		Если ТипЗнч(Узел) = Тип("Массив") И ЭтоМассивСтрокТоваров(Узел) Тогда
			Возврат Узел;
		КонецЕсли;
	КонецЦикла;

	УзелДанных = УзелПоИменам(Данные, "data");
	Если ЭтоУзелJSON(УзелДанных) Тогда
		Найденный = МассивСтрокТоваровИзJSON(УзелДанных, Глубина + 1);
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЕсли;

	Если ЭтоСтрокаТовараJSON(Данные) Тогда
		Результат = Новый Массив;
		Результат.Добавить(Данные);
		Возврат Результат;
	КонецЕсли;

	Для Каждого КлючЗначение Из Данные Цикл
		Найденный = МассивСтрокТоваровИзJSON(КлючЗначение.Значение, Глубина + 1);
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ЭтоМассивСтрокТоваров(Элементы)

	Если Элементы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Граница = Мин(Элементы.Количество(), 5);
	ЕстьСтрока = Ложь;
	Для Индекс = 0 По Граница - 1 Цикл
		Если ЭтоСтрокаТовараJSON(Элементы[Индекс]) Тогда
			ЕстьСтрока = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат ЕстьСтрока;

КонецФункции

Функция ЭтоСтрокаТовараJSON(Элемент)

	Если НЕ ЭтоУзелJSON(Элемент) Тогда
		Возврат Ложь;
	КонецЕсли;

	Номенклатура = УзелПоИменам(Элемент, "nomenclature");
	ЕстьИмя = ЗначениеЗаполнено(ПолеСтрокиJSON(Элемент, "наименование,name,declaration_name"))
		ИЛИ ЗначениеЗаполнено(ПолеСтрокиJSON(Номенклатура, "name,наименование"));
	ЕстьКод = ЗначениеЗаполнено(ПолеСтрокиJSON(Элемент, "код,code"))
		ИЛИ ЗначениеЗаполнено(ПолеСтрокиJSON(Номенклатура, "code,код"));
	ЕстьШтрихкод = ЗначениеЗаполнено(ПолеСтрокиJSON(Элемент, "штрихкод,barcode"))
		ИЛИ ШтрихкодыСтрокиДалиона(Элемент).Количество() > 0;

	Возврат (ЕстьИмя ИЛИ ЕстьКод) И (ЕстьИмя ИЛИ ЕстьШтрихкод);

КонецФункции

Функция ТоварыИзЭлементаJSON(Элемент)

	Результат = Новый Массив;
	Если НЕ ЭтоУзелJSON(Элемент) Тогда
		Возврат Результат;
	КонецЕсли;

	Номенклатура = УзелПоИменам(Элемент, "nomenclature");

	Наименование = ПолеСтрокиJSON(Элемент, "наименование,name,declaration_name");
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Наименование = ПолеСтрокиJSON(Номенклатура, "name,наименование,fullName");
	КонецЕсли;

	Код = ПолеСтрокиJSON(Элемент, "код,code");
	Если НЕ ЗначениеЗаполнено(Код) Тогда
		Код = ПолеСтрокиJSON(Номенклатура, "code,код");
	КонецЕсли;

	Идентификатор = ПолеСтрокиJSON(Элемент, "uid,ИдентификаторНоменклатурыДалион");
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Идентификатор = ПолеСтрокиJSON(Номенклатура, "uid");
	КонецЕсли;

	ИНН = ПолеСтрокиJSON(Элемент, "инн,inn");

	Штрихкоды = Новый Массив;
	Штрихкод = ПолеСтрокиJSON(Элемент, "штрихкод,barcode");
	Если ЗначениеЗаполнено(Штрихкод) Тогда
		Штрихкоды.Добавить(Штрихкод);
	КонецЕсли;
	Для Каждого ШтрихкодДалиона Из ШтрихкодыСтрокиДалиона(Элемент) Цикл
		Если Штрихкоды.Найти(ШтрихкодДалиона) = Неопределено Тогда
			Штрихкоды.Добавить(ШтрихкодДалиона);
		КонецЕсли;
	КонецЦикла;

	Если Штрихкоды.Количество() = 0 Тогда
		Штрихкоды.Добавить("");
	КонецЕсли;

	Для Каждого Штрихкод Из Штрихкоды Цикл
		Товар = Новый Структура("Штрихкод, Наименование, Код, ИНН, КодПоставщика, Идентификатор",
			Штрихкод, Наименование, Код, ИНН, "", Идентификатор);
		Если ЗначениеЗаполнено(ИНН) Тогда
			Товар.КодПоставщика = Код;
			Товар.Код = "";
		КонецЕсли;
		Результат.Добавить(Товар);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолеСтрокиJSON(Узел, ИменаПолей)

	Если НЕ ЭтоУзелJSON(Узел) Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого ИмяПоля Из СтрРазделить(ИменаПолей, ",", Ложь) Цикл
		Значение = ЗначениеСтрокойИгнорРегистра(Узел, СокрЛП(ИмяПоля));
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция УзелПоПутиИгнорРегистра(Данные, Путь)

	ТекущийУзел = Данные;
	Для Каждого ЧастьПути Из СтрРазделить(Путь, ".", Ложь) Цикл
		ТекущийУзел = УзелПоИменам(ТекущийУзел, СокрЛП(ЧастьПути));
		Если ТекущийУзел = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Возврат ТекущийУзел;

КонецФункции

Функция УзелПоИменам(Узел, Имена)

	Если НЕ ЭтоУзелJSON(Узел) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Искомые = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		Имя = СокрЛП(Имя);
		Значение = ЭАрМ_Служебный.ЗначениеУзла(Узел, Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
		Искомые.Вставить(ВРег(Имя), Истина);
	КонецЦикла;

	Для Каждого КлючЗначение Из Узел Цикл
		Если Искомые.Получить(ВРег(Строка(КлючЗначение.Ключ))) <> Неопределено Тогда
			Возврат КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ЗначениеСтрокойИгнорРегистра(Узел, ИмяПоля)

	Значение = ЗначениеСтрокой(Узел, ИмяПоля);
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Найденный = УзелПоИменам(Узел, ИмяПоля);
	Если Найденный = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Найденный) = Тип("Число") Тогда
		Возврат Формат(Найденный, "ЧГ=0");
	КонецЕсли;

	Возврат СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(Найденный));

КонецФункции

Функция ЭтоУзелJSON(Значение)

	Возврат ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("Структура");

КонецФункции

Функция ЭтоШтрихкодФайла(Значение)

	Длина = СтрДлина(Значение);
	Если Длина < 8 ИЛИ Длина > 14 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По Длина Цикл
		Если СтрНайти("0123456789", Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Справочник штрихкодов для строк одного документа.
//
// Возвращаемое значение:
//   Структура - ПоКоду, ПоНаименованиюИНН, ПоНаименованию (Соответствие -> Штрихкод)
//
Функция ШтрихкодыДляПоиска(Коды, Ключи, ИННПоставщика)

	Результат = Новый Структура("ПоКоду, ПоНаименованиюИНН, ПоНаименованию",
		Новый Соответствие, Новый Соответствие, Новый Соответствие);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.КлючНаименования КАК КлючНаименования,
	|	Штрихкоды.КодТовараПоставщика КАК КодТовараПоставщика,
	|	Штрихкоды.ИННПоставщика КАК ИННПоставщика,
	|	Штрихкоды.Источник КАК Источник,
	|	Штрихкоды.ДатаОбновления КАК ДатаОбновления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.КлючНаименования В (&Ключи)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Штрихкоды.Штрихкод,
	|	Штрихкоды.КлючНаименования,
	|	Штрихкоды.КодТовараПоставщика,
	|	Штрихкоды.ИННПоставщика,
	|	Штрихкоды.Источник,
	|	Штрихкоды.ДатаОбновления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.КодТовараПоставщика В (&Коды)
	|	И (Штрихкоды.ИННПоставщика = &ИНН
	|		ИЛИ Штрихкоды.ИННПоставщика = """")
	|	И &ИНН <> """"";
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Запрос.УстановитьПараметр("Коды", Коды);
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИННПоставщика));

	// Код товара без ИНН в записи - запасной путь: файл поставщика, загруженный
	// без ИНН («Загрузить из файла»). Коды у поставщиков свои, поэтому такая
	// запись берётся, только если по коду нет записи своего поставщика
	ПоКодуБезИНН = Новый Соответствие;

	// На один код или имя в регистре бывает несколько штрихкодов - например,
	// неверная пара, выученная сверкой, и ручная пара поверх неё. Раньше
	// побеждала последняя запись выборки, то есть случайная; теперь - самый
	// надёжный источник, при равном источнике - самая свежая запись.
	Записи = Запрос.Выполнить().Выгрузить();
	УпорядочитьПоПриоритетуИсточника(Записи);

	Для Каждого Запись Из Записи Цикл
		// Ключ товара без штрихкода строке как штрихкод не назначаем
		Если ЭтоКлючБезШтрихкода(Запись.Штрихкод) Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(ИННПоставщика) И Запись.ИННПоставщика = ИННПоставщика Тогда
			Если ЗначениеЗаполнено(Запись.КодТовараПоставщика)
				И Результат.ПоКоду.Получить(Запись.КодТовараПоставщика) = Неопределено Тогда
				Результат.ПоКоду.Вставить(Запись.КодТовараПоставщика, Запись.Штрихкод);
			КонецЕсли;
			Если Результат.ПоНаименованиюИНН.Получить(Запись.КлючНаименования) = Неопределено Тогда
				Результат.ПоНаименованиюИНН.Вставить(Запись.КлючНаименования, Запись.Штрихкод);
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(ИННПоставщика) И НЕ ЗначениеЗаполнено(Запись.ИННПоставщика)
			И ЗначениеЗаполнено(Запись.КодТовараПоставщика)
			И ПоКодуБезИНН.Получить(Запись.КодТовараПоставщика) = Неопределено Тогда
			ПоКодуБезИНН.Вставить(Запись.КодТовараПоставщика, Запись.Штрихкод);
		КонецЕсли;

		Если Результат.ПоНаименованию.Получить(Запись.КлючНаименования) = Неопределено Тогда
			Результат.ПоНаименованию.Вставить(Запись.КлючНаименования, Запись.Штрихкод);
		КонецЕсли;

	КонецЦикла;

	Для Каждого КлючЗначение Из ПоКодуБезИНН Цикл
		Если Результат.ПоКоду.Получить(КлючЗначение.Ключ) = Неопределено Тогда
			Результат.ПоКоду.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Насколько можно верить записи регистра штрихкодов поставщиков, по её
// источнику. Меньше - надёжнее:
//   1 - ручная пара: человек сам выбрал строку прихода;
//   2 - данные Далиона, УПД и файлов;
//   3 - выучено сверкой и реестром товаров: пара могла сложиться неверно
//       (две строки одной цены) и дальше воспроизводить себя сама.
//
Функция ПриоритетИсточникаШтрихкода(Источник) Экспорт

	Значение = СокрЛП(СтрокаИлиПусто(Источник));

	Если Значение = "РучнаяПара" Тогда
		Возврат 1;
	ИначеЕсли Значение = "Сверка" ИЛИ Значение = "РеестрТоваров" Тогда
		Возврат 3;
	КонецЕсли;

	Возврат 2;

КонецФункции

// Сортирует записи регистра штрихкодов: сначала надёжный источник, внутри
// источника - свежие. В таблице должны быть колонки Источник и ДатаОбновления.
//
Процедура УпорядочитьПоПриоритетуИсточника(Записи)

	Записи.Колонки.Добавить("ПриоритетИсточника", Новый ОписаниеТипов("Число"));
	Для Каждого Запись Из Записи Цикл
		Запись.ПриоритетИсточника = ПриоритетИсточникаШтрихкода(Запись.Источник);
	КонецЦикла;
	Записи.Сортировать("ПриоритетИсточника, ДатаОбновления Убыв");

КонецПроцедуры

// Из записей, подошедших строке документа, - только записи самого надёжного
// источника. Ручная пара перекрывает пару, выученную сверкой: иначе строка
// УПД несла бы штрихкоды обоих товаров и сверка снова сводила бы её с чужой
// строкой прихода.
//
Функция ЗаписиЛучшегоИсточника(Записи)

	Если Записи.Количество() < 2 Тогда
		Возврат Записи;
	КонецЕсли;

	Лучший = Неопределено;
	Для Каждого Запись Из Записи Цикл
		Приоритет = ПриоритетИсточникаШтрихкода(Запись.Источник);
		Если Лучший = Неопределено ИЛИ Приоритет < Лучший Тогда
			Лучший = Приоритет;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Если ПриоритетИсточникаШтрихкода(Запись.Источник) = Лучший Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Что знает регистр штрихкодов поставщиков о строках документа поставщика:
// номенклатура Далиона (uid и код) и все штрихкоды этого товара.
//
// НазначитьШтрихкоды кладёт строке УПД один штрихкод из регистра, а у
// Далиона в пакете может стоять другой штрихкод той же номенклатуры - и
// пара по штрихкоду не находилась, хотя регистр её знает. Сравнение по
// номенклатуре Далиона такую пару находит.
//
// Запись регистра подходит строке по любому из штрихкодов строки (в любом
// написании GTIN), по коду товара поставщика с тем же ИНН или по ключу
// наименования (своего поставщика - в первую очередь).
//
// Параметры:
//   Строки        - Массив из Структура - Штрихкоды (Массив из Строка),
//                   КодТовараПоставщика, Наименование
//   ИННПоставщика - Строка - может быть пустым
//
// Возвращаемое значение:
//   Массив из Структура - в порядке Строки:
//     * Идентификаторы - Массив из Строка - uid номенклатуры Далиона
//     * Коды           - Массив из Строка - коды номенклатуры Далиона
//     * Штрихкоды      - Массив из Строка - штрихкоды из регистра
//
Функция СведенияШтрихкодовПоставщика(Строки, Знач ИННПоставщика = "") Экспорт

	ИННПоставщика = СокрЛП(СтрокаИлиПусто(ИННПоставщика));

	Результат = Новый Массив;
	ВариантыШтрихкодов = Новый Массив;
	Коды  = Новый Массив;
	Ключи = Новый Массив;

	Для Каждого Строка Из Строки Цикл
		// ИдентификаторыТочные - uid из записей, подошедших по штрихкоду или
		// коду товара; именные записи в них не смешиваются, иначе два разных
		// uid делают выбор неоднозначным (см. ДополнитьСтрокиЭДОИзШтрихкодовПоставщика)
		// Кратности - uid Далиона -> штук в единице поставщика (ручная пара с коробкой
		// или набором, см. СвязатьСтрокуУПДСПриходом)
		Результат.Добавить(Новый Структура("Идентификаторы, ИдентификаторыТочные, Коды, Штрихкоды, Кратности",
			Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Соответствие));
		Для Каждого Штрихкод Из Строка.Штрихкоды Цикл
			Для Каждого КлючЗначение Из КлючиШтрихкода(Штрихкод) Цикл
				ВариантыШтрихкодов.Добавить(Лев(КлючЗначение.Ключ, 200));
			КонецЦикла;
		КонецЦикла;
		Если ЗначениеЗаполнено(Строка.КодТовараПоставщика) Тогда
			Коды.Добавить(СокрЛП(Строка.КодТовараПоставщика));
		КонецЕсли;
		Ключ = КлючНаименования(Строка.Наименование);
		Если ЗначениеЗаполнено(Ключ) Тогда
			Ключи.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

	Если ВариантыШтрихкодов.Количество() = 0 И Коды.Количество() = 0 И Ключи.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	// Три отбора - три части объединения, а не ИЛИ: с ИЛИ по разным полям
	// СУБД не может взять индекс и читает регистр целиком, а он растёт от
	// автонаполнения. ОБЪЕДИНИТЬ без ВСЕ убирает повторы, как РАЗЛИЧНЫЕ
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.КлючНаименования КАК КлючНаименования,
	|	Штрихкоды.КодТовараПоставщика КАК КодТовараПоставщика,
	|	Штрихкоды.ИННПоставщика КАК ИННПоставщика,
	|	Штрихкоды.ИдентификаторНоменклатурыДалион КАК ИдентификаторНоменклатурыДалион,
	|	Штрихкоды.КодНоменклатурыДалион КАК КодНоменклатурыДалион,
	|	Штрихкоды.Источник КАК Источник,
	|	Штрихкоды.КоличествоВЕдинице КАК КоличествоВЕдинице
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод В (&Штрихкоды)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.КлючНаименования КАК КлючНаименования,
	|	Штрихкоды.КодТовараПоставщика КАК КодТовараПоставщика,
	|	Штрихкоды.ИННПоставщика КАК ИННПоставщика,
	|	Штрихкоды.ИдентификаторНоменклатурыДалион КАК ИдентификаторНоменклатурыДалион,
	|	Штрихкоды.КодНоменклатурыДалион КАК КодНоменклатурыДалион,
	|	Штрихкоды.Источник КАК Источник,
	|	Штрихкоды.КоличествоВЕдинице КАК КоличествоВЕдинице
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.КлючНаименования В (&Ключи)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.КлючНаименования КАК КлючНаименования,
	|	Штрихкоды.КодТовараПоставщика КАК КодТовараПоставщика,
	|	Штрихкоды.ИННПоставщика КАК ИННПоставщика,
	|	Штрихкоды.ИдентификаторНоменклатурыДалион КАК ИдентификаторНоменклатурыДалион,
	|	Штрихкоды.КодНоменклатурыДалион КАК КодНоменклатурыДалион,
	|	Штрихкоды.Источник КАК Источник,
	|	Штрихкоды.КоличествоВЕдинице КАК КоличествоВЕдинице
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.КодТовараПоставщика В (&Коды)
	|	И (Штрихкоды.ИННПоставщика = &ИНН
	|		ИЛИ Штрихкоды.ИННПоставщика = """")
	|	И &ИНН <> """"";
	Запрос.УстановитьПараметр("Штрихкоды", ВариантыШтрихкодов);
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Запрос.УстановитьПараметр("Коды", Коды);
	Запрос.УстановитьПараметр("ИНН", ИННПоставщика);

	Записи = Запрос.Выполнить().Выгрузить();

	// Второй круг: все штрихкоды той же номенклатуры Далиона - у товара их
	// бывает несколько (штука, короб, старый и новый EAN)
	Идентификаторы = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Если ЗначениеЗаполнено(Запись.ИдентификаторНоменклатурыДалион)
			И Идентификаторы.Найти(Запись.ИдентификаторНоменклатурыДалион) = Неопределено Тогда
			Идентификаторы.Добавить(Запись.ИдентификаторНоменклатурыДалион);
		КонецЕсли;
	КонецЦикла;
	ШтрихкодыНоменклатуры = Новый Соответствие;
	Если Идентификаторы.Количество() > 0 Тогда
		ЗапросШК = Новый Запрос;
		ЗапросШК.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Штрихкоды.ИдентификаторНоменклатурыДалион КАК Идентификатор,
		|	Штрихкоды.Штрихкод КАК Штрихкод
		|ИЗ
		|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.ИдентификаторНоменклатурыДалион В (&Идентификаторы)";
		ЗапросШК.УстановитьПараметр("Идентификаторы", Идентификаторы);
		ВыборкаШК = ЗапросШК.Выполнить().Выбрать();
		Пока ВыборкаШК.Следующий() Цикл
			Список = ШтрихкодыНоменклатуры.Получить(ВыборкаШК.Идентификатор);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				ШтрихкодыНоменклатуры.Вставить(ВыборкаШК.Идентификатор, Список);
			КонецЕсли;
			Если НЕ ЭтоКлючБезШтрихкода(ВыборкаШК.Штрихкод) Тогда
				Список.Добавить(СокрЛП(ВыборкаШК.Штрихкод));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Индекс = 0 По Строки.ВГраница() Цикл

		Строка   = Строки[Индекс];
		Сведения = Результат[Индекс];
		КодСтроки  = СокрЛП(СтрокаИлиПусто(Строка.КодТовараПоставщика));
		КлючСтроки = КлючНаименования(Строка.Наименование);

		ПоИмениСвоего = Новый Массив;
		ПоИмениЧужого = Новый Массив;
		Подошедшие    = Новый Массив;
		// Код товара у записи без ИНН (файл поставщика без ИНН) - только если по
		// коду нет записи своего поставщика: коды у поставщиков свои
		ПоКодуБезИНН  = Новый Массив;

		Для Каждого Запись Из Записи Цикл

			ПоШтрихкоду = Ложь;
			Для Каждого Штрихкод Из Строка.Штрихкоды Цикл
				Если ШтрихкодыСовпадают(Штрихкод, Запись.Штрихкод) Тогда
					ПоШтрихкоду = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			СвойПоставщик = ЗначениеЗаполнено(ИННПоставщика)
				И СокрЛП(Запись.ИННПоставщика) = ИННПоставщика;
			ПоКоду = СвойПоставщик И ЗначениеЗаполнено(КодСтроки)
				И СокрЛП(Запись.КодТовараПоставщика) = КодСтроки;

			Если ПоШтрихкоду ИЛИ ПоКоду Тогда
				Подошедшие.Добавить(Запись);
			ИначеЕсли ЗначениеЗаполнено(ИННПоставщика) И ЗначениеЗаполнено(КодСтроки)
				И НЕ ЗначениеЗаполнено(СокрЛП(Запись.ИННПоставщика))
				И СокрЛП(Запись.КодТовараПоставщика) = КодСтроки Тогда
				ПоКодуБезИНН.Добавить(Запись);
			ИначеЕсли ЗначениеЗаполнено(КлючСтроки) И Запись.КлючНаименования = КлючСтроки Тогда
				Если СвойПоставщик Тогда
					ПоИмениСвоего.Добавить(Запись);
				Иначе
					ПоИмениЧужого.Добавить(Запись);
				КонецЕсли;
			КонецЕсли;

		КонецЦикла;

		// Код без ИНН, затем имя - запасные пути: своего поставщика, а чужих -
		// только если ничего точнее нет
		ТочныеПодошедшие = Подошедшие;
		Если ТочныеПодошедшие.Количество() = 0 Тогда
			ТочныеПодошедшие = ПоКодуБезИНН;
		КонецЕсли;
		ТочныеПодошедшие = ЗаписиЛучшегоИсточника(ТочныеПодошедшие);

		Если Подошедшие.Количество() = 0 Тогда
			Подошедшие = ПоКодуБезИНН;
		КонецЕсли;
		Если Подошедшие.Количество() = 0 Тогда
			Подошедшие = ?(ПоИмениСвоего.Количество() > 0, ПоИмениСвоего, ПоИмениЧужого);
		КонецЕсли;
		Подошедшие = ЗаписиЛучшегоИсточника(Подошедшие);

		Для Каждого Запись Из ТочныеПодошедшие Цикл
			ДобавитьУникальнуюСтроку(Сведения.ИдентификаторыТочные, Запись.ИдентификаторНоменклатурыДалион);
		КонецЦикла;

		Для Каждого Запись Из Подошедшие Цикл
			Если НЕ ЭтоКлючБезШтрихкода(Запись.Штрихкод) Тогда
				ДобавитьУникальнуюСтроку(Сведения.Штрихкоды, Запись.Штрихкод);
			КонецЕсли;
			ДобавитьУникальнуюСтроку(Сведения.Идентификаторы, Запись.ИдентификаторНоменклатурыДалион);
			ДобавитьУникальнуюСтроку(Сведения.Коды, Запись.КодНоменклатурыДалион);
			Если ТипЗнч(Запись.КоличествоВЕдинице) = Тип("Число") И Запись.КоличествоВЕдинице > 0
				И ЗначениеЗаполнено(Запись.ИдентификаторНоменклатурыДалион) Тогда
				Сведения.Кратности.Вставить(Запись.ИдентификаторНоменклатурыДалион, Запись.КоличествоВЕдинице);
			КонецЕсли;
			Список = ШтрихкодыНоменклатуры.Получить(Запись.ИдентификаторНоменклатурыДалион);
			Если Список <> Неопределено Тогда
				Для Каждого Штрихкод Из Список Цикл
					ДобавитьУникальнуюСтроку(Сведения.Штрихкоды, Штрихкод);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строкам УПД и ЭТрН сверки - все штрихкоды товара и uid номенклатуры
// Далиона из регистра штрихкодов поставщиков (см. СведенияШтрихкодовПоставщика).
// В строку идут все uid суженного набора (сначала точные - по штрихкоду или
// коду), проход «Номенклатура» сверяет их пересечение с uid прихода. Одиночный
// ИдентификаторНоменклатуры ставится по-старому, только если uid один.
//
Процедура ДополнитьСтрокиЭДОИзШтрихкодовПоставщика(Строки, ИННПоставщика)

	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Описания = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Штрихкоды = Новый Массив;
		Для Каждого КлючЗначение Из Строка.Штрихкоды Цикл
			Штрихкоды.Добавить(КлючЗначение.Ключ);
		КонецЦикла;
		Описания.Добавить(Новый Структура("Штрихкоды, КодТовараПоставщика, Наименование",
			Штрихкоды, Строка.Код, Строка.Наименование));
	КонецЦикла;

	Сведения = СведенияШтрихкодовПоставщика(Описания, ИННПоставщика);

	Для Индекс = 0 По Строки.ВГраница() Цикл
		Строка = Строки[Индекс];
		Для Каждого Штрихкод Из Сведения[Индекс].Штрихкоды Цикл
			Строка.Штрихкоды.Вставить(Штрихкод, Истина);
		КонецЦикла;

		Идентификаторы = Сведения[Индекс].ИдентификаторыТочные;
		Если Идентификаторы.Количество() = 0 Тогда
			Идентификаторы = Сведения[Индекс].Идентификаторы;
		КонецЕсли;
		Для Каждого Уид Из Идентификаторы Цикл
			ДобавитьУникальнуюСтроку(Строка.ИдентификаторыНоменклатуры, Уид);
		КонецЦикла;

		Если НЕ ЗначениеЗаполнено(Строка.ИдентификаторНоменклатуры)
			И Сведения[Индекс].Идентификаторы.Количество() = 1 Тогда
			Строка.ИдентификаторНоменклатуры = Сведения[Индекс].Идентификаторы[0];
		КонецЕсли;

		ПрименитьКратностьПоставщика(Строка, Сведения[Индекс].Кратности);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьУникальнуюСтроку(Список, Значение)

	Текст = СокрЛП(СтрокаИлиПусто(Значение));
	Если ЗначениеЗаполнено(Текст) И Список.Найти(Текст) = Неопределено Тогда
		Список.Добавить(Текст);
	КонецЕсли;

КонецПроцедуры

// Те же штрихкоды из УТ для позиций прихода вне сверки - для формы реестра
// УПД. Без них строка Далиона без штрихкода в пакете оставалась в форме без
// пары, хотя сверка и реестр товаров сопоставили её по штрихкоду.
//
// Параметры:
//   Позиции - Массив из Структура - ИдентификаторНоменклатуры, КодНоменклатуры,
//             Наименование, Штрихкоды (Массив из Строка); пустые Штрихкоды
//             дополняются найденными
//
Процедура ДополнитьШтрихкодыПозицийИзУТ(Позиции) Экспорт

	Строки = Новый Массив;
	Для Каждого Позиция Из Позиции Цикл
		Строка = НоваяСтрока("Поступление", Строки.Количество() + 1);
		Строка.Наименование              = СтрокаИлиПусто(Позиция.Наименование);
		Строка.Код                       = СтрокаИлиПусто(Позиция.КодНоменклатуры);
		Строка.ИдентификаторНоменклатуры = СтрокаИлиПусто(Позиция.ИдентификаторНоменклатуры);
		Для Каждого Штрихкод Из Позиция.Штрихкоды Цикл
			Строка.Штрихкоды.Вставить(Штрихкод, Истина);
		КонецЦикла;
		Строки.Добавить(Строка);
	КонецЦикла;

	ДополнитьШтрихкодыИзУТ(Строки);

	Для Индекс = 0 По Строки.ВГраница() Цикл
		Если Позиции[Индекс].Штрихкоды.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого КлючЗначение Из Строки[Индекс].Штрихкоды Цикл
			Позиции[Индекс].Штрихкоды.Добавить(КлючЗначение.Ключ);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Штрихкоды строкам Далиона, пришедшим без них, подбираются здесь, в УТ, по
// регистру ЭАрМ_ШтрихкодыПоставщиков: по uid номенклатуры Далиона, по её коду,
// по наименованию. Регистр пополняют выгрузка справочника Номенклатура,
// порции supplierBarcodes и файлы поставщиков, поэтому Далиону не нужно
// искать штрихкоды при проведении каждого документа. Одним запросом на документ.
//
Процедура ДополнитьШтрихкодыИзУТ(Строки)

	Идентификаторы = Новый Массив;
	Коды  = Новый Массив;
	Ключи = Новый Массив;

	Для Каждого Строка Из Строки Цикл
		Если Строка.Штрихкоды.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.ИдентификаторНоменклатуры) Тогда
			Идентификаторы.Добавить(Строка.ИдентификаторНоменклатуры);
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.Код) Тогда
			Коды.Добавить(Строка.Код);
		КонецЕсли;
		Ключ = КлючНаименования(Строка.Наименование);
		Если ЗначениеЗаполнено(Ключ) Тогда
			Ключи.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

	Если Идентификаторы.Количество() = 0 И Коды.Количество() = 0 И Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	""Номенклатура"" КАК Способ,
	|	Штрихкоды.ИдентификаторНоменклатурыДалион КАК Ключ,
	|	Штрихкоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.ИдентификаторНоменклатурыДалион В (&Идентификаторы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Код"",
	|	Штрихкоды.КодНоменклатурыДалион,
	|	Штрихкоды.Штрихкод
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.КодНоменклатурыДалион В (&Коды)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Наименование"",
	|	Штрихкоды.КлючНаименования,
	|	Штрихкоды.Штрихкод
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.КлючНаименования В (&Ключи)";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Запрос.УстановитьПараметр("Коды", Коды);
	Запрос.УстановитьПараметр("Ключи", Ключи);

	Найденные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЭтоКлючБезШтрихкода(Выборка.Штрихкод) Тогда
			Продолжить;
		КонецЕсли;
		КлючПоиска = СокрЛП(Выборка.Способ) + "|" + СокрЛП(Выборка.Ключ);
		Штрихкоды = Найденные.Получить(КлючПоиска);
		Если Штрихкоды = Неопределено Тогда
			Штрихкоды = Новый Массив;
			Найденные.Вставить(КлючПоиска, Штрихкоды);
		КонецЕсли;
		Штрихкоды.Добавить(СокрЛП(Выборка.Штрихкод));
	КонецЦикла;

	Если Найденные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Строка Из Строки Цикл

		Если Строка.Штрихкоды.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Вариант Из СтрРазделить("Номенклатура,Код,Наименование", ",") Цикл

			Если Вариант = "Номенклатура" Тогда
				Значение = Строка.ИдентификаторНоменклатуры;
			ИначеЕсли Вариант = "Код" Тогда
				Значение = Строка.Код;
			Иначе
				Значение = КлючНаименования(Строка.Наименование);
			КонецЕсли;

			Штрихкоды = ?(ЗначениеЗаполнено(Значение), Найденные.Получить(Вариант + "|" + Значение), Неопределено);
			Если Штрихкоды = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Для Каждого Штрихкод Из Штрихкоды Цикл
				Строка.Штрихкоды.Вставить(Штрихкод, Истина);
			КонецЦикла;
			Строка.СпособШтрихкода = "УТ:" + Вариант;
			Прервать;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаписьЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторУПД КАК ИдентификаторУПД,
	|	Цепочка.ИдентификаторЭТрН КАК ИдентификаторЭТрН,
	|	Цепочка.ИННПоставщика КАК ИННПоставщика,
	|	Цепочка.Поставщик КАК Поставщик
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторЗаказа = &ИдентификаторЗаказа
	|	И Цепочка.ИдентификаторПоступления = &ИдентификаторПоступления";
	Запрос.УстановитьПараметр("ИдентификаторЗаказа", ИдентификаторЗаказа);
	Запрос.УстановитьПараметр("ИдентификаторПоступления", ИдентификаторПоступления);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Цепочка = Новый Структура("ИдентификаторУПД, ИдентификаторЭТрН, ИННПоставщика, Поставщик");
	ЗаполнитьЗначенияСвойств(Цепочка, Выборка);

	Возврат Цепочка;

КонецФункции

// Массив из непустых значений - для обхода необязательных строк линии.
//
Функция ЗначениеВМассиве(Значение1, Значение2 = Неопределено, Значение3 = Неопределено,
	Значение4 = Неопределено)

	Результат = Новый Массив;
	Для Каждого Значение Из ЭАрМ_Служебный.ЗначениеВМассив(Значение1) Цикл
		Результат.Добавить(Значение);
	КонецЦикла;
	Если Значение2 <> Неопределено Тогда
		Результат.Добавить(Значение2);
	КонецЕсли;
	Если Значение3 <> Неопределено Тогда
		Результат.Добавить(Значение3);
	КонецЕсли;
	Если Значение4 <> Неопределено Тогда
		Результат.Добавить(Значение4);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЗначениеСтрокой(Узел, ИмяСвойства)

	Значение = ЭАрМ_Служебный.ЗначениеУзла(Узел, ИмяСвойства, "");

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;

	Возврат СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(Значение));

КонецФункции

Функция СтрокаИлиПусто(Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти
