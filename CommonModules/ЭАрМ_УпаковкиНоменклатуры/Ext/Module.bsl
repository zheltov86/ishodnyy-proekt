////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// Упаковки номенклатуры: УПД и приход приходят коробками, в УТ учёт штуками.
//
// Единица хранения карточки - штука. Коробка - упаковка типа «Конечная»
// (Числитель = штук в коробке, Знаменатель = 1) с собственным штрихкодом в
// РС ШтрихкодыНоменклатуры (реквизит Упаковка). Типовые коробки (6, 10, 12,
// 20, 24) лежат в общих наборах упаковок «Коробка N шт», остальные - в
// индивидуальных упаковках карточки.
//
// Штук в коробке берётся из приходной Далиона (ratio строки). Штрихкод:
// GTIN-14 с индикатором 1-8 - коробка, остальные - штука. GTIN-14 с нулём
// впереди - это EAN-13 штуки.
//
// Правило: Obsidian_ОбменЭДО\10_Инструкции\Правило_Упаковки_И_Штуки.md
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Коэффициент упаковки и штрихкоды товара.
//
// Сначала единицы номенклатуры Далиона (units карточки из пакета «Номенклатура»):
// у каждой единицы свой коэффициент и свои штрихкоды, поэтому коробка известна,
// даже если товар ещё не приходил коробкой, и штрихкод коробки не угадывается по
// виду GTIN. Нет карточки или коробку не выбрать однозначно - по приходной Далиона
// (ratio строки), как раньше.
//
// Параметры:
//   Штрихкод - Строка - штрихкод товара из реестра (можно несколько через «;»)
//
// Возвращаемое значение:
//   Структура - Коэффициент (Число, 1 - упаковки нет), Штрихкоды (Массив из Строка),
//               ШтрихкодыКоробки (Массив из Строка - точно штрихкоды коробки, из
//               единицы Далиона; пусто - определяются по виду GTIN),
//               Источник (Строка - «Далион», «Приход» или пусто)
//
Функция ДанныеУпаковкиТовара(Штрихкод) Экспорт

	Приход = ДанныеУпаковкиИзПрихода(Штрихкод);
	Приход.Вставить("ШтрихкодыКоробки", Новый Массив);
	Приход.Вставить("Источник", ?(Приход.Коэффициент > 1, "Приход", ""));

	Далион = УпаковкаИзЕдиницДалиона(Штрихкод, Приход.Коэффициент);
	Если Далион = Неопределено Тогда
		Возврат Приход;
	КонецЕсли;

	Для Каждого Код Из Приход.Штрихкоды Цикл
		Если Далион.Штрихкоды.Найти(Код) = Неопределено Тогда
			Далион.Штрихкоды.Добавить(Код);
		КонецЕсли;
	КонецЦикла;

	Возврат Далион;

КонецФункции

// Коробка по единицам номенклатуры Далиона.
//
// Какая единица - коробка:
//   1. та, которой принадлежит сам штрихкод товара, если её коэффициент от 2;
//   2. единственная единица с коэффициентом от 2 до 1000;
//   3. из нескольких - та, чей коэффициент совпал с ratio приходной.
// Иначе - Неопределено (решает приходная).
//
// Возвращаемое значение:
//   Структура - см. ДанныеУпаковкиТовара; Неопределено - карточки Далиона нет или коробку не выбрать
//
Функция УпаковкаИзЕдиницДалиона(Штрихкод, КоэффициентПрихода)

	Варианты = ЭАрМ_ПодборНоменклатуры.ВариантыШтрихкода(Штрихкод);
	Если Варианты.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Карточка = ЭАрМ_КатегорииТоваров.КарточкаДалионаПоШтрихкоду(Варианты);
	Исключение
		Карточка = Неопределено;
	КонецПопытки;
	Если Карточка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Искомые = Новый Соответствие;
	Для Каждого Вариант Из Варианты Цикл
		Искомые.Вставить(ТолькоЦифры(Вариант), Истина);
	КонецЦикла;

	Коробки = Новый Массив;
	СвояКоробка = Неопределено;
	Для Каждого Единица Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Карточка, "units")) Цикл

		Коэффициент = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Единица, "ratio", 1));
		Если Коэффициент < 2 ИЛИ Коэффициент > 1000 ИЛИ Коэффициент <> Окр(Коэффициент, 0) Тогда
			Продолжить;
		КонецЕсли;

		Коды = ШтрихкодыУзла(Единица);
		Описание = Новый Структура("Коэффициент, Коды", Коэффициент, Коды);
		Коробки.Добавить(Описание);

		Для Каждого Код Из Коды Цикл
			Для Каждого ВариантКода Из ЭАрМ_ПодборНоменклатуры.ВариантыШтрихкода(Код) Цикл
				Если Искомые.Получить(ТолькоЦифры(ВариантКода)) <> Неопределено Тогда
					СвояКоробка = Описание;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

	КонецЦикла;

	Выбранная = СвояКоробка;
	Если Выбранная = Неопределено И Коробки.Количество() = 1 Тогда
		Выбранная = Коробки[0];
	КонецЕсли;
	Если Выбранная = Неопределено И КоэффициентПрихода > 1 Тогда
		Для Каждого Описание Из Коробки Цикл
			Если Описание.Коэффициент = КоэффициентПрихода Тогда
				Выбранная = Описание;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Выбранная = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура("Коэффициент, Штрихкоды, ШтрихкодыКоробки, Источник",
		Выбранная.Коэффициент, Новый Массив, Выбранная.Коды, "Далион");

	// Штрихкоды: товара (из реестра), карточки Далиона и коробки
	Для Каждого Часть Из СтрРазделить(СтрЗаменить(СокрЛП(Штрихкод), ",", ";"), ";", Ложь) Цикл
		ДобавитьКод(Результат.Штрихкоды, Часть);
	КонецЦикла;
	Для Каждого Код Из ШтрихкодыУзла(Карточка) Цикл
		ДобавитьКод(Результат.Штрихкоды, Код);
	КонецЦикла;
	Для Каждого Код Из Выбранная.Коды Цикл
		ДобавитьКод(Результат.Штрихкоды, Код);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Штрихкоды узла JSON: barcodes - строки или {barcode}, плюс barcode. Только цифры.
//
Функция ШтрихкодыУзла(Узел)

	Результат = Новый Массив;
	ДобавитьКод(Результат, ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Узел, "barcode", "")));
	Для Каждого Элемент Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Узел, "barcodes")) Цикл
		Если ТипЗнч(Элемент) = Тип("Строка") Тогда
			ДобавитьКод(Результат, Элемент);
		Иначе
			ДобавитьКод(Результат, ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "barcode", "")));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьКод(Коды, Значение)

	Код = ТолькоЦифры(Значение);
	Если ЗначениеЗаполнено(Код) И Коды.Найти(Код) = Неопределено Тогда
		Коды.Добавить(Код);
	КонецЕсли;

КонецПроцедуры

// Разбор штрихкодов с учётом того, что коробка известна точно (единица Далиона).
// Без ШтрихкодыКоробки - по виду GTIN (РазобратьШтрихкоды), как раньше.
//
// Возвращаемое значение:
//   Структура - см. РазобратьШтрихкоды
//
Функция РазобратьШтрихкодыДанных(ДанныеУпаковки) Экспорт

	Если НЕ ДанныеУпаковки.Свойство("ШтрихкодыКоробки")
		ИЛИ ДанныеУпаковки.ШтрихкодыКоробки.Количество() = 0 Тогда
		Возврат РазобратьШтрихкоды(ДанныеУпаковки.Штрихкоды);
	КонецЕсли;

	Результат = Новый Структура("Штука, Коробка, Лишние", "", "", Новый Массив);
	Для Каждого Код Из ДанныеУпаковки.ШтрихкодыКоробки Цикл
		Если Результат.Коробка = "" Тогда
			Результат.Коробка = Код;
		ИначеЕсли Результат.Лишние.Найти(Код) = Неопределено Тогда
			Результат.Лишние.Добавить(Код);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Код Из ДанныеУпаковки.Штрихкоды Цикл
		Если ДанныеУпаковки.ШтрихкодыКоробки.Найти(Код) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Штрихкод другой упаковки (блок, вторая коробка) - не штука
		Если ЭтоШтрихкодКоробки(Код) Тогда
			Если Результат.Лишние.Найти(Код) = Неопределено Тогда
				Результат.Лишние.Добавить(Код);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		КодШтуки = ?(СтрДлина(Код) = 14 И СтрНачинаетсяС(Код, "0"), Сред(Код, 2), Код);
		Если Результат.Штука = "" Тогда
			Результат.Штука = КодШтуки;
		ИначеЕсли Результат.Штука <> КодШтуки И Результат.Лишние.Найти(КодШтуки) = Неопределено Тогда
			Результат.Лишние.Добавить(КодШтуки);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Коэффициент упаковки и все штрихкоды строки по приходной Далиона (ratio строки).
//
// Возвращаемое значение:
//   Структура - Коэффициент (Число, 1 - упаковки нет), Штрихкоды (Массив из Строка)
//
Функция ДанныеУпаковкиИзПрихода(Штрихкод)

	Результат = Новый Структура("Коэффициент, Штрихкоды", 1, Новый Массив);

	Для Каждого Часть Из СтрРазделить(СтрЗаменить(СокрЛП(Штрихкод), ",", ";"), ";", Ложь) Цикл
		Код = ТолькоЦифры(Часть);
		Если ЗначениеЗаполнено(Код) И Результат.Штрихкоды.Найти(Код) = Неопределено Тогда
			Результат.Штрихкоды.Добавить(Код);
		КонецЕсли;
	КонецЦикла;

	Если Результат.Штрихкоды.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Искомые = Новый Соответствие;
	Для Каждого Код Из Результат.Штрихкоды Цикл
		Для Каждого Вариант Из ЭАрМ_ПодборНоменклатуры.ВариантыШтрихкода(Код) Цикл
			Искомые.Вставить(Вариант, Истина);
		КонецЦикла;
	КонецЦикла;

	Варианты = Новый Массив;
	Для Каждого КлючЗначение Из Искомые Цикл
		Варианты.Добавить(КлючЗначение.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 5
	|	Реестр.ИдентификаторПоступления КАК Поступление,
	|	Реестр.ДатаОбновления КАК ДатаОбновления
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр
	|ГДЕ
	|	Реестр.Штрихкод В (&Штрихкоды)
	|	И Реестр.ИдентификаторПоступления <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОбновления УБЫВ";
	Запрос.УстановитьПараметр("Штрихкоды", Варианты);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Попытка
			ПозицииПрихода = ЭАрМ_ЦепочкаЗакупки.ПозицииПоступления(Выборка.Поступление);
		Исключение
			Продолжить;
		КонецПопытки;

		Для Каждого ПозицияПрихода Из ПозицииПрихода Цикл

			Если НЕ ПозицияСодержитШтрихкод(ПозицияПрихода, Искомые) Тогда
				Продолжить;
			КонецЕсли;

			Коэффициент = ?(ПозицияПрихода.Свойство("Коэффициент"), ПозицияПрихода.Коэффициент, 1);
			Если Коэффициент < 2 ИЛИ Коэффициент > 1000 ИЛИ Коэффициент <> Окр(Коэффициент, 0) Тогда
				// Упаковки нет: прежнее поведение, один штрихкод строки
				Возврат Результат;
			КонецЕсли;

			Результат.Коэффициент = Коэффициент;
			Для Каждого КодПозиции Из ПозицияПрихода.Штрихкоды Цикл
				Код = ТолькоЦифры(КодПозиции);
				Если ЗначениеЗаполнено(Код) И Результат.Штрихкоды.Найти(Код) = Неопределено Тогда
					Результат.Штрихкоды.Добавить(Код);
				КонецЕсли;
			КонецЦикла;
			Возврат Результат;

		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// GTIN-14 с индикатором 1-8 - штрихкод коробки. С нулём впереди это EAN-13.
//
Функция ЭтоШтрихкодКоробки(Код) Экспорт

	Возврат СтрДлина(Код) = 14 И СтрНайти("12345678", Лев(Код, 1)) > 0;

КонецФункции

// Делит штрихкоды строки на штуку и коробку.
//
// Возвращаемое значение:
//   Структура - Штука, Коробка (Строка, пусто - нет), Лишние (Массив из Строка:
//               ещё штрихкоды, штука это или блок - неизвестно)
//
Функция РазобратьШтрихкоды(Коды) Экспорт

	Результат = Новый Структура("Штука, Коробка, Лишние", "", "", Новый Массив);

	Для Каждого Код Из Коды Цикл

		Если ЭтоШтрихкодКоробки(Код) Тогда
			Если Результат.Коробка = "" Тогда
				Результат.Коробка = Код;
			ИначеЕсли Результат.Коробка <> Код Тогда
				Результат.Лишние.Добавить(Код);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если СтрДлина(Код) = 14 И СтрНачинаетсяС(Код, "0") Тогда
			Код = Сред(Код, 2);
		КонецЕсли;

		Если Результат.Штука = "" Тогда
			Результат.Штука = Код;
		ИначеЕсли Результат.Штука <> Код И Результат.Лишние.Найти(Код) = Неопределено Тогда
			Результат.Лишние.Добавить(Код);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Готовит ещё не записанную карточку: включает упаковки и подставляет набор.
// Вызывается до проверки заполнения. Упаковка в общем наборе уже создана,
// индивидуальная создаётся после записи карточки (ЗавершитьКарточку).
//
// Параметры:
//   Объект          - СправочникОбъект.Номенклатура
//   ДанныеУпаковки  - Структура - ДанныеУпаковкиТовара
//   Итог            - Структура - Сообщения (Массив)
//
// Возвращаемое значение:
//   Структура - Применена (Булево), Набор (общий набор или Неопределено)
//
Функция ПодготовитьКарточку(Объект, ДанныеУпаковки, Итог) Экспорт

	Результат = Новый Структура("Применена, Набор", Ложь, Неопределено);

	Если ДанныеУпаковки.Коэффициент < 2 Тогда
		Возврат Результат;
	КонецЕсли;

	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУпаковкиНоменклатуры") Тогда
		ДобавитьСообщение(Итог, СтрШаблон("%1: упаковки выключены (НСИ и администрирование - Настройки номенклатуры - Использовать упаковки), коробка на %2 шт не создана",
			Объект.Наименование, ДанныеУпаковки.Коэффициент));
		Возврат Результат;
	КонецЕсли;

	Если НЕ ЕдиницаШтучная(Объект.ЕдиницаИзмерения) Тогда
		ДобавитьСообщение(Итог, СтрШаблон("%1: единица хранения «%2» не штучная, коробка на %3 шт не создана",
			Объект.Наименование, Объект.ЕдиницаИзмерения, ДанныеУпаковки.Коэффициент));
		Возврат Результат;
	КонецЕсли;

	Если ТиповойКоэффициент(ДанныеУпаковки.Коэффициент) Тогда
		Набор = НаборДляКоробки(ДанныеУпаковки.Коэффициент, Итог);
		Если Набор = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		Объект.НаборУпаковок = Набор;
		Результат.Набор = Набор;
	Иначе
		Объект.НаборУпаковок = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры;
	КонецЕсли;

	Объект.ИспользоватьУпаковки = Истина;
	Результат.Применена = Истина;

	Возврат Результат;

КонецФункции

// После записи новой карточки: упаковка (если нужна индивидуальная) и
// штрихкоды штуки и коробки. Вызывается внутри транзакции создания.
//
// Возвращаемое значение:
//   Строка - штрихкод штуки (для сопоставления с ЕГАИС), может быть пустым
//
Функция ЗавершитьКарточку(Номенклатура, Подготовка, ДанныеУпаковки, Итог) Экспорт

	Упаковка = Неопределено;
	Если Подготовка.Применена Тогда
		Если Подготовка.Набор <> Неопределено Тогда
			Упаковка = НайтиУпаковку(Подготовка.Набор, ДанныеУпаковки.Коэффициент);
		Иначе
			Упаковка = НайтиИлиСоздатьУпаковку(Номенклатура, ДанныеУпаковки.Коэффициент, Итог);
		КонецЕсли;
	КонецЕсли;

	Разобранные = РазобратьШтрихкодыДанных(ДанныеУпаковки);
	ЗаписатьШтрихкодыКарточки(Номенклатура, Упаковка, Разобранные, Итог, Истина);

	Возврат Разобранные.Штука;

КонецФункции

// Карточка уже есть (найдена по штрихкоду или загружена из сервиса): если
// строка приходит коробками, добавляет упаковку и штрихкоды. Расхождение
// коэффициента не перезаписывает - только сообщение.
//
// Возвращаемое значение:
//   Булево - строка с упаковкой, штрихкоды записаны здесь; Ложь - упаковки нет,
//            штрихкод пишет вызывающий как раньше
//
Функция ОбеспечитьДляСуществующей(Номенклатура, Штрихкод, Итог) Экспорт

	ДанныеУпаковки = ДанныеУпаковкиТовара(Штрихкод);
	Если ДанныеУпаковки.Коэффициент < 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	Упаковка = Неопределено;
	Владелец = ВладелецУпаковок(Номенклатура, Итог);
	Если Владелец <> Неопределено Тогда
		Упаковка = НайтиУпаковку(Владелец, ДанныеУпаковки.Коэффициент);
		Если НЕ ЗначениеЗаполнено(Упаковка) Тогда
			Если Владелец = Номенклатура Тогда
				Упаковка = НайтиИлиСоздатьУпаковку(Номенклатура, ДанныеУпаковки.Коэффициент, Итог);
			Иначе
				ДобавитьСообщение(Итог, СтрШаблон("%1: в наборе упаковок «%2» нет коробки на %3 шт - добавьте упаковку вручную",
					Номенклатура, Владелец, ДанныеУпаковки.Коэффициент));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ЗаписатьШтрихкодыКарточки(Номенклатура, Упаковка, РазобратьШтрихкодыДанных(ДанныеУпаковки), Итог, Ложь);

	Возврат Истина;

КонецФункции

// Массовое обновление упаковок существующей номенклатуры по приходным Далиона.
// Сначала запускается проверка (ТолькоПроверка = Истина): что сходится, что
// будет добавлено, что расходится. Запись - каждая карточка в своей транзакции.
// Расхождение коэффициента, общий набор без нужной коробки и чужой штрихкод
// не правятся - только сообщение.
//
// Параметры:
//   Товары         - Массив из Структура - НоменклатураУИД, Штрихкод, Наименование
//   ТолькоПроверка - Булево - ничего не писать
//
// Возвращаемое значение:
//   Структура - Проверено, БезУпаковки, Совпало, ТребуетОбновления, Обновлено,
//               Расхождений, Пропущено, Ошибок (Число), Сообщения (Массив из Строка)
//
Функция ОбновитьУпаковкиНоменклатуры(Товары, ТолькоПроверка = Истина) Экспорт

	Итог = Новый Структура("Проверено, БезУпаковки, Совпало, ТребуетОбновления, Обновлено, Расхождений, Пропущено, Ошибок, Сообщения",
		0, 0, 0, 0, 0, 0, 0, 0, Новый Массив);

	Для Каждого Товар Из Товары Цикл

		Итог.Проверено = Итог.Проверено + 1;

		Попытка

			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Товар.НоменклатураУИД));
			Статус = СостояниеУпаковки(Номенклатура, ДанныеУпаковкиТовара(Товар.Штрихкод));

			Если Статус.Код = "НетУпаковки" Тогда
				Итог.БезУпаковки = Итог.БезУпаковки + 1;
				Продолжить;
			ИначеЕсли Статус.Код = "Есть" Тогда
				Итог.Совпало = Итог.Совпало + 1;
				Продолжить;
			ИначеЕсли Статус.Код = "Расхождение" Тогда
				Итог.Расхождений = Итог.Расхождений + 1;
				ДобавитьСообщение(Итог, Товар.Наименование + ": " + Статус.Текст);
				Продолжить;
			ИначеЕсли Статус.Код = "Пропуск" Тогда
				Итог.Пропущено = Итог.Пропущено + 1;
				ДобавитьСообщение(Итог, Товар.Наименование + ": " + Статус.Текст);
				Продолжить;
			КонецЕсли;

			Итог.ТребуетОбновления = Итог.ТребуетОбновления + 1;
			Если ТолькоПроверка Тогда
				ДобавитьСообщение(Итог, Товар.Наименование + ": будет сделано - " + Статус.Текст);
				Продолжить;
			КонецЕсли;

			НачатьТранзакцию();
			Попытка
				ОбеспечитьДляСуществующей(Номенклатура, Товар.Штрихкод, Итог);
				ЗафиксироватьТранзакцию();
			Исключение
				ОтменитьТранзакцию();
				ВызватьИсключение;
			КонецПопытки;
			Итог.Обновлено = Итог.Обновлено + 1;

		Исключение
			Итог.Ошибок = Итог.Ошибок + 1;
			ДобавитьСообщение(Итог, Товар.Наименование + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область Упаковки

// Что сейчас с упаковкой карточки относительно прихода Далиона.
//
// Возвращаемое значение:
//   Структура - Код (НетУпаковки, Есть, ДобавитьУпаковку, ДобавитьШтрихкод,
//               Расхождение, Пропуск), Текст
//
Функция СостояниеУпаковки(Номенклатура, ДанныеУпаковки)

	Коэффициент = ДанныеУпаковки.Коэффициент;

	Если Коэффициент < 2 Тогда
		Возврат НовоеСостояние("НетУпаковки", "в приходе Далиона упаковки нет");
	КонецЕсли;

	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУпаковкиНоменклатуры") Тогда
		Возврат НовоеСостояние("Пропуск", "упаковки выключены в УТ");
	КонецЕсли;

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура,
		"ИспользоватьУпаковки, НаборУпаковок, ЕдиницаИзмерения");
	ОбщийНабор = Реквизиты.ИспользоватьУпаковки = Истина
		И ЗначениеЗаполнено(Реквизиты.НаборУпаковок)
		И Реквизиты.НаборУпаковок <> Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры;

	Если НЕ ОбщийНабор И НЕ ЕдиницаШтучная(Реквизиты.ЕдиницаИзмерения) Тогда
		Возврат НовоеСостояние("Пропуск", СтрШаблон("единица хранения «%1» не штучная", Реквизиты.ЕдиницаИзмерения));
	КонецЕсли;

	Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	Если ОбщийНабор Тогда
		Упаковка = НайтиУпаковку(Реквизиты.НаборУпаковок, Коэффициент);
	ИначеЕсли Реквизиты.ИспользоватьУпаковки = Истина Тогда
		Упаковка = НайтиУпаковку(Номенклатура, Коэффициент);
	КонецЕсли;

	Коробка = РазобратьШтрихкодыДанных(ДанныеУпаковки).Коробка;
	Запись = ?(ЗначениеЗаполнено(Коробка), ЗаписьШтрихкода(Коробка), Неопределено);

	Если Запись <> Неопределено Тогда
		Если Запись.Номенклатура <> Номенклатура Тогда
			Возврат НовоеСостояние("Пропуск", СтрШаблон("штрихкод коробки %1 уже у «%2»", Коробка, Запись.Номенклатура));
		КонецЕсли;
		Если ЗначениеЗаполнено(Запись.Упаковка) Тогда
			Размер = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Запись.Упаковка, "Числитель, Знаменатель");
			Если Размер.Знаменатель <> 0 И Размер.Числитель / Размер.Знаменатель <> Коэффициент Тогда
				Возврат НовоеСостояние("Расхождение", СтрШаблон("в УТ коробка на %1 шт, в документе на %2",
					Формат(Размер.Числитель / Размер.Знаменатель, "ЧГ=0"), Формат(Коэффициент, "ЧГ=0")));
			КонецЕсли;
			Возврат НовоеСостояние("Есть", "");
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Упаковка) Тогда
		Если ЗначениеЗаполнено(Коробка) Тогда
			Возврат НовоеСостояние("ДобавитьШтрихкод", СтрШаблон("записать штрихкод коробки %1 на упаковку", Коробка));
		КонецЕсли;
		Возврат НовоеСостояние("Есть", "");
	КонецЕсли;

	Если ОбщийНабор Тогда
		Возврат НовоеСостояние("Пропуск", СтрШаблон("в наборе упаковок «%1» нет коробки на %2 шт - добавьте вручную",
			Реквизиты.НаборУпаковок, Формат(Коэффициент, "ЧГ=0")));
	КонецЕсли;

	Возврат НовоеСостояние("ДобавитьУпаковку", СтрШаблон("создать упаковку на %1 шт%2",
		Формат(Коэффициент, "ЧГ=0"), ?(ЗначениеЗаполнено(Коробка), " и записать штрихкод коробки " + Коробка, "")));

КонецФункции

Функция НовоеСостояние(Код, Текст)

	Возврат Новый Структура("Код, Текст", Код, Текст);

КонецФункции

// Запись штрихкода в регистре штрихкодов номенклатуры.
//
// Возвращаемое значение:
//   Структура - Номенклатура, Упаковка; Неопределено - штрихкода нет
//
Функция ЗаписьШтрихкода(Штрихкод)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Штрихкоды.Номенклатура КАК Номенклатура,
	|	Штрихкоды.Упаковка КАК Упаковка
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод = &Штрихкод";
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Номенклатура, Упаковка", Выборка.Номенклатура, Выборка.Упаковка);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Набор упаковок существующей карточки, в котором лежат (или будут лежать)
// коробки. Общий набор не трогается. Если упаковок у карточки ещё нет,
// включается индивидуальный набор.
//
// Возвращаемое значение:
//   СправочникСсылка.НаборыУпаковок, СправочникСсылка.Номенклатура, Неопределено
//
Функция ВладелецУпаковок(Номенклатура, Итог)

	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУпаковкиНоменклатуры") Тогда
		ДобавитьСообщение(Итог, СтрШаблон("%1: упаковки выключены (НСИ и администрирование - Настройки номенклатуры - Использовать упаковки)", Номенклатура));
		Возврат Неопределено;
	КонецЕсли;

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура,
		"ИспользоватьУпаковки, НаборУпаковок, ЕдиницаИзмерения");
	Индивидуальный = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры;

	Если Реквизиты.ИспользоватьУпаковки = Истина
		И ЗначениеЗаполнено(Реквизиты.НаборУпаковок)
		И Реквизиты.НаборУпаковок <> Индивидуальный Тогда
		Возврат Реквизиты.НаборУпаковок;
	КонецЕсли;

	Если НЕ ЕдиницаШтучная(Реквизиты.ЕдиницаИзмерения) Тогда
		ДобавитьСообщение(Итог, СтрШаблон("%1: единица хранения «%2» не штучная, упаковка не создана", Номенклатура, Реквизиты.ЕдиницаИзмерения));
		Возврат Неопределено;
	КонецЕсли;

	Если Реквизиты.ИспользоватьУпаковки <> Истина ИЛИ Реквизиты.НаборУпаковок <> Индивидуальный Тогда
		Объект = Номенклатура.ПолучитьОбъект();
		Объект.ИспользоватьУпаковки = Истина;
		Объект.НаборУпаковок = Индивидуальный;
		ПолучитьСообщенияПользователю(Истина);
		Объект.Записать();
	КонецЕсли;

	Возврат Номенклатура;

КонецФункции

// Общий набор «Коробка N шт» с упаковкой на N штук; создаётся, если нет.
//
// Возвращаемое значение:
//   СправочникСсылка.НаборыУпаковок, Неопределено (причина в сообщениях)
//
Функция НаборДляКоробки(Коэффициент, Итог)

	Единицы = ЕдиницыКоробкиИШтуки(Итог);
	Если Единицы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Наименование = СтрШаблон("Коробка %1 шт", Формат(Коэффициент, "ЧГ=0"));
	Набор = Справочники.НаборыУпаковок.НайтиПоНаименованию(Наименование, Истина);

	Если НЕ ЗначениеЗаполнено(Набор) Тогда
		НаборОбъект = Справочники.НаборыУпаковок.СоздатьЭлемент();
		НаборОбъект.Наименование = Наименование;
		НаборОбъект.ЕдиницаИзмерения = Единицы.Штука;
		НаборОбъект.ЕдиницаДляОтчетов = Единицы.Штука;
		НаборОбъект.КоэффициентЕдиницыДляОтчетов = 1;
		НаборОбъект.Записать();
		Набор = НаборОбъект.Ссылка;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(НайтиУпаковку(Набор, Коэффициент)) Тогда
		СоздатьУпаковку(Набор, Коэффициент, Единицы);
	КонецЕсли;

	Возврат Набор;

КонецФункции

Функция НайтиИлиСоздатьУпаковку(Владелец, Коэффициент, Итог)

	Упаковка = НайтиУпаковку(Владелец, Коэффициент);
	Если ЗначениеЗаполнено(Упаковка) Тогда
		Возврат Упаковка;
	КонецЕсли;

	Единицы = ЕдиницыКоробкиИШтуки(Итог);
	Если Единицы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СоздатьУпаковку(Владелец, Коэффициент, Единицы);

КонецФункции

// Коробка (упаковка типа «Конечная») на заданное число штук.
//
Функция НайтиУпаковку(Владелец, Коэффициент)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Упаковки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК Упаковки
	|ГДЕ
	|	Упаковки.Владелец = &Владелец
	|	И НЕ Упаковки.ПометкаУдаления
	|	И Упаковки.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Упаковка)
	|	И Упаковки.ТипУпаковки = ЗНАЧЕНИЕ(Перечисление.ТипыУпаковокНоменклатуры.Конечная)
	|	И Упаковки.Числитель = &Числитель
	|	И Упаковки.Знаменатель = 1";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Числитель", Коэффициент);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();

КонецФункции

Функция СоздатьУпаковку(Владелец, Коэффициент, Единицы)

	Объект = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
	Объект.Владелец = Владелец;
	Объект.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Упаковка;
	Объект.ТипУпаковки = Перечисления.ТипыУпаковокНоменклатуры.Конечная;
	Объект.ЕдиницаИзмерения = Единицы.Коробка;
	Объект.Числитель = Коэффициент;
	Объект.Знаменатель = 1;
	Объект.Безразмерная = Истина;
	Объект.Наименование = Справочники.УпаковкиЕдиницыИзмерения.СформироватьНаименование(
		Перечисления.ТипыУпаковокНоменклатуры.Конечная, Единицы.Коробка, Коэффициент, 1, Единицы.Штука);
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

// Штука и коробка из классификатора единиц УТ (ОКЕИ: 796 штука, 8751 коробка,
// запасной вариант 778 упаковка).
//
Функция ЕдиницыКоробкиИШтуки(Итог)

	Единицы = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("796,8751");
	Штука = Единицы.Получить("796");
	Коробка = Единицы.Получить("8751");

	Если Коробка = Неопределено Тогда
		Запасные = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("778");
		Коробка = Запасные.Получить("778");
	КонецЕсли;

	Если Штука = Неопределено ИЛИ Коробка = Неопределено Тогда
		ДобавитьСообщение(Итог, "В классификаторе единиц УТ нет штуки (796) или коробки (8751) / упаковки (778) - упаковка не создана");
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Штука, Коробка", Штука, Коробка);

КонецФункции

Функция ЕдиницаШтучная(Единица)

	Если НЕ ЗначениеЗаполнено(Единица) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Единица, "ТипИзмеряемойВеличины")
		= Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук;

КонецФункции

Функция ТиповойКоэффициент(Коэффициент)

	Возврат СтрРазделить("6,10,12,20,24", ",").Найти(Формат(Коэффициент, "ЧГ=0")) <> Неопределено;

КонецФункции

#КонецОбласти

#Область Штрихкоды

// Пишет штрихкод штуки на карточку и штрихкод коробки на упаковку.
// Уже занятый чужой карточкой штрихкод при создании - исключение (откат
// транзакции), при обновлении - сообщение.
//
Процедура ЗаписатьШтрихкодыКарточки(Номенклатура, Упаковка, Разобранные, Итог, ЗанятыйОшибка)

	Если ЗначениеЗаполнено(Разобранные.Штука) Тогда
		ЗаписатьШтрихкодУпаковки(Номенклатура, Разобранные.Штука, Неопределено, Итог, ЗанятыйОшибка);
	КонецЕсли;

	Если ЗначениеЗаполнено(Разобранные.Коробка) Тогда
		Если ЗначениеЗаполнено(Упаковка) Тогда
			ЗаписатьШтрихкодУпаковки(Номенклатура, Разобранные.Коробка, Упаковка, Итог, ЗанятыйОшибка);
		Иначе
			ДобавитьСообщение(Итог, СтрШаблон("%1: штрихкод коробки %2 не записан - упаковки нет", Номенклатура, Разобранные.Коробка));
		КонецЕсли;
	КонецЕсли;

	Для Каждого Код Из Разобранные.Лишние Цикл
		ДобавитьСообщение(Итог, СтрШаблон("%1: штрихкод %2 не записан - штука это или блок, добавьте вручную", Номенклатура, Код));
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьШтрихкодУпаковки(Номенклатура, Штрихкод, Упаковка, Итог, ЗанятыйОшибка)

	Менеджер = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
	Менеджер.Штрихкод = Штрихкод;
	Менеджер.Прочитать();

	Если Менеджер.Выбран() Тогда

		Если Менеджер.Номенклатура <> Номенклатура Тогда
			Текст = СтрШаблон("Штрихкод %1 уже принадлежит «%2»", Штрихкод, Менеджер.Номенклатура);
			Если ЗанятыйОшибка Тогда
				ВызватьИсключение Текст;
			КонецЕсли;
			ДобавитьСообщение(Итог, Текст);
			Возврат;
		КонецЕсли;

		Если ЗначениеЗаполнено(Упаковка) И Менеджер.Упаковка <> Упаковка Тогда
			Если ЗначениеЗаполнено(Менеджер.Упаковка) Тогда
				ДобавитьСообщение(Итог, СтрШаблон("%1: штрихкод %2 уже привязан к упаковке «%3», не перезаписан",
					Номенклатура, Штрихкод, Менеджер.Упаковка));
				Возврат;
			КонецЕсли;
			Менеджер.Упаковка = Упаковка;
			Менеджер.Записать();
		КонецЕсли;

		Возврат;

	КонецЕсли;

	Менеджер.Штрихкод = Штрихкод;
	Менеджер.Номенклатура = Номенклатура;
	Если ЗначениеЗаполнено(Упаковка) Тогда
		Менеджер.Упаковка = Упаковка;
	КонецЕсли;
	Менеджер.Записать();

КонецПроцедуры

Функция ПозицияСодержитШтрихкод(Позиция, Искомые)

	Если НЕ Позиция.Свойство("Штрихкоды") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Код Из Позиция.Штрихкоды Цикл
		Для Каждого Вариант Из ЭАрМ_ПодборНоменклатуры.ВариантыШтрихкода(Код) Цикл
			Если Искомые.Получить(Вариант) <> Неопределено Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ТолькоЦифры(Значение)

	Результат = "";
	Текст = Строка(Значение);
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьСообщение(Итог, Текст)

	Если Итог.Сообщения.Количество() < 100 Тогда
		Итог.Сообщения.Добавить(Текст);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
