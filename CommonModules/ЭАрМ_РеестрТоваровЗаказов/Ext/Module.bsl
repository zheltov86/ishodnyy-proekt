////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_РеестрТоваровЗаказов: реестр товаров по заказам поставщику.
//
// Одна запись регистра ЭАрМ_РеестрТоваровЗаказов - одна линия сверки цепочки:
// товар заказа Далиона и то, что по нему пришло приходной накладной и УПД,
// с признаком маркировки, кодами Честного знака и ЕГАИС и штрихкодом,
// подобранным в УТ. Обработка
// ЭАрМ_РеестрТоваровЗаказов показывает реестр деревом:
//   склад -> заказ поставщику (поставка) -> товары.
//
// Реестр пишут:
//   * сверка цепочки          - ЭАрМ_СверкаТоваровЦепочки.СверитьЦепочку;
//   * приём заказа без поставок - ЭАрМ_ЦепочкаЗакупки.ОбновитьПоЗаказу;
//   * загрузчик               - ОбновитьРеестр, пересверка цепочек периода.
// Удаление цепочки удаляет и её строки реестра.
//
// Здесь же загрузка файлов штрихкодов поставщика в ЭАрМ_ШтрихкодыПоставщиков -
// то, что делала внешняя обработка ЗагрузкаШтрихкодов в базе Далиона.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Загрузчик реестра: пересверяет цепочки, у которых заказ или поступление
// попадает в период, и пересобирает их строки.
//
// Цепочка с поставкой проходит полную сверку, чтобы реестр, регистр сверки и
// этап цепочки не разошлись. Заказ без поставок только кладёт свои строки.
//
// Параметры:
//   ДатаНачала    - Дата - пустая: без ограничения снизу
//   ДатаОкончания - Дата - пустая: без ограничения сверху
//
// Возвращаемое значение:
//   Структура - Цепочек, Строк, Ошибок, Сообщения (Массив из Строка)
//
Функция ОбновитьРеестр(Знач ДатаНачала = '00010101', Знач ДатаОкончания = '00010101') Экспорт

	Итоги = Новый Структура("Цепочек, Строк, Ошибок, Сообщения", 0, 0, 0, Новый Массив);

	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = '39991231';
	КонецЕсли;
	ДатаОкончания = КонецДня(ДатаОкончания);

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	(Цепочка.ДатаЗаказа МЕЖДУ &ДатаНачала И &ДатаОкончания
	|			ИЛИ Цепочка.ДатаПоступления МЕЖДУ &ДатаНачала И &ДатаОкончания)";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Попытка

			Если ЗначениеЗаполнено(Выборка.ИдентификаторПоступления) Тогда
				//@skip-check query-in-loop
				ЭАрМ_СверкаТоваровЦепочки.СверитьЦепочку(Выборка.ИдентификаторЗаказа,
					Выборка.ИдентификаторПоступления, Настройки);
			Иначе
				//@skip-check query-in-loop
				ОбновитьПоЦепочке(Выборка.ИдентификаторЗаказа, "", Настройки);
			КонецЕсли;

			Итоги.Цепочек = Итоги.Цепочек + 1;

		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(
				?(ЗначениеЗаполнено(Выборка.ИдентификаторПоступления), Выборка.ИдентификаторПоступления,
					Выборка.ИдентификаторЗаказа),
				"ОбновитьРеестр (пересчёт реестра товаров цепочки)", ОшибкаИсключения);
			Итоги.Ошибок = Итоги.Ошибок + 1;
			Итоги.Сообщения.Добавить(Лев(СтрШаблон("%1 / %2: %3",
				Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления,
				ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения)), 300));
		КонецПопытки;

	КонецЦикла;

	Итоги.Строк = КоличествоСтрокРеестра(ДатаНачала, ДатаОкончания);

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", ОперацияЖурнала(), Итоги.Ошибок = 0,
		СтрШаблон("Реестр товаров обновлён: цепочек %1, строк %2, ошибок %3. %4",
			Итоги.Цепочек, Итоги.Строк, Итоги.Ошибок, СтрСоединить(Итоги.Сообщения, "; ")));

	Возврат Итоги;

КонецФункции

// Пересобирает строки реестра одной цепочки.
//
// Параметры:
//   ИдентификаторЗаказа      - Строка - uid заказа Далиона или "ПН:<uid>"
//   ИдентификаторПоступления - Строка - uid поступления; пусто у заказа без поставок
//   Настройки                - Структура, Неопределено - см. ЭАрМ_НастройкиСервер.НастройкиЦепочки
//   Линии                    - Массив, Неопределено - готовые линии сверки; не заданы - строятся
//
// Возвращаемое значение:
//   Число - записано строк
//
Функция ОбновитьПоЦепочке(ИдентификаторЗаказа, ИдентификаторПоступления, Настройки = Неопределено,
	Линии = Неопределено) Экспорт

	Шапка = ШапкаЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления);

	Если Шапка <> Неопределено И Линии = Неопределено Тогда
		Линии = ЭАрМ_СверкаТоваровЦепочки.ЛинииЦепочки(ИдентификаторЗаказа,
			ИдентификаторПоступления, Настройки);
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.ЭАрМ_РеестрТоваровЗаказов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторЗаказа.Установить(ИдентификаторЗаказа);
	НаборЗаписей.Отбор.ИдентификаторПоступления.Установить(ИдентификаторПоступления);

	// Цепочки больше нет - её строки просто удаляются
	Если Шапка = Неопределено ИЛИ Линии = Неопределено Тогда
		НаборЗаписей.Записать(Истина);
		Возврат 0;
	КонецЕсли;

	ЕстьПоставка   = ЗначениеЗаполнено(ИдентификаторПоступления);
	ДатаОбновления = ТекущаяДатаСеанса();
	// ТН ВЭД и признак алкоголя строк УПД - для категории товара (ЭАрМ_КатегорииТоваров)
	ПризнакиУПД = Неопределено;
	Попытка
		ИдентификаторУПДЦепочки = "";
		Шапка.Свойство("ИдентификаторУПД", ИдентификаторУПДЦепочки);
		ПризнакиУПД = ЭАрМ_КатегорииТоваров.ПризнакиПозицийУПД(ИдентификаторУПДЦепочки);
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ОбновитьПоЦепочке (признаки позиций УПД для категории товара не получены)", ИнформацияОбОшибке());
		ПризнакиУПД = Неопределено;
	КонецПопытки;

	Для Каждого Линия Из Линии Цикл

		// В реестр идут товары УПД и приходной, в том числе те, которых нет в одном из двух
		// (НетВУПД / НетВПоступлении). Строки только из ЭТрН или только из заказа при
		// пришедшей поставке в реестр не заводятся
		Если ЕстьПоставка И Линия.УПД = Неопределено И Линия.Поступление = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СтрокаДалиона = ?(Линия.Заказ <> Неопределено, Линия.Заказ, Линия.Поступление);
		Подбор = ПодобранныйШтрихкод(Линия);

		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Шапка);

		Запись.ИдентификаторЗаказа      = ИдентификаторЗаказа;
		Запись.ИдентификаторПоступления = ИдентификаторПоступления;
		// НомерСтроки у записи регистра зарезервирован платформой - измерение ПозицияСтроки
		Запись.ПозицияСтроки            = Линия.НомерСтроки;
		Запись.Номенклатура             = Лев(НаименованиеЛинии(Линия), 500);

		Если СтрокаДалиона <> Неопределено Тогда
			Запись.КодНоменклатуры           = Лев(СтрокаДалиона.Код, 50);
			Запись.ИдентификаторНоменклатуры = Лев(СтрокаДалиона.ИдентификаторНоменклатуры, 36);
		КонецЕсли;

		Если Линия.Заказ <> Неопределено Тогда
			Запись.КоличествоЗаказа = Линия.Заказ.Количество;
			Запись.ЦенаЗаказа       = Линия.Заказ.Цена;
		КонецЕсли;
		Если Линия.Поступление <> Неопределено Тогда
			Запись.КоличествоПН = Линия.Поступление.Количество;
			Запись.ЦенаПН       = Линия.Поступление.Цена;
		КонецЕсли;
		Если Линия.УПД <> Неопределено Тогда
			Запись.КоличествоУПД = Линия.УПД.Количество;
			Запись.ЦенаУПД       = Линия.УПД.Цена;
		КонецЕсли;

		МаркиСтроки = МаркиЛинии(Линия);
		Запись.Маркируемый       = Маркирована(Линия.УПД) ИЛИ Маркирована(Линия.ЭТрН)
			ИЛИ Маркирована(Линия.Поступление)
			ИЛИ ЗначениеЗаполнено(МаркиСтроки.ЧестныйЗнак) ИЛИ ЗначениеЗаполнено(МаркиСтроки.ЕГАИС);
		Запись.МаркиЧестныйЗнак  = МаркиСтроки.ЧестныйЗнак;
		Запись.МаркиЕГАИС        = МаркиСтроки.ЕГАИС;
		Запись.Штрихкод          = Лев(Подбор.Штрихкод, 200);
		Запись.СпособПодбораШК = Лев(Подбор.Способ, 20);
		Запись.СпособСопоставления = Лев(Линия.Способ, 20);
		// У заказа без поставок сверять нечего: "Совпадает" вводило бы в заблуждение
		Запись.Результат       = Лев(?(ЕстьПоставка, Линия.Результат, "ОжидаетПоставки"), 30);
		Запись.Комментарий     = Лев(Линия.Комментарий, 500);
		Запись.ДатаОбновления  = ДатаОбновления;
		// Какие строки УПД и прихода вошли в линию: по ним форма реестра УПД
		// показывает пары сверки, а не подбирает свои
		Запись.ПозицииУПД      = Лев(ЭАрМ_СверкаТоваровЦепочки.ПозицииСтрокиСтрокой(Линия.УПД), 200);
		Запись.СтрокиПН        = Лев(ЭАрМ_СверкаТоваровЦепочки.ПозицииСтрокиСтрокой(Линия.Поступление), 200);
		// Категория (алкоголь, пиво, молочная, фрукты, овощи) - подсказка для видов номенклатуры
		Запись.Категория       = Лев(ЭАрМ_КатегорииТоваров.КатегорияЛинии(Запись.Номенклатура,
			Запись.ПозицииУПД, ПризнакиУПД, Запись.МаркиЕГАИС), 30);
		// Честный знак: марки УПД/ЭТрН и прихода Далиона против штук
		Попытка
			СверкаМарок = ЭАрМ_ЧестныйЗнак.СверкаМарокЛинии(Линия);
			Запись.МарокУПД    = СверкаМарок.МарокУПД;
			Запись.МарокПН     = СверкаМарок.МарокПН;
			Запись.СверкаМарок = СверкаМарок.Текст;
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"ОбновитьПоЦепочке (сверка марок Честного знака по строке)", ОшибкаИсключения);
			Запись.СверкаМарок = Лев("⚠ сверка марок: " + КраткоеПредставлениеОшибки(ОшибкаИсключения), 100);
		КонецПопытки;

	КонецЦикла;

	НаборЗаписей.Записать(Истина);

	// Коды прихода Далиона - в регистр кодов маркировки строк
	Попытка
		ЭАрМ_ЧестныйЗнак.ЗаписатьКодыПрихода(ИдентификаторПоступления, Линии);
	Исключение
		ЗаписьЖурналаРегистрации("ЭАрМ.ЧестныйЗнак", УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат НаборЗаписей.Количество();

КонецФункции

// То же, что ОбновитьПоЦепочке, но без исключений: сбой реестра не должен
// останавливать сверку и приём пакетов. Ошибка уходит в журнал обмена, реестр
// догонит загрузчик. Внутри открытой транзакции не вызывать.
//
Процедура ОтразитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Линии = Неопределено,
	Настройки = Неопределено) Экспорт

	Объект = ?(ЗначениеЗаполнено(ИдентификаторПоступления), ИдентификаторПоступления, ИдентификаторЗаказа);
	Попытка
		Записано = ОбновитьПоЦепочке(ИдентификаторЗаказа, ИдентификаторПоступления, Настройки, Линии);
		ЭАрМ_ПриемПакетовДалион.Трасса(Объект, СтрШаблон(
			"Запись: ЭАрМ_РеестрТоваровЗаказов по цепочке записан - строк реестра %1 (строк сверки %2)",
			Записано, ?(ТипЗнч(Линии) = Тип("Массив"), Линии.Количество(), "не переданы")));

		// Набор читаем обратно: в реестре должно лежать ровно столько строк, сколько записали
		// (0 - законно: цепочки нет или строки только из ЭТрН/заказа)
		ЭАрМ_ПриемПакетовДалион.ПроверитьЗаписьРегистра(Объект, "ЭАрМ_РеестрТоваровЗаказов",
			Новый Структура("ИдентификаторЗаказа, ИдентификаторПоступления",
				ИдентификаторЗаказа, ИдентификаторПоступления), , Записано);
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(
			Лев(Объект, 100),
			ОперацияЖурнала(), Ложь,
			"Реестр товаров: " + ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения));
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(Объект,
			"ОтразитьЦепочку (ЭАрМ_РеестрТоваровЗаказов не записан)", ОшибкаИсключения);
	КонецПопытки;

КонецПроцедуры

// Удаляет строки реестра цепочки. Вызывается при удалении самой цепочки.
//
Процедура УдалитьРеестрЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления) Экспорт

	НаборЗаписей = РегистрыСведений.ЭАрМ_РеестрТоваровЗаказов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторЗаказа.Установить(ИдентификаторЗаказа);
	НаборЗаписей.Отбор.ИдентификаторПоступления.Установить(ИдентификаторПоступления);
	НаборЗаписей.Записать(Истина);

КонецПроцедуры

// Строки реестра товаров одной цепочки - готовые пары УПД и прихода Далиона.
// Форма списка УПД берёт отсюда количество и цену ПН, а не ищет приход заново.
//
// Параметры:
//   ИдентификаторЗаказа      - Строка
//   ИдентификаторПоступления - Строка
//   ИдентификаторУПД         - Строка - запасной отбор, если цепочки ещё нет
//
// Возвращаемое значение:
//   ТаблицаЗначений - Номенклатура, Штрихкод, количества и цены заказа/ПН/УПД, Результат
//
Функция СтрокиЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления, ИдентификаторУПД = "") Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реестр.ПозицияСтроки КАК ПозицияСтроки,
	|	Реестр.Номенклатура КАК Номенклатура,
	|	Реестр.Штрихкод КАК Штрихкод,
	|	Реестр.КоличествоЗаказа КАК КоличествоЗаказа,
	|	Реестр.ЦенаЗаказа КАК ЦенаЗаказа,
	|	Реестр.КоличествоПН КАК КоличествоПН,
	|	Реестр.ЦенаПН КАК ЦенаПН,
	|	Реестр.КоличествоУПД КАК КоличествоУПД,
	|	Реестр.ЦенаУПД КАК ЦенаУПД,
	|	Реестр.Результат КАК Результат,
	|	Реестр.Комментарий КАК Комментарий,
	|	Реестр.СпособСопоставления КАК СпособСопоставления,
	|	Реестр.ПозицииУПД КАК ПозицииУПД,
	|	Реестр.СтрокиПН КАК СтрокиПН
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр
	|ГДЕ
	|	(&ЕстьЦепочка
	|			И Реестр.ИдентификаторЗаказа = &Заказ
	|			И Реестр.ИдентификаторПоступления = &Приход
	|		ИЛИ НЕ &ЕстьЦепочка
	|			И Реестр.ИдентификаторУПД = &УПД)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПозицияСтроки";
	Запрос.УстановитьПараметр("ЕстьЦепочка",
		ЗначениеЗаполнено(ИдентификаторЗаказа) И ЗначениеЗаполнено(ИдентификаторПоступления));
	Запрос.УстановитьПараметр("Заказ", ИдентификаторЗаказа);
	Запрос.УстановитьПараметр("Приход", ИдентификаторПоступления);
	Запрос.УстановитьПараметр("УПД", ИдентификаторУПД);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Строки приходной и УПД, которые по итогу сверки цепочки не сошлись: для
// подсветки в форме приходной накладной.
//
// Не сошлись - критичные результаты линии: количество, цена, строка есть
// только в приходе или только в УПД. Замечания по заказу и ЭТрН сюда не идут.
//
// Возвращаемое значение:
//   Структура:
//     * СтрокиПН   - Соответствие - номер товара в пакете прихода (он же номер
//                    строки приходной) -> текст расхождения
//     * ПозицииУПД - Соответствие - номер позиции УПД -> текст расхождения
//
Функция НесошедшиесяСтроки(ИдентификаторПоступления) Экспорт

	Результат = Новый Структура("СтрокиПН, ПозицииУПД", Новый Соответствие, Новый Соответствие);

	Если НЕ ЗначениеЗаполнено(ИдентификаторПоступления) Тогда
		Возврат Результат;
	КонецЕсли;

	// Только по поступлению: у приходной без заказа ключ заказа цепочки -
	// «ПН:<uid>», в документе его может не быть
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реестр.Результат КАК Результат,
	|	Реестр.Комментарий КАК Комментарий,
	|	Реестр.СтрокиПН КАК СтрокиПН,
	|	Реестр.ПозицииУПД КАК ПозицииУПД
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр
	|ГДЕ
	|	Реестр.ИдентификаторПоступления = &ИдентификаторПоступления
	|	И Реестр.Результат В (&Критичные)";
	Запрос.УстановитьПараметр("ИдентификаторПоступления", ИдентификаторПоступления);
	Запрос.УстановитьПараметр("Критичные",
		СтрРазделить("Количество,Цена,НетВУПД,НетВПоступлении", ","));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Текст = СокрЛП(Выборка.Комментарий);
		Если НЕ ЗначениеЗаполнено(Текст) Тогда
			Текст = СокрЛП(Выборка.Результат);
		КонецЕсли;

		Для Каждого Часть Из СтрРазделить(СокрЛП(Выборка.СтрокиПН), ";", Ложь) Цикл
			Результат.СтрокиПН.Вставить(СокрЛП(Часть), Текст);
		КонецЦикла;
		Для Каждого Часть Из СтрРазделить(СокрЛП(Выборка.ПозицииУПД), ";", Ложь) Цикл
			Результат.ПозицииУПД.Вставить(СокрЛП(Часть), Текст);
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Реестр деревом для формы: склад (или поставщик) -> заказ (поставка) -> товары.
//
// Параметры:
//   ДатаНачала        - Дата
//   ДатаОкончания     - Дата - пустая: по текущую дату
//   ТолькоРасхождения - Булево - только товары с расхождениями
//   Отбор             - Структура, Неопределено - см. НовыйОтборДереваРеестра; не задан -
//                       группировка по складам без отборов, как раньше
//
// Возвращаемое значение:
//   ДеревоЗначений - колонки как у реквизита Дерево формы обработки
//
Функция ДеревоРеестра(Знач ДатаНачала, Знач ДатаОкончания, ТолькоРасхождения = Ложь, Отбор = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = ТекущаяДатаСеанса();
	КонецЕсли;

	ПараметрыОтбора = НовыйОтборДереваРеестра();
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, Отбор);
	КонецЕсли;
	ПоПоставщикам   = (ПараметрыОтбора.Группировка = "Поставщик");
	ПоОрганизациям  = (ПараметрыОтбора.Группировка = "Организация");

	Дерево = Новый ДеревоЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить(
		"Представление,Контрагент,ДокУПД,ДокПриход,Штрихкод,СпособСопоставления,"
		+ "КоличествоЗаказа,ЦенаЗаказа,КоличествоПН,ЦенаПН,КоличествоУПД,ЦенаУПД,"
		+ "Результат,Статус,Наполнение,Комментарий,ИдентификаторЗаказа,ИдентификаторПоступления,"
		+ "Расхождений,ЖдутПоставки,Новая,СтрокиПН,ЦенаИзмененная,ПодтвержденоВДалион,ЗапросВДалион,ВозможныйДубль", ",") Цикл
		Дерево.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реестр.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Реестр.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Реестр.ПозицияСтроки КАК ПозицияСтроки,
	|	Реестр.Склад КАК Склад,
	|	Реестр.Организация КАК Организация,
	|	Реестр.ИННОрганизации КАК ИННОрганизации,
	|	Реестр.НомерЗаказа КАК НомерЗаказа,
	|	Реестр.ДатаЗаказа КАК ДатаЗаказа,
	|	Реестр.Поставщик КАК Поставщик,
	|	Реестр.ИННПоставщика КАК ИННПоставщика,
	|	Реестр.НомерПоступления КАК НомерПоступления,
	|	Реестр.ДатаПоступления КАК ДатаПоступления,
	|	Реестр.НомерУПД КАК НомерУПД,
	|	Реестр.Номенклатура КАК Номенклатура,
	|	Реестр.Штрихкод КАК Штрихкод,
	|	Реестр.СпособСопоставления КАК СпособСопоставления,
	|	Реестр.КоличествоЗаказа КАК КоличествоЗаказа,
	|	Реестр.ЦенаЗаказа КАК ЦенаЗаказа,
	|	Реестр.КоличествоПН КАК КоличествоПН,
	|	Реестр.ЦенаПН КАК ЦенаПН,
	|	Реестр.КоличествоУПД КАК КоличествоУПД,
	|	Реестр.ЦенаУПД КАК ЦенаУПД,
	|	Реестр.Результат КАК Результат,
	|	Реестр.Комментарий КАК Комментарий,
	|	Реестр.СтрокиПН КАК СтрокиПН
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр
	|ГДЕ
	|	(Реестр.ДатаЗаказа МЕЖДУ &ДатаНачала И &ДатаОкончания
	|			ИЛИ Реестр.ДатаПоступления МЕЖДУ &ДатаНачала И &ДатаОкончания)
	|	И Реестр.ИдентификаторПоступления <> """"
	|	И (НЕ &ТолькоРасхождения
	|			ИЛИ Реестр.Результат В (""Количество"", ""Цена"", ""НетВУПД"", ""НетВПоступлении""))
	|	И (&ВсеСклады
	|			ИЛИ Реестр.Склад = &Склад)
	|	И (&ВсеПоставщики
	|			ИЛИ Реестр.Поставщик = &Поставщик
	|			ИЛИ Реестр.ИННПоставщика = &Поставщик)
	|	И (&БезПоиска
	|			ИЛИ Реестр.Номенклатура ПОДОБНО &МаскаПоиска СПЕЦСИМВОЛ ""~"")
	|	И (&ВсеОрганизации
	|			ИЛИ Реестр.Организация = &Организация
	|			ИЛИ Реестр.ИННОрганизации = &Организация)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склад,
	|	ДатаЗаказа,
	|	НомерЗаказа,
	|	ИдентификаторЗаказа,
	|	ДатаПоступления,
	|	ИдентификаторПоступления,
	|	ПозицияСтроки";
	Если ПоПоставщикам Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "УПОРЯДОЧИТЬ ПО
		|	Склад,", "УПОРЯДОЧИТЬ ПО
		|	Поставщик,
		|	ИННПоставщика,");
	ИначеЕсли ПоОрганизациям Тогда
		// Организация -> приходная: внутри организации по дате прихода
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "УПОРЯДОЧИТЬ ПО
		|	Склад,
		|	ДатаЗаказа,
		|	НомерЗаказа,
		|	ИдентификаторЗаказа,
		|	ДатаПоступления,
		|	ИдентификаторПоступления,", "УПОРЯДОЧИТЬ ПО
		|	Организация,
		|	ИННОрганизации,
		|	ДатаПоступления,
		|	ИдентификаторПоступления,
		|	ИдентификаторЗаказа,");
	КонецЕсли;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ТолькоРасхождения", ТолькоРасхождения = Истина);
	Запрос.УстановитьПараметр("ВсеСклады", НЕ ЗначениеЗаполнено(ПараметрыОтбора.Склад));
	Запрос.УстановитьПараметр("Склад", СокрЛП(ПараметрыОтбора.Склад));
	Запрос.УстановитьПараметр("ВсеПоставщики", НЕ ЗначениеЗаполнено(ПараметрыОтбора.Поставщик));
	Запрос.УстановитьПараметр("Поставщик", СокрЛП(ПараметрыОтбора.Поставщик));
	Запрос.УстановитьПараметр("ВсеОрганизации", НЕ ЗначениеЗаполнено(ПараметрыОтбора.Организация));
	Запрос.УстановитьПараметр("Организация", СокрЛП(ПараметрыОтбора.Организация));
	// Поиск по наименованию: любая часть названия, спецсимволы маски экранируются
	ТекстПоиска = СокрЛП(ПараметрыОтбора.Наименование);
	Запрос.УстановитьПараметр("БезПоиска", НЕ ЗначениеЗаполнено(ТекстПоиска));
	Запрос.УстановитьПараметр("МаскаПоиска", "%" + СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(
		ТекстПоиска, "~", "~~"), "%", "~%"), "_", "~_"), "[", "~[") + "%");
	Правки = ЭАрМ_ПравкиЦен.ВсеПравки();

	ТекущийУзел     = Неопределено;
	ТекущаяПоставка = Неопределено;
	УзелВерхний     = Неопределено;
	УзелЗаказа      = Неопределено;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		// В таблице только названия; ИНН - в ключе узла, чтобы одноимённые
		// контрагенты и организации с разным ИНН не слились в один узел
		Если ПоПоставщикам Тогда
			ИмяУзла = ?(ЗначениеЗаполнено(Выборка.Поставщик), Выборка.Поставщик, "<Поставщик не указан>");
			КлючУзла = ИмяУзла + "|" + Выборка.ИННПоставщика;
		ИначеЕсли ПоОрганизациям Тогда
			ИмяУзла = ?(ЗначениеЗаполнено(Выборка.Организация), Выборка.Организация,
				"<Организация не указана - обновите реестр за период>");
			КлючУзла = ИмяУзла + "|" + Выборка.ИННОрганизации;
		Иначе
			ИмяУзла = ?(ЗначениеЗаполнено(Выборка.Склад), Выборка.Склад, "<Склад не указан>");
			КлючУзла = ИмяУзла;
		КонецЕсли;

		Если КлючУзла <> ТекущийУзел Тогда
			ТекущийУзел     = КлючУзла;
			ТекущаяПоставка = Неопределено;
			УзелВерхний = Дерево.Строки.Добавить();
			УзелВерхний.Представление = ИмяУзла;
		КонецЕсли;

		КлючПоставки = Выборка.ИдентификаторЗаказа + "|" + Выборка.ИдентификаторПоступления;
		Если КлючПоставки <> ТекущаяПоставка Тогда
			ТекущаяПоставка = КлючПоставки;
			УзелЗаказа = УзелВерхний.Строки.Добавить();
			// Монитор показывает только приход и УПД: узел - приходная
			УзелЗаказа.Представление            = ПредставлениеПрихода(Выборка);
			Если ПоОрганизациям Тогда
				УзелЗаказа.Контрагент           = КудаИОтКого(Выборка);
			Иначе
				УзелЗаказа.Контрагент           = КонтрагентПоставки(Выборка, ПоПоставщикам);
			КонецЕсли;
			УзелЗаказа.ДокУПД                   = ?(ЗначениеЗаполнено(Выборка.НомерУПД),
				"УПД № " + Выборка.НомерУПД, "нет УПД");
			УзелЗаказа.ДокПриход                = ?(ЗначениеЗаполнено(Выборка.ИдентификаторПоступления),
				СтрШаблон("ПН № %1 от %2", Выборка.НомерПоступления, Формат(Выборка.ДатаПоступления, "ДЛФ=D")),
				"нет прихода");
			УзелЗаказа.ИдентификаторЗаказа      = Выборка.ИдентификаторЗаказа;
			УзелЗаказа.ИдентификаторПоступления = Выборка.ИдентификаторПоступления;
			УзелЗаказа.Новая = ПараметрыОтбора.ИзвестныеПоставки <> Неопределено
				И ПараметрыОтбора.ИзвестныеПоставки.Количество() > 0
				И ПараметрыОтбора.ИзвестныеПоставки.Получить(КлючПоставки) = Неопределено;
		КонецЕсли;

		Товар = УзелЗаказа.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(Товар, Выборка);
		Товар.Представление = Выборка.Номенклатура;
		Товар.Результат = РезультатМонитора(Выборка.Результат, Выборка.КоличествоПН, Выборка.СтрокиПН);
		Товар.Статус = ТекстСтатусаСтроки(Товар.Результат);
		Товар.Наполнение = ПроцентНаполнения(Выборка.КоличествоЗаказа, Выборка.КоличествоПН);

		// Цена прихода исправлена вручную - видно в комментарии строки; введённая
		// цена показывается рядом, в «Измененной цене». «Цена приходной» не меняется
		Для Каждого НомерПН Из СтрРазделить(СокрЛП(Выборка.СтрокиПН), ";", Ложь) Цикл
			Правка = Правки.Получить(СокрЛП(Выборка.ИдентификаторПоступления) + "|" + СокрЛП(НомерПН));
			Если Правка <> Неопределено Тогда
				Товар.ЦенаИзмененная = Правка.ЦенаСтала;
				Товар.ЗапросВДалион = Правка.ЗапросОтправлен;
				Товар.ПодтвержденоВДалион = Правка.ПодтвержденоВДалион;
				Товар.Комментарий = СокрЛП(СокрЛП(Выборка.Комментарий) + " " + ЭАрМ_ПравкиЦен.ТекстПравки(Правка));
				// Цена сошлась после ручной правки с комментарием - строка «Цена подтверждена»
				Если Выборка.Результат = "Совпадает" Тогда
					Товар.Статус = ЭАрМ_ПравкиЦен.СтатусЦенаПодтверждена();
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	ОбъединитьДублиПоНазванию(Дерево);
	ПодвестиИтогиДерева(Дерево);

	Возврат Дерево;

КонецФункции

// Реквизиты УПД и прихода поставки - для шапки монитора по текущей строке.
//
// Параметры:
//   ИдентификаторЗаказа, ИдентификаторПоступления - Строка - ключ цепочки
//
// Возвращаемое значение:
//   Структура - ШапкаУПДНомер, ШапкаУПДПоставщик, ШапкаУПДСумма, ШапкаУПДСостояние,
//               ШапкаПриходНомер, ШапкаПриходМагазин, ШапкаПриходСумма, ШапкаПриходСверка (Строка);
//               ШапкаУПД, ШапкаПриход - то же одной строкой на документ
//
Функция РеквизитыДокументовПоставки(ИдентификаторЗаказа, ИдентификаторПоступления) Экспорт

	Результат = Новый Структура("ШапкаУПДНомер, ШапкаУПДПоставщик, ШапкаУПДСумма, ШапкаУПДСостояние, "
		+ "ШапкаПриходНомер, ШапкаПриходМагазин, ШапкаПриходСумма, ШапкаПриходСверка, ШапкаУПД, ШапкаПриход",
		"", "", "", "", "", "", "", "", "", "");

	Если НЕ ЗначениеЗаполнено(ИдентификаторЗаказа) И НЕ ЗначениеЗаполнено(ИдентификаторПоступления) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Цепочка.НомерПоступления КАК НомерПоступления,
	|	Цепочка.ДатаПоступления КАК ДатаПоступления,
	|	Цепочка.ВходящийНомер КАК ВходящийНомер,
	|	Цепочка.СуммаПоступления КАК СуммаПоступления,
	|	Цепочка.Поставщик КАК Поставщик,
	|	Цепочка.ИННПоставщика КАК ИННПоставщика,
	|	Цепочка.ИдентификаторУПД КАК ИдентификаторУПД,
	|	Цепочка.ИдентификаторУПДАннулированной КАК ИдентификаторУПДАннулированной,
	|	Цепочка.ЕстьРасхождения КАК ЕстьРасхождения,
	|	Цепочка.ТекстРасхождений КАК ТекстРасхождений,
	|	Цепочка.ДатаСверки КАК ДатаСверки,
	|	ЕСТЬNULL(УПД.Номер, """") КАК НомерУПД,
	|	ЕСТЬNULL(УПД.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаУПД,
	|	ЕСТЬNULL(УПД.Контрагент, """") КАК КонтрагентУПД,
	|	ЕСТЬNULL(УПД.ИННКонтрагента, """") КАК ИННУПД,
	|	ЕСТЬNULL(УПД.СуммаУПД, 0) КАК СуммаУПД,
	|	ЕСТЬNULL(УПД.ЕстьУКД, ЛОЖЬ) КАК ЕстьУКД,
	|	ЕСТЬNULL(УПД.СуммаСУчетомУКД, 0) КАК СуммаСУчетомУКД,
	|	ЕСТЬNULL(УПД.Состояние, """") КАК Состояние,
	|	ЕСТЬNULL(УПД.Подписано, ЛОЖЬ) КАК Подписано,
	|	ЕСТЬNULL(УПД.Аннулирована, ЛОЖЬ) КАК Аннулирована,
	|	ЕСТЬNULL(УПД.ОжидаетАннулирования, ЛОЖЬ) КАК ОжидаетАннулирования,
	|	ЕСТЬNULL(Аннулированная.Номер, """") КАК НомерАннулированной
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО Цепочка.ИдентификаторУПД = УПД.ИдентификаторСБИС
	|			И Цепочка.ИдентификаторУПД <> """"
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК Аннулированная
	|		ПО Цепочка.ИдентификаторУПДАннулированной = Аннулированная.ИдентификаторСБИС
	|			И Цепочка.ИдентификаторУПДАннулированной <> """"
	|ГДЕ
	|	Цепочка.ИдентификаторЗаказа = &ИдентификаторЗаказа
	|	И Цепочка.ИдентификаторПоступления = &ИдентификаторПоступления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Реестр.Склад КАК Склад
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр
	|ГДЕ
	|	Реестр.ИдентификаторЗаказа = &ИдентификаторЗаказа
	|	И Реестр.ИдентификаторПоступления = &ИдентификаторПоступления
	|	И Реестр.Склад <> """"";
	Запрос.УстановитьПараметр("ИдентификаторЗаказа", ИдентификаторЗаказа);
	Запрос.УстановитьПараметр("ИдентификаторПоступления", ИдентификаторПоступления);
	Пакет = Запрос.ВыполнитьПакет();

	ВыборкаСклада = Пакет[1].Выбрать();
	Если ВыборкаСклада.Следующий() Тогда
		Результат.ШапкаПриходМагазин = СокрЛП(ВыборкаСклада.Склад);
	КонецЕсли;

	Выборка = Пакет[0].Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;

	// Приход
	Если ЗначениеЗаполнено(ИдентификаторПоступления) Тогда
		Результат.ШапкаПриходНомер = СтрШаблон("№ %1 от %2", СокрЛП(Выборка.НомерПоступления),
			Формат(Выборка.ДатаПоступления, "ДЛФ=D"))
			+ ?(ЗначениеЗаполнено(Выборка.ВходящийНомер), " · вх. № " + СокрЛП(Выборка.ВходящийНомер), "");
		Результат.ШапкаПриходСумма = Формат(Выборка.СуммаПоступления, "ЧДЦ=2; ЧН=0,00");
	КонецЕсли;
	Если Выборка.ЕстьРасхождения Тогда
		Результат.ШапкаПриходСверка = "Расхождения: " + Лев(СокрЛП(Выборка.ТекстРасхождений), 300);
	ИначеЕсли ЗначениеЗаполнено(Выборка.ДатаСверки) Тогда
		Результат.ШапкаПриходСверка = "Сошлось с УПД";
	Иначе
		Результат.ШапкаПриходСверка = "Ещё не сверено";
	КонецЕсли;

	// УПД
	Если ЗначениеЗаполнено(Выборка.ИдентификаторУПД) Тогда
		Результат.ШапкаУПДНомер = СтрШаблон("№ %1 от %2", СокрЛП(Выборка.НомерУПД), Формат(Выборка.ДатаУПД, "ДЛФ=D"));
		Результат.ШапкаУПДСумма = Формат(Выборка.СуммаУПД, "ЧДЦ=2; ЧН=0,00")
			+ ?(Выборка.ЕстьУКД, " · с учётом УКД " + Формат(Выборка.СуммаСУчетомУКД, "ЧДЦ=2; ЧН=0,00"), "");
		Части = Новый Массив;
		Если ЗначениеЗаполнено(Выборка.Состояние) Тогда
			Части.Добавить(СокрЛП(Выборка.Состояние));
		КонецЕсли;
		Если Выборка.Подписано Тогда
			Части.Добавить("подписана нами");
		КонецЕсли;
		Если Выборка.ОжидаетАннулирования Тогда
			Части.Добавить("ждёт решения по аннулированию - решите в СБИС");
		КонецЕсли;
		Если Выборка.Аннулирована Тогда
			Части.Добавить("аннулирована");
		КонецЕсли;
		Результат.ШапкаУПДСостояние = СтрСоединить(Части, " · ");
	ИначеЕсли ЗначениеЗаполнено(Выборка.ИдентификаторУПДАннулированной) Тогда
		Результат.ШапкаУПДНомер = СтрШаблон("№ %1 аннулирована - ждём УПД взамен", СокрЛП(Выборка.НомерАннулированной));
		Результат.ШапкаУПДСостояние = "Новая УПД привяжется сама: по номеру или по совпадению строк";
	Иначе
		Результат.ШапкаУПДНомер = "Не привязана";
		Результат.ШапкаУПДСостояние = "Причина - кнопка «Почему нет УПД»";
	КонецЕсли;

	Поставщик = ?(ЗначениеЗаполнено(Выборка.КонтрагентУПД), Выборка.КонтрагентУПД, Выборка.Поставщик);
	ИНН       = ?(ЗначениеЗаполнено(Выборка.ИННУПД), Выборка.ИННУПД, Выборка.ИННПоставщика);
	Результат.ШапкаУПДПоставщик = СокрЛП(Поставщик) + ?(ЗначениеЗаполнено(ИНН), ", ИНН " + СокрЛП(ИНН), "");

	// Шапка монитора - строка на документ; магазин и поставщик уже в таблице
	Результат.ШапкаУПД = СоединитьНепустые(Результат.ШапкаУПДНомер, Результат.ШапкаУПДСумма,
		Результат.ШапкаУПДСостояние);
	Результат.ШапкаПриход = СоединитьНепустые(Результат.ШапкаПриходНомер, Результат.ШапкаПриходСумма,
		Результат.ШапкаПриходСверка);

	Возврат Результат;

КонецФункции

Функция СоединитьНепустые(Часть1, Часть2, Часть3)

	Части = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Часть1 + Символы.ПС + Часть2 + Символы.ПС + Часть3, Символы.ПС, Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Часть)) Тогда
			Части.Добавить(СокрЛП(Часть));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, "  ·  ");

КонецФункции

// Параметры отбора дерева реестра.
//
// Возвращаемое значение:
//   Структура:
//     * Группировка       - Строка - "Склад" (по умолчанию), "Поставщик" или "Организация"
//     * Склад             - Строка - наименование склада; пусто - все
//     * Поставщик         - Строка - наименование или ИНН поставщика; пусто - все
//     * ИзвестныеПоставки - Соответствие, Неопределено - ключи поставок "заказ|поступление",
//                           показанные в прошлый раз; остальные отмечаются как новые
//     * Наименование      - Строка - часть наименования товара; пусто - все
//     * Организация       - Строка - наименование или ИНН организации; пусто - все
//
Функция НовыйОтборДереваРеестра() Экспорт

	Возврат Новый Структура("Группировка, Склад, Поставщик, ИзвестныеПоставки, Наименование, Организация",
		"Склад", "", "", Неопределено, "", "");

КонецФункции

// Ключи поставок дерева реестра - чтобы в следующий раз отметить новые.
//
// Параметры:
//   Дерево - ДеревоЗначений - см. ДеревоРеестра
//
// Возвращаемое значение:
//   Массив из Строка - "заказ|поступление"
//
Функция КлючиПоставокДерева(Дерево) Экспорт

	Ключи = Новый Массив;
	Для Каждого УзелВерхний Из Дерево.Строки Цикл
		Для Каждого УзелЗаказа Из УзелВерхний.Строки Цикл
			Ключи.Добавить(УзелЗаказа.ИдентификаторЗаказа + "|" + УзелЗаказа.ИдентификаторПоступления);
		КонецЦикла;
	КонецЦикла;
	Возврат Ключи;

КонецФункции

// Короткая метка состояния реестра за период: число строк, последнее
// обновление и число поставок. Форма сравнивает метки и перечитывает дерево,
// только если реестр изменился.
//
// Возвращаемое значение:
//   Строка
//
Функция МеткаРеестра(Знач ДатаНачала, Знач ДатаОкончания) Экспорт

	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = ТекущаяДатаСеанса();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Строк,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Реестр.ИдентификаторПоступления) КАК Поступлений,
	|	МАКСИМУМ(Реестр.ДатаОбновления) КАК Обновлено
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр
	|ГДЕ
	|	(Реестр.ДатаЗаказа МЕЖДУ &ДатаНачала И &ДатаОкончания
	|			ИЛИ Реестр.ДатаПоступления МЕЖДУ &ДатаНачала И &ДатаОкончания)";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат "0";
	КонецЕсли;
	Возврат СтрШаблон("%1:%2:%3", Выборка.Строк, Выборка.Поступлений,
		Формат(Выборка.Обновлено, "ДФ=yyyyMMddHHmmss"));

КонецФункции

// Склады и поставщики реестра за период - списки выбора отборов формы.
//
// Возвращаемое значение:
//   Структура - Склады, Поставщики, Организации (Массив из Строка)
//
Функция СкладыИПоставщикиРеестра(Знач ДатаНачала, Знач ДатаОкончания) Экспорт

	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = ТекущаяДатаСеанса();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Реестр.Склад КАК Значение
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр
	|ГДЕ
	|	(Реестр.ДатаЗаказа МЕЖДУ &ДатаНачала И &ДатаОкончания
	|			ИЛИ Реестр.ДатаПоступления МЕЖДУ &ДатаНачала И &ДатаОкончания)
	|	И Реестр.Склад <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Значение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Реестр.Поставщик КАК Значение
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр
	|ГДЕ
	|	(Реестр.ДатаЗаказа МЕЖДУ &ДатаНачала И &ДатаОкончания
	|			ИЛИ Реестр.ДатаПоступления МЕЖДУ &ДатаНачала И &ДатаОкончания)
	|	И Реестр.Поставщик <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Значение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Реестр.Организация КАК Значение
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр
	|ГДЕ
	|	(Реестр.ДатаЗаказа МЕЖДУ &ДатаНачала И &ДатаОкончания
	|			ИЛИ Реестр.ДатаПоступления МЕЖДУ &ДатаНачала И &ДатаОкончания)
	|	И Реестр.Организация <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Значение";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Результаты = Запрос.ВыполнитьПакет();
	Возврат Новый Структура("Склады, Поставщики, Организации",
		Результаты[0].Выгрузить().ВыгрузитьКолонку("Значение"),
		Результаты[1].Выгрузить().ВыгрузитьКолонку("Значение"),
		Результаты[2].Выгрузить().ВыгрузитьКолонку("Значение"));

КонецФункции

// Загружает файл штрихкодов поставщика в регистр ЭАрМ_ШтрихкодыПоставщиков.
//
// Понимает:
//   * JSON {"товары": [{"код", "наименование", "штрихкод"}]} - формат обработки
//     ЗагрузкаШтрихкодов; также {"items": [{"code", "name", "barcode", "inn"}]}
//     и массив таких объектов в корне;
//   * текст с колонками через табуляцию или ";" - штрихкод и наименование;
//   * текст, где значения идут по одному в строке: штрихкод, наименование, цена.
//
// Параметры:
//   АдресФайла    - Строка - адрес двоичных данных во временном хранилище
//   ИмяФайла      - Строка - имя исходного файла; без поставщика оно им и становится
//   ИННПоставщика - Строка - для поиска по коду товара
//   Поставщик     - Строка
//
// Возвращаемое значение:
//   Структура - Загружено, Пропущено, Поставщик
//
Функция ЗагрузитьШтрихкодыПоставщика(АдресФайла, ИмяФайла, Знач ИННПоставщика = "", Знач Поставщик = "") Экспорт

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Файл штрихкодов не передан на сервер";
	КонецЕсли;

	Файл = Новый Файл(ИмяФайла);
	ИННПоставщика = СокрЛП(ИННПоставщика);
	Поставщик     = СокрЛП(Поставщик);
	Если НЕ ЗначениеЗаполнено(Поставщик) Тогда
		Поставщик = Файл.ИмяБезРасширения;
	КонецЕсли;

	Текст = ТекстФайла(ДвоичныеДанные, Файл.Расширение);
	Если СтрНачинаетсяС(Текст, "{") ИЛИ СтрНачинаетсяС(Текст, "[") Тогда
		Пары = ПарыИзJSON(Текст);
	Иначе
		Пары = ПарыИзТекста(Текст);
	КонецЕсли;

	Итоги = Новый Структура("Загружено, Пропущено, Поставщик", 0, 0, Поставщик);
	Добавленные = Новый Соответствие;

	НачатьТранзакцию();
	Попытка

		Для Каждого Пара Из Пары Цикл

			Ключ = Пара.Штрихкод + "|" + ВРег(Пара.Наименование);
			Если НЕ ЭтоШтрихкод(Пара.Штрихкод)
				ИЛИ НЕ ЗначениеЗаполнено(Пара.Наименование)
				ИЛИ Добавленные.Получить(Ключ) <> Неопределено Тогда
				Итоги.Пропущено = Итоги.Пропущено + 1;
				Продолжить;
			КонецЕсли;
			Добавленные.Вставить(Ключ, Истина);

			Описание = ЭАрМ_СверкаТоваровЦепочки.НовоеОписаниеШтрихкода();
			Описание.Штрихкод               = Пара.Штрихкод;
			Описание.НаименованиеПоставщика = Пара.Наименование;
			Описание.КодТовараПоставщика    = Пара.Код;
			Описание.ИННПоставщика          = ?(ЗначениеЗаполнено(Пара.ИНН), Пара.ИНН, ИННПоставщика);
			Описание.Поставщик              = Поставщик;
			Описание.Источник               = "ФайлПоставщика";

			ЭАрМ_СверкаТоваровЦепочки.ЗаписатьШтрихкодПоставщика(Описание);
			Итоги.Загружено = Итоги.Загружено + 1;

		КонецЦикла;

		ЗафиксироватьТранзакцию();

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ЗагрузитьШтрихкодыПоставщика (файл " + ИмяФайла + ")", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", ОперацияЖурнала(), Истина,
		СтрШаблон("Штрихкоды поставщика %1: загружено %2, пропущено %3",
			Поставщик, Итоги.Загружено, Итоги.Пропущено), Лев(ИмяФайла, 150));

	Возврат Итоги;

КонецФункции

// Имя операции в журнале обмена ЭАрМ_ЖурналОбменаЭДО.
//
Функция ОперацияЖурнала() Экспорт

	Возврат "РеестрТоваров";

КонецФункции

#КонецОбласти

#Область НастройкиМонитора

// Настройки монитора реестра товаров по заказам (форма «Настройки»); хранятся
// для каждого пользователя.
//
// Возвращаемое значение:
//   Структура:
//     * Группировка            - Строка - "Поставщик", "Склад" или "Организация"
//     * ПериодПоУмолчанию      - Строка - "Месяц", "Неделя" или "Сегодня"
//     * ТолькоРасхождения      - Булево - при открытии показывать только проблемы
//     * Автообновление         - Булево
//     * ИнтервалАвтообновления - Число - секунд, не меньше 15
//     * ДатаДокументаИзУПД     - Булево - при правке цены в Далион передавать дату из УПД
//
Функция НастройкиМонитора() Экспорт

	Настройки = Новый Структура("Группировка, ПериодПоУмолчанию, ТолькоРасхождения, Автообновление, "
		+ "ИнтервалАвтообновления, ДатаДокументаИзУПД",
		"Поставщик", "Месяц", Истина, Истина, 30, Ложь);

	Сохраненные = ХранилищеОбщихНастроек.Загрузить(КлючНастроекМонитора(), "Настройки");
	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		Для Каждого КлючЗначение Из Новый Структура(Настройки) Цикл
			Если Сохраненные.Свойство(КлючЗначение.Ключ)
				И ТипЗнч(Сохраненные[КлючЗначение.Ключ]) = ТипЗнч(КлючЗначение.Значение) Тогда
				Настройки[КлючЗначение.Ключ] = Сохраненные[КлючЗначение.Ключ];
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Настройки.Группировка <> "Склад" И Настройки.Группировка <> "Поставщик"
		И Настройки.Группировка <> "Организация" Тогда
		Настройки.Группировка = "Поставщик";
	КонецЕсли;
	Если Настройки.ИнтервалАвтообновления < 15 Тогда
		Настройки.ИнтервалАвтообновления = 15;
	КонецЕсли;

	Возврат Настройки;

КонецФункции

// Сохраняет настройки монитора текущего пользователя.
//
// Параметры:
//   Настройки - Структура - см. НастройкиМонитора
//
Процедура СохранитьНастройкиМонитора(Настройки) Экспорт

	Значения = НастройкиМонитора();
	ЗаполнитьЗначенияСвойств(Значения, Настройки);
	ХранилищеОбщихНастроек.Сохранить(КлючНастроекМонитора(), "Настройки", Значения);

КонецПроцедуры

// Начало периода монитора по настройке «Период по умолчанию».
//
// Возвращаемое значение:
//   Дата
//
Функция НачалоПериодаМонитора(ПериодПоУмолчанию) Экспорт

	Если ПериодПоУмолчанию = "Сегодня" Тогда
		Возврат НачалоДня(ТекущаяДатаСеанса());
	ИначеЕсли ПериодПоУмолчанию = "Неделя" Тогда
		Возврат НачалоНедели(ТекущаяДатаСеанса());
	КонецЕсли;

	Возврат НачалоМесяца(ТекущаяДатаСеанса());

КонецФункции

Функция КлючНастроекМонитора()

	Возврат "ЭАрМ_РеестрТоваровЗаказов";

КонецФункции

#КонецОбласти

#Область СтрокиРеестра

// Реквизиты шапки, общие для всех строк цепочки.
//
// Возвращаемое значение:
//   Структура - имена совпадают с ресурсами регистра; Неопределено - цепочки нет
//
Функция ШапкаЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления)

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_ЦепочкаЗакупки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторЗаказа      = ИдентификаторЗаказа;
	МенеджерЗаписи.ИдентификаторПоступления = ИдентификаторПоступления;
	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Пакеты читаются один раз: из них и склад, и организация
	ПакетЗаказа  = ПакетЦепочки("ЗаказПоставщику", ИдентификаторЗаказа);
	ПакетПрихода = ПакетЦепочки("ПриходнаяНакладная", ИдентификаторПоступления);

	// Склад заказа главнее: поступление могли оформить на другой склад
	Склад = СкладИзПакета(ПакетЗаказа);
	Если НЕ ЗначениеЗаполнено(Склад.Наименование) Тогда
		Склад = СкладИзПакета(ПакетПрихода);
	КонецЕсли;

	// Организация - кто принял товар: приходная главнее заказа, затем УПД
	Организация = ОрганизацияИзПакета(ПакетПрихода);
	Если НЕ ЗначениеЗаполнено(Организация.Наименование) Тогда
		Организация = ОрганизацияИзПакета(ПакетЗаказа);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Организация.Наименование) Тогда
		Организация = ОрганизацияИзУПД(МенеджерЗаписи.ИдентификаторУПД);
	КонецЕсли;

	Шапка = Новый Структура;
	Шапка.Вставить("Склад",               Лев(Склад.Наименование, 150));
	Шапка.Вставить("ИдентификаторСклада", Лев(Склад.Идентификатор, 36));
	Шапка.Вставить("НомерЗаказа",         МенеджерЗаписи.НомерЗаказа);
	Шапка.Вставить("ДатаЗаказа",          МенеджерЗаписи.ДатаЗаказа);
	Шапка.Вставить("Поставщик",           МенеджерЗаписи.Поставщик);
	Шапка.Вставить("ИННПоставщика",       МенеджерЗаписи.ИННПоставщика);
	Шапка.Вставить("НомерПоступления",    МенеджерЗаписи.НомерПоступления);
	Шапка.Вставить("ДатаПоступления",     МенеджерЗаписи.ДатаПоступления);
	Шапка.Вставить("НомерУПД",            МенеджерЗаписи.НомерУПД);
	Шапка.Вставить("ИдентификаторУПД",    МенеджерЗаписи.ИдентификаторУПД);
	Шапка.Вставить("Организация",         Лев(Организация.Наименование, 200));
	Шапка.Вставить("ИННОрганизации",      Лев(Организация.ИНН, 12));

	Возврат Шапка;

КонецФункции

// Пакет Далиона объекта цепочки; приходная без заказа («ПН:») пакета заказа не имеет.
//
Функция ПакетЦепочки(ТипОбъекта, ИдентификаторОбъекта)

	Если НЕ ЗначениеЗаполнено(ИдентификаторОбъекта) ИЛИ СтрНачинаетсяС(ИдентификаторОбъекта, "ПН:") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта(ТипОбъекта, ИдентификаторОбъекта);

КонецФункции

// Возвращаемое значение:
//   Структура - Наименование, Идентификатор
//
Функция СкладИзПакета(Объект)

	Результат = Новый Структура("Наименование, Идентификатор", "", "");
	Если Объект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Склад = ЭАрМ_Служебный.ЗначениеУзла(Объект, "warehouse");
	Результат.Наименование  = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Склад, "name", "")));
	Результат.Идентификатор = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Склад, "uid", "")));

	Возврат Результат;

КонецФункции

// Организация пакета Далиона - узел company (name, inn), как у договоров
// (ЭАрМ_ПриемПакетовДалион.ОрганизацияУТ).
//
// Возвращаемое значение:
//   Структура - Наименование, ИНН
//
Функция ОрганизацияИзПакета(Объект)

	Результат = Новый Структура("Наименование, ИНН", "", "");
	Если Объект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Организация = ЭАрМ_Служебный.ЗначениеУзла(Объект, "company");
	Результат.Наименование = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Организация, "name", "")));
	Результат.ИНН          = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Организация, "inn", "")));

	Возврат Результат;

КонецФункции

// Организация-покупатель из реестра УПД - если в пакетах Далиона её нет.
//
// Возвращаемое значение:
//   Структура - Наименование, ИНН
//
Функция ОрганизацияИзУПД(ИдентификаторУПД)

	Результат = Новый Структура("Наименование, ИНН", "", "");
	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат Результат;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторУПД;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		Результат.Наименование = СокрЛП(МенеджерЗаписи.Организация);
		Результат.ИНН          = СокрЛП(МенеджерЗаписи.ИННОрганизации);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Штрихкод, подобранный товару линии. Строка УПД надёжнее всего: её GTIN или
// штрихкод, назначенный по регистру штрихкодов поставщиков, - это то, что
// реально пришло. Дальше ЭТрН, затем строки Далиона.
//
// Возвращаемое значение:
//   Структура - Штрихкод, Способ
//
Функция ПодобранныйШтрихкод(Линия)

	Результат = Новый Структура("Штрихкод, Способ", "", "");

	Для Каждого ИмяСтроки Из СтрРазделить("УПД,ЭТрН,Заказ,Поступление", ",") Цикл

		СтрокаДокумента = Линия[ИмяСтроки];
		Если СтрокаДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого КлючЗначение Из СтрокаДокумента.Штрихкоды Цикл
			Результат.Штрихкод = КлючЗначение.Ключ;
			Результат.Способ   = ?(ЗначениеЗаполнено(СтрокаДокумента.СпособШтрихкода),
				СтрокаДокумента.СпособШтрихкода, ИмяСтроки);
			Возврат Результат;
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НаименованиеЛинии(Линия)

	Для Каждого ИмяСтроки Из СтрРазделить("Заказ,Поступление,УПД,ЭТрН", ",") Цикл
		СтрокаДокумента = Линия[ИмяСтроки];
		Если СтрокаДокумента <> Неопределено И ЗначениеЗаполнено(СтрокаДокумента.Наименование) Тогда
			Возврат СтрокаДокумента.Наименование;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция Маркирована(СтрокаДокумента)

	Возврат СтрокаДокумента <> Неопределено И СтрокаДокумента.Маркирован = Истина;

КонецФункции

// Коды Честного знака и ЕГАИС линии: УПД, ЭТрН и коды, считанные при приёмке
// в Далионе, вместе, без повторов.
//
Функция МаркиЛинии(Линия)

	Коды = Новый Массив;
	ДобавитьМаркиСтроки(Коды, Линия.УПД);
	ДобавитьМаркиСтроки(Коды, Линия.ЭТрН);
	ДобавитьМаркиСтроки(Коды, Линия.Поступление);

	Разбор = ЭАрМ_КодыМаркировки.МаркиПоВидам(Коды);
	Результат = Новый Структура("ЧестныйЗнак, ЕГАИС",
		СтрСоединить(Разбор.ЧестныйЗнак, Символы.ПС),
		СтрСоединить(Разбор.ЕГАИС, Символы.ПС));

	Возврат Результат;

КонецФункции

Процедура ДобавитьМаркиСтроки(Коды, СтрокаДокумента)

	Если СтрокаДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Маркировки = Неопределено;
	Если НЕ СтрокаДокумента.Свойство("Маркировки", Маркировки) Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Маркировки) = Тип("Массив") Тогда
		Для Каждого Код Из Маркировки Цикл
			Если ЗначениеЗаполнено(Код) Тогда
				Коды.Добавить(СокрЛП(Код));
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Маркировки) = Тип("Строка") И ЗначениеЗаполнено(Маркировки) Тогда
		Для Каждого Код Из СтрРазделить(Маркировки, Символы.ПС, Ложь) Цикл
			Если ЗначениеЗаполнено(Код) Тогда
				Коды.Добавить(СокрЛП(Код));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция КоличествоСтрокРеестра(ДатаНачала, ДатаОкончания)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Строк
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр
	|ГДЕ
	|	(Реестр.ДатаЗаказа МЕЖДУ &ДатаНачала И &ДатаОкончания
	|			ИЛИ Реестр.ДатаПоступления МЕЖДУ &ДатаНачала И &ДатаОкончания)";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);

	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Строк, 0);

КонецФункции

#КонецОбласти

#Область Дерево

// Заголовок поставки: заказ - начало цепочки «заказ - УПД - приход». УПД и приход
// стоят в своих колонках, поэтому здесь только заказ.
//
Функция ПредставлениеПоставки(Выборка)

	Если СтрНачинаетсяС(Выборка.ИдентификаторЗаказа, "ПН:") Тогда
		Возврат "Без заказа (приход напрямую)";
	КонецЕсли;

	Возврат СтрШаблон("Заказ № %1 от %2", Выборка.НомерЗаказа, Формат(Выборка.ДатаЗаказа, "ДЛФ=D"));

КонецФункции

// Заголовок поставки в группировке по организациям: приходная - сколько и что
// пришло в магазин. Поставка без прихода - по заказу.
//
Функция ПредставлениеПрихода(Выборка)

	Если ЗначениеЗаполнено(Выборка.ИдентификаторПоступления) Тогда
		Возврат СтрШаблон("Приход № %1 от %2", Выборка.НомерПоступления, Формат(Выборка.ДатаПоступления, "ДЛФ=D"));
	КонецЕсли;

	Возврат ПредставлениеПоставки(Выборка) + " - прихода ещё нет";

КонецФункции

// Магазин и поставщик приходной одной строкой.
//
Функция КудаИОтКого(Выборка)

	Части = Новый Массив;
	Если ЗначениеЗаполнено(Выборка.Склад) Тогда
		Части.Добавить(СокрЛП(Выборка.Склад));
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.Поставщик) Тогда
		Части.Добавить(СокрЛП(Выборка.Поставщик));
	КонецЕсли;

	Возврат СтрСоединить(Части, " · ");

КонецФункции

// Вторая сторона поставки: в группировке по магазинам - поставщик, по
// поставщикам - магазин.
//
Функция КонтрагентПоставки(Выборка, ПоПоставщикам)

	Если ПоПоставщикам Тогда
		Возврат Выборка.Склад;
	КонецЕсли;

	Возврат Выборка.Поставщик;

КонецФункции

// Строки одного товара в поставке. Сверка идёт только по штрихкоду и номенклатуре
// Далиона, поэтому товар, у которого они не сошлись, попадает в реестр двумя
// строками: «заказ и приход, нет в УПД» и «УПД, нет в приходе».
//
// Монитор показывает такой товар одной строкой, но только при точном совпадении
// названия (без регистра, «ё» и знаков) и только для пары «есть приход, нет УПД» +
// «есть УПД, нет прихода»: сходство названий не считается. Регистр и сверка цепочки
// не меняются; количество и цена УПД и прихода сравниваются заново с допусками
// сверки. Строка помечается способом «Наименование» (жёлтая) - стоит закрепить
// пару вручную в форме реестра УПД. Остальные строки с одним названием
// только помечаются как возможный дубль.
//
Процедура ОбъединитьДублиПоНазванию(Дерево)

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();

	Для Каждого УзелВерхний Из Дерево.Строки Цикл
		Для Каждого УзелЗаказа Из УзелВерхний.Строки Цикл

			Группы = Новый Соответствие;
			Для Каждого Товар Из УзелЗаказа.Строки Цикл
				Ключ = КлючНазванияТовара(Товар.Представление);
				Если НЕ ЗначениеЗаполнено(Ключ) Тогда
					Продолжить;
				КонецЕсли;
				Если Группы.Получить(Ключ) = Неопределено Тогда
					Группы.Вставить(Ключ, Новый Массив);
				КонецЕсли;
				Группы[Ключ].Добавить(Товар);
			КонецЦикла;

			Для Каждого КлючЗначение Из Группы Цикл

				Строки = КлючЗначение.Значение;
				Если Строки.Количество() < 2 Тогда
					Продолжить;
				КонецЕсли;

				Если Строки.Количество() = 2 Тогда
					СПриходом = ?(ЕстьПриходБезУПД(Строки[0]) И ЕстьУПДБезПрихода(Строки[1]), Строки[0],
						?(ЕстьПриходБезУПД(Строки[1]) И ЕстьУПДБезПрихода(Строки[0]), Строки[1], Неопределено));
					Если СПриходом <> Неопределено Тогда
						СУПД = ?(СПриходом = Строки[0], Строки[1], Строки[0]);
						ВлитьСтрокуУПДВСтрокуПрихода(СПриходом, СУПД, Настройки);
						УзелЗаказа.Строки.Удалить(СУПД);
						Продолжить;
					КонецЕсли;
				КонецЕсли;

				Для Каждого Товар Из Строки Цикл
					Товар.ВозможныйДубль = Истина;
					Товар.Комментарий = СокрЛП("возможный дубль: то же название в поставке, штрихкоды не сошлись - свяжите парой. "
						+ Товар.Комментарий);
				КонецЦикла;

			КонецЦикла;

		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ЕстьПриходБезУПД(Товар)

	Возврат (ЧислоИлиНоль(Товар.КоличествоПН) <> 0 ИЛИ ЗначениеЗаполнено(Товар.СтрокиПН))
		И ЧислоИлиНоль(Товар.КоличествоУПД) = 0 И ЧислоИлиНоль(Товар.ЦенаУПД) = 0;

КонецФункции

Функция ЕстьУПДБезПрихода(Товар)

	Возврат (ЧислоИлиНоль(Товар.КоличествоУПД) <> 0 ИЛИ ЧислоИлиНоль(Товар.ЦенаУПД) <> 0)
		И ЧислоИлиНоль(Товар.КоличествоПН) = 0 И НЕ ЗначениеЗаполнено(Товар.СтрокиПН);

КонецФункции

// Переносит УПД (а если у строки прихода нет заказа - и заказ) в строку прихода и
// заново оценивает результат.
//
Процедура ВлитьСтрокуУПДВСтрокуПрихода(СтрокаПрихода, СтрокаУПД, Настройки)

	СтрокаПрихода.КоличествоУПД = СтрокаУПД.КоличествоУПД;
	СтрокаПрихода.ЦенаУПД       = СтрокаУПД.ЦенаУПД;
	Если ЧислоИлиНоль(СтрокаПрихода.КоличествоЗаказа) = 0 И ЧислоИлиНоль(СтрокаПрихода.ЦенаЗаказа) = 0 Тогда
		СтрокаПрихода.КоличествоЗаказа = СтрокаУПД.КоличествоЗаказа;
		СтрокаПрихода.ЦенаЗаказа       = СтрокаУПД.ЦенаЗаказа;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СтрокаПрихода.Штрихкод) Тогда
		СтрокаПрихода.Штрихкод = СтрокаУПД.Штрихкод;
	КонецЕсли;

	ДопускКоличества = ?(ТипЗнч(Настройки.ДопускКоличества) = Тип("Число"), Настройки.ДопускКоличества, 0);
	ДопускЦены       = ?(ТипЗнч(Настройки.ДопускЦены) = Тип("Число"), Настройки.ДопускЦены, 0);

	Если Окр(Макс(СтрокаПрихода.КоличествоПН - СтрокаПрихода.КоличествоУПД,
			СтрокаПрихода.КоличествоУПД - СтрокаПрихода.КоличествоПН), 3) > ДопускКоличества Тогда
		СтрокаПрихода.Результат = "Количество";
	ИначеЕсли Окр(Макс(СтрокаПрихода.ЦенаПН - СтрокаПрихода.ЦенаУПД,
			СтрокаПрихода.ЦенаУПД - СтрокаПрихода.ЦенаПН), 2) > ДопускЦены Тогда
		СтрокаПрихода.Результат = "Цена";
	Иначе
		СтрокаПрихода.Результат = "Совпадает";
	КонецЕсли;

	СтрокаПрихода.Статус = ТекстСтатусаСтроки(СтрокаПрихода.Результат);
	СтрокаПрихода.СпособСопоставления = "Наименование";
	СтрокаПрихода.Комментарий = СокрЛП("объединено по точному названию, штрихкоды не сошлись - закрепите парой в реестре УПД. "
		+ ?(СтрокаПрихода.Результат = "Совпадает", "", СтрокаУПД.Комментарий));

КонецПроцедуры

// Название без регистра, «ё», знаков и лишних пробелов.
//
Функция КлючНазванияТовара(Название)

	Текст = НРег(СтрЗаменить(СокрЛП(Название), "ё", "е"));
	Результат = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если НРег(Символ) <> ВРег(Символ) ИЛИ Найти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Итоги узлов: количество по заказу, ПН и УПД, маркировка, итог сверки,
// число строк с расхождением и ждущих поставки - и по поставке, и по верхнему
// узлу (склад или поставщик). Цены в итогах не складываются - смысла в сумме
// цен нет.
//
Процедура ПодвестиИтогиДерева(Дерево)

	ЕстьСчетчики = Дерево.Колонки.Найти("Расхождений") <> Неопределено;

	Для Каждого УзелСклада Из Дерево.Строки Цикл

		РасхожденийСклада     = 0;
		ОжидаетПоставкиСклада = Ложь;
		ТоваровСклада         = 0;
		ЖдутСклада            = 0;
		НовыхСклада           = 0;

		УзелСклада.КоличествоЗаказа = 0;
		УзелСклада.КоличествоПН     = 0;
		УзелСклада.КоличествоУПД    = 0;

		Для Каждого УзелЗаказа Из УзелСклада.Строки Цикл

			Расхождений = 0;
			ОжидаетПоставки = Ложь;
			Ждут = 0;

			УзелЗаказа.КоличествоЗаказа = 0;
			УзелЗаказа.КоличествоПН     = 0;
			УзелЗаказа.КоличествоУПД    = 0;

			Для Каждого Товар Из УзелЗаказа.Строки Цикл

				УзелЗаказа.КоличествоЗаказа = УзелЗаказа.КоличествоЗаказа + Товар.КоличествоЗаказа;
				УзелЗаказа.КоличествоПН     = УзелЗаказа.КоличествоПН + Товар.КоличествоПН;
				УзелЗаказа.КоличествоУПД    = УзелЗаказа.КоличествоУПД + Товар.КоличествоУПД;

				Если Товар.Результат = "ОжидаетПоставки" Тогда
					ОжидаетПоставки = Истина;
					Ждут = Ждут + 1;
				ИначеЕсли Товар.Результат <> "Совпадает" Тогда
					Расхождений = Расхождений + 1;
				КонецЕсли;

			КонецЦикла;

			УзелЗаказа.Результат = ИтогСверкиУзла(Расхождений, ОжидаетПоставки);
			Если ЕстьСчетчики Тогда
				УзелЗаказа.Расхождений  = Расхождений;
				УзелЗаказа.ЖдутПоставки = Ждут;
				Если УзелЗаказа.Новая = Истина Тогда
					НовыхСклада = НовыхСклада + 1;
				КонецЕсли;
			КонецЕсли;

			УзелСклада.КоличествоЗаказа = УзелСклада.КоличествоЗаказа + УзелЗаказа.КоличествоЗаказа;
			УзелСклада.КоличествоПН     = УзелСклада.КоличествоПН + УзелЗаказа.КоличествоПН;
			УзелСклада.КоличествоУПД    = УзелСклада.КоличествоУПД + УзелЗаказа.КоличествоУПД;

			РасхожденийСклада     = РасхожденийСклада + Расхождений;
			ОжидаетПоставкиСклада = ОжидаетПоставкиСклада ИЛИ ОжидаетПоставки;
			ТоваровСклада         = ТоваровСклада + УзелЗаказа.Строки.Количество();
			ЖдутСклада            = ЖдутСклада + Ждут;

		КонецЦикла;

		УзелСклада.Результат = ИтогСверкиУзла(РасхожденийСклада, ОжидаетПоставкиСклада);
		УзелСклада.Наполнение = ПроцентНаполнения(УзелСклада.КоличествоЗаказа, УзелСклада.КоличествоПН);
		УзелСклада.Статус = ТекстСтатусаУзла(УзелСклада.Результат, УзелСклада.Наполнение);

		Если ЕстьСчетчики Тогда
			УзелСклада.Расхождений  = РасхожденийСклада;
			УзелСклада.ЖдутПоставки = ЖдутСклада;
			УзелСклада.Новая        = НовыхСклада > 0;
		КонецЕсли;

		// Верхний узел - только название: расхождения видны в «Статусе»

		Для Каждого УзелЗаказа Из УзелСклада.Строки Цикл
			УзелЗаказа.Наполнение = ПроцентНаполнения(УзелЗаказа.КоличествоЗаказа, УзелЗаказа.КоличествоПН);
			УзелЗаказа.Статус = ТекстСтатусаУзла(УзелЗаказа.Результат, УзелЗаказа.Наполнение);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

Функция ПроцентНаполнения(Заказано, Пришло)

	Если Заказано = Неопределено Тогда
		Заказано = 0;
	КонецЕсли;
	Если Пришло = Неопределено Тогда
		Пришло = 0;
	КонецЕсли;
	Если Заказано <= 0 Тогда
		Возврат ?(Пришло > 0, 100, 0);
	КонецЕсли;

	Возврат Мин(100, Окр(Пришло * 100 / Заказано, 0));

КонецФункции

// Результат строки для монитора: только приход и УПД. Замечания по ЭТрН и заказу
// (НетВЭТрН, КоличествоЭТрН, НетВЗаказе, НоменклатураПНОшибочна) монитор не
// показывает: строка с приходом - «пришло», без прихода - «нет в приходе».
// В реестре результат не меняется.
//
Функция РезультатМонитора(Результат, КоличествоПН, СтрокиПН)

	Если Результат = "Совпадает" ИЛИ Результат = "Количество" ИЛИ Результат = "Цена"
		ИЛИ Результат = "НетВУПД" ИЛИ Результат = "НетВПоступлении" Тогда
		Возврат Результат;
	КонецЕсли;

	ЕстьПриход = ЧислоИлиНоль(КоличествоПН) <> 0 ИЛИ ЗначениеЗаполнено(СтрокиПН);
	Возврат ?(ЕстьПриход, "Совпадает", "НетВПоступлении");

КонецФункции

Функция ТекстСтатусаСтроки(Результат)

	Если Результат = "Совпадает" Тогда
		Возврат "Пришло";
	ИначеЕсли Результат = "ОжидаетПоставки" Тогда
		Возврат "Ждёт поставки";
	ИначеЕсли Результат = "НетВУПД" Тогда
		Возврат "Нет в УПД";
	ИначеЕсли Результат = "НетВПоступлении" Тогда
		Возврат "Нет в приходе";
	ИначеЕсли Результат = "Количество" Тогда
		Возврат "Не сошлось количество";
	ИначеЕсли Результат = "Цена" Тогда
		Возврат "Не сошлась цена";
	ИначеЕсли СтрНачинаетсяС(Строка(Результат), "Расхождений") Тогда
		Возврат Строка(Результат);
	КонецЕсли;

	Возврат Строка(Результат);

КонецФункции

Функция ТекстСтатусаУзла(Результат, Наполнение)

	Если СтрНачинаетсяС(Строка(Результат), "Расхождений") Тогда
		Возврат Строка(Результат);
	ИначеЕсли Результат = "ОжидаетПоставки" Тогда
		Возврат "Ждёт поставки";
	ИначеЕсли Результат = "Совпадает" Тогда
		Возврат "Пришло";
	КонецЕсли;

	Возврат ТекстСтатусаСтроки(Результат);

КонецФункции

Функция ЗаголовокМагазина(Имя, Поставок, Товаров, Наполнение, Ждут, Расхождений, Новых)

	// В дереве имя читается отдельно: % и статус - в своих колонках.
	// Здесь только счётчики, чтобы строка магазина не превращалась в простыню.
	Части = Новый Массив;
	Части.Добавить(Имя);
	Части.Добавить(СтрШаблон("%1 %2", Поставок, ?(Поставок = 1, "поставка",
		?(Поставок > 1 И Поставок < 5, "поставки", "поставок"))));
	Части.Добавить(СтрШаблон("%1 поз.", Товаров));
	Если Ждут > 0 Тогда
		Части.Добавить("ждут " + Ждут);
	КонецЕсли;
	Если Расхождений > 0 Тогда
		Части.Добавить("≠ " + Расхождений);
	КонецЕсли;
	Если Новых > 0 Тогда
		Части.Добавить("+" + Новых);
	КонецЕсли;

	Возврат СтрСоединить(Части, "  ·  ");

КонецФункции

Функция ЧислоИлиНоль(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Итог сверки узла по расхождениям в его товарах.
//
// Параметры:
//   Расхождений     - Число  - товаров с расхождением
//   ОжидаетПоставки - Булево - есть товары, поставки которых ещё нет
//
// Возвращаемое значение:
//   Строка - как значения Результат в реестре, чтобы работало оформление формы
//
Функция ИтогСверкиУзла(Расхождений, ОжидаетПоставки)

	Если Расхождений > 0 Тогда
		Возврат СтрШаблон("Расхождений: %1", Расхождений);
	ИначеЕсли ОжидаетПоставки Тогда
		Возврат "ОжидаетПоставки";
	КонецЕсли;

	Возврат "Совпадает";

КонецФункции

#КонецОбласти

#Область ЗагрузкаШтрихкодов

// Текст файла. Выгрузки поставщиков бывают и в UTF-8, и в Windows-1251:
// при признаках чужой кодировки файл перечитывается в Windows-1251.
//
Функция ТекстФайла(ДвоичныеДанные, Расширение)

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(СтрЗаменить(Расширение, ".", ""));
	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	Попытка

		Текст = ПрочитатьТекстФайла(ИмяВременногоФайла, КодировкаТекста.UTF8);

		Если СтрНайти(Текст, Символ(65533)) > 0 ИЛИ НЕ ЕстьКириллица(Текст) Тогда
			ТекстWindows = ПрочитатьТекстФайла(ИмяВременногоФайла, "windows-1251");
			Если ЕстьКириллица(ТекстWindows) Тогда
				Текст = ТекстWindows;
			КонецЕсли;
		КонецЕсли;

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ТекстФайла (файл не прочитан)", ОшибкаИсключения);
		ЭАрМ_Служебный.УдалитьВременныйФайл(ИмяВременногоФайла);
		ВызватьИсключение;
	КонецПопытки;

	ЭАрМ_Служебный.УдалитьВременныйФайл(ИмяВременногоФайла);

	Если Лев(Текст, 1) = Символ(65279) Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;

	Возврат СокрЛП(Текст);

КонецФункции

Функция ПрочитатьТекстФайла(ПутьКФайлу, Кодировка)

	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, Кодировка);
	Текст = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	Возврат ЭАрМ_Служебный.СтрокойИлиПусто(Текст);

КонецФункции

Функция ЕстьКириллица(Текст)

	Образец = ВРег(Лев(Текст, 2000));
	Для Каждого Буква Из СтрРазделить("А,О,Е,И,Н", ",") Цикл
		Если СтрНайти(Образец, Буква) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ПарыИзJSON(Текст)

	Пары = Новый Массив;

	Данные = ЭАрМ_Служебный.ПрочитатьОтветJSON(Текст);
	Если Данные = Неопределено Тогда
		ВызватьИсключение "Файл не разобран как JSON";
	КонецЕсли;

	Элементы = Неопределено;
	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Элементы = Данные;
	Иначе
		// Пакет supplierBarcodes Далиона кладёт items внутрь data
		Для Каждого Путь Из СтрРазделить("товары,items,data.items", ",") Цикл
			Узел = ЭАрМ_Служебный.ЗначениеПоПути(Данные, Путь);
			Если ТипЗнч(Узел) = Тип("Массив") Тогда
				Элементы = Узел;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Элементы = Неопределено Тогда
		ВызватьИсключение "В JSON нет массива ""товары"" или ""items""";
	КонецЕсли;

	Для Каждого Элемент Из Элементы Цикл
		Пары.Добавить(НоваяПара(
			ПервоеЗначение(Элемент, "штрихкод,barcode"),
			ПервоеЗначение(Элемент, "наименование,name"),
			ПервоеЗначение(Элемент, "код,code"),
			ПервоеЗначение(Элемент, "инн,inn")));
	КонецЦикла;

	Возврат Пары;

КонецФункции

Функция ПарыИзТекста(Текст)

	Пары = Новый Массив;
	ОжидаемыйШтрихкод = "";

	Для Каждого СтрокаТекста Из СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Ложь) Цикл

		СтрокаТекста = СокрЛП(СтрокаТекста);
		Если НЕ ЗначениеЗаполнено(СтрокаТекста) Тогда
			Продолжить;
		КонецЕсли;

		Ячейки = СтрРазделить(СтрЗаменить(СтрокаТекста, ";", Символы.Таб), Символы.Таб, Ложь);

		Если Ячейки.Количество() > 1 Тогда

			Штрихкод = "";
			Наименование = "";
			Для Каждого Ячейка Из Ячейки Цикл
				Ячейка = СокрЛП(Ячейка);
				Если НЕ ЗначениеЗаполнено(Штрихкод) И ЭтоШтрихкод(Ячейка) Тогда
					Штрихкод = Ячейка;
				ИначеЕсли НЕ ЗначениеЗаполнено(Наименование) И ЗначениеЗаполнено(Ячейка) И НЕ ЭтоЧисло(Ячейка) Тогда
					Наименование = Ячейка;
				КонецЕсли;
			КонецЦикла;

			Если ЗначениеЗаполнено(Штрихкод) И ЗначениеЗаполнено(Наименование) Тогда
				Пары.Добавить(НоваяПара(Штрихкод, Наименование));
			КонецЕсли;
			ОжидаемыйШтрихкод = "";

		// Колонки таблицы, скопированные по одному значению в строке:
		// штрихкод, наименование, цена; заголовки отсеиваются сами
		ИначеЕсли ЭтоШтрихкод(СтрокаТекста) Тогда
			ОжидаемыйШтрихкод = СтрокаТекста;

		ИначеЕсли ЗначениеЗаполнено(ОжидаемыйШтрихкод) И НЕ ЭтоЧисло(СтрокаТекста) Тогда
			Пары.Добавить(НоваяПара(ОжидаемыйШтрихкод, СтрокаТекста));
			ОжидаемыйШтрихкод = "";

		КонецЕсли;

	КонецЦикла;

	Возврат Пары;

КонецФункции

Функция НоваяПара(Штрихкод, Наименование, Код = "", ИНН = "")

	Возврат Новый Структура("Штрихкод, Наименование, Код, ИНН",
		СокрЛП(Штрихкод), СокрЛП(Наименование), СокрЛП(Код), СокрЛП(ИНН));

КонецФункции

Функция ПервоеЗначение(Узел, ИменаСвойств)

	Для Каждого ИмяСвойства Из СтрРазделить(ИменаСвойств, ",") Цикл
		Значение = ЭАрМ_Служебный.ЗначениеУзла(Узел, ИмяСвойства);
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат Формат(Значение, "ЧГ=0");
		ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// EAN-8, UPC-A, EAN-13, ITF-14: только цифры, от 8 до 14 знаков.
//
Функция ЭтоШтрихкод(Значение)

	Длина = СтрДлина(Значение);

	Возврат Длина >= 8 И Длина <= 14 И ТолькоЦифры(Значение);

КонецФункции

Функция ЭтоЧисло(Значение)

	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(Значение, " ", ""), Символы.НПП, ""), ",", ".");
	Если НЕ ЗначениеЗаполнено(Текст) ИЛИ СтрЧислоВхождений(Текст, ".") > 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТолькоЦифры(СтрЗаменить(Текст, ".", ""));

КонецФункции

Функция ТолькоЦифры(Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти
