////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_ОбработкаЭДО: данные реестра УПД для обработки АРМ ЭДО.
//
// Обработка ЭАрМ_ОбработкаЭДО заменяет форму реестра УПД (форму списка
// регистра ЭАрМ_УПД_Входящий), и её табличная часть УПД хранит весь список
// УПД как в форме реестра. Здесь - единственное чтение этого регистра:
// один запрос на весь список, колонки как у табличной части.
//
// Отсюда наполняются и форма МониторЭДО (фоном через ДлительныеОперации),
// и сам объект (см. ЗаполнитьУПД модуля объекта).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Полный список УПД: все записи регистра ЭАрМ_УПД_Входящий без отборов.
//
// Колонки совпадают с табличной частью УПД обработки ЭАрМ_ОбработкаЭДО,
// порядок строк - как в форме реестра: свежие документы сверху.
//
// Возвращаемое значение:
//   ТаблицаЗначений - весь список УПД, колонки табличной части УПД
//
Функция ДанныеРеестраУПД() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УПД.Дата КАК Дата,
	|	УПД.Представление КАК Представление,
	|	УПД.СтатусПодписания КАК СтатусПодписания,
	|	УПД.КОтправке КАК КОтправке,
	|	УПД.Утверждено КАК Утверждено,
	|	УПД.Подписано КАК Подписано,
	|	УПД.ЕстьЭТрН КАК ЕстьЭТрН,
	|	УПД.ЕстьУКД КАК ЕстьУКД,
	|	УПД.РасхожденийНет КАК РасхожденийНет,
	|	УПД.Контрагент КАК Контрагент,
	|	УПД.Формат КАК Формат,
	|	УПД.НомерОснования КАК НомерОснования,
	|	УПД.Состояние КАК Состояние,
	|	УПД.ТипРеестра КАК ТипРеестра,
	|	УПД.ДатаЗагрузки КАК ДатаЗагрузки,
	|	УПД.Пломба КАК Пломба,
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	ИдентификаторСБИС";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Признак данных реестра УПД: короткий хэш содержимого списка.
//
// Монитор ЭДО молча сравнивает признак с признаком загруженного списка
// и перечитывает таблицу только когда данные действительно изменились
// (например, их обновило регламентное задание в другом сеансе).
//
// Возвращаемое значение:
//   Строка - MD5-хэш списка УПД
//
Функция ПризнакРеестраУПД() Экспорт

	Возврат ПризнакТаблицыУПД(ДанныеРеестраУПД());

КонецФункции

// Признак содержимого таблицы УПД - тот же алгоритм, что и в
// ПризнакРеестраУПД. Позволяет запомнить признак уже загруженного
// списка без лишнего запроса к регистру.
//
// Параметры:
//   ТаблицаУПД - ТаблицаЗначений - список УПД, колонки табличной части УПД
//
// Возвращаемое значение:
//   Строка - MD5-хэш содержимого таблицы
//
Функция ПризнакТаблицыУПД(ТаблицаУПД) Экспорт

	// Хэш складывается по строкам, а не по всей таблице разом: список УПД
	// бывает большим, и одна строка-снимок съела бы память сервера.
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Для Каждого СтрокаУПД Из ТаблицаУПД Цикл

		ЗначенияСтроки = Новый Массив;
		Для Каждого Колонка Из ТаблицаУПД.Колонки Цикл
			ЗначенияСтроки.Добавить(Строка(СтрокаУПД[Колонка.Имя]));
		КонецЦикла;
		Хеш.Добавить(СтрСоединить(ЗначенияСтроки, Символы.ПС));

	КонецЦикла;

	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма);

КонецФункции

#КонецОбласти