
#Область ПрограммныйИнтерфейс

// Обработчик команды "ТестироватьМеханизм" на форме.
//
Процедура ТестироватьМеханизм(Форма) Экспорт

	Попытка
		Результат = ЭАрМ_ПанельУправленияЭДОСервер.ВыполнитьТестовыйСценарий();

		// Заполнить журнал на форме с визуализацией
		Форма.ЖурналОтправок.Очистить();
		Для Каждого СтрокаЖурнала Из Результат.ЖурналОтправок Цикл
			НоваяСтрока = Форма.ЖурналОтправок.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЖурнала);
		КонецЦикла;

		ПоказатьПредупреждение(, Результат.Результат, 10, "АРМ ЭДО");

	Исключение
		ПоказатьПредупреждение(,
			"Ошибка выполнения теста: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			10, "АРМ ЭДО");
	КонецПопытки;

КонецПроцедуры

// Обработчик команды "ЗаписатьНастройки" на форме.
//
Процедура ЗаписатьНастройки(Форма) Экспорт

	Попытка
		ЭАрМ_ПанельУправленияЭДОСервер.СохранитьНастройки(
			Форма.АдресСервиса, Форма.ИспользоватьАвтоОтправку);
		ПоказатьПредупреждение(, "Настройки сохранены", 5, "АРМ ЭДО");
	Исключение
		ПоказатьПредупреждение(,
			"Ошибка сохранения настроек: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			10, "АРМ ЭДО");
	КонецПопытки;

КонецПроцедуры

// Обработчик команды "ПроверитьСтатусы" на форме.
// Загружает журнал и применяет визуализацию по статусам.
//
Процедура ПроверитьСтатусы(Форма) Экспорт

	Попытка
		Журнал = ЭАрМ_ПанельУправленияЭДОСервер.ЗагрузитьЖурналОтправок();

		Форма.ЖурналОтправок.Очистить();
		Для Каждого СтрокаЖурнала Из Журнал Цикл
			НоваяСтрока = Форма.ЖурналОтправок.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЖурнала);
		КонецЦикла;

		// Применить визуализацию
		ПрименитьВизуализациюСтатусов(Форма);

		ПоказатьПредупреждение(,
			"Загружено записей: " + Журнал.Количество(), 5, "АРМ ЭДО");

	Исключение
		ПоказатьПредупреждение(,
			"Ошибка загрузки журнала: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			10, "АРМ ЭДО");
	КонецПопытки;

КонецПроцедуры

// Обработчик команды "ПроверитьПодключение" на форме.
//
Процедура ПроверитьПодключение(Форма) Экспорт

	Попытка
		Результат = ЭАрМ_ПанельУправленияЭДОСервер.ПроверитьПодключениеКСервису();

		Если Результат.Доступен Тогда
			ПоказатьПредупреждение(, "Подключение успешно!", 5, "АРМ ЭДО");
		Иначе
			ПоказатьПредупреждение(, "Ошибка: " + Результат.Ошибка, 10, "АРМ ЭДО");
		КонецЕсли;

	Исключение
		ПоказатьПредупреждение(,
			"Ошибка проверки: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			10, "АРМ ЭДО");
	КонецПопытки;

КонецПроцедуры

// Обработчик команды "ОткрытьРегистрЭДО" на форме.
// Открывает форму регистра сведений ЭАрМ_ОжидаемыеПодтвержденияЭДО.
//
Процедура ОткрытьРегистрЭДО() Экспорт

	Попытка
		ОткрытьФорму("РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.ФормаСписка");
	Исключение
		ПоказатьПредупреждение(,
			"Ошибка открытия журнала: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			10, "АРМ ЭДО");
	КонецПопытки;

КонецПроцедуры


// Спрашивает, кто подписывает, если в настройках ЭДО больше одного подписанта.
//
// Один подписант (или ни одного - тогда подготовка сама скажет, что не
// заполнено) - вопроса нет, оповещение получает его номер сразу.
//
// Параметры:
//   ОписаниеОповещения - ОписаниеОповещения - получит Число (номер подписанта)
//                        или Неопределено, если выбор отменили
//
Процедура ВыбратьПодписанта(ОписаниеОповещения) Экспорт

	// Подписант рабочего места (форма «Ожидают отправки»), иначе подписант по
	// умолчанию из настроек ЭДО - без вопроса
	НомерРабочегоМеста = ЭАрМ_ПанельУправленияЭДОСервер.ПодписантБезВопроса(ИмяКомпьютера());
	Если НомерРабочегоМеста > 0 Тогда
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, НомерРабочегоМеста);
		Возврат;
	КонецЕсли;

	Подписанты = ЭАрМ_ПанельУправленияЭДОСервер.ПодписантыСБИС();

	Если Подписанты.Количество() <= 1 Тогда
		ВыполнитьОбработкуОповещения(ОписаниеОповещения,
			?(Подписанты.Количество() = 1, Подписанты[0].Номер, 1));
		Возврат;
	КонецЕсли;

	Список = Новый СписокЗначений;
	Для Каждого Подписант Из Подписанты Цикл
		Список.Добавить(Подписант.Номер, Подписант.Представление);
	КонецЦикла;

	Список.ПоказатьВыборЭлемента(
		Новый ОписаниеОповещения("ВыбратьПодписантаЗавершение", ЭАрМ_ПанельУправленияЭДОКлиент,
			Новый Структура("Оповещение", ОписаниеОповещения)),
		НСтр("ru = 'Кто подписывает?'"));

КонецПроцедуры

// Продолжение ВыбратьПодписанта после выбора в списке.
//
Процедура ВыбратьПодписантаЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.Оповещение,
		?(ВыбранныйЭлемент = Неопределено, Неопределено, ВыбранныйЭлемент.Значение));

КонецПроцедуры

// Подписанты ЭДО и сертификаты этого компьютера в одном окне.
//
// По каждому подписанту из настроек: ФИО, ИНН, должность, отпечаток и что
// за сертификат с этим отпечатком (кому выдан, издатель, срок, ИНН в
// сертификате). Ниже - все личные сертификаты с закрытым ключом: кому
// выдан, ИНН, издатель, срок, отпечаток и какой из них подписант 1 или 2.
// Ничего не подписывает и в СБИС не ходит.
//
Процедура ПоказатьПодписантовИСертификаты() Экспорт

	Просмотр = Новый Структура;
	Просмотр.Вставить("Подписанты", ЭАрМ_ПанельУправленияЭДОСервер.ПодписантыДляПросмотра());
	Просмотр.Вставить("Отпечатки", Новый Массив);
	Просмотр.Вставить("Источники", Новый Соответствие);
	Просмотр.Вставить("Сертификаты", Новый Соответствие);
	Просмотр.Вставить("Индекс", 0);
	Просмотр.Вставить("ОшибкаХранилища", "");

	Для Каждого Подписант Из Просмотр.Подписанты Цикл
		ДобавитьОтпечатокПросмотра(Просмотр, Подписант.ОтпечатокBase64);
	КонецЦикла;

	Состояние(НСтр("ru = 'Чтение личного хранилища сертификатов...'"));

	Попытка
		ЭлектроннаяПодписьКлиент.ПолучитьОтпечаткиСертификатов(
			Новый ОписаниеОповещения("ПросмотрОтпечаткиПолучены", ЭАрМ_ПанельУправленияЭДОКлиент, Просмотр),
			Истина, ЭлектроннаяПодписьКлиент.ПараметрыПолученияОтпечатковСертификатов());
	Исключение
		Просмотр.ОшибкаХранилища = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ПросмотрСледующийСертификат(Просмотр);
	КонецПопытки;

КонецПроцедуры

// Отпечатки личных сертификатов получены - по каждому достаём сам сертификат.
//
Процедура ПросмотрОтпечаткиПолучены(Результат, Просмотр) Экспорт

	Отпечатки = Неопределено;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("Отпечатки", Отпечатки);
		ОшибкаКлиента = "";
		Результат.Свойство("ОшибкаПолученияСертификатовНаКлиенте", ОшибкаКлиента);
		Если ЗначениеЗаполнено(ОшибкаКлиента) Тогда
			Просмотр.ОшибкаХранилища = ОшибкаКлиента;
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(Отпечатки) = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из Отпечатки Цикл
			ДобавитьОтпечатокПросмотра(Просмотр, КлючИЗначение.Ключ);
			Просмотр.Источники.Вставить(КлючИЗначение.Ключ, Строка(КлючИЗначение.Значение));
		КонецЦикла;
	КонецЕсли;

	ПросмотрСледующийСертификат(Просмотр);

КонецПроцедуры

Процедура ПросмотрСледующийСертификат(Просмотр)

	Если Просмотр.Индекс >= Просмотр.Отпечатки.Количество() Тогда
		ПоказатьПросмотрПодписантов(Просмотр);
		Возврат;
	КонецЕсли;

	Отпечаток = Просмотр.Отпечатки[Просмотр.Индекс];
	Состояние(СтрШаблон(НСтр("ru = 'Сертификат %1 из %2...'"),
		Просмотр.Индекс + 1, Просмотр.Отпечатки.Количество()));

	Попытка
		ЭлектроннаяПодписьКлиент.ПолучитьСертификатПоОтпечатку(
			Новый ОписаниеОповещения("ПросмотрСертификатПолучен", ЭАрМ_ПанельУправленияЭДОКлиент, Просмотр),
			Отпечаток, Истина);
	Исключение
		Просмотр.Индекс = Просмотр.Индекс + 1;
		ПросмотрСледующийСертификат(Просмотр);
	КонецПопытки;

КонецПроцедуры

Процедура ПросмотрСертификатПолучен(Сертификат, Просмотр) Экспорт

	Если ТипЗнч(Сертификат) = Тип("СертификатКриптографии") Тогда
		Просмотр.Сертификаты.Вставить(Просмотр.Отпечатки[Просмотр.Индекс], Сертификат);
	КонецЕсли;

	Просмотр.Индекс = Просмотр.Индекс + 1;
	ПросмотрСледующийСертификат(Просмотр);

КонецПроцедуры

Процедура ПоказатьПросмотрПодписантов(Просмотр)

	Состояние();

	Строки = Новый Массив;
	Строки.Добавить(НСтр("ru = 'Подписанты ЭДО и сертификаты'") + " - "
		+ Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДЛФ=DT"));

	// --- Подписанты из настроек
	Если Просмотр.Подписанты.Количество() = 0 Тогда
		Строки.Добавить("");
		Строки.Добавить(НСтр("ru = 'В настройках ЭДО не заполнен ни один подписант.'"));
	КонецЕсли;

	НомераПодписантов = Новый Соответствие;

	Для Каждого Подписант Из Просмотр.Подписанты Цикл

		Строки.Добавить("");
		Строки.Добавить(СтрШаблон(НСтр("ru = '=== Подписант %1 (из настроек) ==='"), Подписант.Номер));
		Строки.Добавить(СтрШаблон(НСтр("ru = 'ФИО:           %1'"), ЗначениеИлиПрочерк(Подписант.ФИО)));
		Строки.Добавить(СтрШаблон(НСтр("ru = 'ИНН:           %1'"), ЗначениеИлиПрочерк(Подписант.ИНН)));
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Должность:     %1'"), ЗначениеИлиПрочерк(Подписант.Должность)));
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Отпечаток:     %1'"), ЗначениеИлиПрочерк(Подписант.Отпечаток)));

		Если НЕ ЗначениеЗаполнено(Подписант.ОтпечатокBase64) Тогда
			Строки.Добавить(НСтр("ru = 'Сертификат:    отпечаток пустой или не шестнадцатеричный - не искали'"));
			Продолжить;
		КонецЕсли;

		НомераПодписантов.Вставить(Подписант.ОтпечатокBase64, Подписант.Номер);

		Сертификат = Просмотр.Сертификаты.Получить(Подписант.ОтпечатокBase64);
		Если Сертификат = Неопределено Тогда
			Строки.Добавить(НСтр("ru = 'Сертификат:    НЕ найден в личном хранилище этого компьютера'"));
			Продолжить;
		КонецЕсли;

		ДобавитьОписаниеСертификата(Строки, Сертификат);

		ИННСертификата = ИННИзСубъекта(Сертификат.Субъект);
		Если ЗначениеЗаполнено(ИННСертификата) И ЗначениеЗаполнено(Подписант.ИНН)
			И СтрНайти(ИННСертификата, Подписант.ИНН) = 0 Тогда
			Строки.Добавить(НСтр("ru = '!!! ИНН в сертификате не совпадает с ИНН подписанта в настройках'"));
		КонецЕсли;

	КонецЦикла;

	// --- Все личные сертификаты
	Строки.Добавить("");
	Строки.Добавить(НСтр("ru = '=== Сертификаты с закрытым ключом на этом компьютере ==='"));

	Если ЗначениеЗаполнено(Просмотр.ОшибкаХранилища) Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Ошибка чтения хранилища: %1'"), Просмотр.ОшибкаХранилища));
	КонецЕсли;

	Найдено = 0;
	Для Каждого Отпечаток Из Просмотр.Отпечатки Цикл

		Источник = Просмотр.Источники.Получить(Отпечаток);
		Сертификат = Просмотр.Сертификаты.Получить(Отпечаток);
		Если Источник = Неопределено Тогда
			// Отпечаток подписанта, которого в хранилище нет - уже показан выше
			Продолжить;
		КонецЕсли;

		Найдено = Найдено + 1;
		НомерПодписанта = НомераПодписантов.Получить(Отпечаток);

		Строки.Добавить("");
		Строки.Добавить(СтрШаблон("%1.%2", Найдено,
			?(НомерПодписанта = Неопределено, "", СтрШаблон(НСтр("ru = ' <- подписант %1'"), НомерПодписанта))));

		Если Сертификат = Неопределено Тогда
			Строки.Добавить(СтрШаблон(НСтр("ru = 'Отпечаток (Base64): %1, источник: %2 - подробности на этом компьютере недоступны'"),
				Отпечаток, Источник));
			Продолжить;
		КонецЕсли;

		ДобавитьОписаниеСертификата(Строки, Сертификат);
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Источник:      %1'"), Источник));

	КонецЦикла;

	Если Найдено = 0 Тогда
		Строки.Добавить(НСтр("ru = 'Сертификатов с закрытым ключом не найдено (или подсистема электронной подписи выключена).'"));
	КонецЕсли;

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(СтрСоединить(Строки, Символы.ПС));
	ТекстовыйДокумент.Показать(НСтр("ru = 'Подписанты и сертификаты'"));

КонецПроцедуры

Процедура ДобавитьОписаниеСертификата(Строки, Сертификат)

	Строки.Добавить(СтрШаблон(НСтр("ru = 'Кому выдан:    %1'"), ПолеОписания(Сертификат.Субъект, "CN")));
	Организация = ПолеОписания(Сертификат.Субъект, "O");
	Если Организация <> "-" Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Организация:   %1'"), Организация));
	КонецЕсли;
	Должность = ПолеОписания(Сертификат.Субъект, "T");
	Если Должность <> "-" Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Должность:     %1'"), Должность));
	КонецЕсли;
	ИНН = ИННИзСубъекта(Сертификат.Субъект);
	Если ЗначениеЗаполнено(ИНН) Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'ИНН:           %1'"), ИНН));
	КонецЕсли;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Кем выдан:     %1'"), ПолеОписания(Сертификат.Издатель, "CN")));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Действует:     с %1 по %2%3'"),
		Формат(Сертификат.ДатаНачала, "ДЛФ=D"), Формат(Сертификат.ДатаОкончания, "ДЛФ=D"),
		?(Сертификат.ДатаОкончания < ОбщегоНазначенияКлиент.ДатаСеанса(), НСтр("ru = ' - ИСТЁК'"), "")));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Отпечаток:     %1'"), ПолучитьHexСтрокуИзДвоичныхДанных(Сертификат.Отпечаток)));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Серийный №:    %1'"), ПолучитьHexСтрокуИзДвоичныхДанных(Сертификат.СерийныйНомер)));

КонецПроцедуры

Процедура ДобавитьОтпечатокПросмотра(Просмотр, Отпечаток)

	Если ЗначениеЗаполнено(Отпечаток) И Просмотр.Отпечатки.Найти(Отпечаток) = Неопределено Тогда
		Просмотр.Отпечатки.Добавить(Отпечаток);
	КонецЕсли;

КонецПроцедуры

Функция ПолеОписания(Описание, Имя)

	Если ТипЗнч(Описание) = Тип("Структура") И Описание.Свойство(Имя) И ЗначениеЗаполнено(Описание[Имя]) Тогда
		Возврат СокрЛП(Описание[Имя]);
	КонецЕсли;

	Возврат "-";

КонецФункции

Функция ИННИзСубъекта(Субъект)

	Для Каждого Имя Из СтрРазделить("ИНН,INN,ИННЮЛ,INNLE", ",") Цикл
		Значение = ПолеОписания(Субъект, Имя);
		Если Значение <> "-" Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЗначениеИлиПрочерк(Значение)

	Возврат ?(ЗначениеЗаполнено(Значение), Значение, НСтр("ru = 'не заполнено'"));

КонецФункции

// --- Автоотправка в СБИС: реестр УПД -> «Ожидают отправки» -> СБИС ---
//
// Общая для формы очереди и формы реестра УПД: флажок «Автоотправка» в любой
// из них включает одну и ту же настройку АвтоотправкаУПД. Одна пачка:
//   1. фоновое задание: сошедшиеся УПД/УКД («Готов к утверждению») ставятся
//      «К отправке» и в очередь, до 5 документов очереди готовятся в СБИС;
//   2. вложения подписываются здесь, на клиенте - ключ у пользователя;
//   3. фоновое задание отправляет подписи;
//   4. форма получает итог в ОповещениеЗавершения и обновляет список.
// Окна ожидания нет: форма остаётся рабочей всё это время.
//
// Состояние пачки живёт в структуре формы (НовоеСостояниеАвтоотправки) и
// передаётся по шагам в дополнительных параметрах оповещений.

// Состояние автоотправки для формы.
//
// Параметры:
//   Форма                 - ФормаКлиентскогоПриложения - владелец пачки
//   ОповещениеЗавершения  - ОписаниеОповещения - вызывается по окончании пачки
//                           со Структурой (Текст, Отправлено - Булево)
//
Функция НовоеСостояниеАвтоотправки(Форма, ОповещениеЗавершения) Экспорт

	Возврат Новый Структура("Форма, ОповещениеЗавершения, НомерПодписанта, Исключить, Идёт,
		|Пакет, Ошибки, ИндексДокумента, ИндексВложения, Сертификат, Менеджер, НачалоПачки",
		Форма, ОповещениеЗавершения, Неопределено, Новый Массив, Ложь,
		Неопределено, Новый Массив, 0, 0, Неопределено, Неопределено, Неопределено);

КонецФункции

// Выбирает подписанта автоотправки (один раз на включение).
//
// Параметры:
//   Состояние  - Структура - см. НовоеСостояниеАвтоотправки
//   Оповещение - ОписаниеОповещения - получает номер подписанта или Неопределено
//
Процедура ВыбратьПодписантаАвтоотправки(Состояние, Оповещение) Экспорт

	ВыбратьПодписанта(Новый ОписаниеОповещения("ПодписантАвтоотправкиВыбран",
		ЭАрМ_ПанельУправленияЭДОКлиент, Новый Структура("Состояние, Оповещение", Состояние, Оповещение)));

КонецПроцедуры

Процедура ПодписантАвтоотправкиВыбран(НомерПодписанта, ДополнительныеПараметры) Экспорт

	ДополнительныеПараметры.Состояние.НомерПодписанта = НомерПодписанта;
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.Оповещение, НомерПодписанта);

КонецПроцедуры

// Снимает минутный таймер автоотправки с формы, которая подписывать не должна.
//
Процедура ОтключитьАвтоотправкуФормы(Форма)

	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Форма.ОтключитьОбработчикОжидания("Подключаемый_Автоотправка");
		Форма.ОтключитьОбработчикОжидания("Подключаемый_АвтоотправкаСейчас");
	Исключение
		// Форма уже закрыта
	КонецПопытки;

КонецПроцедуры

// Запускает следующую пачку, если предыдущая закончилась и подписант выбран.
//
Процедура ЗапуститьАвтоПачку(Состояние) Экспорт

	Если Состояние = Неопределено ИЛИ Состояние.НомерПодписанта = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Галочка включена на другом компьютере - эта форма не готовит пачку,
	// не создаёт криптографию и снимает свой таймер
	Если НЕ ЭАрМ_ПанельУправленияЭДОСервер.АвтоотправкаЭтогоКомпьютера(ИмяКомпьютера()) Тогда
		ОтключитьАвтоотправкуФормы(Состояние.Форма);
		Возврат;
	КонецЕсли;

	// Сторож: пачка «идёт» дольше 20 минут - какой-то шаг цепочки так и не
	// вернулся (закрыли окно пароля, пропала связь). Сбрасываем, иначе
	// автоотправка стояла бы до переоткрытия формы
	Если Состояние.Идёт Тогда
		Если Состояние.НачалоПачки <> Неопределено
			И ТекущаяДата() - Состояние.НачалоПачки > 1200 Тогда
			ЗавершитьАвтоПачку(Состояние, НСтр("ru = 'Пачка не завершилась за 20 минут - сброшена, следующая пойдёт сама.'"), Ложь);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Операция = ЭАрМ_ПанельУправленияЭДОСервер.ЗапуститьАвтоПачкуВФоне(
		Состояние.Форма.УникальныйИдентификатор, Состояние.Исключить, Состояние.НомерПодписанта);

	// Пачку сейчас ведёт другая открытая форма
	Если Операция = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Операция) = Тип("Строка") Тогда
		ЗавершитьАвтоПачку(Состояние, Операция, Ложь);
		Возврат;
	КонецЕсли;

	Состояние.Идёт = Истина;
	Состояние.НачалоПачки = ТекущаяДата();
	ОжидатьФоновоеАвтоотправки(Состояние, Операция, "АвтоПачкаПодготовлена",
		НСтр("ru = 'Автоотправка: подготовка документов в СБИС'"));

КонецПроцедуры

Процедура АвтоПачкаПодготовлена(Результат, Состояние) Экспорт

	// Пачку уже сбросил сторож (см. ЗапуститьАвтоПачку) - поздний ответ не нужен
	Если НЕ Состояние.Идёт Тогда
		Возврат;
	КонецЕсли;

	ТекстОшибки = "";
	Данные = РезультатФоновогоАвтоотправки(Результат, ТекстОшибки);
	Если Данные = Неопределено Тогда
		ЗавершитьАвтоПачку(Состояние, ТекстОшибки, Ложь);
		Возврат;
	КонецЕсли;

	// Взятые документы второй раз в этом сеансе не берём, как бы ни кончилось
	Для Каждого ДокументОчереди Из Данные.Документы Цикл
		Состояние.Исключить.Добавить(ДокументОчереди.ИдентификаторСБИС);
	КонецЦикла;

	Состояние.Пакет  = Данные.Подписания;
	Состояние.Ошибки = Данные.Ошибки;

	Если Состояние.Пакет.Количество() = 0 Тогда
		ЗавершитьАвтоПачку(Состояние, СтрСоединить(Состояние.Ошибки, Символы.ПС), Ложь);
		Возврат;
	КонецЕсли;

	ЭлектроннаяПодписьКлиент.ПолучитьСертификатПоОтпечатку(
		Новый ОписаниеОповещения("АвтоСертификатПолучен", ЭАрМ_ПанельУправленияЭДОКлиент, Состояние),
		Состояние.Пакет[0].ОтпечатокBase64, Истина);

КонецПроцедуры

Процедура АвтоСертификатПолучен(Сертификат, Состояние) Экспорт

	Если ТипЗнч(Сертификат) <> Тип("СертификатКриптографии") Тогда
		ЗавершитьАвтоПачку(Состояние, СтрШаблон(НСтр(
			"ru = 'Сертификат с отпечатком %1 не найден на этом компьютере - в СБИС ничего не отправлено.'"),
			Состояние.Пакет[0].Отпечаток), Ложь);
		Возврат;
	КонецЕсли;

	Состояние.Сертификат = Сертификат;
	ЭлектроннаяПодписьКлиент.СоздатьМенеджерКриптографии(
		Новый ОписаниеОповещения("АвтоМенеджерПолучен", ЭАрМ_ПанельУправленияЭДОКлиент, Состояние),
		"Подписание", Истина, Сертификат.Выгрузить());

КонецПроцедуры

Процедура АвтоМенеджерПолучен(МенеджерКриптографии, Состояние) Экспорт

	Если ТипЗнч(МенеджерКриптографии) <> Тип("МенеджерКриптографии") Тогда
		ЗавершитьАвтоПачку(Состояние, НСтр(
			"ru = 'Не удалось создать менеджер криптографии - в СБИС ничего не отправлено.'"), Ложь);
		Возврат;
	КонецЕсли;

	Состояние.Менеджер = МенеджерКриптографии;
	Состояние.ИндексДокумента = 0;
	Состояние.ИндексВложения  = 0;
	АвтоПодписатьСледующее(Состояние);

КонецПроцедуры

Процедура АвтоПодписатьСледующее(Состояние)

	Пока Состояние.ИндексДокумента < Состояние.Пакет.Количество() Цикл

		Подписание = Состояние.Пакет[Состояние.ИндексДокумента];
		Если Состояние.ИндексВложения < Подписание.Вложения.Количество() Тогда
			Вложение = Подписание.Вложения[Состояние.ИндексВложения];
			// Обработчик ошибки: без него сбой подписи не вызывал продолжения,
			// Состояние.Идёт оставалось Истина - автоотправка вставала
			Состояние.Менеджер.НачатьПодписывание(
				Новый ОписаниеОповещения("АвтоВложениеПодписано", ЭАрМ_ПанельУправленияЭДОКлиент, Состояние,
					"АвтоВложениеНеПодписано", ЭАрМ_ПанельУправленияЭДОКлиент),
				Вложение.Данные, Состояние.Сертификат);
			Возврат;
		КонецЕсли;

		Состояние.ИндексДокумента = Состояние.ИндексДокумента + 1;
		Состояние.ИндексВложения  = 0;

	КонецЦикла;

	АвтоОтправитьПодписи(Состояние);

КонецПроцедуры

Процедура АвтоВложениеНеПодписано(ИнформацияОбОшибке, СтандартнаяОбработка, Состояние) Экспорт

	СтандартнаяОбработка = Ложь;
	ЗавершитьАвтоПачку(Состояние, НСтр("ru = 'Ошибка подписи: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке)
		+ НСтр("ru = ' - в СБИС ничего не отправлено.'"), Ложь);

КонецПроцедуры

Процедура АвтоВложениеПодписано(ДанныеПодписи, Состояние) Экспорт

	Если ТипЗнч(ДанныеПодписи) <> Тип("ДвоичныеДанные") Тогда
		ЗавершитьАвтоПачку(Состояние, НСтр("ru = 'Подписание прервано - в СБИС ничего не отправлено.'"), Ложь);
		Возврат;
	КонецЕсли;

	Состояние.Пакет[Состояние.ИндексДокумента].Вложения[Состояние.ИндексВложения].Подпись = ДанныеПодписи;
	Состояние.ИндексВложения = Состояние.ИндексВложения + 1;

	АвтоПодписатьСледующее(Состояние);

КонецПроцедуры

// Подписи всей пачки - одним фоновым заданием. Состав - как у формы очереди
// (ОтправитьПакетПодписей): сертификат и менеджер на сервер не передаются.
//
Процедура АвтоОтправитьПодписи(Состояние)

	Пакет = Новый Массив;

	Для Каждого Подписание Из Состояние.Пакет Цикл

		ВложенияОтправки = Новый Массив;
		Для Каждого Вложение Из Подписание.Вложения Цикл
			ВложениеОтправки = Новый Структура("Идентификатор, Имя, Подпись",
				Вложение.Идентификатор, Вложение.Имя, Вложение.Подпись);
			Если Вложение.Свойство("ФайлЗаменён") И Вложение.ФайлЗаменён Тогда
				ВложениеОтправки.Вставить("Данные", Вложение.Данные);
				ВложениеОтправки.Вставить("ФайлЗаменён", Истина);
			КонецЕсли;
			ВложенияОтправки.Добавить(ВложениеОтправки);
		КонецЦикла;

		ДанныеОтправки = Новый Структура;
		ДанныеОтправки.Вставить("Реестр",               Подписание.Реестр);
		ДанныеОтправки.Вставить("Идентификатор",        Подписание.Идентификатор);
		ДанныеОтправки.Вставить("Этап",                 Подписание.Этап);
		ДанныеОтправки.Вставить("Действие",             Подписание.Действие);
		ДанныеОтправки.Вставить("Вложения",             ВложенияОтправки);
		ДанныеОтправки.Вставить("ИдентификаторЗапроса", Подписание.ИдентификаторЗапроса);
		ДанныеОтправки.Вставить("НомерДокумента",       Подписание.НомерДокумента);
		ДанныеОтправки.Вставить("НомерПодписанта",      ?(Подписание.Свойство("НомерПодписанта"),
			Подписание.НомерПодписанта, 1));
		Пакет.Добавить(ДанныеОтправки);

	КонецЦикла;

	Операция = ЭАрМ_ПанельУправленияЭДОСервер.ЗапуститьОтправкуАвтоПачкиВФоне(
		Состояние.Форма.УникальныйИдентификатор, Пакет);
	Если Операция = Неопределено Тогда
		ЗавершитьАвтоПачку(Состояние, "", Ложь);
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Операция) = Тип("Строка") Тогда
		ЗавершитьАвтоПачку(Состояние, Операция, Ложь);
		Возврат;
	КонецЕсли;

	ОжидатьФоновоеАвтоотправки(Состояние, Операция, "АвтоПодписиОтправлены",
		СтрШаблон(НСтр("ru = 'Автоотправка: отправка подписей в СБИС (%1)'"), Пакет.Количество()));

КонецПроцедуры

Процедура АвтоПодписиОтправлены(Результат, Состояние) Экспорт

	// Пачку уже сбросил сторож (см. ЗапуститьАвтоПачку) - поздний ответ не нужен
	Если НЕ Состояние.Идёт Тогда
		Возврат;
	КонецЕсли;

	ТекстОшибки = "";
	Итоги = РезультатФоновогоАвтоотправки(Результат, ТекстОшибки);
	Если Итоги = Неопределено Тогда
		ЗавершитьАвтоПачку(Состояние, ТекстОшибки, Истина);
		Возврат;
	КонецЕсли;

	ТекстСводки = "";
	Если ТипЗнч(Итоги) = Тип("Структура") Тогда
		Итоги.Свойство("ТекстСводки", ТекстСводки);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекстСводки) Тогда
		ТекстСводки = ТекстСводкиОтправкиКлиент(Итоги);
	КонецЕсли;
	ЗавершитьАвтоПачку(Состояние, ТекстСводки, Истина);

КонецПроцедуры

Процедура ЗавершитьАвтоПачку(Состояние, Текст, Отправлено)

	Части = Новый Массив;
	Если ЗначениеЗаполнено(Текст) Тогда
		Части.Добавить(Текст);
	КонецЕсли;
	Если Отправлено И Состояние.Ошибки.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'Не дошли до подписи: %1'"), Состояние.Ошибки.Количество()));
	КонецЕсли;

	Состояние.Идёт       = Ложь;
	Состояние.Пакет      = Неопределено;
	Состояние.Ошибки     = Новый Массив;
	Состояние.Сертификат = Неопределено;
	Состояние.Менеджер   = Неопределено;

	Попытка
		ЭАрМ_ПанельУправленияЭДОСервер.ОсвободитьАвтоотправку(Состояние.Форма.УникальныйИдентификатор);
	Исключение
		// Отметка сама устареет через несколько минут
	КонецПопытки;

	ВыполнитьОбработкуОповещения(Состояние.ОповещениеЗавершения,
		Новый Структура("Текст, Отправлено", СтрСоединить(Части, Символы.ПС), Отправлено));

КонецПроцедуры

Процедура ОжидатьФоновоеАвтоотправки(Состояние, Операция, ИмяОбработчика, ТекстСообщения)

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Состояние.Форма);
	ПараметрыОжидания.ТекстСообщения = ТекстСообщения;
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;

	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция,
		Новый ОписаниеОповещения(ИмяОбработчика, ЭАрМ_ПанельУправленияЭДОКлиент, Состояние),
		ПараметрыОжидания);

КонецПроцедуры

Функция РезультатФоновогоАвтоотправки(Результат, ТекстОшибки)

	Если Результат = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Ожидание ответа СБИС отменено'");
		Возврат Неопределено;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		ТекстОшибки = Результат.КраткоеПредставлениеОшибки;
		Если ЭтоОшибкаЗаданиеУжеИдёт(ТекстОшибки) Тогда
			ТекстОшибки = "";
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПолучитьИзВременногоХранилища(Результат.АдресРезультата);

КонецФункции

// --- Индикатор отправки в шапке (форма очереди «Ожидают отправки») ---
//
// Форма опрашивает раз в несколько секунд. Показывает только картинки:
//   идёт      - колесо БСП и зелёная галочка (СБИС или Бухгалтерия);
//   выключено - серая пауза;
//   включено и ничего не уходит - пусто, без секундомера.
//
// Параметры:
//   Форма            - ФормаКлиентскогоПриложения
//   ИмяЭлемента      - Строка - декорация-надпись в шапке (скрыта)
//   Кэш              - Произвольный - переменная формы (сначала Неопределено)
//   ФормаОтправляет  - Булево - эта форма сама подписывает пачку
//
// Возвращаемое значение:
//   Булево - отправка только что закончилась: форме пора перечитать список
//
Функция ОбновитьИндикаторОтправки(Форма, ИмяЭлемента, Кэш, ФормаОтправляет = Ложь) Экспорт

	Если Кэш = Неопределено Тогда
		Кэш = Новый Структура("Состояние, ПолученоВ, Шаг, Шло, НачалоФормы, Картинка",
			Неопределено, Дата(1, 1, 1), 0, Ложь, Неопределено, Ложь);
	ИначеЕсли НЕ Кэш.Свойство("Картинка") Тогда
		Кэш.Вставить("Картинка", Ложь);
	КонецЕсли;

	Сейчас = ТекущаяДата();
	Кэш.Шаг = Кэш.Шаг + 1;

	// Сервер спрашиваем раз в 10 секунд во время отправки и раз в 30 в
	// покое: индикатор - только картинка, а каждый опрос - вызов сервера от
	// каждой открытой формы. Раньше было 3 и 10 секунд
	Если Кэш.Состояние = Неопределено ИЛИ Сейчас - Кэш.ПолученоВ >= ?(Кэш.Шло, 10, 30) Тогда
		Кэш.Состояние = ЭАрМ_ПанельУправленияЭДОСервер.СостояниеИндикатораОтправки();
		Кэш.ПолученоВ = Сейчас;
	КонецЕсли;

	Элемент = Форма.Элементы[ИмяЭлемента];
	Картинка = Форма.Элементы.Найти(СтрЗаменить(ИмяЭлемента, "Надпись", "Картинка"));
	Метка = Форма.Элементы.Найти("ОтправкаИдётМетка");
	Стоп = Форма.Элементы.Найти("АвтоотправкаВыключенаКартинка");
	Состояние = Кэш.Состояние;
	Если Состояние = Неопределено Тогда
		Элемент.Заголовок = "";
		Элемент.Видимость = Ложь;
		ПоказатьКолесоОтправки(Картинка, Ложь, Кэш);
		ПоказатьЭлементИндикатора(Метка, Ложь);
		ПоказатьЭлементИндикатора(Стоп, Ложь);
		Возврат Ложь;
	КонецЕсли;

	Если ФормаОтправляет Тогда
		Если Кэш.НачалоФормы = Неопределено Тогда
			Кэш.НачалоФормы = Сейчас;
		КонецЕсли;
	Иначе
		Кэш.НачалоФормы = Неопределено;
	КонецЕсли;

	ИдётБухгалтерия = Состояние.Свойство("ИдётБухгалтерия") И Состояние.ИдётБухгалтерия;
	Идёт = Состояние.Идёт ИЛИ ФормаОтправляет ИЛИ ИдётБухгалтерия;

	ПоказатьКолесоОтправки(Картинка, Идёт, Кэш);
	ПоказатьЭлементИндикатора(Метка, Идёт);
	ПоказатьЭлементИндикатора(Стоп, НЕ Идёт И НЕ Состояние.Включено);

	Элемент.Заголовок = "";
	Элемент.Видимость = Ложь;

	Закончилась = Кэш.Шло И НЕ Идёт;
	Кэш.Шло = Идёт;
	Если Закончилась Тогда
		Кэш.Состояние = Неопределено;
	КонецЕсли;

	Возврат Закончилась;

КонецФункции

Процедура ПоказатьЭлементИндикатора(Элемент, Показать)

	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Элемент.Видимость <> Показать Тогда
		Элемент.Видимость = Показать;
	КонецЕсли;

КонецПроцедуры

// Колесо БСП рядом с надписью, пока идёт задание. Картинки нет в форме -
// вызывающий ставит unicode-кадры в заголовок.
//
Процедура ПоказатьКолесоОтправки(Картинка, Показать, Кэш)

	Если Картинка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Показать И НЕ Кэш.Картинка Тогда
		Попытка
			Картинка.Картинка = БиблиотекаКартинок.ДлительнаяОперация16;
		Исключение
			Попытка
				Картинка.Картинка = БиблиотекаКартинок.ДлительнаяОперация48;
			Исключение
			КонецПопытки;
		КонецПопытки;
		Кэш.Картинка = Истина;
	КонецЕсли;

	Если Картинка.Видимость <> Показать Тогда
		Картинка.Видимость = Показать;
	КонецЕсли;

КонецПроцедуры

// Сбрасывает опрос индикатора: следующий тик спросит сервер сразу (после
// нажатия «Отправить», смены настроек).
//
Процедура СброситьИндикаторОтправки(Кэш) Экспорт

	Если Кэш <> Неопределено Тогда
		Кэш.Состояние = Неопределено;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// «4:05», «1:02:33».
//
Функция ТекстТаймера(Знач Секунд)

	Секунд = Макс(0, Цел(Секунд));
	Часов = Цел(Секунд / 3600);
	Минут = Цел((Секунд - Часов * 3600) / 60);
	Сек = Секунд % 60;

	Если Часов > 0 Тогда
		Возврат СтрШаблон("%1:%2:%3", Часов, Формат(Минут, "ЧЦ=2; ЧВН=; ЧН=00"), Формат(Сек, "ЧЦ=2; ЧВН=; ЧН=00"));
	КонецЕсли;

	Возврат СтрШаблон("%1:%2", Минут, Формат(Сек, "ЧЦ=2; ЧВН=; ЧН=00"));

КонецФункции

// « · сегодня УПД 3, ЭТрН 1, УКД 0» - пустая строка, если полей ещё нет.
//
Функция ТекстСегодняПоРеестрам(Состояние)

	Если ТипЗнч(Состояние) <> Тип("Структура")
		ИЛИ НЕ Состояние.Свойство("СегодняУПД") Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = ' · сегодня УПД %1, ЭТрН %2, УКД %3'"),
		Состояние.СегодняУПД, Состояние.СегодняЭТрН, Состояние.СегодняУКД);

КонецФункции

// Оповещение об итоге отправки: без окна с текстом. «Уже выполняется» не показываем.
//
Процедура ПоказатьИтогОтправкиСБИС(Текст) Экспорт

	Если НЕ ЗначениеЗаполнено(Текст) ИЛИ ЭтоОшибкаЗаданиеУжеИдёт(Текст) Тогда
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Отправка в СБИС'"), , Лев(Текст, 300));

КонецПроцедуры

Функция ЭтоОшибкаЗаданиеУжеИдёт(Текст) Экспорт

	Возврат СтрНайти(НРег(Строка(Текст)), "уже выполняется") > 0;

КонецФункции

Функция ТекстСводкиОтправкиКлиент(Итоги)

	УПД = 0;
	ЭТрН = 0;
	УКД = 0;
	Подписано = 0;
	Ошибок = 0;
	Если ТипЗнч(Итоги) = Тип("Структура") Тогда
		Итоги.Свойство("УПД", УПД);
		Итоги.Свойство("ЭТрН", ЭТрН);
		Итоги.Свойство("УКД", УКД);
		Итоги.Свойство("Подписано", Подписано);
		Итоги.Свойство("Ошибок", Ошибок);
	КонецЕсли;
	УПД = ?(ТипЗнч(УПД) = Тип("Число"), УПД, 0);
	ЭТрН = ?(ТипЗнч(ЭТрН) = Тип("Число"), ЭТрН, 0);
	УКД = ?(ТипЗнч(УКД) = Тип("Число"), УКД, 0);
	Подписано = ?(ТипЗнч(Подписано) = Тип("Число"), Подписано, 0);
	Ошибок = ?(ТипЗнч(Ошибок) = Тип("Число"), Ошибок, 0);

	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = 'Отправлено в СБИС: УПД %1, ЭТрН %2, УКД %3'"),
		УПД, ЭТрН, УКД));
	Если Подписано > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'подпись подтверждена: %1'"), Подписано));
	КонецЕсли;
	Если Ошибок > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'с ошибкой: %1'"), Ошибок));
	КонецЕсли;

	Возврат СтрСоединить(Части, ". ") + ".";

КонецФункции

// Применяет визуализацию статусов к таблице журнала на форме.
// Окрашивает строки и устанавливает индикаторы в зависимости от статуса.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - форма обработки
//
Процедура ПрименитьВизуализациюСтатусов(Форма)

	Попытка
		Для Каждого СтрокаЖурнала Из Форма.ЖурналОтправок Цикл
			Статус = НРег(СокрЛП(СтрокаЖурнала.Статус));

			// Устанавливаем представление статуса с индикатором
			Если Статус = "ожидает" Тогда
				СтрокаЖурнала.Статус = "⏳ Ожидает";
			ИначеЕсли Статус = "подтверждено" Тогда
				СтрокаЖурнала.Статус = "✅ Подтверждено";
			ИначеЕсли Статус = "отклонено" Тогда
				СтрокаЖурнала.Статус = "❌ Отклонено";
			ИначеЕсли Статус = "создан" Тогда
				СтрокаЖурнала.Статус = "🆕 Создан";
			ИначеЕсли Статус = "ошибка" Тогда
				СтрокаЖурнала.Статус = "⚠️ Ошибка";
			ИначеЕсли Статус = "проверен" Тогда
				СтрокаЖурнала.Статус = "🔍 Проверен";
			ИначеЕсли Статус = "отправленвпапку" Тогда
				СтрокаЖурнала.Статус = "📁 Отправлен в папку";
			ИначеЕсли Статус = "регламентновыполнено" Тогда
				СтрокаЖурнала.Статус = "⏰ Регл. задание OK";
			КонецЕсли;

		КонецЦикла;
	Исключение
		// Визуализация не критична, игнорируем ошибки
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
