// Тесты модулей ЭАрМ_ДвиженияТоваров и ЭАрМ_ВедомостьАннулированных.
// Запуск: ЭАрМ_ТестыДвижений.ПрогнатьВсе()

#Область ПрограммныйИнтерфейс

// Прогон всех тестов.
//
Функция ПрогнатьВсе() Экспорт

	Итог = Новый Структура("Пройдено, Провалено, Ошибки", 0, 0, Новый Массив);

	// Движения товаров
	ПрогнатьТест(Итог, "Тест_ВидыДвижения", Тест_ВидыДвижения());
	ПрогнатьТест(Итог, "Тест_ОпределитьВидДвижения", Тест_ОпределитьВидДвижения());
	ПрогнатьТест(Итог, "Тест_ЭтоВозвратЭтоПриход", Тест_ЭтоВозвратЭтоПриход());
	ПрогнатьТест(Итог, "Тест_ПредставлениеВида", Тест_ПредставлениеВида());
	ПрогнатьТест(Итог, "Тест_ПодсчитатьДвижения", Тест_ПодсчитатьДвижения());

	// Ведомость аннулированных
	ПрогнатьТест(Итог, "Тест_Ведомость_Структура", Тест_Ведомость_Структура());
	ПрогнатьТест(Итог, "Тест_ОпределитьСтатус", Тест_ОпределитьСтатус());

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область ТестыДвижений

// Тест: Виды движения — константы.
//
Функция Тест_ВидыДвижения()

	Ошибки = Новый Массив;

	Проверить(Ошибки, "Приход", ЭАрМ_ДвиженияТоваров.ВидПриход(), "Приход");
	Проверить(Ошибки, "Возврат", ЭАрМ_ДвиженияТоваров.ВидВозврат(), "Возврат");
	Проверить(Ошибки, "Разные", ЭАрМ_ДвиженияТоваров.ВидПриход() <> ЭАрМ_ДвиженияТоваров.ВидВозврат(), Истина);

	Возврат РезультатТеста(Ошибки);

КонецФункции

// Тест: ОпределитьВидДвижения — все ветки.
//
Функция Тест_ОпределитьВидДвижения()

	Ошибки = Новый Массив;

	// 1. Явный признак
	С = Новый Структура("ПризнакВозврата", Истина);
	Проверить(Ошибки, "Явный признак",
		ЭАрМ_ДвиженияТоваров.ОпределитьВидДвижения(С), "Возврат");

	// 2. Тип документа
	С = Новый Структура("ТипДокумента", "ВозвратПоставщику");
	Проверить(Ошибки, "Тип документа",
		ЭАрМ_ДвиженияТоваров.ОпределитьВидДвижения(С), "Возврат");

	// 3. Отрицательное количество
	С = Новый Структура("Количество", -5);
	Проверить(Ошибки, "Отриц. количество",
		ЭАрМ_ДвиженияТоваров.ОпределитьВидДвижения(С), "Возврат");

	// 4. Отрицательная сумма
	С = Новый Структура("Сумма", -1000);
	Проверить(Ошибки, "Отриц. сумма",
		ЭАрМ_ДвиженияТоваров.ОпределитьВидДвижения(С), "Возврат");

	// 5. Обычный приход
	С = Новый Структура("Количество, Сумма", 10, 5000);
	Проверить(Ошибки, "Обычный приход",
		ЭАрМ_ДвиженияТоваров.ОпределитьВидДвижения(С), "Приход");

	// 6. Пустая структура
	С = Новый Структура;
	Проверить(Ошибки, "Пустая",
		ЭАрМ_ДвиженияТоваров.ОпределитьВидДвижения(С), "Приход");

	Возврат РезультатТеста(Ошибки);

КонецФункции

// Тест: ЭтоВозврат / ЭтоПриход.
//
Функция Тест_ЭтоВозвратЭтоПриход()

	Ошибки = Новый Массив;

	Проверить(Ошибки, "ЭтоВозврат(Возврат)",
		ЭАрМ_ДвиженияТоваров.ЭтоВозврат("Возврат"), Истина);
	Проверить(Ошибки, "ЭтоВозврат(Приход)",
		ЭАрМ_ДвиженияТоваров.ЭтоВозврат("Приход"), Ложь);
	Проверить(Ошибки, "ЭтоПриход(Приход)",
		ЭАрМ_ДвиженияТоваров.ЭтоПриход("Приход"), Истина);
	Проверить(Ошибки, "ЭтоПриход(Возврат)",
		ЭАрМ_ДвиженияТоваров.ЭтоПриход("Возврат"), Ложь);

	Возврат РезультатТеста(Ошибки);

КонецФункции

// Тест: ПредставлениеВида.
//
Функция Тест_ПредставлениеВида()

	Ошибки = Новый Массив;

	Проверить(Ошибки, "Приход",
		ЭАрМ_ДвиженияТоваров.ПредставлениеВида("Приход"), "→ Приход");
	Проверить(Ошибки, "Возврат",
		ЭАрМ_ДвиженияТоваров.ПредставлениеВида("Возврат"), "↩ Возврат");

	Возврат РезультатТеста(Ошибки);

КонецФункции

// Тест: ПодсчитатьДвижения.
//
Функция Тест_ПодсчитатьДвижения()

	Ошибки = Новый Массив;

	Движения = Новый Массив;
	Движения.Добавить(Новый Структура("ВидДвижения", "Приход"));
	Движения.Добавить(Новый Структура("ВидДвижения", "Приход"));
	Движения.Добавить(Новый Структура("ВидДвижения", "Возврат"));
	Движения.Добавить(Новый Структура("ВидДвижения", "Возврат"));
	Движения.Добавить(Новый Структура("ВидДвижения", "Возврат"));

	Итог = ЭАрМ_ДвиженияТоваров.ПодсчитатьДвижения(Движения);

	Проверить(Ошибки, "Приход", Итог.Приход, 2);
	Проверить(Ошибки, "Возврат", Итог.Возврат, 3);
	Проверить(Ошибки, "Всего", Итог.Всего, 5);

	Возврат РезультатТеста(Ошибки);

КонецФункции

#КонецОбласти

#Область ТестыВедомости

// Тест: Структура результата ведомости.
//
Функция Тест_Ведомость_Структура()

	Ошибки = Новый Массив;

	// Пустой период — пустая ведомость
	В = ЭАрМ_ВедомостьАннулированных.СформироватьВедомость(
		'20260101', '20260101');

	Проверить(Ошибки, "Есть Документы", В.Свойство("Документы"), Истина);
	Проверить(Ошибки, "Есть Итоги", В.Свойство("Итоги"), Истина);
	Проверить(Ошибки, "Есть Заголовок", В.Свойство("Заголовок"), Истина);
	Проверить(Ошибки, "Итоги.Количество", В.Итоги.Количество, 0);
	Проверить(Ошибки, "Итоги.Сумма", В.Итоги.Сумма, 0);
	Проверить(Ошибки, "Итоги.ВычетЗаявлен", В.Итоги.ВычетЗаявлен, 0);

	Возврат РезультатТеста(Ошибки);

КонецФункции

// Тест: ОпределитьСтатус — все 4 ветки.
//
Функция Тест_ОпределитьСтатус()

	Ошибки = Новый Массив;

	// Вычет заявлен + есть замена
	В1 = Новый Структура("ВыгруженВБух, ЗамененаНа", Истина, "Док-123");
	Статус = ЭАрМ_ВедомостьАннулированных.ОпределитьСтатус(В1);
	Проверить(Ошибки, "Вычет+замена", СтрНайти(Статус, "Вычет заявлен") > 0, Истина);
	Проверить(Ошибки, "Вычет+замена: есть замена", СтрНайти(Статус, "есть замена") > 0, Истина);

	// Вычет заявлен + нет замены
	В2 = Новый Структура("ВыгруженВБух, ЗамененаНа", Истина, "");
	Статус = ЭАрМ_ВедомостьАннулированных.ОпределитьСтатус(В2);
	Проверить(Ошибки, "Вычет без замены", СтрНайти(Статус, "замены нет") > 0, Истина);

	// Вычет НЕ заявлен + есть замена
	В3 = Новый Структура("ВыгруженВБух, ЗамененаНа", Ложь, "Док-456");
	Статус = ЭАрМ_ВедомостьАннулированных.ОпределитьСтатус(В3);
	Проверить(Ошибки, "Без вычета+замена", СтрНайти(Статус, "Есть замена") > 0, Истина);

	// Вычет НЕ заявлен + нет замены
	В4 = Новый Структура("ВыгруженВБух, ЗамененаНа", Ложь, "");
	Статус = ЭАрМ_ВедомостьАннулированных.ОпределитьСтатус(В4);
	Проверить(Ошибки, "Без вычета без замены", СтрНайти(Статус, "Не выгружен") > 0, Истина);

	Возврат РезультатТеста(Ошибки);

КонецФункции

#КонецОбласти

#Область Вспомогательные

Процедура Проверить(Ошибки, ИмяПроверки, Факт, Ожидание)

	Если Факт <> Ожидание Тогда
		Ошибки.Добавить(СтрШаблон("  ✗ %1: ожидалось «%2», получено «%3»",
			ИмяПроверки, Ожидание, Факт));
	КонецЕсли;

КонецПроцедуры

Функция РезультатТеста(Ошибки)

	Возврат Новый Структура("Успех, Ошибки", Ошибки.Количество() = 0, Ошибки);

КонецФункции

Процедура ПрогнатьТест(Итог, ИмяТеста, Результат)

	Если Результат.Успех Тогда
		Итог.Пройдено = Итог.Пройдено + 1;
	Иначе
		Итог.Провалено = Итог.Провалено + 1;
		Для Каждого Ошибка Из Результат.Ошибки Цикл
			Итог.Ошибки.Добавить(ИмяТеста + ":" + Символы.ПС + Ошибка);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
