#Область ПрограммныйИнтерфейс

// Настройка «Обработка событий через очередь». Выключена - подписки работают
// по-старому (прямой вызов), форма реестра УПД - со старыми таймерами.
//
Функция ОчередьВключена() Экспорт

	Возврат ЭАрМ_НастройкиСервер.ЗначениеНастройки("Очередь_Включена") = Истина;

КонецФункции

// Тип документа ЭДО по его виду.
//
Функция ТипДокументаПоВиду(ВидДокумента) Экспорт

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидДокумента, "ТипДокумента");

КонецФункции

#КонецОбласти
