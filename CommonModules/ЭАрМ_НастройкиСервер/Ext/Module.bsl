// Настройка «Отключить все фоновые задания».
//
Функция ФоновыеЗаданияОтключены() Экспорт

	Возврат ЗначениеНастройки("ОтключитьФоновыеЗадания") = Истина;

КонецФункции

// Включает или снимает с расписания регламентные задания расширения.
// При включении настройки останавливает уже запущенные фоновые задания ЭДО.
//
Процедура ПрименитьОтключениеФоновыхЗаданий() Экспорт

	Отключить = ФоновыеЗаданияОтключены();
	ВключитьЗадания = НЕ Отключить;

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Для Каждого МетаЗадания Из Метаданные.РегламентныеЗадания Цикл
			Если НЕ СтрНачинаетсяС(МетаЗадания.Имя, "ЭАрМ_") Тогда
				Продолжить;
			КонецЕсли;
			Задание = РегламентныеЗадания.НайтиПредопределенное(МетаЗадания);
			Если Задание = Неопределено ИЛИ Задание.Использование = ВключитьЗадания Тогда
				Продолжить;
			КонецЕсли;
			Задание.Использование = ВключитьЗадания;
			Задание.Записать();
		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ЭАрМ_Служебный.ЗаписатьОшибку("ОтключитьФоновыеЗадания",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если НЕ Отключить Тогда
		Возврат;
	КонецЕсли;

	Отбор = Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно);
	Для Каждого Фоновое Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл
		Если НЕ СтрНачинаетсяС(Фоновое.ИмяМетода, "ЭАрМ_") Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Фоновое.Отменить();
		Исключение
			ЭАрМ_Служебный.ЗаписатьОшибку("ОтключитьФоновыеЗадания",
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Окно "столько-то дней назад - сегодня" в том виде, в каком его понимает
// фильтр СБИС.
//
Функция ПериодПоГлубине(Глубина)

	Результат = Новый Структура;
	Результат.Вставить("ДатаПо", Формат(ТекущаяДатаСеанса(), "ДФ=дд.ММ.гггг"));
	Результат.Вставить("ДатаС",
		Формат(ТекущаяДатаСеанса() - Глубина * 86400, "ДФ=дд.ММ.гггг"));

	Возврат Результат;

КонецФункции

// Добавляет строку в таблицу описания настроек.
//
Процедура ДобавитьОписание(Описание, Ключ, Раздел, Представление, Тип, ЗначениеПоУмолчанию)

	НоваяСтрока = Описание.Добавить();
	НоваяСтрока.Ключ                = Ключ;
	НоваяСтрока.Раздел              = Раздел;
	НоваяСтрока.Представление       = Представление;
	НоваяСтрока.Тип                 = Тип;
	НоваяСтрока.ЗначениеПоУмолчанию = ЗначениеПоУмолчанию;

КонецПроцедуры

// Читает регистр настроек целиком.
//
// Настройки читаются пачками (НастройкиСБИС, НастройкиFTP, НастройкиОбмена),
// поэтому один запрос на все ключи дешевле запроса на каждый ключ.
//
// Возвращаемое значение:
//   Соответствие - ключ настройки: Структура(Значение, ЗначениеБулево)
//
Функция СохраненныеЗначения()

	УстановитьПривилегированныйРежим(Истина);

	Результат = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Настройки.КлючНастройки КАК КлючНастройки,
	|	Настройки.Значение КАК Значение,
	|	Настройки.ЗначениеБулево КАК ЗначениеБулево
	|ИЗ
	|	РегистрСведений.ЭАрМ_НастройкиЭДО КАК Настройки";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.КлючНастройки,
			Новый Структура("Значение, ЗначениеБулево",
				Выборка.Значение, Выборка.ЗначениеБулево));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Приводит хранимое значение к типу настройки.
//
// Регистр хранит всё строкой плюс отдельным булевым ресурсом, поэтому число
// и признак восстанавливаются здесь, а не в каждом вызывающем коде.
//
Функция ЗначениеИзСохраненных(Сохраненные, Ключ, Тип, ЗначениеПоУмолчанию)

	ДанныеНастройки = Сохраненные.Получить(Ключ);

	Если ДанныеНастройки = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если Тип = "Булево" Тогда
		Возврат ДанныеНастройки.ЗначениеБулево;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДанныеНастройки.Значение) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если Тип = "Число" Тогда
		Возврат ЧислоИзСтроки(ДанныеНастройки.Значение, ЗначениеПоУмолчанию);
	КонецЕсли;

	Возврат ДанныеНастройки.Значение;

КонецФункции

// Сессия из прочитанных настроек, если она ещё не устарела.
//
// Сессию СБИС выдаёт надолго, но не навсегда. Хранить её без времени
// получения нельзя: просроченный sid внешне неотличим от рабочего, и обмен
// падал бы на первом же запросе документов.
//
Функция ЖиваяСессия(Значения)

	Если НЕ ЗначениеЗаполнено(Значения.СБИС_Сессия) Тогда
		Возврат "";
	КонецЕсли;

	ДатаПолучения = ДатаИзСтроки(Значения.СБИС_ДатаСессии);
	Если НЕ ЗначениеЗаполнено(ДатаПолучения) Тогда
		Возврат "";
	КонецЕсли;

	ВремяЖизни = Значения.СБИС_ВремяЖизниСессии;
	Если ВремяЖизни <= 0 Тогда
		ВремяЖизни = 20;
	КонецЕсли;

	Если ТекущаяДатаСеанса() - ДатаПолучения > ВремяЖизни * 60 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Значения.СБИС_Сессия;

КонецФункции

// Число из строки настройки. Нечисловое значение не должно ронять чтение
// настроек целиком, поэтому при отказе возвращается умолчание.
//
Функция ЧислоИзСтроки(Значение, ЗначениеПоУмолчанию)

	Попытка
		Возврат Число(СтрЗаменить(СокрЛП(Значение), ",", "."));
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;

КонецФункции

// Дата из строки формата yyyyMMddHHmmss.
//
Функция ДатаИзСтроки(Значение)

	Если СтрДлина(СокрЛП(Значение)) <> 14 Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Возврат Дата(СокрЛП(Значение));
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// Строковое представление значения настройки для записи в регистр.
//
Функция ЗначениеСтрокой(Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат СокрЛП(Формат(Значение, "ЧГ=0; ЧН="));
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

// Приклеивает подкаталог к корню обмена. Пустой подкаталог означает,
// что работаем прямо в корне.
//
Функция ПодкаталогОбмена(Корень, Подкаталог)

	Имя = СокрЛП(Подкаталог);
	Имя = СтрЗаменить(Имя, "\", "/");

	Пока Лев(Имя, 1) = "/" Цикл
		Имя = Сред(Имя, 2);
	КонецЦикла;
	Пока Прав(Имя, 1) = "/" Цикл
		Имя = Лев(Имя, СтрДлина(Имя) - 1);
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат Корень;
	КонецЕсли;

	Возврат ?(Корень = "/", "/" + Имя, Корень + "/" + Имя);

КонецФункции

#КонецОбласти
