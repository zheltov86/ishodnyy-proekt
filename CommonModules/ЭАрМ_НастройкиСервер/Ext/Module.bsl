// Проверяет, что настроек хватает для обращения к СБИС.
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка
//
Функция ПроверитьЗаполнениеНастроекСБИС() Экспорт

	Результат = Новый Структура("Успех, Ошибка", Истина, "");

	Настройки = НастройкиСБИС();

	НезаполненныеПоля = Новый Массив;
	Если НЕ ЗначениеЗаполнено(Настройки.КлиентID) Тогда
		НезаполненныеПоля.Добавить("app_client_id");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Настройки.КлиентСекрет) Тогда
		НезаполненныеПоля.Добавить("app_secret");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Настройки.СекретныйКлюч) Тогда
		НезаполненныеПоля.Добавить("secret_key");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Настройки.АдресСервера) Тогда
		НезаполненныеПоля.Добавить("Сервер");
	КонецЕсли;

	Если НезаполненныеПоля.Количество() > 0 Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = СтрШаблон(
			НСтр("ru = 'Не заполнены настройки подключения к СБИС: %1'"),
			СтрСоединить(НезаполненныеПоля, ", "));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Каталоги обмена на FTP-сервере.
//
// База2 читает выгрузку из <Каталог>/incoming и кладёт ответы
// в <Каталог>/result. Держим это одной функцией, чтобы обе стороны
// обмена собирали пути одинаково.
//
// Возвращаемое значение:
//   Структура - Корень, Выгрузка, Ответы, АрхивОтветов
//
Функция КаталогиОбменаFTP() Экспорт

	НастройкиПодключения = НастройкиFTP();

	Корень = СокрЛП(НастройкиПодключения.Каталог);
	Если НЕ ЗначениеЗаполнено(Корень) Тогда
		Корень = "/";
	КонецЕсли;
	Корень = СтрЗаменить(Корень, "\", "/");
	Если Прав(Корень, 1) = "/" И СтрДлина(Корень) > 1 Тогда
		Корень = Лев(Корень, СтрДлина(Корень) - 1);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Корень",   Корень);
	Результат.Вставить("Выгрузка", ПодкаталогОбмена(Корень, НастройкиПодключения.КаталогВыгрузки));
	Результат.Вставить("Ответы",   ПодкаталогОбмена(Корень, НастройкиПодключения.КаталогОтветов));
	Результат.Вставить("АрхивОтветов",
		ПодкаталогОбмена(ПодкаталогОбмена(Корень, НастройкиПодключения.КаталогОтветов), "archive"));

	Возврат Результат;

КонецФункции

// Возвращает статичный набор всех настроек ЭДО: ключ - значение.
//
// Ключи СБИС выданы на приложение и общие для всех баз, папки обмена и
// параметры транспорта заданы здесь же. Единственный источник значений:
// и ИнициализироватьНастройкиСБИС, и ЗаписатьВсеНастройки берут их отсюда.
//
// Возвращаемое значение:
//   Структура - ключ настройки -> значение
//
Функция ВсеНастройкиСтатично() Экспорт

	Дефолты = Новый Структура;

	// СБИС — адрес сервиса. Ключи приложения (СБИС_КлиентID, СБИС_КлиентСекрет,
	// СБИС_СекретныйКлюч) в код не выносим: их заполняют в регистре
	// ЭАрМ_НастройкиЭДО один раз на базу. Пустые значения сюда не кладём -
	// пустая строка в регистре читается ПолучитьНастройку как Ложь.
	Дефолты.Вставить("СБИС_АдресСервера", "online.saby.ru");

	// СБИС — параметры выборки
	Дефолты.Вставить("СБИС_Направление", "Входящий");
	Дефолты.Вставить("СБИС_ТипДокумента", "ConsignmentNote");
	Дефолты.Вставить("СБИС_ТипРеестраУПД", "Входящие");
	Дефолты.Вставить("СБИС_ТипВложенияУПД", "УпдДоп,УпдСчфДоп,ЭДОНакл,СчФктр");
	Дефолты.Вставить("СБИС_ТипВложенияУКД", "УкдДис,УкдКсчфДис");
	Дефолты.Вставить("СБИС_ГлубинаДней", 1);
	Дефолты.Вставить("СБИС_РазмерСтраницы", 100);
	Дефолты.Вставить("СБИС_ВремяЖизниСессии", 20);

	// Транспорт. Папки обмена здесь не задаются: они свои на каждом компьютере,
	// и «Все настройки» затирали введённую папку путём с ПК разработчика
	Дефолты.Вставить("ТранспортОбмена", "Папка");

	// Параметры обмена
	Дефолты.Вставить("ОбменВключен", Истина);
	Дефолты.Вставить("ВыгружатьАвтоматически", Истина);
	Дефолты.Вставить("ТолькоПриемИзДалиона", Ложь);
	Дефолты.Вставить("МаксимумДокументовЗаСеанс", 50);
	Дефолты.Вставить("МаксимумПопытокВыгрузки", 3);
	Дефолты.Вставить("ЛогироватьСобытия", Истина);
	Дефолты.Вставить("ТестовыйРежим", Ложь);
	Дефолты.Вставить("ИспользоватьАвтоОтправку", Истина);

	// Цепочка закупок
	Дефолты.Вставить("Цепочка_Включена", Истина);
	Дефолты.Вставить("Цепочка_МаскаПакетов", "dalion_*.json");
	Дефолты.Вставить("Цепочка_ОкноДнейСвязи", 30);
	Дефолты.Вставить("Цепочка_ПорогСовпаденияПроцентов", 70);
	Дефолты.Вставить("Цепочка_ДопускЦеныКопеек", 1);
	Дефолты.Вставить("Цепочка_ПогрешностьКопеек", 1);
	Дефолты.Вставить("Цепочка_СуммаТочно", Истина);
	Дефолты.Вставить("Цепочка_ДопускКоличестваГрамм", 50);
	Дефолты.Вставить("Цепочка_АвтоЗапросПломбы", Истина);
	Дефолты.Вставить("Цепочка_МаксимумПопыток", 3);
	Дефолты.Вставить("Цепочка_ПакетовЗаСеанс", 100);
	Дефолты.Вставить("Цепочка_ЦепочекЗаСеанс", 200);

	// FTP — типовые значения (используются при транспорте FTP)
	Дефолты.Вставить("FTP_Порт", 21);
	Дефолты.Вставить("FTP_Каталог", "/");
	Дефолты.Вставить("FTP_Пассивное", Истина);
	Дефолты.Вставить("FTP_Таймаут", 60);
	Дефолты.Вставить("FTP_КаталогВыгрузки", "incoming");
	Дефолты.Вставить("FTP_КаталогОтветов", "result");

	Возврат Дефолты;

КонецФункции

// Записывает статичные настройки, которые ещё не заданы.
//
// Значения, введённые администратором, не перетирает. Вызывается перед каждым
// сеансом обмена, чтобы в чистой базе ключи СБИС и папки были заполнены.
//
Процедура ИнициализироватьНастройкиСБИС() Экспорт

	// ЗначениеНастройки подставляет умолчание из ОписаниеНастроек, поэтому
	// "ещё не задано" проверяем заполненностью, а не сравнением с Неопределено
	Для Каждого КлючЗначение Из ВсеНастройкиСтатично() Цикл
		//@skip-check query-in-loop
		Если НЕ ЗначениеЗаполнено(ЗначениеНастройки(КлючЗначение.Ключ)) Тогда
			СохранитьНастройку(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Записывает в регистр ВСЕ статичные настройки, перетирая то, что там было.
//
// За этим стоит кнопка "Все настройки" панели управления ЭДО: привести базу
// к известному состоянию одним нажатием, не разбираясь, что и кем правилось.
//
// Возвращаемое значение:
//   Массив из Структура - Ключ, Значение - что записано, в порядке набора
//
Функция ЗаписатьВсеНастройки() Экспорт

	Записанные = Новый Массив;

	Для Каждого КлючЗначение Из ВсеНастройкиСтатично() Цикл

		СохранитьНастройку(КлючЗначение.Ключ, КлючЗначение.Значение);

		Записанные.Добавить(Новый Структура("Ключ, Значение",
			КлючЗначение.Ключ, КлючЗначение.Значение));

	КонецЦикла;

	Возврат Записанные;

КонецФункции


