// Параметры цепочки закупок: приём пакетов Далиона, связи и сверка.
//
// Пустые каталоги подменяются уже настроенными папками обмена: пакеты
// Далион кладёт туда же, куда ответы, а запросы пломбы забирает оттуда же,
// откуда выгрузку.
//
// Возвращаемое значение:
//   Структура - Включена, КаталогПакетов, МаскаПакетов, КаталогЗапросовДалион,
//               ОкноДнейСвязи, ПорогСовпадения (доля), ДопускЦены (рубли),
//               ДопускКоличества (кг),
//               АвтоЗапросПломбы, МаксимумПопыток, ПакетовЗаСеанс, ЦепочекЗаСеанс,
//               Транспорт
//
// Папка для файлов замеров времени (ЭАрМ_Служебный.НачатьЗамер).
//
// Возвращаемое значение:
//   Строка - путь; пустая строка - замеры выключены
//
Функция ПапкаЗамеров() Экспорт

	Значение = ЗначениеНастройки("Замеры_Папка");

	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), СокрЛП(Значение), "");

КонецФункции

Функция НастройкиЦепочки() Экспорт

	Значения = ПолучитьВсеНастройки();

	Результат = Новый Структура;
	Результат.Вставить("Включена", Значения.Цепочка_Включена = Истина);
	Результат.Вставить("КаталогПакетов", ?(ЗначениеЗаполнено(Значения.Цепочка_КаталогПакетов),
		Значения.Цепочка_КаталогПакетов, Значения.ПапкаОбмена));
	Результат.Вставить("МаскаПакетов", ?(ЗначениеЗаполнено(Значения.Цепочка_МаскаПакетов),
		Значения.Цепочка_МаскаПакетов, "dalion_*.json"));
	Результат.Вставить("КаталогЗапросовДалион", ?(ЗначениеЗаполнено(Значения.Цепочка_КаталогЗапросовДалион),
		Значения.Цепочка_КаталогЗапросовДалион, Значения.ПапкаВыгрузки));
	Результат.Вставить("ОкноДнейСвязи",    Макс(Значения.Цепочка_ОкноДнейСвязи, МинимальноеОкноДнейСвязи()));
	Результат.Вставить("ПорогСовпадения",  Мин(Макс(Значения.Цепочка_ПорогСовпаденияПроцентов, 1), 100) / 100);
	Результат.Вставить("ДопускЦены",       Макс(Значения.Цепочка_ДопускЦеныКопеек, 0) / 100);
	Результат.Вставить("ПогрешностьКопеек", Макс(Значения.Цепочка_ПогрешностьКопеек, 0));
	Результат.Вставить("СуммаТочно",       Значения.Цепочка_СуммаТочно = Истина);
	Результат.Вставить("ДопускКоличества", Макс(Значения.Цепочка_ДопускКоличестваГрамм, 0) / 1000);
	Результат.Вставить("АвтоЗапросПломбы", Значения.Цепочка_АвтоЗапросПломбы = Истина);
	Результат.Вставить("МаксимумПопыток",  Макс(Значения.Цепочка_МаксимумПопыток, 1));
	Результат.Вставить("ПакетовЗаСеанс",   Макс(Значения.Цепочка_ПакетовЗаСеанс, 1));
	Результат.Вставить("ЦепочекЗаСеанс",   Макс(Значения.Цепочка_ЦепочекЗаСеанс, 1));
	Результат.Вставить("Транспорт",        Значения.ТранспортОбмена);

	Возврат Результат;

КонецФункции

