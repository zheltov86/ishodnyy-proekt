////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_НастройкиСервер: настройки обмена ЭДО.
//
// Все настройки лежат в регистре сведений ЭАрМ_НастройкиЭДО одной таблицей
// "ключ - значение". Раньше реквизиты подключения к СБИС были зашиты в текст
// модуля внешней обработки, а параметры FTP - в ХранилищеОбщихНастроек; ни то,
// ни другое не видно администратору и не переносится вместе с конфигурацией.
//
// Состав настроек описан в одном месте - ОписаниеНастроек(). Добавление
// параметра сводится к строке в этой таблице: чтение, приведение типов,
// значения по умолчанию и форма настроек берут состав оттуда.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Описание всех настроек обмена: состав, типы и значения по умолчанию.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Ключ                - Строка - имя настройки, оно же измерение регистра
//     * Раздел              - Строка - СБИС, FTP, Обмен, Служебное
//     * Представление       - Строка - как называется в форме настроек
//     * Тип                 - Строка - Строка, Число, Булево, Пароль
//     * ЗначениеПоУмолчанию - Произвольный
//
Функция ОписаниеНастроек() Экспорт

	Описание = Новый ТаблицаЗначений;
	Описание.Колонки.Добавить("Ключ");
	Описание.Колонки.Добавить("Раздел");
	Описание.Колонки.Добавить("Представление");
	Описание.Колонки.Добавить("Тип");
	Описание.Колонки.Добавить("ЗначениеПоУмолчанию");

	// --- Подключение к СБИС ---
	ДобавитьОписание(Описание, "СБИС_КлиентID",      "СБИС", "app_client_id", "Строка", "");
	ДобавитьОписание(Описание, "СБИС_КлиентСекрет",  "СБИС", "app_secret",    "Пароль", "");
	ДобавитьОписание(Описание, "СБИС_СекретныйКлюч", "СБИС", "secret_key",    "Пароль", "");
	// Только имя хоста, без протокола: при HTTPS по IP не сойдётся SNI
	// и проверка сертификата - сертификат выписан на online.saby.ru
	ДобавитьОписание(Описание, "СБИС_АдресСервера",  "СБИС", "Сервер",        "Строка", "online.saby.ru");

	// --- Что именно забираем ---
	ДобавитьОписание(Описание, "СБИС_Направление",     "СБИС", "Направление документов",    "Строка", "Входящий");
	ДобавитьОписание(Описание, "СБИС_ТипДокумента",    "СБИС", "Тип документов ЭПД",        "Строка", "ConsignmentNote");
	ДобавитьОписание(Описание, "СБИС_ТипРеестраУПД",   "СБИС", "Реестр ЭДО",                "Строка", "Входящие");
	ДобавитьОписание(Описание, "СБИС_ТипВложенияУПД",  "СБИС", "Форматы вложений УПД",      "Строка", "УпдДоп,УпдСчфДоп,ЭДОНакл,СчФктр");
	// Корректировки (УКД) приходят тем же реестром, но СБИС отбирает документы
	// по формату вложения. Если СБИС не примет эти имена - очистите настройку
	ДобавитьОписание(Описание, "СБИС_ТипВложенияУКД",  "СБИС", "Форматы вложений УКД",      "Строка", "УкдДис,УкдКсчфДис");
	ДобавитьОписание(Описание, "СБИС_ГлубинаДней",     "СБИС", "Глубина запроса, дней",     "Число",  1);
	ДобавитьОписание(Описание, "СБИС_РазмерСтраницы",  "СБИС", "Документов за один запрос", "Число",  100);
	ДобавитьОписание(Описание, "СБИС_ВремяЖизниСессии", "СБИС", "Время жизни сессии, минут", "Число", 20);

	// --- Подписант ---
	// СБИС достаёт реквизиты подписанта из отпечатка, но ФИО и ИНН требует
	// в запросе явно: без них ПодготовитьДействие отвечает "Неполная
	// информация о сертификате". ИНН здесь физического лица, а не организации
	ДобавитьОписание(Описание, "СБИС_ОтпечатокСертификата", "Подписант", "Отпечаток сертификата", "Строка", "");
	ДобавитьОписание(Описание, "СБИС_ФИОПодписанта",        "Подписант", "ФИО подписанта",        "Строка", "");
	ДобавитьОписание(Описание, "СБИС_ИННПодписанта",        "Подписант", "ИНН подписанта",        "Строка", "");
	ДобавитьОписание(Описание, "СБИС_ДолжностьПодписанта",  "Подписант", "Должность подписанта",  "Строка", "");
	// Второй подписант: при подписании, если заполнены оба, программа
	// спрашивает, кто подписывает (см. ПодписантыСБИС)
	ДобавитьОписание(Описание, "СБИС_ОтпечатокСертификата2", "Подписант", "Отпечаток сертификата (подписант 2)", "Строка", "");
	ДобавитьОписание(Описание, "СБИС_ФИОПодписанта2",        "Подписант", "ФИО подписанта 2",                    "Строка", "");
	ДобавитьОписание(Описание, "СБИС_ИННПодписанта2",        "Подписант", "ИНН подписанта 2",                    "Строка", "");
	ДобавитьОписание(Описание, "СБИС_ДолжностьПодписанта2",  "Подписант", "Должность подписанта 2",              "Строка", "");
	// Кто подписывает, если на рабочем месте подписант не выбран: 0 - спрашивать
	// при каждом подписании (см. ЭАрМ_ПанельУправленияЭДОКлиент.ВыбратьПодписанта)
	ДобавитьОписание(Описание, "ПодписантПоУмолчанию",       "Подписант", "Подписант по умолчанию",              "Число",  0);

	// --- FTP ---
	ДобавитьОписание(Описание, "FTP_Сервер",       "FTP", "Сервер",               "Строка", "");
	ДобавитьОписание(Описание, "FTP_Порт",         "FTP", "Порт",                 "Число",  21);
	ДобавитьОписание(Описание, "FTP_Пользователь", "FTP", "Пользователь",         "Строка", "");
	ДобавитьОписание(Описание, "FTP_Пароль",       "FTP", "Пароль",               "Пароль", "");
	ДобавитьОписание(Описание, "FTP_Каталог",      "FTP", "Каталог",              "Строка", "/");
	ДобавитьОписание(Описание, "FTP_Пассивное",    "FTP", "Пассивное соединение", "Булево", Истина);
	ДобавитьОписание(Описание, "FTP_Таймаут",      "FTP", "Таймаут, секунд",      "Число",  60);
	// Каталоги на сервере, о которых База2 и База1 договорились: выгрузка
	// ложится в первый, ответы Далиона забираются из второго
	ДобавитьОписание(Описание, "FTP_КаталогВыгрузки", "FTP", "Подкаталог выгрузки", "Строка", "incoming");
	ДобавитьОписание(Описание, "FTP_КаталогОтветов",  "FTP", "Подкаталог ответов",  "Строка", "result");

	// --- Обмен с Далионом ---
	ДобавитьОписание(Описание, "ТранспортОбмена",           "Обмен", "Транспорт (FTP, Папка, HTTP)",      "Строка", "Папка");
	// Папки обмена - только из настроек базы: путь с ПК разработчика (C:\Users\...)
	// на другом компьютере давал «Ошибка доступа к файлу C:\Users\... Отказано в доступе»
	ДобавитьОписание(Описание, "ПапкаВыгрузки",             "Обмен", "Папка выгрузки в Далион",           "Строка", "");
	ДобавитьОписание(Описание, "ПапкаОбмена",               "Обмен", "Папка ответов Далион",              "Строка", "");
	ДобавитьОписание(Описание, "АдресСервисаДалион",        "Обмен", "Адрес сервиса Далион",              "Строка", "");
	ДобавитьОписание(Описание, "ОбменВключен",              "Обмен", "Обмен включён",                     "Булево", Ложь);
	ДобавитьОписание(Описание, "ОтключитьФоновыеЗадания",   "Обмен", "Отключить все фоновые задания",     "Булево", Ложь);
	ДобавитьОписание(Описание, "ВыгружатьАвтоматически",    "Обмен", "Выгружать в Далион регламентно",    "Булево", Истина);
	// Истина: УТ не кладёт в incoming документы на создание в Далионе,
	// только забирает уже созданные пакеты из result.
	ДобавитьОписание(Описание, "ТолькоПриемИзДалиона",      "Обмен", "Только приём из Далиона",           "Булево", Ложь);
	ДобавитьОписание(Описание, "МаксимумДокументовЗаСеанс", "Обмен", "Документов за один сеанс",          "Число",  50);
	ДобавитьОписание(Описание, "МаксимумПопытокВыгрузки",   "Обмен", "Попыток выгрузки одного документа", "Число",  3);
	ДобавитьОписание(Описание, "ЛогироватьСобытия",         "Обмен", "Подробный журнал",                  "Булево", Истина);
	ДобавитьОписание(Описание, "ТестовыйРежим",             "Обмен", "Тестовый режим",                    "Булево", Ложь);
	ДобавитьОписание(Описание, "ИспользоватьАвтоОтправку",  "Обмен", "Автоматическая отправка подтверждений", "Булево", Истина);
	ДобавитьОписание(Описание, "АвтоотправкаЭТрН",        "Обмен", "Автоотправка ЭТрН после сверки",      "Булево", Ложь);
	// Входящая папка Бухгалтерии (константа ОбменED_ПапкаВходящихНакладных там).
	// Пусто - подписанные УПД в Бухгалтерию не выгружаются
	ДобавитьОписание(Описание, "ПапкаВыгрузкиБух",          "Обмен", "Папка обмена с Бухгалтерией",       "Строка", "");
	// Истина: подписанные УПД и УКД уходят в Бухгалтерию сами (после подписи и
	// регламентом), ответы Бухгалтерии читаются регламентом. Ложь - только
	// вручную («Выгрузка в Бухгалтерию», «Пакеты в Бухгалтерию»)
	ДобавитьОписание(Описание, "АвтообменСБух",             "Обмен", "Автообмен с Бухгалтерией",          "Булево", Истина);
	// Истина: статусы «Загружено в Бух» / «Не создано в Бух» берёт Монитор папок, а УТ
	// применяет готовые файлы ut_Статусы_*.json регламентом ЭАрМ_ПрименениеПакетов
	// (подпапка папки обмена с БП). Ложь - регламент ничего не делает
	ДобавитьОписание(Описание, "Статусы_ЧерезМонитор",      "Обмен", "Статусы Бух через монитор",         "Булево", Ложь);
	ДобавитьОписание(Описание, "Статусы_Подпапка",          "Обмен", "Подпапка статусов монитора",        "Строка", "ut-status");
	// Истина: подписки ПриЗаписи только ставят отметку изменений и строку очереди,
	// работу делает задание ЭАрМ_ОбработкаОчереди, форма реестра УПД спрашивает отметку
	// раз в минуту вместо четырёх таймеров. Ложь - подписки и форма работают по-старому
	ДобавитьОписание(Описание, "Очередь_Включена",          "Обмен", "Обработка событий через очередь",   "Булево", Истина);
	// Файлы ПоступленияБП_*_авто.json, которые БП пишет сама: сверка «что есть в Бух»
	// раз в 3 часа (регламент ЭАрМ_СверкаСБух, при включённом автообмене с БП)
	ДобавитьОписание(Описание, "Сверка_Подпапка",           "Обмен", "Подпапка файлов поступлений БП",    "Строка", "ПоступленияБП");
	// Истина: регламент ставит УПД и УКД «Готов к утверждению» в «К отправке»
	// и в «Ожидают отправки» с отметкой «Отправить», по пачке за проход
	// (ЭАрМ_ОбработкаПодтвержденийЭДО.АвтоотправкаГотовыхУПД). Флажок - в форме очереди
	ДобавитьОписание(Описание, "АвтоотправкаУПД",           "Обмен", "Автоотправка УПД и УКД «Готов к утверждению»", "Булево", Ложь);
	// Регламент ЭАрМ_ОтправкаОчередиСБИС «отправка неотправленного в СБИС»: как часто и сколько за раз
	// (вкладка «Отправка и регламенты» формы настроек; интервал раньше задавала только форма настроек очереди)
	ДобавитьОписание(Описание, "ИнтервалОтправкиОчереди",       "Обмен", "Отправка в СБИС: запуск каждые, минут",   "Число", 5);
	ДобавитьОписание(Описание, "ОтправкаСБИС_РазмерПачки",      "Обмен", "Документов в одной пачке в СБИС",         "Число", 5);
	ДобавитьОписание(Описание, "ОтправкаСБИС_ПачекЗаЗапуск",    "Обмен", "Пачек за один запуск",                    "Число", 20);
	ДобавитьОписание(Описание, "ОтправкаСБИС_ВОчередьЗаПроход", "Обмен", "Ставить в очередь за проход, документов", "Число", 50);
	// Выключено: кнопка «Просмотреть архив» архив не читает и приходные
	// из него в цепочку не кладёт. Регламент папку archive и так не трогает
	ДобавитьОписание(Описание, "ПолучениеСтарыхДокументов", "Обмен", "Получение старых документов из архива", "Булево", Ложь);
	// Истина: при пакетах Далиона «Контрагент» и «ДоговорКонтрагента» в УТ
	// создаются партнёр и контрагент, если их ещё нет по ИНН или метке DALION:uid
	ДобавитьОписание(Описание, "Обмен_СоздаватьКонтрагентовИзДалиона", "Обмен",
		"Создавать контрагентов из Далиона", "Булево", Истина);

	// --- Подбор номенклатуры (фасад + двойной прогон) ---
	// Истина: НайтиТовар считает по-новому и по-старому, пишет расхождения
	// в журнал «АРМ_ЭДО.ДвойнойПрогон», возвращает СТАРЫЙ результат (не ломает поведение)
	ДобавитьОписание(Описание, "Подбор_ТолькоЛог",          "Подбор", "Двойной прогон подбора (только лог)", "Булево", Ложь);

	// --- Цепочка закупок: заказ поставщику - поступление - УПД - ЭТрН ---
	// Доли и копейки хранятся целыми: дробное число в строковом регистре
	// зависит от разделителя локали
	ДобавитьОписание(Описание, "Цепочка_Включена",                 "Цепочка", "Цепочка закупок включена",                 "Булево", Истина);
	ДобавитьОписание(Описание, "Цепочка_КаталогПакетов",           "Цепочка", "Папка пакетов Далиона (пусто - папка ответов)", "Строка", "");
	ДобавитьОписание(Описание, "Цепочка_МаскаПакетов",             "Цепочка", "Маска файлов пакетов",                     "Строка", "dalion_*.json");
	ДобавитьОписание(Описание, "Цепочка_КаталогЗапросовДалион",    "Цепочка", "Папка запросов пломбы (пусто - папка выгрузки)", "Строка", "");
	ДобавитьОписание(Описание, "Цепочка_ОкноДнейСвязи",            "Цепочка", "Окно поиска связанных документов, дней",   "Число",  30);
	ДобавитьОписание(Описание, "Цепочка_ПорогСовпаденияПроцентов", "Цепочка", "Порог совпадения товаров, %",              "Число",  70);
	ДобавитьОписание(Описание, "Цепочка_ДопускЦеныКопеек",         "Цепочка", "Допуск расхождения цены, копеек",          "Число",  1);
	// Погрешность итоговой суммы УПД и прихода. «Точно» - совпадение до копейки.
	// Снята - разница в пределах копеек не мешает «Готов к утверждению»
	ДобавитьОписание(Описание, "Цепочка_ПогрешностьКопеек",        "Цепочка", "Погрешность итоговой суммы, копеек",      "Число",  1);
	ДобавитьОписание(Описание, "Цепочка_СуммаТочно",               "Цепочка", "Итоговая сумма точно, без погрешности",   "Булево", Истина);
	ДобавитьОписание(Описание, "Цепочка_ДопускКоличестваГрамм",    "Цепочка", "Допуск расхождения количества, грамм",     "Число",  50);
	ДобавитьОписание(Описание, "Цепочка_АвтоЗапросПломбы",         "Цепочка", "Запрашивать пломбу после чистой сверки",   "Булево", Истина);
	ДобавитьОписание(Описание, "Цепочка_МаксимумПопыток",          "Цепочка", "Попыток обработки пакета",                 "Число",  3);
	ДобавитьОписание(Описание, "Цепочка_ПакетовЗаСеанс",           "Цепочка", "Пакетов за один сеанс",                    "Число",  100);
	ДобавитьОписание(Описание, "Цепочка_ЦепочекЗаСеанс",           "Цепочка", "Цепочек на сверку за один сеанс",          "Число",  200);

	// --- СБИС через СБИС ---
	ДобавитьОписание(Описание, "СБИС_ИспользоватьСБИС", "СБИС", "Использовать СБИС напрямую", "Булево", Ложь);
	ДобавитьОписание(Описание, "СБИС_ЛогинСБИС",       "СБИС", "Логин СБИС",                "Строка", "");
	ДобавитьОписание(Описание, "СБИС_ПарольСБИС",      "СБИС", "Пароль СБИС",               "Пароль", "");

	// --- Служебное: пишется кодом, в форме настроек не показывается ---
	ДобавитьОписание(Описание, "СБИС_Сессия",          "Служебное", "Текущая сессия",  "Строка", "");
	ДобавитьОписание(Описание, "СБИС_ДатаСессии",      "Служебное", "Сессия получена", "Строка", "");
	ДобавитьОписание(Описание, "ДатаПоследнегоОбмена", "Служебное", "Последний обмен", "Строка", "");
	ДобавитьОписание(Описание, "Цепочка_ВерсияСверки",     "Служебное", "Версия сверки цепочек",      "Строка", "");
	ДобавитьОписание(Описание, "Цепочка_ДатаВерсииСверки", "Служебное", "Версия сверки установлена",  "Строка", "");
	// Кто сейчас ведёт автоотправку: «форма|дата». Две открытые формы (очередь
	// и реестр УПД) не должны подписывать одни и те же документы
	ДобавитьОписание(Описание, "Автоотправка_Занята",      "Служебное", "Автоотправка идёт",          "Строка", "");

	// --- ЕГАИС: алкоголь в реестре УПД (ЭАрМ_АлкогольЕГАИС, форма «Настройки ЕГАИС» панели) ---
	ДобавитьОписание(Описание, "ЕГАИС_ОпределятьАлкоголь",      "ЕГАИС", "Определять алкоголь в строках УПД",             "Булево", Истина);
	ДобавитьОписание(Описание, "ЕГАИС_УчитыватьНаименование",   "ЕГАИС", "Отмечать «возможно алкоголь» по наименованию", "Булево", Истина);
	ДобавитьОписание(Описание, "ЕГАИС_ЗаписыватьСоответствие",  "ЕГАИС", "Сопоставлять номенклатуру с алкокодом ЕГАИС",  "Булево", Истина);
	ДобавитьОписание(Описание, "ЕГАИС_ВидНоменклатурыАлкоголь", "ЕГАИС", "Вид номенклатуры для алкоголя (УИД)",          "Строка", "");
	ДобавитьОписание(Описание, "ЕГАИС_ВидНоменклатурыПиво",     "ЕГАИС", "Вид номенклатуры для пива (УИД)",              "Строка", "");
	ДобавитьОписание(Описание, "ЕГАИС_НоменклатурыЗаПроход",    "ЕГАИС", "Номенклатуры за одно дозаполнение",            "Число",  500);
	ДобавитьОписание(Описание, "СБИС_ЗаменыПроверка",           "Служебное", "Когда искали замены аннулированных УПД", "Строка", "");
	ДобавитьОписание(Описание, "ЕГАИС_СверкаПоНазванию",        "ЕГАИС", "Алкоголь: сверка по названию, если нет штрихкода", "Булево", Ложь);
	ДобавитьОписание(Описание, "ЕГАИС_ДатаКлассификатора",      "Служебное", "Классификатор видов ЕГАИС заполнен",       "Строка", "");

	// --- Замеры: время шагов формы реестра УПД в CSV. Пустая папка - замеры выключены ---
	ДобавитьОписание(Описание, "Замеры_Папка", "Замеры", "Папка для замеров", "Строка", "");

	// Куда кнопка «Тест сверки» кладёт файлы (УПД из СБИС и два JSON Далиона)
	ДобавитьОписание(Описание, "ТестСверки_Папка", "Тест", "Папка для файлов теста сверки", "Строка", "");
	// Сколько поставок создаёт тест (0 - тест по своим XML из папки) и какая доля с расхождениями
	ДобавитьОписание(Описание, "ТестСверки_Количество", "Тест", "Сколько поставок в тесте", "Число", 50);
	ДобавитьОписание(Описание, "ТестСверки_ПроцентРасхождений", "Тест", "Процент поставок с расхождениями", "Число", 80);

	// Кнопка «Выгрузить логи»: за сколько последних часов трасса и журнал идут в папку error
	ДобавитьОписание(Описание, "Логи_Часов", "Логи", "Выгружать логи за последние, часов", "Число", 24);
	// Этап теста и сколько всего - пишет тест, читает форма (ЭАрМ_ТестУпаковок.ТекстПрогрессаТеста)
	ДобавитьОписание(Описание, "ТестСверки_Прогресс", "Служебное", "Прогресс теста приёма и сверки", "Строка", "");
	// Что сейчас делает отправка неотправленного в СБИС (ЭАрМ_ОбработкаПодтвержденийЭДО.ОтметитьХодОтправки)
	ДобавитьОписание(Описание, "ОтправкаСБИС_Ход", "Служебное", "Ход отправки неотправленного в СБИС", "Строка", "");

	// --- Монитор папок (служба FolderMonitor): пакеты Далиона берутся из его очереди,
	// а не перебором папки. Монитор недоступен - приём идёт по-старому, из папки ---
	ДобавитьОписание(Описание, "Монитор_Включен", "Монитор", "Брать пакеты из очереди Монитора папок", "Булево", Ложь);
	ДобавитьОписание(Описание, "Монитор_Сервер",  "Монитор", "Сервер Монитора папок",                  "Строка", "localhost");
	ДобавитьОписание(Описание, "Монитор_Порт",    "Монитор", "Порт",                                   "Число",  5080);
	ДобавитьОписание(Описание, "Монитор_Ключ",    "Монитор", "Ключ API",                               "Пароль", "");
	// Id папки пакетов Далиона в мониторе (колонка в его настройках). 0 - очередь всех папок
	ДобавитьОписание(Описание, "Монитор_ИдПапки", "Монитор", "Папка в мониторе (Id, 0 - все)",         "Число",  0);

	Возврат Описание;

КонецФункции

// Возвращает все настройки, приведённые к своим типам.
//
// Возвращаемое значение:
//   Структура - ключ настройки: значение. Состав - см. ОписаниеНастроек
//
Функция ПолучитьВсеНастройки() Экспорт

	Сохраненные = СохраненныеЗначения();

	Результат = Новый Структура;

	Для Каждого ОписаниеНастройки Из ОписаниеНастроек() Цикл
		Результат.Вставить(ОписаниеНастройки.Ключ,
			ЗначениеИзСохраненных(Сохраненные, ОписаниеНастройки.Ключ,
				ОписаниеНастройки.Тип, ОписаниеНастройки.ЗначениеПоУмолчанию));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает значение настройки, приведённое к её типу.
//
// Параметры:
//   Ключ - Строка - имя настройки, см. ОписаниеНастроек
//
// Возвращаемое значение:
//   Строка, Число, Булево - значение либо умолчание, если настройка не задана
//
Функция ЗначениеНастройки(Ключ) Экспорт

	Значения = ПолучитьВсеНастройки();

	ЗначениеНайденное = Неопределено;
	Если Значения.Свойство(Ключ, ЗначениеНайденное) Тогда
		Возврат ЗначениеНайденное;
	КонецЕсли;

	// Ключ не описан - отдаём как хранится, строкой
	Возврат ЗначениеИзСохраненных(СохраненныеЗначения(), Ключ, "Строка", "");

КонецФункции

// Получает значение настройки из регистра.
//
// Оставлена для совместимости с ранее написанным кодом расширения. В новом
// коде лучше ЗначениеНастройки: она знает тип настройки и не путает пустую
// строку с Ложь.
//
// Параметры:
//   Ключ - Строка - ключ настройки
//
// Возвращаемое значение:
//   Строка, Число, Булево - значение настройки
//
Функция ПолучитьНастройку(Ключ) Экспорт

	Возврат ЗначениеНастройки(Ключ);

КонецФункции

// Сохраняет значение настройки в регистр.
//
// Параметры:
//   Ключ     - Строка - ключ настройки
//   Значение - Строка, Число, Булево - значение настройки
//
Процедура СохранитьНастройку(Ключ, Значение) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_НастройкиЭДО.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.КлючНастройки = Лев(Ключ, 100);

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		МенеджерЗаписи.ЗначениеБулево = Значение;
		МенеджерЗаписи.Значение = "";
	Иначе
		МенеджерЗаписи.Значение = Лев(ЗначениеСтрокой(Значение), 500);
		МенеджерЗаписи.ЗначениеБулево = Ложь;
	КонецЕсли;

	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

// Версия расширения АРМ_ЭдоОбмен (свойство «Версия» в Configuration.xml выгрузки -
// то, что видно в свойствах расширения). Пишется в заголовок формы настроек,
// протокол теста и файлы выгрузки логов и настроек: по логу видно, какая версия
// работала.
//
// Возвращаемое значение:
//   Строка - версия; «не указана», если не прочитана
//
Функция ВерсияРасширения() Экспорт

	Попытка
		Расширение = Метаданные.ОбщиеМодули.ЭАрМ_НастройкиСервер.РасширениеКонфигурации();
		Если Расширение <> Неопределено И ЗначениеЗаполнено(Расширение.Версия) Тогда
			Возврат СокрЛП(Расширение.Версия);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.Версия", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Версия расширения не прочитана: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат "не указана";

КонецФункции

// Подпапка папки обмена (папки пакетов Далиона из настроек; пусто - папка ответов
// Далиона) для выгрузок с формы настроек: «error» - логи, «setting» - настройки.
// Нет - создаётся.
//
// Параметры:
//   Имя - Строка - имя подпапки
//
// Возвращаемое значение:
//   Строка - полный путь
//
Функция ПодпапкаОбмена(Имя) Экспорт

	Корень = СокрЛП(НастройкиЦепочки().КаталогПакетов);
	Если НЕ ЗначениеЗаполнено(Корень) Тогда
		ВызватьИсключение "не задана папка обмена: «Папка ответов Далион» или «Папка пакетов Далиона» в настройках ЭДО";
	КонецЕсли;

	Каталог = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Корень, Имя);
	ФайлКаталога = Новый Файл(Каталог);
	Если НЕ ФайлКаталога.Существует() Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;

	Возврат Каталог;

КонецФункции

// Кнопка «Выгрузить настройки» в настройках ЭДО: сохранённые настройки по
// разделам - в файл Настройки_<дата_время>.txt подпапки «setting» папки обмена.
// Пароли и секреты (тип «Пароль», в имени «пароль», «секрет», «токен») не
// выгружаются: вместо значения - звёздочки, задан ли он.
//
// Возвращаемое значение:
//   Строка - что выгружено и куда
//
Функция ВыгрузитьНастройкиВПапку() Экспорт

	Каталог = ПодпапкаОбмена("setting");
	Сейчас = ТекущаяДатаСеанса();
	Путь = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Каталог,
		"Настройки_" + Формат(Сейчас, "ДФ=yyyyMMdd_HHmmss") + ".txt");
	Значения = ПолучитьВсеНастройки();

	Текст = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Текст.ЗаписатьСтроку(СтрШаблон("Настройки АРМ ЭДО (версия расширения %1), выгружены %2, пользователь %3, база %4",
		ВерсияРасширения(), Формат(Сейчас, "ДФ='dd.MM.yyyy HH:mm:ss'"), ИмяПользователя(),
		СтрокаСоединенияИнформационнойБазы()));
	Текст.ЗаписатьСтроку("Пароли и секреты не выгружаются: *** - задан, пусто - не задан");

	Раздел = Неопределено;
	Всего = 0;
	Скрыто = 0;
	Для Каждого ОписаниеНастройки Из ОписаниеНастроек() Цикл

		Если ОписаниеНастройки.Раздел <> Раздел Тогда
			Раздел = ОписаниеНастройки.Раздел;
			Текст.ЗаписатьСтроку("");
			Текст.ЗаписатьСтроку("[" + Раздел + "]");
		КонецЕсли;

		Значение = Неопределено;
		Значения.Свойство(ОписаниеНастройки.Ключ, Значение);
		Если НастройкаСекретная(ОписаниеНастройки) Тогда
			ЗначениеВФайл = ?(ЗначениеЗаполнено(Значение), "***", "");
			Скрыто = Скрыто + 1;
		ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
			ЗначениеВФайл = Формат(Значение, "БЛ=Нет; БИ=Да");
		Иначе
			ЗначениеВФайл = ЗначениеСтрокой(Значение);
		КонецЕсли;

		Текст.ЗаписатьСтроку(СтрШаблон("%1 = %2    // %3", ОписаниеНастройки.Ключ, ЗначениеВФайл,
			ОписаниеНастройки.Представление));
		Всего = Всего + 1;

	КонецЦикла;
	Текст.Закрыть();

	Возврат СтрШаблон("Настройки выгружены: %1 (настроек %2, секретов скрыто %3). Выгружены записанные "
		+ "настройки - если меняли поля, сначала «Записать».", Путь, Всего, Скрыто);

КонецФункции

Функция НастройкаСекретная(ОписаниеНастройки)

	Если ОписаниеНастройки.Тип = "Пароль" Тогда
		Возврат Истина;
	КонецЕсли;

	Ключ = НРег(ОписаниеНастройки.Ключ);

	Возврат СтрНайти(Ключ, "пароль") > 0 ИЛИ СтрНайти(Ключ, "секрет") > 0 ИЛИ СтрНайти(Ключ, "токен") > 0
		ИЛИ СтрНайти(Ключ, "password") > 0 ИЛИ СтрНайти(Ключ, "token") > 0 ИЛИ СтрНайти(Ключ, "secret") > 0;

КонецФункции

// Сохраняет настройки из структуры одной транзакцией.
//
// Параметры:
//   Настройки - Структура - ключ настройки: значение
//
Процедура СохранитьВсеНастройки(Настройки) Экспорт

	НачатьТранзакцию();
	Попытка

		Для Каждого КлючЗначение Из Настройки Цикл
			СохранитьНастройку(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если Настройки.Свойство("ОтключитьФоновыеЗадания") Тогда
		ПрименитьОтключениеФоновыхЗаданий();
	КонецЕсли;

КонецПроцедуры

// Реквизиты подключения к СБИС.
//
// Заменяет функцию НастройкиПриложения() модуля объекта обработки, где
// идентификаторы приложения были записаны прямо в текст модуля.
//
// Возвращаемое значение:
//   Структура:
//     * КлиентID      - Строка - app_client_id
//     * КлиентСекрет  - Строка - app_secret
//     * СекретныйКлюч - Строка - secret_key
//     * АдресСервера  - Строка - имя хоста, без протокола
//     * ТекущаяСессия - Строка - сохранённая сессия, пока она не устарела
//
Функция НастройкиСБИС() Экспорт

	Значения = ПолучитьВсеНастройки();

	Результат = Новый Структура;
	Результат.Вставить("КлиентID",      Значения.СБИС_КлиентID);
	Результат.Вставить("КлиентСекрет",  Значения.СБИС_КлиентСекрет);
	Результат.Вставить("СекретныйКлюч", Значения.СБИС_СекретныйКлюч);
	Результат.Вставить("АдресСервера",  Значения.СБИС_АдресСервера);
	Результат.Вставить("ТекущаяСессия", ЖиваяСессия(Значения));

	Возврат Результат;

КонецФункции

// Реквизиты подписанта для действий по документу в СБИС.
//
// Отпечаток СБИС использует, чтобы достать остальные реквизиты у себя, но
// ФИО и ИНН приходится передавать явно. ИНН здесь физического лица: в ответе
// СБИС у подписанта стоит именно он, а не ИНН организации.
//
// Параметры:
//   Номер - Число - 1 или 2: какой подписант из настроек. Необязательный -
//           старые вызовы получают первого, как раньше
//
// Возвращаемое значение:
//   Структура - Отпечаток, ФИО, ИНН, Должность
//
Функция ПодписантСБИС(Знач Номер = 1) Экспорт

	Значения = ПолучитьВсеНастройки();

	Суффикс = ?(Номер = 2, "2", "");

	Результат = Новый Структура;
	Результат.Вставить("Отпечаток", СокрЛП(ЗначениеНастройкиИлиПусто(Значения, "СБИС_ОтпечатокСертификата" + Суффикс)));
	Результат.Вставить("ФИО",       СокрЛП(ЗначениеНастройкиИлиПусто(Значения, "СБИС_ФИОПодписанта" + Суффикс)));
	Результат.Вставить("ИНН",       СокрЛП(ЗначениеНастройкиИлиПусто(Значения, "СБИС_ИННПодписанта" + Суффикс)));
	Результат.Вставить("Должность", СокрЛП(ЗначениеНастройкиИлиПусто(Значения, "СБИС_ДолжностьПодписанта" + Суффикс)));

	Возврат Результат;

КонецФункции

// Все подписанты из настроек, у которых заполнен отпечаток или ФИО.
//
// Возвращаемое значение:
//   Массив из Структура - Номер, Отпечаток, ФИО, ИНН, Должность, Представление
//
Функция ПодписантыСБИС() Экспорт

	Результат = Новый Массив;

	Для Номер = 1 По 2 Цикл
		Подписант = ПодписантСБИС(Номер);
		Если НЕ ЗначениеЗаполнено(Подписант.Отпечаток) И НЕ ЗначениеЗаполнено(Подписант.ФИО) Тогда
			Продолжить;
		КонецЕсли;
		Подписант.Вставить("Номер", Номер);
		Подписант.Вставить("Представление", СтрШаблон("%1. %2%3%4", Номер,
			?(ЗначениеЗаполнено(Подписант.ФИО), Подписант.ФИО, НСтр("ru = 'ФИО не заполнено'")),
			?(ЗначениеЗаполнено(Подписант.Должность), ", " + Подписант.Должность, ""),
			?(ЗначениеЗаполнено(Подписант.ИНН), СтрШаблон(НСтр("ru = ' (ИНН %1)'"), Подписант.ИНН), "")));
		Результат.Добавить(Подписант);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗначениеНастройкиИлиПусто(Значения, Ключ)

	Если Значения.Свойство(Ключ) И Значения[Ключ] <> Неопределено Тогда
		Возврат Строка(Значения[Ключ]);
	КонецЕсли;

	Возврат "";

КонецФункции

// Параметры отбора документов в СБИС.
//
// Возвращаемое значение:
//   Структура - Направление, ТипДокумента, ТипРеестраУПД, ТипВложенияУПД,
//               ГлубинаДней, РазмерСтраницы
//
Функция ПараметрыОтбораСБИС() Экспорт

	Значения = ПолучитьВсеНастройки();

	Результат = Новый Структура;
	Результат.Вставить("Направление",    Значения.СБИС_Направление);
	Результат.Вставить("ТипДокумента",   Значения.СБИС_ТипДокумента);
	Результат.Вставить("ТипРеестраУПД",  Значения.СБИС_ТипРеестраУПД);
	// Форматы вложений в запрос реестра УПД не передаём: СБИС отбирает по своим
	// названиям форматов, и УПД с незнакомым ему названием не приходила вовсе.
	// Вид документа определяется по имени файла ФНС
	// (ЭАрМ_Служебный.ФорматДокументаПоВложениям); ЭТрН и путевые листы в
	// реестр УПД не пишутся - у них свой реестр
	Результат.Вставить("ТипВложенияУПД", "");
	Результат.Вставить("ГлубинаДней",    ОграничитьГлубинуДней(Значения.СБИС_ГлубинаДней));
	Результат.Вставить("РазмерСтраницы", Значения.СБИС_РазмерСтраницы);

	Возврат Результат;

КонецФункции

