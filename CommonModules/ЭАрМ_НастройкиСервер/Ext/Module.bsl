// Настройки подключения к FTP.
//
// Имена полей те же, что были у НастройкиFTPПоУмолчанию() в модуле обработки:
// код выгрузки от переезда настроек в регистр не поменялся.
//
// Возвращаемое значение:
//   Структура - Сервер, Порт, Пользователь, Пароль, Каталог,
//               ПассивноеСоединение, Таймаут
//
Функция НастройкиFTP() Экспорт

	Значения = ПолучитьВсеНастройки();

	Результат = Новый Структура;
	Результат.Вставить("Сервер",              Значения.FTP_Сервер);
	Результат.Вставить("Порт",                Значения.FTP_Порт);
	Результат.Вставить("Пользователь",        Значения.FTP_Пользователь);
	Результат.Вставить("Пароль",              Значения.FTP_Пароль);
	Результат.Вставить("Каталог",             Значения.FTP_Каталог);
	Результат.Вставить("ПассивноеСоединение", Значения.FTP_Пассивное);
	Результат.Вставить("Таймаут",             Значения.FTP_Таймаут);
	Результат.Вставить("КаталогВыгрузки",     Значения.FTP_КаталогВыгрузки);
	Результат.Вставить("КаталогОтветов",      Значения.FTP_КаталогОтветов);

	Возврат Результат;

КонецФункции

// Сохраняет настройки подключения к FTP.
//
// Параметры:
//   НастройкиПодключения - Структура - см. НастройкиFTP
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка
//
Функция ЗаписатьНастройкиFTP(НастройкиПодключения) Экспорт

	Результат = Новый Структура("Успех, Ошибка", Истина, "");

	ИменаПолей = Новый Структура;
	ИменаПолей.Вставить("FTP_Сервер",       "Сервер");
	ИменаПолей.Вставить("FTP_Порт",         "Порт");
	ИменаПолей.Вставить("FTP_Пользователь", "Пользователь");
	ИменаПолей.Вставить("FTP_Пароль",       "Пароль");
	ИменаПолей.Вставить("FTP_Каталог",      "Каталог");
	ИменаПолей.Вставить("FTP_Пассивное",    "ПассивноеСоединение");
	ИменаПолей.Вставить("FTP_Таймаут",      "Таймаут");
	ИменаПолей.Вставить("FTP_КаталогВыгрузки", "КаталогВыгрузки");
	ИменаПолей.Вставить("FTP_КаталогОтветов",  "КаталогОтветов");

	Сохраняемые = Новый Структура;

	Для Каждого КлючЗначение Из ИменаПолей Цикл
		ЗначениеПоля = Неопределено;
		Если НастройкиПодключения.Свойство(КлючЗначение.Значение, ЗначениеПоля) Тогда
			Сохраняемые.Вставить(КлючЗначение.Ключ, ЗначениеПоля);
		КонецЕсли;
	КонецЦикла;

	Попытка
		СохранитьВсеНастройки(Сохраняемые);
	Исключение
		Результат.Успех = Ложь;
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Параметры выгрузки в Далион.
