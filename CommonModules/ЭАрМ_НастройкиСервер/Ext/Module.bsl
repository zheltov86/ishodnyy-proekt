// Глубина запроса с учётом предела.
//
Функция ОграничитьГлубинуДней(ГлубинаДней) Экспорт

	Предел = МаксимальнаяГлубинаДней();

	Если НЕ ЗначениеЗаполнено(ГлубинаДней) ИЛИ ГлубинаДней <= 0 Тогда
		Возврат Предел;
	КонецЕсли;

	Возврат ?(ГлубинаДней > Предел, Предел, ГлубинаДней);

КонецФункции

// Период запроса реестра строками в формате СБИС.
//
// Без ДатаС/ДатаПо СБИС отдаёт реестр за всё время: сервис перебирает архив
// целиком, а обмену нужны последние дни. Период считается здесь один раз для
// всех, кто ходит в списки - и регламентный обмен, и разовые вызовы из форм.
//
// Параметры:
//   ГлубинаДней - Число - сколько дней назад смотреть. 0 или пусто - предел,
//                 см. ОграничитьГлубинуДней
//
// Возвращаемое значение:
//   Структура:
//     * ДатаС  - Строка - "дд.ММ.гггг"
//     * ДатаПо - Строка - "дд.ММ.гггг"
//
Функция ПериодЗапросаСБИС(ГлубинаДней = 0) Экспорт

	Возврат ПериодПоГлубине(ОграничитьГлубинуДней(ГлубинаДней));

КонецФункции

