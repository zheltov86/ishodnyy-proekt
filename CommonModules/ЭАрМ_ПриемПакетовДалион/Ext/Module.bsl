////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_ПриемПакетовДалион: приём JSON-пакетов из модулей обмена Далиона.
//
// Далион выкладывает в папку обмена (или в каталог ответов на FTP) файлы
// dalion_<тип>_<uid>_<время>.json в формате { "header": {...}, "data": {...} }:
//   ЗаказПоставщику      - заказ, контрагент, договор, строки и штрихкоды;
//   ПриходнаяНакладная   - поступление, то же + basis.purchaseOrder;
//   ВозвратПоставщику    - возврат товаров поставщику (basis.purchaseInvoice, строки
//                          с purchaseDocument); строки - в ЭАрМ_ТоварыЭТрН, источник
//                          «ВозвратДалион» (ЭАрМ_КорректировкиУПД.ЗаписатьСтрокиДокументаДалион);
//   КорректировкаПоставщика - корректировочный документ входящий (строки «до» и
//                          «после», состояние обмена); строки - в ЭАрМ_ТоварыЭТрН,
//                          источник «КорректировкаДалион»;
//   Номенклатура         - справочник, в шапке header.export = Номенклатура;
//   Контрагент           - справочник контрагентов (партнёр + контрагент УТ);
//   ДоговорКонтрагента   - справочник договоров;
//   Касса                - справочник касс;
//   supplierBarcodes     - порции штрихкодов (старый формат);
//   serviceResponse      - ответ на запрос пломбы.
// Исходящие файлы УТ (dalion_serviceRequest_*, dalion_dataRequest_*) приём пропускает.
//
// Приём и обработка разведены:
//   * приём только кладёт пакет в регистр ЭАрМ_ПакетыДалион, на объект - одна
//     запись, более новая версия заменяет прежнюю, повтор с тем же хешем
//     пропускается; заказ и приходная с тем же номером и датой, но другим
//     uid, тоже не грузятся;
//   * обработка берёт пакеты из регистра и раскладывает их по цепочке закупки.
// Так файл уходит в архив сразу после регистрации, а сбой разбора не теряет
// данные: пакет остаётся в регистре со статусом "Ошибка" и берётся повторно.
//
// Старые выгрузки result_receipts_*.json и ответы response_*.json читает
// ЭАрМ_РегламентныйОбменЭДО, маски не пересекаются.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Точка входа регламентного задания ЭАрМ_ОбменЦепочкиЗакупок.
//
// Шаги независимы: сбой одного не отменяет остальные, иначе недоступный FTP
// останавливал бы и сверку уже принятых документов.
//
Процедура ВыполнитьЗадание() Экспорт

	Если ЭАрМ_НастройкиСервер.ФоновыеЗаданияОтключены() Тогда
		Трасса("", "Проход не начат: в настройках ЭДО включено «Отключить все фоновые задания»", Ложь);
		Возврат;
	КонецЕсли;

	ВыполнитьПриемИОбработку();

КонецПроцедуры

// Тот же проход, что у регламентного задания, но по кнопке «Прочитать папку».
//
// Настройка «Отключить все фоновые задания» ручной проход не блокирует, а итог
// возвращается для показа. Раньше кнопка при отключённых заданиях молча ничего
// не делала и всё равно сообщала, что папка прочитана и пакеты разложены.
//
// Параметры:
//   ПриниматьПовторно - Булево - Истина: файлы из папки принимаются заново
//     (дубли и устаревшие тоже), а пакеты заказов и приходных за период снова
//     ставятся в очередь обработки - связь с УПД и сверка проходят повторно
//   ПереобработатьС, ПереобработатьПо - Дата - период по дате документа Далиона;
//     пустые - все пакеты документов
//   Папка - Строка - читать эту папку вместо папки пакетов из настроек (тесты)
//   Ограничения - Структура - для теста: ТолькоОбъекты (Массив uid заказов и приходных),
//     Срок (Дата) - после него проход прерывается с «ОШИБКА ПРОВЕРКИ»
//
// Возвращаемое значение:
//   Строка - итог прохода для пользователя
//
Функция ВыполнитьВручную(ПриниматьПовторно = Ложь, ПереобработатьС = Неопределено,
	ПереобработатьПо = Неопределено, Папка = "", Ограничения = Неопределено) Экспорт

	// Что именно будет читаться - до прохода, чтобы «не читает папку» было
	// видно сразу: путь из настроек, виден ли он серверу 1С, сколько файлов
	Строки = Новый Массив;
	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	Если ЗначениеЗаполнено(Папка) Тогда
		Настройки.КаталогПакетов = Папка;
		Настройки.Транспорт = "Папка";
	КонецЕсли;

	Если ПриниматьПовторно Тогда
		Строки.Добавить(СтрШаблон("Переобработка: пакетов заказов и приходных снова поставлено в очередь - %1 (период %2 - %3).",
			ВернутьПакетыДокументовВОчередь(ПереобработатьС, ПереобработатьПо),
			?(ЗначениеЗаполнено(ПереобработатьС), Формат(ПереобработатьС, "ДЛФ=D"), "любой"),
			?(ЗначениеЗаполнено(ПереобработатьПо), Формат(ПереобработатьПо, "ДЛФ=D"), "любой")));
	КонецЕсли;
	Строки.Добавить(СтрШаблон("Папка пакетов из настроек: «%1» (транспорт %2, маска %3).",
		Настройки.КаталогПакетов, Настройки.Транспорт, Настройки.МаскаПакетов));
	Если НЕ ЗначениеЗаполнено(Папка) И ЭАрМ_МониторПапок.Включен() Тогда
		Строки.Добавить("Файлы берутся из очереди Монитора папок; не ответит - из папки. " +
			ЭАрМ_МониторПапок.ПроверитьПодключение().Текст);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПутьФайлаТрассы()) Тогда
		Строки.Добавить("Текстовый лог всех этапов: " + ПутьФайлаТрассы());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Настройки.КаталогПакетов) Тогда
		Строки.Добавить("ПУСТО: заполните «Папка ответов Далион» в настройках ЭДО.");
	Иначе
		Каталоги = ЭАрМ_РегламентныйОбменЭДО.КаталогиОтветовВПапке(Настройки.КаталогПакетов);
		Если Каталоги.Количество() = 0 Тогда
			Строки.Добавить("НЕ НАЙДЕНА сервером 1С: " + Настройки.КаталогПакетов);
		КонецЕсли;
		Для Каждого ПутьКаталога Из Каталоги Цикл
			Строки.Добавить(СтрШаблон("  %1: файлов %2 - %3, захваченных .processing - %4", ПутьКаталога,
				Настройки.МаскаПакетов, НайтиФайлы(ПутьКаталога, Настройки.МаскаПакетов).Количество(),
				НайтиФайлы(ПутьКаталога, Настройки.МаскаПакетов + ".processing").Количество()));
		КонецЦикла;
	КонецЕсли;

	НачалоПрохода = ТекущаяДатаСеанса();
	Итоги = ВыполнитьПриемИОбработку(ПриниматьПовторно, Папка, Ограничения);

	Если Итоги = Неопределено Тогда
		Строки.Добавить("Цепочка закупок выключена в настройках ЭДО (Цепочка_Включена) - папка не читалась.");
		Возврат СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;

	Строки.Добавить(СтрШаблон("Принято пакетов: %1, обработано: %2, ошибок: %3.",
		Итоги.Принято, Итоги.Обработано, Итоги.Ошибок));

	// Весь путь этого прохода по шагам - прямо в сообщении: где оборвалось,
	// помечено «СТОП». То же лежит в регистре ЭАрМ_ТрассаПриема
	Строки.Добавить("");
	Строки.Добавить("--- Трасса прохода (СТОП = шаг остановил документ) ---");
	Для Каждого СтрокаТрассы Из ТрассаПрохода(НачалоПрохода, ?(ЗначениеЗаполнено(Папка), 500, 80)) Цикл
		Строки.Добавить(СтрокаТрассы);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Строки регистра трассы этого сеанса с момента начала прохода, по порядку.
//
// Возвращаемое значение:
//   Массив из Строка
//
Функция ТрассаПрохода(НачалоПрохода, Максимум) Экспорт

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ ПЕРВЫЕ %1
	|	Трасса.ДатаШага КАК ДатаШага,
	|	Трасса.Шаг КАК Шаг,
	|	Трасса.Успех КАК Успех,
	|	Трасса.Объект КАК Объект,
	|	Трасса.Номер КАК Номер,
	|	Трасса.ИмяФайла КАК ИмяФайла,
	|	Трасса.Сообщение КАК Сообщение
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТрассаПриема КАК Трасса
	|ГДЕ
	|	Трасса.Сеанс = &Сеанс
	|	И Трасса.ДатаШага >= &Начало
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаШага,
	|	Трасса.Запись", Формат(Максимум, "ЧГ=0"));
	Запрос.УстановитьПараметр("Сеанс", НомерСеансаИнформационнойБазы());
	Запрос.УстановитьПараметр("Начало", НачалоПрохода);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОшибкаПроверкиИсключение("",
			"ТрассаПрохода (регистр трассы не прочитан)", ОшибкаИсключения);
		Результат.Добавить("Регистр трассы недоступен: " + ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения));
		Возврат Результат;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		Хвост = "";
		Если ЗначениеЗаполнено(Выборка.ИмяФайла) Тогда
			Хвост = " [" + Выборка.ИмяФайла + "]";
		ИначеЕсли ЗначениеЗаполнено(Выборка.Объект) Тогда
			Хвост = " [" + Лев(Выборка.Объект, 8) + "…" + ?(ЗначениеЗаполнено(Выборка.Номер), " №" + Выборка.Номер, "") + "]";
		КонецЕсли;
		Результат.Добавить(СтрШаблон("%1 %2%3: %4%5",
			Формат(Выборка.ДатаШага, "ДФ=HH:mm:ss"), ?(Выборка.Успех, "", "СТОП "),
			Выборка.Шаг, Выборка.Сообщение, Хвост));
	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Результат.Добавить("Строк трассы нет: проход не дошёл даже до «Проход начат» - проверьте, что регистр ЭАрМ_ТрассаПриема создан (обновление конфигурации БД).");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Параметры:
//   ПриниматьПовторно - Булево - файлы из папки принимаются заново (см. ВыполнитьВручную)
//
// Возвращаемое значение:
//   Структура - см. НовыеИтоги; Неопределено - цепочка выключена в настройках
//
Функция ВыполнитьПриемИОбработку(ПриниматьПовторно = Ложь, Папка = "", Ограничения = Неопределено)

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	Настройки.Вставить("ПриниматьПовторно", ПриниматьПовторно = Истина);
	// Тесты гоняют весь проход по своей папке: вместо папки пакетов из настроек
	Если ЗначениеЗаполнено(Папка) Тогда
		Настройки.КаталогПакетов = Папка;
		Настройки.Транспорт = "Папка";
	КонецЕсли;
	// Очередь Монитора папок - только для папки из настроек: своя папка теста читается напрямую
	Настройки.Вставить("ЧерезМонитор", НЕ ЗначениеЗаполнено(Папка) И ЭАрМ_МониторПапок.Включен());
	// Тест: только свои объекты (ТолькоОбъекты - uid заказов и приходных) и срок прохода
	ТестовыйПроход = Ложь;
	Если ТипЗнч(Ограничения) = Тип("Структура") Тогда
		Для Каждого КлючЗначение Из Ограничения Цикл
			Настройки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
		ТестовыйПроход = Ограничения.Свойство("ТолькоОбъекты");
	КонецЕсли;

	Если НЕ Настройки.Включена Тогда
		Трасса("", "Проход не начат: цепочка закупок выключена (Цепочка_Включена)", Ложь);
		Возврат Неопределено;
	КонецЕсли;

	Итоги = НовыеИтоги();

	// Один проход за раз: регламентные задания и кнопка «Прочитать папку»
	// шли одновременно, делили одни файлы и пакеты и мешали друг другу
	Занят = ДругойПроходИдёт();
	Если ЗначениеЗаполнено(Занят) Тогда
		Трасса("", "Проход не начат: уже идёт другой проход - " + Занят, Ложь);
		Итоги.Сообщения.Добавить("Проход не начат: уже идёт другой проход - " + Занят);
		Возврат Итоги;
	КонецЕсли;
	ОтметитьПроход(Истина);

	Трасса("", СтрШаблон("Проход начат: транспорт «%1», папка пакетов «%2», маска %3, пакетов за сеанс %4",
		Настройки.Транспорт, Настройки.КаталогПакетов, Настройки.МаскаПакетов, Настройки.ПакетовЗаСеанс));

	// Шаги прохода. Тест берёт только шаги, через которые идут его документы:
	// связь с УПД делает обработка приходной, а связи, корректировки, ЭТрН и очередь
	// СБИС по всей базе к тестовым документам отношения не имеют и тест тормозили
	Шаги = Новый Массив;
	Шаги.Добавить(Новый Структура("Представление, Имя, ВТесте", "Приём пакетов", "ПринятьПакеты", Истина));
	Шаги.Добавить(Новый Структура("Представление, Имя, ВТесте", "Обработка пакетов", "ОбработатьПакеты", Истина));
	Шаги.Добавить(Новый Структура("Представление, Имя, ВТесте", "Связи с ЭДО", "ОбновитьСвязиЭДО", Ложь));
	Шаги.Добавить(Новый Структура("Представление, Имя, ВТесте", "Корректировки УПД", "ОбработатьКорректировки", Ложь));
	Шаги.Добавить(Новый Структура("Представление, Имя, ВТесте", "Сверка товаров", "СверитьЦепочки", Истина));
	Шаги.Добавить(Новый Структура("Представление, Имя, ВТесте", "ЭТрН по приходам", "ОтметитьЭТрНПоПриходам", Ложь));
	Шаги.Добавить(Новый Структура("Представление, Имя, ВТесте", "Очередь ЭДО", "СобратьГотовые", Ложь));
	// Пломбы регламент не запрашивает: в Далион - только вручную
	Если Настройки.АвтоЗапросПломбы И НЕ ЭАрМ_НастройкиСервер.АвтоотправкаВДалионВыключена() Тогда
		Шаги.Добавить(Новый Структура("Представление, Имя, ВТесте", "Запросы пломбы", "ЗапроситьПломбы", Ложь));
	КонецЕсли;

	Для Каждого Шаг Из Шаги Цикл
		Если ТестовыйПроход И НЕ Шаг.ВТесте Тогда
			Трасса("", "Шаг «" + Шаг.Представление + "» в тесте пропущен: работает по всей базе, тестовых документов не касается");
			Продолжить;
		КонецЕсли;
		Если ВремяВышло(Настройки, "перед шагом «" + Шаг.Представление + "»") Тогда
			Итоги.Ошибок = Итоги.Ошибок + 1;
			Итоги.Сообщения.Добавить("Проход прерван по времени перед шагом «" + Шаг.Представление + "»");
			Прервать;
		КонецЕсли;
		ВыполнитьШаг(Шаг.Представление, Шаг.Имя, Настройки, Итоги);
	КонецЦикла;

	Если НЕ ТестовыйПроход Тогда
		ЭАрМ_ЗапросыДалион.ОбновитьСтатусыЗапросов();
	КонецЕсли;

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", ОперацияЖурнала(), Итоги.Ошибок = 0,
		СтрШаблон("Принято пакетов: %1, обработано: %2, ошибок: %3. %4",
			Итоги.Принято, Итоги.Обработано, Итоги.Ошибок, СтрСоединить(Итоги.Сообщения, "; ")));

	ОтметитьПроход(Ложь);

	Трасса("", СтрШаблон("Проход окончен: принято %1, обработано %2, ошибок %3",
		Итоги.Принято, Итоги.Обработано, Итоги.Ошибок), Итоги.Ошибок = 0, , ,
		Новый Структура("Принято, Обработано, Ошибок", Итоги.Принято, Итоги.Обработано, Итоги.Ошибок));

	Возврат Итоги;

КонецФункции

// Забирает новые пакеты из папки и, при транспорте FTP, с сервера.
//
// Параметры:
//   Настройки - Структура - см. ЭАрМ_НастройкиСервер.НастройкиЦепочки
//   Итоги     - Структура - см. НовыеИтоги
//
Процедура ПринятьПакеты(Настройки, Итоги) Экспорт

	// Монитор папок включён - файлы из его очереди; не ответил - папка, как раньше
	ЧерезМонитор = Ложь;
	Настройки.Свойство("ЧерезМонитор", ЧерезМонитор);
	Если НЕ (ЧерезМонитор = Истина И ПринятьИзМонитора(Настройки, Итоги)) Тогда
		ПринятьИзПапки(Настройки, Итоги);
	КонецЕсли;

	Если ВРег(СокрЛП(Настройки.Транспорт)) = "FTP" Тогда
		ПринятьСFTP(Настройки, Итоги);
	КонецЕсли;

КонецПроцедуры

// Раскладывает принятые пакеты по цепочке закупки.
//
// Заказы идут раньше поступлений: поступление ищет свой заказ по uid, и заказ,
// пришедший в том же сеансе, должен быть уже записан.
//
// Справочники и документы - двумя порциями по ПакетовЗаСеанс: сначала справочники,
// затем заказы и приходные. Одной общей порцией выгрузка справочника целиком
// (тысячи пакетов по 5 элементов) занимала все места, и приходные часами стояли
// «Принят» - в архиве, но не сопоставленные.
//
Процедура ОбработатьПакеты(Настройки, Итоги) Экспорт

	// Имя ТипыДокументов, а не «Документы»: это глобальный менеджер, и
	// присваивание ему роняло весь шаг «Поле объекта недоступно для записи»
	ТипыДокументов = Новый Массив;
	ТипыДокументов.Добавить("ЗаказПоставщику");
	ТипыДокументов.Добавить("ПриходнаяНакладная");
	ТипыДокументов.Добавить("ВозвратПоставщику");
	ТипыДокументов.Добавить("КорректировкаПоставщика");

	// Приоритет - приходные: своей порцией и первыми. Общей порцией с заказами
	// приходные (порядок 3) стояли за сотнями заказов (порядок 2) и за проход
	// не доходили до обработки - ни документов, ни связи с УПД. Заказ, пришедший
	// позже приходной, находит её поставку сам (ОбновитьПоЗаказу)
	Приходные = Новый Массив;
	Приходные.Добавить("ПриходнаяНакладная");
	Заказы = Новый Массив;
	Заказы.Добавить("ЗаказПоставщику");

	// Возвраты и корректировки поставщиков - своей порцией сразу за приходными, до
	// справочников: их мало (только по УКД с уменьшением), а строки нужны сверке УКД.
	// Возврат идёт раньше корректировки (порядок в запросе порции)
	ВозвратыИКорректировки = Новый Массив;
	ВозвратыИКорректировки.Добавить("ВозвратПоставщику");
	ВозвратыИКорректировки.Добавить("КорректировкаПоставщика");

	ОбработатьПорциюПакетов(Настройки, Итоги, Приходные, Истина, "приходные");
	ОбработатьПорциюПакетов(Настройки, Итоги, ВозвратыИКорректировки, Истина, "возвраты и корректировки");
	ОбработатьПорциюПакетов(Настройки, Итоги, ТипыДокументов, Ложь, "справочники");
	ОбработатьПорциюПакетов(Настройки, Итоги, Заказы, Истина, "заказы");

КонецПроцедуры

Процедура ОбработатьПорциюПакетов(Настройки, Итоги, ТипыДокументов, ТолькоДокументы, Порция = "")

	Статусы = Статусы();

	// Повторы пакетов с ошибкой - в конце порции: раньше старые ошибочные шли
	// первыми по дате приёма и занимали лимит, а свежие приходные ждали проходами
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ ПЕРВЫЕ %1
	|	Пакеты.ТипОбъекта КАК ТипОбъекта,
	|	Пакеты.ИдентификаторОбъекта КАК ИдентификаторОбъекта,
	|	ВЫБОР
	|		КОГДА Пакеты.ТипОбъекта = ""Контрагент"" ТОГДА -1
	|		КОГДА Пакеты.ТипОбъекта = ""supplierBarcodes"" ТОГДА 0
	|		КОГДА Пакеты.ТипОбъекта = ""Номенклатура"" ТОГДА 0
	|		КОГДА Пакеты.ТипОбъекта = ""ДоговорКонтрагента"" ТОГДА 1
	|		КОГДА Пакеты.ТипОбъекта = ""Касса"" ТОГДА 0
	|		КОГДА Пакеты.ТипОбъекта = ""ЗаказПоставщику"" ТОГДА 2
	|		КОГДА Пакеты.ТипОбъекта = ""ПриходнаяНакладная"" ТОГДА 3
	|		КОГДА Пакеты.ТипОбъекта = ""ВозвратПоставщику"" ТОГДА 4
	|		КОГДА Пакеты.ТипОбъекта = ""КорректировкаПоставщика"" ТОГДА 5
	|		ИНАЧЕ 3
	|	КОНЕЦ КАК Порядок,
	|	ВЫБОР
	|		КОГДА Пакеты.Статус = &Ошибка ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Повтор,
	|	Пакеты.ДатаПриема КАК ДатаПриема
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПакетыДалион КАК Пакеты
	|ГДЕ
	|	(Пакеты.Статус = &Принят
	|			ИЛИ Пакеты.Статус = &Ошибка
	|				И Пакеты.ПопытокОбработки < &МаксимумПопыток)
	|	И (&ТолькоДокументы
	|				И Пакеты.ТипОбъекта В (&Документы)
	|			ИЛИ НЕ &ТолькоДокументы
	|				И НЕ Пакеты.ТипОбъекта В (&Документы))
	|	И (НЕ &Ограничено
	|			ИЛИ Пакеты.ИдентификаторОбъекта В (&ТолькоОбъекты))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Повтор,
	|	ДатаПриема", Формат(Настройки.ПакетовЗаСеанс, "ЧГ=0"));

	Запрос.УстановитьПараметр("Документы", ТипыДокументов);
	Запрос.УстановитьПараметр("ТолькоДокументы", ТолькоДокументы);
	Запрос.УстановитьПараметр("Принят", Статусы.Принят);
	Запрос.УстановитьПараметр("Ошибка", Статусы.Ошибка);
	// Тест приёма и сверки обрабатывает только свои пакеты, не всю очередь базы
	ТолькоОбъекты = Неопределено;
	Настройки.Свойство("ТолькоОбъекты", ТолькоОбъекты);
	Запрос.УстановитьПараметр("Ограничено", ТипЗнч(ТолькоОбъекты) = Тип("Массив"));
	Запрос.УстановитьПараметр("ТолькоОбъекты", ?(ТипЗнч(ТолькоОбъекты) = Тип("Массив"), ТолькоОбъекты, Новый Массив));
	Запрос.УстановитьПараметр("МаксимумПопыток", Настройки.МаксимумПопыток);

	Выборка = Запрос.Выполнить().Выбрать();

	Трасса("", СтрШаблон("Обработка пакетов (%1): в очереди %2",
		Порция, Выборка.Количество()), Истина, , Выборка.Количество());

	Пока Выборка.Следующий() Цикл
		Если ВремяВышло(Настройки, "Обработка пакетов (" + Порция + ")") Тогда
			Прервать;
		КонецЕсли;
		//@skip-check query-in-loop
		ОбработатьПакет(Выборка.ТипОбъекта, Выборка.ИдентификаторОбъекта, Настройки, Итоги);
	КонецЦикла;

КонецПроцедуры

// Обрабатывает один уже принятый пакет. Тест соответствия гоняет только
// свои заказ и приход, без очереди старых ошибок.
//
Процедура ОбработатьПакетОбъекта(ТипОбъекта, ИдентификаторОбъекта, Настройки, Итоги) Экспорт

	ОбработатьПакет(ТипОбъекта, ИдентификаторОбъекта, Настройки, Итоги);

КонецПроцедуры

// Секция "data" последнего принятого пакета объекта.
//
// Параметры:
//   ТипОбъекта           - Строка - "ЗаказПоставщику", "ПриходнаяНакладная",
//                          "ВозвратПоставщику", "КорректировкаПоставщика"
//   ИдентификаторОбъекта - Строка - uid документа Далиона
//
// Возвращаемое значение:
//   Соответствие, Неопределено
//
Функция ДанныеОбъекта(ТипОбъекта, ИдентификаторОбъекта) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пакеты.ДанныеПакета КАК ДанныеПакета
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПакетыДалион КАК Пакеты
	|ГДЕ
	|	Пакеты.ТипОбъекта = &ТипОбъекта
	|	И Пакеты.ИдентификаторОбъекта = &ИдентификаторОбъекта";
	Запрос.УстановитьПараметр("ТипОбъекта", ТипОбъекта);
	Запрос.УстановитьПараметр("ИдентификаторОбъекта", ИдентификаторОбъекта);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЭАрМ_Служебный.ЗначениеУзла(
		ЭАрМ_Служебный.ПрочитатьОтветJSON(Выборка.ДанныеПакета), "data");

КонецФункции

// Статусы пакета в регистре ЭАрМ_ПакетыДалион.
//
Функция Статусы() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Принят",    "Принят");
	Результат.Вставить("Обработан", "Обработан");
	Результат.Вставить("Ошибка",    "Ошибка");

	Возврат Результат;

КонецФункции

// Имя операции в журнале обмена ЭАрМ_ЖурналОбменаЭДО.
//
Функция ОперацияЖурнала() Экспорт

	Возврат "ЦепочкаЗакупки";

КонецФункции

// Трассировка приёма: каждый шаг пути приходной - строкой в журнал обмена,
// операция «ТрассаПриема». По ней видно, на каком шаге документ остановился:
// папка - файл - регистр пакетов - обработка - цепочка - УПД - документ - сверка.
//
// Каждая строка пишется в регистр ЭАрМ_ТрассаПриема (шаг, объект, файл,
// сообщение, счётчики, сеанс) и дублируется в журнал обмена.
//
// Параметры:
//   Идентификатор - Строка - uid документа Далиона или УПД; пусто - общий шаг
//   Текст         - Строка - «Шаг: что произошло»; шаг берётся до двоеточия
//   Успех         - Булево - Ложь, если шаг остановил документ
//   ИмяФайла      - Строка
//   Количество    - Число - сколько файлов, пакетов, цепочек, строк на шаге
//   Счётчики      - Структура - Принято, Обработано, Ошибок, ТипОбъекта, Номер
//
Процедура Трасса(Идентификатор, Текст, Успех = Истина, ИмяФайла = "",
	Количество = Неопределено, Счётчики = Неопределено, ЭтоОшибка = Ложь) Экспорт

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Идентификатор, 100), ОперацияТрассы(),
		Успех, Текст, ИмяФайла);

	ЗаписатьВФайлТрассы(Идентификатор, Текст, Успех, ИмяФайла);
	ЗаписатьВЖурналРегистрации(Идентификатор, Текст, Успех, ЭтоОшибка);

	Попытка

		Запись = РегистрыСведений.ЭАрМ_ТрассаПриема.СоздатьМенеджерЗаписи();
		Запись.Запись       = Строка(Новый УникальныйИдентификатор);
		Запись.ДатаШага     = ТекущаяДатаСеанса();
		Запись.Сеанс        = НомерСеансаИнформационнойБазы();
		Запись.Шаг          = ШагТрассы(Текст);
		Запись.Успех        = Успех;
		Запись.Объект       = Лев(Идентификатор, 100);
		Запись.ИмяФайла     = Лев(ИмяФайла, 150);
		Запись.Сообщение    = Лев(Текст, 1000);
		Запись.Пользователь = Лев(ИмяПользователя(), 100);
		Если ТипЗнч(Количество) = Тип("Число") Тогда
			Запись.Количество = Количество;
		КонецЕсли;
		Если ТипЗнч(Счётчики) = Тип("Структура") Тогда
			Для Каждого ИмяПоля Из СтрРазделить("Принято,Обработано,Ошибок,ТипОбъекта,Номер", ",") Цикл
				Значение = Неопределено;
				Если Счётчики.Свойство(ИмяПоля, Значение) И Значение <> Неопределено Тогда
					Запись[ИмяПоля] = ?(ТипЗнч(Значение) = Тип("Строка"), Лев(Значение, 50), Значение);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Запись.Записать(Истина);

	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("ТрассаПриема",
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Срок прохода (Настройки.Срок, задаёт тест): время вышло - в лог «ОШИБКА ПРОВЕРКИ»
// с местом, где стоим, и Истина: вызывающий прерывает свой цикл. Без срока - Ложь.
//
// Параметры:
//   Настройки - Структура - настройки прохода
//   Где       - Строка - шаг или цикл, который проверяет срок
//
// Возвращаемое значение:
//   Булево
//
Функция ВремяВышло(Настройки, Где) Экспорт

	Срок = Неопределено;
	Если НЕ Настройки.Свойство("Срок", Срок) ИЛИ НЕ ЗначениеЗаполнено(Срок) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТекущаяДатаСеанса() <= Срок Тогда
		Возврат Ложь;
	КонецЕсли;

	// Об одном сроке пишем один раз
	Если НЕ Настройки.Свойство("СрокИстёкОтмечен") Тогда
		Настройки.Вставить("СрокИстёкОтмечен", Истина);
		ОшибкаПроверки("", "Срок прохода", СтрШаблон("время прохода вышло (срок %1) - прерываю: %2",
			Формат(Срок, "ДЛФ=T"), Где));
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Длинный текст - в журнал обмена ЭДО целиком: частями до 950 знаков по границам
// строк, с пометкой «(часть i из n)». Поле сообщения журнала - 1000 знаков, и
// карточка приходной или протокол сверки иначе обрезались бы.
//
// Параметры:
//   Идентификатор - Строка - под чем искать в журнале (uid приходной, УПД)
//   Операция      - Строка - «Приходная», «Сверка»
//   Успех         - Булево
//   Текст         - Строка - строки через Символы.ПС
//
Процедура ЗаписатьВЖурналПодробно(Идентификатор, Операция, Успех, Текст) Экспорт

	Части = Новый Массив;
	Текущая = "";
	Для Каждого СтрокаТекста Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Пока СтрДлина(СтрокаТекста) > 950 Цикл
			Если ЗначениеЗаполнено(Текущая) Тогда
				Части.Добавить(Текущая);
				Текущая = "";
			КонецЕсли;
			Части.Добавить(Лев(СтрокаТекста, 950));
			СтрокаТекста = Сред(СтрокаТекста, 951);
		КонецЦикла;
		Если СтрДлина(Текущая) + СтрДлина(СтрокаТекста) + 1 > 950 Тогда
			Части.Добавить(Текущая);
			Текущая = "";
		КонецЕсли;
		Текущая = ?(ЗначениеЗаполнено(Текущая), Текущая + Символы.ПС, "") + СтрокаТекста;
	КонецЦикла;
	Если ЗначениеЗаполнено(Текущая) Тогда
		Части.Добавить(Текущая);
	КонецЕсли;

	Для Номер = 1 По Части.Количество() Цикл
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Идентификатор, 100), Операция, Успех,
			?(Части.Количество() > 1, СтрШаблон("(часть %1 из %2) ", Номер, Части.Количество()), "")
				+ Части[Номер - 1]);
	КонецЦикла;

КонецПроцедуры

// Карточка приходной Далиона - в журнал обмена (операция «Приходная», под uid
// приходной): шапка целиком и каждая строка товаров - номенклатура, коды, все
// штрихкоды, количество и коэффициент, цена, сумма, НДС. По ней видно, что
// именно пришло, до всякой сверки.
//
// Параметры:
//   Объект - Соответствие - data пакета приходной
//
Процедура ЗаписатьКарточкуПриходной(Объект) Экспорт

	Попытка

		Идентификатор = ПолеКарточки(Объект, "uid");
		Строки = Новый Массив;

		Поставщик = ЭАрМ_Служебный.ЗначениеУзла(Объект, "counterparty");
		Строки.Добавить(СтрШаблон("ПРИХОДНАЯ Далиона № %1 от %2 (uid %3, версия %4)",
			ПолеКарточки(Объект, "number"), ПолеКарточки(Объект, "date"), Идентификатор,
			ПолеКарточки(Объект, "versionNumber")));
		Строки.Добавить(СтрШаблон("Поставщик: «%1» ИНН %2 КПП %3 (uid %4)",
			ПолеКарточки(Поставщик, "name"), ПолеКарточки(Поставщик, "inn"),
			ПолеКарточки(Поставщик, "kpp"), ПолеКарточки(Поставщик, "uid")));
		Строки.Добавить(СтрШаблон("Номера для поиска УПД: входящий «%1», ЭДО «%2», счёт-фактура «%3»",
			ПолеКарточки(Объект, "incomingNumber"), ПолеКарточки(Объект, "edoIncomingNumber"),
			ПолеКарточки(Объект, "invoiceNumber")));
		Строки.Добавить(СтрШаблон("Основание - заказ: uid %1 «%2»",
			ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеПоПути(Объект, "basis.purchaseOrder.uid", "")),
			ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеПоПути(Объект, "basis.purchaseOrder.name", ""))));
		Строки.Добавить(СтрШаблон("Организация «%1», склад «%2», договор «%3»",
			ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеПоПути(Объект, "company.name", "")),
			ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеПоПути(Объект, "warehouse.name", "")),
			ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеПоПути(Объект, "contract.name", ""))));
		Строки.Добавить(СтрШаблон("Сумма %1, НДС в сумме %2, НДС учитывается %3; проведена %4, помечена на удаление %5",
			ПолеКарточки(Объект, "amount"), ПолеКарточки(Объект, "vatIncluded"),
			ПолеКарточки(Объект, "useVat"), ПолеКарточки(Объект, "posted"),
			ПолеКарточки(Объект, "deletionMark")));
		Комментарий = ПолеКарточки(Объект, "comment");
		Если ЗначениеЗаполнено(Комментарий) Тогда
			Строки.Добавить("Комментарий: " + Лев(Комментарий, 300));
		КонецЕсли;

		Товары = ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "goods"));
		Строки.Добавить(СтрШаблон("Строк товаров: %1", Товары.Количество()));
		НомерСтроки = 0;
		Для Каждого Товар Из Товары Цикл
			НомерСтроки = НомерСтроки + 1;
			Номенклатура = ЭАрМ_Служебный.ЗначениеУзла(Товар, "nomenclature");
			Штрихкоды = ЭАрМ_СверкаТоваровЦепочки.ШтрихкодыСтрокиДалиона(Товар);
			// СтрШаблон принимает не больше 10 параметров - строка собирается из двух частей
			Строки.Добавить(СтрШаблон(
				"  %1. «%2» код %3, артикул %4, uid %5; ШК %6; ",
				?(ЗначениеЗаполнено(ПолеКарточки(Товар, "lineNumber")),
					ПолеКарточки(Товар, "lineNumber"), НомерСтроки),
				ПолеКарточки(Номенклатура, "name"), ПолеКарточки(Номенклатура, "code"),
				ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеПоПути(Товар, "item.article", "")),
				ПолеКарточки(Номенклатура, "uid"),
				?(Штрихкоды.Количество() = 0, "НЕТ", СтрСоединить(Штрихкоды, ",")))
				+ СтрШаблон("кол-во %1 %2 x коэфф. %3; цена %4; сумма %5; НДС %6 (%7)",
				ПолеКарточки(Товар, "quantity"),
				ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеПоПути(Номенклатура, "unit.name", "")),
				?(ЗначениеЗаполнено(ПолеКарточки(Товар, "ratio")), ПолеКарточки(Товар, "ratio"), "1"),
				ПолеКарточки(Товар, "price"), ПолеКарточки(Товар, "amount"),
				ПолеКарточки(Товар, "vatAmount"), ПолеКарточки(Товар, "vatRate")));
		КонецЦикла;

		ЗаписатьВЖурналПодробно(Идентификатор, "Приходная", Истина, СтрСоединить(Строки, Символы.ПС));

	Исключение
		ОшибкаПроверкиИсключение(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Объект, "uid", "")),
			"ЗаписатьКарточкуПриходной (карточка приходной в журнал не записана)", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Значение поля пакета строкой для карточки: даты, числа и булево - как есть.
//
Функция ПолеКарточки(Узел, Имя)

	Если Узел = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Значение = ЭАрМ_Служебный.ЗначениеУзла(Узел, Имя, "");
	Если Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "да", "нет");
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=,; ЧГ=0; ЧН=0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Диагностика для дерева реестра УПД, когда к УПД не привязана ни одна цепочка:
// есть ли в регистре пакетов приходная Далиона, в номере которой есть номер УПД,
// и что с ней (статус, ошибка, попытки). Так видно, читался ли файл приходной вообще.
//
// Возвращаемое значение:
//   Строка
//
Функция ОписаниеПакетовПриходнойПоНомеру(НомерУПД) Экспорт

	Номер = СокрЛП(НомерУПД);
	Если НЕ ЗначениеЗаполнено(Номер) Тогда
		Возврат "";
	КонецЕсли;

	Шаблон = Номер;
	Для Каждого Спецсимвол Из СтрРазделить("~,%,_,[,],^", ",") Цикл
		Шаблон = СтрЗаменить(Шаблон, Спецсимвол, "~" + Спецсимвол);
	КонецЦикла;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 5
	|	Пакеты.ИдентификаторОбъекта КАК Идентификатор,
	|	Пакеты.НомерОбъекта КАК Номер,
	|	Пакеты.Статус КАК Статус,
	|	Пакеты.ПопытокОбработки КАК Попыток,
	|	Пакеты.ТекстОшибки КАК ТекстОшибки,
	|	Пакеты.ДатаПриема КАК ДатаПриема
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПакетыДалион КАК Пакеты
	|ГДЕ
	|	Пакеты.ТипОбъекта = ""ПриходнаяНакладная""
	|	И Пакеты.НомерОбъекта ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пакеты.ДатаПриема УБЫВ");
	Запрос.УстановитьПараметр("Шаблон", "%" + Шаблон + "%");

	Части = Новый Массив;
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Части.Добавить(СтрШаблон("приходная № %1 (uid %2) принята %3, статус «%4», попыток %5%6",
				Выборка.Номер, Выборка.Идентификатор, Формат(Выборка.ДатаПриема, "ДЛФ=DT"), Выборка.Статус,
				Выборка.Попыток, ?(ЗначениеЗаполнено(Выборка.ТекстОшибки), ": " + Лев(Выборка.ТекстОшибки, 200), "")));
		КонецЦикла;
	Исключение
		ОшибкаПроверкиИсключение("", "ОписаниеПакетовПриходнойПоНомеру", ИнформацияОбОшибке());
		Возврат "регистр пакетов не прочитан";
	КонецПопытки;

	Если Части.Количество() = 0 Тогда
		Возврат СтрШаблон("в регистре пакетов нет приходной Далиона с «%1» в номере - файл приходной не принимался "
			+ "(не лежал в папке пакетов или не дошёл до приёма)", Номер);
	КонецЕсли;

	Возврат "в регистре пакетов: " + СтрСоединить(Части, "; ");

КонецФункции

// Кнопка «Очистить архив» в настройках ЭДО: удаляет файлы из папок archive
// папки пакетов Далиона - там лежат уже принятые dalion_*.json (и копии
// ответов). Удаляются только файлы, лежащие прямо в каталогах с именем archive:
//   <папка пакетов>\archive
//   <папка пакетов>\<подкаталог ответов, обычно result>\archive
// Вложенные каталоги, error, incoming и сама папка пакетов не затрагиваются.
//
// Возвращаемое значение:
//   Строка - сколько файлов удалено в каждой папке; для поля статуса формы
//
Функция ОчиститьАрхивПакетов() Экспорт

	Корень = СокрЛП(ЭАрМ_НастройкиСервер.НастройкиЦепочки().КаталогПакетов);
	Если НЕ ЗначениеЗаполнено(Корень) Тогда
		Возврат "В настройках ЭДО не указана папка пакетов Далиона (и папка обмена) - очищать нечего.";
	КонецЕсли;

	// Те же папки, что читает приём (корень и подкаталог ответов), - в каждой
	// ПереместитьОтветВАрхив кладёт разобранные файлы в archive
	Кандидаты = Новый Массив;
	Для Каждого ПапкаПриема Из ЭАрМ_РегламентныйОбменЭДО.КаталогиОтветовВПапке(Корень) Цикл
		Кандидаты.Добавить(ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(ПапкаПриема, "archive"));
	КонецЦикла;
	Если Кандидаты.Количество() = 0 Тогда
		ОшибкаПроверки("", "ОчиститьАрхивПакетов", "папка пакетов " + Корень + " не видна серверу 1С - очистка не выполнена");
		Возврат "Папка пакетов " + Корень + " не видна серверу 1С - очищать нечего.";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("Очистка архива пакетов Далиона. Папка пакетов: " + Корень);
	ВсегоУдалено = 0;
	ВсегоОшибок = 0;

	Для Каждого Путь Из Кандидаты Цикл

		ФайлКаталога = Новый Файл(Путь);
		Если НЕ ФайлКаталога.Существует() ИЛИ НЕ ФайлКаталога.ЭтоКаталог() Тогда
			Строки.Добавить(Путь + ": папки нет - пропущена");
			Продолжить;
		КонецЕсли;

		// Защита: чистится только каталог, который называется archive
		Если НРег(ФайлКаталога.Имя) <> "archive" Тогда
			Строки.Добавить(Путь + ": имя папки не archive - пропущена");
			Продолжить;
		КонецЕсли;

		Удалено = 0;
		Ошибок = 0;
		Для Каждого ФайлАрхива Из НайтиФайлы(Путь, "*", Ложь) Цикл

			Если ФайлАрхива.ЭтоКаталог() Тогда
				Продолжить;
			КонецЕсли;

			Попытка
				УдалитьФайлы(ФайлАрхива.ПолноеИмя);
				Удалено = Удалено + 1;
			Исключение
				Ошибок = Ошибок + 1;
				ОшибкаПроверкиИсключение("", "ОчиститьАрхивПакетов (файл " + ФайлАрхива.Имя + " не удалён)",
					ИнформацияОбОшибке());
			КонецПопытки;

		КонецЦикла;

		ВсегоУдалено = ВсегоУдалено + Удалено;
		ВсегоОшибок = ВсегоОшибок + Ошибок;
		Строки.Добавить(СтрШаблон("%1: удалено файлов %2%3", Путь, Удалено,
			?(Ошибок > 0, ", не удалось " + Ошибок, "")));

	КонецЦикла;

	Строки.Добавить(СтрШаблон("Итого удалено: %1, ошибок: %2.", ВсегоУдалено, ВсегоОшибок));
	Трасса("", СтрШаблон("Архив: очищен вручную из настроек - удалено файлов %1, ошибок %2", ВсегоУдалено, ВсегоОшибок),
		ВсегоОшибок = 0, , ВсегоУдалено);

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Отметка «проход идёт» в настройках ЭДО: номер сеанса и время начала.
//
Процедура ОтметитьПроход(Начат)

	Попытка
		Сохраняемые = Новый Структура("ПриемДалион_Проход",
			?(Начат, Формат(НомерСеансаИнформационнойБазы(), "ЧГ=0") + "|"
				+ Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss"), ""));
		ЭАрМ_НастройкиСервер.СохранитьВсеНастройки(Сохраняемые);
	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("ТрассаПриема",
			"Отметка прохода не записана: " + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Идёт ли сейчас проход в другом живом сеансе. Отметка старше часа или от
// завершённого сеанса не мешает (сеанс упал посреди прохода).
//
// Возвращаемое значение:
//   Строка - описание занятого прохода; пусто - можно начинать
//
Функция ДругойПроходИдёт()

	Значение = ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПриемДалион_Проход");
	Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Части = СтрРазделить(Значение, "|");
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;

	НомерЗанявшего = 0;
	Начало = '00010101';
	Попытка
		НомерЗанявшего = Число(Части[0]);
		Начало = Дата(Части[1]);
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОшибкаПроверкиИсключение("",
			"ДругойПроходИдёт (отметка прохода в настройках испорчена - считаем, что другого прохода нет)", ОшибкаИсключения);
		Возврат "";
	КонецПопытки;

	Если НомерЗанявшего = НомерСеансаИнформационнойБазы()
		ИЛИ ТекущаяДатаСеанса() - Начало > 3600 Тогда
		Возврат "";
	КонецЕсли;

	Жив = Ложь;
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Для Каждого Сеанс Из ПолучитьСеансыИнформационнойБазы() Цикл
			Если Сеанс.НомерСеанса = НомерЗанявшего Тогда
				Жив = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		УстановитьПривилегированныйРежим(Ложь);
		ОшибкаПроверкиИсключение("",
			"ДругойПроходИдёт (сеансы не проверены - считаем, что другой проход идёт, этот проход пропущен)", ОшибкаИсключения);
		Жив = Истина; // не смогли проверить - считаем, что идёт
	КонецПопытки;

	Если НЕ Жив Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("сеанс %1, начат %2", НомерЗанявшего, Формат(Начало, "ДЛФ=T"));

КонецФункции

// Путь текстового лога трассы: файл ТрассаПриема.log в папке, откуда
// принимаются накладные (папка пакетов Далиона из настроек ЭДО).
//
// Возвращаемое значение:
//   Строка - полный путь; пустая, если папка не задана
//
Функция ПутьФайлаТрассы() Экспорт

	Каталог = "";
	Попытка
		Каталог = СокрЛП(ЭАрМ_НастройкиСервер.НастройкиЦепочки().КаталогПакетов);
	Исключение
		Возврат "";
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Каталог, "ТрассаПриема.log");

КонецФункции

// Куда строка лога идёт при выгрузке:
//   «Ошибка»      - «ОШИБКА ПРОВЕРКИ» или неуспешный шаг, кроме сверки;
//   «Расхождение» - неуспешный шаг сверки (шаг/операция «Сверка»): не сошлись
//                   товары или суммы - это результат, а не сбой;
//   «»            - успешный шаг, только в общий файл.
// Раньше всё неуспешное шло в «Ошибки»: ~90% файла были расхождения сверки.
//
Функция ВидСтрокиЛога(Успех, Шаг, ТекстСообщения)

	Если СтрНайти(ТекстСообщения, "ОШИБКА ПРОВЕРКИ") > 0 Тогда
		Возврат "Ошибка";
	КонецЕсли;
	Если Успех Тогда
		Возврат "";
	КонецЕсли;

	Возврат ?(СтрНачинаетсяС(НРег(Шаг), "сверка"), "Расхождение", "Ошибка");

КонецФункции

// Кнопка «Выгрузить логи» в настройках ЭДО: трасса приёма (ЭАрМ_ТрассаПриема) и
// журнал обмена (ЭАрМ_ЖурналОбменаЭДО, без копий строк трассы) за последние Часов
// часов - в подпапку «error» папки обмена (ЭАрМ_НастройкиСервер.ПодпапкаОбмена):
//   * Логи_<дата_время>.txt   - всё по времени;
//   * Ошибки_<дата_время>.txt - «ОШИБКА ПРОВЕРКИ» и сбои (неуспешные шаги, кроме сверки);
//   * Расхождения_<дата_время>.txt - неуспешные шаги сверки (не сошлось), см. ВидСтрокиЛога.
// Многострочные сообщения пишутся одной строкой через « | ».
//
// Параметры:
//   Часов - Число - за сколько последних часов; 0 - 24
//
// Возвращаемое значение:
//   Строка - что выгружено и куда
//
Функция ВыгрузитьЛогиВПапку(Часов = 24) Экспорт

	Часов = ?(Часов > 0, Часов, 24);
	Каталог = ЭАрМ_НастройкиСервер.ПодпапкаОбмена("error");
	Сейчас = ТекущаяДатаСеанса();
	Начало = Сейчас - Часов * 3600;
	Метка = Формат(Сейчас, "ДФ=yyyyMMdd_HHmmss");
	ПутьЛогов = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Каталог, "Логи_" + Метка + ".txt");
	ПутьОшибок = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Каталог, "Ошибки_" + Метка + ".txt");
	ПутьРасхождений = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Каталог, "Расхождения_" + Метка + ".txt");

	ФайлЛогов = Новый ЗаписьТекста(ПутьЛогов, КодировкаТекста.UTF8);
	ФайлОшибок = Новый ЗаписьТекста(ПутьОшибок, КодировкаТекста.UTF8);
	ФайлРасхождений = Новый ЗаписьТекста(ПутьРасхождений, КодировкаТекста.UTF8);
	Заголовок = СтрШаблон("АРМ ЭДО (версия расширения %1): логи с %2 по %3 (часов %4), выгружены пользователем %5",
		ЭАрМ_НастройкиСервер.ВерсияРасширения(), Формат(Начало, "ДФ='dd.MM.yyyy HH:mm:ss'"),
		Формат(Сейчас, "ДФ='dd.MM.yyyy HH:mm:ss'"), Формат(Часов, "ЧГ=0"), ИмяПользователя());
	ФайлЛогов.ЗаписатьСтроку(Заголовок);
	ФайлОшибок.ЗаписатьСтроку(Заголовок + " - только ошибки: «ОШИБКА ПРОВЕРКИ» и неуспешные шаги, кроме расхождений сверки");
	ФайлРасхождений.ЗаписатьСтроку(Заголовок + " - расхождения сверки (не сошлось: товары, суммы, протоколы сверки)");

	// --- Трасса приёма ---
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Трасса.ДатаШага КАК ДатаШага,
	|	Трасса.Сеанс КАК Сеанс,
	|	Трасса.Шаг КАК Шаг,
	|	Трасса.Успех КАК Успех,
	|	Трасса.Объект КАК Объект,
	|	Трасса.ТипОбъекта КАК ТипОбъекта,
	|	Трасса.Номер КАК Номер,
	|	Трасса.ИмяФайла КАК ИмяФайла,
	|	Трасса.Сообщение КАК Сообщение,
	|	Трасса.Пользователь КАК Пользователь
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТрассаПриема КАК Трасса
	|ГДЕ
	|	Трасса.ДатаШага >= &Начало
	|
	|УПОРЯДОЧИТЬ ПО
	|	Трасса.ДатаШага,
	|	Трасса.Запись");
	Запрос.УстановитьПараметр("Начало", Начало);
	Выборка = Запрос.Выполнить().Выбрать();

	ФайлЛогов.ЗаписатьСтроку("");
	ФайлЛогов.ЗаписатьСтроку("=== ТРАССА ПРИЁМА (ЭАрМ_ТрассаПриема) ===");
	ФайлОшибок.ЗаписатьСтроку("");
	ФайлОшибок.ЗаписатьСтроку("=== ТРАССА ПРИЁМА: ошибки ===");
	ФайлРасхождений.ЗаписатьСтроку("");
	ФайлРасхождений.ЗаписатьСтроку("=== ТРАССА ПРИЁМА: расхождения сверки ===");
	СтрокТрассы = 0;
	ОшибокТрассы = 0;
	РасхожденийТрассы = 0;
	Пока Выборка.Следующий() Цикл
		ТекстСообщения = СтрЗаменить(СокрП(Выборка.Сообщение), Символы.ПС, " | ");
		СтрокаЛога = СтрШаблон("%1 %2 %3 | %4 | %5 | сеанс %6, %7", Формат(Выборка.ДатаШага, "ДФ='dd.MM.yyyy HH:mm:ss'"),
			?(Выборка.Успех, "OK  ", "СТОП"), СокрП(Выборка.Шаг),
			СокрП(СтрШаблон("%1 %2 %3 %4", СокрП(Выборка.ТипОбъекта), СокрП(Выборка.Номер), СокрП(Выборка.Объект),
				СокрП(Выборка.ИмяФайла))),
			ТекстСообщения, Формат(Выборка.Сеанс, "ЧГ=0; ЧН=0"), СокрП(Выборка.Пользователь));
		ФайлЛогов.ЗаписатьСтроку(СтрокаЛога);
		СтрокТрассы = СтрокТрассы + 1;
		Вид = ВидСтрокиЛога(Выборка.Успех, СокрП(Выборка.Шаг), ТекстСообщения);
		Если Вид = "Ошибка" Тогда
			ФайлОшибок.ЗаписатьСтроку(СтрокаЛога);
			ОшибокТрассы = ОшибокТрассы + 1;
		ИначеЕсли Вид = "Расхождение" Тогда
			ФайлРасхождений.ЗаписатьСтроку(СтрокаЛога);
			РасхожденийТрассы = РасхожденийТрассы + 1;
		КонецЕсли;
	КонецЦикла;

	// --- Журнал обмена: строки трассы в нём - копии, их не повторяем ---
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Журнал.Период КАК Период,
	|	Журнал.Операция КАК Операция,
	|	Журнал.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Журнал.Успех КАК Успех,
	|	Журнал.ИмяФайла КАК ИмяФайла,
	|	Журнал.Сообщение КАК Сообщение,
	|	Журнал.Пользователь КАК Пользователь
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЖурналОбменаЭДО КАК Журнал
	|ГДЕ
	|	Журнал.Период >= &Начало
	|	И Журнал.Операция <> ""ТрассаПриема""
	|
	|УПОРЯДОЧИТЬ ПО
	|	Журнал.Период");
	Запрос.УстановитьПараметр("Начало", Начало);
	Выборка = Запрос.Выполнить().Выбрать();

	ФайлЛогов.ЗаписатьСтроку("");
	ФайлЛогов.ЗаписатьСтроку("=== ЖУРНАЛ ОБМЕНА (ЭАрМ_ЖурналОбменаЭДО, без строк трассы) ===");
	ФайлОшибок.ЗаписатьСтроку("");
	ФайлОшибок.ЗаписатьСтроку("=== ЖУРНАЛ ОБМЕНА: ошибки ===");
	ФайлРасхождений.ЗаписатьСтроку("");
	ФайлРасхождений.ЗаписатьСтроку("=== ЖУРНАЛ ОБМЕНА: расхождения сверки ===");
	ЗаписейЖурнала = 0;
	ОшибокЖурнала = 0;
	РасхожденийЖурнала = 0;
	Пока Выборка.Следующий() Цикл
		ТекстСообщения = СтрЗаменить(СокрП(Выборка.Сообщение), Символы.ПС, " | ");
		СтрокаЛога = СтрШаблон("%1 %2 %3 | %4 %5 | %6 | %7", Формат(Выборка.Период, "ДФ='dd.MM.yyyy HH:mm:ss'"),
			?(Выборка.Успех, "OK  ", "СТОП"), СокрП(Выборка.Операция), СокрП(Выборка.ИдентификаторСБИС),
			СокрП(Выборка.ИмяФайла), ТекстСообщения, СокрП(Выборка.Пользователь));
		ФайлЛогов.ЗаписатьСтроку(СтрокаЛога);
		ЗаписейЖурнала = ЗаписейЖурнала + 1;
		Вид = ВидСтрокиЛога(Выборка.Успех, СокрП(Выборка.Операция), ТекстСообщения);
		Если Вид = "Ошибка" Тогда
			ФайлОшибок.ЗаписатьСтроку(СтрокаЛога);
			ОшибокЖурнала = ОшибокЖурнала + 1;
		ИначеЕсли Вид = "Расхождение" Тогда
			ФайлРасхождений.ЗаписатьСтроку(СтрокаЛога);
			РасхожденийЖурнала = РасхожденийЖурнала + 1;
		КонецЕсли;
	КонецЦикла;

	ФайлЛогов.Закрыть();
	ФайлОшибок.Закрыть();
	ФайлРасхождений.Закрыть();

	Итог = СтрШаблон("Логи за %1 ч выгружены в %2: трасса %3 строк, журнал %4 записей. Ошибок: трасса %5, журнал %6 - %7. "
		+ "Расхождений сверки: трасса %8, журнал %9 - %10", Формат(Часов, "ЧГ=0"), ПутьЛогов, СтрокТрассы, ЗаписейЖурнала,
		ОшибокТрассы, ОшибокЖурнала, ПутьОшибок, РасхожденийТрассы, РасхожденийЖурнала, ПутьРасхождений)
		+ ". Текстовый лог трассы целиком - " + ПутьФайлаТрассы();
	Трасса("", Итог);

	Возврат Итог;

КонецФункции

// Любая строка журнала обмена ЭДО - тоже в текстовый лог (с именем операции
// вместо шага). Вызывается из ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал.
//
Процедура ЗаписатьВЛогСтрокуЖурнала(Операция, Идентификатор, Текст, Успех, ИмяФайла) Экспорт

	Если Операция = ОперацияТрассы() Тогда
		Возврат; // трасса пишет в файл сама
	КонецЕсли;

	ЗаписатьВФайлТрассы(Идентификатор, Текст, Успех, ИмяФайла, "Журнал[" + Операция + "]");

КонецПроцедуры

// Дописывает строку трассы в текстовый лог рядом с накладными: все этапы
// приёма, создания документов и сверки, ошибки - с пометкой СТОП. Файла нет -
// создаётся. Сбой записи лог не роняет приём.
//
Процедура ЗаписатьВФайлТрассы(Идентификатор, Текст, Успех, ИмяФайла, Шаг = "")

	Путь = ПутьФайлаТрассы();
	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		ФайлЛога = Новый Файл(Путь);
		Каталог = ФайлЛога.Путь;
		ФайлКаталога = Новый Файл(Каталог);
		Если НЕ ФайлКаталога.Существует() Тогда
			СоздатьКаталог(Каталог);
		КонецЕсли;

		Хвост = "";
		Если ЗначениеЗаполнено(ИмяФайла) Тогда
			Хвост = " | файл " + ИмяФайла;
		КонецЕсли;
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Хвост = " | " + Идентификатор + Хвост;
		КонецЕсли;

		ТекстСтроки = СтрШаблон("%1 [с%2] %3 %4: %5%6",
			Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm:ss"),
			Формат(НомерСеансаИнформационнойБазы(), "ЧГ=0"),
			?(Успех, "OK  ", "СТОП"), ?(ЗначениеЗаполнено(Шаг), Шаг, ШагТрассы(Текст)),
			СтрЗаменить(Текст, Символы.ПС, " / "), Хвост);

		// Добавление = Истина: файл дописывается, а не перезаписывается.
		// Файл занят другим сеансом - строка уходит в лог этого сеанса рядом
		Попытка
			Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, , Истина);
		Исключение
			Путь = Лев(Путь, СтрДлина(Путь) - 4) + "_сеанс"
				+ Формат(НомерСеансаИнформационнойБазы(), "ЧГ=0") + ".log";
			Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, , Истина);
		КонецПопытки;
		Запись.ЗаписатьСтроку(ТекстСтроки);
		Запись.Закрыть();

	Исключение
		// Лог не пишется - молча: ошибка в журнал регистрации на каждую строку
		// только засоряла его
	КонецПопытки;

КонецПроцедуры

// Журнал регистрации 1С: событие «АРМ_ЭДО.ТрассаПриема». Обычный шаг -
// «Информация», остановка документа - «Предупреждение», ошибка проверки или
// исключение - «Ошибка». Сам журнал не должен ронять приём.
//
Процедура ЗаписатьВЖурналРегистрации(Идентификатор, Текст, Успех, ЭтоОшибка)

	Попытка

		Уровень = ?(ЭтоОшибка, УровеньЖурналаРегистрации.Ошибка,
			?(Успех, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Предупреждение));

		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ТрассаПриема", Уровень, , ,
			Лев(?(ЗначениеЗаполнено(Идентификатор), "[" + Идентификатор + "] ", "") + Текст, 2000));

	Исключение
		// журнал регистрации недоступен - файл и регистр трассы всё равно пишутся
	КонецПопытки;

КонецПроцедуры

// Ошибка проверки: что-то на пути приёма или сверки оборвалось либо запись
// в регистр не прочиталась. Пишется во все логи с пометкой «ОШИБКА ПРОВЕРКИ»
// и уровнем «Ошибка» в журнале регистрации.
//
// Параметры:
//   Идентификатор - Строка - uid документа
//   Где           - Строка - метод или этап: «Сверка / ЗаписатьСверку»
//   Текст         - Строка - что случилось
//
Процедура ОшибкаПроверки(Идентификатор, Где, Текст) Экспорт

	Трасса(Идентификатор, СтрШаблон("ОШИБКА ПРОВЕРКИ [%1]: %2", Где, Текст), Ложь, , , , Истина);

КонецПроцедуры

// Ошибка проверки по пойманному исключению - текст берётся из ИнформацияОбОшибке.
//
Процедура ОшибкаПроверкиИсключение(Идентификатор, Где, Информация) Экспорт

	ОшибкаПроверки(Идентификатор, Где, ЭАрМ_Служебный.ТекстИсключения(Информация));

КонецПроцедуры

// Читает запись регистра сведений обратно после записи и сверяет с тем, что
// записали. Результат - строка во все логи: «Проверка записи: найдена» либо
// «ОШИБКА ПРОВЕРКИ: записи нет / значение другое».
//
// Параметры:
//   Идентификатор    - Строка - uid документа
//   ИмяРегистра      - Строка - имя регистра сведений
//   Измерения        - Структура - значения измерений записи
//   Ожидаемые        - Структура, Неопределено - поля, которые должны быть записаны
//                      (имя ресурса = значение); Неопределено - проверяется набор
//                      записей по отбору измерений
//   ОжидаемоеКоличество - Число, Неопределено - сколько записей должно быть в наборе
//
// Возвращаемое значение:
//   Булево - Истина, если запись есть и значения совпали
//
Функция ПроверитьЗаписьРегистра(Идентификатор, ИмяРегистра, Измерения, Ожидаемые = Неопределено,
	ОжидаемоеКоличество = Неопределено) Экспорт

	Отбор = Новый Массив;
	Для Каждого КлючЗначение Из Измерения Цикл
		Отбор.Добавить(КлючЗначение.Ключ + "=" + Лев(Строка(КлючЗначение.Значение), 40));
	КонецЦикла;
	Где = "Проверка записи " + ИмяРегистра;
	ТекстОтбора = СтрСоединить(Отбор, "; ");

	Попытка

		Если ТипЗнч(Ожидаемые) = Тип("Структура") Тогда

			Запись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
			Для Каждого КлючЗначение Из Измерения Цикл
				Запись[КлючЗначение.Ключ] = КлючЗначение.Значение;
			КонецЦикла;
			Запись.Прочитать();

			Если НЕ Запись.Выбран() Тогда
				ОшибкаПроверки(Идентификатор, Где, "записи нет в регистре после записи (" + ТекстОтбора + ")");
				Возврат Ложь;
			КонецЕсли;

			Расхождения = Новый Массив;
			Для Каждого КлючЗначение Из Ожидаемые Цикл
				Прочитано = Запись[КлючЗначение.Ключ];
				Если НЕ ЗначенияСовпали(Прочитано, КлючЗначение.Значение) Тогда
					Расхождения.Добавить(СтрШаблон("%1: записано «%2», прочитано «%3»", КлючЗначение.Ключ,
						Лев(Строка(КлючЗначение.Значение), 60), Лев(Строка(Прочитано), 60)));
				КонецЕсли;
			КонецЦикла;

			Если Расхождения.Количество() > 0 Тогда
				ОшибкаПроверки(Идентификатор, Где, СтрШаблон("запись есть (%1), но значения не совпали - %2",
					ТекстОтбора, СтрСоединить(Расхождения, "; ")));
				Возврат Ложь;
			КонецЕсли;

			Трасса(Идентификатор, СтрШаблон("Проверка записи: %1 (%2) - запись прочитана, значения совпали (полей проверено %3)",
				ИмяРегистра, ТекстОтбора, Ожидаемые.Количество()));
			Возврат Истина;

		КонецЕсли;

		Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		Для Каждого КлючЗначение Из Измерения Цикл
			Набор.Отбор[КлючЗначение.Ключ].Установить(КлючЗначение.Значение);
		КонецЦикла;
		Набор.Прочитать();
		Найдено = Набор.Количество();

		// Количество не задано - нужна хотя бы одна запись; задано - ровно столько (и 0 тоже)
		Если ?(ОжидаемоеКоличество = Неопределено, Найдено = 0, Найдено <> ОжидаемоеКоличество) Тогда
			ОшибкаПроверки(Идентификатор, Где, СтрШаблон("в регистре после записи %1 записей, ожидалось %2 (%3)",
				Найдено, ?(ОжидаемоеКоличество = Неопределено, "хотя бы одна", ОжидаемоеКоличество), ТекстОтбора));
			Возврат Ложь;
		КонецЕсли;

		Трасса(Идентификатор, СтрШаблон("Проверка записи: %1 (%2) - в регистре %3 записей, как ожидалось",
			ИмяРегистра, ТекстОтбора, Найдено));
		Возврат Истина;

	Исключение
		ОшибкаПроверкиИсключение(Идентификатор, Где + " (чтение не удалось)", ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Прочитанное из базы против записанного. Строки: 1С при записи отбрасывает
// концевые пробелы, а поле ограниченной длины обрезает хвост - это не ошибка.
//
Функция ЗначенияСовпали(Прочитано, Записано)

	Если ТипЗнч(Прочитано) = Тип("Строка") И ТипЗнч(Записано) = Тип("Строка") Тогда
		ИзБазы = СокрП(Прочитано);
		Ожидалось = СокрП(Записано);
		Возврат ИзБазы = Ожидалось
			ИЛИ ЗначениеЗаполнено(ИзБазы) И СтрДлина(Ожидалось) > СтрДлина(ИзБазы)
				И СтрНачинаетсяС(Ожидалось, ИзБазы);
	КонецЕсли;

	Возврат Прочитано = Записано;

КонецФункции

// Проверка записи «по запросу»: сколько строк реально лежит в регистре или
// табличной части документа. Для случаев, когда нужный отбор - по ресурсу, а не
// по измерению.
//
// Параметры:
//   Идентификатор   - Строка - uid документа
//   Что             - Строка - что проверяется (для текста)
//   ТекстЗапроса    - Строка - запрос, возвращающий одну колонку Количество
//   Параметры       - Структура - параметры запроса
//   Ожидаемо        - Число - сколько должно быть
//
// Возвращаемое значение:
//   Булево
//
Функция ПроверитьКоличествоЗапросом(Идентификатор, Что, ТекстЗапроса, Параметры, Ожидаемо) Экспорт

	Попытка

		Запрос = Новый Запрос(ТекстЗапроса);
		Для Каждого КлючЗначение Из Параметры Цикл
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;

		Выборка = Запрос.Выполнить().Выбрать();
		Факт = ?(Выборка.Следующий(), Выборка.Количество, 0);

		Если Факт <> Ожидаемо Тогда
			ОшибкаПроверки(Идентификатор, "Проверка записи " + Что,
				СтрШаблон("после записи в базе %1 строк, должно быть %2", Факт, Ожидаемо));
			Возврат Ложь;
		КонецЕсли;

		Трасса(Идентификатор, СтрШаблон("Проверка записи: %1 - в базе %2 строк, как ожидалось", Что, Факт));
		Возврат Истина;

	Исключение
		ОшибкаПроверкиИсключение(Идентификатор, "Проверка записи " + Что + " (чтение не удалось)", ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Короткое имя шага по началу сообщения - для отбора в регистре трассы.
//
Функция ШагТрассы(Текст)

	Начало = НРег(Лев(СокрЛП(Текст), 20));
	Шаги = Новый Соответствие;
	Шаги.Вставить("проход",   "Проход");
	Шаги.Вставить("папка",    "Папка");
	Шаги.Вставить("файл",     "Файл");
	Шаги.Вставить("регистр",  "РегистрПакетов");
	Шаги.Вставить("обработка","Пакет");
	Шаги.Вставить("шаг",      "ШагПрохода");
	Шаги.Вставить("цепочка",  "Цепочка");
	Шаги.Вставить("поиск упд","ПоискУПД");
	Шаги.Вставить("документ", "Документ");
	Шаги.Вставить("связи",    "Связи");
	Шаги.Вставить("сверка",   "Сверка");
	Шаги.Вставить("запись",   "ЗаписьРегистра");
	Шаги.Вставить("проверка", "ПроверкаЗаписи");
	Шаги.Вставить("архив",    "Архив");
	Шаги.Вставить("тест",     "Тест");
	Шаги.Вставить("сбис",     "СБИС");
	Шаги.Вставить("ошибка пр", "ОшибкаПроверки");
	Шаги.Вставить("этрн",     "ЭТрН");

	Для Каждого КлючЗначение Из Шаги Цикл
		Если СтрНачинаетсяС(Начало, КлючЗначение.Ключ) Тогда
			Возврат КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "Прочее";

КонецФункции

// Имя операции трассировки в журнале обмена.
//
Функция ОперацияТрассы() Экспорт

	Возврат "ТрассаПриема";

КонецФункции

#КонецОбласти

#Область Прием

Процедура ПринятьИзПапки(Настройки, Итоги)

	Если НЕ ЗначениеЗаполнено(Настройки.КаталогПакетов) Тогда
		ДобавитьОшибку(Итоги, "Папка",
			"не указана «Папка ответов Далион» в настройках ЭДО - пакеты Далиона не читались");
		Возврат;
	КонецЕсли;

	Каталоги = ЭАрМ_РегламентныйОбменЭДО.КаталогиОтветовВПапке(Настройки.КаталогПакетов);
	Если Каталоги.Количество() = 0 Тогда
		ДобавитьОшибку(Итоги, "Папка",
			ЭАрМ_РегламентныйОбменЭДО.ТекстНедоступнойПапки(Настройки.КаталогПакетов));
		Трасса("", "Папка пакетов не найдена сервером 1С: " + Настройки.КаталогПакетов, Ложь);
	КонецЕсли;

	ПриниматьПовторно = Ложь;
	Настройки.Свойство("ПриниматьПовторно", ПриниматьПовторно);
	ПриниматьПовторно = (ПриниматьПовторно = Истина);

	Для Каждого ПутьКаталога Из Каталоги Цикл

		ВернутьЗависшиеПакеты(ПутьКаталога, Настройки.МаскаПакетов);

		Файлы = НайтиФайлы(ПутьКаталога, Настройки.МаскаПакетов);
		Трасса("", СтрШаблон("Папка %1: файлов по маске %2 - %3", ПутьКаталога,
			Настройки.МаскаПакетов, Файлы.Количество()), Истина, , Файлы.Количество());

		Для Каждого ФайлПакета Из Файлы Цикл

			// Это исходящий запрос УТ к Далиону, а не входящий пакет.
			// В файловом режиме оба направления могут использовать одну папку.
			Если ЭтоИсходящийФайлУТ(ФайлПакета.Имя) Тогда
				Трасса("", "Файл пропущен: это исходящий запрос УТ", Истина, ФайлПакета.Имя);
				Продолжить;
			КонецЕсли;

			// Захват переименованием в .processing: второй сеанс (регламентное задание
			// и кнопка, два задания) тот же файл уже не возьмёт. Раньше оба читали
			// одну папку, и второму доставалось «Файл не обнаружен» на ЧтениеТекста
			ФайлЗахвата = ЭАрМ_РегламентныйОбменЭДО.ЗахватитьФайлОтвета(ФайлПакета);
			Если ФайлЗахвата = Неопределено Тогда
				Трасса("", "Файл пропущен: его уже забрал другой сеанс (второе регламентное задание или кнопка «Прочитать папку» во время задания)",
					Истина, ФайлПакета.Имя);
				Продолжить;
			КонецЕсли;

			Результат = ПринятьФайл(ФайлЗахвата.ПолноеИмя, ФайлПакета.Имя, "Папка", Итоги, ПриниматьПовторно);

			Если Результат.Успех Тогда
				ЭАрМ_РегламентныйОбменЭДО.ПереместитьОтветВАрхив(ПутьКаталога, ФайлЗахвата, ФайлПакета.Имя);
				Если ЭтоДокументДалиона(Результат.ТипОбъекта) Тогда
					Трасса("", "Файл перенесён в archive (" + Результат.Состояние + ")", Истина, ФайлПакета.Имя);
				КонецЕсли;
			Иначе
				ПереместитьВОшибки(ПутьКаталога, ФайлЗахвата, Результат.Ошибка, ФайлПакета.Имя);
				Трасса("", "Файл перенесён в error: " + Результат.Ошибка, Ложь, ФайлПакета.Имя);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Приём из очереди службы «Монитор папок» (ЭАрМ_МониторПапок).
//
// Монитор отдаёт только дописанные файлы, и строку очереди получает один сеанс.
// Файл, который сервер 1С видит по пути, после разбора уходит в archive/error
// рядом - как при чтении папки. Не видит (монитор на другом сервере) - файл
// скачивается через API, а в архив его убирает монитор.
//
// Возвращаемое значение:
//   Булево - Ложь, если монитор не ответил: тогда пакеты читаются из папки
//
Функция ПринятьИзМонитора(Настройки, Итоги)

	ПриниматьПовторно = Ложь;
	Настройки.Свойство("ПриниматьПовторно", ПриниматьПовторно);
	ПриниматьПовторно = (ПриниматьПовторно = Истина);

	Попытка
		Пачка = ЭАрМ_МониторПапок.ВзятьИзОчереди(Настройки.ПакетовЗаСеанс);
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОшибкаПроверкиИсключение("", "ПринятьИзМонитора (очередь не получена - пакеты читаются из папки)", ОшибкаИсключения);
		ДобавитьОшибку(Итоги, "Монитор папок",
			ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения) + " - пакеты прочитаны из папки");
		Возврат Ложь;
	КонецПопытки;

	Трасса("", СтрШаблон("Монитор папок: из очереди взято %1, маска пакетов %2",
		Пачка.Количество(), Настройки.МаскаПакетов), Истина, , Пачка.Количество());

	Для Каждого СтрокаОчереди Из Пачка Цикл
		ПринятьСтрокуМонитора(СтрокаОчереди, Настройки, Итоги, ПриниматьПовторно);
	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура ПринятьСтрокуМонитора(СтрокаОчереди, Настройки, Итоги, ПриниматьПовторно)

	ФайлПакета = Новый Файл(СтрокаОчереди.Path);
	ИмяФайла = ФайлПакета.Имя;

	Если ЭтоИсходящийФайлУТ(ИмяФайла) ИЛИ НЕ ИмяПоМаске(ИмяФайла, Настройки.МаскаПакетов) Тогда
		Трасса("", "Монитор: файл пропущен - исходящий запрос УТ или не по маске " + Настройки.МаскаПакетов, Истина, ИмяФайла);
		ОтветитьМонитору(СтрокаОчереди, Истина, "Пропущен: не пакет Далиона");
		Возврат;
	КонецЕсли;

	ВидитПапку = Ложь;
	Попытка
		ВидитПапку = ФайлПакета.Существует();
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОшибкаПроверкиИсключение("", "ПринятьСтрокуМонитора (путь " + СтрокаОчереди.Path + " не проверен - файл будет скачан)", ОшибкаИсключения);
	КонецПопытки;

	Если ВидитПапку Тогда

		// Захват, как при чтении папки: кнопка теста или вторая база могут читать ту же папку
		ФайлЗахвата = ЭАрМ_РегламентныйОбменЭДО.ЗахватитьФайлОтвета(ФайлПакета);
		Если ФайлЗахвата = Неопределено Тогда
			Трасса("", "Монитор: файл уже забрал другой сеанс 1С", Истина, ИмяФайла);
			ОтветитьМонитору(СтрокаОчереди, Истина, "Файл забрал другой сеанс 1С");
			Возврат;
		КонецЕсли;

		Результат = ПринятьФайл(ФайлЗахвата.ПолноеИмя, ИмяФайла, "Монитор", Итоги, ПриниматьПовторно);
		Если Результат.Успех Тогда
			ЭАрМ_РегламентныйОбменЭДО.ПереместитьОтветВАрхив(ФайлПакета.Путь, ФайлЗахвата, ИмяФайла);
		Иначе
			ПереместитьВОшибки(ФайлПакета.Путь, ФайлЗахвата, Результат.Ошибка, ИмяФайла);
		КонецЕсли;

	Иначе

		Попытка
			ВременныйФайл = ЭАрМ_МониторПапок.ПолучитьФайлВоВременный(СтрокаОчереди.FileId);
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ОшибкаПроверкиИсключение("", "ПринятьСтрокуМонитора (" + ИмяФайла + " не скачан из монитора)", ОшибкаИсключения);
			ОтветитьМонитору(СтрокаОчереди, Ложь, "Не скачан в 1С: " + ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения));
			Возврат;
		КонецПопытки;

		Результат = ПринятьФайл(ВременныйФайл, ИмяФайла, "Монитор", Итоги, ПриниматьПовторно);
		ЭАрМ_Служебный.УдалитьВременныйФайл(ВременныйФайл);

		Если Результат.Успех Тогда
			Попытка
				ЭАрМ_МониторПапок.ПереместитьВАрхив(СтрокаОчереди.FileId);
			Исключение
				ОшибкаИсключения = ИнформацияОбОшибке();
				// Пакет уже в регистре; файл остался в папке монитора и уйдёт в архив по его сроку
				ОшибкаПроверкиИсключение("", "ПринятьСтрокуМонитора (" + ИмяФайла + " принят, но монитор не убрал его в архив)", ОшибкаИсключения);
			КонецПопытки;
		КонецЕсли;

	КонецЕсли;

	Если Результат.Успех Тогда
		Если ЭтоДокументДалиона(Результат.ТипОбъекта) Тогда
			Трасса("", СтрШаблон("Монитор: файл принят (%1), %2", Результат.Состояние,
				?(ВидитПапку, "перенесён в archive", "скачан через API, архив - в мониторе")), Истина, ИмяФайла);
		КонецЕсли;
		ОтветитьМонитору(СтрокаОчереди, Истина, Результат.Состояние);
	Иначе
		Трасса("", "Монитор: файл не принят: " + Результат.Ошибка, Ложь, ИмяФайла);
		ОтветитьМонитору(СтрокаОчереди, Ложь, Результат.Ошибка);
	КонецЕсли;

КонецПроцедуры

// Подтверждение строки очереди монитора. Не дошло - монитор вернёт строку в очередь
// по своему таймауту, повторный приём даст «Дубль» в регистре пакетов.
//
Процедура ОтветитьМонитору(СтрокаОчереди, Успех, Текст)

	Попытка
		Если Успех Тогда
			ЭАрМ_МониторПапок.Подтвердить(СтрокаОчереди.Id, Текст);
		Иначе
			ЭАрМ_МониторПапок.ОтметитьОшибку(СтрокаОчереди.Id, Текст);
		КонецЕсли;
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОшибкаПроверкиИсключение("", СтрШаблон("ОтветитьМонитору (строка очереди %1 не подтверждена)",
			Формат(СтрокаОчереди.Id, "ЧГ=0")), ОшибкаИсключения);
	КонецПопытки;

КонецПроцедуры

// Имя файла по маске вида dalion_*.json: звёздочка - любые символы, остальное как есть.
//
Функция ИмяПоМаске(ИмяФайла, Маска)

	Если НЕ ЗначениеЗаполнено(Маска) Тогда
		Возврат Истина;
	КонецЕсли;

	// Сравнение кусков через Лев/Прав: СтрНачинаетсяС и СтрНайти с пустой подстрокой
	// (маска «*.json», «a**b») вызывают исключение
	Части = СтрРазделить(НРег(Маска), "*", Истина);
	Имя = НРег(ИмяФайла);
	Если Лев(Имя, СтрДлина(Части[0])) <> Части[0] Тогда
		Возврат Ложь;
	КонецЕсли;
	Позиция = СтрДлина(Части[0]) + 1;
	Для Номер = 1 По Части.ВГраница() Цикл
		Часть = Части[Номер];
		Если Номер = Части.ВГраница() Тогда
			Возврат СтрДлина(Имя) - СтрДлина(Часть) + 1 >= Позиция И Прав(Имя, СтрДлина(Часть)) = Часть;
		КонецЕсли;
		Если Часть = "" Тогда
			Продолжить;
		КонецЕсли;
		Найдено = СтрНайти(Имя, Часть, , Позиция);
		Если Найдено = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Позиция = Найдено + СтрДлина(Часть);
	КонецЦикла;

	Возврат СтрДлина(Имя) = СтрДлина(Части[0]);

КонецФункции

Процедура ПринятьСFTP(Настройки, Итоги)

	НастройкиПодключения = ЭАрМ_НастройкиСервер.НастройкиFTP();
	Если НЕ ЗначениеЗаполнено(НастройкиПодключения.Сервер) Тогда
		Возврат;
	КонецЕсли;

	Каталоги = ЭАрМ_НастройкиСервер.КаталогиОбменаFTP();
	КаталогОшибок = ЭАрМ_Служебный.ОбъединитьПутьFTP(Каталоги.Ответы, "error");

	Соединение = ЭАрМ_Служебный.СоздатьСоединениеFTP(НастройкиПодключения);
	ЭАрМ_Служебный.ОбеспечитьКаталогFTP(Соединение, Каталоги.АрхивОтветов);
	ЭАрМ_Служебный.ОбеспечитьКаталогFTP(Соединение, КаталогОшибок);

	Для Каждого ФайлНаСервере Из Соединение.НайтиФайлы(Каталоги.Ответы, Настройки.МаскаПакетов) Цикл

		Если ЭтоИсходящийФайлУТ(ФайлНаСервере.Имя) Тогда
			Продолжить;
		КонецЕсли;

		ВременныйФайл = ПолучитьИмяВременногоФайла("json");

		Попытка

			Соединение.Получить(ФайлНаСервере.ПолноеИмя, ВременныйФайл);
			Результат = ПринятьФайл(ВременныйФайл, ФайлНаСервере.Имя, "FTP", Итоги);

			Приемник = ?(Результат.Успех, Каталоги.АрхивОтветов, КаталогОшибок);
			Соединение.Переместить(ФайлНаСервере.ПолноеИмя,
				ЭАрМ_Служебный.ОбъединитьПутьFTP(Приемник, ФайлНаСервере.Имя));

		Исключение
			// Файл остаётся на сервере и будет прочитан следующим проходом
			ДобавитьОшибку(Итоги, ФайлНаСервере.Имя,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;

		ЭАрМ_Служебный.УдалитьВременныйФайл(ВременныйФайл);

	КонецЦикла;

КонецПроцедуры

// Читает файл пакета и регистрирует его.
//
// Возвращаемое значение:
//   Структура - Успех (Булево), Ошибка (Строка), Состояние (Принят, Дубль, Устарел)
//
Функция ПринятьФайл(ПутьКФайлу, ИмяФайла, Источник, Итоги, Принудительно = Ложь)

	Результат = Новый Структура("Успех, Ошибка, Состояние, ТипОбъекта", Ложь, "", "", "");

	Попытка

		ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
		ТекстПакета = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();

		Если Лев(ТекстПакета, 1) = Символ(65279) Тогда
			ТекстПакета = Сред(ТекстПакета, 2);
		КонецЕсли;
		ТекстПакета = СокрЛП(ТекстПакета);

		Описание = ОписаниеПакета(ТекстПакета);
		Описание.ИмяФайла = ИмяФайла;
		Описание.Источник = Источник;

		Результат.ТипОбъекта = Описание.ТипОбъекта;

		// Трасса - только по документам: справочники Далиона идут сотнями
		// файлов и заслоняли путь приходной
		ТрассаНужна = ЭтоДокументДалиона(Описание.ТипОбъекта);
		Если ТрассаНужна Тогда
			Трасса(Описание.ИдентификаторОбъекта, СтрШаблон(
				"Файл разобран: тип %1, uid %2, номер %3 от %4, версия %5, создан %6, запрос %7",
				Описание.ТипОбъекта, Описание.ИдентификаторОбъекта, Описание.НомерОбъекта,
				Формат(Описание.ДатаОбъекта, "ДЛФ=D"), Формат(Описание.НомерВерсии, "ЧГ=0"),
				Формат(Описание.ДатаСоздания, "ДЛФ=DT"), Описание.ИдентификаторЗапроса), Истина, ИмяФайла);
		КонецЕсли;

		Подробности = "";
		Результат.Состояние = ЗарегистрироватьПакет(Описание, Подробности, Принудительно);
		Результат.Успех = Истина;

		Если ТрассаНужна ИЛИ Результат.Состояние <> "Принят" Тогда
			Трасса(Описание.ИдентификаторОбъекта, СтрШаблон("Регистр пакетов: %1. %2",
				Результат.Состояние, Подробности), Результат.Состояние = "Принят", ИмяФайла, ,
				Новый Структура("ТипОбъекта, Номер", Описание.ТипОбъекта, Описание.НомерОбъекта));
		КонецЕсли;

		// Запись пакета читаем обратно: статус и хеш должны лежать в регистре
		Если ТрассаНужна И Результат.Состояние = "Принят" Тогда
			ПроверитьЗаписьРегистра(Описание.ИдентификаторОбъекта, "ЭАрМ_ПакетыДалион",
				Новый Структура("ТипОбъекта, ИдентификаторОбъекта", Описание.ТипОбъекта, Описание.ИдентификаторОбъекта),
				Новый Структура("Статус, Хеш", Статусы().Принят, Описание.Хеш));
		КонецЕсли;

		Если Результат.Состояние = "Принят" Тогда
			Итоги.Принято = Итоги.Принято + 1;
		ИначеЕсли ЭтоДокументДалиона(Описание.ТипОбъекта) Тогда
			// Файл уйдёт в архив, а в регистр не записан - без этой строки
			// документ просто «не пришёл»
			ТекстПропуска = СтрШаблон(
				"%1 %2 от %3 не записан в регистр пакетов: %4", Описание.ТипОбъекта,
				Описание.НомерОбъекта, Формат(Описание.ДатаОбъекта, "ДЛФ=D"),
				?(Результат.Состояние = "Устарел",
					"в регистре пакет новее",
					"такой же пакет уже есть или тот же номер и дата под другим uid"));
			Итоги.Сообщения.Добавить(ТекстПропуска);
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Описание.ИдентификаторОбъекта, 100),
				ОперацияЖурнала(), Ложь, ТекстПропуска, ИмяФайла);
		КонецЕсли;

		ЭАрМ_ЗапросыДалион.ОтметитьПоступлениеПакета(
			Описание.ИдентификаторЗапроса, Описание.ТипОбъекта);

		// Итог запроса от Далиона: тип считается пришедшим, даже если за период
		// не нашлось ни одного документа и отдельного пакета не было
		Если Описание.ТипОбъекта = "dataResponse" Тогда
			ОтметитьТипыИзИтогаЗапроса(Описание);
		КонецЕсли;

	Исключение
		Результат.Ошибка = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
		ДобавитьОшибку(Итоги, ИмяФайла, Результат.Ошибка);
		Трасса("", "Файл не принят: " + Результат.Ошибка, Ложь, ИмяФайла);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// dataResponse: data.types[] = {type, selected, exported, unchanged, errors}.
// Тип с ошибками пришедшим не отмечаем - запрос не должен выглядеть выполненным.
//
Процедура ОтметитьТипыИзИтогаЗапроса(Описание)

	Данные = ЭАрМ_Служебный.ПрочитатьОтветJSON(Описание.Текст);
	Объект = ЭАрМ_Служебный.ЗначениеУзла(Данные, "data");

	Для Каждого ИтогТипа Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "types")) Цикл

		ТипОбъекта = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ИтогТипа, "type", ""));
		Ошибок = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(ИтогТипа, "errors", 0));

		Если ЗначениеЗаполнено(ТипОбъекта) И Ошибок = 0 Тогда
			ЭАрМ_ЗапросыДалион.ОтметитьПоступлениеПакета(Описание.ИдентификаторЗапроса, ТипОбъекта);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Разбирает заголовок пакета. Неизвестный тип и пустой идентификатор - ошибка
// приёма: такой файл уходит в error, а не в архив.
//
// Возвращаемое значение:
//   Структура - ТипОбъекта, ИдентификаторОбъекта, НомерОбъекта, ДатаОбъекта,
//               НомерВерсии, ДатаСоздания, Хеш, Текст, ИмяФайла, Источник
//
Функция ОписаниеПакета(ТекстПакета)

	Данные = ЭАрМ_Служебный.ПрочитатьОтветJSON(ТекстПакета);
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Файл не разобран как JSON-объект";
	КонецЕсли;

	Заголовок = ЭАрМ_Служебный.ЗначениеУзла(Данные, "header");
	ТипПакета = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Заголовок, "type", ""));
	Объект    = ЭАрМ_Служебный.ЗначениеУзла(Данные, "data");
	ИдентификаторЗапроса = ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеУзла(Заголовок, "requestId", ""));

	Если СтрНайти("|ЗаказПоставщику|ПриходнаяНакладная|ВозвратПоставщику|КорректировкаПоставщика|Номенклатура|Контрагент|ДоговорКонтрагента|Касса|supplierBarcodes|serviceResponse|dataResponse|",
		"|" + ТипПакета + "|") = 0 ИЛИ НЕ ЗначениеЗаполнено(ТипПакета) Тогда
		ВызватьИсключение СтрШаблон("Неизвестный тип пакета ""%1""", ТипПакета);
	КонецЕсли;

	Хеш = ХешТекста(ТекстПакета);

	Описание = Новый Структура;
	Описание.Вставить("ТипОбъекта", ТипПакета);
	Описание.Вставить("Хеш", Хеш);
	Описание.Вставить("Текст", ТекстПакета);
	Описание.Вставить("ИмяФайла", "");
	Описание.Вставить("Источник", "");
	Описание.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
	Описание.Вставить("ДатаСоздания",
		ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Заголовок, "created", "")));

	Если ЭтоДокументДалиона(ТипПакета) Тогда

		Описание.Вставить("ИдентификаторОбъекта",
			ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Объект, "uid", "")));
		Описание.Вставить("НомерОбъекта",
			ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Объект, "number", "")));
		Описание.Вставить("ДатаОбъекта",
			ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "date", "")));
		Описание.Вставить("НомерВерсии",
			ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "versionNumber", 0)));

	Иначе

		// Порции штрихкодов и ответы не версионируются: каждый файл - отдельный
		// пакет, а одинаковое содержимое отсекается хешем
		Описание.Вставить("ИдентификаторОбъекта", Хеш);
		Описание.Вставить("НомерОбъекта", ЭАрМ_Служебный.СтрокойИлиПусто(
			?(ЗначениеЗаполнено(ИдентификаторЗапроса), ИдентификаторЗапроса,
				ЭАрМ_Служебный.ЗначениеУзла(Заголовок, "requestId", ""))));
		Описание.Вставить("ДатаОбъекта", Описание.ДатаСоздания);
		Описание.Вставить("НомерВерсии", 0);

	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Описание.ИдентификаторОбъекта) Тогда
		ВызватьИсключение СтрШаблон("В пакете ""%1"" не заполнен data.uid", ТипПакета);
	КонецЕсли;

	Возврат Описание;

КонецФункции

// Кладёт пакет в регистр по правилу "одна запись на объект".
//
// Параметры:
//   Подробности   - Строка - почему пакет принят или отвергнут (для трассировки)
//   Принудительно - Булево - Истина: записать поверх, не проверяя дубль и версию
//
// Возвращаемое значение:
//   Строка - "Принят", "Дубль" (тот же хеш) или "Устарел" (версия старше записанной)
//
Функция ЗарегистрироватьПакет(Описание, Подробности = "", Принудительно = Ложь)

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЭАрМ_ПакетыДалион");
		ЭлементБлокировки.УстановитьЗначение("ТипОбъекта", Описание.ТипОбъекта);
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторОбъекта", Описание.ИдентификаторОбъекта);
		Блокировка.Заблокировать();

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ПакетыДалион.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ТипОбъекта = Описание.ТипОбъекта;
		МенеджерЗаписи.ИдентификаторОбъекта = Описание.ИдентификаторОбъекта;
		МенеджерЗаписи.Прочитать();

		Если Принудительно Тогда
			Подробности = "принудительно заново" + ?(МенеджерЗаписи.Выбран(),
				" (поверх записи в регистре, статус был «" + МенеджерЗаписи.Статус + "»)", "");

		ИначеЕсли МенеджерЗаписи.Выбран() Тогда

			Если МенеджерЗаписи.Хеш = Описание.Хеш Тогда
				ОтменитьТранзакцию();
				Подробности = СтрШаблон("в регистре уже есть такой же пакет (хеш совпал), статус %1, файл %2",
					МенеджерЗаписи.Статус, МенеджерЗаписи.ИмяФайла);
				Возврат "Дубль";
			КонецЕсли;

			// Файлы могут прийти не по порядку: старую версию документа
			// поверх новой не пишем. Старшинство - по времени пакета (header.created):
			// номера версий у источников Далиона разного масштаба (расширение -
			// yyyyMMddHHmmss, в Число(10,0) записывается обрезанным до 9999999999;
			// обработка ВыгрузкаДанныхДалион - секунды от 2000 года), и новая
			// приходная выглядела «старше» записанной и молча уходила в архив.
			// Номер версии решает, только когда времени нет или оно совпало
			Если ЗначениеЗаполнено(Описание.ДатаСоздания)
				И ЗначениеЗаполнено(МенеджерЗаписи.ДатаСозданияПакета)
				И Описание.ДатаСоздания <> МенеджерЗаписи.ДатаСозданияПакета Тогда
				Устарел = Описание.ДатаСоздания < МенеджерЗаписи.ДатаСозданияПакета;
			Иначе
				Устарел = Описание.НомерВерсии < МенеджерЗаписи.НомерВерсии;
			КонецЕсли;
			Подробности = СтрШаблон("в регистре: версия %1, создан %2, статус %3; в файле: версия %4, создан %5",
				Формат(МенеджерЗаписи.НомерВерсии, "ЧГ=0"), Формат(МенеджерЗаписи.ДатаСозданияПакета, "ДЛФ=DT"),
				МенеджерЗаписи.Статус, Формат(Описание.НомерВерсии, "ЧГ=0"), Формат(Описание.ДатаСоздания, "ДЛФ=DT"));
			Если Устарел Тогда
				ОтменитьТранзакцию();
				Подробности = "пакет в регистре новее - " + Подробности;
				Возврат "Устарел";
			КонецЕсли;
			Подробности = "новая версия поверх записанной - " + Подробности;

		ИначеЕсли ДокументУжеЗагружен(Описание) Тогда
			// Тот же номер и дата под другим uid - Далион пересоздал документ.
			// Раньше пакет отбрасывался здесь как «Дубль» и в регистр не попадал,
			// а цепочка рассчитана на то, что он лежит в регистре: ДокументЦепочкиУжеЕсть
			// держит его без цепочки, пока прежний жив, а ПринятьОтложенныеЗаменыПоступления
			// принимает, когда прежний помечен на удаление. Дубль решает цепочка
			Подробности = СтрШаблон("новый uid, но документ с номером %1 и датой %2 уже есть под другим uid - "
				+ "пакет записан, замену или дубль решит цепочка",
				Описание.НомерОбъекта, Формат(Описание.ДатаОбъекта, "ДЛФ=D"));

		Иначе
			Подробности = "новый объект";

		КонецЕсли;

		МенеджерЗаписи.ТипОбъекта           = Описание.ТипОбъекта;
		МенеджерЗаписи.ИдентификаторОбъекта = Описание.ИдентификаторОбъекта;
		МенеджерЗаписи.НомерОбъекта         = Лев(Описание.НомерОбъекта, 50);
		МенеджерЗаписи.ДатаОбъекта          = Описание.ДатаОбъекта;
		// Регистр - Число(10,0): 14-значный номер расширения Далиона не помещается
		МенеджерЗаписи.НомерВерсии          = Мин(Описание.НомерВерсии, 9999999999);
		МенеджерЗаписи.ДатаСозданияПакета   = Описание.ДатаСоздания;
		МенеджерЗаписи.ИмяФайла             = Лев(Описание.ИмяФайла, 150);
		МенеджерЗаписи.Источник             = Лев(Описание.Источник, 20);
		МенеджерЗаписи.ДатаПриема           = ТекущаяДатаСеанса();
		МенеджерЗаписи.Хеш                  = Описание.Хеш;
		МенеджерЗаписи.Статус               = Статусы().Принят;
		МенеджерЗаписи.ПопытокОбработки     = 0;
		МенеджерЗаписи.ДатаОбработки        = '00010101';
		МенеджерЗаписи.ТекстОшибки          = "";
		МенеджерЗаписи.ДанныеПакета         = Описание.Текст;
		МенеджерЗаписи.Записать(Истина);

		ЗафиксироватьТранзакцию();

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ОшибкаПроверкиИсключение(Описание.ИдентификаторОбъекта,
			"ЗарегистрироватьПакет (пакет не записан в ЭАрМ_ПакетыДалион)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

	Возврат "Принят";

КонецФункции

// Пакеты, захваченные дольше 30 минут назад и не разобранные (сеанс упал
// посреди приёма), возвращаются под исходное имя - их возьмёт следующий проход.
//
Процедура ВернутьЗависшиеПакеты(ПутьКаталога, МаскаПакетов)

	Для Каждого Захваченный Из НайтиФайлы(ПутьКаталога, МаскаПакетов + ".processing") Цикл
		Попытка
			Если ТекущаяДатаСеанса() - Захваченный.ПолучитьВремяИзменения() < 1800 Тогда
				Продолжить;
			КонецЕсли;
			ПереместитьФайл(Захваченный.ПолноеИмя,
				Лев(Захваченный.ПолноеИмя, СтрДлина(Захваченный.ПолноеИмя) - СтрДлина(".processing")));
			Трасса("", "Файл возвращён из .processing: прошлый сеанс не дочитал его", Ложь, Захваченный.Имя);
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			// Его как раз вернул или разбирает другой проход
			ОшибкаПроверкиИсключение("",
				"ВернутьЗависшиеПакеты (не возвращён " + Захваченный.Имя + ")", ОшибкаИсключения);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Убирает непринятый файл в подкаталог error рядом с ним. В архив такой
// файл не кладём: там он выглядел бы обработанным.
//
// Параметры:
//   ИмяВОшибках - Строка - имя файла в error; пусто - имя самого файла
//
Процедура ПереместитьВОшибки(ПутьКаталога, ФайлПакета, ТекстОшибки, ИмяВОшибках = "")

	Попытка

		КаталогОшибок = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(ПутьКаталога, "error");
		ФайлКаталогаОшибок = Новый Файл(КаталогОшибок);
		Если НЕ ФайлКаталогаОшибок.Существует() Тогда
			СоздатьКаталог(КаталогОшибок);
		КонецЕсли;

		ПутьВОшибках = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(КаталогОшибок,
			?(ЗначениеЗаполнено(ИмяВОшибках), ИмяВОшибках, ФайлПакета.Имя));
		ФайлВОшибках = Новый Файл(ПутьВОшибках);
		Если ФайлВОшибках.Существует() Тогда
			УдалитьФайлы(ПутьВОшибках);
		КонецЕсли;

		ПереместитьФайл(ФайлПакета.ПолноеИмя, ПутьВОшибках);

	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("ЦепочкаЗакупки", СтрШаблон(
			"Не удалось убрать %1 в error: %2", ФайлПакета.Имя,
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
	КонецПопытки;

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", ОперацияЖурнала(), Ложь,
		СтрШаблон("Пакет не принят: %1", ТекстОшибки),
		?(ЗначениеЗаполнено(ИмяВОшибках), ИмяВОшибках, ФайлПакета.Имя));

КонецПроцедуры

#КонецОбласти

#Область Обработка

Процедура ОбработатьПакет(ТипОбъекта, ИдентификаторОбъекта, Настройки, Итоги)

	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Пакеты.ДанныеПакета КАК ДанныеПакета
		|ИЗ
		|	РегистрСведений.ЭАрМ_ПакетыДалион КАК Пакеты
		|ГДЕ
		|	Пакеты.ТипОбъекта = &ТипОбъекта
		|	И Пакеты.ИдентификаторОбъекта = &ИдентификаторОбъекта";
		Запрос.УстановитьПараметр("ТипОбъекта", ТипОбъекта);
		Запрос.УстановитьПараметр("ИдентификаторОбъекта", ИдентификаторОбъекта);

		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Возврат;
		КонецЕсли;

		Данные = ЭАрМ_Служебный.ПрочитатьОтветJSON(Выборка.ДанныеПакета);
		Объект = ЭАрМ_Служебный.ЗначениеУзла(Данные, "data");

		Если ЭтоДокументДалиона(ТипОбъекта) Тогда
			Трасса(ИдентификаторОбъекта, "Обработка пакета начата: " + ТипОбъекта);
		КонецЕсли;

		Если ТипОбъекта = "ЗаказПоставщику" Тогда
			СоздатьДоговорИзДокумента(Объект);
			ЭАрМ_ЦепочкаЗакупки.ОбновитьПоЗаказу(Объект, Настройки);

		ИначеЕсли ТипОбъекта = "ПриходнаяНакладная" Тогда
			СоздатьДоговорИзДокумента(Объект);
			ЭАрМ_ЦепочкаЗакупки.ОбновитьПоПоступлению(Объект, Настройки);

		ИначеЕсли ТипОбъекта = "ВозвратПоставщику" ИЛИ ТипОбъекта = "КорректировкаПоставщика" Тогда
			// Возврат и корректировка поставщика из Далиона: строки - в ЭАрМ_ТоварыЭТрН
			// (источники «ВозвратДалион» / «КорректировкаДалион»). Сверку с УКД
			// и статусы по ним ведёт ЭАрМ_КорректировкиУПД
			ЗаписаноСтрок = ЭАрМ_КорректировкиУПД.ЗаписатьСтрокиДокументаДалион(ТипОбъекта, Объект);
			Трасса(ИдентификаторОбъекта, СтрШаблон("Документ: %1 № %2 - строк в ЭАрМ_ТоварыЭТрН %3",
				ТипОбъекта, ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Объект, "number", "")),
				ЗаписаноСтрок), Истина, , ЗаписаноСтрок);

		ИначеЕсли ТипОбъекта = "supplierBarcodes" Тогда
			ЭАрМ_СверкаТоваровЦепочки.ЗагрузитьШтрихкодыПоставщика(Объект);
			ПометитьНаСверкуПоНоменклатуре(Объект, ИдентификаторОбъекта);

		ИначеЕсли ТипОбъекта = "Номенклатура" Тогда
			ЭАрМ_СверкаТоваровЦепочки.ЗагрузитьНоменклатуруДалион(Объект);
			ПометитьНаСверкуПоНоменклатуре(Объект, ИдентификаторОбъекта);

		ИначеЕсли ТипОбъекта = "Контрагент" Тогда
			ЗагрузитьКонтрагентовВУТ(Объект);

		ИначеЕсли ТипОбъекта = "ДоговорКонтрагента" Тогда
			ЗагрузитьДоговорыВУТ(Объект);

		ИначеЕсли ТипОбъекта = "Касса" Тогда
			// Справочник сохранён в регистре пакетов. Сверку документов не трогаем.

		ИначеЕсли ТипОбъекта = "serviceResponse" Тогда
			Если НЕ ЭАрМ_ПравкиЦен.ПрименитьОтветServiceResponse(Данные) Тогда
				ЭАрМ_ЦепочкаЗакупки.ПрименитьОтветПломбы(Данные);
			КонецЕсли;

		КонецЕсли;

		ОтметитьОбработку(ТипОбъекта, ИдентификаторОбъекта, "");
		Итоги.Обработано = Итоги.Обработано + 1;
		Если ЭтоДокументДалиона(ТипОбъекта) Тогда
			Трасса(ИдентификаторОбъекта, "Обработка пакета окончена: статус «Обработан»");
		КонецЕсли;

	Исключение

		ТекстОшибки = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
		ОтметитьОбработку(ТипОбъекта, ИдентификаторОбъекта, ТекстОшибки);
		Трасса(ИдентификаторОбъекта, "Обработка пакета прервана ошибкой: " + ТекстОшибки, Ложь);
		ДобавитьОшибку(Итоги, ТипОбъекта + " " + ИдентификаторОбъекта, ТекстОшибки);

		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторОбъекта, 100), ОперацияЖурнала(),
			Ложь, СтрШаблон("%1: %2", ТипОбъекта, ТекстОшибки));

	КонецПопытки;

КонецПроцедуры

// Пакеты заказов и приходных за период - снова в статус «Принят»: следующий
// проход обработает их заново (связь с УПД, документ, сверка). Для
// переобработки уже принятых файлов, которые папка больше не отдаст.
//
// Возвращаемое значение:
//   Число - сколько пакетов возвращено в очередь
//
Функция ВернутьПакетыДокументовВОчередь(ДатаС = Неопределено, ДатаПо = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пакеты.ТипОбъекта КАК ТипОбъекта,
	|	Пакеты.ИдентификаторОбъекта КАК ИдентификаторОбъекта
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПакетыДалион КАК Пакеты
	|ГДЕ
	|	Пакеты.ТипОбъекта В (""ЗаказПоставщику"", ""ПриходнаяНакладная"", ""ВозвратПоставщику"", ""КорректировкаПоставщика"")
	|	И (&БезНачала ИЛИ Пакеты.ДатаОбъекта >= &ДатаС)
	|	И (&БезКонца ИЛИ Пакеты.ДатаОбъекта <= &ДатаПо)";
	Запрос.УстановитьПараметр("БезНачала", НЕ ЗначениеЗаполнено(ДатаС));
	Запрос.УстановитьПараметр("ДатаС", ?(ЗначениеЗаполнено(ДатаС), НачалоДня(ДатаС), '00010101'));
	Запрос.УстановитьПараметр("БезКонца", НЕ ЗначениеЗаполнено(ДатаПо));
	Запрос.УстановитьПараметр("ДатаПо", ?(ЗначениеЗаполнено(ДатаПо), КонецДня(ДатаПо), '00010101'));

	Возвращено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ПакетыДалион.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ТипОбъекта = Выборка.ТипОбъекта;
		МенеджерЗаписи.ИдентификаторОбъекта = Выборка.ИдентификаторОбъекта;
		МенеджерЗаписи.Прочитать();
		Если НЕ МенеджерЗаписи.Выбран() Тогда
			Продолжить;
		КонецЕсли;
		МенеджерЗаписи.Статус = Статусы().Принят;
		МенеджерЗаписи.ПопытокОбработки = 0;
		МенеджерЗаписи.ТекстОшибки = "";
		МенеджерЗаписи.Записать(Истина);
		Возвращено = Возвращено + 1;
	КонецЦикла;

	Трасса("", СтрШаблон("Проход: переобработка - пакетов документов возвращено в очередь %1", Возвращено),
		Истина, , Возвращено);

	Возврат Возвращено;

КонецФункции

// Номенклатура уже записана: сбой пометки цепочек на пересверку не должен
// возвращать пакет в очередь - только строка в журнал.
//
Процедура ПометитьНаСверкуПоНоменклатуре(Объект, ИдентификаторОбъекта)

	Попытка
		ЭАрМ_СверкаТоваровЦепочки.ПометитьНаСверкуПоШтрихкодамНоменклатуры(Объект);
	Исключение
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторОбъекта, 100), ОперацияЖурнала(), Ложь,
			"Пересверка по номенклатуре: " + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Пустой текст ошибки - пакет обработан, иначе ошибка и ещё одна попытка.
//
Процедура ОтметитьОбработку(ТипОбъекта, ИдентификаторОбъекта, ТекстОшибки)

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЭАрМ_ПакетыДалион");
		ЭлементБлокировки.УстановитьЗначение("ТипОбъекта", ТипОбъекта);
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторОбъекта", ИдентификаторОбъекта);
		Блокировка.Заблокировать();

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ПакетыДалион.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ТипОбъекта = ТипОбъекта;
		МенеджерЗаписи.ИдентификаторОбъекта = ИдентификаторОбъекта;
		МенеджерЗаписи.Прочитать();

		Если НЕ МенеджерЗаписи.Выбран() Тогда
			ОтменитьТранзакцию();
			ОшибкаПроверки(ИдентификаторОбъекта, "ОтметитьОбработку",
				СтрШаблон("пакета %1 нет в ЭАрМ_ПакетыДалион - статус «%2» не записан", ТипОбъекта,
					?(ЗначениеЗаполнено(ТекстОшибки), Статусы().Ошибка, Статусы().Обработан)));
			Возврат;
		КонецЕсли;

		МенеджерЗаписи.ДатаОбработки = ТекущаяДатаСеанса();

		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			МенеджерЗаписи.Статус           = Статусы().Ошибка;
			МенеджерЗаписи.ПопытокОбработки = МенеджерЗаписи.ПопытокОбработки + 1;
			МенеджерЗаписи.ТекстОшибки      = Лев(ТекстОшибки, 500);
		Иначе
			МенеджерЗаписи.Статус           = Статусы().Обработан;
			МенеджерЗаписи.ТекстОшибки      = "";
		КонецЕсли;

		МенеджерЗаписи.Записать(Истина);
		ЗафиксироватьТранзакцию();

		Если ЭтоДокументДалиона(ТипОбъекта) ИЛИ ЗначениеЗаполнено(ТекстОшибки) Тогда
			Трасса(ИдентификаторОбъекта, СтрШаблон("Запись: ЭАрМ_ПакетыДалион %1 № %2 - статус «%3», попыток %4",
				ТипОбъекта, МенеджерЗаписи.НомерОбъекта, МенеджерЗаписи.Статус, МенеджерЗаписи.ПопытокОбработки),
				НЕ ЗначениеЗаполнено(ТекстОшибки));

			ПроверитьЗаписьРегистра(ИдентификаторОбъекта, "ЭАрМ_ПакетыДалион",
				Новый Структура("ТипОбъекта, ИдентификаторОбъекта", ТипОбъекта, ИдентификаторОбъекта),
				Новый Структура("Статус", МенеджерЗаписи.Статус));
		КонецЕсли;

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		// Трасса и проверка идут уже после фиксации: транзакции может не быть
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ЭАрМ_Служебный.ЗаписатьОшибку("ЦепочкаЗакупки",
			ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения));
		ОшибкаПроверкиИсключение(ИдентификаторОбъекта, "ОтметитьОбработку (статус пакета не записан)", ОшибкаИсключения);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пакет header.type = Контрагент: data.items[] — партнёр и контрагент УТ.
// Найденного по ИНН (и КПП) контрагента не дублирует; нет — заводит партнёра-поставщика
// и контрагента. После фиксации транзакции для новых контрагентов фоном запрашиваются
// данные ФНС (КПП, ОГРН, адрес) - типовое заполнение, как при загрузке банковской выписки.
// Договоры приходят отдельным пакетом (ЗагрузитьДоговорыВУТ).
//
Процедура ЗагрузитьКонтрагентовВУТ(Объект)

	Элементы = ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "items"));
	Если Элементы.Количество() = 0
		И ЗначениеЗаполнено(ЭАрМ_Служебный.ЗначениеУзла(Объект, "uid", "")) Тогда
		Элементы.Добавить(Объект);
	КонецЕсли;

	Созданные = Новый Массив;

	НачатьТранзакцию();
	Попытка

		Для Каждого Элемент Из Элементы Цикл
			РезультатЗаписи = ЗаписатьКонтрагентаИзДалиона(Элемент, Истина);
			Если РезультатЗаписи.Создан Тогда
				Созданные.Добавить(РезультатЗаписи);
			КонецЕсли;
		КонецЦикла;

		ЗафиксироватьТранзакцию();

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ОшибкаПроверкиИсключение("",
			"ЗагрузитьКонтрагентовВУТ (контрагенты не записаны)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

	// Поля из ФНС - только после фиксации: фоновое задание должно видеть контрагента
	Для Каждого РезультатЗаписи Из Созданные Цикл
		ЗапроситьРеквизитыКонтрагентаВФНС(РезультатЗаписи);
	КонецЦикла;

КонецПроцедуры

// Контрагент Далиона -> контрагент УТ.
//
// Параметры:
//   Элемент          - Структура, Соответствие - uid, name, fullName, inn, kpp
//   СоздаватьЕслиНет - Булево - нет в УТ: завести партнёра и контрагента
//
// Возвращаемое значение:
//   Структура - Контрагент, Создан (Булево), ИНН, ЮрФизЛицо
//
Функция ЗаписатьКонтрагентаИзДалиона(Элемент, СоздаватьЕслиНет = Истина) Экспорт

	ИНН = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "inn", "")));
	КПП = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "kpp", "")));
	Имя = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "name", "")));
	ПолноеИмя = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "fullName", "")));
	Если НЕ ЗначениеЗаполнено(ПолноеИмя) Тогда
		ПолноеИмя = Имя;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИНН) И НЕ ЗначениеЗаполнено(Имя) Тогда
		ВызватьИсключение "В контрагенте Далиона не заполнены ИНН и наименование.";
	КонецЕсли;

	ЭтоИП = СтрДлина(ИНН) = 12;
	ЮрФизЛицо = ?(ЭтоИП, Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель, Перечисления.ЮрФизЛицо.ЮрЛицо);
	Результат = Новый Структура("Контрагент, Создан, ИНН, ЮрФизЛицо",
		Справочники.Контрагенты.ПустаяСсылка(), Ложь, ИНН, ЮрФизЛицо);

	Найденный = НайтиКонтрагентаУТ(ИНН, КПП, Имя);
	Если ЗначениеЗаполнено(Найденный) Тогда

		// Пустое дозаполняем, заполненное в УТ не трогаем
		КонтрагентОбъект = Найденный.ПолучитьОбъект();
		Если НЕ ЗначениеЗаполнено(КонтрагентОбъект.КПП) И ЗначениеЗаполнено(КПП) И НЕ ЭтоИП Тогда
			КонтрагентОбъект.КПП = КПП;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(КонтрагентОбъект.НаименованиеПолное) И ЗначениеЗаполнено(ПолноеИмя) Тогда
			КонтрагентОбъект.НаименованиеПолное = ПолноеИмя;
		КонецЕсли;
		Если КонтрагентОбъект.Модифицированность() Тогда
			КонтрагентОбъект.Записать();
		КонецЕсли;

		Результат.Контрагент = Найденный;
		Возврат Результат;

	КонецЕсли;

	Если НЕ СоздаватьЕслиНет Тогда
		Возврат Результат;
	КонецЕсли;

	Комментарий = НСтр("ru = '#Создан автоматически при приёме контрагентов Далиона'");

	ПартнерОбъект = Справочники.Партнеры.СоздатьЭлемент();
	ПартнерОбъект.Поставщик = Истина;
	ПартнерОбъект.ПрочиеОтношения = Истина;
	ПартнерОбъект.ДатаРегистрации = ТекущаяДатаСеанса();
	ПартнерОбъект.Комментарий = Комментарий;
	ПартнерОбъект.Наименование = Лев(?(ЗначениеЗаполнено(Имя), Имя, ПолноеИмя), 100);
	ПартнерОбъект.НаименованиеПолное = ?(ЗначениеЗаполнено(ПолноеИмя), ПолноеИмя, Имя);
	ПартнерОбъект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
	ПартнерОбъект.Записать();

	КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
	КонтрагентОбъект.Наименование = ПартнерОбъект.Наименование;
	КонтрагентОбъект.НаименованиеПолное = ПартнерОбъект.НаименованиеПолное;
	КонтрагентОбъект.ИНН = ИНН;
	Если НЕ ЭтоИП Тогда
		КонтрагентОбъект.КПП = КПП;
	КонецЕсли;
	КонтрагентОбъект.СтранаРегистрации = Справочники.СтраныМира.Россия;
	КонтрагентОбъект.ЮрФизЛицо = ЮрФизЛицо;
	КонтрагентОбъект.Партнер = ПартнерОбъект.Ссылка;
	КонтрагентОбъект.Записать();

	Результат.Контрагент = КонтрагентОбъект.Ссылка;
	Результат.Создан = Истина;

	Возврат Результат;

КонецФункции

// Контрагент УТ по ИНН (и КПП, если он известен), без ИНН - по наименованию.
// Не найден - пустая ссылка.
//
Функция НайтиКонтрагентаУТ(ИНН, КПП, Имя)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.КПП КАК КПП
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	НЕ Контрагенты.ПометкаУдаления
	|	И (&ПоИНН И Контрагенты.ИНН = &ИНН
	|		ИЛИ НЕ &ПоИНН И Контрагенты.Наименование = &Имя)";
	Запрос.УстановитьПараметр("ПоИНН", ЗначениеЗаполнено(ИНН));
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("Имя", Имя);

	Выборка = Запрос.Выполнить().Выбрать();
	Первый = Справочники.Контрагенты.ПустаяСсылка();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(КПП) ИЛИ СокрЛП(Выборка.КПП) = КПП Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Первый) Тогда
			Первый = Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	// Тот же ИНН с другим КПП - филиал: отдельного контрагента не плодим
	Возврат Первый;

КонецФункции

// Типовое заполнение из ФНС (ЕГРЮЛ/ЕГРИП) фоновым заданием УТ. Недоступность
// сервиса или не настроенное подключение - не ошибка приёма.
//
Процедура ЗапроситьРеквизитыКонтрагентаВФНС(РезультатЗаписи) Экспорт

	Если НЕ ЗначениеЗаполнено(РезультатЗаписи.ИНН) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		КлиентБанкЛокализация.ЗапуститьЗаполнениеДанныхКонтрагента(
			РезультатЗаписи.Контрагент,
			Новый Структура("ИНН, ЮрФизЛицо", РезультатЗаписи.ИНН, РезультатЗаписи.ЮрФизЛицо),
			ТекущаяДатаСеанса());
	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("Контрагент",
			СтрШаблон("Реквизиты из ФНС не запрошены (ИНН %1): %2", РезультатЗаписи.ИНН,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

// Пакет header.type = ДоговорКонтрагента: data.items[] пишутся
// в справочник ДоговорыКонтрагентов УТ. Приходные накладные сюда не входят.
//
Процедура ЗагрузитьДоговорыВУТ(Объект)

	Элементы = ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "items"));
	Если Элементы.Количество() = 0
		И ЗначениеЗаполнено(ЭАрМ_Служебный.ЗначениеУзла(Объект, "uid", "")) Тогда
		Элементы.Добавить(Объект);
	КонецЕсли;

	// Каждый договор - своей транзакцией: в выгрузке Далиона все договоры, в том числе
	// с покупателями, и один плохой не должен откатывать порцию из сотен.
	// Повтор пакета безопасен: договор находится по метке DALION:uid
	Ошибки = Новый Массив;
	Созданные = Новый Массив;

	Для Каждого Элемент Из Элементы Цикл

		НачатьТранзакцию();
		Попытка
			Пропуск = ЗаписатьДоговорУТ(Элемент, Созданные);
			ЗафиксироватьТранзакцию();
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ОтменитьТранзакцию();
			ОшибкаПроверкиИсключение("", "ЗагрузитьДоговорыВУТ (договор не записан)", ОшибкаИсключения);
			Ошибки.Добавить(СтрШаблон("%1: %2",
				ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "name", "")),
				ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения)));
			Продолжить;
		КонецПопытки;

		Если ЗначениеЗаполнено(Пропуск) Тогда
			ЭАрМ_Служебный.ЗаписатьОшибку("Договор", Пропуск);
		КонецЕсли;

	КонецЦикла;

	// Поля из ФНС - только после фиксации: фоновое задание должно видеть контрагента
	Для Каждого РезультатЗаписи Из Созданные Цикл
		ЗапроситьРеквизитыКонтрагентаВФНС(РезультатЗаписи);
	КонецЦикла;

	ПересчитатьДатыОплатыПоДоговорам(Элементы);

	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрШаблон("Договоров с ошибкой %1 из %2: %3", Ошибки.Количество(), Элементы.Количество(),
			СтрСоединить(Ошибки, "; "));
	КонецЕсли;

КонецПроцедуры

// Пришёл договор (или его срок оплаты) - у УПД этих поставщиков дата оплаты
// считается заново: колонка «Дата оплаты» реестра УПД.
//
Процедура ПересчитатьДатыОплатыПоДоговорам(Элементы)

	ИННы = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		ИНН = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(
			ЭАрМ_Служебный.ЗначениеПоПути(Элемент, "counterparty.inn")));
		Если ЗначениеЗаполнено(ИНН) И ИННы.Найти(ИНН) = Неопределено Тогда
			ИННы.Добавить(ИНН);
		КонецЕсли;
	КонецЦикла;

	Если ИННы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Обновлено = ЭАрМ_ВыгрузкаНакладныхДляБух.ОбновитьДатыОплатыУПД(, , , ИННы);
		Трасса("", СтрШаблон("Договоры Далиона: даты оплаты УПД пересчитаны - строк %1, ИНН поставщиков: %2",
			Обновлено, СтрСоединить(ИННы, ", ")), Истина, , Обновлено);
	Исключение
		ОшибкаПроверкиИсключение("", "ПересчитатьДатыОплатыПоДоговорам (даты оплаты УПД не пересчитаны)",
			ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Договор из карточки contract заказа или прихода: нет в УТ - заводится, есть - не трогаем
// (срок оплаты и прочее уточнит отдельный пакет ДоговорКонтрагента). Контрагент и
// организация берутся из документа, если в карточке договора их нет. Ошибка договора
// документ не останавливает: дату платежа тогда не передать, это видно в очереди выгрузки.
//
Процедура СоздатьДоговорИзДокумента(Документ)

	Попытка

		Карточка = ЭАрМ_Служебный.ЗначениеУзла(Документ, "contract");
		Идентификатор = ?(Карточка = Неопределено, "",
			ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Карточка, "uid", "")));
		Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
			Возврат;
		КонецЕсли;

		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Договоры.Ссылка ИЗ Справочник.ДоговорыКонтрагентов КАК Договоры
			|ГДЕ Договоры.Комментарий ПОДОБНО &Метка");
		Запрос.УстановитьПараметр("Метка", "DALION:" + Идентификатор + "%");
		Если НЕ Запрос.Выполнить().Пустой() Тогда
			Возврат;
		КонецЕсли;

		Элемент = Новый Структура;
		Для Каждого КлючИЗначение Из Карточка Цикл
			Элемент.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		Для Каждого Поле Из СтрРазделить("counterparty,company,currency", ",") Цикл
			Если ЭАрМ_Служебный.ЗначениеУзла(Элемент, Поле) = Неопределено Тогда
				Элемент.Вставить(Поле, ЭАрМ_Служебный.ЗначениеУзла(Документ, Поле));
			КонецЕсли;
		КонецЦикла;
		// Старая выгрузка Далиона кладёт в договор владельца без ИНН - берём поставщика
		// документа: по ИНН его находит или заводит ЗаписатьКонтрагентаИзДалиона
		КонтрагентДокумента = ЭАрМ_Служебный.ЗначениеУзла(Документ, "counterparty");
		Если КонтрагентДокумента <> Неопределено
			И НЕ ЗначениеЗаполнено(ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеПоПути(Элемент, "counterparty.inn"))) Тогда
			Элемент.Вставить("counterparty", КонтрагентДокумента);
		КонецЕсли;
		// Дату документа в договор не подставляем: пустое начало действия не отсекает
		// УПД, пришедшие раньше заказа

		Созданные = Новый Массив;
		НачатьТранзакцию();
		Попытка
			Пропуск = ЗаписатьДоговорУТ(Элемент, Созданные);
			ЗафиксироватьТранзакцию();
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ОтменитьТранзакцию();
			ОшибкаПроверкиИсключение("",
				"СоздатьДоговорИзДокумента (договор не записан)", ОшибкаИсключения);
			ВызватьИсключение;
		КонецПопытки;

		Если ЗначениеЗаполнено(Пропуск) Тогда
			ЭАрМ_Служебный.ЗаписатьОшибку("Договор", Пропуск);
		КонецЕсли;
		Для Каждого РезультатЗаписи Из Созданные Цикл
			ЗапроситьРеквизитыКонтрагентаВФНС(РезультатЗаписи);
		КонецЦикла;

	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("Договор",
			СтрШаблон("Договор из документа Далиона не создан: %1", ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

// Договор Далиона -> ДоговорыКонтрагентов УТ. Вызывается в транзакции.
//
// Параметры:
//   Элемент   - Структура, Соответствие - карточка договора (uid, counterparty, company, ...)
//   Созданные - Массив - сюда добавляются заведённые контрагенты для запроса в ФНС
//
// Возвращаемое значение:
//   Строка - пусто: договор записан; иначе почему пропущен (не ошибка пакета)
//
Функция ЗаписатьДоговорУТ(Элемент, Созданные)

	Идентификатор = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "uid", ""));
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		ВызватьИсключение "В договоре Далиона не заполнен uid.";
	КонецЕсли;

	Вид = ВидДоговораУТ(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "kind", "")));
	Контрагент = КонтрагентДоговораУТ(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "counterparty"), Вид, Созданные);
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат СтрШаблон("Договор Далиона «%1» (%2) пропущен: контрагента %3 нет в УТ, договор не с поставщиком",
			ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "name", "")), Идентификатор,
			ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеПоПути(Элемент, "counterparty.name")));
	КонецЕсли;
	Партнер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Партнер");
	Если НЕ ЗначениеЗаполнено(Партнер) Тогда
		ВызватьИсключение СтрШаблон("У контрагента «%1» в УТ не заполнен партнёр.", Контрагент);
	КонецЕсли;

	Организация = ОрганизацияУТ(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "company"));
	Валюта = ВалютаУТ(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "currency"));

	Номер = Лев(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "number", "")), 128);
	ДатаДоговора = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "date", ""));
	Наименование = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "name", ""));
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Наименование = СтрШаблон("Договор %1", Номер);
	КонецЕсли;

	ДоговорОбъект = НайтиДоговорУТ(Идентификатор, Номер, Контрагент, ДатаДоговора);
	НовыйДоговор = ДоговорОбъект.ЭтоНовый();

	ДоговорОбъект.Наименование = Лев(Наименование, 150);
	ДоговорОбъект.НаименованиеДляПечати = Наименование;
	ДоговорОбъект.Номер = Номер;
	ДоговорОбъект.Дата = ДатаДоговора;

	ДатаНачала = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "startDate", ""));
	ДатаОкончания = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "endDate", ""));
	ДатаРасторжения = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "terminationDate", ""));
	// Без времени: выгрузка в Бухгалтерию сравнивает начало действия с началом дня УПД,
	// договор от 22.09 10:00 иначе не подошёл бы к УПД от 22.09
	ДоговорОбъект.ДатаНачалаДействия = НачалоДня(?(ЗначениеЗаполнено(ДатаНачала), ДатаНачала, ДатаДоговора));
	Если ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДоговорОбъект.ДатаОкончанияДействия = ДатаОкончания;
	ИначеЕсли ЗначениеЗаполнено(ДатаРасторжения) Тогда
		ДоговорОбъект.ДатаОкончанияДействия = ДатаРасторжения;
	КонецЕсли;
	ДоговорОбъект.Организация = Организация;
	ДоговорОбъект.Партнер = Партнер;
	ДоговорОбъект.Контрагент = Контрагент;
	ДоговорОбъект.ВалютаВзаиморасчетов = Валюта;
	ТекстКомментария = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "comment", ""));
	Примечание = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "note", ""));
	Если ЗначениеЗаполнено(Примечание) Тогда
		ТекстКомментария = СокрЛП(ТекстКомментария + Символы.ПС + Примечание);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаРасторжения) И ДатаРасторжения <> ДатаОкончания Тогда
		ТекстКомментария = СокрЛП(ТекстКомментария + Символы.ПС
			+ "Дата расторжения: " + Формат(ДатаРасторжения, "ДЛФ=D"));
	КонецЕсли;
	ДоговорОбъект.Комментарий = КомментарийДоговораДалион(ТекстКомментария, Идентификатор);
	ДоговорОбъект.ПометкаУдаления = ЭАрМ_Служебный.ЗначениеУзла(Элемент, "deletionMark", Ложь) = Истина;

	// Срок оплаты (дни отсрочки) - из него считается плановая дата платежа в Бухгалтерию.
	// Далион поле не прислал - заполненный в УТ срок не затираем
	ДнейОплаты = Неопределено;
	Для Каждого ИмяПоля Из СтрРазделить("paymentDays,paymentTermDays,paymentDeferral,deferralDays,paymentPeriod,defermentDays", ",") Цикл
		ЗначениеПоля = ЭАрМ_Служебный.ЗначениеУзла(Элемент, ИмяПоля, Неопределено);
		Если ЗначениеПоля <> Неопределено И ЗначениеЗаполнено(ЭАрМ_Служебный.СтрокойИлиПусто(ЗначениеПоля)) Тогда
			ДнейОплаты = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЗначениеПоля);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ДнейОплаты <> Неопределено Тогда
		ДоговорОбъект.УстановленСрокОплаты = ДнейОплаты > 0;
		ДоговорОбъект.СрокОплаты = ДнейОплаты;
	КонецЕсли;

	Если НовыйДоговор Тогда
		ДоговорОбъект.ТипДоговора = Вид.ТипДоговора;
		ДоговорОбъект.ХозяйственнаяОперация = Вид.ХозяйственнаяОперация;
		ДоговорОбъект.Статус = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
		ДоговорОбъект.Согласован = Истина;
		ДоговорОбъект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
		ДоговорОбъект.ВариантКурсаДоговора = Перечисления.ВариантыКурсаДоговора.Переменный;
		ДоговорОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
		ДоговорОбъект.ЗакупкаПодДеятельность = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	КонецЕсли;

	ДоговорОбъект.Записать();

	Возврат "";

КонецФункции

// Контрагент договора в УТ. Нет в УТ: для договора с поставщиком (и ИНН известен)
// заводится партнёр-поставщик и контрагент, как по пакету «Контрагент»; для договоров
// покупателей и комиссии поставщиков не плодим - пустая ссылка, договор пропускается.
//
Функция КонтрагентДоговораУТ(Описание, Вид, Созданные)

	ИНН = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Описание, "inn", "")));
	КПП = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Описание, "kpp", "")));
	Имя = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Описание, "name", "")));

	Если НЕ ЗначениеЗаполнено(ИНН) И НЕ ЗначениеЗаполнено(Имя) Тогда
		ВызватьИсключение "В договоре Далиона не заполнены ИНН и наименование контрагента.";
	КонецЕсли;

	Найденный = НайтиКонтрагентаУТ(ИНН, КПП, Имя);
	Если ЗначениеЗаполнено(Найденный) Тогда
		Возврат Найденный;
	КонецЕсли;

	Если Вид.ТипДоговора <> Перечисления.ТипыДоговоров.СПоставщиком Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		ВызватьИсключение СтрШаблон("Поставщика «%1» нет в УТ, а без ИНН он не заводится.", Имя);
	КонецЕсли;

	РезультатЗаписи = ЗаписатьКонтрагентаИзДалиона(Описание, Истина);
	Если РезультатЗаписи.Создан Тогда
		Созданные.Добавить(РезультатЗаписи);
	КонецЕсли;

	Возврат РезультатЗаписи.Контрагент;

КонецФункции

Функция НайтиДоговорУТ(Идентификатор, Номер, Контрагент, ДатаДоговора)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Договоры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	|ГДЕ
	|	Договоры.Комментарий ПОДОБНО &Метка";
	Запрос.УстановитьПараметр("Метка", "DALION:" + Идентификатор + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;

	// Без номера и даты под отбор попал бы любой «пустой» договор поставщика
	Если НЕ ЗначениеЗаполнено(Номер) ИЛИ НЕ ЗначениеЗаполнено(ДатаДоговора) Тогда
		Возврат Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	КонецЕсли;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Договоры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	|ГДЕ
	|	Договоры.Номер = &Номер
	|	И Договоры.Контрагент = &Контрагент
	|	И Договоры.Дата = &Дата";
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Дата", ДатаДоговора);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;

	Возврат Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();

КонецФункции

Функция КомментарийДоговораДалион(Комментарий, Идентификатор)

	Метка = "DALION:" + Идентификатор;
	Текст = СокрЛП(Комментарий);
	Если СтрНайти(Текст, Метка) > 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Если ЗначениеЗаполнено(Текст) Тогда
		Возврат Метка + " " + Текст;
	КонецЕсли;

	Возврат Метка;

КонецФункции

// Организация по ИНН фирмы Далиона, затем по наименованию; единственная - если не нашлась.
//
Функция ОрганизацияУТ(Описание)

	Имя = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Описание, "name", "")));
	ИНН = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Описание, "inn", "")));
	КПП = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Описание, "kpp", "")));

	Если ЗначениеЗаполнено(ИНН) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Организации.Ссылка КАК Ссылка,
			|	Организации.КПП КАК КПП
			|ИЗ
			|	Справочник.Организации КАК Организации
			|ГДЕ
			|	НЕ Организации.ПометкаУдаления
			|	И Организации.ИНН = &ИНН");
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Ссылки = Запрос.Выполнить().Выгрузить();
		Если Ссылки.Количество() = 1 Тогда
			Возврат Ссылки[0].Ссылка;
		КонецЕсли;
		Для Каждого СтрокаОрганизации Из Ссылки Цикл
			Если ЗначениеЗаполнено(КПП) И СокрЛП(СтрокаОрганизации.КПП) = КПП Тогда
				Возврат СтрокаОрганизации.Ссылка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|	И (&БезИмени
	|		ИЛИ Организации.Наименование = &Имя
	|		ИЛИ Организации.НаименованиеПолное = &Имя)";
	Запрос.УстановитьПараметр("БезИмени", НЕ ЗначениеЗаполнено(Имя));
	Запрос.УстановитьПараметр("Имя", Имя);

	Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если Ссылки.Количество() = 1 Тогда
		Возврат Ссылки[0];
	КонецЕсли;

	Если Ссылки.Количество() = 0 И ЗначениеЗаполнено(Имя) Тогда
		Запрос.УстановитьПараметр("БезИмени", Истина);
		Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		Если Ссылки.Количество() = 1 Тогда
			Возврат Ссылки[0];
		КонецЕсли;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("В УТ не удалось выбрать организацию «%1».", Имя);

КонецФункции

Функция ВалютаУТ(Описание)

	Код = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Описание, "code", "")));
	Имя = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Описание, "name", "")));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Валюты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|ГДЕ
	|	НЕ Валюты.ПометкаУдаления
	|	И (Валюты.Код = &Код
	|		ИЛИ Валюты.Наименование = &Имя)";
	Запрос.УстановитьПараметр("Код", Код);
	Запрос.УстановитьПараметр("Имя", Имя);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Попытка
		ВалютаУчета = Константы.ВалютаРегламентированногоУчета.Получить();
		Если ЗначениеЗаполнено(ВалютаУчета) Тогда
			Возврат ВалютаУчета;
		КонецЕсли;
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОшибкаПроверкиИсключение("",
			"ВалютаУТ (константа «Валюта регламентированного учёта» не прочитана)", ОшибкаИсключения);
		ВалютаУчета = Неопределено;
	КонецПопытки;

	ВызватьИсключение СтрШаблон("В УТ не найдена валюта «%1» %2.", Имя, Код);

КонецФункции

Функция ВидДоговораУТ(ВидДалион)

	Текст = НРег(ВидДалион);
	Вид = Новый Структура("ТипДоговора, ХозяйственнаяОперация");

	Если СтрНайти(Текст, "покупател") > 0 Тогда
		Вид.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем;
		Вид.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	ИначеЕсли СтрНайти(Текст, "комитент") > 0 Тогда
		Вид.ТипДоговора = Перечисления.ТипыДоговоров.СКомитентом;
		Вид.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПриемНаКомиссию;
	Иначе
		Вид.ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком;
		Вид.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	КонецЕсли;

	Возврат Вид;

КонецФункции

Процедура ВыполнитьШаг(Представление, ИмяПроцедуры, Настройки, Итоги)

	Попытка

		Если ИмяПроцедуры = "ПринятьПакеты" Тогда
			ПринятьПакеты(Настройки, Итоги);
		ИначеЕсли ИмяПроцедуры = "ОбработатьПакеты" Тогда
			ОбработатьПакеты(Настройки, Итоги);
		ИначеЕсли ИмяПроцедуры = "ОбновитьСвязиЭДО" Тогда
			ЭАрМ_ЦепочкаЗакупки.ОбновитьСвязиЭДО(Настройки);
		ИначеЕсли ИмяПроцедуры = "ОбработатьКорректировки" Тогда
			ЭАрМ_КорректировкиУПД.ОбработатьКорректировки();
		ИначеЕсли ИмяПроцедуры = "СверитьЦепочки" Тогда
			ЭАрМ_СверкаТоваровЦепочки.СверитьЦепочки(Настройки);
		ИначеЕсли ИмяПроцедуры = "ОтметитьЭТрНПоПриходам" Тогда
			ЭАрМ_ЦепочкаЗакупки.ОтметитьЭТрНПоПриходам();
		ИначеЕсли ИмяПроцедуры = "СобратьГотовые" Тогда
			ЭАрМ_ОбработкаПодтвержденийЭДО.СобратьГотовыеКОтправке();
		ИначеЕсли ИмяПроцедуры = "ЗапроситьПломбы" Тогда
			ЭАрМ_ЦепочкаЗакупки.ЗапроситьПломбы(Настройки);
		КонецЕсли;

		Трасса("", "Шаг «" + Представление + "» выполнен");

	Исключение
		ДобавитьОшибку(Итоги, Представление, ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		Трасса("", "Шаг «" + Представление + "» прерван: "
			+ ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()), Ложь);
	КонецПопытки;

КонецПроцедуры

Функция НовыеИтоги()

	Итоги = Новый Структура;
	Итоги.Вставить("Принято",    0);
	Итоги.Вставить("Обработано", 0);
	Итоги.Вставить("Ошибок",     0);
	Итоги.Вставить("Сообщения",  Новый Массив);

	Возврат Итоги;

КонецФункции

// Заказ или приходная с тем же номером и датой, но другим uid, уже лежит
// в регистре пакетов. Только для подробностей трассы: пакет всё равно записывается,
// дубль или замену решает цепочка (ДокументЦепочкиУжеЕсть).
//
Функция ДокументУжеЗагружен(Описание)

	Если Описание.ТипОбъекта <> "ЗаказПоставщику"
		И Описание.ТипОбъекта <> "ПриходнаяНакладная" Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Описание.НомерОбъекта)
		ИЛИ НЕ ЗначениеЗаполнено(Описание.ДатаОбъекта) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пакеты.ИдентификаторОбъекта КАК ИдентификаторОбъекта
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПакетыДалион КАК Пакеты
	|ГДЕ
	|	Пакеты.ТипОбъекта = &ТипОбъекта
	|	И Пакеты.НомерОбъекта = &НомерОбъекта
	|	И Пакеты.ДатаОбъекта МЕЖДУ &НачалоДня И &КонецДня
	|	И Пакеты.ИдентификаторОбъекта <> &ИдентификаторОбъекта";
	Запрос.УстановитьПараметр("ТипОбъекта", Описание.ТипОбъекта);
	Запрос.УстановитьПараметр("НомерОбъекта", Лев(Описание.НомерОбъекта, 50));
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(Описание.ДатаОбъекта));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(Описание.ДатаОбъекта));
	Запрос.УстановитьПараметр("ИдентификаторОбъекта", Описание.ИдентификаторОбъекта);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

Процедура ДобавитьОшибку(Итоги, Где, ТекстОшибки)

	Итоги.Ошибок = Итоги.Ошибок + 1;
	Итоги.Сообщения.Добавить(Лев(СтрШаблон("%1: %2", Где, ТекстОшибки), 300));

КонецПроцедуры

Функция ХешТекста(Текст)

	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеширование.Добавить(Текст);

	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

// Заказ, приходная, возврат и корректировка поставщика - документы Далиона (версионируются
// по uid, путь трассируется); справочники и ответы нет.
//
Функция ЭтоДокументДалиона(ТипОбъекта)

	Возврат ТипОбъекта = "ЗаказПоставщику" ИЛИ ТипОбъекта = "ПриходнаяНакладная"
		ИЛИ ТипОбъекта = "ВозвратПоставщику" ИЛИ ТипОбъекта = "КорректировкаПоставщика";

КонецФункции

Функция ЭтоИсходящийФайлУТ(ИмяФайла)

	Имя = НРег(СокрЛП(ИмяФайла));

	Возврат СтрНачинаетсяС(Имя, "dalion_servicerequest_")
		ИЛИ СтрНачинаетсяС(Имя, "dalion_datarequest_");

КонецФункции

#КонецОбласти
