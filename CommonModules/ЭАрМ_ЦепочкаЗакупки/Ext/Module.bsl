Функция ПоставкиЗаказа(ИдентификаторЗаказа)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторЗаказа = &ИдентификаторЗаказа";
	Запрос.УстановитьПараметр("ИдентификаторЗаказа", ИдентификаторЗаказа);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИдентификаторПоступления");

КонецФункции

// Запись цепочки, в которой лежит поступление, со всеми ресурсами.
//
Функция ЗаписьПоступления(ИдентификаторПоступления)

	Если НЕ ЗначениеЗаполнено(ИдентификаторПоступления) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления = &ИдентификаторПоступления";
	Запрос.УстановитьПараметр("ИдентификаторПоступления", ИдентификаторПоступления);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЗаписьЦепочки(Выборка.ИдентификаторЗаказа, ИдентификаторПоступления);

КонецФункции

Функция ЗаписьЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления)

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_ЦепочкаЗакупки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторЗаказа = ИдентификаторЗаказа;
	МенеджерЗаписи.ИдентификаторПоступления = ИдентификаторПоступления;
	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Для Каждого Поле Из Метаданные.РегистрыСведений.ЭАрМ_ЦепочкаЗакупки.Измерения Цикл
		Результат.Вставить(Поле.Имя, МенеджерЗаписи[Поле.Имя]);
	КонецЦикла;
	Для Каждого Поле Из Метаданные.РегистрыСведений.ЭАрМ_ЦепочкаЗакупки.Ресурсы Цикл
		Результат.Вставить(Поле.Имя, МенеджерЗаписи[Поле.Имя]);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращаемое значение:
//   Структура - Номер, Дата, ИНН, КлючиСвязи
//
Функция РеквизитыУПД(ИдентификаторУПД)

	Результат = Новый Структура("Номер, Дата, ИНН, КлючиСвязи", "", '00010101', "", "");

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат Результат;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторУПД;
	МенеджерЗаписи.Прочитать();

	Если МенеджерЗаписи.Выбран() Тогда
		Результат.Номер      = МенеджерЗаписи.Номер;
		Результат.Дата       = МенеджерЗаписи.Дата;
		Результат.ИНН        = СокрЛП(МенеджерЗаписи.ИННКонтрагента);
		Результат.КлючиСвязи = МенеджерЗаписи.КлючиСвязи;
	КонецЕсли;

	Возврат Результат;

КонецФункции

