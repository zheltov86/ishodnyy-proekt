Функция КлючиТовара(Наименование, Штрихкоды)

	Ключи = Новый Структура("Наименование, Штрихкоды",
		СокрЛП(Строка(Наименование)), Новый Соответствие);

	Для Каждого Штрихкод Из Штрихкоды Цикл
		Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого КлючЗначение Из ЭАрМ_СверкаТоваровЦепочки.КлючиШтрихкода(Штрихкод) Цикл
			Ключи.Штрихкоды.Вставить(КлючЗначение.Ключ, Истина);
		КонецЦикла;
	КонецЦикла;

	Возврат Ключи;

КонецФункции

// Доля товаров, общих для двух документов, от большего из них. Общий товар -
// общий штрихкод или совпавшее наименование (точное либо по основам слов).
//
Функция ДоляОбщихТоваров(ТоварыА, ТоварыБ)

	Наибольшее = Макс(ТоварыА.Количество(), ТоварыБ.Количество());
	Если Наибольшее = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Занятые = Новый Соответствие;
	Общих = 0;

	Для Каждого ТоварА Из ТоварыА Цикл
		Для Индекс = 0 По ТоварыБ.ВГраница() Цикл

			Если Занятые.Получить(Индекс) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ТоварБ = ТоварыБ[Индекс];
			Совпадение = ЭАрМ_СверкаТоваровЦепочки.НаименованияСовпадают(
				ТоварА.Наименование, ТоварБ.Наименование);

			Если НЕ Совпадение Тогда
				Для Каждого КлючЗначение Из ТоварА.Штрихкоды Цикл
					Если ТоварБ.Штрихкоды.Получить(КлючЗначение.Ключ) <> Неопределено Тогда
						Совпадение = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;

			Если Совпадение Тогда
				Занятые.Вставить(Индекс, Истина);
				Общих = Общих + 1;
				Прервать;
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	Возврат Общих / Наибольшее;

КонецФункции

// Полное совпадение только по штрихкодам: каждая строка одного документа
// должна найти пару в другом. Наименования не считаются.
//
Функция ДоляОбщихШтрихкодов(ТоварыА, ТоварыБ)

	Наибольшее = Макс(ТоварыА.Количество(), ТоварыБ.Количество());
	Если Наибольшее = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Занятые = Новый Соответствие;
	Общих = 0;

	Для Каждого ТоварА Из ТоварыА Цикл

		Если ТоварА.Штрихкоды.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Для Индекс = 0 По ТоварыБ.ВГраница() Цикл

			Если Занятые.Получить(Индекс) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ТоварБ = ТоварыБ[Индекс];
			Если ТоварБ.Штрихкоды.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;

			Для Каждого КлючЗначение Из ТоварА.Штрихкоды Цикл
				Если ТоварБ.Штрихкоды.Получить(КлючЗначение.Ключ) <> Неопределено Тогда
					Занятые.Вставить(Индекс, Истина);
					Общих = Общих + 1;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Если Занятые.Получить(Индекс) <> Неопределено Тогда
				Прервать;
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Возврат Общих / Наибольшее;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пустой ИНН с любой стороны не опровергает связь: у части документов СБИС
// ИНН в реестр не попадает.
//
Функция ИННСовпадает(ИНН1, ИНН2)

	Цифры1 = ЦифрыИНН(ИНН1);
	Цифры2 = ЦифрыИНН(ИНН2);

	Если НЕ ЗначениеЗаполнено(Цифры1) ИЛИ НЕ ЗначениеЗаполнено(Цифры2) Тогда
		Возврат Истина;
	КонецЕсли;

	Если СтрДлина(Цифры1) >= 12 И СтрДлина(Цифры2) >= 12 Тогда
		Возврат Лев(Цифры1, 12) = Лев(Цифры2, 12);
	КонецЕсли;

	Если (СтрДлина(Цифры1) = 12 И СтрДлина(Цифры2) = 10)
		ИЛИ (СтрДлина(Цифры1) = 10 И СтрДлина(Цифры2) = 12) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрДлина(Цифры1) >= 10 И СтрДлина(Цифры2) >= 10 Тогда
		Возврат Лев(Цифры1, 10) = Лев(Цифры2, 10);
	КонецЕсли;

	Возврат Цифры1 = Цифры2;

КонецФункции

Функция ЦифрыИНН(ИНН)

	Текст = СокрЛП(Строка(ИНН));
	Результат = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НомераДокументаДляСвязи(Объект, ВключаяНомерДокумента = Истина)

	Имена = "incomingNumber,edoIncomingNumber,invoiceNumber";
	Если ВключаяНомерДокумента Тогда
		Имена = Имена + ",number";
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого ИмяНомера Из СтрРазделить(Имена, ",") Цикл
		Номер = ЗначениеСтрокой(Объект, ИмяНомера);
		Если ЗначениеЗаполнено(Номер) И Результат.Найти(Номер) = Неопределено Тогда
			Результат.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВходящийНомерИзОбъекта(Объект)

	Для Каждого ИмяНомера Из СтрРазделить("incomingNumber,edoIncomingNumber,invoiceNumber", ",") Цикл
		Номер = ЗначениеСтрокой(Объект, ИмяНомера);
		Если ЗначениеЗаполнено(Номер) Тогда
			Возврат Номер;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Помечено ли поступление на удаление - по последнему пакету Далиона.
//
Функция ПоступлениеУдаленоВДалионе(ИдентификаторПоступления)

	Объект = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ПриходнаяНакладная", ИдентификаторПоступления);

	Возврат Объект <> Неопределено
		И ЭАрМ_Служебный.ЗначениеУзла(Объект, "deletionMark", Ложь) = Истина;

КонецФункции

// Отпускает УПД и ЭТрН поступления, помеченного в Далионе на удаление: связи
// в цепочке снимаются, УПД теряет «Расхождений нет», «К отправке» и ручную
// отметку «Сверилось», ЭТрН - «Можно утвердить». Подписанное не трогается.
// ЗаменаНа - uid более новой приходной с тем же номером и датой, если старая
// не удалена, а заменяется (ЗаменитьУстаревшиеПриходные).
//
Процедура ОтпуститьУдаленноеПоступление(ИдентификаторЗаказа, ИдентификаторПоступления, НомерПоступления,
	ЗаменаНа = "")

	Запись = ЗаписьЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления);
	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторУПД  = СокрЛП(Запись.ИдентификаторУПД);
	ИдентификаторЭТрН = СокрЛП(Запись.ИдентификаторЭТрН);
	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) И НЕ ЗначениеЗаполнено(ИдентификаторЭТрН) Тогда
		Возврат;
	КонецЕсли;

	Изменения = Новый Структура;
	Изменения.Вставить("ИдентификаторУПД",  "");
	Изменения.Вставить("НомерУПД",          "");
	Изменения.Вставить("ДатаУПД",           Дата(1, 1, 1));
	Изменения.Вставить("СпособСвязиУПД",    "");
	Изменения.Вставить("ИдентификаторЭТрН", "");
	Изменения.Вставить("НомерЭТрН",         "");
	Изменения.Вставить("СпособСвязиЭТрН",   "");
	ИзменитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Изменения, Ложь);

	Если ЗначениеЗаполнено(ЗаменаНа) Тогда
		Текст = СтрШаблон(НСтр("ru = 'Приходная Далиона %1 заменена более новой с тем же номером и датой. Документ пересверяется с новой.'"),
			СокрЛП(НомерПоступления));
	Иначе
		Текст = СтрШаблон(НСтр("ru = 'Приходная Далиона %1 помечена на удаление. Документ ждёт приходную, которую заведут взамен.'"),
			СокрЛП(НомерПоступления));
	КонецЕсли;

	Если ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		ЭАрМ_КорректировкиУПД.ИзменитьСтрокуРеестра("ЭАрМ_УПД_Входящий", ИдентификаторУПД,
			Новый Структура("РасхожденийНет, КОтправке, СвереноВручную, СвереноВручнуюКем, ТекстСверки",
				Ложь, Ложь, Ложь, "", Лев(Текст, 1024)));
		ЭАрМ_РегламентныйОбменЭДО.ОбновитьСводкуУПД(ИдентификаторУПД);
	КонецЕсли;

	Если ЗначениеЗаполнено(ИдентификаторЭТрН) Тогда
		СнятьГотовностьЭТрН(ИдентификаторЭТрН);
	КонецЕсли;

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторПоступления, 100), ОперацияОтвязки(), Истина,
		СтрШаблон(?(ЗначениеЗаполнено(ЗаменаНа),
			НСтр("ru = 'Поступление %1 заменено более новым: отпущены УПД «%2» и ЭТрН «%3», они переходят к новой приходной'"),
			НСтр("ru = 'Поступление %1 помечено в Далионе на удаление: отпущены УПД «%2» и ЭТрН «%3», они ждут приходную взамен'")),
			СокрЛП(НомерПоступления), СокрЛП(Запись.НомерУПД), СокрЛП(Запись.НомерЭТрН)));

КонецПроцедуры

// ЭТрН без приходной утверждать нельзя: снимает «Можно утвердить», «К отправке»
// и статус «Готов к отправке». Подписанную и утверждённую не трогает.
//
Процедура СнятьГотовностьЭТрН(ИдентификаторЭТрН)

	НачатьТранзакцию();
	Попытка

		ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра(
			"РегистрСведений.ЭАрМ_РеестрЭТрН", ИдентификаторЭТрН);

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_РеестрЭТрН.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторЭТрН;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран()
			И НЕ МенеджерЗаписи.Подписано
			И НЕ МенеджерЗаписи.Утверждено Тогда

			МенеджерЗаписи.МожноУтвердить = Ложь;
			МенеджерЗаписи.КОтправке = Ложь;
			Если МенеджерЗаписи.СтатусПодписания = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ГотовКОтправке Тогда
				МенеджерЗаписи.СтатусПодписания = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ПустаяСсылка();
			КонецЕсли;
			МенеджерЗаписи.Записать(Истина);

		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторЭТрН,
			"СнятьГотовностьЭТрН (реестр ЭТрН не записан)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Принимает поступления, которые раньше были отброшены как дубль этого -
// тот же номер и дата, другой uid. Теперь прежнее помечено на удаление, и
// документ, заведённый взамен, должен встать в цепочку. Отброшенные
// документы - это пакеты поступлений без записи цепочки.
//
Процедура ПринятьОтложенныеЗаменыПоступления(Номер, ДатаДокумента, ИдентификаторУдаленного, Настройки)

	Если НЕ ЗначениеЗаполнено(Номер) ИЛИ НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пакеты.ИдентификаторОбъекта КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПакетыДалион КАК Пакеты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ПО Цепочка.ИдентификаторПоступления = Пакеты.ИдентификаторОбъекта
	|ГДЕ
	|	Пакеты.ТипОбъекта = ""ПриходнаяНакладная""
	|	И Пакеты.ИдентификаторОбъекта <> &ИдентификаторУдаленного
	|	И Цепочка.ИдентификаторПоступления ЕСТЬ NULL";
	Запрос.УстановитьПараметр("ИдентификаторУдаленного", ИдентификаторУдаленного);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Объект = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ПриходнаяНакладная", Выборка.Идентификатор);
		Если Объект = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ДатаДвойника = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "date", ""));
		Если Лев(ЗначениеСтрокой(Объект, "number"), 50) <> Номер
			ИЛИ НачалоДня(ДатаДвойника) <> НачалоДня(ДатаДокумента) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ОбновитьПоПоступлению(Объект, Настройки);
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Выборка.Идентификатор, 100),
				ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(), Истина, СтрШаблон(
				НСтр("ru = 'Поступление %1 от %2 принято взамен помеченного на удаление'"),
				Номер, Формат(ДатаДокумента, "ДЛФ=D")));
		Исключение
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Выборка.Идентификатор, 100),
				ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(), Ложь, СтрШаблон(
				НСтр("ru = 'Поступление %1 взамен удалённого не принято: %2'"),
				Номер, ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Кнопка «Сверить все УПД с приходными» реестра УПД (идёт фоновым заданием).
//
// Готовит и пересверяет все УПД периода с приходными Далиона:
//   1. проход приёма, как «Прочитать папку»: новые пакеты из папки разбираются;
//   2. приходные с одинаковым номером и датой под разными uid: в цепочке
//      остаётся самая новая, старая заменяется (ЗаменитьУстаревшиеПриходные);
//   3. связи с ЭДО и корректировки, затем сверка всех открытых цепочек периода
//      заново - и уже сверенных;
//   4. ЭТрН по приходам, очередь «Готов к отправке» и сводка реестра.
// Подписанные УПД (цепочка «Закрыто») не трогаются.
//
// Параметры:
//   ДатаС, ДатаПо - Дата - период реестра УПД; пустые - без ограничения
//
// Возвращаемое значение:
//   Строка - итог для пользователя
//
Функция СверитьВсеУПДСПриходными(Знач ДатаС = Неопределено, Знач ДатаПо = Неопределено) Экспорт

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	ДатаС  = ?(ЗначениеЗаполнено(ДатаС), НачалоДня(ДатаС), '00010101');
	ДатаПо = ?(ЗначениеЗаполнено(ДатаПо), КонецДня(ДатаПо), '00010101');

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Сверка всех УПД с приходными, период %1 - %2'"),
		?(ЗначениеЗаполнено(ДатаС), Формат(ДатаС, "ДЛФ=D"), НСтр("ru = 'любой'")),
		?(ЗначениеЗаполнено(ДатаПо), Формат(ДатаПо, "ДЛФ=D"), НСтр("ru = 'любой'"))));
	Ошибок = 0;

	// 1. Папка: приходные, которые ещё лежат в папке, должны успеть в замену и сверку
	Попытка
		ИтогПрохода = ЭАрМ_ПриемПакетовДалион.ВыполнитьВручную();
		Позиция = СтрНайти(ИтогПрохода, "--- Трасса");
		Если Позиция > 0 Тогда
			ИтогПрохода = СокрП(Лев(ИтогПрохода, Позиция - 1));
		КонецЕсли;
		Строки.Добавить(ИтогПрохода);
	Исключение
		Ошибок = Ошибок + 1;
		Строки.Добавить(НСтр("ru = 'Приём из папки не выполнен: '")
			+ ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

	// 2. Устаревшие приходные с тем же номером и датой
	Замены = ЗаменитьУстаревшиеПриходные(ДатаС, ДатаПо, Настройки);
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Приходных с одинаковым номером и датой: групп %1, заменено старых %2'"),
		Замены.Групп, Замены.Заменено));
	Для Каждого Сообщение Из Замены.Сообщения Цикл
		Строки.Добавить("  " + Сообщение);
	КонецЦикла;

	// 3. Связи и корректировки - до сверки: сверка берёт УПД и УКД из цепочки
	Попытка
		ОбновитьСвязиЭДО(Настройки);
	Исключение
		Ошибок = Ошибок + 1;
		Строки.Добавить(НСтр("ru = 'Связи с ЭДО: '") + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;
	Попытка
		ЭАрМ_КорректировкиУПД.ОбработатьКорректировки();
	Исключение
		Ошибок = Ошибок + 1;
		Строки.Добавить(НСтр("ru = 'Корректировки УПД: '") + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

	Сверено = 0;
	ОшибокСверки = 0;
	Для Каждого Цепочка Из ЦепочкиДляСверкиВсех(ДатаС, ДатаПо) Цикл
		Попытка
			ЭАрМ_СверкаТоваровЦепочки.СверитьЦепочку(Цепочка.ИдентификаторЗаказа,
				Цепочка.ИдентификаторПоступления, Настройки);
			Сверено = Сверено + 1;
		Исключение
			ОшибокСверки = ОшибокСверки + 1;
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Цепочка.ИдентификаторПоступления, 100),
				ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(), Ложь,
				"Сверка всех УПД: " + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Цепочек пересверено: %1, с ошибкой сверки: %2 (см. журнал обмена)'"),
		Сверено, ОшибокСверки));
	Ошибок = Ошибок + ОшибокСверки;

	// 4. Подготовка: ЭТрН по приходам, очередь к отправке, сводка реестра
	Попытка
		ОтметитьЭТрНПоПриходам();
		ЭАрМ_ОбработкаПодтвержденийЭДО.СобратьГотовыеКОтправке();
		ЭАрМ_РегламентныйОбменЭДО.ОбновитьСводкуРеестраУПД(Неопределено, ДатаС, ДатаПо);
		Строки.Добавить(НСтр("ru = 'ЭТрН по приходам отмечены, готовые УПД собраны в очередь отправки, сводка реестра обновлена'"));
	Исключение
		Ошибок = Ошибок + 1;
		Строки.Добавить(НСтр("ru = 'Подготовка к отправке: '") + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

	Итог = СтрСоединить(Строки, Символы.ПС);
	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(), Ошибок = 0,
		Лев(Итог, 950));

	Возврат Итог;

КонецФункции

// Открытые цепочки периода с приходной: с УПД - по дате УПД, без УПД - по
// дате поступления.
//
Функция ЦепочкиДляСверкиВсех(ДатаС, ДатаПо)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО Цепочка.ИдентификаторУПД = УПД.ИдентификаторСБИС
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления <> """"
	|	И Цепочка.Этап <> ""Закрыто""
	|	И (Цепочка.ИдентификаторУПД <> """"
	|				И (&НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ ЕСТЬNULL(УПД.Дата, ДАТАВРЕМЯ(1, 1, 1)) >= &НачалоПериода)
	|				И (&КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ ЕСТЬNULL(УПД.Дата, ДАТАВРЕМЯ(3999, 12, 31)) <= &КонецПериода)
	|			ИЛИ Цепочка.ИдентификаторУПД = """"
	|				И (&НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ Цепочка.ДатаПоступления >= &НачалоПериода)
	|				И (&КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ Цепочка.ДатаПоступления <= &КонецПериода))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Цепочка.ДатаПоступления";
	Запрос.УстановитьПараметр("НачалоПериода", ДатаС);
	Запрос.УстановитьПараметр("КонецПериода", ДатаПо);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Приходные Далиона с одинаковым номером и датой под разными uid: Далион
// пересоздал документ, а в цепочке осталась старая. Самая новая - не
// помеченная на удаление, с самым поздним data.modifiedAt (нет его - время
// пакета, затем время приёма). Старая, стоящая в цепочке, отпускает УПД и
// ЭТрН, её цепочка и документ «Приходная накладная» снимаются, новая
// обрабатывается заново и забирает УПД старой (ручную связь - вручную).
// Раньше замена шла только после пометки старой на удаление в Далионе.
// Цепочки с подписанной УПД («Закрыто») не трогаются.
//
// Параметры:
//   ДатаС, ДатаПо - Дата - период; пустые - без ограничения. Окно расширяется
//                   на неделю: приходная бывает раньше или позже даты УПД
//
// Возвращаемое значение:
//   Структура - Групп (Число), Заменено (Число), Сообщения (Массив из Строка)
//
Функция ЗаменитьУстаревшиеПриходные(ДатаС, ДатаПо, Настройки) Экспорт

	Результат = Новый Структура("Групп, Заменено, Сообщения", 0, 0, Новый Массив);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пакеты.НомерОбъекта КАК НомерОбъекта,
	|	НАЧАЛОПЕРИОДА(Пакеты.ДатаОбъекта, ДЕНЬ) КАК День
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПакетыДалион КАК Пакеты
	|ГДЕ
	|	Пакеты.ТипОбъекта = ""ПриходнаяНакладная""
	|	И Пакеты.НомерОбъекта <> """"
	|	И (&НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ Пакеты.ДатаОбъекта >= &НачалоПериода)
	|	И (&КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ Пакеты.ДатаОбъекта <= &КонецПериода)
	|
	|СГРУППИРОВАТЬ ПО
	|	Пакеты.НомерОбъекта,
	|	НАЧАЛОПЕРИОДА(Пакеты.ДатаОбъекта, ДЕНЬ)
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Пакеты.ИдентификаторОбъекта) > 1";
	Неделя = 7 * 86400;
	Запрос.УстановитьПараметр("НачалоПериода", ?(ЗначениеЗаполнено(ДатаС), ДатаС - Неделя, '00010101'));
	Запрос.УстановитьПараметр("КонецПериода", ?(ЗначениеЗаполнено(ДатаПо), ДатаПо + Неделя, '00010101'));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Результат.Групп = Результат.Групп + 1;

		Попытка
			//@skip-check query-in-loop
			Сообщение = ЗаменитьПриходнуюГруппы(Выборка.НомерОбъекта, Выборка.День, Настройки);
			Если ЗначениеЗаполнено(Сообщение) Тогда
				Результат.Заменено = Результат.Заменено + 1;
				Результат.Сообщения.Добавить(Сообщение);
			КонецЕсли;
		Исключение
			ТекстОшибки = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
			Результат.Сообщения.Добавить(СтрШаблон(НСтр("ru = 'приходная %1 от %2: замена не выполнена - %3'"),
				Выборка.НомерОбъекта, Формат(Выборка.День, "ДЛФ=D"), ТекстОшибки));
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", ОперацияОтвязки(), Ложь, СтрШаблон(
				НСтр("ru = 'Замена приходной %1 от %2 более новой не выполнена: %3'"),
				Выборка.НомерОбъекта, Формат(Выборка.День, "ДЛФ=D"), ТекстОшибки));
		КонецПопытки;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Одна группа приходных с одним номером и датой: см. ЗаменитьУстаревшиеПриходные.
//
// Возвращаемое значение:
//   Строка - что сделано; пусто - заменять нечего
//
Функция ЗаменитьПриходнуюГруппы(Номер, День, Настройки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пакеты.ИдентификаторОбъекта КАК Идентификатор,
	|	Пакеты.ДанныеПакета КАК ДанныеПакета,
	|	Пакеты.ДатаСозданияПакета КАК ДатаСозданияПакета,
	|	Пакеты.ДатаПриема КАК ДатаПриема
	|ИЗ
	|	РегистрСведений.ЭАрМ_ПакетыДалион КАК Пакеты
	|ГДЕ
	|	Пакеты.ТипОбъекта = ""ПриходнаяНакладная""
	|	И Пакеты.НомерОбъекта = &Номер
	|	И Пакеты.ДатаОбъекта МЕЖДУ &НачалоДня И &КонецДня";
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(День));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(День));

	Новейшая = Неопределено;
	Кандидаты = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Объект = ЭАрМ_Служебный.ЗначениеУзла(ЭАрМ_Служебный.ПрочитатьОтветJSON(Выборка.ДанныеПакета), "data");
		Если Объект = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Изменена = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "modifiedAt", ""));
		Если НЕ ЗначениеЗаполнено(Изменена) Тогда
			Изменена = Выборка.ДатаСозданияПакета;
		КонецЕсли;

		Кандидат = Новый Структура("Идентификатор, Объект, Удалена, Изменена, ДатаПриема",
			Выборка.Идентификатор, Объект,
			ЭАрМ_Служебный.ЗначениеУзла(Объект, "deletionMark", Ложь) = Истина,
			Изменена, Выборка.ДатаПриема);
		Кандидаты.Добавить(Кандидат);

		Если Кандидат.Удалена Тогда
			Продолжить;
		КонецЕсли;
		Если Новейшая = Неопределено
			ИЛИ Кандидат.Изменена > Новейшая.Изменена
			ИЛИ Кандидат.Изменена = Новейшая.Изменена И Кандидат.ДатаПриема > Новейшая.ДатаПриема Тогда
			Новейшая = Кандидат;
		КонецЕсли;

	КонецЦикла;

	Если Новейшая = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	// Старые, которые держат место в цепочке. Помеченные на удаление уже
	// отпущены (ОтпуститьУдаленноеПоступление) и новой не мешают
	Старые = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Идентификатор = Новейшая.Идентификатор ИЛИ Кандидат.Удалена Тогда
			Продолжить;
		КонецЕсли;
		Запись = ЗаписьПоступления(Кандидат.Идентификатор);
		Если Запись <> Неопределено Тогда
			Старые.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	Если Старые.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого Запись Из Старые Цикл
		Если Запись.Этап = "Закрыто" Тогда
			Возврат СтрШаблон(НСтр("ru = 'приходная %1 от %2: в цепочке старая (uid %3) с подписанной УПД «%4» - не заменяю, при необходимости свяжите вручную'"),
				Номер, Формат(День, "ДЛФ=D"), Запись.ИдентификаторПоступления, СокрЛП(Запись.НомерУПД));
		КонецЕсли;
	КонецЦикла;

	// УПД старой переходит к новой: ручная связь остаётся ручной
	ИдентификаторУПД = "";
	СвязьВручную = Ложь;
	НомераУПД = Новый Массив;

	Для Каждого Запись Из Старые Цикл

		Если ЗначениеЗаполнено(Запись.ИдентификаторУПД) И НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
			ИдентификаторУПД = СокрЛП(Запись.ИдентификаторУПД);
			СвязьВручную = Запись.СпособСвязиУПД = "Вручную";
		КонецЕсли;
		Если ЗначениеЗаполнено(Запись.НомерУПД) Тогда
			НомераУПД.Добавить(СокрЛП(Запись.НомерУПД));
		КонецЕсли;

		ОтпуститьУдаленноеПоступление(Запись.ИдентификаторЗаказа, Запись.ИдентификаторПоступления,
			Номер, Новейшая.Идентификатор);
		УдалитьЦепочку(Запись.ИдентификаторЗаказа, Запись.ИдентификаторПоступления);
		ПометитьПриходнуюЗамененной(Запись.ИдентификаторПоступления);

		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Запись.ИдентификаторПоступления, 100), ОперацияОтвязки(), Истина,
			СтрШаблон(НСтр("ru = 'Приходная %1 от %2 (uid %3) заменена более новой с тем же номером и датой (uid %4): цепочка снята, документ помечен на удаление'"),
				Номер, Формат(День, "ДЛФ=D"), Запись.ИдентификаторПоступления, Новейшая.Идентификатор));

	КонецЦикла;

	// Новая - заново через обработку пакета: договор, цепочка, связь с УПД,
	// документ «Приходная накладная», статус пакета
	Итоги = Новый Структура("Принято, Обработано, Ошибок, Сообщения", 0, 0, 0, Новый Массив);
	ЭАрМ_ПриемПакетовДалион.ОбработатьПакетОбъекта("ПриходнаяНакладная", Новейшая.Идентификатор, Настройки, Итоги);
	Если Итоги.Ошибок > 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'приходная %1 от %2: старая снята, новая (uid %3) не обработана - %4'"),
			Номер, Формат(День, "ДЛФ=D"), Новейшая.Идентификатор, СтрСоединить(Итоги.Сообщения, "; "));
	КонецЕсли;

	Новая = ЗаписьПоступления(Новейшая.Идентификатор);
	Если Новая <> Неопределено И ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Если НЕ ЗначениеЗаполнено(Новая.ИдентификаторУПД) Тогда
			Если СвязьВручную Тогда
				СвязатьВручную(Новая.ИдентификаторЗаказа, Новая.ИдентификаторПоступления, ИдентификаторУПД);
			Иначе
				СвязатьНайденнуюПоНомеру(Новая.ИдентификаторЗаказа, Новая.ИдентификаторПоступления, ИдентификаторУПД);
			КонецЕсли;
		ИначеЕсли СвязьВручную И СокрЛП(Новая.ИдентификаторУПД) <> ИдентификаторУПД Тогда
			СвязатьВручную(Новая.ИдентификаторЗаказа, Новая.ИдентификаторПоступления, ИдентификаторУПД);
		КонецЕсли;
		Новая = ЗаписьПоступления(Новейшая.Идентификатор);
	КонецЕсли;

	Если Новая = Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'приходная %1 от %2: старая снята, новая (uid %3) в цепочку не встала - см. журнал обмена'"),
			Номер, Формат(День, "ДЛФ=D"), Новейшая.Идентификатор);
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'приходная %1 от %2: старая заменена новой (uid %3), УПД «%4»'"),
		Номер, Формат(День, "ДЛФ=D"), Новейшая.Идентификатор,
		?(ЗначениеЗаполнено(Новая.НомерУПД), СокрЛП(Новая.НомерУПД),
			?(НомераУПД.Количество() > 0, СтрСоединить(НомераУПД, ", ") + НСтр("ru = ' - связь не перенесена'"),
				НСтр("ru = 'ещё не найдена'"))));

КонецФункции

// Документ «Приходная накладная» старой приходной, заменённой новой, - на
// удаление: в списках расширения остаётся одна приходная с этим номером.
//
Процедура ПометитьПриходнуюЗамененной(ИдентификаторПоступления)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Приходная.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЭАрМ_ПриходнаяНакладная КАК Приходная
	|ГДЕ
	|	Приходная.ИдентификаторДалион = &Идентификатор
	|	И НЕ Приходная.ПометкаУдаления";
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторПоступления);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокументОбъект.УстановитьПометкуУдаления(Истина);
		Исключение
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторПоступления, 100), ОперацияОтвязки(), Ложь,
				НСтр("ru = 'Документ заменённой приходной не помечен на удаление: '")
					+ ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция ДокументЦепочкиУжеЕсть(Вид, Номер, ДатаДокумента, Идентификатор)

	Если НЕ ЗначениеЗаполнено(Номер) ИЛИ НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;

	Если Вид = "Заказ" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Цепочка.ИдентификаторЗаказа КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
		|ГДЕ
		|	Цепочка.НомерЗаказа = &Номер
		|	И Цепочка.ДатаЗаказа МЕЖДУ &НачалоДня И &КонецДня
		|	И Цепочка.ИдентификаторЗаказа <> &Идентификатор";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Цепочка.ИдентификаторПоступления КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
		|ГДЕ
		|	Цепочка.НомерПоступления = &Номер
		|	И Цепочка.ДатаПоступления МЕЖДУ &НачалоДня И &КонецДня
		|	И Цепочка.ИдентификаторПоступления <> &Идентификатор
		|	И Цепочка.ИдентификаторПоступления <> """"";
	КонецЕсли;

	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ДатаДокумента));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ДатаДокумента));
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Если Вид = "Заказ" Тогда
		Возврат НЕ Запрос.Выполнить().Пустой();
	КонецЕсли;

	// Поступление с тем же номером и датой, помеченное в Далионе на удаление,
	// дублем не считается: новый документ его заменяет
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ПоступлениеУдаленоВДалионе(Выборка.Идентификатор) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЗначениеВМассиве(Значение)

	Результат = Новый Массив;
	Результат.Добавить(Значение);

	Возврат Результат;

КонецФункции

Функция ЗначениеСтрокой(Узел, ИмяСвойства)

	Значение = ЭАрМ_Служебный.ЗначениеУзла(Узел, ИмяСвойства, "");

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;

	Возврат СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(Значение));

КонецФункции

#КонецОбласти
