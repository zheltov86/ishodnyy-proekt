// Поставщик из пакета: блок counterparty, запасной путь - владелец договора.
//
// Возвращаемое значение:
//   Структура - Наименование, ИНН, Идентификатор
//
Функция ДанныеПоставщика(Объект)

	Контрагент = ЭАрМ_Служебный.ЗначениеУзла(Объект, "counterparty");
	Если Контрагент = Неопределено Тогда
		Контрагент = ЭАрМ_Служебный.ЗначениеПоПути(Объект, "contract.counterparty");
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Наименование",  ЗначениеСтрокой(Контрагент, "name"));
	Результат.Вставить("ИНН",           ЗначениеСтрокой(Контрагент, "inn"));
	Результат.Вставить("Идентификатор", ЗначениеСтрокой(Контрагент, "uid"));

	Возврат Результат;

