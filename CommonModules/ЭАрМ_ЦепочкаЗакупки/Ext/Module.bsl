////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_ЦепочкаЗакупки: цепочка "заказ поставщику - поступление - УПД - ЭТрН".
//
// Одна запись регистра ЭАрМ_ЦепочкаЗакупки - одна поставка по заказу:
//   ИдентификаторЗаказа      - uid заказа Далиона; "ПН:<uid>", если поступление
//                              пришло без заказа и связь ещё не найдена;
//   ИдентификаторПоступления - uid поступления Далиона; пусто, пока поставки нет.
// По заказу может быть несколько поставок - несколько записей.
//
// Связи и откуда они берутся (СпособСвязи...):
//   заказ - поступление : "Основание" (basis.purchaseOrder), "Товары" (ИНН, окно
//                         дат, доля общих товаров);
//   поступление - УПД   : "Номер" (входящий номер), "Штрихкод" (полное
//                         совпадение всех строк по штрихкодам, GTIN-13/14
//                         и UPC-A считаются одним кодом);
//   поступление - ЭТрН  : "Номер", "Приход" (ИНН и окно дат, независимо от товаров),
//                         либо через УПД;
//   УПД - ЭТрН          : существующая ЭАрМ_РегламентныйОбменЭДО.НайтиЭТрНДляУПД;
//   любая               : "Вручную" - автоматика её не перезаписывает.
//
// Этапы: ЗаказПолучен -> ПоступлениеПолучено -> УПДНайдена -> Сверено /
// ЕстьРасхождения -> ПломбаЗапрошена -> Закрыто.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обновляет цепочки по пакету заказа поставщику.
//
// Параметры:
//   Объект    - Соответствие - секция data пакета ЗаказПоставщику
//   Настройки - Структура - см. ЭАрМ_НастройкиСервер.НастройкиЦепочки
//
Процедура ОбновитьПоЗаказу(Объект, Настройки) Экспорт

	ИдентификаторЗаказа = ЗначениеСтрокой(Объект, "uid");
	Если НЕ ЗначениеЗаполнено(ИдентификаторЗаказа) Тогда
		ВызватьИсключение "В заказе не заполнен uid";
	КонецЕсли;

	Поставщик = ДанныеПоставщика(Объект);

	НомерЗаказа = Лев(ЗначениеСтрокой(Объект, "number"), 50);
	ДатаЗаказа  = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "date", ""));
	Если ДокументЦепочкиУжеЕсть("Заказ", НомерЗаказа, ДатаЗаказа, ИдентификаторЗаказа) Тогда
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторЗаказа, СтрШаблон(
			"Цепочка: СТОП - заказ %1 от %2 уже есть в цепочке под другим uid, пакет не принят в цепочку",
			НомерЗаказа, Формат(ДатаЗаказа, "ДЛФ=D")), Ложь);
		Возврат;
	КонецЕсли;

	Изменения = Новый Структура;
	Изменения.Вставить("НомерЗаказа",             НомерЗаказа);
	Изменения.Вставить("ДатаЗаказа",              ДатаЗаказа);
	Изменения.Вставить("ДатаПоставкиПлан",        ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "deliveryDate", "")));
	Изменения.Вставить("СуммаЗаказа",             ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "amount", 0)));
	Изменения.Вставить("Поставщик",               Лев(Поставщик.Наименование, 200));
	Изменения.Вставить("ИННПоставщика",           Лев(Поставщик.ИНН, 12));
	Изменения.Вставить("ИдентификаторПоставщика", Лев(Поставщик.Идентификатор, 36));

	Поставки = ПоставкиЗаказа(ИдентификаторЗаказа);
	Если Поставки.Количество() = 0 Тогда
		Поставки.Добавить("");
	КонецЕсли;

	Для Каждого ИдентификаторПоступления Из Поставки Цикл
		ИзменитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Изменения, Истина);
	КонецЦикла;

	// Документ - раньше штрихкодов (как в ОбновитьПоПоступлению)
	ЭАрМ_ДокументыЗакупки.ЗаписатьЗаказ(Объект);

	Попытка
		ЭАрМ_СверкаТоваровЦепочки.ЗагрузитьШтрихкодыИзСтрок(ЭАрМ_Служебный.ЗначениеУзла(Объект, "goods"),
			Поставщик.ИНН, Поставщик.Наименование, "ЗаказДалион");
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторЗаказа,
			"ОбновитьПоЗаказу (штрихкоды строк записаны не все - документ и цепочка записаны, приём продолжен)",
			ИнформацияОбОшибке());
	КонецПопытки;

	// Заказ без поставок сверкой не проходит - его товары кладём в реестр сразу.
	// Поставки заказа пересверятся сами: у них сменилась ДатаОбновления.
	Если Поставки.Найти("") <> Неопределено Тогда
		ЭАрМ_РеестрТоваровЗаказов.ОтразитьЦепочку(ИдентификаторЗаказа, "", , Настройки);
	КонецЕсли;

КонецПроцедуры

// Обновляет цепочку по пакету поступления.
//
// Параметры:
//   Объект    - Соответствие - секция data пакета ПриходнаяНакладная
//   Настройки - Структура
//
Процедура ОбновитьПоПоступлению(Объект, Настройки) Экспорт

	ИдентификаторПоступления = ЗначениеСтрокой(Объект, "uid");
	Если НЕ ЗначениеЗаполнено(ИдентификаторПоступления) Тогда
		ВызватьИсключение "В поступлении не заполнен uid";
	КонецЕсли;

	Поставщик = ДанныеПоставщика(Объект);
	ТекущаяЗапись = ЗаписьПоступления(ИдентификаторПоступления);

	НомерПоступления = Лев(ЗначениеСтрокой(Объект, "number"), 50);
	ДатаПоступления  = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "date", ""));

	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
		"Цепочка: поступление %1 от %2, поставщик «%3» ИНН %4, входящий номер «%5», товаров %6, в цепочке %7",
		НомерПоступления, Формат(ДатаПоступления, "ДЛФ=D"), Поставщик.Наименование, Поставщик.ИНН,
		ВходящийНомерИзОбъекта(Объект),
		ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "goods")).Количество(),
		?(ТекущаяЗапись = Неопределено, "ещё нет", "уже есть")));

	// Полная карточка приходной - в журнал обмена (операция «Приходная»)
	ЭАрМ_ПриемПакетовДалион.ЗаписатьКарточкуПриходной(Объект);

	Если ТекущаяЗапись = Неопределено
		И ДокументЦепочкиУжеЕсть("Поступление", НомерПоступления, ДатаПоступления, ИдентификаторПоступления) Тогда
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления,
			"Цепочка: СТОП - такое же поступление уже есть под другим uid, пакет не принят в цепочку", Ложь);
		// Такое же действующее поступление уже есть под другим uid - это дубль.
		// Раньше он отбрасывался молча, и замена приходной выглядела как
		// «не пришла». Пометят прежнее на удаление - этот документ примется сам
		// (ПринятьОтложенныеЗаменыПоступления)
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторПоступления, 100),
			ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(), Ложь, СтрШаблон(
			НСтр("ru = 'Поступление %1 от %2 не принято: такое же уже есть в цепочке под другим идентификатором Далиона и не помечено на удаление. Если это замена - пометьте прежнее на удаление в Далионе, и новое примется само'"),
			НомерПоступления, Формат(ДатаПоступления, "ДЛФ=D")));
		Возврат;
	КонецЕсли;

	// Ключ заказа: ручная связь сильнее основания, основание сильнее всего остального
	ИдентификаторЗаказа = ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеПоПути(Объект, "basis.purchaseOrder.uid", ""));
	СпособСвязиЗаказа = ?(ЗначениеЗаполнено(ИдентификаторЗаказа), "Основание", "");

	Если ТекущаяЗапись <> Неопределено
		И (ТекущаяЗапись.СпособСвязиЗаказа = "Вручную" ИЛИ НЕ ЗначениеЗаполнено(ИдентификаторЗаказа)) Тогда
		ИдентификаторЗаказа = ТекущаяЗапись.ИдентификаторЗаказа;
		СпособСвязиЗаказа = ТекущаяЗапись.СпособСвязиЗаказа;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИдентификаторЗаказа) Тогда
		ИдентификаторЗаказа = "ПН:" + ИдентификаторПоступления;
	КонецЕсли;

	// Основание в поступлении поменяли - поставка переезжает к другому заказу
	Если ТекущаяЗапись <> Неопределено И ТекущаяЗапись.ИдентификаторЗаказа <> ИдентификаторЗаказа Тогда
		УдалитьЦепочку(ТекущаяЗапись.ИдентификаторЗаказа, ИдентификаторПоступления);
		ТекущаяЗапись = Неопределено;
	КонецЕсли;

	// Заготовка "заказ без поставок" больше не нужна
	УдалитьЦепочку(ИдентификаторЗаказа, "");

	Удален    = ЭАрМ_Служебный.ЗначениеУзла(Объект, "deletionMark", Ложь) = Истина;
	Проведено = ЭАрМ_Служебный.ЗначениеУзла(Объект, "posted", Ложь) = Истина И НЕ Удален;

	Изменения = Новый Структура;
	Изменения.Вставить("НомерПоступления",     НомерПоступления);
	Изменения.Вставить("ДатаПоступления",      ДатаПоступления);
	Изменения.Вставить("ВходящийНомер",        Лев(ВходящийНомерИзОбъекта(Объект), 50));
	Изменения.Вставить("ПроведеноПоступление", Проведено);
	Изменения.Вставить("СуммаПоступления",     ЭАрМ_ПравкиЦен.СуммаСПравками(ИдентификаторПоступления,
		ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "amount", 0))));
	Изменения.Вставить("СпособСвязиЗаказа",    СпособСвязиЗаказа);

	// Поставщик заказа главнее: поступление могли оформить на другого контрагента
	Если ТекущаяЗапись = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекущаяЗапись.ИННПоставщика) Тогда
		Изменения.Вставить("Поставщик",               Лев(Поставщик.Наименование, 200));
		Изменения.Вставить("ИННПоставщика",           Лев(Поставщик.ИНН, 12));
		Изменения.Вставить("ИдентификаторПоставщика", Лев(Поставщик.Идентификатор, 36));
	КонецЕсли;

	// Новая версия поступления - пломба, если ещё не стоит, запрашивается заново
	Если ТекущаяЗапись = Неопределено ИЛИ ТекущаяЗапись.СтатусПломбы <> "Установлена" Тогда
		Изменения.Вставить("СтатусПломбы", "");
		Изменения.Вставить("ИдентификаторЗапросаПломбы", "");
	КонецЕсли;

	ИзменитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Изменения, Истина);

	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
		"Цепочка: запись ЭАрМ_ЦепочкаЗакупки записана (заказ %1, связь заказа «%2», проведено %3, удалено %4)",
		ИдентификаторЗаказа, СпособСвязиЗаказа, Проведено, Удален));

	// Помеченное на удаление в Далионе поступление больше не приходная для УПД
	// и ЭТрН. Раньше оно оставалось привязанным: УПД сверялась и утверждалась
	// по удалённому документу, а приходная, заведённая взамен, к ней уже не
	// привязывалась. Теперь документы отпускаются, а замена с тем же номером
	// и датой, отброшенная раньше как дубль, принимается сразу
	Если Удален Тогда
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления,
			"Цепочка: поступление помечено на удаление в Далионе - УПД и ЭТрН отпущены, связь не ищется", Ложь);
		ОтпуститьУдаленноеПоступление(ИдентификаторЗаказа, ИдентификаторПоступления, НомерПоступления);
		ЭАрМ_ДокументыЗакупки.ЗаписатьПоступление(Объект);
		ПринятьОтложенныеЗаменыПоступления(НомерПоступления, ДатаПоступления,
			ИдентификаторПоступления, Настройки);
		Возврат;
	КонецЕсли;

	Если ТекущаяЗапись = Неопределено ИЛИ ТекущаяЗапись.СпособСвязиУПД <> "Вручную" Тогда
		СвязатьСЭДО(ИдентификаторЗаказа, ИдентификаторПоступления, Объект, Настройки);
	Иначе
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления,
			"Цепочка: связь с УПД ручная - автоматический поиск пропущен");
	КонецЕсли;

	// Документ - раньше штрихкодов: сбой записи штрихкода или карточки Далиона
	// раньше обрывал пакет до документа, и приходная в расширении не появлялась
	ЭАрМ_ДокументыЗакупки.ЗаписатьПоступление(Объект);

	// Штрихкоды - справочные данные для сверки: их сбой пишется в лог, но
	// приходную не останавливает (каждая строка уже залогирована внутри)
	Попытка
		ЭАрМ_СверкаТоваровЦепочки.ЗагрузитьШтрихкодыИзСтрок(ЭАрМ_Служебный.ЗначениеУзла(Объект, "goods"),
			Поставщик.ИНН, Поставщик.Наименование, "ПоступлениеДалион");
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, "Цепочка: штрихкоды строк записаны в ЭАрМ_ШтрихкодыПоставщиков");
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторПоступления,
			"ОбновитьПоПоступлению (штрихкоды строк записаны не все - документ и цепочка записаны, приём продолжен)",
			ИнформацияОбОшибке());
	КонецПопытки;

	Итоговая = ЗаписьЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления);
	Если Итоговая <> Неопределено Тогда
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
			"Цепочка: итог приёма - этап «%1», УПД %2 (связь «%3»), ЭТрН %4 (связь «%5»)",
			Итоговая.Этап, ?(ЗначениеЗаполнено(Итоговая.ИдентификаторУПД), Итоговая.НомерУПД + " / " + Итоговая.ИдентификаторУПД, "НЕ НАЙДЕНА"),
			Итоговая.СпособСвязиУПД, ?(ЗначениеЗаполнено(Итоговая.ИдентификаторЭТрН), Итоговая.НомерЭТрН, "нет"),
			Итоговая.СпособСвязиЭТрН), ЗначениеЗаполнено(Итоговая.ИдентификаторУПД));
	КонецЕсли;

КонецПроцедуры

// Дотягивает связи, которых не было в момент приёма: УПД и ЭТрН приходят из
// СБИС в своём ритме, заказ может прийти позже поступления.
//
Процедура ОбновитьСвязиЭДО(Настройки) Экспорт

	// Сначала освобождаем цепочки от аннулированных документов: ниже на этом же
	// проходе они найдут документы, присланные взамен
	ОтвязатьЗакрытыеДокументы();

	// В выборке первыми идут цепочки без УПД: цепочки с УПД, но без ЭТрН остаются
	// в ней всегда (ЭТрН есть не у каждого поставщика) и при сортировке только по
	// дате обновления вытесняли из 200 мест цепочки, которым УПД ещё только искать

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 200
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Цепочка.ИдентификаторУПД КАК ИдентификаторУПД,
	|	Цепочка.СпособСвязиУПД КАК СпособСвязиУПД,
	|	Цепочка.ИдентификаторЭТрН КАК ИдентификаторЭТрН
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления <> """"
	|	И Цепочка.Этап <> ""Закрыто""
	|	И (Цепочка.ИдентификаторУПД = """"
	|			ИЛИ &СЭТрН
	|				И Цепочка.ИдентификаторЭТрН = """"
	|			ИЛИ ПОДСТРОКА(Цепочка.ИдентификаторЗаказа, 1, 3) = ""ПН:"")
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА Цепочка.ИдентификаторУПД = """"
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ,
	|	Цепочка.ДатаОбновления УБЫВ";
	// Без ЭТрН в цепочке не перебираем каждый проход сотни цепочек «без ЭТрН»
	Запрос.УстановитьПараметр("СЭТрН", ЭТрНВЦепочке());

	Выборка = Запрос.Выполнить().Выбрать();
	ЭАрМ_ПриемПакетовДалион.Трасса("", СтрШаблон("Связи с ЭДО: цепочек без УПД или ЭТрН в очереди %1", Выборка.Количество()),
		Истина, , Выборка.Количество());

	Пока Выборка.Следующий() Цикл

		Попытка

			ИдентификаторЗаказа = Выборка.ИдентификаторЗаказа;

			//@skip-check query-in-loop
			Объект = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ПриходнаяНакладная", Выборка.ИдентификаторПоступления);
			Если Объект = Неопределено Тогда
				ЭАрМ_ПриемПакетовДалион.Трасса(Выборка.ИдентификаторПоступления,
					"Связи с ЭДО: пакета поступления нет в регистре пакетов - связь не ищется", Ложь);
				Продолжить;
			КонецЕсли;

			Если СтрНачинаетсяС(ИдентификаторЗаказа, "ПН:") Тогда
				ИдентификаторЗаказа = ПривязатьКЗаказуПоТоварам(ИдентификаторЗаказа,
					Выборка.ИдентификаторПоступления, Объект, Настройки);
			КонецЕсли;

			Если Выборка.СпособСвязиУПД = "Вручную" Тогда
				Если НЕ ЗначениеЗаполнено(Выборка.ИдентификаторЭТрН) Тогда
					СвязатьЭТрН(ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, Выборка.ИдентификаторУПД);
					СвязатьЭТрНПоПриходу(ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, Объект, Настройки);
				КонецЕсли;
				ОтразитьПоступлениеВРеестрах(ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, Объект);
			ИначеЕсли НЕ ЗначениеЗаполнено(Выборка.ИдентификаторУПД) Тогда
				СвязатьСЭДО(ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, Объект, Настройки);
			Иначе
				Если НЕ ЗначениеЗаполнено(Выборка.ИдентификаторЭТрН) Тогда
					СвязатьЭТрН(ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, Выборка.ИдентификаторУПД);
					СвязатьЭТрНПоПриходу(ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, Объект, Настройки);
				КонецЕсли;
				ОтразитьПоступлениеВРеестрах(ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, Объект);
			КонецЕсли;

		Исключение
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Выборка.ИдентификаторПоступления, 100),
				ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(), Ложь,
				"Связи: " + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	ОтразитьЦепочкиБезЗаписиВРеестре();

	// Поставщик аннулировал УПД и прислал новую - тянем её, не дожидаясь, пока
	// она попадёт в реестр за последние дни
	Попытка
		ПодтянутьЗаменыАннулированных(Настройки);
	Исключение
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(), Ложь,
			"Замены аннулированных УПД: " + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

	// Замена пришла под другим номером: ищем её от аннулированной УПД по товарам
	Попытка
		СвязатьЗаменыАннулированныхУПД(Настройки);
	Исключение
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(), Ложь,
			"Замены аннулированных УПД по товарам: " + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

	// Правки цен живут отдельно от пакета: сумма приходной в цепочке должна их
	// включать, в том числе у правок, сделанных до этого пересчёта
	Попытка
		ПересчитатьСуммуПоступления();
	Исключение
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(), Ложь,
			"Сумма с правками цен: " + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Ищет в СБИС новую УПД взамен аннулированной для цепочек, которые её ждут.
//
// Цепочка отпустила закрытую УПД (ОтпуститьЗакрытыеУПД) и хранит её в
// ИдентификаторУПДАннулированной. Поставщик присылает новую с тем же номером. Если её
// нет в реестре УПД - ищем в СБИС по номеру (закрытые документы поиск пропускает),
// загружаем и обновляем связи. Не чаще раза в час и не больше 20 номеров за раз:
// каждый поиск - до двух запросов к СБИС.
//
// Возвращаемое значение:
//   Структура - Проверено, Загружено (Число); Пропущено - Булево (не пришло время)
//
Функция ПодтянутьЗаменыАннулированных(Настройки, Максимум = 20) Экспорт

	Итог = Новый Структура("Проверено, Загружено, Пропущено", 0, 0, Ложь);

	// Не чаще раза в час
	ДатаПроверки = ЭАрМ_НастройкиСервер.ЗначениеНастройки("СБИС_ЗаменыПроверка");
	Если ТипЗнч(ДатаПроверки) = Тип("Строка") И СтрДлина(ДатаПроверки) = 14 Тогда
		Попытка
			Прошлая = Дата(ДатаПроверки);
			Если ТекущаяДатаСеанса() - Прошлая < 3600 Тогда
				Итог.Пропущено = Истина;
				Возврат Итог;
			КонецЕсли;
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"ПодтянутьЗаменыАннулированных (дата прошлой проверки в настройках не дата - проверка выполняется)", ОшибкаИсключения);
		КонецПопытки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 200
	|	УПД.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО Цепочка.ИдентификаторУПДАннулированной = УПД.ИдентификаторСБИС
	|ГДЕ
	|	Цепочка.ИдентификаторУПДАннулированной <> """"
	|	И Цепочка.ИдентификаторУПД = """"
	|	И Цепочка.ИдентификаторПоступления <> """"
	|	И Цепочка.Этап <> ""Закрыто""
	|	И УПД.Номер <> """"";
	Номера = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номер");

	ЭАрМ_НастройкиСервер.СохранитьВсеНастройки(Новый Структура("СБИС_ЗаменыПроверка",
		Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss")));

	Если Номера.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;

	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Возврат Итог;
	КонецЕсли;

	Для Каждого Номер Из Номера Цикл

		Если Итог.Проверено >= Максимум Тогда
			Прервать;
		КонецЕсли;

		// Новая УПД уже в реестре - связь доделает ОбновитьСвязиЭДО
		Если УПДПоГибкомуНомеру(Номер).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;

		Итог.Проверено = Итог.Проверено + 1;
		Найденная = ЭАрМ_ОбщийМодульОбмен.НайтиУПДПоНомеру(Номер, Сессия);
		Если ЗначениеЗаполнено(Найденная.Сессия) Тогда
			Сессия = Найденная.Сессия;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Найденная.Идентификатор) ИЛИ Найденная.ДокументРеестра = Неопределено
			ИЛИ Найденная.Реестр <> "Входящие" Тогда
			Продолжить;
		КонецЕсли;

		ЭАрМ_РегламентныйОбменЭДО.ЗагрузитьДокументРеестраУПД(Найденная.ДокументРеестра, Найденная.Реестр);
		Итог.Загружено = Итог.Загружено + 1;
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Найденная.Идентификатор, 100), "ЗаменаУПД", Истина,
			СтрШаблон("Взамен аннулированной найдена УПД № %1 от %2", Найденная.Номер, Найденная.Дата));

	КонецЦикла;

	Возврат Итог;

КонецФункции

// Ищет замену аннулированной УПД под ДРУГИМ номером - от самой аннулированной УПД.
//
// ПодтянутьЗаменыАннулированных и обычная связь ищут по номеру: в приходной
// Далиона стоит номер аннулированной УПД, и замена под новым номером по нему
// не находится. Здесь кандидаты берутся из реестра УПД, без запросов в СБИС:
//   * тот же поставщик (ИНН аннулированной УПД, иначе цепочки);
//   * создана не раньше аннулированной (ДатаВремяСБИС), дата документа не раньше
//     её даты минус окно связи;
//   * не УКД, не закрыта в СБИС, не занята другой приходной.
// Товары сравниваются только по штрихкоду (ДоляОбщихШтрихкодов): все строки
// кандидата и аннулированной УПД нашли пару друг в друге, либо все строки
// кандидата и приходной Далиона. Сходство названий не считается.
// Связь ставится, только если подходит ровно один кандидат; несколько - не
// связываем (их покажет «Почему нет УПД», связать можно вручную).
// Цепочки с ручной связью не трогаются. ЗамененаНа у аннулированной, перевод ЭТрН
// и УКД на новую УПД - на следующем проходе ОтметитьЗаменуУПД, как при обычной связи.
//
// Возвращаемое значение:
//   Структура - Цепочек, Связано, Неоднозначно (Число)
//
Функция СвязатьЗаменыАннулированныхУПД(Настройки) Экспорт

	Итог = Новый Структура("Цепочек, Связано, Неоднозначно", 0, 0, 0);
	Окно = Настройки.ОкноДнейСвязи * 86400;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 50
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Цепочка.ИдентификаторУПДАннулированной КАК Старая,
	|	Цепочка.ИННПоставщика КАК ИННЦепочки,
	|	СтараяУПД.ИННКонтрагента КАК ИННСтарой,
	|	СтараяУПД.Дата КАК ДатаСтарой,
	|	СтараяУПД.ДатаВремяСБИС КАК СозданаСтарая,
	|	СтараяУПД.Номер КАК НомерСтарой
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК СтараяУПД
	|		ПО Цепочка.ИдентификаторУПДАннулированной = СтараяУПД.ИдентификаторСБИС
	|ГДЕ
	|	Цепочка.ИдентификаторУПДАннулированной <> """"
	|	И Цепочка.ИдентификаторУПД = """"
	|	И Цепочка.ИдентификаторПоступления <> """"
	|	И Цепочка.СпособСвязиУПД <> ""Вручную""
	|	И Цепочка.Этап <> ""Закрыто""
	|
	|УПОРЯДОЧИТЬ ПО
	|	Цепочка.ДатаОбновления УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Итог.Цепочек = Итог.Цепочек + 1;

		Попытка

			ИНН = ?(ЗначениеЗаполнено(Выборка.ИННСтарой), СокрЛП(Выборка.ИННСтарой), СокрЛП(Выборка.ИННЦепочки));
			Если НЕ ЗначениеЗаполнено(ИНН) Тогда
				// Без поставщика по товарам легко взять чужую УПД
				Продолжить;
			КонецЕсли;

			//@skip-check query-in-loop
			Кандидаты = КандидатыЗаменыУПД(Выборка, ИНН, Окно);
			Если Кандидаты.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;

			//@skip-check query-in-loop
			ТоварыДокументов = ТоварыУПДПоШтрихкодам(Кандидаты, СокрЛП(Выборка.Старая));
			ТоварыСтарой = ТоварыДокументов.Получить(СокрЛП(Выборка.Старая));
			ТоварыПрихода = Неопределено;

			Подходящие = Новый Массив;
			Для Каждого Кандидат Из Кандидаты Цикл

				ТоварыКандидата = ТоварыДокументов.Получить(Кандидат);
				Если ТоварыКандидата = Неопределено Тогда
					Продолжить;
				КонецЕсли;

				Подходит = ТоварыСтарой <> Неопределено
					И ДоляОбщихШтрихкодов(ТоварыСтарой, ТоварыКандидата) = 1;

				// Поставщик исправил строки - сравниваем с самой приходной
				Если НЕ Подходит Тогда
					Если ТоварыПрихода = Неопределено Тогда
						//@skip-check query-in-loop
						Объект = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ПриходнаяНакладная",
							Выборка.ИдентификаторПоступления);
						ТоварыПрихода = ?(Объект = Неопределено, Новый Массив, КлючиТоваровДалиона(Объект));
					КонецЕсли;
					Подходит = ДоляОбщихШтрихкодов(ТоварыПрихода, ТоварыКандидата) = 1;
				КонецЕсли;

				Если Подходит Тогда
					Подходящие.Добавить(Кандидат);
				КонецЕсли;

			КонецЦикла;

			Если Подходящие.Количество() > 1 Тогда
				Итог.Неоднозначно = Итог.Неоднозначно + 1;
				Продолжить;
			ИначеЕсли Подходящие.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;

			Новая = Подходящие[0];
			Реквизиты = РеквизитыУПД(Новая);

			Изменения = Новый Структура;
			Изменения.Вставить("ИдентификаторУПД", Лев(Новая, 100));
			Изменения.Вставить("НомерУПД",         Лев(Реквизиты.Номер, 50));
			Изменения.Вставить("ДатаУПД",          Реквизиты.Дата);
			Изменения.Вставить("СпособСвязиУПД",   "Замена");
			ИзменитьЦепочку(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, Изменения, Ложь);

			ОтразитьПоступлениеВРеестрах(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления);
			Итог.Связано = Итог.Связано + 1;

			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Новая, 100), ОперацияОтвязки(), Истина,
				СтрШаблон(НСтр("ru = 'Взамен аннулированной УПД № %1 привязана УПД № %2 от %3 (другой номер, совпали строки по штрихкоду)'"),
					СокрЛП(Выборка.НомерСтарой), СокрЛП(Реквизиты.Номер), Формат(Реквизиты.Дата, "ДЛФ=D")));

		Исключение
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Выборка.ИдентификаторПоступления, 100),
				ОперацияОтвязки(), Ложь,
				"Замена аннулированной УПД: " + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Возврат Итог;

КонецФункции

// УПД реестра - возможная замена аннулированной: тот же поставщик, создана не
// раньше, не УКД, не закрыта и не занята другой приходной.
//
// Возвращаемое значение:
//   Массив из Строка - идентификаторы СБИС
//
Функция КандидатыЗаменыУПД(ДанныеСтарой, ИНН, Окно)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК Идентификатор,
	|	УПД.ИННКонтрагента КАК ИНН
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Занятые
	|		ПО УПД.ИдентификаторСБИС = Занятые.ИдентификаторУПД
	|			И Занятые.ИдентификаторПоступления <> """"
	|ГДЕ
	|	УПД.ИдентификаторСБИС <> &Старая
	|	И УПД.Формат <> ""УКД""
	|	И УПД.Дата >= &ДатаС
	|	И (&СозданаСтарая = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ УПД.ДатаВремяСБИС = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ УПД.ДатаВремяСБИС >= &СозданаСтарая)
	|	И Занятые.ИдентификаторУПД ЕСТЬ NULL
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УПД");
	Запрос.УстановитьПараметр("Старая", ДанныеСтарой.Старая);
	Запрос.УстановитьПараметр("ДатаС", НачалоДня(ДанныеСтарой.ДатаСтарой) - Окно);
	Запрос.УстановитьПараметр("СозданаСтарая", ДанныеСтарой.СозданаСтарая);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Пустой ИНН у кандидата не прощаем: замену ищем строго у того же поставщика
		Если ЗначениеЗаполнено(Выборка.ИНН) И ИННСовпадает(Выборка.ИНН, ИНН) Тогда
			Результат.Добавить(СокрЛП(Выборка.Идентификатор));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строки УПД (ЭАрМ_ТоварыЭТрН, источник «УПД») для сравнения по штрихкодам.
//
// Возвращаемое значение:
//   Соответствие - идентификатор УПД -> Массив из Структура (см. КлючиТовара)
//
Функция ТоварыУПДПоШтрихкодам(Кандидаты, Старая)

	Идентификаторы = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Идентификаторы.Добавить(Кандидат);
	КонецЦикла;
	Идентификаторы.Добавить(Старая);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Товары.Наименование КАК Наименование,
	|	Товары.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС В (&Идентификаторы)
	|	И Товары.ИсточникТоваров = ""УПД""";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = СокрЛП(Выборка.ИдентификаторСБИС);
		Строки = Результат.Получить(Ключ);
		Если Строки = Неопределено Тогда
			Строки = Новый Массив;
			Результат.Вставить(Ключ, Строки);
		КонецЕсли;
		Строки.Добавить(КлючиТовара(Выборка.Наименование, ЗначениеВМассиве(Выборка.Штрихкод)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Пересчитывает сумму поступления в цепочке с учётом правок цен
// (ЭАрМ_ПравкиЦен) и обновляет сводку реестра УПД.
//
// Нужна после исправления цены: правка живёт отдельно от пакета Далиона, а сумма
// приходной в реестре УПД берётся из цепочки. Без пересчёта она оставалась
// суммой пакета.
//
// Параметры:
//   ИдентификаторПоступления - Строка - одно поступление (в том числе после снятия последней
//                              правки, когда сумма возвращается к пакетной); пусто: все,
//                              у которых есть правки
//
// Возвращаемое значение:
//   Число - сколько записей цепочки обновлено
//
Функция ПересчитатьСуммуПоступления(ИдентификаторПоступления = "") Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Цепочка.ИдентификаторУПД КАК ИдентификаторУПД,
	|	Цепочка.СуммаПоступления КАК СуммаПоступления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления <> """"
	|	И (НЕ &Все
	|				И Цепочка.ИдентификаторПоступления = &ИдентификаторПоступления
	|			ИЛИ &Все
	|				И Цепочка.ИдентификаторПоступления В (
	|					ВЫБРАТЬ
	|						Правки.ИдентификаторПоступления
	|					ИЗ
	|						РегистрСведений.ЭАрМ_ПравкиЦенПриходов КАК Правки))";
	Запрос.УстановитьПараметр("Все", НЕ ЗначениеЗаполнено(ИдентификаторПоступления));
	Запрос.УстановитьПараметр("ИдентификаторПоступления", Лев(ИдентификаторПоступления, 40));

	Обновлено = 0;
	СуммыПакетов = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Ключ = СокрЛП(Выборка.ИдентификаторПоступления);
		Если СуммыПакетов.Получить(Ключ) = Неопределено Тогда
			Объект = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ПриходнаяНакладная", Выборка.ИдентификаторПоступления);
			Если Объект = Неопределено Тогда
				СуммыПакетов.Вставить(Ключ, -1);
			Иначе
				СуммаПакета = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "amount", 0));
				СуммыПакетов.Вставить(Ключ, ЭАрМ_ПравкиЦен.СуммаСПравками(Выборка.ИдентификаторПоступления, СуммаПакета));
			КонецЕсли;
		КонецЕсли;

		НоваяСумма = СуммыПакетов.Получить(Ключ);
		Если НоваяСумма = -1 ИЛИ Окр(Выборка.СуммаПоступления, 2) = Окр(НоваяСумма, 2) Тогда
			Продолжить;
		КонецЕсли;

		// Дату обновления не двигаем: пересверку цепочки это не должно запускать
		ИзменитьЦепочку(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления,
			Новый Структура("СуммаПоступления", НоваяСумма), Ложь, Ложь);
		Обновлено = Обновлено + 1;

		Если ЗначениеЗаполнено(Выборка.ИдентификаторУПД) Тогда
			ЭАрМ_РегламентныйОбменЭДО.ОбновитьСводкуУПД(Выборка.ИдентификаторУПД);
		КонецЕсли;

	КонецЦикла;

	Возврат Обновлено;

КонецФункции

// Запрашивает в СБИС УПД для приходных Далиона, у которых в цепочке её нет.
//
// Регламентный обмен читает реестр УПД только за последние дни, поэтому УПД
// старше окна в регистр не попадает, и цепочка остаётся без неё. Здесь УПД
// ищется адресно: по входящему номеру приходной, в окне поиска по номеру
// (ЭАрМ_НастройкиСервер.ГлубинаПоискаДней), без выгрузки всего реестра.
// Найденная УПД пишется в реестр вместе с товарами, затем связи цепочек
// обновляются обычным ОбновитьСвязиЭДО.
//
// Параметры:
//   ДатаС, ДатаПо - Дата - период по дате поступления; пусто - без границы
//   Настройки     - Структура - см. ЭАрМ_НастройкиСервер.НастройкиЦепочки
//   Максимум      - Число - сколько разных номеров искать за один вызов:
//                   каждый поиск - до двух запросов в СБИС
//
// Возвращаемое значение:
//   Структура:
//     * Отобрано    - Число - цепочек без УПД в периоде
//     * БезНомера   - Число - цепочек без входящего номера, искать нечем
//     * УжеВРеестре - Число - номеров, УПД которых уже в реестре (связь доделает
//                     ОбновитьСвязиЭДО)
//     * Загружено   - Число - УПД, загруженных из СБИС
//     * НеНайдено   - Число - номеров, которых в СБИС не нашлось
//     * Осталось    - Число - номеров, не вошедших в Максимум
//     * Ошибка      - Строка - причина, если поиск не начат
//     * Сообщения   - Массив из Строка - номера, которые не нашлись или не проверены
//     * Сбоев       - Число - номеров, по которым запрос к СБИС не удался (сессия,
//                     сеть); это не «не найдено», их стоит проверить повторным запуском
//
Функция ДозапроситьУПДДляПриходов(ДатаС, ДатаПо, Настройки, Максимум = 100) Экспорт

	Итог = Новый Структура("Отобрано, БезНомера, УжеВРеестре, Загружено, НеНайдено, Осталось, Ошибка, Сообщения, Сбоев",
		0, 0, 0, 0, 0, 0, "", Новый Массив, 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Цепочка.НомерПоступления КАК НомерПоступления,
	|	Цепочка.ВходящийНомер КАК ВходящийНомер
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления <> """"
	|	И Цепочка.ИдентификаторУПД = """"
	|	И Цепочка.СпособСвязиУПД <> ""Вручную""
	|	И Цепочка.Этап <> ""Закрыто""
	|	И (&БезНачала ИЛИ Цепочка.ДатаПоступления >= &ДатаС)
	|	И (&БезКонца ИЛИ Цепочка.ДатаПоступления <= &ДатаПо)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Цепочка.ДатаПоступления УБЫВ";
	Запрос.УстановитьПараметр("БезНачала", НЕ ЗначениеЗаполнено(ДатаС));
	Запрос.УстановитьПараметр("ДатаС", НачалоДня(ДатаС));
	Запрос.УстановитьПараметр("БезКонца", НЕ ЗначениеЗаполнено(ДатаПо));
	Запрос.УстановитьПараметр("ДатаПо", КонецДня(ДатаПо));

	// Один номер - один поиск: по нему могут висеть несколько цепочек
	Номера = Новый Соответствие;
	Очередь = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Итог.Отобрано = Итог.Отобрано + 1;

		// Как и при обычной связи (УПДПоНомеру): нет входящего номера - ищем
		// по номеру самой приходной
		Номер = СокрЛП(Выборка.ВходящийНомер);
		Если НЕ ЗначениеЗаполнено(Номер) Тогда
			Номер = СокрЛП(Выборка.НомерПоступления);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Номер) Тогда
			Итог.БезНомера = Итог.БезНомера + 1;
			Продолжить;
		КонецЕсли;

		Ключ = ЭАрМ_Служебный.НомерДляСравнения(Номер);
		Если Номера.Получить(Ключ) = Неопределено Тогда
			Номера.Вставить(Ключ, Истина);
			Очередь.Добавить(Номер);
		КонецЕсли;

	КонецЦикла;

	Если Очередь.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;

	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Итог.Ошибка = "Не удалось авторизоваться в СБИС, проверьте настройки ЭДО";
		Возврат Итог;
	КонецЕсли;

	Обработано = 0;
	Для Каждого Номер Из Очередь Цикл

		Если Обработано >= Максимум Тогда
			Итог.Осталось = Очередь.Количество() - Обработано;
			Прервать;
		КонецЕсли;
		Обработано = Обработано + 1;

		Попытка

			//@skip-check query-in-loop
			ЕстьВРеестре = ЭАрМ_РегламентныйОбменЭДО.НайтиДокументЭДОПоНомеру(Номер);
			Если ЕстьВРеестре.Реестр = "УПД" Тогда
				Итог.УжеВРеестре = Итог.УжеВРеестре + 1;
				Продолжить;
			КонецЕсли;

			Найденная = ЭАрМ_ОбщийМодульОбмен.НайтиУПДПоНомеру(Номер, Сессия);

			// Поиск мог войти в СБИС заново - дальше работаем с новой сессией
			Если ЗначениеЗаполнено(Найденная.Сессия) Тогда
				Сессия = Найденная.Сессия;
			КонецЕсли;

			// Запрос не удался - это не «УПД нет», а «не проверено»
			Если НЕ ЗначениеЗаполнено(Найденная.Идентификатор)
				И ЗначениеЗаполнено(Найденная.ОшибкаЗапроса) Тогда
				Итог.Сбоев = Итог.Сбоев + 1;
				Итог.Сообщения.Добавить(СтрШаблон("%1: %2", Номер, Найденная.ОшибкаЗапроса));
				Продолжить;
			КонецЕсли;

			Если НЕ ЗначениеЗаполнено(Найденная.Идентификатор)
				ИЛИ Найденная.ДокументРеестра = Неопределено
				ИЛИ Найденная.Реестр <> "Входящие" Тогда
				Итог.НеНайдено = Итог.НеНайдено + 1;
				Итог.Сообщения.Добавить("Не найдена УПД к номеру " + Номер);
				Продолжить;
			КонецЕсли;

			ЭАрМ_РегламентныйОбменЭДО.ЗагрузитьДокументРеестраУПД(Найденная.ДокументРеестра, Найденная.Реестр);
			Итог.Загружено = Итог.Загружено + 1;

			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Найденная.Идентификатор, 100), "ДозапросУПД", Истина,
				СтрШаблон("УПД № %1 от %2 загружена из СБИС для приходной с номером %3",
					Найденная.Номер, Найденная.Дата, Номер));

		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"ДозапроситьУПДДляПриходов (УПД для приходной № " + Номер + " не загружена из СБИС)", ОшибкаИсключения);
			Итог.НеНайдено = Итог.НеНайдено + 1;
			Итог.Сообщения.Добавить(СтрШаблон("%1: %2", Номер,
				ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения)));
		КонецПопытки;

	КонецЦикла;

	Если Итог.Загружено > 0 Тогда
		ОбновитьСвязиЭДО(Настройки);
		ЭАрМ_СверкаТоваровЦепочки.СверитьЦепочки(Настройки);
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Читает приходные из папки archive, находит к ним УПД и сверяет.
//
// Регламент папку archive не открывает: туда файлы уезжают уже разобранными.
// Эта команда нужна для прошлого периода. Без настройки «Получение старых
// документов из архива» архив не читается. Уникальный входящий номер без УПД
// запрашивается в СБИС по одному, и только если дата приходной внутри окна
// реестра (ЭАрМ_НастройкиСервер.МаксимальнаяГлубинаДней). Старше окна номер
// в СБИС не ищем: иначе сервис снова перебирает весь архив.
//
// После загрузки приходные кладутся в цепочку, связи и сверка — те же
// процедуры, что у регламента. Цвет строки реестра от этого не меняется
// отдельно: зелёная и красная красятся по РасхожденийНет, как обычно.
//
// Возвращаемое значение:
//   Структура - Файлов, Уникальных, УжеБылаУПД, Загружено, НеНайдено,
//               ВнеПериода, Осталось, ГлубинаДней, Сошлось, Расхождение,
//               БезУПД, БезСверки, Ошибка, Сообщения
//
Функция ПросмотретьАрхивИСвестиУПД() Экспорт

	Итог = Новый Структура;
	Итог.Вставить("Файлов", 0);
	Итог.Вставить("Уникальных", 0);
	Итог.Вставить("УжеБылаУПД", 0);
	Итог.Вставить("Загружено", 0);
	Итог.Вставить("НеНайдено", 0);
	Итог.Вставить("ВнеПериода", 0);
	Итог.Вставить("Осталось", 0);
	Итог.Вставить("ГлубинаДней", ЭАрМ_НастройкиСервер.МаксимальнаяГлубинаДней());
	Итог.Вставить("Сошлось", 0);
	Итог.Вставить("Расхождение", 0);
	Итог.Вставить("БезУПД", 0);
	Итог.Вставить("БезСверки", 0);
	Итог.Вставить("Ошибка", "");
	Итог.Вставить("Сообщения", Новый Массив);

	Если ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПолучениеСтарыхДокументов") <> Истина Тогда
		Итог.Ошибка = НСтр("ru = 'Из архива не загружаем: в настройках обмена выключено «Получение старых документов из архива».'");
		Возврат Итог;
	КонецЕсли;

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	Приходные = ПриходныеИзАрхива(Итог);
	Итог.Уникальных = Приходные.Количество();

	Если Итог.Уникальных = 0 Тогда
		Итог.Сообщения.Добавить(НСтр("ru = 'В папках archive нет приходных result_receipts и dalion_ПриходнаяНакладная.'"));
		Возврат Итог;
	КонецЕсли;

	Граница = НачалоДня(ТекущаяДатаСеанса() - Итог.ГлубинаДней * 86400);
	КЗапросу = Новый Массив;
	Загруженные = Новый Массив;

	Для Каждого Пара Из Приходные Цикл

		Приход = Пара.Значение;
		Найденная = ЭАрМ_РегламентныйОбменЭДО.НайтиДокументЭДОПоНомеру(Приход.Номер);
		Если Найденная.Реестр = "УПД" Тогда
			Итог.УжеБылаУПД = Итог.УжеБылаУПД + 1;
			Приход.ИдентификаторУПД = Найденная.Идентификатор;
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Приход.Дата) ИЛИ Приход.Дата < Граница Тогда
			Итог.ВнеПериода = Итог.ВнеПериода + 1;
			Продолжить;
		КонецЕсли;

		КЗапросу.Добавить(Приход);

	КонецЦикла;

	Если КЗапросу.Количество() > 0 Тогда
		ЗапроситьУПДАрхиваВСБИС(КЗапросу, Загруженные, Итог);
	КонецЕсли;

	ПрименитьПриходныеАрхива(Приходные, Настройки, Итог);
	ОбновитьСвязиЭДО(Настройки);
	ЭАрМ_СверкаТоваровЦепочки.СверитьЦепочки(Настройки);

	Если Загруженные.Количество() > 0 Тогда
		ЭАрМ_РегламентныйОбменЭДО.ОбновитьСводкуРеестраУПД(Загруженные);
	КонецЕсли;

	ПодсчитатьСверкуАрхива(Приходные, Итог);

	Возврат Итог;

КонецФункции

// Уникальные приходные из подкаталогов archive папок обмена.
//
// Ключ соответствия - номер для сравнения. Повтор того же входящего номера
// не плодит второй запрос в СБИС: остаётся файл с более поздней датой.
//
Функция ПриходныеИзАрхива(Итог)

	Приходные = Новый Соответствие;
	ПределФайлов = 400;

	Для Каждого ПутьАрхива Из КаталогиАрхиваОбмена() Цикл

		СобратьВыгрузкиАрхива(ПутьАрхива, Приходные, Итог, ПределФайлов);
		СобратьПакетыАрхива(ПутьАрхива, Приходные, Итог, ПределФайлов);

		Если Итог.Файлов >= ПределФайлов Тогда
			Итог.Сообщения.Добавить(СтрШаблон(
				НСтр("ru = 'Просмотрено файлов архива: %1, остальные в этот проход не брались'"),
				ПределФайлов));
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Приходные;

КонецФункции

Функция КаталогиАрхиваОбмена()

	Кандидаты = Новый Массив;
	Обмен = ЭАрМ_НастройкиСервер.НастройкиОбмена();
	Если ЗначениеЗаполнено(Обмен.ПапкаОбмена) Тогда
		Для Каждого ПутьКаталога Из ЭАрМ_РегламентныйОбменЭДО.КаталогиОтветовВПапке(Обмен.ПапкаОбмена) Цикл
			Кандидаты.Добавить(ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(ПутьКаталога, "archive"));
		КонецЦикла;
	КонецЕсли;

	Цепочка = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	Если ЗначениеЗаполнено(Цепочка.КаталогПакетов) Тогда
		Кандидаты.Добавить(ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Цепочка.КаталогПакетов, "archive"));
	КонецЕсли;

	Результат = Новый Массив;
	Просмотренные = Новый Соответствие;
	Для Каждого Путь Из Кандидаты Цикл

		Ключ = ВРег(СокрЛП(Путь));
		Если НЕ ЗначениеЗаполнено(Ключ) ИЛИ Просмотренные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Просмотренные.Вставить(Ключ, Истина);

		Каталог = Новый Файл(Путь);
		Если Каталог.Существует() Тогда
			Результат.Добавить(Путь);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура СобратьВыгрузкиАрхива(ПутьАрхива, Приходные, Итог, ПределФайлов)

	Для Каждого ФайлВыгрузки Из НайтиФайлы(ПутьАрхива, "result_receipts_*.json") Цикл

		Если Итог.Файлов >= ПределФайлов Тогда
			Возврат;
		КонецЕсли;
		Итог.Файлов = Итог.Файлов + 1;

		Попытка
			ДанныеФайла = ЭАрМ_РегламентныйОбменЭДО.ПрочитатьФайлОбменаJSON(ФайлВыгрузки.ПолноеИмя);
			Накладные = ЭАрМ_Служебный.ЗначениеВМассив(
				ЭАрМ_Служебный.ЗначениеУзла(ДанныеФайла, "ПриходныеНакладные"));
			Для Каждого Накладная Из Накладные Цикл
				Шапка = ЭАрМ_Служебный.ЗначениеУзла(Накладная, "Шапка");
				Номер = ЭАрМ_Служебный.СтрокойИлиПусто(
					ЭАрМ_Служебный.ЗначениеУзла(Шапка, "ВходящийНомер", ""));
				Дата = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(
					ЭАрМ_Служебный.ЗначениеУзла(Шапка, "Дата", ""));
				ЗапомнитьПриходнуюАрхива(Приходные, Номер, Дата, ФайлВыгрузки.ПолноеИмя, "Выгрузка");
			КонецЦикла;
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"СобратьВыгрузкиАрхива (файл " + ФайлВыгрузки.Имя + ")", ОшибкаИсключения);
			Итог.Сообщения.Добавить(СтрШаблон("%1: %2", ФайлВыгрузки.Имя,
				ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения)));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

Процедура СобратьПакетыАрхива(ПутьАрхива, Приходные, Итог, ПределФайлов)

	Для Каждого ФайлПакета Из НайтиФайлы(ПутьАрхива, "dalion_ПриходнаяНакладная_*.json") Цикл

		Если Итог.Файлов >= ПределФайлов Тогда
			Возврат;
		КонецЕсли;
		Итог.Файлов = Итог.Файлов + 1;

		Попытка
			Данные = ЭАрМ_РегламентныйОбменЭДО.ПрочитатьФайлОбменаJSON(ФайлПакета.ПолноеИмя);
			Объект = ЭАрМ_Служебный.ЗначениеУзла(Данные, "data");
			Номер = ВходящийНомерИзОбъекта(Объект);
			Если НЕ ЗначениеЗаполнено(Номер) Тогда
				Номер = ЗначениеСтрокой(Объект, "number");
			КонецЕсли;
			Дата = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "date", ""));
			ЗапомнитьПриходнуюАрхива(Приходные, Номер, Дата, ФайлПакета.ПолноеИмя, "Пакет");
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"СобратьПакетыАрхива (файл " + ФайлПакета.Имя + ")", ОшибкаИсключения);
			Итог.Сообщения.Добавить(СтрШаблон("%1: %2", ФайлПакета.Имя,
				ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения)));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

Процедура ЗапомнитьПриходнуюАрхива(Приходные, Номер, Дата, Путь, Вид)

	Номер = СокрЛП(Номер);
	Если НЕ ЗначениеЗаполнено(Номер) Тогда
		Возврат;
	КонецЕсли;

	Ключ = ЭАрМ_Служебный.НомерДляСравнения(Номер);
	Прежняя = Приходные.Получить(Ключ);
	Если Прежняя <> Неопределено И ЗначениеЗаполнено(Прежняя.Дата)
		И (НЕ ЗначениеЗаполнено(Дата) ИЛИ Дата < Прежняя.Дата) Тогда
		Возврат;
	КонецЕсли;

	Описание = Новый Структура("Номер, Дата, Путь, Вид, ИдентификаторУПД",
		Номер, Дата, Путь, Вид, "");
	Приходные.Вставить(Ключ, Описание);

КонецПроцедуры

Процедура ЗапроситьУПДАрхиваВСБИС(КЗапросу, Загруженные, Итог)

	Максимум = 100;
	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Итог.Сообщения.Добавить(НСтр("ru = 'Не удалось авторизоваться в СБИС, проверьте настройки ЭДО. Приходные архива без нового запроса.'"));
		Итог.НеНайдено = КЗапросу.Количество();
		Возврат;
	КонецЕсли;

	Обработано = 0;
	Для Каждого Приход Из КЗапросу Цикл

		Если Обработано >= Максимум Тогда
			Итог.Осталось = КЗапросу.Количество() - Обработано;
			Прервать;
		КонецЕсли;
		Обработано = Обработано + 1;

		Попытка

			Найденная = ЭАрМ_ОбщийМодульОбмен.НайтиУПДПоНомеру(Приход.Номер, Сессия);
			Если НЕ ЗначениеЗаполнено(Найденная.Идентификатор)
				ИЛИ Найденная.ДокументРеестра = Неопределено
				ИЛИ Найденная.Реестр <> "Входящие" Тогда
				Итог.НеНайдено = Итог.НеНайдено + 1;
				Итог.Сообщения.Добавить(НСтр("ru = 'Не найдена УПД к номеру '") + Приход.Номер);
				Продолжить;
			КонецЕсли;

			ЭАрМ_РегламентныйОбменЭДО.ЗагрузитьДокументРеестраУПД(Найденная.ДокументРеестра, Найденная.Реестр);
			Приход.ИдентификаторУПД = Найденная.Идентификатор;
			Загруженные.Добавить(Найденная.Идентификатор);
			Итог.Загружено = Итог.Загружено + 1;

			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Найденная.Идентификатор, 100), "АрхивУПД", Истина,
				СтрШаблон("УПД № %1 от %2 загружена из СБИС для приходной архива %3",
					Найденная.Номер, Найденная.Дата, Приход.Номер));

		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"ЗапроситьУПДАрхиваВСБИС (приходная № " + Приход.Номер + ")", ОшибкаИсключения);
			Итог.НеНайдено = Итог.НеНайдено + 1;
			Итог.Сообщения.Добавить(СтрШаблон("%1: %2", Приход.Номер,
				ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения)));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

Процедура ПрименитьПриходныеАрхива(Приходные, Настройки, Итог)

	Примененные = Новый Соответствие;

	Для Каждого Пара Из Приходные Цикл

		Приход = Пара.Значение;
		Если Примененные.Получить(Приход.Путь) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Примененные.Вставить(Приход.Путь, Истина);

		Попытка

			Если Приход.Вид = "Выгрузка" Тогда
				ДанныеФайла = ЭАрМ_РегламентныйОбменЭДО.ПрочитатьФайлОбменаJSON(Приход.Путь);
				ЭАрМ_РегламентныйОбменЭДО.ПрименитьПриходныеНакладныеДалион(ДанныеФайла);
			Иначе
				Данные = ЭАрМ_РегламентныйОбменЭДО.ПрочитатьФайлОбменаJSON(Приход.Путь);
				Объект = ЭАрМ_Служебный.ЗначениеУзла(Данные, "data");
				ОбновитьПоПоступлению(Объект, Настройки);
			КонецЕсли;

		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"ПрименитьПриходныеАрхива (приходная № " + Приход.Номер + ")", ОшибкаИсключения);
			Итог.Сообщения.Добавить(СтрШаблон("%1: %2", Приход.Номер,
				ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения)));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

Процедура ПодсчитатьСверкуАрхива(Приходные, Итог)

	Для Каждого Пара Из Приходные Цикл

		Приход = Пара.Значение;
		Найденная = ЭАрМ_РегламентныйОбменЭДО.НайтиУПДВРеестреПоНомеру(Приход.Номер);
		Если НЕ ЗначениеЗаполнено(Найденная.Идентификатор) Тогда
			Итог.БезУПД = Итог.БезУПД + 1;
			Продолжить;
		КонецЕсли;

		Менеджер = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
		Менеджер.ИдентификаторСБИС = Найденная.Идентификатор;
		Менеджер.Прочитать();
		Если НЕ Менеджер.Выбран() Тогда
			Итог.БезУПД = Итог.БезУПД + 1;
		ИначеЕсли Менеджер.РасхожденийНет Тогда
			Итог.Сошлось = Итог.Сошлось + 1;
		ИначеЕсли ЗначениеЗаполнено(СокрЛП(Менеджер.ТекстСверки)) Тогда
			Итог.Расхождение = Итог.Расхождение + 1;
		Иначе
			Итог.БезСверки = Итог.БезСверки + 1;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Документы, закрытые в СБИС (аннулированы, удалены, отозваны), уходят из
// связей, чтобы их место занял документ, присланный взамен. Между
// аннулированной и новой УПД в СБИС связи нет - новую находит обычный поиск
// цепочки по номеру и товарам, а закрытые документы он больше не видит.
//
//   1. Цепочка отпускает закрытую УПД и запоминает её
//      в ИдентификаторУПДАннулированной; закрытую ЭТрН - просто отпускает.
//   2. Когда цепочка нашла новую УПД, у аннулированной пишется ЗамененаНа,
//      а ЭТрН, которая ссылалась на аннулированную, переводится на новую.
//   3. Корректировки - ЭАрМ_КорректировкиУПД.ОтвязатьЗакрытыеДокументы.
//   4. Неотправленные строки очереди подписания закрытых документов удаляются.
//
// Пломба значения не имеет: аннулированные УПД и ЭТрН отпускаются и у цепочки
// с пломбой - но только с поступлением не старше ГраницаОтвязкиСПломбой(), чтобы
// не открыть разом всю историю. Такая цепочка снова считается открытой
// (ЭтапЦепочки), пока не найден документ взамен, - иначе связи и сверка её
// пропускали бы.
// Ручная привязка приходной аннулирование не удерживает: УПД закрыта,
// накладная ждёт документ взамен. Утвердить закрытый документ не даст
// ЭАрМ_УтверждениеСБИС.ЗапретУтверждения.
// Каждый шаг - под своей Попыткой: сбой одного не останавливает остальные.
//
Процедура ОтвязатьЗакрытыеДокументы() Экспорт

	Попытка
		ОтпуститьЗакрытыеУПД();
	Исключение
		ЗаписатьСбойОтвязки("УПД цепочек", ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		ОтпуститьЗакрытыеЭТрН();
	Исключение
		ЗаписатьСбойОтвязки("ЭТрН цепочек", ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		ОтметитьЗаменуУПД();
	Исключение
		ЗаписатьСбойОтвязки("замена УПД", ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		ЭАрМ_КорректировкиУПД.ОтвязатьЗакрытыеДокументы();
	Исключение
		ЗаписатьСбойОтвязки("корректировки", ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		УбратьЗакрытыеИзОчереди();
	Исключение
		ЗаписатьСбойОтвязки("очередь подписания", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// С какой даты поступления цепочку с пломбой ещё отпускают от аннулированного
// документа: 60 дней. Старше - не трогаем, иначе первый проход откроет всю
// историю и она займёт места поиска связей.
//
Функция ГраницаОтвязкиСПломбой()

	Возврат НачалоДня(ТекущаяДатаСеанса()) - 60 * 86400;

КонецФункции

Процедура ОтпуститьЗакрытыеУПД()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Цепочка.ИдентификаторУПД КАК ИдентификаторУПД,
	|	Цепочка.НомерПоступления КАК НомерПоступления,
	|	УПД.Номер КАК НомерУПД,
	|	УПД.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО Цепочка.ИдентификаторУПД = УПД.ИдентификаторСБИС
	|ГДЕ
	|	НЕ (" + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УПД") + ")
	|	И (Цепочка.СтатусПломбы <> ""Установлена""
	|			ИЛИ Цепочка.ДатаПоступления >= &ГраницаПломбы)";
	Запрос.УстановитьПараметр("ГраницаПломбы", ГраницаОтвязкиСПломбой());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ИдентификаторУПД = СокрЛП(Выборка.ИдентификаторУПД);

		Изменения = Новый Структура;
		Изменения.Вставить("ИдентификаторУПД", "");
		Изменения.Вставить("НомерУПД", "");
		Изменения.Вставить("ДатаУПД", Дата(1, 1, 1));
		Изменения.Вставить("СпособСвязиУПД", "");
		Изменения.Вставить("ИдентификаторУПДАннулированной", Лев(ИдентификаторУПД, 100));
		ИзменитьЦепочку(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, Изменения, Ложь);

		// Строка аннулированной УПД больше не «Сошлось» и в отправку не идёт
		ЭАрМ_КорректировкиУПД.ИзменитьСтрокуРеестра("ЭАрМ_УПД_Входящий", ИдентификаторУПД,
			Новый Структура("РасхожденийНет, КОтправке, СвереноВручную, СвереноВручнуюКем, ТекстСверки",
				Ложь, Ложь, Ложь, "", Лев(СтрШаблон(
				НСтр("ru = 'Закрыта в СБИС (%1). Поступление %2 ждёт УПД, которую поставщик пришлёт взамен.'"),
				СокрЛП(Выборка.Состояние), СокрЛП(Выборка.НомерПоступления)), 1024)));

		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторУПД, 100), ОперацияОтвязки(), Истина,
			СтрШаблон(НСтр("ru = 'УПД %1 закрыта в СБИС (%2): поступление %3 отвязано и ждёт новую УПД'"),
				СокрЛП(Выборка.НомерУПД), СокрЛП(Выборка.Состояние), СокрЛП(Выборка.НомерПоступления)));

		// Номер УПД в документе приходной и строки реестра товаров - по цепочке
		// сразу, а не после следующей сверки: иначе там видна закрытая УПД
		Попытка
			ЭАрМ_ДокументыЗакупки.ОбновитьПоЦепочке(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления);
		Исключение
			ЗаписатьСбойОтвязки("документ приходной", ИнформацияОбОшибке());
		КонецПопытки;
		ЭАрМ_РеестрТоваровЗаказов.ОтразитьЦепочку(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления);

	КонецЦикла;

КонецПроцедуры

Процедура ОтпуститьЗакрытыеЭТрН()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Цепочка.ИдентификаторЭТрН КАК ИдентификаторЭТрН,
	|	Цепочка.НомерПоступления КАК НомерПоступления,
	|	ЭТрН.Номер КАК НомерЭТрН,
	|	ЭТрН.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|		ПО Цепочка.ИдентификаторЭТрН = ЭТрН.ИдентификаторСБИС
	|ГДЕ
	|	Цепочка.СпособСвязиЭТрН <> ""Вручную""
	|	И НЕ (" + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("ЭТрН") + ")
	|	И (Цепочка.СтатусПломбы <> ""Установлена""
	|			ИЛИ Цепочка.ДатаПоступления >= &ГраницаПломбы)";
	Запрос.УстановитьПараметр("ГраницаПломбы", ГраницаОтвязкиСПломбой());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Изменения = Новый Структура("ИдентификаторЭТрН, НомерЭТрН, СпособСвязиЭТрН", "", "", "");
		// Как у УПД: по ней ЭтапЦепочки держит цепочку с пломбой открытой до замены
		Изменения.Вставить("ИдентификаторЭТрНАннулированной", Лев(СокрЛП(Выборка.ИдентификаторЭТрН), 100));
		ИзменитьЦепочку(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, Изменения, Ложь);

		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Выборка.ИдентификаторЭТрН, 100), ОперацияОтвязки(), Истина,
			СтрШаблон(НСтр("ru = 'ЭТрН %1 закрыта в СБИС (%2): поступление %3 отвязано и ждёт новую ЭТрН'"),
				СокрЛП(Выборка.НомерЭТрН), СокрЛП(Выборка.Состояние), СокрЛП(Выборка.НомерПоступления)));

	КонецЦикла;

КонецПроцедуры

// Цепочка, отпустившая аннулированную УПД, нашла новую: связываем их явно,
// чтобы в реестре было видно, какая УПД какую заменила, и переводим на новую
// ЭТрН, которые ссылались на аннулированную.
//
Процедура ОтметитьЗаменуУПД()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторУПДАннулированной КАК Старая,
	|	Цепочка.ИдентификаторУПД КАК Новая,
	|	СтараяУПД.Номер КАК НомерСтарой,
	|	ЕСТЬNULL(НоваяУПД.Номер, """") КАК НомерНовой,
	|	ЕСТЬNULL(НоваяУПД.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНовой
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК СтараяУПД
	|		ПО Цепочка.ИдентификаторУПДАннулированной = СтараяУПД.ИдентификаторСБИС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК НоваяУПД
	|		ПО Цепочка.ИдентификаторУПД = НоваяУПД.ИдентификаторСБИС
	|ГДЕ
	|	Цепочка.ИдентификаторУПДАннулированной <> """"
	|	И Цепочка.ИдентификаторУПД <> """"
	|	И Цепочка.ИдентификаторУПД <> Цепочка.ИдентификаторУПДАннулированной
	|	И СтараяУПД.ЗамененаНа = """"";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Старая = СокрЛП(Выборка.Старая);
		Новая  = СокрЛП(Выборка.Новая);
		ТекстЗамены = СтрШаблон(НСтр("ru = 'Закрыта в СБИС. Взамен пришла УПД № %1 от %2.'"),
			СокрЛП(Выборка.НомерНовой), Формат(Выборка.ДатаНовой, "ДЛФ=D"));

		ЭАрМ_КорректировкиУПД.ИзменитьСтрокуРеестра("ЭАрМ_УПД_Входящий", Старая,
			Новый Структура("ЗамененаНа, ТекстСверки", Лев(Новая, 100), ТекстЗамены));

		ПеревестиЭТрННаНовуюУПД(Старая, Новая, СокрЛП(Выборка.НомерНовой));

		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Старая, 100), ОперацияОтвязки(), Истина,
			СтрШаблон(НСтр("ru = 'УПД %1 (закрыта в СБИС) заменена УПД %2 от %3'"),
				СокрЛП(Выборка.НомерСтарой), СокрЛП(Выборка.НомерНовой), Формат(Выборка.ДатаНовой, "ДЛФ=D")));

	КонецЦикла;

КонецПроцедуры

// Дубли реестра УПД: у одного поставщика (ИНН) несколько строк с одним номером
// и датой. Так бывало, когда поиск исходной УПД корректировки по номеру
// подхватывал ЭТрН с тем же номером и писал её в реестр УПД пустой строкой.
//
// В группе остаётся «рабочая» строка: подписана, утверждена, есть статус
// подписания, «К отправке», сверка, цепочка; при равенстве - созданная в СБИС
// позже. Удаляются только пустые строки: не подписаны, не утверждены, без
// статуса «Утвержден»/«Подписан» и без отправленной строки очереди. Группа из
// двух рабочих строк не трогается - её показывают, решает человек.
//
// Параметры:
//   ДатаС, ДатаПо - Дата - период по дате УПД
//
// Возвращаемое значение:
//   Структура:
//     * Удалить  - Массив из Структура - Идентификатор, Оставить, Номер, Дата, Контрагент
//     * Спорные  - Массив из Строка - группы, где несколько рабочих строк
//
Функция НайтиДублиРеестраУПД(ДатаС, ДатаПо) Экспорт

	Результат = Новый Структура("Удалить, Спорные", Новый Массив, Новый Массив);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.ИННКонтрагента КАК ИННКонтрагента,
	|	УПД.Контрагент КАК Контрагент,
	|	УПД.Формат КАК Формат,
	|	УПД.Подписано КАК Подписано,
	|	УПД.Утверждено КАК Утверждено,
	|	УПД.СтатусПодписания КАК СтатусПодписания,
	|	УПД.КОтправке КАК КОтправке,
	|	УПД.РасхожденийНет КАК РасхожденийНет,
	|	ВЫБОР
	|		КОГДА УПД.ДатаВремяСБИС > ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА УПД.ДатаВремяСБИС
	|		ИНАЧЕ УПД.ДатаЗагрузки
	|	КОНЕЦ КАК Момент,
	|	ВЫБОР
	|		КОГДА Цепочки.ИдентификаторУПД ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ВЦепочке,
	|	ВЫБОР
	|		КОГДА Отправленные.ИдентификаторСБИС ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ОтправленВОчереди
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			Цепочка.ИдентификаторУПД КАК ИдентификаторУПД
	|		ИЗ
	|			РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ГДЕ
	|			Цепочка.ИдентификаторУПД <> """") КАК Цепочки
	|		ПО УПД.ИдентификаторСБИС = Цепочки.ИдентификаторУПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			Очередь.ИдентификаторСБИС КАК ИдентификаторСБИС
	|		ИЗ
	|			РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|		ГДЕ
	|			Очередь.Статус В (
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОтправленНаПодпись),
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено))) КАК Отправленные
	|		ПО УПД.ИдентификаторСБИС = Отправленные.ИдентификаторСБИС
	|ГДЕ
	|	УПД.Номер <> """"
	|	И УПД.Дата МЕЖДУ &ДатаС И &ДатаПо";
	Запрос.УстановитьПараметр("ДатаС", НачалоДня(ДатаС));
	Запрос.УстановитьПараметр("ДатаПо", ?(ЗначениеЗаполнено(ДатаПо), КонецДня(ДатаПо), '39991231235959'));

	Строки = Запрос.Выполнить().Выгрузить();
	Строки.Колонки.Добавить("Группа", Новый ОписаниеТипов("Строка"));
	Строки.Колонки.Добавить("Вес", Новый ОписаниеТипов("Число"));
	Строки.Колонки.Добавить("Пустая", Новый ОписаниеТипов("Булево"));

	Статусы = Перечисления.ЭАрМ_СтатусыПодписанияЭДО;
	Для Каждого Строка Из Строки Цикл

		ИНН = "";
		Для Позиция = 1 По СтрДлина(Строка.ИННКонтрагента) Цикл
			Символ = Сред(Строка.ИННКонтрагента, Позиция, 1);
			Если СтрНайти("0123456789", Символ) > 0 Тогда
				ИНН = ИНН + Символ;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЗначениеЗаполнено(ИНН) Тогда
			ИНН = ВРег(СокрЛП(Строка.Контрагент));
		КонецЕсли;
		Строка.Группа = ИНН + "|" + ВРег(СокрЛП(Строка.Номер)) + "|" + Формат(Строка.Дата, "ДФ=yyyyMMdd");

		Строка.Вес = ?(Строка.Подписано, 1000, 0)
			+ ?(Строка.Утверждено, 500, 0)
			+ ?(ЗначениеЗаполнено(Строка.СтатусПодписания), 100, 0)
			+ ?(Строка.КОтправке, 50, 0)
			+ ?(Строка.РасхожденийНет, 20, 0)
			+ ?(Строка.ВЦепочке, 10, 0)
			+ ?(Строка.Формат = "УПД", 5, 0);

		Строка.Пустая = НЕ Строка.Подписано
			И НЕ Строка.Утверждено
			И Строка.СтатусПодписания <> Статусы.Утвержден
			И Строка.СтатусПодписания <> Статусы.Подписан
			И НЕ Строка.ОтправленВОчереди;

	КонецЦикла;

	Строки.Сортировать("Группа, Вес Убыв, Момент Убыв");

	Индекс = 0;
	Пока Индекс < Строки.Количество() Цикл

		Первая = Строки[Индекс];
		Конец = Индекс + 1;
		Пока Конец < Строки.Количество() И Строки[Конец].Группа = Первая.Группа Цикл
			Конец = Конец + 1;
		КонецЦикла;

		Если Конец - Индекс > 1 Тогда
			Для Номер = Индекс + 1 По Конец - 1 Цикл
				Лишняя = Строки[Номер];
				Если НЕ Лишняя.Пустая Тогда
					Результат.Спорные.Добавить(СтрШаблон(НСтр("ru = 'УПД № %1 от %2 (%3): несколько подписанных или утверждённых строк'"),
						СокрЛП(Первая.Номер), Формат(Первая.Дата, "ДЛФ=D"), СокрЛП(Первая.Контрагент)));
					Продолжить;
				КонецЕсли;
				Результат.Удалить.Добавить(Новый Структура("Идентификатор, Оставить, Номер, Дата, Контрагент",
					СокрЛП(Лишняя.ИдентификаторСБИС), СокрЛП(Первая.ИдентификаторСБИС),
					СокрЛП(Лишняя.Номер), Лишняя.Дата, СокрЛП(Лишняя.Контрагент)));
			КонецЦикла;
		КонецЕсли;

		Индекс = Конец;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Удаляет пустые дубли реестра УПД (см. НайтиДублиРеестраУПД). Всё, что
// ссылалось на удаляемую строку, переводится на оставленную: цепочки закупки
// (если оставленная ни в какой цепочке не стоит, иначе связь снимается),
// ЭТрН, основание корректировок. Строки товаров и неотправленные строки
// очереди удаляемой УПД удаляются вместе с ней. Каждое удаление - в журнал.
//
// Возвращаемое значение:
//   Структура - Удалено, Ошибок, Спорных, Текст
//
Функция УдалитьДублиРеестраУПД(ДатаС, ДатаПо) Экспорт

	Дубли = НайтиДублиРеестраУПД(ДатаС, ДатаПо);
	Итог = Новый Структура("Удалено, Ошибок, Спорных, Текст", 0, 0, Дубли.Спорные.Количество(), "");

	Для Каждого Дубль Из Дубли.Удалить Цикл
		Попытка
			УдалитьДубльУПД(Дубль);
			Итог.Удалено = Итог.Удалено + 1;
		Исключение
			Итог.Ошибок = Итог.Ошибок + 1;
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Дубль.Идентификатор, 100), "ДублиУПД", Ложь,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Итог.Текст = СтрШаблон(НСтр("ru = 'Удалено дублей УПД: %1, ошибок: %2.'"), Итог.Удалено, Итог.Ошибок);
	Если Итог.Спорных > 0 Тогда
		Итог.Текст = Итог.Текст + Символы.ПС + НСтр("ru = 'Не тронуто (несколько рабочих строк, решите вручную):'")
			+ Символы.ПС + СтрСоединить(Дубли.Спорные, Символы.ПС);
	КонецЕсли;

	Возврат Итог;

КонецФункции

Процедура УдалитьДубльУПД(Дубль)

	Старая = Дубль.Идентификатор;
	Новая  = Дубль.Оставить;

	// Цепочки закупки: на оставленную УПД, если она ещё ни к чему не привязана
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Цепочка.ИдентификаторУПД КАК ИдентификаторУПД
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторУПД В (&Идентификаторы)";
	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(Старая);
	Идентификаторы.Добавить(Новая);
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Цепочки = Запрос.Выполнить().Выгрузить();

	НоваяПривязана = Цепочки.Найти(Новая, "ИдентификаторУПД") <> Неопределено;
	РеквизитыНовой = ЗаписьРеестраУПД(Новая);

	Для Каждого Цепочка Из Цепочки Цикл
		Если СокрЛП(Цепочка.ИдентификаторУПД) <> Старая Тогда
			Продолжить;
		КонецЕсли;
		Изменения = Новый Структура;
		Если НЕ НоваяПривязана Тогда
			Изменения.Вставить("ИдентификаторУПД", Лев(Новая, 100));
			Изменения.Вставить("НомерУПД", РеквизитыНовой.Номер);
			Изменения.Вставить("ДатаУПД", РеквизитыНовой.Дата);
			НоваяПривязана = Истина;
		Иначе
			Изменения.Вставить("ИдентификаторУПД", "");
			Изменения.Вставить("НомерУПД", "");
			Изменения.Вставить("ДатаУПД", Дата(1, 1, 1));
			Изменения.Вставить("СпособСвязиУПД", "");
		КонецЕсли;
		ИзменитьЦепочку(Цепочка.ИдентификаторЗаказа, Цепочка.ИдентификаторПоступления, Изменения, Ложь);
		Попытка
			ЭАрМ_СверкаТоваровЦепочки.СверитьЦепочку(Цепочка.ИдентификаторЗаказа, Цепочка.ИдентификаторПоступления);
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			// Пересверит регламент
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(Цепочка.ИдентификаторПоступления,
				"УдалитьДубльУПД (пересверка после переноса цепочки - пересверит регламент)", ОшибкаИсключения);
		КонецПопытки;
	КонецЦикла;

	// ЭТрН и основание корректировок - на оставленную
	ПеревестиЭТрННаНовуюУПД(Старая, Новая, РеквизитыНовой.Номер);

	ЗапросУКД = Новый Запрос;
	ЗапросУКД.Текст =
	"ВЫБРАТЬ
	|	УКД.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.ИдентификаторОснования = &Старая";
	ЗапросУКД.УстановитьПараметр("Старая", Старая);
	ВыборкаУКД = ЗапросУКД.Выполнить().Выбрать();
	Пока ВыборкаУКД.Следующий() Цикл
		ЭАрМ_КорректировкиУПД.ИзменитьСтрокуРеестра("ЭАрМ_УКД_Входящий", СокрЛП(ВыборкаУКД.ИдентификаторСБИС),
			Новый Структура("ИдентификаторОснования", Лев(Новая, 100)));
	КонецЦикла;

	НачатьТранзакцию();
	Попытка

		// Неотправленные строки очереди (отправленных у пустой строки нет по отбору)
		ЗапросОчереди = Новый Запрос;
		ЗапросОчереди.Текст =
		"ВЫБРАТЬ
		|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
		|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса
		|ИЗ
		|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
		|ГДЕ
		|	Очередь.ИдентификаторСБИС = &Старая";
		ЗапросОчереди.УстановитьПараметр("Старая", Старая);
		ВыборкаОчереди = ЗапросОчереди.Выполнить().Выбрать();
		Пока ВыборкаОчереди.Следующий() Цикл
			СтрокаОчереди = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
			СтрокаОчереди.ЭлектронныйДокумент = ВыборкаОчереди.ЭлектронныйДокумент;
			СтрокаОчереди.ИдентификаторЗапроса = ВыборкаОчереди.ИдентификаторЗапроса;
			СтрокаОчереди.Удалить();
		КонецЦикла;

		// Строки товаров удаляемой УПД
		НаборТоваров = РегистрыСведений.ЭАрМ_ТоварыЭТрН.СоздатьНаборЗаписей();
		НаборТоваров.Отбор.ИдентификаторСБИС.Установить(Старая);
		НаборТоваров.Записать(Истина);

		СтрокаРеестра = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
		СтрокаРеестра.ИдентификаторСБИС = Старая;
		СтрокаРеестра.Удалить();

		ЗафиксироватьТранзакцию();

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"УдалитьДубльУПД (дубль УПД не удалён)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Старая, 100), "ДублиУПД", Истина,
		СтрШаблон(НСтр("ru = 'Удалён дубль УПД № %1 от %2 (%3), оставлена %4'"),
			Дубль.Номер, Формат(Дубль.Дата, "ДЛФ=D"), Дубль.Контрагент, Новая));

КонецПроцедуры

// Номер и дата строки реестра УПД.
//
Функция ЗаписьРеестраУПД(Идентификатор)

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
	МенеджерЗаписи.Прочитать();

	Возврат Новый Структура("Номер, Дата", Лев(СокрЛП(МенеджерЗаписи.Номер), 50), МенеджерЗаписи.Дата);

КонецФункции

Процедура ПеревестиЭТрННаНовуюУПД(Старая, Новая, НомерНовой)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭТрН.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	ЭТрН.ИдентификаторУПД = &Старая";
	Запрос.УстановитьПараметр("Старая", Старая);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭАрМ_КорректировкиУПД.ИзменитьСтрокуРеестра("ЭАрМ_РеестрЭТрН", СокрЛП(Выборка.ИдентификаторСБИС),
			Новый Структура("ИдентификаторУПД, ПредставлениеУПД",
				Лев(Новая, 100), Лев(СтрШаблон("УПД № %1", НомерНовой), 150)));
	КонецЦикла;

КонецПроцедуры

// Неотправленные строки очереди подписания закрытых документов: подписать их
// всё равно не дадут, а в пачке они возвращались бы ошибкой каждый раз.
//
Процедура УбратьЗакрытыеИзОчереди()

	Шаблон =
	"ВЫБРАТЬ
	|	Очередь.Реестр КАК Реестр,
	|	Очередь.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.#Регистр КАК Док
	|		ПО Очередь.ИдентификаторСБИС = Док.ИдентификаторСБИС
	|ГДЕ
	|	Очередь.Реестр = ""#Реестр""
	|	И Очередь.Статус В (
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ПустаяСсылка))
	|	И НЕ (" + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("Док") + ")";

	Части = Новый Массив;
	Для Каждого Пара Из СтрРазделить("УПД:ЭАрМ_УПД_Входящий,УКД:ЭАрМ_УКД_Входящий,ЭТрН:ЭАрМ_РеестрЭТрН", ",") Цикл
		Реестр  = СтрРазделить(Пара, ":")[0];
		Регистр = СтрРазделить(Пара, ":")[1];
		Части.Добавить(СтрЗаменить(СтрЗаменить(Шаблон, "#Регистр", Регистр), "#Реестр", Реестр));
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Отказ (утверждение уже ушло) не пишем: строка осталась бы и писала
		// ту же ошибку на каждом проходе
		Ошибка = ЭАрМ_ОбработкаПодтвержденийЭДО.СнятьСУтверждения(Выборка.Реестр, СокрЛП(Выборка.ИдентификаторСБИС));
		Если НЕ ЗначениеЗаполнено(Ошибка) Тогда
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Выборка.ИдентификаторСБИС, 100), ОперацияОтвязки(), Истина,
				СтрШаблон(НСтр("ru = '%1 закрыт(а) в СБИС: убран(а) из очереди подписания'"), Выборка.Реестр));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ОперацияОтвязки()

	Возврат "АннулированиеСБИС";

КонецФункции

Процедура ЗаписатьСбойОтвязки(Шаг, СведенияОбОшибке)

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", ОперацияОтвязки(), Ложь,
		СтрШаблон(НСтр("ru = 'Отвязка закрытых документов, шаг «%1»: %2'"),
			Шаг, ЭАрМ_Служебный.ТекстИсключения(СведенияОбОшибке)));

КонецПроцедуры

// Записывает итог сверки в цепочку. Дату обновления не трогает: иначе цепочка
// попадала бы в сверку на каждом проходе.
//
// Параметры:
//   Итог - Структура - ЕстьРасхождения, РасхожденийСтрок, ТекстРасхождений, УПДУчтена
//
Процедура ЗафиксироватьСверку(ИдентификаторЗаказа, ИдентификаторПоступления, Итог) Экспорт

	Изменения = Новый Структура;
	Изменения.Вставить("ЕстьРасхождения",  Итог.ЕстьРасхождения);
	Изменения.Вставить("РасхожденийСтрок", Итог.РасхожденийСтрок);
	Изменения.Вставить("ТекстРасхождений", Итог.ТекстРасхождений);
	Изменения.Вставить("ДатаСверки",       ТекущаяДатаСеанса());

	ИзменитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Изменения, Ложь, Ложь);

	// Утверждать УПД в ЭДО можно, когда есть приход и ЭТрН (наличие)
	// или когда сверка с приходом сошлась. Отметка "Расхождений нет"
	// в реестре УПД ставится и снимается здесь.
	Цепочка = ЗаписьЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления);
	ЕстьЭТрНИПриход = Цепочка <> Неопределено
		И ЗначениеЗаполнено(Цепочка.ИдентификаторЭТрН)
		И ЗначениеЗаполнено(Цепочка.ИдентификаторПоступления);

	Если Цепочка <> Неопределено И ЗначениеЗаполнено(Цепочка.ИдентификаторУПД) Тогда
		// Приход и ЭТрН есть - на подпись идёт ЭТрН (ОтметитьЭТрНПоСверке ниже).
		// УПД идёт на подпись, только если сошлась с приходом строками и
		// итоговой суммой; с расхождениями она ждёт корректировку (УКД), и
		// сверка с учётом УКД снимет ожидание сама. Раньше наличие прихода и
		// ЭТрН делало готовой и УПД, и она уходила с другой суммой.
		УПДСошлась = ?(Итог.Свойство("УПДСошлась"), Итог.УПДСошлась,
			Итог.УПДУчтена И НЕ Итог.ЕстьРасхождения);
		// Итог без признака (старый вызов) считаем несошедшимся
		СуммыСошлись = Итог.Свойство("СуммыСошлись") И Итог.СуммыСошлись = Истина;
		// С 29.09.2026: итоговая сумма УПД (с учётом УКД) и приходной сошлась
		// до копейки - УПД готова к отправке, даже если отдельные строки
		// сведены не так (пары по штрихкоду бывают неполными). Расхождения
		// строк остаются в тексте сверки справкой
		УПДГотова = Итог.УПДУчтена И СуммыСошлись;
		Если УПДГотова И УПДСошлась Тогда
			ТекстСверки = "Сошлось";
		ИначеЕсли УПДГотова Тогда
			ТекстСверки = "Сошлось по итоговой сумме";
			Если ЗначениеЗаполнено(СокрЛП(Итог.ТекстРасхождений)) Тогда
				ТекстСверки = ТекстСверки + "; строки: " + СокрЛП(Итог.ТекстРасхождений);
			КонецЕсли;
		Иначе
			ТекстСверки = СокрЛП(Итог.ТекстРасхождений);
			Если НЕ ЗначениеЗаполнено(ТекстСверки) Тогда
				ТекстСверки = "Итоговая сумма УПД и прихода не сошлась или не сверена";
			КонецЕсли;
		КонецЕсли;
		// Статус «Ожидает УКД» (возвращён 14.10.2026 по просьбе): итоговая сумма НЕ
		// сошлась, товара из УПД нет в приходе и число позиций не сходится
		// (ЭАрМ_СверкаТоваровЦепочки.УПДОжидаетУКД, УПД уже с учётом пришедших
		// УКД). Ложь - снять: сумма сошлась или ждать нечего. Сошлась после УКД -
		// ИзменитьСтрокуРеестра поднимает статус из «Ожидает УКД»
		ОжидаетУКД = НЕ УПДГотова И Итог.Свойство("ОжидаетУКД") И Итог.ОжидаетУКД = Истина;
		// «УКД есть, нет возврата из Далиона»: УКД уменьшила количество, приходная
		// Далиона больше УПД после УКД (ЭАрМ_СверкаТоваровЦепочки.УПДЖдётВозвратДалиона)
		НетВозвратаДалиона = НЕ УПДГотова И НЕ ОжидаетУКД
			И Итог.Свойство("НетВозвратаДалиона") И Итог.НетВозвратаДалиона = Истина;
		ЭАрМ_ПриемПакетовДалион.Трасса(Цепочка.ИдентификаторУПД, СтрШаблон(
			"Сверка: статус УПД - %1. КАК ОПРЕДЕЛЕНО: итоговая сумма %2; товар УПД без пары в приходе и разное число позиций - %3; УКД уменьшила количество и приходная больше УПД после УКД - %4",
			?(ОжидаетУКД, "«Нужна УКД от поставщика»",
				?(НетВозвратаДалиона, "«УКД есть, нет возврата из Далиона»", "статус не ставится (снимается, если был)")),
			?(УПДГотова, "сошлась", "не сошлась"),
			?(Итог.Свойство("ОжидаетУКД") И Итог.ОжидаетУКД = Истина, "да", "нет"),
			?(Итог.Свойство("НетВозвратаДалиона") И Итог.НетВозвратаДалиона = Истина, "да", "нет")));
		// «Есть ЭТрН» - наличие ЭТрН, без условия о приходе; нет ЭТрН в
		// цепочке - галочку не трогаем, её могла поставить ЭТрН вне цепочки
		ЭАрМ_КорректировкиУПД.ЗафиксироватьИтогСверки(Цепочка.ИдентификаторУПД,
			УПДГотова, ТекстСверки,
			?(ЗначениеЗаполнено(Цепочка.ИдентификаторЭТрН), Истина, Неопределено), ОжидаетУКД, НетВозвратаДалиона);
	КонецЕсли;

	ОтразитьПоступлениеВРеестрах(ИдентификаторЗаказа, ИдентификаторПоступления);

	Если ЕстьЭТрНИПриход Тогда
		ОтметитьЭТрНПоСверке(Цепочка.ИдентификаторЭТрН, Истина);
	КонецЕсли;

	// Остальные ЭТрН этой УПД (несколько рейсов, ЭТрН не попала в цепочку)
	Если Цепочка <> Неопределено И ЗначениеЗаполнено(Цепочка.ИдентификаторУПД) Тогда
		ОтметитьЭТрНПоПриходам(Цепочка.ИдентификаторУПД);
	КонецЕсли;

	ЭАрМ_ДокументыЗакупки.ОбновитьПоЦепочке(ИдентификаторЗаказа, ИдентификаторПоступления);

КонецПроцедуры

// Делает ЭТрН готовой к утверждению (МожноУтвердить, "Готов к отправке") по факту:
// у неё есть соответствующая УПД, а по УПД - приходная Далиона. Совпадение
// товаров не требуется, как и у ЭТрН, связанной с цепочкой напрямую.
// «К отправке» человек ставит сам.
//
// Соответствие ЭТрН и УПД - то же, что в ЭАрМ_РегламентныйОбменЭДО.НайтиЭТрНДляУПД:
// ссылка на УПД в реестре ЭТрН или в строках груза. Приходная - поступление в
// цепочке этой УПД или номер приходной Далиона в реестре УПД. Берутся только
// ещё не зелёные ЭТрН; зелёную обратно не перекрашивает.
//
// Параметры:
//   ИдентификаторУПД - Строка - только ЭТрН этой УПД; пусто - все
//
Процедура ОтметитьЭТрНПоПриходам(ИдентификаторУПД = "") Экспорт

	ОтборЭТрН    = "";
	ОтборТоваров = "";
	Если ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		ОтборЭТрН    = "
		|	И ЭТрН.ИдентификаторУПД = &ИдентификаторУПД";
		ОтборТоваров = "
		|	И Товары.ИдентификаторУПД = &ИдентификаторУПД";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ
	|	ЭТрН.ИдентификаторСБИС КАК ИдентификаторЭТрН,
	|	ЭТрН.ИдентификаторУПД КАК ИдентификаторУПД
	|ПОМЕСТИТЬ Связи
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	НЕ ЭТрН.МожноУтвердить
	|	И ЭТрН.ИдентификаторУПД <> """"%1
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Товары.ИдентификаторСБИС,
	|	Товары.ИдентификаторУПД
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|		ПО ЭТрН.ИдентификаторСБИС = Товары.ИдентификаторСБИС
	|ГДЕ
	|	Товары.ИсточникТоваров = ""ЭТрН""
	|	И Товары.ИдентификаторУПД <> """"
	|	И НЕ ЭТрН.МожноУтвердить%2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Связи.ИдентификаторЭТрН КАК ИдентификаторЭТрН
	|ИЗ
	|	Связи КАК Связи
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ПО Цепочка.ИдентификаторУПД = Связи.ИдентификаторУПД
	|			И Цепочка.ИдентификаторПоступления <> """"
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО УПД.ИдентификаторСБИС = Связи.ИдентификаторУПД
	|ГДЕ
	|	(НЕ Цепочка.ИдентификаторПоступления ЕСТЬ NULL
	|			ИЛИ ЕСТЬNULL(УПД.НомерДокументаДалион, """") <> """")", ОтборЭТрН, ОтборТоваров);
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			//@skip-check query-in-loop
			ОтметитьЭТрНПоСверке(Выборка.ИдентификаторЭТрН, Истина);
		Исключение
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Выборка.ИдентификаторЭТрН, 100),
				ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(), Ложь,
				"ЭТрН по приходу: " + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Кладёт запросы пломбы по цепочкам, сверенным без расхождений.
//
// Запрос уходит в Далион один раз: после записи файла статус "Запрошена",
// повторно цепочка попадёт сюда только с новой версией поступления.
//
Процедура ЗапроситьПломбы(Настройки) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 100
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Цепочка.НомерПоступления КАК НомерПоступления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО Цепочка.ИдентификаторУПД = УПД.ИдентификаторСБИС
	|ГДЕ
	|	Цепочка.Этап = ""Сверено""
	|	И Цепочка.ПроведеноПоступление
	|	И НЕ Цепочка.ЕстьРасхождения
	|	И Цепочка.ИдентификаторЭТрН <> """"
	|	И УПД.Утверждено
	|	И УПД.Подписано
	|	И Цепочка.СтатусПломбы = """"";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Результат = ОтправитьЗапросПломбы(Выборка.ИдентификаторПоступления, Выборка.НомерПоступления, Настройки);
		ЗафиксироватьРезультатЗапросаПломбы(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, Результат);

	КонецЦикла;

КонецПроцедуры

// Ручной тестовый запрос пломбы по выбранной УПД. Условия автомата
// (Сверено, подпись, ЭТрН) не проверяются: нужен только uid поступления
// в цепочке, который пришёл пакетом из Далиона.
//
// Возвращаемое значение:
//   Структура - Успех, Сообщение
//
Функция ЗапроситьПломбуПоУПД(ИдентификаторУПД) Экспорт

	Результат = Новый Структура("Успех, Сообщение", Ложь, "");

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Результат.Сообщение = "Выберите УПД в списке";
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Цепочка.НомерПоступления КАК НомерПоступления,
	|	Цепочка.НомерУПД КАК НомерУПД
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторУПД = &ИдентификаторУПД";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Результат.Сообщение =
			"У этой УПД ещё нет цепочки с приходной Далиона. Создайте приходную в Далионе, дождитесь выгрузки и прочитайте папку обмена в УТ.";
		Возврат Результат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Выборка.ИдентификаторПоступления) Тогда
		Результат.Сообщение = "В цепочке нет uid поступления. Сначала примите пакет ПриходнаяНакладная из Далиона.";
		Возврат Результат;
	КонецЕсли;

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	Отправка = ОтправитьЗапросПломбы(Выборка.ИдентификаторПоступления, Выборка.НомерПоступления, Настройки);
	ЗафиксироватьРезультатЗапросаПломбы(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, Отправка);

	Результат.Успех = Отправка.Успех;
	Результат.Сообщение = ?(Отправка.Успех,
		СтрШаблон("Тест: запрос пломбы отправлен по УПД %1, поступление %2. Файл: %3",
			Выборка.НомерУПД, Выборка.НомерПоступления, Отправка.ИмяФайла),
		"Запрос пломбы не отправлен: " + Отправка.Ошибка);

	Возврат Результат;

КонецФункции

// Запись цепочки, связанная с этой УПД. Нужна форме реестра: пакет уже принят
// в ЭАрМ_ЦепочкаЗакупки, а поля Далиона в ЭАрМ_УПД_Входящий могли ещё не
// заполниться.
//
Функция ЦепочкаПоУПД(ИдентификаторУПД) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторУПД = &ИдентификаторУПД
	|
	|УПОРЯДОЧИТЬ ПО
	|	Цепочка.ДатаОбновления УБЫВ";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЗаписьЦепочки(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления);

КонецФункции

// Запасной поиск: входящий номер поступления совпал с номером УПД, а uid УПД
// в цепочку ещё не записали. Номера поставщика повторяются, поэтому при
// известной дате УПД берётся приходная только внутри окна связи.
//
Функция ЦепочкаПоНомеруЭДО(НомерЭДО, ДатаУПД = '00010101', ИНН = "") Экспорт

	Если НЕ ЗначениеЗаполнено(НомерЭДО) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОкноСекунд = 0;
	Если ЗначениеЗаполнено(ДатаУПД) Тогда
		ОкноСекунд = ЭАрМ_НастройкиСервер.НастройкиЦепочки().ОкноДнейСвязи * 86400;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Цепочка.ВходящийНомер КАК ВходящийНомер,
	|	Цепочка.НомерУПД КАК НомерУПД,
	|	Цепочка.ДатаПоступления КАК ДатаПоступления,
	|	Цепочка.ИННПоставщика КАК ИННПоставщика
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления <> """"
	|	И Цепочка.ИдентификаторУПД = """"";
	Если ОкноСекунд > 0 Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Цепочка.ДатаПоступления МЕЖДУ &ДатаС И &ДатаПо";
		Запрос.УстановитьПараметр("ДатаС", НачалоДня(ДатаУПД) - ОкноСекунд);
		Запрос.УстановитьПараметр("ДатаПо", КонецДня(ДатаУПД) + ОкноСекунд);
	КонецЕсли;

	ЛучшийЗаказ = "";
	ЛучшееПоступление = "";
	ЛучшаяРазница = Неопределено;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЭАрМ_Служебный.НомераСовпадают(Выборка.ВходящийНомер, НомерЭДО)
			И НЕ ЭАрМ_Служебный.НомераСовпадают(Выборка.НомерУПД, НомерЭДО) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ИНН) И НЕ ИННСовпадает(Выборка.ИННПоставщика, ИНН) Тогда
			Продолжить;
		КонецЕсли;
		Разница = ?(ЗначениеЗаполнено(ДатаУПД) И ЗначениеЗаполнено(Выборка.ДатаПоступления),
			Выборка.ДатаПоступления - ДатаУПД, 0);
		Если Разница < 0 Тогда
			Разница = -Разница;
		КонецЕсли;
		Если ЛучшаяРазница = Неопределено ИЛИ Разница < ЛучшаяРазница Тогда
			ЛучшаяРазница = Разница;
			ЛучшийЗаказ = Выборка.ИдентификаторЗаказа;
			ЛучшееПоступление = Выборка.ИдентификаторПоступления;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(ЛучшееПоступление) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЗаписьЦепочки(ЛучшийЗаказ, ЛучшееПоступление);

КонецФункции

// Строки поступления Далиона в том виде, в каком их рисует дерево реестра УПД.
//
Функция ПозицииПоступления(ИдентификаторПоступления, БезПравок = Ложь) Экспорт

	Позиции = ПозицииПриходаИзОбъекта(
		ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ПриходнаяНакладная", ИдентификаторПоступления));

	// Цена, исправленная вручную с комментарием (ЭАрМ_ПравкиЦен), - как в сверке
	Если НЕ БезПравок Тогда
		ЭАрМ_ПравкиЦен.ПрименитьКПозициям(Позиции, ИдентификаторПоступления);
	КонецЕсли;

	Возврат Позиции;

КонецФункции

// Применяет ответ Далиона на запрос пломбы.
//
// Параметры:
//   Данные - Соответствие - пакет serviceResponse целиком; data - массив
//            { uid, number, found, posted, sealed, sealState, error }
//
Процедура ПрименитьОтветПломбы(Данные) Экспорт

	Заголовок = ЭАрМ_Служебный.ЗначениеУзла(Данные, "header");
	ИдентификаторЗапроса = ЗначениеСтрокой(Заголовок, "requestId");

	Для Каждого Ответ Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Данные, "data")) Цикл

		ИдентификаторПоступления = ЗначениеСтрокой(Ответ, "uid");
		ТекущаяЗапись = ЗаписьПоступления(ИдентификаторПоступления);
		Если ТекущаяЗапись = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ТекущаяЗапись.СтатусПломбы <> "Запрошена"
			ИЛИ НЕ ЗначениеЗаполнено(ИдентификаторЗапроса)
			ИЛИ ТекущаяЗапись.ИдентификаторЗапросаПломбы <> ИдентификаторЗапроса Тогда
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторПоступления, 100),
				ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(), Ложь,
				"Ответ пломбы пропущен: requestId не совпадает с ожидаемым");
			Продолжить;
		КонецЕсли;

		Пломба = ЭАрМ_Служебный.ЗначениеУзла(Ответ, "sealed", Ложь) = Истина;
		Ошибка = ЗначениеСтрокой(Ответ, "error");

		Изменения = Новый Структура;
		Изменения.Вставить("ПроведеноПоступление", ЭАрМ_Служебный.ЗначениеУзла(Ответ, "posted", Ложь) = Истина);
		Изменения.Вставить("СтатусПломбы",         ?(Пломба, "Установлена", ?(ЗначениеЗаполнено(Ошибка), "Отказ", "НеУстановлена")));
		Изменения.Вставить("ДатаОтветаПломбы",     ТекущаяДатаСеанса());
		Изменения.Вставить("КомментарийПломбы",    Лев(?(ЗначениеЗаполнено(Ошибка), Ошибка, ЗначениеСтрокой(Ответ, "sealState")), 500));

		ИзменитьЦепочку(ТекущаяЗапись.ИдентификаторЗаказа, ИдентификаторПоступления, Изменения, Ложь, Ложь);

		ЭАрМ_ЗапросыДалион.ОтметитьОтветПломбы(ИдентификаторЗапроса,
			Изменения.СтатусПломбы, Изменения.КомментарийПломбы);

		Если ЗначениеЗаполнено(ТекущаяЗапись.ИдентификаторУПД) Тогда
			ОтметитьПризнакУПД(ТекущаяЗапись.ИдентификаторУПД, "Пломба", Пломба);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// УПД изменилась со стороны СБИС (пришла или связалась её корректировка):
// цепочки с этой УПД сверяются заново на ближайшем проходе задания.
//
Процедура ОтметитьИзменениеУПД(ИдентификаторУПД) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторУПД = &ИдентификаторУПД";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Пустые изменения: ИзменитьЦепочку только сдвинет ДатаОбновления
		ИзменитьЦепочку(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления,
			Новый Структура, Ложь);
	КонецЦикла;

КонецПроцедуры

// Связывает с УПД цепочку, найденную формой реестра УПД по номеру
// (ЦепочкаПоНомеруЭДО), когда автоматика связи её не нашла. Без связи сверка
// цепочки не пишет итог в УПД: форма показывала расхождения, а строка УПД
// оставалась белой. Занятую другой УПД цепочку не трогает.
//
// Возвращаемое значение:
//   Булево - Истина, если связь записана
//
Функция СвязатьНайденнуюПоНомеру(ИдентификаторЗаказа, ИдентификаторПоступления, ИдентификаторУПД) Экспорт

	Цепочка = ЗаписьЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления);
	Если Цепочка = Неопределено
		ИЛИ ЗначениеЗаполнено(Цепочка.ИдентификаторУПД)
		ИЛИ НЕ ЗначениеЗаполнено(ИдентификаторУПД)
		ИЛИ ЭАрМ_УтверждениеСБИС.ДокументРеестраЗакрыт("ЭАрМ_УПД_Входящий", ИдентификаторУПД) Тогда
		Возврат Ложь;
	КонецЕсли;

	Реквизиты = РеквизитыУПД(ИдентификаторУПД);

	Изменения = Новый Структура;
	Изменения.Вставить("ИдентификаторУПД", Лев(ИдентификаторУПД, 100));
	Изменения.Вставить("НомерУПД",         Лев(Реквизиты.Номер, 50));
	Изменения.Вставить("ДатаУПД",          Реквизиты.Дата);
	Изменения.Вставить("СпособСвязиУПД",   "Номер");

	ИзменитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Изменения, Ложь);

	Если НЕ ЗначениеЗаполнено(Цепочка.ИдентификаторЭТрН) Тогда
		СвязатьЭТрН(ИдентификаторЗаказа, ИдентификаторПоступления, ИдентификаторУПД);
	КонецЕсли;

	ОтразитьПоступлениеВРеестрах(ИдентификаторЗаказа, ИдентификаторПоступления);

	Возврат Истина;

КонецФункции

// Ручная связь поступления с УПД. Пустой идентификатор снимает связь, и
// автоматика снова начинает её искать.
//
Процедура СвязатьВручную(ИдентификаторЗаказа, ИдентификаторПоступления, ИдентификаторУПД) Экспорт

	// Отметка сверки относилась к прежней УПД: без цепочки утверждать её нельзя
	Прежняя = ЗаписьЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления);
	Если Прежняя <> Неопределено И ЗначениеЗаполнено(Прежняя.ИдентификаторУПД)
		И Прежняя.ИдентификаторУПД <> ИдентификаторУПД Тогда
		ОтметитьПризнакУПД(Прежняя.ИдентификаторУПД, "РасхожденийНет", Ложь);
		ОтметитьПризнакУПД(Прежняя.ИдентификаторУПД, "ЕстьЭТрН", Ложь);
		// Ручная «Сверилось» относилась к прежней паре
		ОтметитьПризнакУПД(Прежняя.ИдентификаторУПД, "СвереноВручную", Ложь);
		ЭАрМ_КорректировкиУПД.СнятьСтрокиСверкиВручную(Прежняя.ИдентификаторУПД);
	КонецЕсли;

	Изменения = Новый Структура;
	Изменения.Вставить("ИдентификаторУПД",  Лев(ИдентификаторУПД, 100));
	Изменения.Вставить("СпособСвязиУПД",    ?(ЗначениеЗаполнено(ИдентификаторУПД), "Вручную", ""));
	Изменения.Вставить("ИдентификаторЭТрН", "");
	Изменения.Вставить("НомерЭТрН",         "");
	Изменения.Вставить("СпособСвязиЭТрН",   "");

	Реквизиты = РеквизитыУПД(ИдентификаторУПД);
	Изменения.Вставить("НомерУПД", Лев(Реквизиты.Номер, 50));
	Изменения.Вставить("ДатаУПД",  Реквизиты.Дата);

	ИзменитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Изменения, Ложь);

	Если ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		СвязатьЭТрН(ИдентификаторЗаказа, ИдентификаторПоступления, ИдентификаторУПД);
	КонецЕсли;

	ОтразитьПоступлениеВРеестрах(ИдентификаторЗаказа, ИдентификаторПоступления);

КонецПроцедуры

// Приходные для формы подбора: тот же поставщик, номер УПД и дата в плюс-минус
// дней. Пустой номер отбора - только окно дат. Текущая приходная УПД в списке
// всегда, даже если она вне окна.
//
// Параметры:
//   ИдентификаторУПД - Строка
//   Дней             - Число, Неопределено - плюс-минус от даты УПД; Неопределено -
//                      окно связи из настроек
//   НомерОтбора      - Строка, Неопределено - Неопределено значит номер самой УПД;
//                      пустая строка отключает отбор по номеру
//
// Возвращаемое значение:
//   Структура - НомерУПД, ДатаУПД, Представление, Дней, Номер, Строки
//
Функция ПриходныеДляВыбораУПД(ИдентификаторУПД, Дней = Неопределено, НомерОтбора = Неопределено) Экспорт

	Реквизиты = РеквизитыУПД(ИдентификаторУПД);
	Если Дней = Неопределено Тогда
		Дней = ЭАрМ_НастройкиСервер.НастройкиЦепочки().ОкноДнейСвязи;
	КонецЕсли;
	Если НомерОтбора = Неопределено Тогда
		НомерОтбора = СокрЛП(Реквизиты.Номер);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("НомерУПД", СокрЛП(Реквизиты.Номер));
	Результат.Вставить("ДатаУПД", Реквизиты.Дата);
	Результат.Вставить("Представление", СтрШаблон(НСтр("ru = 'УПД № %1 от %2'"),
		СокрЛП(Реквизиты.Номер), Формат(Реквизиты.Дата, "ДЛФ=D")));
	Результат.Вставить("Дней", Дней);
	Результат.Вставить("Номер", НомерОтбора);
	Результат.Вставить("Строки", Новый Массив);

	Если НЕ ЗначениеЗаполнено(Реквизиты.ИНН) Тогда
		Возврат Результат;
	КонецЕсли;

	ОкноСекунд = Макс(Дней, 0) * 86400;
	Текущая = ЦепочкаПоУПД(ИдентификаторУПД);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Цепочка.НомерПоступления КАК НомерПоступления,
	|	Цепочка.ДатаПоступления КАК ДатаПоступления,
	|	Цепочка.ВходящийНомер КАК ВходящийНомер,
	|	Цепочка.СуммаПоступления КАК СуммаПоступления,
	|	Цепочка.ИдентификаторУПД КАК ИдентификаторУПД,
	|	Цепочка.НомерУПД КАК НомерУПД,
	|	Цепочка.ДатаУПД КАК ДатаУПД,
	|	Цепочка.ДатаОбновления КАК ДатаОбновления,
	|	ЕСТЬNULL(УПД.КодСостояния, """") КАК КодСостояния,
	|	ЕСТЬNULL(УПД.Состояние, """") КАК Состояние
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО Цепочка.ИдентификаторУПД = УПД.ИдентификаторСБИС
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления <> """"
	|	И Цепочка.ИННПоставщика = &ИНН";
	Запрос.УстановитьПараметр("ИНН", Реквизиты.ИНН);

	Кандидаты = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ТекущаяПриходная = Текущая <> Неопределено
			И Текущая.ИдентификаторЗаказа = Выборка.ИдентификаторЗаказа
			И Текущая.ИдентификаторПоступления = Выборка.ИдентификаторПоступления;
		НомерНакладной = ?(ЗначениеЗаполнено(Выборка.ВходящийНомер),
			СокрЛП(Выборка.ВходящийНомер), СокрЛП(Выборка.НомерПоступления));
		НомерСовпал = НЕ ЗначениеЗаполнено(НомерОтбора)
			ИЛИ ЭАрМ_Служебный.НомераСовпадают(Выборка.ВходящийНомер, НомерОтбора)
			ИЛИ ЭАрМ_Служебный.НомераСовпадают(Выборка.НомерПоступления, НомерОтбора);
		ВОкне = НЕ ЗначениеЗаполнено(Реквизиты.Дата)
			ИЛИ НЕ ЗначениеЗаполнено(Выборка.ДатаПоступления)
			ИЛИ РазницаДат(Выборка.ДатаПоступления, Реквизиты.Дата) <= ОкноСекунд;
		Если НЕ ТекущаяПриходная И НЕ (НомерСовпал И ВОкне) Тогда
			Продолжить;
		КонецЕсли;

		Связи = Новый Массив;
		ДобавитьСвязьПриходной(Связи, Выборка.ИдентификаторУПД, Выборка.НомерУПД, Выборка.ДатаУПД,
			ЭАрМ_УтверждениеСБИС.ДокументЗакрытВСБИС(Выборка.КодСостояния, Выборка.Состояние));

		Кандидаты.Добавить(Новый Структура(
			"ИдентификаторЗаказа, ИдентификаторПоступления, Номер, Дата, Сумма, Привязка, Текущая, Разница, ДатаОбновления, Связи",
			Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления,
			НомерНакладной, Выборка.ДатаПоступления, Выборка.СуммаПоступления,
			"", ТекущаяПриходная,
			?(ЗначениеЗаполнено(Реквизиты.Дата), РазницаДат(Выборка.ДатаПоступления, Реквизиты.Дата), 0),
			Выборка.ДатаОбновления, Связи));

	КонецЦикла;

	Кандидаты = СвернутьОдинаковыеПриходные(Кандидаты, ИдентификаторУПД);

	Для Индекс = 0 По Кандидаты.ВГраница() Цикл
		Для Следующий = Индекс + 1 По Кандидаты.ВГраница() Цикл
			Если Кандидаты[Следующий].Разница < Кандидаты[Индекс].Разница Тогда
				Временный = Кандидаты[Индекс];
				Кандидаты[Индекс] = Кандидаты[Следующий];
				Кандидаты[Следующий] = Временный;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Результат.Строки = Кандидаты;
	Возврат Результат;

КонецФункции

// Меняет приходную выбранной УПД и сразу сверяет новую пару.
// Одна накладная остаётся на одной УПД, у одной УПД остаётся одна приходная:
// прежние пары снимаются. Если накладная уже была на другой УПД, это сказано
// в ответе.
//
// Возвращаемое значение:
//   Строка - что получилось
//
Функция СменитьПриходнуюУПД(ИдентификаторУПД, ИдентификаторЗаказа, ИдентификаторПоступления) Экспорт

	Приходная = ЗаписьЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления);
	Если Приходная = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат НСтр("ru = 'Приходная не найдена'");
	КонецЕсли;

	Если ЭАрМ_УтверждениеСБИС.ДокументРеестраЗакрыт("ЭАрМ_УПД_Входящий", ИдентификаторУПД) Тогда
		Возврат НСтр("ru = 'УПД аннулирована в СБИС. Приходную привяжите к новой УПД, которую пришлёт поставщик.'");
	КонецЕсли;

	ГдеБыла = СнятьПовторныеПарыУПДИПриходной(ИдентификаторУПД, ИдентификаторЗаказа,
		ИдентификаторПоступления, Приходная);

	СвязатьВручную(ИдентификаторЗаказа, ИдентификаторПоступления, ИдентификаторУПД);
	ЭАрМ_СверкаТоваровЦепочки.СверитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления);

	Номер = ?(ЗначениеЗаполнено(Приходная.ВходящийНомер), Приходная.ВходящийНомер, Приходная.НомерПоступления);
	Текст = СтрШаблон(НСтр("ru = 'Приходная №%1 от %2 привязана к УПД, сверка выполнена'"),
		СокрЛП(Номер), Формат(Приходная.ДатаПоступления, "ДЛФ=D"));
	Если ЗначениеЗаполнено(ГдеБыла) Тогда
		Текст = Текст + ". " + ГдеБыла;
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Снимает повтор одной и той же пары. У этой УПД не остаётся другой приходной.
// Такая же накладная (номер, день и сумма, либо тот же идентификатор) не
// остаётся на другой УПД. Саму выбранную цепочку не трогает: её перепишет
// следующая связь.
//
// Возвращаемое значение:
//   Строка - с каких чужих УПД накладная снята; пусто, если нигде больше не была
//
Функция СнятьПовторныеПарыУПДИПриходной(ИдентификаторУПД, ИдентификаторЗаказа, ИдентификаторПоступления, Приходная)

	КлючНакладной = КлючНакладнойЦепочки(Приходная.ВходящийНомер, Приходная.НомерПоступления,
		Приходная.ДатаПоступления, Приходная.СуммаПоступления);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Цепочка.ВходящийНомер КАК ВходящийНомер,
	|	Цепочка.НомерПоступления КАК НомерПоступления,
	|	Цепочка.ДатаПоступления КАК ДатаПоступления,
	|	Цепочка.СуммаПоступления КАК СуммаПоступления,
	|	Цепочка.ИдентификаторУПД КАК ИдентификаторУПД,
	|	Цепочка.НомерУПД КАК НомерУПД,
	|	Цепочка.ДатаУПД КАК ДатаУПД
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления <> """"
	|	И (Цепочка.ИННПоставщика = &ИНН
	|			ИЛИ Цепочка.ИдентификаторУПД = &ИдентификаторУПД)";
	Запрос.УстановитьПараметр("ИНН", Приходная.ИННПоставщика);
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	Чужие = Новый Массив;
	УжеСказано = Новый Соответствие;
	Если ЗначениеЗаполнено(СокрЛП(Приходная.ИдентификаторУПД))
		И СокрЛП(Приходная.ИдентификаторУПД) <> ИдентификаторУПД Тогда
		УжеСказано.Вставить(СокрЛП(Приходная.ИдентификаторУПД), Истина);
		Чужие.Добавить(ПредставлениеУПДПривязки(Приходная.НомерУПД, Приходная.ДатаУПД));
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Выборка.ИдентификаторЗаказа = ИдентификаторЗаказа
			И Выборка.ИдентификаторПоступления = ИдентификаторПоступления Тогда
			Продолжить;
		КонецЕсли;

		ИдентификаторСвязи = СокрЛП(Выборка.ИдентификаторУПД);
		Если НЕ ЗначениеЗаполнено(ИдентификаторСвязи) Тогда
			Продолжить;
		КонецЕсли;

		ТаЖеУПД = ИдентификаторСвязи = ИдентификаторУПД;
		ТаЖеНакладная = Выборка.ИдентификаторПоступления = ИдентификаторПоступления
			ИЛИ КлючНакладнойЦепочки(Выборка.ВходящийНомер, Выборка.НомерПоступления,
				Выборка.ДатаПоступления, Выборка.СуммаПоступления) = КлючНакладной;
		Если НЕ ТаЖеУПД И НЕ ТаЖеНакладная Тогда
			Продолжить;
		КонецЕсли;

		СвязатьВручную(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления, "");

		Если НЕ ТаЖеУПД И УжеСказано.Получить(ИдентификаторСвязи) = Неопределено Тогда
			УжеСказано.Вставить(ИдентификаторСвязи, Истина);
			Чужие.Добавить(ПредставлениеУПДПривязки(Выборка.НомерУПД, Выборка.ДатаУПД));
		КонецЕсли;

	КонецЦикла;

	Если Чужие.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Снята с %1, чтобы не лежать на двух УПД'"),
		СтрСоединить(Чужие, ", "));

КонецФункции

// История Далиона кладёт одну и ту же накладную несколько раз: номер, день и
// сумма совпадают, а идентификаторы разные. В подборе это одна строка.
// Текущая привязка УПД важнее, иначе берётся запись, которую обновляли позже.
// Связи всех копий собираются в колонку «К чему привязана».
//
Функция СвернутьОдинаковыеПриходные(Кандидаты, ИдентификаторУПД)

	Уникальные = Новый Соответствие;
	Порядок = Новый Массив;

	Для Каждого Кандидат Из Кандидаты Цикл

		Ключ = КлючОдинаковойПриходной(Кандидат);
		Прежняя = Уникальные.Получить(Ключ);
		Если Прежняя = Неопределено Тогда
			Уникальные.Вставить(Ключ, Кандидат);
			Порядок.Добавить(Ключ);
			Продолжить;
		КонецЕсли;

		Если ПриходнаяПодбораНовее(Кандидат, Прежняя) Тогда
			Оставить = Кандидат;
			Вливать = Прежняя;
		Иначе
			Оставить = Прежняя;
			Вливать = Кандидат;
		КонецЕсли;

		Для Каждого Связь Из Вливать.Связи Цикл
			ДобавитьСвязьПриходной(Оставить.Связи, Связь.Идентификатор, Связь.Номер, Связь.Дата, Связь.Закрыта);
		КонецЦикла;
		Если Вливать.Текущая Тогда
			Оставить.Текущая = Истина;
		КонецЕсли;
		Уникальные.Вставить(Ключ, Оставить);

	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого Ключ Из Порядок Цикл
		СтрокаПодбора = Уникальные.Получить(Ключ);
		СтрокаПодбора.Привязка = ТекстПривязкиПриходной(СтрокаПодбора.Связи,
			ИдентификаторУПД, СтрокаПодбора.Текущая);
		Результат.Добавить(СтрокаПодбора);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьСвязьПриходной(Связи, Идентификатор, Номер, Дата, Закрыта = Ложь)

	// Параметр приходит из поля выборки, его писать нельзя
	ИдентификаторСвязи = СокрЛП(Идентификатор);
	Если НЕ ЗначениеЗаполнено(ИдентификаторСвязи) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Связь Из Связи Цикл
		Если Связь.Идентификатор = ИдентификаторСвязи Тогда
			Если Закрыта Тогда
				Связь.Закрыта = Истина;
			КонецЕсли;
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Связи.Добавить(Новый Структура("Идентификатор, Номер, Дата, Закрыта",
		ИдентификаторСвязи, СокрЛП(Номер), Дата, Закрыта));

КонецПроцедуры

Функция ТекстПривязкиПриходной(Связи, ИдентификаторУПД, Текущая)

	Чужие = Новый Массив;
	ЕстьТекущая = Текущая;
	ТекущаяЗакрыта = Ложь;

	Для Каждого Связь Из Связи Цикл
		Если Связь.Идентификатор = ИдентификаторУПД Тогда
			ЕстьТекущая = Истина;
			ТекущаяЗакрыта = Связь.Закрыта;
			Продолжить;
		КонецЕсли;
		Чужие.Добавить(ПредставлениеУПДПривязки(Связь.Номер, Связь.Дата, Связь.Закрыта));
	КонецЦикла;

	Если ЕстьТекущая И Чужие.Количество() = 0 Тогда
		Текст = ?(ТекущаяЗакрыта, НСтр("ru = 'текущая, аннулирована'"), НСтр("ru = 'текущая'"));
	ИначеЕсли ЕстьТекущая Тогда
		Текст = НСтр("ru = 'текущая; ещё '") + СтрСоединить(Чужие, "; ");
	ИначеЕсли Чужие.Количество() = 0 Тогда
		Текст = НСтр("ru = 'свободна'");
	Иначе
		Текст = СтрСоединить(Чужие, "; ");
	КонецЕсли;

	Возврат Лев(Текст, 200);

КонецФункции

Функция ПредставлениеУПДПривязки(Номер, Дата, Закрыта = Ложь)

	Если Закрыта И ЗначениеЗаполнено(Дата) Тогда
		Возврат СтрШаблон(НСтр("ru = 'аннулирована УПД № %1 от %2'"), СокрЛП(Номер), Формат(Дата, "ДЛФ=D"));
	ИначеЕсли Закрыта Тогда
		Возврат СтрШаблон(НСтр("ru = 'аннулирована УПД № %1'"), СокрЛП(Номер));
	ИначеЕсли ЗначениеЗаполнено(Дата) Тогда
		Возврат СтрШаблон(НСтр("ru = 'УПД № %1 от %2'"), СокрЛП(Номер), Формат(Дата, "ДЛФ=D"));
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'УПД № %1'"), СокрЛП(Номер));

КонецФункции

Функция КлючНакладнойЦепочки(ВходящийНомер, НомерПоступления, Дата, Сумма)

	Номер = ?(ЗначениеЗаполнено(ВходящийНомер), СокрЛП(ВходящийНомер), СокрЛП(НомерПоступления));

	Возврат КлючОдинаковойПриходной(Новый Структура("Номер, Дата, Сумма", Номер, Дата, Сумма));

КонецФункции

Функция КлючОдинаковойПриходной(Кандидат)

	Возврат ВРег(СокрЛП(Кандидат.Номер)) + "|"
		+ Формат(Кандидат.Дата, "ДФ=yyyyMMdd") + "|"
		+ Формат(Кандидат.Сумма, "ЧГ=0; ЧДЦ=2");

КонецФункции

Функция ПриходнаяПодбораНовее(Кандидат, Прежняя)

	Если Кандидат.Текущая И НЕ Прежняя.Текущая Тогда
		Возврат Истина;
	КонецЕсли;

	Если Прежняя.Текущая Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Кандидат.ДатаОбновления > Прежняя.ДатаОбновления;

КонецФункции

Функция РазницаДат(Дата1, Дата2)

	Если НЕ ЗначениеЗаполнено(Дата1) ИЛИ НЕ ЗначениеЗаполнено(Дата2) Тогда
		Возврат 0;
	КонецЕсли;

	Разница = Дата1 - Дата2;
	Если Разница < 0 Тогда
		Разница = -Разница;
	КонецЕсли;

	Возврат Разница;

КонецФункции

#КонецОбласти

#Область Связи

// Принудительно ищет УПД для поступления и пересверяет цепочку. Нужна, когда
// приходная загружена позже УПД (старые приходные из архива): регламент берёт
// для связей только первые 200 открытых цепочек, и старая могла до УПД не дойти.
//
// Параметры:
//   ИдентификаторПоступления - Строка - uid приходной Далиона
//
// Возвращаемое значение:
//   Строка - что получилось
//
Функция ПерепривязатьУПДКПоступлению(ИдентификаторПоступления) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления = &ИдентификаторПоступления";
	Запрос.УстановитьПараметр("ИдентификаторПоступления", ИдентификаторПоступления);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат НСтр("ru = 'Цепочки закупки с этой приходной нет'");
	КонецЕсли;
	ИдентификаторЗаказа = Выборка.ИдентификаторЗаказа;

	Объект = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ПриходнаяНакладная", ИдентификаторПоступления);
	Если Объект = Неопределено Тогда
		Возврат НСтр("ru = 'Пакет приходной накладной не найден в данных обмена'");
	КонецЕсли;

	Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
	До = ЗаписьЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления);

	Если НЕ ЗначениеЗаполнено(До.ИдентификаторУПД) Тогда
		СвязатьСЭДО(ИдентификаторЗаказа, ИдентификаторПоступления, Объект, Настройки);
	Иначе
		ОтразитьПоступлениеВРеестрах(ИдентификаторЗаказа, ИдентификаторПоступления, Объект);
	КонецЕсли;

	После = ЗаписьЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления);
	Если После = Неопределено ИЛИ НЕ ЗначениеЗаполнено(После.ИдентификаторУПД) Тогда
		Возврат НСтр("ru = 'УПД так и не нашлась - см. «Почему нет УПД»'");
	КонецЕсли;

	Попытка
		ЭАрМ_СверкаТоваровЦепочки.СверитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Настройки);
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторПоступления,
			"ПерепривязатьУПДКПоступлению (пересверка после привязки)", ОшибкаИсключения);
		Возврат СтрШаблон(НСтр("ru = 'УПД № %1 привязана, но пересверка не прошла: %2'"),
			После.НомерУПД, КраткоеПредставлениеОшибки(ОшибкаИсключения));
	КонецПопытки;

	Возврат СтрШаблон(НСтр("ru = 'УПД № %1 привязана, цепочка пересверена'"), После.НомерУПД);

КонецФункции

// Объясняет, почему к приходной не привязана УПД: по каждому номеру приходной
// показывает УПД реестра с похожим номером и что именно её отсекает.
//
// Параметры:
//   ИдентификаторПоступления - Строка - uid приходной Далиона
//
// Возвращаемое значение:
//   Строка - построчный разбор
//
Функция ДиагностикаСвязиУПД(ИдентификаторПоступления) Экспорт

	Тексты = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления = &ИдентификаторПоступления";
	Запрос.УстановитьПараметр("ИдентификаторПоступления", ИдентификаторПоступления);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат НСтр("ru = 'Цепочки закупки с этой приходной нет'");
	КонецЕсли;

	Цепочка = ЗаписьЦепочки(Выборка.ИдентификаторЗаказа, ИдентификаторПоступления);
	Объект = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ПриходнаяНакладная", ИдентификаторПоступления);
	Если Объект = Неопределено Тогда
		Возврат НСтр("ru = 'Пакет приходной накладной не найден в данных обмена'");
	КонецЕсли;

	Поставщик = ДанныеПоставщика(Объект);
	Тексты.Добавить(СтрШаблон(НСтр("ru = 'Приходная № %1 от %2, поставщик «%3», ИНН %4. Этап цепочки: %5, пломба: %6, УПД в цепочке: %7'"),
		Цепочка.НомерПоступления, Формат(Цепочка.ДатаПоступления, "ДЛФ=D"), Поставщик.Наименование,
		?(ЗначениеЗаполнено(Поставщик.ИНН), Поставщик.ИНН, НСтр("ru = '(пусто)'")),
		Цепочка.Этап, Цепочка.СтатусПломбы,
		?(ЗначениеЗаполнено(Цепочка.ИдентификаторУПД), Цепочка.НомерУПД, НСтр("ru = 'нет'"))));

	НомераВсе = НомераДокументаДляСвязи(Объект, Истина);
	Тексты.Добавить(СтрШаблон(НСтр("ru = 'Номера для поиска УПД: %1'"),
		?(НомераВсе.Количество() = 0, НСтр("ru = 'нет (в приходной не заполнен входящий номер)'"),
			СтрСоединить(НомераВсе, ", "))));

	Если НомераВсе.Количество() = 0 Тогда
		Возврат СтрСоединить(Тексты, Символы.ПС);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК Идентификатор,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.ИННКонтрагента КАК ИНН,
	|	УПД.Формат КАК Формат,
	|	УПД.КодСостояния КАК КодСостояния,
	|	УПД.Состояние КАК Состояние,
	|	Занятые.ИдентификаторПоступления КАК ЗанятаПоступлением,
	|	Занятые.НомерПоступления КАК ЗанятаНомером
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Занятые
	|		ПО УПД.ИдентификаторСБИС = Занятые.ИдентификаторУПД
	|			И Занятые.ИдентификаторПоступления <> """"
	|ГДЕ
	|	УПД.Номер <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	УПД.Дата УБЫВ";

	Найдено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Совпал = Ложь;
		Для Каждого Номер Из НомераВсе Цикл
			Если ЭАрМ_Служебный.НомераСовпадают(Выборка.Номер, Номер) Тогда
				Совпал = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Совпал Тогда
			Продолжить;
		КонецЕсли;

		Найдено = Найдено + 1;
		Причины = Новый Массив;
		Если Выборка.Формат = "УКД" Тогда
			Причины.Добавить(НСтр("ru = 'это корректировка (УКД), а не УПД'"));
		КонецЕсли;
		Если ЭАрМ_УтверждениеСБИС.ДокументЗакрытВСБИС(Выборка.КодСостояния, Выборка.Состояние) Тогда
			Причины.Добавить(НСтр("ru = 'документ аннулирован/закрыт в СБИС'"));
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ЗанятаПоступлением) И Выборка.ЗанятаПоступлением <> ИдентификаторПоступления Тогда
			Причины.Добавить(СтрШаблон(НСтр("ru = 'уже привязана к другой приходной № %1'"), Выборка.ЗанятаНомером));
		КонецЕсли;
		Если НЕ ИННСовпадает(Выборка.ИНН, Поставщик.ИНН) Тогда
			Причины.Добавить(СтрШаблон(НСтр("ru = 'ИНН поставщика не совпал: в УПД %1, в приходной %2'"),
				Выборка.ИНН, Поставщик.ИНН));
		КонецЕсли;
		Если ЗначениеЗаполнено(Цепочка.ИдентификаторУПД) И Цепочка.ИдентификаторУПД = Выборка.Идентификатор Тогда
			Причины.Добавить(НСтр("ru = 'уже привязана к этой приходной'"));
		КонецЕсли;

		Тексты.Добавить(СтрШаблон(НСтр("ru = 'УПД № %1 от %2 (%3, состояние: %4): %5'"),
			Выборка.Номер, Формат(Выборка.Дата, "ДЛФ=D"), Выборка.Формат,
			?(ЗначениеЗаполнено(Выборка.Состояние), Выборка.Состояние, Выборка.КодСостояния),
			?(Причины.Количество() = 0, НСтр("ru = 'препятствий нет - нажмите «Привязать УПД»'"),
				СтрСоединить(Причины, "; "))));

	КонецЦикла;

	Если Найдено = 0 Тогда
		Тексты.Добавить(НСтр("ru = 'В реестре УПД нет документа с таким номером: он старше окна реестра (3 дня) и ещё не загружен. Загрузите его кнопкой «Запросить УПД к приходным» или «Запросить реестр за период» в реестре УПД.'"));
	КонецЕсли;

	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

// Ищет УПД для поступления и через неё ЭТрН.
//
Процедура СвязатьСЭДО(ИдентификаторЗаказа, ИдентификаторПоступления, Объект, Настройки)

	Поставщик = ДанныеПоставщика(Объект);
	ДатаПоступления = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "date", ""));

	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
		"Поиск УПД: по номерам [%1], ИНН %2, дата %3, окно %4 дн.",
		СтрСоединить(НомераДокументаДляСвязи(Объект, Истина), ", "), Поставщик.ИНН,
		Формат(ДатаПоступления, "ДЛФ=D"), Настройки.ОкноДнейСвязи));

	Найденный = УПДПоНомеру(Объект, Поставщик.ИНН, ДатаПоступления, ИдентификаторПоступления);

	Если ЗначениеЗаполнено(Найденный.Идентификатор) Тогда
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления,
			"Поиск УПД: найдена по номеру - " + Найденный.Идентификатор);
	ИначеЕсли ЗначениеЗаполнено(Найденный.ИдентификаторЭТрН) Тогда
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления,
			"Поиск УПД: по номеру нашлась только ЭТрН " + Найденный.НомерЭТрН + ", УПД у неё нет");
	Иначе
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления,
			"Поиск УПД: по номеру не найдена (нет в реестре УПД с таким номером и ИНН, или занята другой приходной, или закрыта) - ищу по товарам", Ложь);
		Найденный = УПДПоТоварам(Объект, Поставщик.ИНН, ДатаПоступления, ИдентификаторПоступления, Настройки);
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления,
			?(ЗначениеЗаполнено(Найденный.Идентификатор),
				"Поиск УПД: найдена по штрихкодам всех строк - " + Найденный.Идентификатор,
				"Поиск УПД: по товарам не найдена (нет УПД того же ИНН в окне дат, где все строки сошлись по штрихкодам)"),
			ЗначениеЗаполнено(Найденный.Идентификатор));
		Если НЕ ЗначениеЗаполнено(Найденный.Идентификатор) Тогда
			ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления,
				"Поиск УПД: " + КандидатыУПДДляТрассы(Поставщик.ИНН, ДатаПоступления,
					Настройки.ОкноДнейСвязи, ИдентификаторПоступления,
					НомераДокументаДляСвязи(Объект, Истина)), Ложь);
		КонецЕсли;
	КонецЕсли;

	Изменения = Новый Структура;

	Если ЗначениеЗаполнено(Найденный.Идентификатор) Тогда
		Реквизиты = РеквизитыУПД(Найденный.Идентификатор);
		Изменения.Вставить("ИдентификаторУПД", Лев(Найденный.Идентификатор, 100));
		Изменения.Вставить("НомерУПД",         Лев(Реквизиты.Номер, 50));
		Изменения.Вставить("ДатаУПД",          Реквизиты.Дата);
		Изменения.Вставить("СпособСвязиУПД",   Найденный.Способ);
	КонецЕсли;

	// Номер привёл только к ЭТрН без УПД - запоминаем хотя бы её
	Если ЗначениеЗаполнено(Найденный.ИдентификаторЭТрН) И ЭТрНВЦепочке() Тогда
		Изменения.Вставить("ИдентификаторЭТрН", Лев(Найденный.ИдентификаторЭТрН, 100));
		Изменения.Вставить("НомерЭТрН",         Лев(Найденный.НомерЭТрН, 50));
		Изменения.Вставить("СпособСвязиЭТрН",   Найденный.Способ);
	КонецЕсли;

	Если Изменения.Количество() > 0 Тогда
		ИзменитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Изменения, Ложь);
	КонецЕсли;

	Если ЗначениеЗаполнено(Найденный.Идентификатор) И НЕ ЗначениеЗаполнено(Найденный.ИдентификаторЭТрН) Тогда
		СвязатьЭТрН(ИдентификаторЗаказа, ИдентификаторПоступления, Найденный.Идентификатор);
	КонецЕсли;

	// Ни номер, ни УПД не привели к ЭТрН - ищем её по самому приходу
	СвязатьЭТрНПоПриходу(ИдентификаторЗаказа, ИдентификаторПоступления, Объект, Настройки);

	ОтразитьПоступлениеВРеестрах(ИдентификаторЗаказа, ИдентификаторПоступления, Объект);

КонецПроцедуры

// ЭТрН к цепочке не привязывается (решение пользователя 14.10.2026): в цепочке
// только заказ, приходная Далиона и УПД. ЭТрН остаётся в реестре ЭТрН из СБИС.
// Вернуть - Истина.
//
Функция ЭТрНВЦепочке() Экспорт

	Возврат Ложь;

КонецФункции

Процедура СвязатьЭТрН(ИдентификаторЗаказа, ИдентификаторПоступления, ИдентификаторУПД)

	Если НЕ ЭТрНВЦепочке() Тогда
		Возврат;
	КонецЕсли;

	Реквизиты = РеквизитыУПД(ИдентификаторУПД);
	НайденнаяЭТрН = ЭАрМ_РегламентныйОбменЭДО.НайтиЭТрНДляУПД(ИдентификаторУПД, Реквизиты.Номер, Реквизиты.КлючиСвязи);

	Если НЕ ЗначениеЗаполнено(НайденнаяЭТрН.Идентификатор) Тогда
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
			"ЭТрН: к УПД № %1 ЭТрН в реестре ЭТрН не найдена (по ссылке на УПД, ключам и номеру)", Реквизиты.Номер));
		Возврат;
	КонецЕсли;

	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
		"ЭТрН: к УПД № %1 найдена ЭТрН № %2 (%3) - связь «УПД»", Реквизиты.Номер,
		НайденнаяЭТрН.Номер, НайденнаяЭТрН.Идентификатор));

	Изменения = Новый Структура;
	Изменения.Вставить("ИдентификаторЭТрН", Лев(НайденнаяЭТрН.Идентификатор, 100));
	Изменения.Вставить("НомерЭТрН",         Лев(НайденнаяЭТрН.Номер, 50));
	Изменения.Вставить("СпособСвязиЭТрН",   "УПД");

	ИзменитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Изменения, Ложь);

КонецПроцедуры

// ЭТрН к приходу Далиона без посредничества УПД. Кандидаты: ЭТрН того же
// поставщика (ИНН обязателен с обеих сторон), с датой в окне вокруг даты
// поступления, ещё не занятые другой поставкой. Товары не обязательны:
// приход всегда фиксирует ЭТрН. Из подходящих берётся лучший: склад весит
// больше доли товаров, при равенстве побеждает ближайшая дата.
// Связь ставится со способом "Приход".
//
Процедура СвязатьЭТрНПоПриходу(ИдентификаторЗаказа, ИдентификаторПоступления, Объект, Настройки)

	Если НЕ ЭТрНВЦепочке() Тогда
		Возврат;
	КонецЕсли;

	Цепочка = ЗаписьЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления);
	Если Цепочка = Неопределено ИЛИ ЗначениеЗаполнено(Цепочка.ИдентификаторЭТрН) Тогда
		Возврат;
	КонецЕсли;

	ИННПоставщика = Цепочка.ИННПоставщика;
	Если НЕ ЗначениеЗаполнено(ИННПоставщика) Тогда
		ИННПоставщика = ДанныеПоставщика(Объект).ИНН;
	КонецЕсли;

	Найденная = ЭТрНПоПриходу(Объект, ИННПоставщика, ИдентификаторПоступления, Настройки);
	Если НЕ ЗначениеЗаполнено(Найденная.Идентификатор) Тогда
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
			"ЭТрН: по приходу (ИНН %1, окно %2 дн.) свободной ЭТрН нет", ИННПоставщика, Настройки.ОкноДнейСвязи));
		Возврат;
	КонецЕсли;

	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторПоступления, СтрШаблон(
		"ЭТрН: по приходу (ИНН %1) привязана ЭТрН № %2 (%3) - связь «Приход»", ИННПоставщика,
		Найденная.Номер, Найденная.Идентификатор));

	Изменения = Новый Структура;
	Изменения.Вставить("ИдентификаторЭТрН", Лев(Найденная.Идентификатор, 100));
	Изменения.Вставить("НомерЭТрН",         Лев(Найденная.Номер, 50));
	Изменения.Вставить("СпособСвязиЭТрН",   "Приход");

	ИзменитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Изменения, Ложь);

КонецПроцедуры

// Возвращаемое значение:
//   Структура - Идентификатор, Номер; пустые, если подходящей ЭТрН нет
//
Функция ЭТрНПоПриходу(Объект, ИННПоставщика, ИдентификаторПоступления, Настройки)

	Результат = Новый Структура("Идентификатор, Номер", "", "");

	ДатаПоступления = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "date", ""));
	Если НЕ ЗначениеЗаполнено(ИННПоставщика) ИЛИ НЕ ЗначениеЗаполнено(ДатаПоступления) Тогда
		Возврат Результат;
	КонецЕсли;

	Склад = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеПоПути(Объект, "warehouse.name", "")));
	Окно  = Настройки.ОкноДнейСвязи * 86400;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭТрН.ИдентификаторСБИС КАК Идентификатор,
	|	ЭТрН.Номер КАК Номер,
	|	ЭТрН.Дата КАК Дата,
	|	ЭТрН.ИННКонтрагента КАК ИНН,
	|	ЭТрН.АдресДоставки КАК АдресДоставки
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Занятые
	|		ПО ЭТрН.ИдентификаторСБИС = Занятые.ИдентификаторЭТрН
	|			И Занятые.ИдентификаторПоступления <> &ИдентификаторПоступления
	|ГДЕ
	|	ЭТрН.Дата МЕЖДУ &ДатаС И &ДатаПо
	|	И ЭТрН.ИННКонтрагента <> """"
	|	И Занятые.ИдентификаторЭТрН ЕСТЬ NULL
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("ЭТрН");
	Запрос.УстановитьПараметр("ДатаС", НачалоДня(ДатаПоступления) - Окно);
	Запрос.УстановитьПараметр("ДатаПо", КонецДня(ДатаПоступления) + Окно);
	Запрос.УстановитьПараметр("ИдентификаторПоступления", ИдентификаторПоступления);

	Кандидаты = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Пустой ИНН здесь не в пользу связи: по дате и складу без поставщика
		// легко привязать чужую машину
		Если ИННСовпадает(Выборка.ИНН, ИННПоставщика) Тогда
			Кандидаты.Добавить(Новый Структура("Идентификатор, Номер, Дата, ПоСкладу, Доля",
				СокрЛП(Выборка.Идентификатор), СокрЛП(Выборка.Номер), Выборка.Дата,
				СкладВАдресе(Склад, Выборка.АдресДоставки), 0));
		КонецЕсли;
	КонецЦикла;

	Если Кандидаты.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Доля общих товаров - одним запросом по всем кандидатам
	Идентификаторы = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Идентификаторы.Добавить(Кандидат.Идентификатор);
	КонецЦикла;

	ЗапросТоваров = Новый Запрос;
	ЗапросТоваров.Текст =
	"ВЫБРАТЬ
	|	Товары.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Товары.Наименование КАК Наименование,
	|	Товары.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС В (&Идентификаторы)
	|	И Товары.ИсточникТоваров <> ""База2""";
	ЗапросТоваров.УстановитьПараметр("Идентификаторы", Идентификаторы);

	ТоварыКандидатов = Новый Соответствие;
	ВыборкаТоваров = ЗапросТоваров.Выполнить().Выбрать();
	Пока ВыборкаТоваров.Следующий() Цикл
		Ключ = СокрЛП(ВыборкаТоваров.ИдентификаторСБИС);
		Строки = ТоварыКандидатов.Получить(Ключ);
		Если Строки = Неопределено Тогда
			Строки = Новый Массив;
			ТоварыКандидатов.Вставить(Ключ, Строки);
		КонецЕсли;
		Строки.Добавить(КлючиТовара(ВыборкаТоваров.Наименование, ЗначениеВМассиве(ВыборкаТоваров.Штрихкод)));
	КонецЦикла;

	ТоварыПоступления = КлючиТоваровДалиона(Объект);

	Лучший = Неопределено;
	ЛучшаяОценка = 0;
	ЛучшаяРазница = 0;

	Для Каждого Кандидат Из Кандидаты Цикл

		Строки = ТоварыКандидатов.Получить(Кандидат.Идентификатор);
		Если Строки <> Неопределено Тогда
			Кандидат.Доля = ДоляОбщихТоваров(ТоварыПоступления, Строки);
		КонецЕсли;

		Оценка  = ?(Кандидат.ПоСкладу, 2, 0) + Кандидат.Доля;
		Разница = Макс(Кандидат.Дата - ДатаПоступления, ДатаПоступления - Кандидат.Дата);

		Если Лучший = Неопределено ИЛИ Оценка > ЛучшаяОценка
			ИЛИ Оценка = ЛучшаяОценка И Разница < ЛучшаяРазница Тогда
			Лучший = Кандидат;
			ЛучшаяОценка = Оценка;
			ЛучшаяРазница = Разница;
		КонецЕсли;

	КонецЦикла;

	Если Лучший <> Неопределено Тогда
		Результат.Идентификатор = Лучший.Идентификатор;
		Результат.Номер         = Лучший.Номер;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Склад Далиона называют по-своему ("Магазин на Центральной"), а в ЭТрН лежит
// полный адрес доставки. Совпадением считаем, что основа значимого слова из
// названия склада - первые пять букв слова длиннее трёх - есть в адресе.
// Служебные слова вроде "магазин" и "склад" не учитываются.
//
Функция СкладВАдресе(Склад, АдресДоставки)

	Адрес = СтрЗаменить(ВРег(СокрЛП(АдресДоставки)), "Ё", "Е");
	Если НЕ ЗначениеЗаполнено(Склад) ИЛИ НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Ложь;
	КонецЕсли;

	Текст = СтрЗаменить(ВРег(Склад), "Ё", "Е");
	Знаки = ",.;:()""'-/\№#";
	Для Позиция = 1 По СтрДлина(Знаки) Цикл
		Текст = СтрЗаменить(Текст, Сред(Знаки, Позиция, 1), " ");
	КонецЦикла;

	Служебные = "|МАГАЗИН|СКЛАД|ОСНОВНОЙ|ГЛАВНЫЙ|ТОРГОВЫЙ|ЦЕНТРАЛЬНЫЙ СКЛАД|ГОРОД|УЛИЦА|ОБЛАСТЬ|РАЙОН|";

	Для Каждого Слово Из СтрРазделить(Текст, " ", Ложь) Цикл
		Если СтрДлина(Слово) < 4 ИЛИ СтрНайти(Служебные, "|" + Слово + "|") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Адрес, Лев(Слово, 5)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// УПД по номерам поступления. Один кандидат берём даже при разном ИНН:
// в тесте ИНН СБИС и Далиона часто не совпадают по формату. Если кандидатов
// несколько, сначала ИНН, затем ближайшая дата.
//
// Возвращаемое значение:
//   Структура - Идентификатор, Способ, ИдентификаторЭТрН, НомерЭТрН
//
Функция УПДПоНомеру(Объект, ИННПоставщика, ДатаПоступления = Неопределено, ИдентификаторПоступления = "")

	Результат = Новый Структура("Идентификатор, Способ, ИдентификаторЭТрН, НомерЭТрН", "", "", "", "");

	НомераЭДО = НомераДокументаДляСвязи(Объект, Ложь);
	НомераВсе = НомераДокументаДляСвязи(Объект, Истина);
	Номера = ?(НомераЭДО.Количество() > 0, НомераЭДО, НомераВсе);

	Выбранный = ВыбратьУПДИзНомеров(НомераЭДО, ИННПоставщика, ДатаПоступления, ИдентификаторПоступления);
	Если НЕ ЗначениеЗаполнено(Выбранный) Тогда
		Выбранный = ВыбратьУПДИзНомеров(НомераВсе, ИННПоставщика, ДатаПоступления, ИдентификаторПоступления);
	КонецЕсли;
	Если ЗначениеЗаполнено(Выбранный) Тогда
		Результат.Идентификатор = Выбранный;
		Результат.Способ = "Номер";
		Возврат Результат;
	КонецЕсли;

	Для Каждого Номер Из Номера Цикл

		Найденный = ЭАрМ_РегламентныйОбменЭДО.НайтиДокументЭДОПоНомеру(Номер);
		Если Найденный.Реестр <> "ЭТрН" ИЛИ НЕ ЗначениеЗаполнено(Найденный.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;

		РеквизитыЭТрН = РеквизитыЭТрН(Найденный.Идентификатор);
		Результат.ИдентификаторЭТрН = Найденный.Идентификатор;
		Результат.НомерЭТрН         = РеквизитыЭТрН.Номер;
		Результат.Идентификатор     = РеквизитыЭТрН.ИдентификаторУПД;
		Результат.Способ            = "Номер";

		// ЭТрН ещё ссылается на аннулированную УПД: её не берём, иначе цепочка
		// привязалась бы к ней снова сразу после отвязки
		Если ЭАрМ_УтверждениеСБИС.ДокументРеестраЗакрыт("ЭАрМ_УПД_Входящий",
			СокрЛП(Результат.Идентификатор)) Тогда
			Результат.Идентификатор = "";
		КонецЕсли;
		Возврат Результат;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Для трассы: какие УПД этого поставщика есть в реестре в окне дат и почему
// каждая не подошла - занята другой приходной, закрыта, это УКД, номер не
// совпал. Нет ни одной - реестр УПД за эти даты не загружен из СБИС.
//
// Возвращаемое значение:
//   Строка
//
Функция КандидатыУПДДляТрассы(ИННПоставщика, ДатаПоступления, ОкноДней, ИдентификаторПоступления, Номера)

	Опорная = ?(ЗначениеЗаполнено(ДатаПоступления), ДатаПоступления, ТекущаяДатаСеанса());
	Окно = Макс(ОкноДней, 1) * 86400;
	ДатаС = НачалоДня(Опорная - Окно);
	ДатаПо = КонецДня(Опорная + Окно);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 15
	|	УПД.ИдентификаторСБИС КАК Идентификатор,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.ИННКонтрагента КАК ИНН,
	|	УПД.Формат КАК Формат,
	|	УПД.Состояние КАК Состояние,
	|	МАКСИМУМ(Занятые.ИдентификаторПоступления) КАК ЗанятаПоступлением
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Занятые
	|		ПО УПД.ИдентификаторСБИС = Занятые.ИдентификаторУПД
	|			И Занятые.ИдентификаторПоступления <> """"
	|ГДЕ
	|	УПД.Дата МЕЖДУ &ДатаС И &ДатаПо
	|	И (УПД.ИННКонтрагента = """"
	|			ИЛИ ПОДСТРОКА(УПД.ИННКонтрагента, 1, 10) = ПОДСТРОКА(&ИНН, 1, 10))
	|
	|СГРУППИРОВАТЬ ПО
	|	УПД.ИдентификаторСБИС, УПД.Номер, УПД.Дата, УПД.ИННКонтрагента, УПД.Формат, УПД.Состояние
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("ДатаС", ДатаС);
	Запрос.УстановитьПараметр("ДатаПо", ДатаПо);
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИННПоставщика));

	Части = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		НомерСовпал = Ложь;
		Для Каждого Номер Из Номера Цикл
			Если ЭАрМ_Служебный.НомераСовпадают(Выборка.Номер, Номер) Тогда
				НомерСовпал = Истина;
			КонецЕсли;
		КонецЦикла;

		Причина = "";
		Если Выборка.Формат = "УКД" Тогда
			Причина = "это УКД";
		ИначеЕсли ЭАрМ_УтверждениеСБИС.ДокументРеестраЗакрыт("ЭАрМ_УПД_Входящий", Выборка.Идентификатор) Тогда
			Причина = "закрыта в СБИС (" + Выборка.Состояние + ")";
		ИначеЕсли ЗначениеЗаполнено(Выборка.ЗанятаПоступлением)
			И Выборка.ЗанятаПоступлением <> ИдентификаторПоступления Тогда
			Причина = "занята приходной " + Выборка.ЗанятаПоступлением;
		ИначеЕсли НЕ НомерСовпал Тогда
			Причина = "номер не совпал";
		Иначе
			Причина = "ПОДХОДИТ - проверьте ИНН: в УПД «" + Выборка.ИНН + "»";
		КонецЕсли;

		Части.Добавить(СтрШаблон("№%1 от %2%3: %4", Выборка.Номер, Формат(Выборка.Дата, "ДЛФ=D"),
			?(НомерСовпал, " (номер совпал)", ""), Причина));

	КонецЦикла;

	Если Части.Количество() = 0 Тогда
		Возврат СтрШаблон("в реестре УПД нет ни одной УПД с ИНН %1 за %2 - %3: реестр за эти даты не загружен из СБИС или ИНН в УПД другой",
			ИННПоставщика, Формат(ДатаС, "ДЛФ=D"), Формат(ДатаПо, "ДЛФ=D"));
	КонецЕсли;

	Возврат СтрШаблон("в реестре за %1 - %2 у ИНН %3 есть: %4", Формат(ДатаС, "ДЛФ=D"),
		Формат(ДатаПо, "ДЛФ=D"), ИННПоставщика, СтрСоединить(Части, "; "));

КонецФункции

Функция ВыбратьУПДИзНомеров(Номера, ИННПоставщика, ДатаПоступления, ИдентификаторПоступления)

	КандидатыУПД = Новый Массив;
	Для Каждого Номер Из Номера Цикл
		Для Каждого Кандидат Из УПДПоГибкомуНомеру(Номер, ИдентификаторПоступления) Цикл
			УжеЕсть = Ложь;
			Для Каждого Добавленный Из КандидатыУПД Цикл
				Если Добавленный.Идентификатор = Кандидат.Идентификатор Тогда
					УжеЕсть = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ УжеЕсть Тогда
				КандидатыУПД.Добавить(Кандидат);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат ВыбратьУПДПоНомеру(КандидатыУПД, ИННПоставщика, ДатаПоступления);

КонецФункции

Функция УПДПоГибкомуНомеру(НомерДокумента, ИдентификаторПоступления = "")

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК Идентификатор,
	|	УПД.Номер КАК Номер,
	|	УПД.ИННКонтрагента КАК ИНН,
	|	УПД.Дата КАК Дата
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Занятые
	|		ПО УПД.ИдентификаторСБИС = Занятые.ИдентификаторУПД
	|			И Занятые.ИдентификаторПоступления <> """"
	|			И Занятые.ИдентификаторПоступления <> &ИдентификаторПоступления
	|ГДЕ
	|	УПД.Номер <> """"
	|	И УПД.Формат <> ""УКД""
	|	И Занятые.ИдентификаторУПД ЕСТЬ NULL
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УПД") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	УПД.Дата УБЫВ";
	Запрос.УстановитьПараметр("ИдентификаторПоступления",
		?(ЗначениеЗаполнено(ИдентификаторПоступления), ИдентификаторПоступления, "---"));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЭАрМ_Служебный.НомераСовпадают(Выборка.Номер, НомерДокумента) Тогда
			Кандидат = Новый Структура("Идентификатор, ИНН, Дата",
				СокрЛП(Выборка.Идентификатор), СокрЛП(Выборка.ИНН), Выборка.Дата);
			Результат.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВыбратьУПДПоНомеру(Кандидаты, ИННПоставщика, ДатаПоступления)

	// Явно другой ИНН - чужая УПД с тем же номером: номера у поставщиков
	// повторяются. Пустой ИНН и разный формат ИННСовпадает прощает
	Подходящие = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если ИННСовпадает(Кандидат.ИНН, ИННПоставщика) Тогда
			Подходящие.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;

	Если Подходящие.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Если Подходящие.Количество() = 1 Тогда
		Возврат Подходящие[0].Идентификатор;
	КонецЕсли;

	СИнН = Новый Массив;
	Для Каждого Кандидат Из Подходящие Цикл
		Если ЗначениеЗаполнено(ИННПоставщика) И ЗначениеЗаполнено(Кандидат.ИНН) Тогда
			СИнН.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;

	Список = ?(СИнН.Количество() > 0, СИнН, Подходящие);
	Если Список.Количество() = 1 Тогда
		Возврат Список[0].Идентификатор;
	КонецЕсли;

	Лучший = "";
	ЛучшаяРазница = Неопределено;
	ОпорнаяДата = ?(ЗначениеЗаполнено(ДатаПоступления), ДатаПоступления, ТекущаяДатаСеанса());
	// История Далиона приносит прошлогодние накладные с тем же номером.
	// Без окна ближайшей оказывалась любая, даже за прошлый год.
	ОкноСекунд = 0;
	Если ЗначениеЗаполнено(ДатаПоступления) Тогда
		ОкноСекунд = ЭАрМ_НастройкиСервер.НастройкиЦепочки().ОкноДнейСвязи * 86400;
	КонецЕсли;
	Для Каждого Кандидат Из Список Цикл
		Разница = Кандидат.Дата - ОпорнаяДата;
		Если Разница < 0 Тогда
			Разница = -Разница;
		КонецЕсли;
		Если ОкноСекунд > 0
			И (НЕ ЗначениеЗаполнено(Кандидат.Дата) ИЛИ Разница > ОкноСекунд) Тогда
			Продолжить;
		КонецЕсли;
		Если ЛучшаяРазница = Неопределено ИЛИ Разница < ЛучшаяРазница Тогда
			ЛучшаяРазница = Разница;
			Лучший = Кандидат.Идентификатор;
		КонецЕсли;
	КонецЦикла;

	Возврат Лучший;

КонецФункции

// Номер ввели с ошибкой: берём УПД того же поставщика в окне дат только при
// полном совпадении всех строк по штрихкодам.
//
Функция УПДПоТоварам(Объект, ИННПоставщика, ДатаПоступления, ИдентификаторПоступления, Настройки)

	Результат = Новый Структура("Идентификатор, Способ, ИдентификаторЭТрН, НомерЭТрН", "", "", "", "");

	Если НЕ ЗначениеЗаполнено(ДатаПоступления) Тогда
		ДатаПоступления = ТекущаяДатаСеанса();
	КонецЕсли;

	Окно = Настройки.ОкноДнейСвязи * 86400;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ПОМЕСТИТЬ Кандидаты
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Занятые
	|		ПО УПД.ИдентификаторСБИС = Занятые.ИдентификаторУПД
	|			И Занятые.ИдентификаторПоступления <> &ИдентификаторПоступления
	|ГДЕ
	|	УПД.Дата МЕЖДУ &ДатаС И &ДатаПо
	|	И УПД.Формат <> ""УКД""
	|	И (&БезИНН = ИСТИНА
	|			ИЛИ УПД.ИННКонтрагента = """"
	|			ИЛИ УПД.ИННКонтрагента = &ИНН
	|			ИЛИ ПОДСТРОКА(УПД.ИННКонтрагента, 1, 10) = ПОДСТРОКА(&ИНН, 1, 10))
	|	И Занятые.ИдентификаторУПД ЕСТЬ NULL
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УПД") + "
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдентификаторСБИС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Товары.Наименование КАК Наименование,
	|	Товары.Штрихкод КАК Штрихкод
	|ИЗ
	|	Кандидаты КАК Кандидаты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ПО Кандидаты.ИдентификаторСБИС = Товары.ИдентификаторСБИС
	|ГДЕ
	|	Товары.ИсточникТоваров = ""УПД""";
	Запрос.УстановитьПараметр("ИНН", ИННПоставщика);
	Запрос.УстановитьПараметр("БезИНН", НЕ ЗначениеЗаполнено(ИННПоставщика));
	Запрос.УстановитьПараметр("ДатаС", ДатаПоступления - Окно);
	Запрос.УстановитьПараметр("ДатаПо", КонецДня(ДатаПоступления) + Окно);
	Запрос.УстановитьПараметр("ИдентификаторПоступления", ИдентификаторПоступления);

	ТоварыКандидатов = Новый Соответствие;
	Выборка = Запрос.ВыполнитьПакет()[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Строки = ТоварыКандидатов.Получить(Выборка.ИдентификаторСБИС);
		Если Строки = Неопределено Тогда
			Строки = Новый Массив;
			ТоварыКандидатов.Вставить(Выборка.ИдентификаторСБИС, Строки);
		КонецЕсли;
		Строки.Добавить(КлючиТовара(Выборка.Наименование, ЗначениеВМассиве(Выборка.Штрихкод)));
	КонецЦикла;

	ТоварыПоступления = КлючиТоваровДалиона(Объект);

	ЛучшаяДоля = 0;
	Для Каждого КлючЗначение Из ТоварыКандидатов Цикл
		Доля = ДоляОбщихШтрихкодов(ТоварыПоступления, КлючЗначение.Значение);
		Если Доля > ЛучшаяДоля Тогда
			ЛучшаяДоля = Доля;
			Результат.Идентификатор = КлючЗначение.Ключ;
		КонецЕсли;
	КонецЦикла;

	Если ЛучшаяДоля < 1 Тогда
		Результат.Идентификатор = "";
	Иначе
		Результат.Способ = "Штрихкод";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Уже связанную цепочку дописывает в реестр УПД: пакет принят, а колонки
// Далиона в форме пустые, пока нет НомерДокументаДалион и строк База2.
//
Процедура ОтразитьЦепочкиБезЗаписиВРеестре()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 200
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО Цепочка.ИдентификаторУПД = УПД.ИдентификаторСБИС
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления <> """"
	|	И Цепочка.ИдентификаторУПД <> """"
	|	И Цепочка.Этап <> ""Закрыто""
	|	И (УПД.НомерДокументаДалион ЕСТЬ NULL
	|			ИЛИ УПД.НомерДокументаДалион = """")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Цепочка.ДатаОбновления УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ОтразитьПоступлениеВРеестрах(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления);
		Исключение
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(Выборка.ИдентификаторПоступления, 100),
				ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(), Ложь,
				"Реестр УПД: " + ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Процедура ОтразитьПоступлениеВРеестрах(ИдентификаторЗаказа, ИдентификаторПоступления, Объект = Неопределено)

	Цепочка = ЗаписьЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления);
	Если Цепочка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Цепочка.ИдентификаторУПД)
		И НЕ ЗначениеЗаполнено(Цепочка.ИдентификаторЭТрН) Тогда
		Возврат;
	КонецЕсли;

	Если Объект = Неопределено Тогда
		Объект = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ПриходнаяНакладная", ИдентификаторПоступления);
	КонецЕсли;

	ЭАрМ_РегламентныйОбменЭДО.ОтразитьПриходДалионаВРеестреЭДО(
		Цепочка.ИдентификаторУПД, Цепочка.ИдентификаторЭТрН,
		ОписаниеПриходаДляРеестра(Объект, Цепочка));

	// Приход связан с УПД - сводка реестра УПД (сумма и статус приходной)
	ЭАрМ_РегламентныйОбменЭДО.ОбновитьСводкуУПД(Цепочка.ИдентификаторУПД);

	// Контроль: что реально лежит в строке реестра УПД после записи
	Если ЗначениеЗаполнено(Цепочка.ИдентификаторУПД) Тогда
		СтрокаРеестра = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
		СтрокаРеестра.ИдентификаторСБИС = Цепочка.ИдентификаторУПД;
		СтрокаРеестра.Прочитать();
		Если СтрокаРеестра.Выбран() Тогда
			ЭАрМ_ПриемПакетовДалион.Трасса(Цепочка.ИдентификаторУПД, СтрШаблон(
				"Документ: строка реестра УПД № %1 теперь: приход Далиона № %2 от %3 на %4, статус Далион «%5», сумма приходной %6, статус приходной «%7», сверка: расхождений нет = %8",
				СтрокаРеестра.Номер, СтрокаРеестра.НомерДокументаДалион, Формат(СтрокаРеестра.ДатаДокументаДалион, "ДЛФ=D"),
				Формат(СтрокаРеестра.СуммаДокументаДалион, "ЧДЦ=2; ЧГ=0"), СтрокаРеестра.СтатусДалион,
				Формат(СтрокаРеестра.СуммаПриходной, "ЧДЦ=2; ЧГ=0"), СтрокаРеестра.СтатусПриходной, СтрокаРеестра.РасхожденийНет),
				ЗначениеЗаполнено(СтрокаРеестра.НомерДокументаДалион));
			Если НЕ ЗначениеЗаполнено(СтрокаРеестра.НомерДокументаДалион) Тогда
				ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(Цепочка.ИдентификаторУПД, "ОтразитьПоступлениеВРеестрах",
					"после записи прихода в строке реестра УПД пусто «Номер документа Далион» - колонки Далиона на форме останутся пустыми");
			КонецЕсли;
		Иначе
			ЭАрМ_ПриемПакетовДалион.Трасса(Цепочка.ИдентификаторУПД,
				"Документ: строки реестра УПД " + Цепочка.ИдентификаторУПД + " нет - приход в реестр УПД не попал", Ложь);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ОписаниеПриходаДляРеестра(Объект, Цепочка)

	Приход = Новый Структура;
	Приход.Вставить("Номер", ?(Цепочка = Неопределено, "", Цепочка.НомерПоступления));
	Приход.Вставить("Дата", ?(Цепочка = Неопределено, '00010101', Цепочка.ДатаПоступления));
	Приход.Вставить("Сумма", ?(Цепочка = Неопределено, 0, Цепочка.СуммаПоступления));
	Приход.Вставить("Проведен", Цепочка <> Неопределено И Цепочка.ПроведеноПоступление);
	Приход.Вставить("Статус", "Получен");
	Приход.Вставить("Комментарий", "");
	Приход.Вставить("Позиции", ПозицииПриходаИзОбъекта(Объект));

	Если Объект <> Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(Приход.Номер) Тогда
			Приход.Номер = ЗначениеСтрокой(Объект, "number");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Приход.Дата) Тогда
			Приход.Дата = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "date", ""));
		КонецЕсли;
		Если Приход.Сумма = 0 Тогда
			Приход.Сумма = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "amount", 0));
		КонецЕсли;
		Приход.Проведен = ЭАрМ_Служебный.ЗначениеУзла(Объект, "posted", Ложь) = Истина;
		Приход.Комментарий = ЗначениеСтрокой(Объект, "comment");
	КонецЕсли;

	Если Цепочка <> Неопределено Тогда
		Если Цепочка.ЕстьРасхождения Тогда
			Приход.Статус = "Расхождения";
			Приход.Комментарий = Цепочка.ТекстРасхождений;
		ИначеЕсли ЗначениеЗаполнено(Цепочка.ДатаСверки) Тогда
			Приход.Статус = "Сверено";
			Приход.Комментарий = Цепочка.ТекстРасхождений;
		ИначеЕсли Приход.Проведен Тогда
			Приход.Статус = "Проведен";
		КонецЕсли;
	КонецЕсли;

	Возврат Приход;

КонецФункции

Функция ПозицииПриходаИзОбъекта(Объект)

	Результат = Новый Массив;

	Если Объект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	УчитыватьНДС     = ЭАрМ_Служебный.ЗначениеУзла(Объект, "useVat", Ложь) = Истина;
	СуммаВключаетНДС = ЭАрМ_Служебный.ЗначениеУзла(Объект, "vatIncluded", Ложь) = Истина;

	Для Каждого Товар Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "goods")) Цикл

		Номенклатура = ЭАрМ_Служебный.ЗначениеУзла(Товар, "nomenclature");
		Карточка     = ЭАрМ_Служебный.ЗначениеУзла(Товар, "item");

		Коэффициент = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "ratio", 1));
		Если Коэффициент <= 0 Тогда
			Коэффициент = 1;
		КонецЕсли;

		Количество = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "quantity", 0)) * Коэффициент;
		Сумма = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "amount", 0));
		СуммаНДС = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "vatAmount", 0));
		ЦенаПакета = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "price", 0));
		СуммаСНДС = ?(УчитыватьНДС И НЕ СуммаВключаетНДС, Сумма + СуммаНДС, Сумма);

		Позиция = Новый Структура;
		Позиция.Вставить("Наименование",     ЗначениеСтрокой(Номенклатура, "name"));
		Позиция.Вставить("КодНоменклатуры",  ЗначениеСтрокой(Номенклатура, "code"));
		Позиция.Вставить("Артикул",          ЗначениеСтрокой(Карточка, "article"));
		Позиция.Вставить("Штрихкод",         ШтрихкодСтрокиПрихода(Товар, Номенклатура));
		Позиция.Вставить("Количество",       Количество);
		// Штук в единице документа (ratio Далиона): для упаковок при создании номенклатуры
		Позиция.Вставить("Коэффициент",      Коэффициент);
		Если ЦенаПакета <> 0 Тогда
			Позиция.Вставить("Цена", ЦенаПакета / Коэффициент);
		Иначе
			Позиция.Вставить("Цена", ?(Количество = 0, 0, СуммаСНДС / Количество));
		КонецЕсли;
		Позиция.Вставить("Сумма",            Сумма);
		Позиция.Вставить("СтавкаНДС",        ЗначениеСтрокой(Товар, "vatRate"));
		Позиция.Вставить("СуммаНДС",         СуммаНДС);
		// Все штрихкоды карточки: у штуки и короба они разные, и УПД может
		// нести не тот, что выбран в Штрихкод
		Позиция.Вставить("Штрихкоды",        ШтрихкодыТовараДалиона(Товар, Номенклатура));
		// Сумма строки с НДС - так её считает сверка цепочки (СтрокиДалиона)
		// и так она сравнивается с суммой УПД
		Позиция.Вставить("СуммаСНДС",        СуммаСНДС);
		Позиция.Вставить("ИдентификаторНоменклатуры", ЗначениеСтрокой(Номенклатура, "uid"));
		Результат.Добавить(Позиция);

	КонецЦикла;

	// Строке без штрихкода в пакете - штрихкоды из УТ, как у сверки цепочки
	// (ЭАрМ_СверкаТоваровЦепочки.ДополнитьШтрихкодыИзУТ): иначе форма не
	// находила пару там, где сверка её нашла
	ЭАрМ_СверкаТоваровЦепочки.ДополнитьШтрихкодыПозицийИзУТ(Результат);
	Для Каждого Позиция Из Результат Цикл
		Если НЕ ЗначениеЗаполнено(Позиция.Штрихкод) И Позиция.Штрихкоды.Количество() > 0 Тогда
			Позиция.Штрихкод = ЭАрМ_СверкаТоваровЦепочки.ПредпочтительныйШтрихкод(Позиция.Штрихкоды);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ШтрихкодСтрокиПрихода(Товар, Номенклатура)

	Возврат ЭАрМ_СверкаТоваровЦепочки.ПредпочтительныйШтрихкод(
		ШтрихкодыТовараДалиона(Товар, Номенклатура));

КонецФункции

Функция ШтрихкодыТовараДалиона(Товар, Номенклатура)

	Результат = Новый Массив;
	Добавленные = Новый Соответствие;
	Кандидаты = Новый Массив;

	Кандидаты.Добавить(ЗначениеСтрокой(Товар, "barcode"));
	Кандидаты.Добавить(ЗначениеСтрокой(Номенклатура, "barcode"));
	ДобавитьШтрихкодыУзла(Кандидаты, Товар);
	ДобавитьШтрихкодыУзла(Кандидаты, Номенклатура);

	Для Каждого Штрихкод Из Кандидаты Цикл
		Текст = СокрЛП(Штрихкод);
		Если ЗначениеЗаполнено(Текст) И Добавленные.Получить(Текст) = Неопределено Тогда
			Добавленные.Вставить(Текст, Истина);
			Результат.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьШтрихкодыУзла(Кандидаты, Узел)

	Для Каждого ОписаниеШтрихкода Из ЭАрМ_Служебный.ЗначениеВМассив(
		ЭАрМ_Служебный.ЗначениеУзла(Узел, "barcodes")) Цикл
		Кандидаты.Добавить(ЗначениеСтрокой(ОписаниеШтрихкода, "barcode"));
		Если ТипЗнч(ОписаниеШтрихкода) = Тип("Строка") Тогда
			Кандидаты.Добавить(СокрЛП(ОписаниеШтрихкода));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Поступление без заказа: ищем заказ того же поставщика, ещё без поставок,
// с датой в окне до поступления и с долей общих товаров не ниже порога.
//
// Возвращаемое значение:
//   Строка - ключ заказа, под которым теперь живёт цепочка
//
Функция ПривязатьКЗаказуПоТоварам(КлючБезЗаказа, ИдентификаторПоступления, Объект, Настройки)

	Поставщик = ДанныеПоставщика(Объект);
	ДатаПоступления = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "date", ""));

	Если НЕ ЗначениеЗаполнено(Поставщик.ИНН) ИЛИ НЕ ЗначениеЗаполнено(ДатаПоступления) Тогда
		Возврат КлючБезЗаказа;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИННПоставщика = &ИНН
	|	И Цепочка.ИдентификаторПоступления = """"
	|	И Цепочка.ДатаЗаказа МЕЖДУ &ДатаС И &ДатаПо";
	Запрос.УстановитьПараметр("ИНН", Поставщик.ИНН);
	Запрос.УстановитьПараметр("ДатаС", ДатаПоступления - Настройки.ОкноДнейСвязи * 86400);
	Запрос.УстановитьПараметр("ДатаПо", КонецДня(ДатаПоступления));

	ТоварыПоступления = КлючиТоваровДалиона(Объект);

	ЛучшийЗаказ = "";
	ЛучшаяДоля  = 0;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		//@skip-check query-in-loop
		Заказ = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ЗаказПоставщику", Выборка.ИдентификаторЗаказа);
		Доля = ДоляОбщихТоваров(ТоварыПоступления, КлючиТоваровДалиона(Заказ));
		Если Доля > ЛучшаяДоля Тогда
			ЛучшаяДоля  = Доля;
			ЛучшийЗаказ = Выборка.ИдентификаторЗаказа;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(ЛучшийЗаказ) ИЛИ ЛучшаяДоля < Настройки.ПорогСовпадения Тогда
		Возврат КлючБезЗаказа;
	КонецЕсли;

	// Переносим запись под ключ заказа: поля заказа уже лежат в его заготовке
	ЗаписьБезЗаказа = ЗаписьПоступления(ИдентификаторПоступления);
	Заготовка = ЗаписьЦепочки(ЛучшийЗаказ, "");

	НачатьТранзакцию();
	Попытка

		Изменения = Новый Структура;
		Для Каждого КлючЗначение Из ЗаписьБезЗаказа Цикл
			Если КлючЗначение.Ключ <> "ИдентификаторЗаказа" Тогда
				Изменения.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ИмяПоля Из СтрРазделить("НомерЗаказа,ДатаЗаказа,ДатаПоставкиПлан,СуммаЗаказа,Поставщик,ИННПоставщика,ИдентификаторПоставщика", ",") Цикл
			Изменения.Вставить(ИмяПоля, Заготовка[ИмяПоля]);
		КонецЦикла;
		Изменения.Вставить("СпособСвязиЗаказа", "Товары");

		УдалитьЦепочку(КлючБезЗаказа, ИдентификаторПоступления);
		УдалитьЦепочку(ЛучшийЗаказ, "");
		ИзменитьЦепочку(ЛучшийЗаказ, ИдентификаторПоступления, Изменения, Истина);

		ЗафиксироватьТранзакцию();

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторПоступления,
			"ПривязатьКЗаказуПоТоварам (привязка к заказу не записана)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

	Возврат ЛучшийЗаказ;

КонецФункции

#КонецОбласти

#Область Пломба

Процедура ЗафиксироватьРезультатЗапросаПломбы(ИдентификаторЗаказа, ИдентификаторПоступления, Отправка)

	Изменения = Новый Структура;
	Если Отправка.Успех Тогда
		Изменения.Вставить("СтатусПломбы",      "Запрошена");
		Изменения.Вставить("ДатаЗапросаПломбы", ТекущаяДатаСеанса());
		Изменения.Вставить("ИдентификаторЗапросаПломбы", Отправка.ИдентификаторЗапроса);
		Изменения.Вставить("КомментарийПломбы", Лев(Отправка.Путь, 500));
	Иначе
		Изменения.Вставить("КомментарийПломбы", Лев("Запрос не отправлен: " + Отправка.Ошибка, 500));
	КонецЕсли;

	ИзменитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Изменения, Ложь, Ложь);

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Лев(ИдентификаторПоступления, 100),
		ЭАрМ_ПриемПакетовДалион.ОперацияЖурнала(), Отправка.Успех,
		?(Отправка.Успех, "Запрошена пломба", Отправка.Ошибка), Отправка.ИмяФайла);

	ЭАрМ_ЗапросыДалион.ЗафиксироватьЗапросПломбы(Отправка.ИдентификаторЗапроса,
		ИдентификаторПоступления, Отправка.ИмяФайла, Отправка.Успех, Отправка.Ошибка);

КонецПроцедуры

// Пишет файл запроса пломбы в канал, по которому Далион забирает данные УТ.
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, Путь, ИмяФайла
//
Функция ОтправитьЗапросПломбы(ИдентификаторПоступления, НомерПоступления, Настройки)

	Результат = Новый Структура(
		"Успех, Ошибка, Путь, ИмяФайла, ИдентификаторЗапроса",
		Ложь, "", "", "", Строка(Новый УникальныйИдентификатор));

	ОписаниеДокумента = Новый Структура("uid, number", ИдентификаторПоступления, НомерПоступления);
	СписокДокументов = Новый Массив;
	СписокДокументов.Добавить(ОписаниеДокумента);

	Заголовок = Новый Структура;
	Заголовок.Вставить("type",      "serviceRequest");
	Заголовок.Вставить("version",   "1.0");
	Заголовок.Вставить("source",    "UT");
	Заголовок.Вставить("created",   Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Заголовок.Вставить("requestId", Результат.ИдентификаторЗапроса);

	Пакет = Новый Структура;
	Пакет.Вставить("header", Заголовок);
	Пакет.Вставить("data",   Новый Структура("action, documents", "setSeal", СписокДокументов));

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Пакет);
	ТекстJSON = ЗаписьJSON.Закрыть();

	Результат.ИмяФайла = СтрШаблон("dalion_serviceRequest_%1_%2.json",
		Результат.ИдентификаторЗапроса, Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss"));

		Попытка

		Если ВРег(СокрЛП(Настройки.Транспорт)) = "FTP" Тогда

			Отправка = ЭАрМ_ОбщийМодульОбмен.ОтправитьТекстНаFTP(ТекстJSON, Результат.ИмяФайла);
			Результат.Успех  = Отправка.Успех;
			Результат.Ошибка = Отправка.Ошибка;
			Результат.Путь   = Отправка.ПутьНаFTP;

		Иначе

			Если НЕ ЗначениеЗаполнено(Настройки.КаталогЗапросовДалион) Тогда
				ВызватьИсключение "Не указана папка запросов пломбы для Далиона";
			КонецЕсли;
			ФайлКаталога = Новый Файл(Настройки.КаталогЗапросовДалион);
			Если НЕ ФайлКаталога.Существует() Тогда
				Попытка
					СоздатьКаталог(Настройки.КаталогЗапросовДалион);
				Исключение
					ОшибкаИсключения = ИнформацияОбОшибке();
					// «Отказано в доступе» без объяснения ничего не говорит:
					// чаще всего папка в профиле пользователя, а регламент
					// работает от имени службы сервера 1С
					ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторПоступления,
						"ОтправитьЗапросПломбы (папка запросов Далиона не создана)", ОшибкаИсключения);
					ВызватьИсключение ЭАрМ_РегламентныйОбменЭДО.ТекстНедоступнойПапки(
						Настройки.КаталогЗапросовДалион);
				КонецПопытки;
			КонецЕсли;

			// Пишем под временным именем и переименовываем: Далион не должен
			// прочитать недописанный файл
			Путь = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Настройки.КаталогЗапросовДалион, Результат.ИмяФайла);
			ЭАрМ_Служебный.ЗаписатьТекстВФайл(ТекстJSON, Путь + ".tmp");
			ПереместитьФайл(Путь + ".tmp", Путь);

			Результат.Успех = Истина;
			Результат.Путь  = Путь;

		КонецЕсли;

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторПоступления,
			"ОтправитьЗапросПломбы (запрос пломбы не записан)", ОшибкаИсключения);
		Результат.Ошибка = ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Если ЭТрН есть и приходная накладная записана, ставит «Можно утвердить»
// и статус «Готов к утверждению». При наличии прихода автоматически ставит
// «К отправке» и пишет строку в очередь: регламент подхватывает и отправляет
// в СБИС без ручного клика.
//
Процедура ОтметитьЭТрНПоСверке(ИдентификаторЭТрН, ЕстьПриход)

	Если НЕ ЗначениеЗаполнено(ИдентификаторЭТрН) Тогда
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра(
			"РегистрСведений.ЭАрМ_РеестрЭТрН", ИдентификаторЭТрН);

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_РеестрЭТрН.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторЭТрН;
		МенеджерЗаписи.Прочитать();

		Если НЕ МенеджерЗаписи.Выбран() Тогда
			ЗафиксироватьТранзакцию();
			ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторЭТрН,
				"ЭТрН: " + ИдентификаторЭТрН + " из цепочки в реестре ЭТрН нет - отметка по сверке пропущена", Ложь);
			Возврат;
		КонецЕсли;

		// Закрытую в СБИС ЭТрН утверждать нечем: не готовим её и снимаем отметки
		Закрыта = ЭАрМ_УтверждениеСБИС.ДокументЗакрытВСБИС(
			МенеджерЗаписи.КодСостояния, МенеджерЗаписи.Состояние);

		Готова = НЕ Закрыта
			И (ЕстьПриход
				ИЛИ МенеджерЗаписи.МожноУтвердить
				ИЛИ ЗначениеЗаполнено(МенеджерЗаписи.НомерДокументаДалион));
		Изменено = Ложь;

		Если Закрыта И МенеджерЗаписи.МожноУтвердить Тогда
			МенеджерЗаписи.МожноУтвердить = Ложь;
			Изменено = Истина;
		КонецЕсли;

		Если НЕ Готова И МенеджерЗаписи.КОтправке Тогда
			МенеджерЗаписи.КОтправке = Ложь;
			Изменено = Истина;
		КонецЕсли;

		Если Готова И НЕ МенеджерЗаписи.МожноУтвердить Тогда
			МенеджерЗаписи.МожноУтвердить = Истина;
			Изменено = Истина;
		КонецЕсли;

		// Автопостановка «К отправке»: приход есть, документ не подписан и не
		// утверждён — ставим флажок, чтобы регламент отправил в СБИС.
		// Включается настройкой «АвтоотправкаЭТрН» (по умолчанию — Ложь).
		Если Готова
			И НЕ МенеджерЗаписи.КОтправке
			И НЕ МенеджерЗаписи.Подписано
			И НЕ МенеджерЗаписи.Утверждено
			И МенеджерЗаписи.СтатусПодписания <> Перечисления.ЭАрМ_СтатусыПодписанияЭДО.Подписан
			И ЭАрМ_НастройкиСервер.ЗначениеНастройки("АвтоотправкаЭТрН") = Истина Тогда
			МенеджерЗаписи.КОтправке = Истина;
			Изменено = Истина;
		КонецЕсли;

		ПрежнийСтатус = МенеджерЗаписи.СтатусПодписания;
		Если Готова Тогда
			ЭАрМ_УтверждениеСБИС.ПовыситьСтатусПодписания(МенеджерЗаписи,
				Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ГотовКОтправке);
		ИначеЕсли ПрежнийСтатус = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ГотовКОтправке Тогда
			МенеджерЗаписи.СтатусПодписания =
				Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ПустаяСсылка();
		КонецЕсли;

		Если МенеджерЗаписи.СтатусПодписания <> ПрежнийСтатус Тогда
			Изменено = Истина;
		КонецЕсли;

		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторЭТрН, СтрШаблон(
			"Запись: ЭАрМ_РеестрЭТрН № %1: %2 (закрыта %3, готова %4, Можно утвердить %5, К отправке %6, статус «%7», приход %8)",
			МенеджерЗаписи.Номер, ?(Изменено, "записана", "без изменений"), Закрыта, Готова,
			МенеджерЗаписи.МожноУтвердить, МенеджерЗаписи.КОтправке, МенеджерЗаписи.СтатусПодписания,
			МенеджерЗаписи.НомерДокументаДалион));

		Если Изменено Тогда
			МенеджерЗаписи.Записать(Истина);

			// Логируем автопостановку: видно, что бот отправил
			Если МенеджерЗаписи.КОтправке И ЕстьПриход Тогда
				ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(ИдентификаторЭТрН,
					"АвтоотправкаЭТрН", Истина,
					СтрШаблон("ЭТрН %1: КОтправке=Истина (приход %2), очередь — регламент",
						МенеджерЗаписи.Номер, МенеджерЗаписи.НомерДокументаДалион));
			КонецЕсли;
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторЭТрН,
			"ОтметитьЭТрНПоСверке (реестр ЭТрН не записан)", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Меняет булев признак строки реестра УПД: Пломба, РасхожденийНет.
//
Процедура ОтметитьПризнакУПД(ИдентификаторУПД, ИмяПризнака, Значение)

	НачатьТранзакцию();
	Попытка

		ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра("РегистрСведений.ЭАрМ_УПД_Входящий", ИдентификаторУПД);

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторУПД;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() Тогда
			Изменено = Ложь;
			Если МенеджерЗаписи[ИмяПризнака] <> Значение Тогда
				МенеджерЗаписи[ИмяПризнака] = Значение;
				Изменено = Истина;
			КонецЕсли;
			Если ИмяПризнака = "РасхожденийНет" И НЕ Значение И МенеджерЗаписи.КОтправке Тогда
				МенеджерЗаписи.КОтправке = Ложь;
				Изменено = Истина;
			КонецЕсли;
			Если Изменено Тогда
				МенеджерЗаписи.Записать(Истина);
			КонецЕсли;
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторУПД,
			"ОтметитьПризнакУПД (признак " + ИмяПризнака + " не записан в реестр УПД)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ЗаписьЦепочки

// Ставит открытым цепочкам УПД дату обновления, чтобы задание их пересверело.
//
// Закрытую цепочку, уже подписанную УПД и ручную связь или ручные отметки
// строк не трогает. Саму сверку не запускает и «Расхождений нет» не очищает.
//
Процедура ПометитьОткрытыеЦепочкиНаСверку(ИдентификаторУПД, ИдентификаторЭТрН = "") Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) И НЕ ЗначениеЗаполнено(ИдентификаторЭТрН) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ИдентификаторУПД) И УПДНеПересверять(ИдентификаторУПД) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цепочка.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.Этап <> ""Закрыто""
	|	И Цепочка.СпособСвязиУПД <> ""Вручную""
	|	И (Цепочка.ИдентификаторУПД = &ИдентификаторУПД
	|				И &ИдентификаторУПД <> """"
	|			ИЛИ Цепочка.ИдентификаторЭТрН = &ИдентификаторЭТрН
	|				И &ИдентификаторЭТрН <> """")";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);
	Запрос.УстановитьПараметр("ИдентификаторЭТрН", ИдентификаторЭТрН);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИзменитьЦепочку(Выборка.ИдентификаторЗаказа, Выборка.ИдентификаторПоступления,
			Новый Структура, Ложь, Истина);
	КонецЦикла;

КонецПроцедуры

// Подписанная УПД и УПД с ручными отметками строк повторную сверку не ждут.
//
Функция УПДНеПересверять(ИдентификаторУПД)

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторУПД;
	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат МенеджерЗаписи.Подписано = Истина
		ИЛИ ЗначениеЗаполнено(МенеджерЗаписи.СтрокиСвереныВручную);

КонецФункции

// Меняет поля записи цепочки под блокировкой.
//
// Параметры:
//   Изменения        - Структура - имя ресурса: значение
//   СоздатьЕслиНет   - Булево
//   ОбновитьДату     - Булево - поставить ДатаОбновления (признак "нужна сверка")
//
Процедура ИзменитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления, Изменения, СоздатьЕслиНет,
	ОбновитьДату = Истина)

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЭАрМ_ЦепочкаЗакупки");
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторЗаказа", ИдентификаторЗаказа);
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторПоступления", ИдентификаторПоступления);
		Блокировка.Заблокировать();

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ЦепочкаЗакупки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторЗаказа = ИдентификаторЗаказа;
		МенеджерЗаписи.ИдентификаторПоступления = ИдентификаторПоступления;
		МенеджерЗаписи.Прочитать();
		// ПЕРЕД записью: какой этап и УПД были - в трассу после записи
		ЭтапБыл = ?(МенеджерЗаписи.Выбран(), МенеджерЗаписи.Этап, "записи не было");
		УПДБыла = ?(МенеджерЗаписи.Выбран(), МенеджерЗаписи.ИдентификаторУПД, "");

		Если НЕ МенеджерЗаписи.Выбран() И НЕ СоздатьЕслиНет Тогда
			ОтменитьТранзакцию();
			Поля = Новый Массив;
			Для Каждого КлючЗначение Из Изменения Цикл
				Поля.Добавить(КлючЗначение.Ключ);
			КонецЦикла;
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(
				?(ЗначениеЗаполнено(ИдентификаторПоступления), ИдентификаторПоступления, ИдентификаторЗаказа),
				"ИзменитьЦепочку", СтрШаблон("цепочки (заказ %1) нет в ЭАрМ_ЦепочкаЗакупки - поля %2 не записаны",
					ИдентификаторЗаказа, СтрСоединить(Поля, ", ")));
			Возврат;
		КонецЕсли;

		// Прочитать() очищает поля, если записи нет, - измерения задаём снова
		МенеджерЗаписи.ИдентификаторЗаказа = ИдентификаторЗаказа;
		МенеджерЗаписи.ИдентификаторПоступления = ИдентификаторПоступления;

		Для Каждого КлючЗначение Из Изменения Цикл
			МенеджерЗаписи[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЦикла;

		Если ОбновитьДату Тогда
			МенеджерЗаписи.ДатаОбновления = ТекущаяДатаСеанса();
		КонецЕсли;

		МенеджерЗаписи.Этап = ЭтапЦепочки(МенеджерЗаписи);
		МенеджерЗаписи.Записать(Истина);

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(
			?(ЗначениеЗаполнено(ИдентификаторПоступления), ИдентификаторПоступления, ИдентификаторЗаказа),
			"ИзменитьЦепочку (ЭАрМ_ЦепочкаЗакупки не записана)", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

	// Каждая запись цепочки - в трассу: какие поля и с каким значением
	Поля = Новый Массив;
	Для Каждого КлючЗначение Из Изменения Цикл
		Значение = КлючЗначение.Значение;
		Если ТипЗнч(Значение) = Тип("Дата") Тогда
			Значение = Формат(Значение, "ДЛФ=DT");
		КонецЕсли;
		Поля.Добавить(КлючЗначение.Ключ + "=" + Лев(Строка(Значение), 40));
	КонецЦикла;
	ЭАрМ_ПриемПакетовДалион.Трасса(
		?(ЗначениеЗаполнено(ИдентификаторПоступления), ИдентификаторПоступления, ИдентификаторЗаказа),
		СтрШаблон("Запись: ЭАрМ_ЦепочкаЗакупки (заказ %1) этап «%4» -> «%2», УПД «%5» -> «%6»: %3", ИдентификаторЗаказа,
			МенеджерЗаписи.Этап, ?(Поля.Количество() = 0, "только дата обновления/этап", СтрСоединить(Поля, "; ")),
			ЭтапБыл, УПДБыла, МенеджерЗаписи.ИдентификаторУПД));

	// Запись цепочки читаем обратно: этап должен лежать в регистре
	ЭАрМ_ПриемПакетовДалион.ПроверитьЗаписьРегистра(
		?(ЗначениеЗаполнено(ИдентификаторПоступления), ИдентификаторПоступления, ИдентификаторЗаказа),
		"ЭАрМ_ЦепочкаЗакупки",
		Новый Структура("ИдентификаторЗаказа, ИдентификаторПоступления", ИдентификаторЗаказа, ИдентификаторПоступления),
		Новый Структура("Этап", МенеджерЗаписи.Этап));

КонецПроцедуры

// Удаляет запись цепочки вместе с её строками сверки.
//
Процедура УдалитьЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления)

	НаборЗаписей = РегистрыСведений.ЭАрМ_ЦепочкаЗакупки.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторЗаказа.Установить(ИдентификаторЗаказа);
	НаборЗаписей.Отбор.ИдентификаторПоступления.Установить(ИдентификаторПоступления);
	НаборЗаписей.Записать(Истина);

	НаборСверки = РегистрыСведений.ЭАрМ_СверкаТоваровЦепочки.СоздатьНаборЗаписей();
	НаборСверки.Отбор.ИдентификаторЗаказа.Установить(ИдентификаторЗаказа);
	НаборСверки.Отбор.ИдентификаторПоступления.Установить(ИдентификаторПоступления);
	НаборСверки.Записать(Истина);

	ЭАрМ_РеестрТоваровЗаказов.УдалитьРеестрЦепочки(ИдентификаторЗаказа, ИдентификаторПоступления);

КонецПроцедуры

Функция ЭтапЦепочки(Запись)

	// Пломба закрывает цепочку, пока в ней есть её документы. Аннулированную УПД
	// или ЭТрН цепочка отпустила и ждёт замену: она открыта, иначе замену никто
	// не привяжет
	ЖдётЗамену = ЗначениеЗаполнено(Запись.ИдентификаторУПДАннулированной)
			И НЕ ЗначениеЗаполнено(Запись.ИдентификаторУПД)
		ИЛИ ЗначениеЗаполнено(Запись.ИдентификаторЭТрНАннулированной)
			И НЕ ЗначениеЗаполнено(Запись.ИдентификаторЭТрН);

	Если Запись.СтатусПломбы = "Установлена" И НЕ ЖдётЗамену Тогда
		Возврат "Закрыто";
	ИначеЕсли Запись.СтатусПломбы = "Запрошена" Тогда
		Возврат "ПломбаЗапрошена";
	ИначеЕсли НЕ ЗначениеЗаполнено(Запись.ИдентификаторПоступления) Тогда
		Возврат "ЗаказПолучен";
	ИначеЕсли НЕ ЗначениеЗаполнено(Запись.ИдентификаторУПД) Тогда
		Возврат "ПоступлениеПолучено";
	ИначеЕсли ЗначениеЗаполнено(Запись.ДатаСверки) И Запись.ДатаСверки >= Запись.ДатаОбновления Тогда
		Возврат ?(Запись.ЕстьРасхождения, "ЕстьРасхождения", "Сверено");
	КонецЕсли;

	Возврат "УПДНайдена";

КонецФункции

