#Область ПрограммныйИнтерфейс

// Обработчик подписки на запись входящего ЭДО.
// Вызывается при записи документа ЭлектронныйДокументВходящийЭДО.
//
Процедура ЭАрМ_ПриЗаписиВходящегоЭДО(Источник, Отказ) Экспорт

	// Через очередь: подписка только ставит строку «ЭТрН», работу делает задание
	// ЭАрМ_ОбработкаОчереди. Флажок выключен - прежняя прямая обработка ниже
	Если ЭАрМ_ОчередьСобытийПовтИсп.ОчередьВключена() Тогда
		ЭАрМ_ОчередьСобытий.ПоставитьВходящийЭДО(Источник);
		Возврат;
	КонецЕсли;

	ВидДокумента = Источник.ВидДокумента;
	Если НЕ ЗначениеЗаполнено(ВидДокумента) Тогда
		Возврат;
	КонецЕсли;

	ТипДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидДокумента, "ТипДокумента");

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ПодпискаВходящий",
		УровеньЖурналаРегистрации.Информация, , Источник.Ссылка,
		СтрШаблон("Тип: %1", ТипДокумента));

	Если ТипДокумента <> Перечисления.ТипыДокументовЭДО.ЭТрН Тогда
		Возврат;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ПодпискаВходящий",
		УровеньЖурналаРегистрации.Информация, , Источник.Ссылка,
		"ЭТрН обнаружен → обработка");

	ОбработатьВходящийЭТрН(Источник.Ссылка);

КонецПроцедуры

// Обработчик подписки на событие записи состояния ЭДО.
// Вызывается при записи в регистр СостоянияПоОбъектамУчетаЭДО.
//
Процедура ЭАрМ_ПриЗаписиСостоянияПоОбъектамУчетаЭДО(Источник, Отказ, Замещение) Экспорт

	// Через очередь: подписка только ставит строки «Подтверждение», запросы и
	// вызов веб-сервиса - в задании ЭАрМ_ОбработкаОчереди (ОтправитьПодтверждениеПоОбъекту).
	// Флажок выключен - прежняя прямая отправка ниже
	Если ЭАрМ_ОчередьСобытийПовтИсп.ОчередьВключена() Тогда
		ЭАрМ_ОчередьСобытий.ПоставитьСостоянияОбъектов(Источник);
		Возврат;
	КонецЕсли;

	Если Источник.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Запись Из Источник Цикл

		СсылкаНаОбъект = Запись.СсылкаНаОбъект;

		//@skip-check query-in-loop
		ЭлектронныеДокументы = НайтиЭлектронныеДокументыПоОбъектуУчета(СсылкаНаОбъект);

		Для Каждого ЭлектронныйДокумент Из ЭлектронныеДокументы Цикл

			ВидДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				ЭлектронныйДокумент, "ВидДокумента");
			ТипДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				ВидДокумента, "ТипДокумента");

			Если НЕ ЭтоПоддерживаемыйТипДокумента(ТипДокумента) Тогда
				Продолжить;
			КонецЕсли;

			//@skip-check query-in-loop
			Если УжеОтправленНаПодтверждение(ЭлектронныйДокумент) Тогда
				Продолжить;
			КонецЕсли;

			ЭАрМ_ОбработкаПодтвержденийЭДО.ОтправитьНаПодтверждение(ЭлектронныйДокумент);

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Обработка входящего ЭТрН из очереди событий (строка «ЭТрН»).
//
// Параметры:
//   ВходящийЭДО - ДокументСсылка.ЭлектронныйДокументВходящийЭДО
//
Процедура ОбработатьВходящийЭТрНИзОчереди(ВходящийЭДО) Экспорт

	ОбработатьВходящийЭТрН(ВходящийЭДО);

КонецПроцедуры

// То, что раньше делала подписка на запись состояния ЭДО, для одного объекта
// учёта (строка очереди «Подтверждение»): найти электронные документы объекта,
// пропустить уже отправленные на подтверждение и отправить остальные.
//
// Параметры:
//   СсылкаНаОбъект - Произвольный - объект учёта из записи состояния
//
Процедура ОтправитьПодтверждениеПоОбъекту(СсылкаНаОбъект) Экспорт

	Для Каждого ЭлектронныйДокумент Из НайтиЭлектронныеДокументыПоОбъектуУчета(СсылкаНаОбъект) Цикл

		ВидДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлектронныйДокумент, "ВидДокумента");
		ТипДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидДокумента, "ТипДокумента");

		Если НЕ ЭтоПоддерживаемыйТипДокумента(ТипДокумента) Тогда
			Продолжить;
		КонецЕсли;

		Если УжеОтправленНаПодтверждение(ЭлектронныйДокумент) Тогда
			Продолжить;
		КонецЕсли;

		ЭАрМ_ОбработкаПодтвержденийЭДО.ОтправитьНаПодтверждение(ЭлектронныйДокумент);

	КонецЦикла;

КонецПроцедуры

// Версия модуля.
//
Функция ВерсияМодуля() Экспорт

	Возврат "1.0.0";

КонецФункции

#КонецОбласти

#Область ИнтеграцияСБИС

// Запускает сеанс обмена с СБИС.
//
// Оставлена ради вызывающих: форма панели управления и регламентное задание
// зовут именно её. Сама работа - в ЭАрМ_РегламентныйОбменЭДО: авторизация
// с кэшем сессии, постраничные реестры ЭТрН и УПД в регистры сведений,
// подбор груза и выгрузка в Далион.
//
// Возвращаемое значение:
//   Структура:
//     * Обработано - Число  - выгружено документов
//     * Записано   - Число  - строк реестра получено
//     * Ошибки     - Массив из Строка
//
Функция ОбработатьДокументыСБИС() Экспорт

	ЭАрМ_НастройкиСервер.ИнициализироватьНастройкиСБИС();

	Итоги = ЭАрМ_РегламентныйОбменЭДО.ВыполнитьОбмен();

	Результат = Новый Структура("Обработано, Записано, Ошибки",
		Итоги.Выгружено, Итоги.ЗагруженоЭТрН + Итоги.ЗагруженоУПД, Новый Массив);

	Если ЗначениеЗаполнено(Итоги.Ошибка) Тогда
		Результат.Ошибки.Добавить(Итоги.Ошибка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьВходящийЭТрН(ВходящийЭДО)

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ОбработкаЭТрН",
		УровеньЖурналаРегистрации.Информация, , ВходящийЭДО,
		"Начало обработки входящего ЭТрН");

	// >>> Вставить логику обработки <<<

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ОбработкаЭТрН",
		УровеньЖурналаРегистрации.Информация, , ВходящийЭДО,
		"Обработка завершена");

КонецПроцедуры

Функция ЭтоПоддерживаемыйТипДокумента(ТипДокумента)

	Возврат ТипДокумента = Перечисления.ТипыДокументовЭДО.УПД
		ИЛИ ТипДокумента = Перечисления.ТипыДокументовЭДО.ЭТрН;

КонецФункции

Функция НайтиЭлектронныеДокументыПоОбъектуУчета(СсылкаНаОбъект)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент КАК ЭлектронныйДокумент
	|ИЗ
	|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК ОбъектыУчетаДокументовЭДО
	|ГДЕ
	|	ОбъектыУчетаДокументовЭДО.ОбъектУчета = &СсылкаНаОбъект
	|	И ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент ССЫЛКА Документ.ЭлектронныйДокументВходящийЭДО";
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат Результат.Выгрузить().ВыгрузитьКолонку("ЭлектронныйДокумент");

КонецФункции

Функция УжеОтправленНаПодтверждение(ЭлектронныйДокумент)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Поле1
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
	|ГДЕ
	|	Т.ЭлектронныйДокумент = &ЭлектронныйДокумент";
	Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокумент);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти
