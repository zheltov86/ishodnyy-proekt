// ЭАрМ_ОбщийМодульОбмен: обмен с СБИС и выгрузка в Далион.
//
// Модуль перенесён из модуля объекта внешней обработки "ПодписаниеЭдо".
// Здесь остались только прикладные операции: авторизация, чтение реестров и
// документов, разбор груза и сборка JSON приходной накладной. Разбор ответов,
// работа с файлами и прочая техника - в модуле ЭАрМ_Служебный, настройки
// подключения - в ЭАрМ_НастройкиСервер (регистр сведений ЭАрМ_НастройкиЭДО).
//
// Документы из СБИС забирает регламентное задание, см. ЭАрМ_РегламентныйОбменЭДО.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// ============================================================================
// ВЕРСИЯ
// ============================================================================

// Возвращает метку сборки модуля.
// Нужна, чтобы отличать, какая версия расширения реально подключена к базе:
// текст ошибок и поведение меняются между сборками, и без метки это
// приходится угадывать.
//
// Проверить из консоли:
//   Сообщить(ЭАрМ_ОбщийМодульОбмен.ВерсияМодуля());
//
// Возвращаемое значение:
//   Строка
//
Функция ВерсияМодуля() Экспорт

	Возврат "2026-09-03/54 (расширение АРМ_ЭдоОбмен, регистры вместо таблиц)";

КонецФункции

// ============================================================================
// АВТОРИЗАЦИЯ И ПОЛУЧЕНИЕ ДОКУМЕНТОВ
// ============================================================================

// Авторизует приложение в СБИС и возвращает сессию.
//
// Вход отделён от чтения документов: сессия нужна и реестру ЭТрН, и реестру
// УПД, а запрашиваются они независимо друг от друга.
//
// Параметры:
//   AppClientId - Строка - app_client_id (по умолчанию из настроек ЭДО)
//   AppSecret   - Строка - app_secret (по умолчанию из настроек ЭДО)
//   SecretKey   - Строка - secret_key (по умолчанию из настроек ЭДО)
//
// Возвращаемое значение:
//   Структура:
//     * Успех  - Булево
//     * Ошибка - Строка
//     * Сессия - Строка - session ID (sid)
//     * Ответ  - Строка - полный ответ сервера
//
Функция Авторизоваться(AppClientId = "", AppSecret = "", SecretKey = "") Экспорт

	// Вход - тоже вызов СБИС: строка "oauth" в журнале запросов (без ключей,
	// сессии и тела ответа)
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ДляЖурнала = Новый Структура("КодСостояния, Текст", 0, "");

	Результат = ВойтиВСБИС(AppClientId, AppSecret, SecretKey, ДляЖурнала);

	ЭАрМ_Служебный.ЗаписатьВЖурналЗапросовСБИС("oauth", НачалоМс,
		ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс, Результат.Успех, ДляЖурнала.КодСостояния,
		ДляЖурнала.Текст, "", СтрДлина(Результат.Ответ), 0, Ложь);

	Возврат Результат;

КонецФункции

// OAuth-вход в СБИС. ДляЖурнала: КодСостояния (код HTTP, 0 - ответа нет) и Текст
// (ошибка без тела ответа) - для журнала запросов СБИС, см. Авторизоваться.
//
Функция ВойтиВСБИС(AppClientId, AppSecret, SecretKey, ДляЖурнала)

	Результат = Новый Структура("Успех, Ошибка, Сессия, Ответ", Истина, "", "", "");

	Настройки = ЭАрМ_НастройкиСервер.НастройкиСБИС();

	Если НЕ ЗначениеЗаполнено(AppClientId) Тогда AppClientId = Настройки.КлиентID; КонецЕсли;
	Если НЕ ЗначениеЗаполнено(AppSecret) Тогда AppSecret = Настройки.КлиентСекрет; КонецЕсли;
	Если НЕ ЗначениеЗаполнено(SecretKey) Тогда SecretKey = Настройки.СекретныйКлюч; КонецЕсли;

	ТелоЗапроса = СтрШаблон(
		"{""app_client_id"":""%1"",""app_secret"":""%2"",""secret_key"":""%3""}",
		AppClientId, AppSecret, SecretKey);

	АдресРесурса = "/oauth/service/";

	Попытка
		Соединение = ЭАрМ_Служебный.СоздатьСоединениеHTTPS(Настройки.АдресСервера);

		Запрос = Новый HTTPЗапрос(АдресРесурса);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8",
			ИспользованиеByteOrderMark.НеИспользовать);

		Ответ = Соединение.ОтправитьДляОбработки(Запрос);

		Результат.Ответ = Ответ.ПолучитьТелоКакСтроку();
		ДляЖурнала.КодСостояния = Ответ.КодСостояния;

		// СБИС отдаёт ошибки бизнес-логики как JSON-RPC error с кодом HTTP 500,
		// поэтому тело разбираем независимо от кода состояния.
		ДанныеОтвета    = ЭАрМ_Служебный.ПрочитатьОтветJSON(Результат.Ответ);
		ТекстОшибкиСБИС = ЭАрМ_Служебный.ТекстОшибкиОтвета(ДанныеОтвета);

		Если ЗначениеЗаполнено(ТекстОшибкиСБИС) Тогда
			Результат.Успех = Ложь;
			Результат.Ошибка = ТекстОшибкиСБИС;
			ДляЖурнала.Текст = ТекстОшибкиСБИС;
			Возврат Результат;
		ИначеЕсли Ответ.КодСостояния <> 200 Тогда
			Результат.Успех = Ложь;
			Результат.Ошибка = СтрШаблон("HTTP %1: %2",
				Ответ.КодСостояния, Результат.Ответ);
			ДляЖурнала.Текст = СтрШаблон("HTTP %1", Ответ.КодСостояния);
			Возврат Результат;
		КонецЕсли;

		Результат.Сессия = ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "sid");
		Если Не ЗначениеЗаполнено(Результат.Сессия) Тогда
			Результат.Сессия = ЭАрМ_Служебный.ЗначениеУзла(
				ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "result"), "sid");
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Результат.Сессия) Тогда
			Результат.Успех = Ложь;
			Результат.Ошибка = "В ответе нет поля sid";
			ДляЖурнала.Текст = Результат.Ошибка;
			Возврат Результат;
		КонецЕсли;

	Исключение
		Результат.Успех = Ложь;
		Результат.Ошибка = СтрШаблон("Ошибка авторизации: %1",
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		ДляЖурнала.Текст = Результат.Ошибка;
		ЭАрМ_Служебный.ЗаписатьОшибку("Авторизоваться", Результат.Ошибка);
		Возврат Результат;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Авторизует приложение в СБИС и получает список документов.
// Сначала выполняет OAuth-авторизацию, затем запрашивает реестр документов
// методом СБИС.СписокДокументов.
//
// Параметры:
//   AppClientId     - Строка - app_client_id (по умолчанию из настроек ЭДО)
//   AppSecret       - Строка - app_secret (по умолчанию из настроек ЭДО)
//   SecretKey       - Строка - secret_key (по умолчанию из настроек ЭДО)
//   ТипДокумента    - Строка - см. ПолучитьСписокДокументов
//   Страница        - Число - номер страницы (с 0, по умолчанию 0)
//   РазмерСтраницы  - Число - количество на странице (по умолчанию 100)
//   Направление     - Строка - "Входящий" или "Исходящий"
//   ГлубинаДней     - Число - период реестра, 0 - по настройкам ЭДО
//
// Возвращаемое значение:
//   Структура:
//     * Успех      - Булево
//     * Ошибка     - Строка
//     * Сессия     - Строка (sid) или Неопределено
//     * Документы  - Массив - список документов (элементы - Соответствие)
//     * Навигация  - Соответствие - Страница, ЕстьЕще
//     * Ответ      - Строка - полный ответ сервера
//
Функция АвторизоватьПриложение(
		AppClientId = "", AppSecret = "", SecretKey = "",
		ТипДокумента = "ConsignmentNote", Страница = 0, РазмерСтраницы = 100,
		Направление = "Входящий", ГлубинаДней = 0) Экспорт

	Настройки = ЭАрМ_НастройкиСервер.НастройкиСБИС();

	Если НЕ ЗначениеЗаполнено(AppClientId) Тогда AppClientId = Настройки.КлиентID; КонецЕсли;
	Если НЕ ЗначениеЗаполнено(AppSecret) Тогда AppSecret = Настройки.КлиентСекрет; КонецЕсли;
	Если НЕ ЗначениеЗаполнено(SecretKey) Тогда SecretKey = Настройки.СекретныйКлюч; КонецЕсли;

	Результат = Новый Структура("Успех, Ошибка, Сессия, Документы, Навигация, Ответ",
		Истина, "", Неопределено, Новый Массив, Новый Соответствие, "");

	// --- Шаг 1: Авторизация ---
	// Вход отделён от чтения реестров: сессия одна, а реестры ЭТрН и УПД
	// запрашиваются каждый сам по себе.
	РезультатВхода = Авторизоваться(AppClientId, AppSecret, SecretKey);

	Результат.Ответ = РезультатВхода.Ответ;

	Если НЕ РезультатВхода.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = РезультатВхода.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Результат.Сессия = РезультатВхода.Сессия;

	// --- Шаг 2: Получение списка документов ---
	// Период задаём всегда, даже когда со страницы нужен один документ: без
	// ДатаС/ДатаПо СБИС перебирает архив целиком и отвечает тем дольше, чем
	// дольше живёт учётная запись
	Период = ЭАрМ_НастройкиСервер.ПериодЗапросаСБИС(ГлубинаДней);

	РезультатДокументов = ПолучитьСписокДокументов(
		Результат.Сессия, ТипДокумента, Направление,
		Страница, РазмерСтраницы, Период.ДатаС, Период.ДатаПо,
		Настройки.АдресСервера);

	Если НЕ РезультатДокументов.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = РезультатДокументов.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Результат.Документы = РезультатДокументов.Документы;
	Результат.Навигация = РезультатДокументов.Навигация;

	Возврат Результат;

КонецФункции

// Получает список документов из СБИС.
// Метод API: СБИС.СписокДокументов (JSON-RPC).
//
// Этим методом читаются документы подсистемы ЭПД (транспортные накладные,
// путевые листы, заказы на перевозку). Ключ фильтра "Тип" здесь принимает
// АНГЛИЙСКИЙ код типа документа. Реестры ЭДО (накладные, счета-фактуры,
// договоры) читаются другим методом - см. ПолучитьСписокДокументовПоСобытиям.
//
// Параметры:
//   Сессия           - Строка - session ID (sid)
//   ТипДокумента     - Строка - ключ фильтра "Тип":
//                      ConsignmentNote - транспортная накладная (ЭТрН)
//                      Waybill         - путевой лист (ЭПЛ)
//                      TransportOrder  - заказ на перевозку
//   Направление      - Строка - "Входящий" или "Исходящий"
//   Страница         - Число - номер страницы (с 0, по умолчанию 0)
//   РазмерСтраницы   - Число - количество на странице (по умолчанию 100)
//   ДатаС            - Строка - начало периода "ДД.ММ.ГГГГ". Пусто - окно из
//                      настроек, см. ЭАрМ_НастройкиСервер.ПериодЗапросаСБИС:
//                      реестр без периода не запрашивается никогда
//   ДатаПо           - Строка - конец периода "ДД.ММ.ГГГГ", по умолчанию так же
//   АдресСервиса     - Строка - хост сервера (по умолчанию из настроек ЭДО)
//   ДопПоля          - Строка - дополнительные узлы ответа через запятую
//
// Возвращаемое значение:
//   Структура:
//     * Успех      - Булево
//     * Ошибка     - Строка
//     * Документы  - Массив - список документов (элементы - Соответствие)
//     * Навигация  - Соответствие - Страница, РазмерСтраницы, ЕстьЕще
//     * Ответ      - Строка - полный ответ сервера
//
Функция ПолучитьСписокДокументов(Сессия = "", ТипДокумента = "ConsignmentNote",
		Направление = "Входящий",
		Страница = 0, РазмерСтраницы = 100,
		ДатаС = "", ДатаПо = "",
		АдресСервиса = "", ДопПоля = "Стороны,ТекущиеЭтапы,Подстановки") Экспорт

	Результат = ЭАрМ_Служебный.НовыйРезультатСписка();

	Если НЕ ЗначениеЗаполнено(ТипДокумента) Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = "Не заполнен тип документа";
		Возврат Результат;
	КонецЕсли;

	СтруктураФильтра = Новый Структура;
	СтруктураФильтра.Вставить("Тип", ТипДокумента);

	Если ЗначениеЗаполнено(Направление) Тогда
		СтруктураФильтра.Вставить("Направление", Направление);
	КонецЕсли;

	Если ЗначениеЗаполнено(ДопПоля) Тогда
		СтруктураФильтра.Вставить("ДопПоля", ДопПоля);
	КонецЕсли;

	ЭАрМ_Служебный.ДополнитьФильтрПериодомИНавигацией(
		СтруктураФильтра, ДатаС, ДатаПо, Страница, РазмерСтраницы);

	ЭАрМ_Служебный.ЗаполнитьРезультатСписка(Результат, "СБИС.СписокДокументов",
		СтруктураФильтра, Сессия, АдресСервиса);

	Возврат Результат;

КонецФункции

// Получает реестр документов ЭДО из СБИС.
// Метод API: СБИС.СписокДокументовПоСобытиям (JSON-RPC).
//
// Этим методом читаются разделы "Входящие", "Отправленные" и
// "Ответы контрагента". Формат документа задаётся отдельным
// ключом "ТипВложения" - именно сюда идёт ЭДОНакл, СчФктр и прочие.
//
// Параметры:
//   Сессия           - Строка - session ID (sid)
//   ТипРеестра       - Строка - ключ фильтра "ТипРеестра":
//                      Входящие, Отправленные, Ответы контрагента
//   ТипВложения      - Строка - ключ фильтра "ТипВложения", формат документа:
//                      ЭДОНакл, АктВР, СчФктр, УпдСчфДоп, УпдДоп, счФактКор,
//                      УкдКсчфДис, УкдДис, АктСвер, Договор, ЭДОСч,
//                      АктПриемки, Заказ. Можно перечислить через запятую.
//                      Пусто - без отбора по формату.
//   Страница         - Число - номер страницы (с 0, по умолчанию 0)
//   РазмерСтраницы   - Число - количество на странице (по умолчанию 100)
//   ДатаС            - Строка - начало периода "ДД.ММ.ГГГГ". Пусто - окно из
//                      настроек, см. ЭАрМ_НастройкиСервер.ПериодЗапросаСБИС:
//                      реестр без периода не запрашивается никогда
//   ДатаПо           - Строка - конец периода "ДД.ММ.ГГГГ", по умолчанию так же
//   АдресСервиса     - Строка - хост сервера (по умолчанию из настроек ЭДО)
//   ДопОтбор         - Структура - дополнительные ключи фильтра как есть:
//                      Маска (поиск по номеру и названию), Контрагент
//                      и НашаОрганизация (структуры СвЮЛ/СвФЛ), Состояние.
//                      Ими документ забирается адресно, без обхода реестра
//
// Возвращаемое значение:
//   Структура - см. ПолучитьСписокДокументов
//
Функция ПолучитьСписокДокументовПоСобытиям(Сессия = "", ТипРеестра = "Входящие",
		ТипВложения = "",
		Страница = 0, РазмерСтраницы = 100,
		ДатаС = "", ДатаПо = "",
		АдресСервиса = "", ДопОтбор = Неопределено, ДопПоля = "") Экспорт

	Результат = ЭАрМ_Служебный.НовыйРезультатСписка();

	Если НЕ ЗначениеЗаполнено(ТипРеестра) Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = "Не заполнен тип реестра";
		Возврат Результат;
	КонецЕсли;

	СтруктураФильтра = Новый Структура;
	СтруктураФильтра.Вставить("ТипРеестра", ТипРеестра);

	Если ЗначениеЗаполнено(ТипВложения) Тогда
		СтруктураФильтра.Вставить("ТипВложения", ТипВложения);
	КонецЕсли;

	// Дополнительные узлы ответа. Ради них всё и затевается: с "Подстановки"
	// реестр отдаёт титулы, а в них лежит груз - и товары всей страницы
	// приезжают одним запросом, без чтения каждого документа по отдельности.
	Если ЗначениеЗаполнено(ДопПоля) Тогда
		СтруктураФильтра.Вставить("ДопПоля", ДопПоля);
	КонецЕсли;

	// Ключи дополнительного отбора кладём в фильтр как есть: их набор задаёт
	// вызывающий код, а СБИС сам решает, что с ними делать
	Если ДопОтбор <> Неопределено Тогда
		Для Каждого КлючЗначение Из ДопОтбор Цикл
			СтруктураФильтра.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	ЭАрМ_Служебный.ДополнитьФильтрПериодомИНавигацией(
		СтруктураФильтра, ДатаС, ДатаПо, Страница, РазмерСтраницы);

	ЭАрМ_Служебный.ЗаполнитьРезультатСписка(Результат, "СБИС.СписокДокументовПоСобытиям",
		СтруктураФильтра, Сессия, АдресСервиса);

	Возврат Результат;

КонецФункции

// Читает документ целиком по идентификатору из реестра.
// Метод API: СБИС.ПрочитатьДокумент (JSON-RPC).
//
// Список документов отдаёт только шапку и метаданные вложений. Содержимое -
// титулы ЭПД, строки товаров, стороны - приходит только этим методом.
//
// Параметры:
//   Идентификатор - Строка - идентификатор документа из реестра
//   Сессия        - Строка - session ID (sid)
//   АдресСервиса  - Строка - хост сервера (по умолчанию из настроек ЭДО)
//   ДопПоля       - Строка - дополнительные узлы ответа через запятую.
//                   Для ЭТрН обязателен узел "Подстановки" - без него
//                   титулы (а значит и груз) в ответ не попадут.
//                   Связи документа приходят только с "ЦепочкаДокументов" -
//                   его запрашивают отдельно, см. ДопПоляСоСвязями.
//
// Возвращаемое значение:
//   Структура:
//     * Успех    - Булево
//     * Ошибка   - Строка
//     * Документ - Соответствие - узел result ответа
//     * Ответ    - Строка - полный ответ сервера
//
Функция ПрочитатьДокумент(Идентификатор, Сессия = "", АдресСервиса = "",
		ДопПоля = "ДопДействия,ТекущиеЭтапы,Подстановки,Расширение,Стороны,ИдентификаторУчастника",
		КешСоединений = Неопределено, Источник = "") Экспорт

	Результат = Новый Структура("Успех, Ошибка, Документ, Ответ",
		Истина, "", Неопределено, "");

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = "Не заполнен идентификатор документа";
		Возврат Результат;
	КонецЕсли;

	Настройки = ЭАрМ_НастройкиСервер.НастройкиСБИС();

	ИдСессии = Сессия;
	Если НЕ ЗначениеЗаполнено(ИдСессии) Тогда
		ИдСессии = ПолучитьСессию();
	КонецЕсли;

	Адрес = АдресСервиса;
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Адрес = Настройки.АдресСервера;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИдСессии) Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = "Не заполнена сессия (sid)";
		Возврат Результат;
	КонецЕсли;

	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("Идентификатор", Строка(Идентификатор));
	Если ЗначениеЗаполнено(ДопПоля) Тогда
		СтруктураДокумента.Вставить("ДопПоля", ДопПоля);
	КонецЕсли;

	ОтветМетода = ЭАрМ_Служебный.ВыполнитьМетодСБИС("СБИС.ПрочитатьДокумент",
		Новый Структура("Документ", СтруктураДокумента), ИдСессии, Адрес, КешСоединений, Источник);

	Результат.Ответ = ОтветМетода.Ответ;

	Если НЕ ОтветМетода.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = ОтветМетода.Ошибка;
		Возврат Результат;
	КонецЕсли;

	// Документ - это сам узел result, без промежуточной обёртки.
	// Разворачивать result.Документ нельзя: у документа есть собственный
	// узел "Документ" (сопроводительные документы), и тогда теряются
	// "Подстановки" - а в них лежат титулы.
	Результат.Документ = ОтветМетода.Данные;

	Возврат Результат;

КонецФункции

// Возвращает список титулов ЭТрН, пришедших в документе.
//
// Титулы приходят в узле "Подстановки" как соответствие
// "имя подстановки" -> данные титула (или массив данных).
// Имя подстановки для ЭТрН - "ЭТрН_" + код титула, например "ЭТрН_1110339".
//
// Параметры:
//   Документ - Соответствие - см. ПрочитатьДокумент, поле Документ
//
// Возвращаемое значение:
//   Массив структур:
//     * КодТитула - Строка - например "1110339"
//     * Имя       - Строка - например "Погрузка"
//     * ЕстьГруз  - Булево - есть ли в титуле непустой узел Груз.Позиция
//     * Данные    - Соответствие - сами данные титула
//
Функция ТитулыЭТрН(Документ) Экспорт

	РезультатФункции = Новый Массив;

	Подстановки = ЭАрМ_Служебный.ЗначениеУзла(Документ, "Подстановки");

	Если Подстановки = Неопределено Тогда
		// Подстраховка на случай, если документ передали завёрнутым
		Подстановки = ЭАрМ_Служебный.ЗначениеПоПути(Документ, "Документ.Подстановки");
	КонецЕсли;

	Если Подстановки = Неопределено Тогда
		Возврат РезультатФункции;
	КонецЕсли;

	КодыТитулов = ЭАрМ_Служебный.КодыТитуловЭТрН();

	Для Каждого ЭлементПодстановки Из Подстановки Цикл

		ИмяПодстановки = Строка(ЭлементПодстановки.Ключ);
		КодТитула = СтрЗаменить(ИмяПодстановки, "ЭТрН_", "");

		МассивТитулов = ЭАрМ_Служебный.ЗначениеВМассив(ЭлементПодстановки.Значение);

		Для Каждого ДанныеТитула Из МассивТитулов Цикл

			Позиции = ЭАрМ_Служебный.ЗначениеПоПути(ДанныеТитула, "Груз.Позиция");

			ОписаниеТитула = Новый Структура;
			ОписаниеТитула.Вставить("КодТитула", КодТитула);
			ОписаниеТитула.Вставить("Имя",       КодыТитулов.Получить(КодТитула));
			ОписаниеТитула.Вставить("ЕстьГруз",  ЗначениеЗаполнено(Позиции));
			ОписаниеТитула.Вставить("Данные",    ДанныеТитула);

			Если ОписаниеТитула.Имя = Неопределено Тогда
				ОписаниеТитула.Имя = ИмяПодстановки;
			КонецЕсли;

			РезультатФункции.Добавить(ОписаниеТитула);

		КонецЦикла;

	КонецЦикла;

	Возврат РезультатФункции;

КонецФункции

// Сводка титулов ЭТрН одной строкой для формы реестра: какие титулы
// есть в документе, в порядке титульного flow. Титулы в документе - это
// подписанные этапы, поэтому сводка отвечает на вопрос "до какого титула
// дошла накладная".
//
// Параметры:
//   Документ - Соответствие - см. ПрочитатьДокумент, поле Документ
//
// Возвращаемое значение:
//   Строка - например "✓ Погрузка, ✓ ПолучениеГруза, ✓ Переадресовка";
//            пусто, если титулов в документе нет
//
Функция СводкаТитуловЭТрН(Документ) Экспорт

	Титулы = ТитулыЭТрН(Документ);
	Если Титулы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	ИменаПрисутствующих = Новый Соответствие;
	Для Каждого ОписаниеТитула Из Титулы Цикл
		ИменаПрисутствующих.Вставить(ОписаниеТитула.КодТитула, ОписаниеТитула.Имя);
	КонецЦикла;

	Части = Новый Массив;

	// Сначала известные титулы в порядке титульного flow.
	Для Каждого КодТитула Из ЭАрМ_Служебный.ПорядокТитуловЭТрН() Цикл

		ИмяТитула = ИменаПрисутствующих.Получить(КодТитула);
		Если ИмяТитула <> Неопределено Тогда
			Части.Добавить("✓ " + ИмяТитула);
			ИменаПрисутствующих.Удалить(КодТитула);
		КонецЕсли;

	КонецЦикла;

	// Коды вне известного порядка (новые титулы СБИС) не теряем.
	Для Каждого КлючИЗначение Из ИменаПрисутствующих Цикл
		Части.Добавить("✓ " + КлючИЗначение.Значение);
	КонецЦикла;

	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Разбирает груз транспортной накладной в плоский массив позиций.
//
// У ЭТрН нет номенклатуры в смысле ЭДО-накладной: перевозится груз,
// и он описан в титуле, в узле Груз.Позиция. Заполняет груз грузоотправитель
// в титуле "Погрузка" (код 1110339), поэтому по умолчанию берётся он.
// Если в "Погрузке" груза нет, берётся первый титул с непустым грузом.
// Предпочтение "Погрузке" обязательно: порядок обхода узла Подстановки
// (Соответствие) не гарантирован, и титул с уточняющим грузом
// (Переадресовка, ИзменениеСтоимости) мог обойти "Погрузку"
// и переиграть состав груза.
//
// Параметры:
//   Документ  - Соответствие - см. ПрочитатьДокумент, поле Документ
//   КодТитула - Строка - конкретный титул, например "1110339".
//               Пусто - "Погрузка" (1110339) с грузом, иначе первый титул с грузом.
//
// Возвращаемое значение:
//   Структура:
//     * Успех     - Булево
//     * Ошибка    - Строка
//     * КодТитула - Строка - из какого титула взят груз
//     * Позиции   - Массив структур - см. ПозицияГруза
//
Функция ПолучитьГрузЭТрН(Документ, КодТитула = "") Экспорт

	Результат = ЭАрМ_Служебный.НовыйРезультатГруза();

	Титулы = ТитулыЭТрН(Документ);
	Если Титулы.Количество() = 0 Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = СтрШаблон(
			"[%1] В документе нет узла ""Подстановки"", а титулы лежат только в нём."
			+ " Что пришло в документе: %2",
			ВерсияМодуля(), ЭАрМ_Служебный.КлючиУзла(Документ));
		Возврат Результат;
	КонецЕсли;

	ТитулСГрузом = Неопределено;
	ПервыйТитулСГрузом = Неопределено;

	Для Каждого ОписаниеТитула Из Титулы Цикл

		Если ЗначениеЗаполнено(КодТитула) Тогда
			Если ОписаниеТитула.КодТитула = КодТитула Тогда
				ТитулСГрузом = ОписаниеТитула;
				Прервать;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если НЕ ОписаниеТитула.ЕстьГруз Тогда
			Продолжить;
		КонецЕсли;

		Если ПервыйТитулСГрузом = Неопределено Тогда
			ПервыйТитулСГрузом = ОписаниеТитула;
		КонецЕсли;

		// Приоритет у "Погрузки" (1110339) - см. комментарий к функции.
		Если ОписаниеТитула.КодТитула = "1110339" Тогда
			ТитулСГрузом = ОписаниеТитула;
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Если ТитулСГрузом = Неопределено
		И НЕ ЗначениеЗаполнено(КодТитула) Тогда
		ТитулСГрузом = ПервыйТитулСГрузом;
	КонецЕсли;

	Если ТитулСГрузом = Неопределено Тогда
		Результат.Успех = Ложь;
		Если ЗначениеЗаполнено(КодТитула) Тогда
			Результат.Ошибка = СтрШаблон("В документе нет титула %1", КодТитула);
		Иначе
			Результат.Ошибка = "Ни в одном титуле документа нет груза";
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Результат.КодТитула = ТитулСГрузом.КодТитула;
	Результат.ИмяТитула = ТитулСГрузом.Имя;

	// Маршрут лежит в том же титуле, что и груз. Заполняем до разбора позиций:
	// адрес доставки нужен и тогда, когда груз не заполнен.
	Результат.Пункты = ПунктыМаршрутаЭТрН(ТитулСГрузом.Данные);

	Для Каждого ОписаниеПункта Из Результат.Пункты Цикл

		Если ОписаниеПункта.Вид = "Выгрузка" Тогда
			Если НЕ ЗначениеЗаполнено(Результат.АдресДоставки) Тогда
				Результат.АдресДоставки = ОписаниеПункта.Адрес;
				Результат.ДоставитьДо   = ОписаниеПункта.ДатаВремя;
			КонецЕсли;
		ИначеЕсли НЕ ЗначениеЗаполнено(Результат.АдресПогрузки) Тогда
			Результат.АдресПогрузки = ОписаниеПункта.Адрес;
		КонецЕсли;

	КонецЦикла;

	Позиции = ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеПоПути(ТитулСГрузом.Данные, "Груз.Позиция"));

	НомерСтроки = 1;
	Для Каждого Груз Из Позиции Цикл
		Результат.Позиции.Добавить(ЭАрМ_Служебный.ПозицияГруза(Груз, НомерСтроки));
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает название стороны документа.
//
// Сторона приходит вложенным узлом, а не строкой: у юрлица название лежит
// в СвЮЛ.Название, у физлица - в СвФЛ (полное название либо ФИО по частям).
// Поэтому чтение "Контрагент.Название" в лоб даёт пустую строку.
//
// Параметры:
//   ДанныеСтороны - Соответствие, Неопределено - узел стороны
//
// Возвращаемое значение:
//   Строка
//
Функция НазваниеСтороны(ДанныеСтороны) Экспорт

	Если ДанныеСтороны = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	СведенияЮЛ = ЭАрМ_Служебный.ЗначениеУзла(ДанныеСтороны, "СвЮЛ");
	Если СведенияЮЛ <> Неопределено Тогда
		Возврат ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(СведенияЮЛ, "Название"));
	КонецЕсли;

	СведенияФЛ = ЭАрМ_Служебный.ЗначениеУзла(ДанныеСтороны, "СвФЛ");
	Если СведенияФЛ <> Неопределено Тогда

		НазваниеПолное = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(СведенияФЛ, "НазваниеПолное"));
		Если ЗначениеЗаполнено(НазваниеПолное) Тогда
			Возврат НазваниеПолное;
		КонецЕсли;

		НазваниеФЛ = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(СведенияФЛ, "Название"));
		Если ЗначениеЗаполнено(НазваниеФЛ) Тогда
			Возврат НазваниеФЛ;
		КонецЕсли;

		ЧастиИмени = Новый Массив;
		Для Каждого ИмяЧасти Из СтрРазделить("Фамилия,Имя,Отчество", ",", Ложь) Цикл
			ЧастьИмени = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(СведенияФЛ, ИмяЧасти));
			Если ЗначениеЗаполнено(ЧастьИмени) Тогда
				ЧастиИмени.Добавить(ЧастьИмени);
			КонецЕсли;
		КонецЦикла;

		Возврат СтрСоединить(ЧастиИмени, " ");

	КонецЕсли;

	Возврат ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ДанныеСтороны, "Название"));

КонецФункции

// Возвращает реквизиты стороны: название, ИНН и КПП.
// Для приходной накладной название бесполезно без ИНН - по нему приёмник
// сопоставляет контрагента.
//
// Параметры:
//   ДанныеСтороны - Соответствие, Неопределено - узел стороны
//
// Возвращаемое значение:
//   Структура - Название, ИНН, КПП
//
Функция РеквизитыСтороны(ДанныеСтороны) Экспорт

	Результат = Новый Структура("Название, ИНН, КПП", "", "", "");

	Если ДанныеСтороны = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Название = НазваниеСтороны(ДанныеСтороны);

	СведенияЮЛ = ЭАрМ_Служебный.ЗначениеУзла(ДанныеСтороны, "СвЮЛ");
	Если СведенияЮЛ <> Неопределено Тогда
		Результат.ИНН = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(СведенияЮЛ, "ИНН", ""));
		Результат.КПП = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(СведенияЮЛ, "КПП", ""));
		Возврат Результат;
	КонецЕсли;

	СведенияФЛ = ЭАрМ_Служебный.ЗначениеУзла(ДанныеСтороны, "СвФЛ");
	Если СведенияФЛ <> Неопределено Тогда
		Результат.ИНН = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(СведенияФЛ, "ИНН", ""));
		Возврат Результат;
	КонецЕсли;

	Результат.ИНН = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ДанныеСтороны, "ИНН", ""));
	Результат.КПП = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ДанныеСтороны, "КПП", ""));

	Возврат Результат;

КонецФункции

// Возвращает стороны документа готовыми строками.
//
// Своя сторона и контрагент зависят от направления: у входящего мы получатель,
// у исходящего - отправитель. Ровно так же разводит реестры сам СБИС.
//
// Параметры:
//   ДокументСБИС - Соответствие - документ из реестра или из ПрочитатьДокумент
//   Направление  - Строка - "Входящий" или "Исходящий"
//
// Возвращаемое значение:
//   Структура - Организация, Контрагент, Отправитель, Получатель,
//               Перевозчик, Заказчик
//
Функция СтороныДокумента(ДокументСБИС, Направление = "Входящий") Экспорт

	Стороны = ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Стороны");

	// Роли в узле "Стороны" называются по-разному в зависимости от того,
	// кто и как заводил документ. Перебираем известные варианты.
	Отправитель = ЭАрМ_Служебный.НазваниеСтороныПоКлючам(Стороны, "Отправитель,Грузоотправитель,Продавец");
	Получатель  = ЭАрМ_Служебный.НазваниеСтороныПоКлючам(Стороны, "Получатель,Грузополучатель,Покупатель");

	Если ВРег(Направление) = ВРег("Исходящий") Тогда
		Организация = Отправитель;
		Контрагент  = Получатель;
	Иначе
		Организация = Получатель;
		Контрагент  = Отправитель;
	КонецЕсли;

	// Если СБИС прислал стороны отдельными узлами - они точнее отбора
	НазваниеОрганизации = НазваниеСтороны(ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "НашаОрганизация"));
	Если ЗначениеЗаполнено(НазваниеОрганизации) Тогда
		Организация = НазваниеОрганизации;
	КонецЕсли;

	НазваниеКонтрагента = НазваниеСтороны(ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Контрагент"));
	Если ЗначениеЗаполнено(НазваниеКонтрагента) Тогда
		Контрагент = НазваниеКонтрагента;
	КонецЕсли;

	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Организация", Организация);
	РезультатФункции.Вставить("Контрагент",  Контрагент);
	РезультатФункции.Вставить("Отправитель", Отправитель);
	РезультатФункции.Вставить("Получатель",  Получатель);
	РезультатФункции.Вставить("Перевозчик",
		ЭАрМ_Служебный.НазваниеСтороныПоКлючам(Стороны, "Перевозчик,Грузоперевозчик"));
	РезультатФункции.Вставить("Заказчик",
		ЭАрМ_Служебный.НазваниеСтороныПоКлючам(Стороны, "Заказчик,ВладелецОбъекта"));

	Возврат РезультатФункции;

КонецФункции

// Возвращает описание того, что реально пришло в документе и в узле "Стороны".
// Нужно, когда ожидаемая сторона пустая: имена ролей в ответе СБИС зависят
// от того, кем и как заведён документ, и угадывать их бессмысленно.
//
// Параметры:
//   ДокументСБИС - Соответствие - документ из реестра
//
// Возвращаемое значение:
//   Строка
//
Функция ОписаниеСторонДляДиагностики(ДокументСБИС) Экспорт

	Возврат СтрШаблон("узлы документа: [%1]; узлы ""Стороны"": [%2]",
		ЭАрМ_Служебный.КлючиУзла(ДокументСБИС),
		ЭАрМ_Служебный.КлючиУзла(ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Стороны")));

КонецФункции

// Возвращает пункты маршрута из данных титула: погрузка и выгрузка.
// Адрес доставки - это адрес пункта выгрузки.
//
// Параметры:
//   ДанныеТитула - Соответствие - данные титула (см. ТитулыЭТрН, поле Данные)
//
// Возвращаемое значение:
//   Массив структур:
//     * Вид         - Строка - "Погрузка" или "Выгрузка"
//     * НомерПункта - Число - порядковый номер в рамках вида
//     * Адрес       - Строка
//     * GLN         - Строка
//     * ДатаВремя   - Строка - плановые дата и время по пункту
//
Функция ПунктыМаршрутаЭТрН(ДанныеТитула) Экспорт

	РезультатФункции = Новый Массив;

	ЭАрМ_Служебный.ДобавитьПунктыМаршрута(РезультатФункции, ЭАрМ_Служебный.ЗначениеУзла(ДанныеТитула, "ПунктПогрузки"), "Погрузка");
	ЭАрМ_Служебный.ДобавитьПунктыМаршрута(РезультатФункции, ЭАрМ_Служебный.ЗначениеУзла(ДанныеТитула, "ПунктВыгрузки"), "Выгрузка");

	Возврат РезультатФункции;

КонецФункции

// Возвращает адрес пункта строкой и его GLN.
//
// Параметры:
//   ДанныеПункта - Соответствие - узел ПунктПогрузки или ПунктВыгрузки
//
// Возвращаемое значение:
//   Структура - Адрес, GLN
//
Функция АдресПункта(ДанныеПункта) Экспорт

	РезультатФункции = Новый Структура("Адрес, GLN", "", "");

	ДанныеАдреса = ЭАрМ_Служебный.ЗначениеПоПути(ДанныеПункта, "Адрес.Фактический");
	Если ДанныеАдреса = Неопределено Тогда
		Возврат РезультатФункции;
	КонецЕсли;

	РезультатФункции.GLN = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ДанныеАдреса, "GLN", ""));

	// Обычно адрес приходит готовой строкой, но узел называется по-разному,
	// а иногда строки нет вовсе - тогда собираем из частей структуры.
	АдресСтрокой = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ДанныеАдреса, "Текст", ""));

	Если НЕ ЗначениеЗаполнено(АдресСтрокой) Тогда
		АдресСтрокой = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ДанныеАдреса, "АдресТекст", ""));
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(АдресСтрокой) Тогда
		АдресСтрокой = ЭАрМ_Служебный.АдресИзЧастей(ЭАрМ_Служебный.ЗначениеУзла(ДанныеАдреса, "Структура"));
	КонецЕсли;

	РезультатФункции.Адрес = АдресСтрокой;

	Возврат РезультатФункции;

КонецФункции

// Разворачивает позицию груза в список детализирующих строк.
//
// ВАЖНО: "КоличествоМест" - это просто число из Параметры.КоличествоМест,
// отдельных объектов-мест формат ЭТрН не передаёт. Развернуть 5 мест
// в 5 строк неоткуда. Детализация существует только там, где СБИС реально
// присылает списки: номера контейнеров, коды маркировки, идентификаторы
// госсистем и опасные грузы.
//
// Параметры:
//   Позиция - Структура - см. ПозицияГруза
//
// Возвращаемое значение:
//   Массив структур:
//     * Вид        - Строка - откуда строка (Контейнер, Маркировка, ...)
//     * Значение   - Строка - номер, код, идентификатор
//     * Количество - Число
//
Функция ДеталиПозицииГруза(Позиция) Экспорт

	РезультатФункции = Новый Массив;

	Для Каждого ОписаниеКонтейнера Из Позиция.Контейнеры Цикл
		ЭАрМ_Служебный.ДобавитьДетальГруза(РезультатФункции, "Контейнер",
			ОписаниеКонтейнера.Номер, ОписаниеКонтейнера.Количество);
	КонецЦикла;

	Для Каждого КодМаркировки Из Позиция.Маркировки Цикл
		ЭАрМ_Служебный.ДобавитьДетальГруза(РезультатФункции, "Маркировка", КодМаркировки, 1);
	КонецЦикла;

	Для Каждого ОписаниеОпасногоГруза Из Позиция.ОпасныеГрузы Цикл
		ЭАрМ_Служебный.ДобавитьДетальГруза(РезультатФункции, "Опасный груз",
			ЭАрМ_Служебный.НаименованиеОпасногоГруза(ОписаниеОпасногоГруза), 1);
	КонецЦикла;

	Если Позиция.СведенияГИС <> Неопределено Тогда

		ВидГИС = "ГИС";
		Если ЗначениеЗаполнено(Позиция.СведенияГИС.Наименование) Тогда
			ВидГИС = "ГИС: " + Позиция.СведенияГИС.Наименование;
		КонецЕсли;

		Для Каждого ИдентификаторГИС Из Позиция.СведенияГИС.Идентификаторы Цикл
			ЭАрМ_Служебный.ДобавитьДетальГруза(РезультатФункции, ВидГИС, ИдентификаторГИС, 1);
		КонецЦикла;

	КонецЕсли;

	Возврат РезультатФункции;

КонецФункции

// Возвращает адрес доставки документа: адрес первого пункта выгрузки.
//
// Работает и на документе из реестра, и на прочитанном документе - лишь бы
// в нём были титулы (узел "Подстановки"). Если титулов нет, вернёт пустую
// строку: в реестре они появляются только когда запрошены в ДопПоля.
//
// Параметры:
//   ДокументСБИС - Соответствие - документ из реестра или из ПрочитатьДокумент
//
// Возвращаемое значение:
//   Строка
//
Функция АдресДоставкиДокумента(ДокументСБИС) Экспорт

	Для Каждого ОписаниеТитула Из ТитулыЭТрН(ДокументСБИС) Цикл

		Для Каждого ОписаниеПункта Из ПунктыМаршрутаЭТрН(ОписаниеТитула.Данные) Цикл

			Если ОписаниеПункта.Вид = "Выгрузка"
				И ЗначениеЗаполнено(ОписаниеПункта.Адрес) Тогда
				Возврат ОписаниеПункта.Адрес;
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Возврат "";

КонецФункции

// Читает документ по идентификатору и сразу возвращает разобранный груз.
// Свёртка ПрочитатьДокумент + ПолучитьГрузЭТрН в один вызов.
//
// Параметры:
//   Идентификатор - Строка - идентификатор документа из реестра
//   Сессия        - Строка - session ID (sid)
//   КодТитула     - Строка - конкретный титул, пусто - "Погрузка", иначе первый с грузом
//   АдресСервиса  - Строка - хост сервера (по умолчанию из настроек ЭДО)
//
// Возвращаемое значение:
//   Структура - см. НовыйРезультатГруза
//
Функция ПолучитьГрузПоИдентификатору(Идентификатор, Сессия = "",
		КодТитула = "", АдресСервиса = "") Экспорт

	ДанныеДокумента = ПрочитатьДокумент(Идентификатор, Сессия, АдресСервиса);

	Если НЕ ДанныеДокумента.Успех Тогда
		Результат = ЭАрМ_Служебный.НовыйРезультатГруза();
		Результат.Успех = Ложь;
		Результат.Ошибка = ДанныеДокумента.Ошибка;
		Результат.Идентификатор = Строка(Идентификатор);
		Возврат Результат;
	КонецЕсли;

	Результат = ПолучитьГрузЭТрН(ДанныеДокумента.Документ, КодТитула);
	Результат.Идентификатор = Строка(Идентификатор);

	Возврат Результат;

КонецФункции

// Сквозной сценарий для проверки из формы:
// авторизация -> реестр ЭТрН -> чтение первого документа -> разбор груза.
//
// Параметры:
//   Направление - Строка - "Входящий" или "Исходящий"
//   КодТитула   - Строка - конкретный титул, пусто - "Погрузка", иначе первый с грузом
//
// Возвращаемое значение:
//   Структура - см. НовыйРезультатГруза
//
Функция ПолучитьГрузПервойЭТрН(Направление = "Входящий", КодТитула = "") Экспорт

	Результат = ЭАрМ_Служебный.НовыйРезультатГруза();

	// Достаточно одного документа, поэтому размер страницы 1
	СписокЭТрН = АвторизоватьПриложение(, , , "ConsignmentNote", 0, 1, Направление);

	Если НЕ СписокЭТрН.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = СписокЭТрН.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Если СписокЭТрН.Документы.Количество() = 0 Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = СтрШаблон(
			"В реестре нет ни одной транспортной накладной (направление: %1)", Направление);
		Возврат Результат;
	КонецЕсли;

	Идентификатор = ЭАрМ_Служебный.ЗначениеУзла(СписокЭТрН.Документы[0], "Идентификатор", "");

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = "У документа в реестре нет идентификатора";
		Возврат Результат;
	КонецЕсли;

	Возврат ПолучитьГрузПоИдентификатору(Идентификатор, СписокЭТрН.Сессия, КодТитула);

КонецФункции

// ============================================================================
// УПД: ЦЕНЫ И СВЯЗЬ С ЭТрН
// ============================================================================

// Возвращает реестр товарных документов ЭДО (УПД, накладные, счета-фактуры).
//
// Это НЕ ЭПД: реестры ЭДО читаются методом СБИС.СписокДокументовПоСобытиям,
// а формат задаётся ключом "ТипВложения".
//
// Параметры:
//   Сессия         - Строка - session ID (sid)
//   ТипРеестра     - Строка - Входящие, Отправленные, Ответы контрагента
//   ТипВложения    - Строка - форматы через запятую
//   Страница       - Число
//   РазмерСтраницы - Число
//   АдресСервиса   - Строка
//
// Возвращаемое значение:
//   Структура - см. ПолучитьСписокДокументовПоСобытиям
//
Функция ПолучитьСписокУПД(Сессия = "", ТипРеестра = "Входящие",
		ТипВложения = "", Страница = 0, РазмерСтраницы = 100,
		АдресСервиса = "", ГлубинаДней = 0, ДопПоля = Неопределено,
		ДатаС = "", ДатаПо = "") Экспорт

	// Период задаём всегда: реестры ЭДО в референсе запрашиваются только
	// с ДатаС/ДатаПо, без периода ответ может прийти пустым. Окно реестра УПД -
	// те же 3 дня, что у ЭТрН (ЭАрМ_НастройкиСервер.ПериодРеестраУПД);
	// ГлубинаДней оставлен для совместимости вызовов и на период УПД не влияет.
	// Явные ДатаС/ДатаПо ("дд.ММ.гггг") - разовый запрос за свой период из формы
	Период = ЭАрМ_НастройкиСервер.ПериодРеестраУПД();
	Если ЗначениеЗаполнено(ДатаС) И ЗначениеЗаполнено(ДатаПо) Тогда
		Период = Новый Структура("ДатаС, ДатаПо", ДатаС, ДатаПо);
	КонецЕсли;

	// По умолчанию просим вложения сразу в списке: тогда ссылки на XML с
	// товарами приезжают вместе со страницей, и читать каждый документ
	// отдельно не нужно
	ЗапрашиваемыеПоля = ?(ДопПоля = Неопределено, ДопПоляСписка(), ДопПоля);

	Возврат ПолучитьСписокДокументовПоСобытиям(Сессия, ТипРеестра, ТипВложения,
		Страница, РазмерСтраницы, Период.ДатаС, Период.ДатаПо,
		АдресСервиса, , ЗапрашиваемыеПоля);

КонецФункции

// Дополнительные узлы, которые просим у реестра.
//
// Ровно те, что нужны для товаров: вложения дают ссылки на XML УПД,
// подстановки - титулы с грузом ЭТрН.
//
// Возвращаемое значение:
//   Строка
//
Функция ДопПоляСписка() Экспорт

	Возврат "Вложение,Подстановки";

КонецФункции

// Авторизуется и сразу возвращает реестр УПД.
//
// Симметрично АвторизоватьПриложение, но для товарных документов ЭДО:
// форме нужен один вызов, а не связка "авторизоваться, потом запросить".
//
// Параметры:
//   ТипРеестра     - Строка - Входящие, Отправленные, Ответы контрагента
//   ТипВложения    - Строка - форматы через запятую
//   Страница       - Число
//   РазмерСтраницы - Число
//
// Возвращаемое значение:
//   Структура:
//     * Успех     - Булево
//     * Ошибка    - Строка
//     * Сессия    - Строка (sid)
//     * Документы - Массив
//     * Навигация - Соответствие
//
Функция АвторизоватьИПолучитьУПД(ТипРеестра = "Входящие",
		ТипВложения = "УпдДоп,УпдСчфДоп,ЭДОНакл,СчФктр",
		Страница = 0, РазмерСтраницы = 100) Экспорт

	Результат = Новый Структура("Успех, Ошибка, Сессия, Документы, Навигация, Ответ",
		Истина, "", "", Новый Массив, Новый Соответствие, "");

	// Одна страница ЭТрН нужна только ради получения сессии
	Авторизация = АвторизоватьПриложение(, , , "ConsignmentNote", 0, 1);

	Если НЕ Авторизация.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = Авторизация.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Результат.Сессия = Авторизация.Сессия;

	РеестрУПД = ПолучитьСписокУПД(Результат.Сессия, ТипРеестра, ТипВложения,
		Страница, РазмерСтраницы);

	Если НЕ РеестрУПД.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = РеестрУПД.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Результат.Документы = РеестрУПД.Документы;
	Результат.Навигация = РеестрУПД.Навигация;
	Результат.Ответ     = РеестрУПД.Ответ;

	Возврат Результат;

КонецФункции

// Возвращает документы, на которые ссылается ЭТрН.
//
// В титуле ЭТрН сопроводительные документы разложены по ролям:
//   ДокументОснование                        - документ передачи ценностей (УПД)
//   СопроводительныеДокументы.Отгрузка[]     - тоже передача ценностей
//   СопроводительныеДокументы.Груз[]         - документы к грузу
//   СопроводительныеДокументы.ТранспортнаяНакладная[]
//   СопроводительныеДокументы.Ведомость
//   ДоговорНаУслугиПеревозки
//
// У каждого есть Номер, Дата, Наименование и Идентификатор - последний и есть
// прямая ссылка на документ в СБИС.
//
// Параметры:
//   ДокументСБИС - Соответствие - прочитанный документ ЭТрН
//
// Возвращаемое значение:
//   Массив структур - Роль, Номер, Дата, Наименование, Идентификатор
//
Функция СвязанныеДокументыЭТрН(ДокументСБИС) Экспорт

	РезультатФункции = Новый Массив;

	Для Каждого ОписаниеТитула Из ТитулыЭТрН(ДокументСБИС) Цикл

		ДанныеТитула = ОписаниеТитула.Данные;

		// ДокументОснование лежит не в корне титула, а внутри узла "Другой"
		// (данные отгрузчика). Корень проверяем на случай другой раскладки.
		ЭАрМ_Служебный.ДобавитьСвязанныйДокумент(РезультатФункции,
			ЭАрМ_Служебный.ЗначениеПоПути(ДанныеТитула, "Другой.ДокументОснование"), "ДокументОснование");

		ЭАрМ_Служебный.ДобавитьСвязанныйДокумент(РезультатФункции,
			ЭАрМ_Служебный.ЗначениеУзла(ДанныеТитула, "ДокументОснование"), "ДокументОснование");

		ЭАрМ_Служебный.ДобавитьСвязанныйДокумент(РезультатФункции,
			ЭАрМ_Служебный.ЗначениеПоПути(ДанныеТитула, "СопроводительныеДокументы.Ведомость"), "Ведомость");

		ЭАрМ_Служебный.ДобавитьСвязанныйДокумент(РезультатФункции,
			ЭАрМ_Служебный.ЗначениеУзла(ДанныеТитула, "ДоговорНаУслугиПеревозки"), "ДоговорПеревозки");

		СписокРолей = "Отгрузка,Груз,ТранспортнаяНакладная";
		Для Каждого ИмяРоли Из СтрРазделить(СписокРолей, ",", Ложь) Цикл

			УзелРоли = ЭАрМ_Служебный.ЗначениеПоПути(ДанныеТитула, "СопроводительныеДокументы." + ИмяРоли);
			Для Каждого ДанныеДокумента Из ЭАрМ_Служебный.ЗначениеВМассив(УзелРоли) Цикл
				ЭАрМ_Служебный.ДобавитьСвязанныйДокумент(РезультатФункции, ДанныеДокумента, ИмяРоли);
			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

	Возврат РезультатФункции;

КонецФункции

// Возвращает ИНН стороны из узла ответа.
//
Функция ИННСтороны(ДанныеСтороны) Экспорт

	Возврат РеквизитыСтороны(ДанныеСтороны).ИНН;

КонецФункции

// Перечисляет титулы документа и их узлы - для диагностики, когда ожидаемого
// узла в титуле не оказалось.
//
Функция ОписаниеТитуловДляДиагностики(ДокументСБИС) Экспорт

	Титулы = ТитулыЭТрН(ДокументСБИС);

	Если Титулы.Количество() = 0 Тогда
		Возврат СтрШаблон("титулов нет, узлы документа: [%1]", ЭАрМ_Служебный.КлючиУзла(ДокументСБИС));
	КонецЕсли;

	ЧастиОписания = Новый Массив;

	Для Каждого ОписаниеТитула Из Титулы Цикл
		ЧастиОписания.Добавить(СтрШаблон("%1 [%2]",
			ОписаниеТитула.КодТитула, ЭАрМ_Служебный.КлючиУзла(ОписаниеТитула.Данные)));
	КонецЦикла;

	Возврат СтрСоединить(ЧастиОписания, "; ");

КонецФункции

// Читает УПД и возвращает строки товаров с ценами.
//
// Строки лежат не в JSON, а во вложении - XML формата ФНС. Поэтому:
// прочитать документ -> найти неслужебное вложение -> скачать файл ->
// разобрать XML -> Файл/Документ/ТаблДок/СтрТабл.
//
// Параметры:
//   ИдентификаторУПД - Строка - документ УПД в СБИС
//   Сессия           - Строка - session ID (sid)
//   АдресСервиса     - Строка
//   КешСоединений    - см. ЭАрМ_Служебный.НовыйКешСоединенийСБИС
//
// Возвращаемое значение:
//   Структура:
//     * Успех     - Булево
//     * Ошибка    - Строка
//     * Товары    - Массив структур - см. СтрокаТовараУПД
//     * ИмяФайла  - Строка - какое вложение разобрали
//     * КлючиСтроки - Строка - какие поля реально пришли в первой строке
//
Функция ПолучитьТоварыУПД(ИдентификаторУПД, Сессия = "", АдресСервиса = "",
		КешСоединений = Неопределено) Экспорт

	// Для отдельных документов СБИС не возвращает ссылки на файлы без
	// явного запроса узла Вложение. Если текущий аккаунт не принимает это
	// дополнительное поле, сохраняем совместимость повтором без ДопПоля.
	ДанныеДокумента = ПрочитатьДокумент(
		ИдентификаторУПД, Сессия, АдресСервиса, "Вложение",
		КешСоединений);

	Если ДанныеДокумента.Успех Тогда
		РезультатСВложением = ТоварыУПДИзУзлаДокумента(
			ДанныеДокумента.Документ, Сессия, АдресСервиса,
			КешСоединений);
		Если РезультатСВложением.Успех
			И РезультатСВложением.Товары.Количество() > 0 Тогда
			Возврат РезультатСВложением;
		КонецЕсли;
	КонецЕсли;

	// Ответ может быть успешным, но различаться по составу базовых и
	// дополнительных полей. Второй вариант также проверяем до отказа.
	ДанныеБезДопПолей = ПрочитатьДокумент(
		ИдентификаторУПД, Сессия, АдресСервиса, "",
		КешСоединений);

	Если НЕ ДанныеБезДопПолей.Успех Тогда
		Результат = НовыйРезультатТоваровУПД();
		Результат.Успех = Ложь;
		Результат.Ошибка = ДанныеБезДопПолей.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Возврат ТоварыУПДИзУзлаДокумента(
		ДанныеБезДопПолей.Документ, Сессия, АдресСервиса,
		КешСоединений);

КонецФункции

// Заготовка результата ПолучитьТоварыУПД.
//
Функция НовыйРезультатТоваровУПД() Экспорт

	Возврат Новый Структура(
		"Успех, Ошибка, Товары, ИмяФайла, КлючиСтроки, НомерТранснакладной,"
		+ " НомерДокумента, ДатаДокумента, НомерВФайле, ДатаВФайле, АдресВФайле,"
		+ " ЭтоКорректировка, НомерОснования, ДатаОснования",
		Истина, "", Новый Массив, "", "", "", "", "", "", "", "", Ложь, "", "");

КонецФункции

// Разбирает товары по уже полученному узлу документа.
//
// Вынесено из ПолучитьТоварыУПД, чтобы не читать документ второй раз: строка
// реестра, которую вернул ПолучитьСписокУПД, обычно уже содержит вложения со
// ссылками. Тогда чтение документа - лишний запрос в СБИС на каждую строку.
// Если вложений в узле нет, вызывающий откатывается к ПолучитьТоварыУПД.
//
// Параметры:
//   УзелДокумента - Соответствие, Структура - узел документа либо строка реестра
//   Сессия        - Строка - sid
//   АдресСервиса  - Строка
//   КешСоединений - см. ЭАрМ_Служебный.НовыйКешСоединенийСБИС
//
// Возвращаемое значение:
//   Структура - см. ПолучитьТоварыУПД
//
Функция ТоварыУПДИзУзлаДокумента(УзелДокумента, Сессия = "", АдресСервиса = "",
		КешСоединений = Неопределено) Экспорт

	Результат = НовыйРезультатТоваровУПД();

	// Номер и дата нужны табличной части: по ним видно, из какого документа
	// пришла строка
	Результат.НомерДокумента = ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеУзла(УзелДокумента, "Номер", ""));
	Результат.ДатаДокумента = ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеУзла(УзелДокумента, "Дата", ""));

	ВложенияКандидаты = ЭАрМ_Служебный.ВложенияСДаннымиТоваров(УзелДокумента);

	Если ВложенияКандидаты.Количество() = 0 Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = СтрШаблон(
			"У документа нет XML-вложения со ссылкой на файл."
			+ " Узлы документа: %1. Вложения: %2",
			ЭАрМ_Служебный.КлючиУзла(УзелДокумента),
			ЭАрМ_Служебный.ИменаВложенийДляДиагностики(УзелДокумента));
		Возврат Результат;
	КонецЕсли;

	// Какой именно XML содержит таблицу товаров, по имени видно не всегда,
	// поэтому проверяем кандидатов по очереди и берём первый со строками.
	ДиагностикаПопыток = Новый Массив;

	Для Каждого ОписаниеВложения Из ВложенияКандидаты Цикл

		Результат.ИмяФайла = ОписаниеВложения.Имя;

		// Скачиваем в файл, а не в строку: XML формата ФНС объявляет
		// windows-1251, и ЧтениеXML корректно отработает кодировку только
		// при чтении файла. Строка из UTF-8 тела дала бы мусор или исключение.
		ПутьКВложению = ЭАрМ_Служебный.СкачатьВложениеВФайл(ОписаниеВложения, Сессия,
			АдресСервиса, КешСоединений);

		Если НЕ ЗначениеЗаполнено(ПутьКВложению) Тогда
			ДиагностикаПопыток.Добавить(СтрШаблон("%1: не удалось скачать"
				+ " (подробности в журнале регистрации)", ОписаниеВложения.Имя));
			Продолжить;
		КонецЕсли;

		РазобранныеТовары = ЭАрМ_Служебный.РазобратьТоварыИзФайлаУПД(ПутьКВложению);
		ЭАрМ_Служебный.УдалитьВременныйФайл(ПутьКВложению);

		Если РазобранныеТовары.Товары.Количество() > 0 Тогда

			Результат.Товары              = РазобранныеТовары.Товары;
			Результат.КлючиСтроки         = РазобранныеТовары.КлючиСтроки;
			Результат.НомерТранснакладной = РазобранныеТовары.НомерТранснакладной;
			Результат.НомерВФайле         = РазобранныеТовары.НомерВФайле;
			Результат.ДатаВФайле          = РазобранныеТовары.ДатаВФайле;
			Результат.АдресВФайле         = РазобранныеТовары.АдресВФайле;
			// Корректировочный документ: строки со значениями После и ссылка на
			// исправляемый счёт-фактуру, см. ЭАрМ_КорректировкиУПД
			Результат.ЭтоКорректировка    = РазобранныеТовары.ЭтоКорректировка;
			Результат.НомерОснования      = РазобранныеТовары.НомерОснования;
			Результат.ДатаОснования       = РазобранныеТовары.ДатаОснования;

			Возврат Результат;

		КонецЕсли;

		ДиагностикаПопыток.Добавить(СтрШаблон("%1: строк нет, %2",
			ОписаниеВложения.Имя,
			?(ЗначениеЗаполнено(РазобранныеТовары.Ошибка),
				РазобранныеТовары.Ошибка, РазобранныеТовары.КлючиКорня)));

	КонецЦикла;

	Результат.Успех = Ложь;
	Результат.Ошибка = СтрШаблон(
		НСтр("ru = 'В документе не найдены строки товаров. Вложения: %1'"),
		СтрСоединить(ДиагностикаПопыток, "; "));

	Возврат Результат;

КонецФункции

// Извлекает и разбирает каждое вложение документа ЭДО по отдельности.
//
// Нужно для диагностики, когда непонятно, в каком именно вложении лежат
// строки товаров: документ ЭДО может содержать сразу несколько XML -
// информацию продавца, информацию покупателя (ON_N...) и прочие. Эта функция
// скачивает и разбирает их по очереди, не применяя отбор "продавец/покупатель".
//
// Параметры:
//   Идентификатор - Строка - документ УПД/накладной в СБИС
//   Сессия        - Строка - session ID (sid)
//   АдресСервиса  - Строка
//
// Возвращаемое значение:
//   Структура:
//     * Успех    - Булево
//     * Ошибка   - Строка
//     * Вложения - Массив структур по каждому вложению:
//         Имя, Ссылка, Служебный, Разобран, Ошибка,
//         Товаров, КлючиКорня, КлючиСтроки, НомерТранснакладной,
//         Структура, Товары
//
Функция РазобратьВложенияДокумента(Идентификатор, Сессия = "", АдресСервиса = "") Экспорт

	Результат = Новый Структура("Успех, Ошибка, Вложения",
		Истина, "", Новый Массив);

	// ДопПоля не передаём, как и в ПолучитьТоварыУПД: вложения приходят и без них
	ДанныеДокумента = ПрочитатьДокумент(Идентификатор, Сессия, АдресСервиса, "");

	Если НЕ ДанныеДокумента.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = ДанныеДокумента.Ошибка;
		Возврат Результат;
	КонецЕсли;

	УзелВложений = ЭАрМ_Служебный.ЗначениеУзла(ДанныеДокумента.Документ, "Вложение");
	Если УзелВложений = Неопределено Тогда
		УзелВложений = ЭАрМ_Служебный.ЗначениеУзла(ДанныеДокумента.Документ, "Вложения");
	КонецЕсли;

	Для Каждого ДанныеВложения Из ЭАрМ_Служебный.ЗначениеВМассив(УзелВложений) Цикл

		ИмяФайла  = ЭАрМ_Служебный.ЗначениеВложенияПоПути(ДанныеВложения,
			"Файл.Имя,Имя,Файл.ИмяФайла,Наименование");
		Ссылка    = ЭАрМ_Служебный.ЗначениеВложенияПоПути(ДанныеВложения,
			"Файл.Ссылка,Ссылка,Файл.СсылкаНаФайл,URL");
		Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
			Ссылка = ЭАрМ_Служебный.НайтиЗначениеПоИмениКлюча(ДанныеВложения, "Ссылка,URL,СсылкаНаФайл");
		КонецЕсли;
		Служебный = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ДанныеВложения, "Служебный", ""));

		ОписаниеВложения = Новый Структура;
		ОписаниеВложения.Вставить("Имя",       ИмяФайла);
		ОписаниеВложения.Вставить("Ссылка",    Ссылка);
		ОписаниеВложения.Вставить("Служебный", Служебный);
		ОписаниеВложения.Вставить("КлючиУзла", СтрШаблон("вложение [%1], Файл [%2]",
			ЭАрМ_Служебный.КлючиУзла(ДанныеВложения), ЭАрМ_Служебный.КлючиУзла(ЭАрМ_Служебный.ЗначениеУзла(ДанныеВложения, "Файл"))));
		ОписаниеВложения.Вставить("Разобран",  Ложь);
		ОписаниеВложения.Вставить("Ошибка",    "");
		ОписаниеВложения.Вставить("Товаров",   0);
		ОписаниеВложения.Вставить("КлючиКорня", "");
		ОписаниеВложения.Вставить("КлючиСтроки", "");
		ОписаниеВложения.Вставить("НомерТранснакладной", "");
		ОписаниеВложения.Вставить("Структура", "");
		ОписаниеВложения.Вставить("Товары",    Новый Массив);

		Результат.Вложения.Добавить(ОписаниеВложения);

		// Служебные вложения (подписи, извещения) и не-XML не разбираем
		Если Служебный = "Да" Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(ИмяФайла) И НРег(Прав(ИмяФайла, 4)) <> ".xml" Тогда
			Продолжить;
		КонецЕсли;

		ОписаниеСкачивания = Новый Структура("Имя, Ссылка, Идентификатор",
			ИмяФайла, Ссылка,
			ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ДанныеВложения, "Идентификатор", "")));

		ПутьКВложению = ЭАрМ_Служебный.СкачатьВложениеВФайл(ОписаниеСкачивания, Сессия, АдресСервиса);

		Если НЕ ЗначениеЗаполнено(ПутьКВложению) Тогда
			ОписаниеВложения.Ошибка = "не удалось скачать";
			Продолжить;
		КонецЕсли;

		РазобранноеВложение = РазобратьВложениеИзФайла(ПутьКВложению);

		ЭАрМ_Служебный.УдалитьВременныйФайл(ПутьКВложению);

		ОписаниеВложения.Разобран = Истина;
		ОписаниеВложения.Товары   = РазобранноеВложение.Товары;
		ОписаниеВложения.Товаров  = РазобранноеВложение.Товары.Количество();
		ОписаниеВложения.КлючиКорня  = РазобранноеВложение.КлючиКорня;
		ОписаниеВложения.КлючиСтроки = РазобранноеВложение.КлючиСтроки;
		ОписаниеВложения.НомерТранснакладной = РазобранноеВложение.НомерТранснакладной;
		ОписаниеВложения.Структура = РазобранноеВложение.Структура;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Разбирает скачанный XML вложения ЭДО: и структуру узлов, и строки товаров.
//
// Обёртка над РазобратьТоварыИзФайлаУПД + ОписаниеСтруктурыXML: одним вызовом
// получаем и полный перечень узлов (для диагностики формата), и товары.
//
// Параметры:
//   ПутьКФайлу - Строка - путь к скачанному XML вложения
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, Структура, Товары, КлючиКорня, КлючиСтроки,
//               НомерТранснакладной
//
Функция РазобратьВложениеИзФайла(ПутьКФайлу) Экспорт

	Результат = Новый Структура(
		"Успех, Ошибка, Структура, Товары, КлючиКорня, КлючиСтроки, НомерТранснакладной",
		Истина, "", "", Новый Массив, "", "", "");

	РазобранныеТовары = ЭАрМ_Служебный.РазобратьТоварыИзФайлаУПД(ПутьКФайлу);

	Результат.Успех               = НЕ ЗначениеЗаполнено(РазобранныеТовары.Ошибка);
	Результат.Ошибка              = РазобранныеТовары.Ошибка;
	Результат.Товары              = РазобранныеТовары.Товары;
	Результат.КлючиКорня          = РазобранныеТовары.КлючиКорня;
	Результат.КлючиСтроки         = РазобранныеТовары.КлючиСтроки;
	Результат.НомерТранснакладной = РазобранныеТовары.НомерТранснакладной;
	Результат.Структура           = ЭАрМ_Служебный.ОписаниеСтруктурыXML(
		ЭАрМ_Служебный.ПрочитатьXMLФайлВСоответствие(ПутьКФайлу));

	Возврат Результат;

КонецФункции

// ============================================================================
// СВЯЗИ ДОКУМЕНТОВ
// ============================================================================

// Возвращает документы, связанные с указанным.
//
// Отдельного метода "получить связанные документы" в API СБИС нет: связи
// приезжают вместе с самим документом. Собираем их из трёх мест сразу -
// какое из них заполнено, зависит от вида документа и от того, чем он заведён:
//   1. Расширение.ЦепочкаДокументов - цепочка от сервера (для неё в чтении
//      запрашивается ДопПоля "ЦепочкаДокументов");
//   2. LinkedOutflows - массив идентификаторов связанных документов;
//   3. сопроводительные документы из титулов ЭТрН - их разбирает
//      СвязанныеДокументыЭТрН.
//
// Параметры:
//   Идентификатор - Строка - документ ЭТрН или УПД в СБИС
//   Сессия        - Строка - session ID (sid)
//   АдресСервиса  - Строка
//
// Возвращаемое значение:
//   Структура:
//     * Успех         - Булево
//     * Ошибка        - Строка
//     * Документы     - Массив структур - см. НоваяСвязьДокументов
//     * ВидДокумента  - Строка - вид самого документа по вложениям (УПД, ЭТрН)
//     * КлючиСвязи    - Строка - см. КлючиСвязиДокумента
//     * Диагностика   - Строка - какие узлы связей пришли, для разбора вслепую
//
Функция ПолучитьСвязанныеДокументы(Идентификатор, Сессия = "", АдресСервиса = "") Экспорт

	Результат = Новый Структура(
		"Успех, Ошибка, Документы, ВидДокумента, КлючиСвязи, Диагностика",
		Истина, "", Новый Массив, "", "", "");

	ДанныеДокумента = ПрочитатьДокумент(Идентификатор, Сессия, АдресСервиса,
		ЭАрМ_Служебный.ДопПоляСоСвязями());

	Если НЕ ДанныеДокумента.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = ДанныеДокумента.Ошибка;
		Возврат Результат;
	КонецЕсли;

	ДокументСБИС = ДанныеДокумента.Документ;

	Результат.ВидДокумента = ЭАрМ_Служебный.ФорматДокументаПоВложениям(ДокументСБИС);
	Результат.КлючиСвязи   = ЭАрМ_Служебный.КлючиСвязиДокумента(ДокументСБИС);
	Результат.Диагностика  = ЭАрМ_Служебный.ОписаниеУзловСвязей(ДокументСБИС);

	// Сначала спрашиваем сам сервис: сопоставление - его работа, и его ответ
	// точнее любого нашего разбора. Метод отвечает не на всех аккаунтах,
	// поэтому остальные источники остаются как запасные.
	ОтветСвязей = ЗапроситьСвязанныеДокументы(Идентификатор, Сессия, "Основание", "",
		АдресСервиса);

	Если ОтветСвязей.Успех Тогда
		ЭАрМ_Служебный.СобратьДокументыИзУзла(ОтветСвязей.Данные, Результат.Документы,
			Строка(Идентификатор), "метод " + ОтветСвязей.Метод, 0);
	КонецЕсли;

	Результат.Диагностика = Результат.Диагностика + "; связи по API: "
		+ ?(ОтветСвязей.Успех, "метод " + ОтветСвязей.Метод, ОтветСвязей.Ошибка);

	ЭАрМ_Служебный.СобратьСвязиИзЦепочки(ДокументСБИС, Результат.Документы, Строка(Идентификатор));
	ЭАрМ_Служебный.СобратьСвязиИзСсылок(ДокументСБИС, Результат.Документы, Строка(Идентификатор));
	ЭАрМ_Служебный.СобратьСвязиИзТитулов(ДокументСБИС, Результат.Документы, Строка(Идентификатор));

	Возврат Результат;

КонецФункции

// Ищет среди связей документа заказ (заявку) на перевозку.
//
// Параметры:
//   Идентификатор - Строка - документ ЭТрН или УПД в СБИС
//   Сессия        - Строка - session ID (sid)
//   АдресСервиса  - Строка
//
// Возвращаемое значение:
//   Структура:
//     * Успех         - Булево - удалось ли прочитать документ
//     * Ошибка        - Строка
//     * Найдена       - Булево
//     * Идентификатор - Строка - заявка в СБИС, если пришёл её идентификатор
//     * Номер, Дата   - Строка
//     * Вид           - Строка - как заявка названа в ответе
//     * Диагностика   - Строка - см. ПолучитьСвязанныеДокументы
//
Функция НайтиЗаявкуНаПеревозку(Идентификатор, Сессия = "", АдресСервиса = "") Экспорт

	Результат = Новый Структура(
		"Успех, Ошибка, Найдена, Идентификатор, Номер, Дата, Вид, Диагностика",
		Истина, "", Ложь, "", "", "", "", "");

	СвязиДокумента = ПолучитьСвязанныеДокументы(Идентификатор, Сессия, АдресСервиса);

	Результат.Диагностика = СвязиДокумента.Диагностика;

	Если НЕ СвязиДокумента.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = СвязиДокумента.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Для Каждого ОписаниеСвязи Из СвязиДокумента.Документы Цикл

		Если НЕ ОписаниеСвязи.ЭтоЗаявкаНаПеревозку Тогда
			Продолжить;
		КонецЕсли;

		Результат.Найдена       = Истина;
		Результат.Идентификатор = ОписаниеСвязи.Идентификатор;
		Результат.Номер         = ОписаниеСвязи.Номер;
		Результат.Дата          = ОписаниеСвязи.Дата;
		Результат.Вид           = ?(ЗначениеЗаполнено(ОписаниеСвязи.Вид),
			ОписаниеСвязи.Вид, ОписаниеСвязи.Наименование);

		Возврат Результат;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Показывает, что реально пришло в узлах связей документа.
//
// Разметка цепочки в документации не описана, а штатная обработка читает из
// неё только этапы. Поэтому перед разбором стоит посмотреть на живом документе,
// какие узлы и ключи в нём есть.
//
// Параметры:
//   Идентификатор - Строка - документ в СБИС
//   Сессия        - Строка - session ID (sid)
//   АдресСервиса  - Строка
//
// Возвращаемое значение:
//   Строка - описание узлов; текст ошибки, если документ не прочитан
//
Функция ОписаниеЦепочкиДокументов(Идентификатор, Сессия = "", АдресСервиса = "") Экспорт

	ДанныеДокумента = ПрочитатьДокумент(Идентификатор, Сессия, АдресСервиса,
		ЭАрМ_Служебный.ДопПоляСоСвязями());

	Если НЕ ДанныеДокумента.Успех Тогда
		Возврат "Документ не прочитан: " + ДанныеДокумента.Ошибка;
	КонецЕсли;

	Возврат ЭАрМ_Служебный.ОписаниеУзловСвязей(ДанныеДокумента.Документ);

КонецФункции

// Ищет документ ЭДО (УПД, накладную) строго по совпадению номера.
//
// Маска в СБИС.СписокДокументовПоСобытиям ищет широко - по номеру и по
// названию сразу, поэтому каждый кандидат проверяется точным совпадением
// нормализованного номера, и первое совпадение принимается как результат.
// Приблизительных совпадений и оценок здесь нет: не сошлось - значит нет.
//
// Ищем сразу в обоих направлениях реестра ЭДО ("Входящие"/"Отправленные"):
// связанный документ может лежать во встречном реестре.
//
// Параметры:
//   НомерДокумента - Строка - искомый номер
//   Сессия         - Строка - session ID (sid)
//   ТипРеестра     - Строка - реестр, с которого начать поиск
//   АдресСервиса   - Строка
//
// Возвращаемое значение:
//   Структура:
//     * Идентификатор - Строка - найденный документ; пусто, если не нашли
//     * Представление - Строка - имя документа для показа
//     * Номер, Дата, Наименование - Строка - реквизиты найденного
//     * Реестр        - Строка - в каком из двух реестров нашёлся
//     * ДокументРеестра - Соответствие, Неопределено - элемент реестра СБИС
//     * Ошибка        - Строка - причина, если не нашли или запрос не удался
//     * ОшибкаЗапроса - Строка - текст сбоя запроса к СБИС, если реестр не прочитан
//                       (сессия, сеть). Не пусто и Идентификатор пуст - это не
//                       «документа нет», а «не удалось проверить»
//     * Закрытых      - Число - сколько найденных с этим номером документов закрыты в
//                       СБИС (аннулированы, отозваны, удалены): они пропускаются
//     * Сессия        - Строка - sid, которым закончился поиск: при просрочке
//                       сессия перезапрашивается, вызывающему стоит взять новую
//
Функция НайтиУПДПоНомеру(НомерДокумента, Сессия = "", ТипРеестра = "Входящие",
		АдресСервиса = "") Экспорт

	Результат = Новый Структура(
		"Идентификатор, Представление, Номер, Дата, Наименование, Реестр, Ошибка, ДокументРеестра, ОшибкаЗапроса, Сессия, Закрытых",
		"", "", "", "", "", "", "", Неопределено, "", Сессия, 0);

	Если НЕ ЗначениеЗаполнено(НомерДокумента) Тогда
		Результат.Ошибка = "номер документа не заполнен";
		Возврат Результат;
	КонецЕсли;

	РеестрыДляПоиска = ?(ТипРеестра = "Отправленные",
		"Отправленные,Входящие", "Входящие,Отправленные");

	// Маска сужает выборку по номеру, но не по времени: без периода СБИС всё
	// равно идёт по всему архиву, и так дважды - по обоим реестрам. Окно поиска
	// шире глубины обмена, потому что связанная УПД бывает старше
	Период = ЭАрМ_НастройкиСервер.ПериодПоискаСБИС();

	Для Каждого ИмяРеестра Из СтрРазделить(РеестрыДляПоиска, ",", Ложь) Цикл

		ОтветРеестра = ПолучитьСписокДокументовПоСобытиям(Результат.Сессия, СокрЛП(ИмяРеестра), "",
			0, 50, Период.ДатаС, Период.ДатаПо, АдресСервиса,
			Новый Структура("Маска", НомерДокумента));

		// Сессия просрочилась - входим заново и повторяем запрос один раз.
		// Без этого отказ сессии выглядел как «документа нет»
		Если НЕ ОтветРеестра.Успех И ЭтоОшибкаСессии(ОтветРеестра.Ошибка) Тогда
			НоваяСессия = ПолучитьСессию(Истина);
			Если ЗначениеЗаполнено(НоваяСессия) Тогда
				Результат.Сессия = НоваяСессия;
				ОтветРеестра = ПолучитьСписокДокументовПоСобытиям(Результат.Сессия, СокрЛП(ИмяРеестра), "",
					0, 50, Период.ДатаС, Период.ДатаПо, АдресСервиса,
					Новый Структура("Маска", НомерДокумента));
			КонецЕсли;
		КонецЕсли;

		Если НЕ ОтветРеестра.Успех Тогда
			Результат.ОшибкаЗапроса = ОтветРеестра.Ошибка;
			Продолжить;
		КонецЕсли;

		Для Каждого ДокументРеестра Из ОтветРеестра.Документы Цикл

			НомерВРеестре = ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ДокументРеестра, "Номер", ""));

			Если НЕ ЭАрМ_Служебный.НомераСовпадают(НомерВРеестре, НомерДокумента) Тогда
				Продолжить;
			КонецЕсли;

			// Корректировка, ЭТрН или путевой лист с тем же номером - не та УПД.
			// ЭТрН поставщик часто нумерует так же, как УПД: раньше поиск брал её,
			// и в реестре УПД появлялся пустой дубль с грузом ЭТрН
			ФорматНайденного = ЭАрМ_Служебный.ФорматДокументаПоВложениям(ДокументРеестра);
			Если ФорматНайденного = "УКД" ИЛИ ФорматНайденного = "ЭТрН" ИЛИ ФорматНайденного = "ЭПЛ" Тогда
				Продолжить;
			КонецЕсли;

			// Аннулированная, отозванная, удалённая УПД с тем же номером - не та: взамен
			// неё поставщик присылает новую с тем же номером, а искать надо её
			СостояниеДокумента = ЭАрМ_Служебный.ЗначениеУзла(ДокументРеестра, "Состояние");
			Если ЭАрМ_УтверждениеСБИС.ДокументЗакрытВСБИС(
				ЭАрМ_УтверждениеСБИС.КодСостоянияСБИС(ДокументРеестра),
				ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(СостояниеДокумента, "Название", ""))) Тогда
				Результат.Закрытых = Результат.Закрытых + 1;
				Продолжить;
			КонецЕсли;

			Результат.Идентификатор = ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ДокументРеестра, "Идентификатор", ""));
			Результат.Номер         = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ДокументРеестра, "Номер", ""));
			Результат.Дата          = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ДокументРеестра, "Дата", ""));
			Результат.Наименование  = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ДокументРеестра, "Название", ""));
			Результат.Представление = ЭАрМ_Служебный.ПредставлениеДокументаЭДО(ДокументРеестра);
			Результат.Реестр        = СокрЛП(ИмяРеестра);
			Результат.ДокументРеестра = ДокументРеестра;

			Возврат Результат;

		КонецЦикла;

	КонецЦикла;

	Результат.Ошибка = ?(ЗначениеЗаполнено(Результат.ОшибкаЗапроса),
		СтрШаблон("запрос к СБИС не выполнен, документ ""%1"" не проверен: %2", НомерДокумента, Результат.ОшибкаЗапроса),
		?(Результат.Закрытых > 0,
			СтрШаблон("документ ""%1"" есть только аннулированный (закрытых: %2) - ждём новую взамен", НомерДокумента, Результат.Закрытых),
			СтрШаблон("документ с номером ""%1"" не найден", НомерДокумента)));

	Возврат Результат;

КонецФункции

// Превращает строки товаров УПД в позиции груза - формат, который понимает
// ТоварыДляДалион.
//
// Возвращаемое значение:
//   Массив структур - см. ПозицияГруза
//
Функция ПозицииИзТоваровУПД(ТоварыУПД) Экспорт

	РезультатФункции = Новый Массив;
	НомерСтроки = 1;

	Для Каждого СтрокаУПД Из ТоварыУПД Цикл

		Позиция = ЭАрМ_Служебный.ПозицияГруза(Новый Соответствие, НомерСтроки);

		Позиция.Наименование     = СтрокаУПД.Наименование;
		Позиция.Артикул          = СтрокаУПД.Артикул;
		Позиция.КодТовара        = ЭАрМ_Служебный.ЗначениеУзла(СтрокаУПД, "КодТовара", "");
		Позиция.Штрихкод         = ЭАрМ_Служебный.ЗначениеУзла(СтрокаУПД, "Штрихкод", "");

		// ТН ВЭД и признак алкоголя - колонка «Алкоголь» реестра УПД
		Позиция.Вставить("КодТНВЭД", ЭАрМ_Служебный.ЗначениеУзла(СтрокаУПД, "КодТНВЭД", ""));
		Позиция.Вставить("Алкоголь", ЭАрМ_АлкогольЕГАИС.АлкогольСтрокиУПД(СтрокаУПД));

		// ГТД и страна - для карточки номенклатуры УТ (ЭАрМ_КатегорииТоваров)
		Позиция.Вставить("НомерГТД", ЭАрМ_Служебный.ЗначениеУзла(СтрокаУПД, "НомерГТД", ""));
		Позиция.Вставить("СтранаПроисхождения", ЭАрМ_Служебный.ЗначениеУзла(СтрокаУПД, "СтранаПроисхождения", ""));
		Позиция.Вставить("РНПТ", ЭАрМ_Служебный.ЗначениеУзла(СтрокаУПД, "РНПТ", ""));
		Позиция.Вставить("СуммаАкциза", ЭАрМ_Служебный.ЗначениеУзла(СтрокаУПД, "СуммаАкциза", 0));

		// Коды маркировки из УПД: по ним в регистре товаров считается Маркировок,
		// и строка реестра товаров по заказам получает признак Маркируемый
		КодыМаркировки = ЭАрМ_Служебный.ЗначениеУзла(СтрокаУПД, "Маркировки");
		Если ТипЗнч(КодыМаркировки) = Тип("Массив") Тогда
			Позиция.Маркировки = КодыМаркировки;
		КонецЕсли;
		Позиция.ЕдиницаИзмерения = СтрокаУПД.ЕдиницаИзмерения;
		Позиция.КоличествоМест   = СтрокаУПД.Количество;
		Позиция.Цена             = СтрокаУПД.Цена;
		Позиция.СтавкаНДС        = СтрокаУПД.СтавкаНДС;
		Позиция.СуммаНДС         = СтрокаУПД.СуммаНДС;
		Позиция.Стоимость        = ?(СтрокаУПД.СуммаСНДС > 0,
			СтрокаУПД.СуммаСНДС, СтрокаУПД.СуммаБезНДС);

		// Признак уменьшения/возврата строки для регистра товаров
		Позиция.Вставить("ПризнакИзменения", ПризнакИзмененияСтрокиТовара(СтрокаУПД));

		РезультатФункции.Добавить(Позиция);
		НомерСтроки = НомерСтроки + 1;

	КонецЦикла;

	Возврат РезультатФункции;

КонецФункции

// Признак уменьшения/возврата товарной строки для регистра ЭАрМ_ТоварыЭТрН:
//   "Убрана"/"Уменьшение"/"Увеличение"/"БезИзменений" - строки УКД
//   (см. ЭАрМ_Служебный.СтрокаТовараУКД);
//   "Возврат" - отрицательная строка УПД (возвратный документ);
//   "" - обычное поступление.
//
// Параметры:
//   СтрокаТовара - Структура - см. ЭАрМ_Служебный.СтрокаТовараУПД, СтрокаТовараУКД
//
// Возвращаемое значение:
//   Строка
//
Функция ПризнакИзмененияСтрокиТовара(СтрокаТовара)

	Признак = "";
	СтрокаТовара.Свойство("ПризнакИзменения", Признак);
	Признак = ЭАрМ_Служебный.СтрокойИлиПусто(Признак);

	Если НЕ ЗначениеЗаполнено(Признак) Тогда
		ОтрицательнаяСтрока = Ложь;
		Если СтрокаТовара.Свойство("ОтрицательнаяСтрока", ОтрицательнаяСтрока) Тогда
			Если ОтрицательнаяСтрока = Истина Тогда
				Признак = "Возврат";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Признак;

КонецФункции

// Подбирает товарный состав транспортной накладной.
//
// Правило одно - "свёрнут ли груз ЭТрН" (см. ГрузЭТрНСвернут):
//   1. Строк столько же, сколько мест - груз уже построчный, берём как есть,
//      УПД не трогаем.
//   2. Строк меньше, чем мест (одна строка "16 мест" или три строки на
//      сорок мест) - построчного состава в ЭТрН нет, он в УПД. Ищем УПД
//      строго по номеру ЭТрН и берём товары оттуда. Если строки ЭТрН при
//      этом были, они не выбрасываются: логистику из них - маркировки,
//      контейнеры, массы - переносим в строки УПД (см. ОбъединитьГрузУПДиЭТрН).
//   3. Не нашли УПД - остаёмся на исходных строках ЭТрН.
//
// Ищем по возрастанию цены обращения: сначала строки товаров в регистре,
// потом реестр УПД в регистре, и только потом СБИС.
//
// Параметры:
//   Идентификатор - Строка - документ ЭТрН в СБИС
//   Сессия        - Строка - session ID (sid)
//   Направление   - Строка - "Входящий" или "Исходящий"
//   КодТитула     - Строка - титул для груза, пусто - "Погрузка", иначе первый с грузом
//   АдресСервиса  - Строка
//   ДокументСБИС  - Соответствие, Неопределено - уже прочитанный документ,
//                   если он есть у вызывающего кода - тогда не читаем повторно
//
// Возвращаемое значение:
//   Структура - см. НовыйРезультатГруза, плюс:
//     * ИсточникТоваров - Строка - "ЭТрН" либо "УПД"
//     * ИдентификаторУПД - Строка - найденный документ, пусто - не искали/не нашли
//     * ПредставлениеУПД - Строка - имя документа для показа
//     * НомерИскали      - Строка - что подставляли в поиск (для статуса)
//
// Подбирает товарный состав по одним регистрам, не обращаясь к СБИС.
//
// Тот же разбор, что и в ПодобратьГрузПоНомеру, но без двух последних шагов:
// если строк УПД в регистре нет, состав остаётся нераскрытым. Так работает
// обмен - к моменту его запуска регистры уже наполнены отдельным заданием,
// и ходить на сервер ему незачем.
//
// Параметры:
//   Идентификатор - Строка - документ ЭТрН в СБИС
//   ДокументСБИС  - Соответствие - узел документа из реестра
//   КодТитула     - Строка - титул для груза, пусто - "Погрузка", иначе первый с грузом
//
// Возвращаемое значение:
//   Структура - см. ПодобратьГрузПоНомеру
//
Функция ПодобратьГрузПоРегистрам(Идентификатор, ДокументСБИС, КодТитула = "") Экспорт

	Результат = ПолучитьГрузЭТрН(ДокументСБИС, КодТитула);
	Результат.Идентификатор = Строка(Идентификатор);

	Результат.Вставить("ИсточникТоваров",  "ЭТрН");
	Результат.Вставить("ИдентификаторУПД", "");
	Результат.Вставить("ПредставлениеУПД", "");
	Результат.Вставить("НомерИскали",      "");
	Результат.Вставить("ТоварыРаскрыты",   Истина);
	Результат.Вставить("ВсегоМест",        МестВГрузе(Результат.Позиции));

	Если НЕ Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;

	Если НЕ ГрузЭТрНСвернут(Результат.Позиции) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ТоварыРаскрыты = Ложь;

	НомерЭТрН = ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Номер", ""));

	Если НЕ ЗначениеЗаполнено(НомерЭТрН) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.НомерИскали = НомерЭТрН;

	ИзРегистра = ЭАрМ_РегламентныйОбменЭДО.ТоварыУПДИзРегистраДляЭТрН(
		Идентификатор, НомерЭТрН);

	Если ИзРегистра.Позиции.Количество() > 0 Тогда
		Результат.Позиции = ОбъединитьГрузУПДиЭТрН(ИзРегистра.Позиции, Результат.Позиции);
		Результат.ТоварыРаскрыты = Истина;
		Результат.Вставить("ИсточникТоваров",  "УПД");
		Результат.Вставить("ИдентификаторУПД", ИзРегистра.ИдентификаторУПД);
		Результат.Вставить("ПредставлениеУПД", ИзРегистра.Представление);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПодобратьГрузПоНомеру(Идентификатор, Сессия = "", Направление = "Входящий",
		КодТитула = "", АдресСервиса = "", ДокументСБИС = Неопределено) Экспорт

	Если ДокументСБИС = Неопределено Тогда

		ДанныеДокумента = ПрочитатьДокумент(Идентификатор, Сессия, АдресСервиса);

		Если НЕ ДанныеДокумента.Успех Тогда
			Результат = ЭАрМ_Служебный.НовыйРезультатГруза();
			Результат.Успех = Ложь;
			Результат.Ошибка = ДанныеДокумента.Ошибка;
			Результат.Идентификатор = Строка(Идентификатор);
			Возврат Результат;
		КонецЕсли;

		ДокументСБИС = ДанныеДокумента.Документ;

	КонецЕсли;

	Результат = ПолучитьГрузЭТрН(ДокументСБИС, КодТитула);
	Результат.Идентификатор = Строка(Идентификатор);

	Результат.Вставить("ИсточникТоваров",  "ЭТрН");
	Результат.Вставить("ИдентификаторУПД", "");
	Результат.Вставить("ПредставлениеУПД", "");
	Результат.Вставить("НомерИскали",      "");
	// Раскрыт ли товарный состав. Ложь означает: в ЭТрН свёрнутые места,
	// а УПД к ним не нашлась - в накладную такие строки отдавать нельзя
	Результат.Вставить("ТоварыРаскрыты",   Истина);
	Результат.Вставить("ВсегоМест",        МестВГрузе(Результат.Позиции));

	Если НЕ Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;

	// Груз уже построчный - искать нечего
	Если НЕ ГрузЭТрНСвернут(Результат.Позиции) Тогда
		Возврат Результат;
	КонецЕсли;

	// Дальше состав считается нераскрытым, пока не нашлась УПД
	Результат.ТоварыРаскрыты = Ложь;

	НомерЭТрН = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Номер", ""));

	Если НЕ ЗначениеЗаполнено(НомерЭТрН) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.НомерИскали = НомерЭТрН;

	// Строки ЭТрН придерживаем: если товары найдутся в УПД, логистику из них
	// надо перенести, а не потерять
	ПозицииЭТрН = Результат.Позиции;

	// Шаг 1. Строки товаров УПД уже в регистре - ни одного обращения к серверу
	ИзРегистра = ЭАрМ_РегламентныйОбменЭДО.ТоварыУПДИзРегистраДляЭТрН(
		Идентификатор, НомерЭТрН);

	Если ИзРегистра.Позиции.Количество() > 0 Тогда
		Результат.Позиции = ОбъединитьГрузУПДиЭТрН(ИзРегистра.Позиции, ПозицииЭТрН);
		Результат.ТоварыРаскрыты = Истина;
		Результат.Вставить("ИсточникТоваров",  "УПД");
		Результат.Вставить("ИдентификаторУПД", ИзРегистра.ИдентификаторУПД);
		Результат.Вставить("ПредставлениеУПД", ИзРегистра.Представление);
		Возврат Результат;
	КонецЕсли;

	// Шаг 2. Сам документ УПД в реестре есть, а его строки не разобраны -
	// значит в СБИС идём только за товарами, реестр там не перебираем
	ИзРеестра = ЭАрМ_РегламентныйОбменЭДО.НайтиУПДДляЭТрН(
		Идентификатор, НомерЭТрН);

	Если ЗначениеЗаполнено(ИзРеестра.Идентификатор) Тогда

		ТоварыИзРеестра = ПолучитьТоварыУПД(ИзРеестра.Идентификатор, Сессия, АдресСервиса);

		Если ТоварыИзРеестра.Успех И ТоварыИзРеестра.Товары.Количество() > 0 Тогда
			Результат.Позиции = ОбъединитьГрузУПДиЭТрН(
				ПозицииИзТоваровУПД(ТоварыИзРеестра.Товары), ПозицииЭТрН);
			Результат.ТоварыРаскрыты = Истина;
			Результат.Вставить("ИсточникТоваров",  "УПД");
			Результат.Вставить("ИдентификаторУПД", ИзРеестра.Идентификатор);
			Результат.Вставить("ПредставлениеУПД", ИзРеестра.Представление);
			Возврат Результат;
		КонецЕсли;

	КонецЕсли;

	// Шаг 3. В реестре документа нет - вот теперь ищем в СБИС
	ТипРеестра = ?(Направление = "Исходящий", "Отправленные", "Входящие");

	НайденныйДокумент = НайтиУПДПоНомеру(НомерЭТрН, Сессия, ТипРеестра, АдресСервиса);

	Если НЕ ЗначениеЗаполнено(НайденныйДокумент.Идентификатор) Тогда
		// Не совпало - значит нет: остаёмся на данных ЭТрН
		Возврат Результат;
	КонецЕсли;

	ТоварыУПД = ПолучитьТоварыУПД(НайденныйДокумент.Идентификатор, Сессия, АдресСервиса);

	Если НЕ ТоварыУПД.Успех Или ТоварыУПД.Товары.Количество() = 0 Тогда
		// Документ нашёлся, но товары не прочитались - не блокируем экспорт,
		// остаёмся на строке ЭТрН
		Возврат Результат;
	КонецЕсли;

	Результат.Позиции = ОбъединитьГрузУПДиЭТрН(
		ПозицииИзТоваровУПД(ТоварыУПД.Товары), ПозицииЭТрН);
	Результат.ТоварыРаскрыты = Истина;
	Результат.Вставить("ИсточникТоваров",  "УПД");
	Результат.Вставить("ИдентификаторУПД", НайденныйДокумент.Идентификатор);
	Результат.Вставить("ПредставлениеУПД", НайденныйДокумент.Представление);

	Возврат Результат;

КонецФункции

// Сериализует узел документа СБИС в текст для хранения в регистре.
//
// Узел - это Соответствие, разобранное из ответа СБИС. Храним его целиком:
// в реестре нет ни сторон, ни адресов, ни груза, а обмену они нужны, и
// второй раз спрашивать сервер об уже полученном документе незачем.
//
// Возвращаемое значение:
//   Строка - JSON; пустая строка, если узла нет
//
Функция ТекстJSONУзла(Узел) Экспорт

	Если Узел = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Узел);
		Возврат ЗаписьJSON.Закрыть();
	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("ТекстJSONУзла",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат "";
	КонецПопытки;

КонецФункции

// Разбирает сохранённый узел документа обратно.
//
// Возвращаемое значение:
//   Соответствие, Неопределено - узел документа
//
Функция УзелИзJSON(ТекстУзла) Экспорт

	Если НЕ ЗначениеЗаполнено(ТекстУзла) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЭАрМ_Служебный.ПрочитатьОтветJSON(ТекстУзла);

КонецФункции

// Свёрнут ли груз ЭТрН, то есть нет ли в нём построчного состава.
//
// Судим по местам: в построчном грузе одна строка - одно место, и сумма
// КоличествоМест совпадает с числом строк. Если мест больше, чем строк
// (одна строка "16 мест" или три строки на сорок мест), состав свёрнут и
// искать его надо в УПД.
//
// Когда мест нет вовсе, судить не по чему - считаем груз построчным и
// остаёмся на данных ЭТрН, как было до появления этой проверки.
//
// Параметры:
//   Позиции - Массив из Структура - см. ЭАрМ_Служебный.ПозицияГруза
//
// Возвращаемое значение:
//   Булево
//
Функция ГрузЭТрНСвернут(Позиции) Экспорт

	Если Позиции.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Если Позиции.Количество() = 1 Тогда
		Возврат Истина;
	КонецЕсли;

	ВсегоМест = МестВГрузе(Позиции);

	Если ВсегоМест = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ВсегоМест <> Позиции.Количество();

КонецФункции

// Сколько мест заявлено в грузе.
//
// Возвращаемое значение:
//   Число
//
Функция МестВГрузе(Позиции) Экспорт

	ВсегоМест = 0;

	Для Каждого Позиция Из Позиции Цикл
		ВсегоМест = ВсегоМест + Позиция.КоличествоМест;
	КонецЦикла;

	Возврат ВсегоМест;

КонецФункции

// Переносит логистику строк ЭТрН в построчный состав из УПД.
//
// УПД знает номенклатуру, количество и цены, но ничего не знает про
// маркировки, контейнеры и массы - они есть только в грузе ЭТрН. Раньше при
// переходе на УПД строки ЭТрН просто отбрасывались вместе с этими данными.
//
// Сопоставляем по наименованию, и только однозначно: если под одним
// наименованием в ЭТрН несколько строк, перенос пропускаем - разложить
// маркировки по строкам УПД в таком случае нечем, а размножить их по всем
// строкам было бы хуже, чем не переносить.
//
// Параметры:
//   ПозицииУПД  - Массив из Структура - построчный состав, основа результата
//   ПозицииЭТрН - Массив из Структура - исходные строки груза ЭТрН
//
// Возвращаемое значение:
//   Массив из Структура - позиции УПД, дополненные данными ЭТрН
//
Функция ОбъединитьГрузУПДиЭТрН(ПозицииУПД, ПозицииЭТрН) Экспорт

	Если ПозицииУПД.Количество() = 0 Тогда
		Возврат ПозицииЭТрН;
	КонецЕсли;

	Если ПозицииЭТрН.Количество() = 0 Тогда
		Возврат ПозицииУПД;
	КонецЕсли;

	СтрокиЭТрН = ПозицииЭТрНПоНаименованию(ПозицииЭТрН);

	// Что переносим: всё, чего в УПД нет по определению
	ПоляЛогистики = "СпособУпаковки,ТараКод,Примечание,Состояние,КоличествоПаллет,"
		+ "МассаБрутто,МассаНетто,Длина,Ширина,Высота,Объем,Плотность,"
		+ "Контейнеры,ТипГруза,Маркировки,ОпасныеГрузы,СведенияГИС";

	Для Каждого ПозицияУПД Из ПозицииУПД Цикл

		ПозицияЭТрН = СтрокиЭТрН.Получить(КлючНаименования(ПозицияУПД.Наименование));

		Если ПозицияЭТрН = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ИмяПоля Из СтрРазделить(ПоляЛогистики, ",", Ложь) Цикл

			ЗначениеЭТрН = Неопределено;
			Если НЕ ПозицияЭТрН.Свойство(ИмяПоля, ЗначениеЭТрН)
				ИЛИ НЕ ЗначениеЗаполнено(ЗначениеЭТрН) Тогда
				Продолжить;
			КонецЕсли;

			// Дополняем, а не затираем: то, что УПД знает сама, остаётся её
			ЗначениеУПД = Неопределено;
			Если ПозицияУПД.Свойство(ИмяПоля, ЗначениеУПД)
				И ЗначениеЗаполнено(ЗначениеУПД) Тогда
				Продолжить;
			КонецЕсли;

			ПозицияУПД.Вставить(ИмяПоля, ЗначениеЭТрН);

		КонецЦикла;

		// Код номенклатуры в УПД бывает пустым, а в ЭТрН заполнен
		Если НЕ ЗначениеЗаполнено(ПозицияУПД.Номенклатура)
			И ЗначениеЗаполнено(ПозицияЭТрН.Номенклатура) Тогда
			ПозицияУПД.Номенклатура = ПозицияЭТрН.Номенклатура;
		КонецЕсли;

	КонецЦикла;

	// Свёрнутая строка ЭТрН и повторяющиеся наименования по имени не
	// сопоставляются - их коды маркировки раскладываем по GTIN внутри кода
	РазложитьМаркировкиЭТрНПоGTIN(ПозицииУПД, ПозицииЭТрН);

	Возврат ПозицииУПД;

КонецФункции

// Коды маркировки ЭТрН, которые не достались ни одной позиции УПД по
// наименованию, раскладываются по GTIN позиций УПД. Позиции, у которых коды
// уже есть, не трогаем.
//
Процедура РазложитьМаркировкиЭТрНПоGTIN(ПозицииУПД, ПозицииЭТрН)

	Занятые = Новый Соответствие;
	Получатели = Новый Массив;
	ОписанияПолучателей = Новый Массив;

	Для Каждого ПозицияУПД Из ПозицииУПД Цикл

		Маркировки = ЭАрМ_Служебный.ЗначениеУзла(ПозицияУПД, "Маркировки");
		ЕстьКоды = ТипЗнч(Маркировки) = Тип("Массив") И Маркировки.Количество() > 0;
		Если ЕстьКоды Тогда
			Для Каждого Код Из Маркировки Цикл
				Занятые.Вставить(СокрЛП(Код), Истина);
			КонецЦикла;
			Продолжить;
		КонецЕсли;

		Штрихкод = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ПозицияУПД, "Штрихкод", ""));
		Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
			Продолжить;
		КонецЕсли;

		Штрихкоды = Новый Массив;
		Штрихкоды.Добавить(Штрихкод);
		Получатели.Добавить(ПозицияУПД);
		ОписанияПолучателей.Добавить(Новый Структура("Штрихкоды, Количество", Штрихкоды,
			ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(ПозицияУПД, "КоличествоМест", 0))));

	КонецЦикла;

	Если Получатели.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Свободные = Новый Массив;
	Для Каждого ПозицияЭТрН Из ПозицииЭТрН Цикл
		Маркировки = ЭАрМ_Служебный.ЗначениеУзла(ПозицияЭТрН, "Маркировки");
		Если ТипЗнч(Маркировки) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Код Из Маркировки Цикл
			Если Занятые.Получить(СокрЛП(Код)) = Неопределено Тогда
				Свободные.Добавить(СокрЛП(Код));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Разложенные = ЭАрМ_КодыМаркировки.РазложитьКодыПоGTIN(ОписанияПолучателей, Свободные);

	// Новый массив, а не дополнение прежнего: после переноса по наименованию
	// позиции УПД и ЭТрН могли делить один массив
	Для Индекс = 0 По Получатели.ВГраница() Цикл
		Если Разложенные[Индекс].Количество() > 0 Тогда
			Получатели[Индекс].Вставить("Маркировки", Разложенные[Индекс]);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Строки груза ЭТрН по наименованию; неоднозначные наименования выброшены.
//
// Возвращаемое значение:
//   Соответствие - Наименование (Строка) → Структура позиции
//
Функция ПозицииЭТрНПоНаименованию(ПозицииЭТрН)

	Найденные = Новый Соответствие;
	Неоднозначные = Новый Соответствие;

	Для Каждого Позиция Из ПозицииЭТрН Цикл

		Ключ = КлючНаименования(Позиция.Наименование);
		Если НЕ ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;

		Если Найденные.Получить(Ключ) <> Неопределено Тогда
			Неоднозначные.Вставить(Ключ, Истина);
			Продолжить;
		КонецЕсли;

		Найденные.Вставить(Ключ, Позиция);

	КонецЦикла;

	Для Каждого КлючИЗначение Из Неоднозначные Цикл
		Найденные.Удалить(КлючИЗначение.Ключ);
	КонецЦикла;

	Возврат Найденные;

КонецФункции

// Наименование в виде ключа сопоставления: регистр и лишние пробелы
// поставщики пишут как придётся.
//
Функция КлючНаименования(Наименование)

	Ключ = ВРег(СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(Наименование)));

	Пока СтрНайти(Ключ, "  ") > 0 Цикл
		Ключ = СтрЗаменить(Ключ, "  ", " ");
	КонецЦикла;

	Возврат Ключ;

КонецФункции

// Спрашивает у СБИС документы, связанные с указанным.
//
// Имя метода в документации, которая ходит по рукам, пишут как
// "СвязанныхДокументовСНаименованиями", но в штатной обработке СБИС такого
// вызова нет, а пространство имён у методов разное. Проверять вслепую нечем:
// у сервиса нет "списка методов". Поэтому перебираем известные написания и
// смотрим на ответ - "метод не найден" отличается от любой другой ошибки,
// и первое же принятое имя запоминается в результате.
//
// Параметры:
//   Идентификатор    - Строка - документ в СБИС
//   Сессия           - Строка - session ID (sid)
//   НаправлениеСвязи - Строка - "Основание" ищет документы, на основании
//                      которых создан наш (заявку, заказ на перевозку)
//   ВидСвязи         - Строка - необязательное уточнение вида связи
//   АдресСервиса     - Строка
//
// Возвращаемое значение:
//   Структура:
//     * Успех   - Булево - метод найден и ответил
//     * Ошибка  - Строка - что ответил сервис, если не вышло
//     * Данные  - Произвольный - узел result как есть
//     * Метод   - Строка - имя, которое сервис принял
//     * ПопыткиВызова - Массив структур: Метод, Ошибка - для диагностики
//
Функция ЗапроситьСвязанныеДокументы(Идентификатор, Сессия = "",
		НаправлениеСвязи = "Основание", ВидСвязи = "", АдресСервиса = "") Экспорт

	Результат = Новый Структура("Успех, Ошибка, Данные, Метод, ПопыткиВызова",
		Ложь, "", Неопределено, "", Новый Массив);

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Результат.Ошибка = "не заполнен идентификатор документа";
		Возврат Результат;
	КонецЕсли;

	Настройки = ЭАрМ_НастройкиСервер.НастройкиСБИС();

	ИдСессии = Сессия;
	Если НЕ ЗначениеЗаполнено(ИдСессии) Тогда
		ИдСессии = ПолучитьСессию();
	КонецЕсли;

	Адрес = АдресСервиса;
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Адрес = Настройки.АдресСервера;
	КонецЕсли;

	ПараметрыМетода = ЭАрМ_Служебный.ПараметрыЗапросаСвязей(Идентификатор, НаправлениеСвязи, ВидСвязи);

	Для Каждого ИмяМетода Из ЭАрМ_Служебный.ИменаМетодовСвязей() Цикл

		ОтветМетода = ЭАрМ_Служебный.ВыполнитьМетодСБИС(ИмяМетода, ПараметрыМетода, ИдСессии, Адрес);

		Если ОтветМетода.Успех Тогда

			Результат.Успех  = Истина;
			Результат.Метод  = ИмяМетода;
			Результат.Данные = ОтветМетода.Данные;

			Возврат Результат;

		КонецЕсли;

		Результат.ПопыткиВызова.Добавить(Новый Структура("Метод, Ошибка",
			ИмяМетода, ОтветМетода.Ошибка));

		// Метода с таким именем нет - пробуем следующее написание.
		// Любая другая ошибка означает, что метод есть, но зовём мы его
		// неправильно: перебирать дальше бессмысленно, надо чинить параметры.
		Если НЕ ЭАрМ_Служебный.ЭтоОшибкаНеизвестногоМетода(ОтветМетода.Ошибка) Тогда
			Результат.Ошибка = СтрШаблон("%1: %2", ИмяМетода, ОтветМетода.Ошибка);
			Возврат Результат;
		КонецЕсли;

	КонецЦикла;

	Результат.Ошибка = "ни одно из известных имён метода сервис не принял";

	Возврат Результат;

КонецФункции

// Показывает, чем ответил сервис на каждое написание метода связей.
//
// Нужна ровно для одного: выяснить на живом аккаунте, есть ли у СБИС метод
// связанных документов и как он называется. Результат можно скопировать
// из сообщения и прислать - по нему видно, что править.
//
// Параметры:
//   Идентификатор - Строка - любой документ, у которого связи заведомо есть
//   Сессия        - Строка - session ID (sid)
//   АдресСервиса  - Строка
//
// Возвращаемое значение:
//   Строка - отчёт по всем попыткам
//
Функция ПроверитьМетодыСвязей(Идентификатор, Сессия = "", АдресСервиса = "") Экспорт

	ОтветСвязей = ЗапроситьСвязанныеДокументы(Идентификатор, Сессия, "Основание", "",
		АдресСервиса);

	ЧастиОтчёта = Новый Массив;

	Если ОтветСвязей.Успех Тогда
		ЧастиОтчёта.Добавить("ПРИНЯТ: " + ОтветСвязей.Метод);
		ЧастиОтчёта.Добавить("узлы ответа: [" + ЭАрМ_Служебный.КлючиУзла(ОтветСвязей.Данные) + "]");
	Иначе
		ЧастиОтчёта.Добавить("не принят ни один метод: " + ОтветСвязей.Ошибка);
	КонецЕсли;

	Для Каждого ОписаниеПопытки Из ОтветСвязей.ПопыткиВызова Цикл
		ЧастиОтчёта.Добавить(СтрШаблон("%1 -> %2", ОписаниеПопытки.Метод, ОписаниеПопытки.Ошибка));
	КонецЦикла;

	Возврат СтрСоединить(ЧастиОтчёта, Символы.ПС);

КонецФункции

// ============================================================================
// ВЫГРУЗКА В ДАЛИОН: JSON + FTP
// ============================================================================

// Собирает реквизиты приходной накладной по документу ЭТрН.
//
// ВАЖНО про полноту: ЭТрН - транспортный документ. В нём есть стороны,
// маршрут, груз и его масса, но НЕТ цены, ставки НДС, единицы измерения
// и штрихкодов по строкам - они живут в товарной накладной ЭДО, это
// отдельный документ. Соответствующие поля остаются пустыми осознанно.
//
// Параметры:
//   ДокументСБИС - Соответствие - прочитанный документ (см. ПрочитатьДокумент)
//   Направление  - Строка - "Входящий" или "Исходящий"
//   КодТитула    - Строка - титул для груза, пусто - "Погрузка", иначе первый с грузом
//
// Возвращаемое значение:
//   Структура:
//     * Успех  - Булево
//     * Ошибка - Строка
//     * Данные - Структура - тело будущего JSON
//
Функция ДанныеПриходнойНакладной(ДокументСБИС, Направление = "Входящий",
		РезультатГруза = Неопределено, КодТитула = "") Экспорт

	Результат = Новый Структура("Успех, Ошибка, Данные", Истина, "", Неопределено);

	// Груз обычно уже разобран вызывающим кодом - тогда берём его как есть,
	// чтобы в файл попало ровно то, что было показано на форме.
	Если РезультатГруза = Неопределено Тогда
		РезультатГруза = ПолучитьГрузЭТрН(ДокументСБИС, КодТитула);
	КонецЕсли;

	Если НЕ РезультатГруза.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = РезультатГруза.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Стороны = ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Стороны");

	// Товарный состав нераскрыт - это когда в ЭТрН одна свёрнутая строка
	// ("24 места"), а УПД к ней не нашлась. Отдавать такую строку товаром
	// нельзя: Далион принял бы 24 места как одну позицию номенклатуры.
	// Тогда уходит только шапка, а признак говорит приёмной стороне, почему
	// табличная часть пуста.
	ТоварыРаскрыты = Неопределено;
	Если ТипЗнч(РезультатГруза) = Тип("Структура") Тогда
		РезультатГруза.Свойство("ТоварыРаскрыты", ТоварыРаскрыты);
	КонецЕсли;

	Если ТоварыРаскрыты = Неопределено Тогда
		// Груз собран не через ПодобратьГрузПоНомеру - решаем сами
		ТоварыРаскрыты = НЕ ГрузЭТрНСвернут(РезультатГруза.Позиции);
	КонецЕсли;

	ВсегоМест = МестВГрузе(РезультатГруза.Позиции);

	// Имя переменной не "Товары": так теперь называется табличная часть
	ТоварыНакладной = ?(ТоварыРаскрыты,
		ЭАрМ_Служебный.ТоварыДляДалион(РезультатГруза.Позиции), Новый Массив);

	// Шапка: имена строго по реквизитам Документ.ПриходнаяНакладная Далиона
	Накладная = Новый Структура;
	Накладная.Вставить("Дата",  ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Дата", "")));
	Накладная.Вставить("Фирма",
		РеквизитыСтороны(ЭАрМ_Служебный.СторонаПоНаправлению(ДокументСБИС, Стороны, Направление, Истина)));
	Накладная.Вставить("Контрагент",
		РеквизитыСтороны(ЭАрМ_Служебный.СторонаПоНаправлению(ДокументСБИС, Стороны, Направление, Ложь)));
	Накладная.Вставить("ДоговорКонтрагента", "");
	Накладная.Вставить("Склад",              "");
	// Валюту и сумму считаем по исходному грузу: даже когда табличная часть
	// не уходит, итог документа в шапке должен остаться
	ТоварыДляИтогов = ЭАрМ_Служебный.ТоварыДляДалион(РезультатГруза.Позиции);
	Накладная.Вставить("ВалютаДокумента",    ЭАрМ_Служебный.ВалютаПоТоварам(ТоварыДляИтогов));
	Накладная.Вставить("СуммаДокумента",     ЭАрМ_Служебный.СуммаПоТоварам(ТоварыДляИтогов));
	Накладная.Вставить("СуммаВключаетНДС",   Истина);
	Накладная.Вставить("УчитыватьНДС",       Истина);
	Накладная.Вставить("ВидОперации",        "");

	// Признаки товарного состава - по ним приёмная сторона решает, заводить
	// табличную часть или только шапку
	Накладная.Вставить("ТоварыРаскрыты",  ТоварыРаскрыты);
	Накладная.Вставить("ТоварыОтсутствуют", НЕ ТоварыРаскрыты);
	Накладная.Вставить("КоличествоМест",  ВсегоМест);

	// Номер и дата ЭТрН - это и есть входящий документ электронного обмена
	НомерЭТрН = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Номер", ""));
	Накладная.Вставить("ВходящийНомер", НомерЭТрН);
	Накладная.Вставить("НомерВходящегоДокументаЭлектронногоОбмена", НомерЭТрН);
	Накладная.Вставить("ДатаВходящегоДокументаЭлектронногоОбмена",
		ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Дата", "")));

	Комментарий = ЭАрМ_Служебный.КомментарийПоДоставке(РезультатГруза);

	Если НЕ ТоварыРаскрыты Тогда
		ПояснениеСостава = СтрШаблон(
			НСтр("ru = 'Товарный состав не раскрыт: в ЭТрН заявлено мест - %1, УПД не найдена'"),
			ВсегоМест);
		Комментарий = ?(ЗначениеЗаполнено(Комментарий),
			Комментарий + Символы.ПС + ПояснениеСостава, ПояснениеСостава);
	КонецЕсли;

	Накладная.Вставить("Комментарий", Комментарий);

	Накладная.Вставить("Товары",            ТоварыНакладной);
	Накладная.Вставить("Услуги",            Новый Массив);
	Накладная.Вставить("Тара",              Новый Массив);
	Накладная.Вставить("ШтрихкодыУпаковок", ?(ТоварыРаскрыты,
		ЭАрМ_Служебный.ШтрихкодыУпаковокДляДалион(РезультатГруза.Позиции), Новый Массив));

	Доставка = Новый Структура;
	Доставка.Вставить("АдресПогрузки", РезультатГруза.АдресПогрузки);
	Доставка.Вставить("АдресДоставки", РезультатГруза.АдресДоставки);
	Доставка.Вставить("ДоставитьДо",   РезультатГруза.ДоставитьДо);
	Доставка.Вставить("Пункты",        РезультатГруза.Пункты);

	ДанныеНакладной = Новый Структура;
	ДанныеНакладной.Вставить("Версия",             "2.0");
	ДанныеНакладной.Вставить("Источник",           ЭАрМ_Служебный.ИсточникДляДалион(ДокументСБИС, РезультатГруза));
	ДанныеНакладной.Вставить("ПриходнаяНакладная", Накладная);

	// Перевозчик, заказчик и маршрут в реквизитах Далиона отсутствуют,
	// поэтому идут отдельным узлом - как справочная информация.
	ДополнительныеДанные = Новый Структура;
	ДополнительныеДанные.Вставить("Перевозчик",
		РеквизитыСтороны(ЭАрМ_Служебный.СторонаПоКлючам(Стороны, "Перевозчик,Грузоперевозчик")));
	ДополнительныеДанные.Вставить("Заказчик",
		РеквизитыСтороны(ЭАрМ_Служебный.СторонаПоКлючам(Стороны, "Заказчик,ВладелецОбъекта")));
	ДополнительныеДанные.Вставить("Доставка", Доставка);
	// Ссылки на УПД и прочие сопроводительные документы отдаём как есть:
	// сопоставлять их - дело приёмной стороны
	ДополнительныеДанные.Вставить("СопроводительныеДокументы",
		СвязанныеДокументыЭТрН(ДокументСБИС));
	ДанныеНакладной.Вставить("ДополнительныеДанные", ДополнительныеДанные);

	Результат.Данные = ДанныеНакладной;

	Возврат Результат;

КонецФункции

// Сериализует данные приходной накладной в JSON.
//
// Параметры:
//   ДанныеНакладной - Структура - см. ДанныеПриходнойНакладной, поле Данные
//
// Возвращаемое значение:
//   Строка - текст JSON с отступами
//
Функция СформироватьJSONДляДалион(ДанныеНакладной) Экспорт

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, ДанныеНакладной);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Сквозной сценарий: прочитать ЭТрН, собрать JSON и положить его на FTP.
//
// Параметры:
//   Идентификатор - Строка - идентификатор документа в СБИС
//   Сессия        - Строка - session ID (sid)
//   Направление   - Строка - "Входящий" или "Исходящий"
//   КодТитула     - Строка - титул для груза, пусто - "Погрузка", иначе первый с грузом
//
// Возвращаемое значение:
//   Структура:
//     * Успех         - Булево
//     * Ошибка        - Строка
//     * ИмяФайла      - Строка - имя выгруженного файла
//     * ПутьНаFTP     - Строка - полный путь на сервере
//     * ТекстJSON     - Строка - то, что было отправлено
//     * ТоваровВыгружено - Число
//
Функция ВыгрузитьНакладнуюНаFTP(Идентификатор, Сессия = "",
		Направление = "Входящий", КодТитула = "") Экспорт

	Результат = ПодготовитьНакладнуюДляДалион(
		Идентификатор, Сессия, Направление, КодТитула);

	Результат.Вставить("ПутьНаFTP", "");

	Если НЕ Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;

	Если ЭАрМ_НастройкиСервер.НастройкиОбмена().ТолькоПриемИзДалиона Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = НСтр(
			"ru = 'Отправка документов в Далион выключена: в настройках ЭДО включён только приём из result'");
		Возврат Результат;
	КонецЕсли;

	РезультатОтправки = ОтправитьТекстНаFTP(Результат.ТекстJSON, Результат.ИмяФайла);

	Результат.Успех     = РезультатОтправки.Успех;
	Результат.Ошибка    = РезультатОтправки.Ошибка;
	Результат.ПутьНаFTP = РезультатОтправки.ПутьНаFTP;

	Возврат Результат;

КонецФункции

// Читает документ и готовит JSON приходной накладной, никуда его не отправляя.
// Вынесено отдельно, потому что получателей у одного и того же JSON двое:
// FTP и локальная папка.
//
// Параметры:
//   Идентификатор - Строка - идентификатор документа в СБИС
//   Сессия        - Строка - session ID (sid)
//   Направление   - Строка - "Входящий" или "Исходящий"
//   КодТитула     - Строка - титул для груза, пусто - "Погрузка", иначе первый с грузом
//
// Возвращаемое значение:
//   Структура:
//     * Успех            - Булево
//     * Ошибка           - Строка
//     * ИмяФайла         - Строка - рекомендуемое имя файла
//     * ТекстJSON        - Строка
//     * ТоваровВыгружено - Число
//
Функция ПодготовитьНакладнуюДляДалион(Идентификатор, Сессия = "",
		Направление = "Входящий", КодТитула = "") Экспорт

	Результат = Новый Структура(
		"Успех, Ошибка, ИмяФайла, ТекстJSON, ТоваровВыгружено",
		Истина, "", "", "", 0);

	ДанныеДокумента = ПрочитатьДокумент(Идентификатор, Сессия);
	Если НЕ ДанныеДокумента.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = ДанныеДокумента.Ошибка;
		Возврат Результат;
	КонецЕсли;

	// Товары построчные - берём из ЭТрН как есть. Если груз свёрнут в одну
	// строку, ищем документ ЭДО строго по номеру ЭТрН и берём товары из
	// него; не нашли - остаёмся на данных ЭТрН. См. ПодобратьГрузПоНомеру.
	РезультатГруза = ПодобратьГрузПоНомеру(Идентификатор, Сессия, Направление,
		КодТитула, , ДанныеДокумента.Документ);

	ДанныеНакладной = ДанныеПриходнойНакладной(
		ДанныеДокумента.Документ, Направление, РезультатГруза, КодТитула);

	Если НЕ ДанныеНакладной.Успех Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = ДанныеНакладной.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Результат.ТекстJSON        = СформироватьJSONДляДалион(ДанныеНакладной.Данные);
	Результат.ТоваровВыгружено = ДанныеНакладной.Данные.ПриходнаяНакладная.Товары.Количество();
	Результат.ИмяФайла         = ЭАрМ_Служебный.ИмяФайлаВыгрузки(ДанныеНакладной.Данные);

	Возврат Результат;

КонецФункции

// Кладёт текст на FTP отдельным файлом.
// Пишем через временный файл: FTPСоединение умеет отправлять только файлы.
//
// Параметры:
//   ТекстФайла - Строка - содержимое
//   ИмяФайла   - Строка - имя файла на сервере
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, ПутьНаFTP
//
Функция ОтправитьТекстНаFTP(ТекстФайла, ИмяФайла) Экспорт

	Результат = Новый Структура("Успех, Ошибка, ПутьНаFTP", Истина, "", "");

	НастройкиПодключения = ЭАрМ_НастройкиСервер.НастройкиFTP();

	Если НЕ ЗначениеЗаполнено(НастройкиПодключения.Сервер) Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = "Не заполнен адрес FTP-сервера. Настройки ЭДО - раздел FTP";
		Возврат Результат;
	КонецЕсли;

	ВременныйФайл = ПолучитьИмяВременногоФайла("json");

	Попытка

		ЭАрМ_Служебный.ЗаписатьТекстВФайл(ТекстФайла, ВременныйФайл);

		Соединение = ЭАрМ_Служебный.СоздатьСоединениеFTP(НастройкиПодключения);

		// Кладём не в корень, а в подкаталог выгрузки: База2 читает
		// именно его. Каталога может не быть - создаём недостающий
		КаталогНазначения = ЭАрМ_НастройкиСервер.КаталогиОбменаFTP().Выгрузка;

		ЭАрМ_Служебный.ОбеспечитьКаталогFTP(Соединение, КаталогНазначения);

		// Не делаем CWD перед записью полным путём: на этом FTP путь
		// считается от текущего каталога, и файл оказывается в
		// incoming/incoming, куда Далион не смотрит.
		ПутьНаСервере = ЭАрМ_Служебный.ОбъединитьПутьFTP(КаталогНазначения, ИмяФайла);
		ВременныйПутьНаСервере = ПутьНаСервере + ".tmp";
		Соединение.Записать(ВременныйФайл, ВременныйПутьНаСервере);
		Соединение.Переместить(ВременныйПутьНаСервере, ПутьНаСервере);

		Результат.ПутьНаFTP = ПутьНаСервере;

	Исключение
		Результат.Успех = Ложь;
		Результат.Ошибка = СтрШаблон("Ошибка выгрузки на FTP: %1",
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		ЭАрМ_Служебный.ЗаписатьОшибку("ОтправитьТекстНаFTP", Результат.Ошибка);
	КонецПопытки;

	ЭАрМ_Служебный.УдалитьВременныйФайл(ВременныйФайл);

	Возврат Результат;

КонецФункции

// Проверяет подключение к FTP: соединяется и читает список файлов каталога.
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, Каталог, ФайловВКаталоге
//
Функция ПроверитьПодключениеFTP() Экспорт

	Результат = Новый Структура("Успех, Ошибка, Каталог, ФайловВКаталоге",
		Истина, "", "", 0);

	НастройкиПодключения = ЭАрМ_НастройкиСервер.НастройкиFTP();

	Если НЕ ЗначениеЗаполнено(НастройкиПодключения.Сервер) Тогда
		Результат.Успех = Ложь;
		Результат.Ошибка = "Не заполнен адрес FTP-сервера. Настройки ЭДО - раздел FTP";
		Возврат Результат;
	КонецЕсли;

	Попытка

		Соединение = ЭАрМ_Служебный.СоздатьСоединениеFTP(НастройкиПодключения);

		Если ЗначениеЗаполнено(НастройкиПодключения.Каталог) Тогда
			Соединение.УстановитьТекущийКаталог(НастройкиПодключения.Каталог);
		КонецЕсли;

		Результат.Каталог = Соединение.ТекущийКаталог();
		Результат.ФайловВКаталоге = Соединение.НайтиФайлы(Результат.Каталог, "*").Количество();

	Исключение
		// Адрес называем прямо в ошибке: в настройках он записан как есть, а к
		// серверу уходит разобранным, и по сообщению должно быть видно, куда
		// именно не достучались
		Адрес = ЭАрМ_Служебный.АдресСервераFTP(
			НастройкиПодключения.Сервер, НастройкиПодключения.Порт);

		Результат.Успех = Ложь;
		Результат.Ошибка = СтрШаблон("Ошибка подключения к FTP (%1:%2): %3",
			Адрес.Сервер, Формат(Адрес.Порт, "ЧГ=0"),
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		ЭАрМ_Служебный.ЗаписатьОшибку("ПроверитьПодключениеFTP", Результат.Ошибка);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// ============================================================================
// СЕССИЯ
// ============================================================================

// Возвращает действующую сессию СБИС, при необходимости авторизуясь заново.
//
// За один проход регламентного задания к сервису идут десятки обращений.
// Авторизация на каждое из них - лишние запросы и лишний повод получить отказ,
// поэтому sid хранится в настройках вместе с временем получения и
// переиспользуется, пока не устарел (см. ЭАрМ_НастройкиСервер.ПолучитьСессиюСБИС).
//
// Параметры:
//   ОбновитьПринудительно - Булево - не смотреть на сохранённую сессию,
//                           войти заново. Нужно, когда сервис ответил,
//                           что сессия недействительна.
//
// Возвращаемое значение:
//   Строка - sid. Пустая строка, если авторизоваться не удалось
//
Функция ПолучитьСессию(ОбновитьПринудительно = Ложь) Экспорт

	Если НЕ ОбновитьПринудительно Тогда
		СохраненнаяСессия = ЭАрМ_НастройкиСервер.ПолучитьСессиюСБИС();
		Если ЗначениеЗаполнено(СохраненнаяСессия) Тогда
			Возврат СохраненнаяСессия;
		КонецЕсли;
	КонецЕсли;

	РезультатВхода = Авторизоваться();

	Если НЕ РезультатВхода.Успех Тогда
		ЭАрМ_НастройкиСервер.СохранитьСессиюСБИС("");
		ЭАрМ_Служебный.ЗаписатьОшибку("ПолучитьСессию", РезультатВхода.Ошибка);
		Возврат "";
	КонецЕсли;

	ЭАрМ_НастройкиСервер.СохранитьСессиюСБИС(РезультатВхода.Сессия);

	Возврат РезультатВхода.Сессия;

КонецФункции

// Распознаёт отказ из-за просроченной сессии.
//
// СБИС не выделяет такой отказ отдельным кодом: приходит обычная ошибка
// бизнес-логики с текстом про авторизацию. Отличить её важно - на неё
// отвечают повторным входом, а не остановкой обмена.
//
// Параметры:
//   ТекстОшибки - Строка - текст, который вернул сервис
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоОшибкаСессии(ТекстОшибки) Экспорт

	Если НЕ ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекстДляПоиска = НРег(ТекстОшибки);

	Признаки = СтрРазделить(
		"сесси,session,не авторизован,авторизаци,unauthorized,http 401,http 403,доступ запрещ",
		",", Ложь);

	Для Каждого Признак Из Признаки Цикл
		Если СтрНайти(ТекстДляПоиска, Признак) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции


#КонецОбласти
