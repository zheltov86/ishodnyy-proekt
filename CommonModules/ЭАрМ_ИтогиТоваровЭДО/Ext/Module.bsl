////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_ИтогиТоваровЭДО: итоги товаров ЭТрН и УПД по группам.
//
// Дерево для формы реестра ЭТрН, общий итог сверху:
//   ВСЕГО
//     Обработанные                           - итог группы
//       УПД / ЭТрН № от, контрагент          - итог документа
//         строки товаров
//     Необработанные
//     Электроэнергия                         - отдельно, в две первые группы не входит
//
// Строки берутся из регистра ЭАрМ_ТоварыЭТрН: у УПД - её товары, у ЭТрН - груз,
// но только если связанной УПД в реестре нет (иначе один товар посчитался бы
// дважды). Строки Далиона (База2) и корректировок (УКД) в итоги не входят.
//
// Обработан документ, если он утверждён в СБИС, проведён в Далионе или к нему
// нашлась приходная накладная Далиона.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Дерево итогов за период по дате документа.
//
// Параметры:
//   ДатаНачала, ДатаОкончания - Дата - пустая дата окончания - по текущий день
//
// Возвращаемое значение:
//   ДеревоЗначений - колонки Представление, Статус, Документов, Строк, Количество,
//                    Сумма, СуммаНДС, Идентификатор
//
Функция ДеревоИтогов(Знач ДатаНачала, Знач ДатаОкончания) Экспорт

	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = ТекущаяДатаСеанса();
	КонецЕсли;

	Дерево = Новый ДеревоЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить("Представление,Статус,Документов,Строк,Количество,Сумма,СуммаНДС,Идентификатор", ",") Цикл
		Дерево.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;

	Всего = Дерево.Строки.Добавить();
	Всего.Представление = "ВСЕГО";
	Всего.Статус = СтрШаблон("%1 - %2", Формат(ДатаНачала, "ДЛФ=D"), Формат(ДатаОкончания, "ДЛФ=D"));

	Группы = Новый Соответствие;
	Для Каждого ИмяГруппы Из СтрРазделить(ИменаГрупп(), ",") Цикл
		УзелГруппы = Всего.Строки.Добавить();
		УзелГруппы.Представление = ИмяГруппы;
		Группы.Вставить(ИмяГруппы, УзелГруппы);
	КонецЦикла;

	УзлыДокументов = Новый Соответствие;

	Выборка = ЗапросСтрок(ДатаНачала, ДатаОкончания).Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Обработан = Выборка.Утверждено ИЛИ Выборка.ПроведенВДалион ИЛИ Выборка.ПриходНайден;

		Если ЭтоЭлектроэнергия(Выборка.Наименование, Выборка.ЕдиницаИзмерения) Тогда
			ИмяГруппы = "Электроэнергия";
		Иначе
			ИмяГруппы = ?(Обработан, "Обработанные", "Необработанные");
		КонецЕсли;

		Идентификатор = СокрЛП(Выборка.Идентификатор);
		КлючДокумента = ИмяГруппы + "|" + Выборка.ВидДокумента + "|" + Идентификатор;

		УзелДокумента = УзлыДокументов.Получить(КлючДокумента);
		Если УзелДокумента = Неопределено Тогда
			УзелДокумента = Группы.Получить(ИмяГруппы).Строки.Добавить();
			УзелДокумента.Представление = СтрШаблон("%1 № %2 от %3, %4", Выборка.ВидДокумента,
				СокрЛП(Выборка.Номер), Формат(Выборка.Дата, "ДЛФ=D"), СокрЛП(Выборка.Контрагент));
			УзелДокумента.Статус        = СтатусДокумента(Выборка);
			УзелДокумента.Идентификатор = Идентификатор;
			УзлыДокументов.Вставить(КлючДокумента, УзелДокумента);
		КонецЕсли;

		СтрокаТовара = УзелДокумента.Строки.Добавить();
		СтрокаТовара.Представление = СокрЛП(Выборка.Наименование);
		СтрокаТовара.Статус        = СокрЛП(Выборка.ЕдиницаИзмерения);
		СтрокаТовара.Строк         = 1;
		СтрокаТовара.Количество    = Выборка.Количество;
		СтрокаТовара.Сумма         = Выборка.Сумма;
		СтрокаТовара.СуммаНДС      = Выборка.СуммаНДС;

	КонецЦикла;

	ПодвестиИтоги(Всего);

	Возврат Дерево;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИменаГрупп()

	Возврат "Обработанные,Необработанные,Электроэнергия";

КонецФункции

Функция ЗапросСтрок(ДатаНачала, ДатаОкончания)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	""УПД"" КАК ВидДокумента,
	|	УПД.ИдентификаторСБИС КАК Идентификатор,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.Контрагент КАК Контрагент,
	|	УПД.Утверждено КАК Утверждено,
	|	УПД.ПроведенВДалион КАК ПроведенВДалион,
	|	ВЫБОР
	|		КОГДА УПД.НомерДокументаДалион <> """"
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПриходНайден,
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.Наименование КАК Наименование,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Товары.Количество КАК Количество,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ПО (Товары.ИдентификаторСБИС = УПД.ИдентификаторСБИС)
	|			И (Товары.ИсточникТоваров = ""УПД"")
	|ГДЕ
	|	УПД.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И УПД.Формат <> ""УКД""
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""ЭТрН"",
	|	ЭТрН.ИдентификаторСБИС,
	|	ЭТрН.Номер,
	|	ЭТрН.Дата,
	|	ЭТрН.Контрагент,
	|	ЭТрН.Утверждено,
	|	ЭТрН.ПроведенВДалион,
	|	ВЫБОР
	|		КОГДА ЭТрН.МожноУтвердить
	|				ИЛИ ЭТрН.НомерДокументаДалион <> """"
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	Товары.НомерПозиции,
	|	Товары.Наименование,
	|	Товары.ЕдиницаИзмерения,
	|	Товары.Количество,
	|	Товары.Сумма,
	|	Товары.СуммаНДС
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ПО (Товары.ИдентификаторСБИС = ЭТрН.ИдентификаторСБИС)
	|			И (Товары.ИсточникТоваров <> ""База2"")
	|			И (Товары.ИсточникТоваров <> ""УКД"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК СвязаннаяУПД
	|		ПО (СвязаннаяУПД.ИдентификаторСБИС = ЭТрН.ИдентификаторУПД)
	|ГДЕ
	|	ЭТрН.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И СвязаннаяУПД.ИдентификаторСБИС ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Идентификатор,
	|	НомерПозиции";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Возврат Запрос;

КонецФункции

// Электроэнергия - по наименованию или по единице измерения кВт*ч (ОКЕИ 245).
//
Функция ЭтоЭлектроэнергия(Наименование, ЕдиницаИзмерения)

	Текст = СтрЗаменить(ВРег(Наименование), " ", "");
	Для Каждого Признак Из СтрРазделить("ЭЛЕКТРОЭНЕРГ,ЭЛЕКТРИЧЕСКАЯЭНЕРГ,ЭЛЕКТРИЧЕСКОЙЭНЕРГ,ЭЛЕКТРОСНАБЖЕН", ",") Цикл
		Если СтрНайти(Текст, Признак) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Единица = СтрЗаменить(СтрЗаменить(СтрЗаменить(ВРег(СокрЛП(ЕдиницаИзмерения)), " ", ""), ".", ""), "·", "*");
	Возврат Единица = "КВТ*Ч" ИЛИ Единица = "КВТЧ" ИЛИ Единица = "245";

КонецФункции

Функция СтатусДокумента(Выборка)

	Если Выборка.Утверждено Тогда
		Возврат "Утверждён в СБИС";
	ИначеЕсли Выборка.ПроведенВДалион Тогда
		Возврат "Проведён в Далионе";
	ИначеЕсли Выборка.ПриходНайден Тогда
		Возврат "Приходная Далиона найдена";
	КонецЕсли;

	Возврат "Не обработан";

КонецФункции

// Суммирует строки снизу вверх. Документов у узла документа - один, у группы
// и у ВСЕГО - сумма по вложенным.
//
Процедура ПодвестиИтоги(Узел)

	Если Узел.Строки.Количество() = 0 Тогда
		Для Каждого ИмяКолонки Из СтрРазделить("Документов,Строк,Количество,Сумма,СуммаНДС", ",") Цикл
			Если Узел[ИмяКолонки] = Неопределено Тогда
				Узел[ИмяКолонки] = 0;
			КонецЕсли;
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Узел.Документов = 0;
	Узел.Строк      = 0;
	Узел.Количество = 0;
	Узел.Сумма      = 0;
	Узел.СуммаНДС   = 0;

	ЭтоДокумент = ЗначениеЗаполнено(Узел.Идентификатор);

	Для Каждого Подчиненный Из Узел.Строки Цикл
		ПодвестиИтоги(Подчиненный);
		Узел.Документов = Узел.Документов + Подчиненный.Документов;
		Узел.Строк      = Узел.Строк + Подчиненный.Строк;
		Узел.Количество = Узел.Количество + Подчиненный.Количество;
		Узел.Сумма      = Узел.Сумма + Подчиненный.Сумма;
		Узел.СуммаНДС   = Узел.СуммаНДС + Подчиненный.СуммаНДС;
	КонецЦикла;

	Если ЭтоДокумент Тогда
		Узел.Документов = 1;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
