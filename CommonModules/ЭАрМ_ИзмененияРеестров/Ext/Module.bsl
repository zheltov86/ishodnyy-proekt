////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_ИзмененияРеестров: отметки «в реестре что-то поменялось».
//
// Подписки на запись реестров УПД, УКД и ЭТрН (ЭАрМ_ОчередьСобытий.ПриЗаписиРеестра)
// ставят отметку, а открытая форма раз в минуту спрашивает ПоследнееИзменение и
// перечитывает список, только если отметка новее запомненной. Вместо таймеров,
// которые на каждое открытое окно гоняли снимки и сверки по всему реестру.
//
// У каждого сеанса своя строка (Реестр + Сеанс): записи разных пользователей
// не блокируют друг друга. Общего счётчика нет.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Ставит отметку «реестр изменился» для текущего сеанса.
//
// Параметры:
//   Реестр - Строка - "УПД", "УКД" или "ЭТрН"
//
Процедура Отметить(Реестр) Экспорт

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_ИзмененияРеестров.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Реестр = Реестр;
	МенеджерЗаписи.Сеанс = НомерСеансаИнформационнойБазы();
	МенеджерЗаписи.Момент = ТекущаяДатаСеанса();
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

// Когда реестр менялся в последний раз (максимум по всем сеансам).
//
// Параметры:
//   Реестр - Строка - "УПД", "УКД" или "ЭТрН"
//
// Возвращаемое значение:
//   Дата - пустая, если отметок нет
//
Функция ПоследнееИзменение(Реестр) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(Отметки.Момент) КАК Момент
	|ИЗ
	|	РегистрСведений.ЭАрМ_ИзмененияРеестров КАК Отметки
	|ГДЕ
	|	Отметки.Реестр = &Реестр";
	Запрос.УстановитьПараметр("Реестр", Реестр);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ТипЗнч(Выборка.Момент) = Тип("Дата") Тогда
		Возврат Выборка.Момент;
	КонецЕсли;

	Возврат '00010101';

КонецФункции

// Удаляет отметки сеансов, давно не писавших: номера сеансов не повторяются,
// и строки умерших сеансов копились бы.
//
// Параметры:
//   ДнейХранить - Число
//
// Возвращаемое значение:
//   Число - сколько строк удалено
//
Функция ОчиститьСтарые(Знач ДнейХранить = 2) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Отметки.Реестр КАК Реестр,
	|	Отметки.Сеанс КАК Сеанс
	|ИЗ
	|	РегистрСведений.ЭАрМ_ИзмененияРеестров КАК Отметки
	|ГДЕ
	|	Отметки.Момент < &Граница";
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - ДнейХранить * 86400);

	Удалено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений.ЭАрМ_ИзмененияРеестров.СоздатьНаборЗаписей();
		Набор.Отбор.Реестр.Установить(Выборка.Реестр);
		Набор.Отбор.Сеанс.Установить(Выборка.Сеанс);
		Набор.Записать();
		Удалено = Удалено + 1;
	КонецЦикла;

	Возврат Удалено;

КонецФункции

#КонецОбласти
