////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_СтатистикаЭДО: сводка по документам ЭДО - что подписано в СБИС,
// что отправлено и ждёт подписи, а что ещё нужно обработать.
//
// Три взгляда на одни и те же данные:
//   ТаблицаСтатистики - по разделам и состояниям, с итогами;
//   ДеревоИтоговЭТрН  - товары ЭТрН, сгруппированные по состоянию подписи;
//   ТаблицаЦепочки    - заказ поставщику -> приходная -> УПД -> ЭТрН одной строкой.
//
// Состояние подписи одно на все разделы (см. ИмяСостояния):
//   «Подписан в СБИС»       - СБИС подтвердил подпись, делать нечего;
//   «Отправлен, ждём подпись» - утверждение ушло, подписи в СБИС ещё не видно;
//   «Готов к отправке»      - приходная найдена, можно подписывать;
//   «Надо обработать»       - приходной нет, подписывать нельзя.
//
// Товары считаются по регистру ЭАрМ_ТоварыЭТрН. У УПД берутся её строки,
// у ЭТрН - груз, но только когда связанной УПД в реестре нет: иначе один и тот
// же товар попал бы в итоги дважды. Строки Далиона (База2) и корректировок
// в итоги не входят.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Сводка по разделам и состояниям подписи с итогами.
//
// Параметры:
//   ДатаНачала, ДатаОкончания - Дата - период по дате документа;
//                               пустая дата окончания - по текущий день
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Раздел          - Строка - ЭТрН, УПД, УКД или «ВСЕГО»
//     * Показатель      - Строка - состояние подписи
//     * Документов      - Число
//     * Строк           - Число - позиций товаров
//     * Количество      - Число
//     * Сумма           - Число
//     * СуммаНДС        - Число
//     * ПоследнееСобытие - Дата - самое свежее событие среза, с временем
//     * ЧтоДелать       - Строка - что с этими документами делать дальше
//
Функция ТаблицаСтатистики(Знач ДатаНачала, Знач ДатаОкончания) Экспорт

	ДокументыЭДО = ТаблицаДокументов(ДатаНачала, ДатаОкончания);

	Статистика = НоваяТаблицаСтатистики();
	Ключи = Новый Соответствие;

	Для Каждого Документ Из ДокументыЭДО Цикл
		НакопитьСрез(Статистика, Ключи, Документ.Раздел, Документ.Состояние, Документ);
		НакопитьСрез(Статистика, Ключи, "ВСЕГО", Документ.Состояние, Документ);
	КонецЦикла;

	Статистика.Сортировать("Раздел, Показатель");

	Возврат Статистика;

КонецФункции

// Дерево товаров ЭТрН, сгруппированное по состоянию подписи в СБИС.
//
// Вынесено из формы реестра ЭТрН: там дерево мешало работе со списком,
// а нужно оно не каждый день и совсем для другой задачи - понять, что уже
// подписано, а что ещё ждёт обработки.
//
// Параметры:
//   ДатаНачала, ДатаОкончания - Дата - период по дате документа
//
// Возвращаемое значение:
//   ДеревоЗначений - колонки Представление, Состояние, Документов, Строк,
//                    Количество, Сумма, СуммаНДС, ПоследнееСобытие, Идентификатор
//
Функция ДеревоИтоговЭТрН(Знач ДатаНачала, Знач ДатаОкончания) Экспорт

	Период = НормализоватьПериод(ДатаНачала, ДатаОкончания);

	Дерево = Новый ДеревоЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить(
		"Представление,Состояние,Документов,Строк,Количество,Сумма,СуммаНДС,ПоследнееСобытие,Идентификатор", ",") Цикл
		Дерево.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;

	Всего = Дерево.Строки.Добавить();
	Всего.Представление = НСтр("ru = 'ВСЕГО'");
	Всего.Состояние = СтрШаблон("%1 - %2",
		Формат(Период.Начало, "ДЛФ=DT"), Формат(Период.Окончание, "ДЛФ=DT"));

	УзлыГрупп = Новый Соответствие;
	УзлыДокументов = Новый Соответствие;

	Выборка = ЗапросТоваровЭТрН(Период).Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если ЭтоЭлектроэнергия(Выборка.Наименование, Выборка.ЕдиницаИзмерения) Тогда
			ИмяГруппы = СостояниеЭлектроэнергия();
		Иначе
			ИмяГруппы = ИмяСостояния(Выборка);
		КонецЕсли;

		УзелГруппы = УзлыГрупп.Получить(ИмяГруппы);
		Если УзелГруппы = Неопределено Тогда
			УзелГруппы = Всего.Строки.Добавить();
			УзелГруппы.Представление = ИмяГруппы;
			УзелГруппы.Состояние = ЧтоДелать(ИмяГруппы);
			УзлыГрупп.Вставить(ИмяГруппы, УзелГруппы);
		КонецЕсли;

		Идентификатор = СокрЛП(Выборка.Идентификатор);
		КлючДокумента = ИмяГруппы + "|" + Идентификатор;

		УзелДокумента = УзлыДокументов.Получить(КлючДокумента);
		Если УзелДокумента = Неопределено Тогда
			УзелДокумента = УзелГруппы.Строки.Добавить();
			УзелДокумента.Представление = СтрШаблон(НСтр("ru = 'ЭТрН № %1 от %2, %3'"),
				СокрЛП(Выборка.Номер), Формат(Выборка.Дата, "ДЛФ=D"), СокрЛП(Выборка.Контрагент));
			УзелДокумента.Состояние        = ИмяСостояния(Выборка);
			УзелДокумента.Идентификатор    = Идентификатор;
			УзелДокумента.ПоследнееСобытие = ПоследнееСобытие(Выборка);
			УзлыДокументов.Вставить(КлючДокумента, УзелДокумента);
		КонецЕсли;

		СтрокаТовара = УзелДокумента.Строки.Добавить();
		СтрокаТовара.Представление = СокрЛП(Выборка.Наименование);
		СтрокаТовара.Состояние     = СокрЛП(Выборка.ЕдиницаИзмерения);
		СтрокаТовара.Строк         = 1;
		СтрокаТовара.Количество    = Выборка.Количество;
		СтрокаТовара.Сумма         = Выборка.Сумма;
		СтрокаТовара.СуммаНДС      = Выборка.СуммаНДС;

	КонецЦикла;

	ПодвестиИтоги(Всего);

	Возврат Дерево;

КонецФункции

// Цепочка закупки одной строкой: заказ поставщику, приходная накладная
// Далиона, УПД и ЭТрН с их состоянием подписи и временем событий.
//
// Параметры:
//   ДатаНачала, ДатаОкончания - Дата - период по дате заказа
//
// Возвращаемое значение:
//   ТаблицаЗначений - см. НоваяТаблицаЦепочки
//
Функция ТаблицаЦепочки(Знач ДатаНачала, Знач ДатаОкончания) Экспорт

	Период = НормализоватьПериод(ДатаНачала, ДатаОкончания);

	Цепочка = НоваяТаблицаЦепочки();

	Выборка = ЗапросЦепочки(Период).Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Строка = Цепочка.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);

		Строка.СостояниеУПД  = ?(ЗначениеЗаполнено(Выборка.ИдентификаторУПД),
			ИмяСостоянияПоПолям(Выборка.УПДПодписано, Выборка.УПДУтверждено, Выборка.УПДГотова),
			НСтр("ru = 'УПД не найдена'"));
		Строка.СостояниеЭТрН = ?(ЗначениеЗаполнено(Выборка.ИдентификаторЭТрН),
			ИмяСостоянияПоПолям(Выборка.ЭТрНПодписано, Выборка.ЭТрНУтверждено, Выборка.ЭТрНГотова),
			НСтр("ru = 'ЭТрН не найдена'"));

		Строка.Расхождения = ?(Выборка.ЕстьРасхождения,
			СтрШаблон(НСтр("ru = 'строк: %1'"), Выборка.РасхожденийСтрок), "");

	КонецЦикла;

	Возврат Цепочка;

КонецФункции

// Состояние подписи документа реестра одним словом.
//
// Одна формулировка на всю статистику: реестры ЭТрН, УПД и УКД ведут
// одинаковые поля, и расходиться их толкованию нельзя.
//
// Параметры:
//   Подписано  - Булево - СБИС подтвердил подпись
//   Утверждено - Булево - утверждение отправлено в СБИС
//   Готов      - Булево - приходная найдена, подписывать можно
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяСостоянияПоПолям(Подписано, Утверждено, Готов) Экспорт

	Если Подписано Тогда
		Возврат СостояниеПодписан();
	ИначеЕсли Утверждено Тогда
		Возврат СостояниеОтправлен();
	ИначеЕсли Готов Тогда
		Возврат СостояниеГотов();
	КонецЕсли;

	Возврат СостояниеНадоОбработать();

КонецФункции

// Названия состояний. Их показывает форма и по ним же красит строки,
// поэтому текст живёт в одном месте.
//
Функция СостояниеПодписан() Экспорт
	Возврат НСтр("ru = 'Подписан в СБИС'");
КонецФункции

Функция СостояниеОтправлен() Экспорт
	Возврат НСтр("ru = 'Отправлен, ждём подпись'");
КонецФункции

Функция СостояниеГотов() Экспорт
	Возврат НСтр("ru = 'Готов к отправке'");
КонецФункции

Функция СостояниеНадоОбработать() Экспорт
	Возврат НСтр("ru = 'Надо обработать'");
КонецФункции

Функция СостояниеЭлектроэнергия() Экспорт
	Возврат НСтр("ru = 'Электроэнергия'");
КонецФункции

// Что делать с документами в этом состоянии.
//
// Параметры:
//   Состояние - Строка - см. ИмяСостоянияПоПолям
//
// Возвращаемое значение:
//   Строка
//
Функция ЧтоДелать(Знач Состояние) Экспорт

	Если Состояние = СостояниеПодписан() Тогда
		Возврат НСтр("ru = 'Ничего, документооборот закрыт'");
	ИначеЕсли Состояние = СостояниеОтправлен() Тогда
		Возврат НСтр("ru = 'Проверить подпись в СБИС - кнопка в очереди отправки'");
	ИначеЕсли Состояние = СостояниеГотов() Тогда
		Возврат НСтр("ru = 'Собрать в очередь и подписать'");
	ИначеЕсли Состояние = СостояниеЭлектроэнергия() Тогда
		Возврат НСтр("ru = 'Считается отдельно, в приход Далиона не идёт'");
	КонецЕсли;

	Возврат НСтр("ru = 'Найти приходную накладную Далиона или разобрать расхождения'");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Документы всех реестров за период с итогами по товарам.
//
// Переменная названа ДокументыЭДО, а не Документы: «Документы» - свойство
// глобального контекста (менеджер документов), присваивать ему нельзя.
//
Функция ТаблицаДокументов(Знач ДатаНачала, Знач ДатаОкончания)

	Период = НормализоватьПериод(ДатаНачала, ДатаОкончания);

	ДокументыЭДО = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить(
		"Раздел,Идентификатор,Номер,Дата,Контрагент,Состояние,Строк,Количество,Сумма,СуммаНДС,ПоследнееСобытие", ",") Цикл
		ДокументыЭДО.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;

	Выборка = ЗапросДокументов(Период).Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Строка = ДокументыЭДО.Добавить();
		Строка.Раздел           = Выборка.Раздел;
		Строка.Идентификатор    = СокрЛП(Выборка.Идентификатор);
		Строка.Номер            = СокрЛП(Выборка.Номер);
		Строка.Дата             = Выборка.Дата;
		Строка.Контрагент       = СокрЛП(Выборка.Контрагент);
		Строка.Состояние        = ИмяСостояния(Выборка);
		Строка.Строк            = ?(Выборка.Строк = NULL, 0, Выборка.Строк);
		Строка.Количество       = ?(Выборка.Количество = NULL, 0, Выборка.Количество);
		Строка.Сумма            = ?(Выборка.Сумма = NULL, 0, Выборка.Сумма);
		Строка.СуммаНДС         = ?(Выборка.СуммаНДС = NULL, 0, Выборка.СуммаНДС);
		Строка.ПоследнееСобытие = ПоследнееСобытие(Выборка);

	КонецЦикла;

	Возврат ДокументыЭДО;

КонецФункции

Функция НоваяТаблицаСтатистики()

	Статистика = Новый ТаблицаЗначений;
	Статистика.Колонки.Добавить("Раздел");
	Статистика.Колонки.Добавить("Показатель");
	Статистика.Колонки.Добавить("Документов");
	Статистика.Колонки.Добавить("Строк");
	Статистика.Колонки.Добавить("Количество");
	Статистика.Колонки.Добавить("Сумма");
	Статистика.Колонки.Добавить("СуммаНДС");
	Статистика.Колонки.Добавить("ПоследнееСобытие");
	Статистика.Колонки.Добавить("ЧтоДелать");

	Возврат Статистика;

КонецФункции

// Добавляет документ в срез «раздел + состояние», заводя срез при первом
// попадании.
//
Процедура НакопитьСрез(Статистика, Ключи, Раздел, Состояние, Документ)

	Ключ = Раздел + "|" + Состояние;

	Строка = Ключи.Получить(Ключ);
	Если Строка = Неопределено Тогда
		Строка = Статистика.Добавить();
		Строка.Раздел           = Раздел;
		Строка.Показатель       = Состояние;
		Строка.Документов       = 0;
		Строка.Строк            = 0;
		Строка.Количество       = 0;
		Строка.Сумма            = 0;
		Строка.СуммаНДС         = 0;
		Строка.ПоследнееСобытие = '00010101';
		Строка.ЧтоДелать        = ЧтоДелать(Состояние);
		Ключи.Вставить(Ключ, Строка);
	КонецЕсли;

	Строка.Документов = Строка.Документов + 1;
	Строка.Строк      = Строка.Строк + Документ.Строк;
	Строка.Количество = Строка.Количество + Документ.Количество;
	Строка.Сумма      = Строка.Сумма + Документ.Сумма;
	Строка.СуммаНДС   = Строка.СуммаНДС + Документ.СуммаНДС;

	Если Документ.ПоследнееСобытие > Строка.ПоследнееСобытие Тогда
		Строка.ПоследнееСобытие = Документ.ПоследнееСобытие;
	КонецЕсли;

КонецПроцедуры

// Состояние подписи по строке выборки реестра.
//
Функция ИмяСостояния(Выборка)

	Возврат ИмяСостоянияПоПолям(Выборка.Подписано, Выборка.Утверждено, Выборка.Готов);

КонецФункции

// Самое свежее событие документа: загрузка из СБИС, выгрузка в Далион
// или ответ Далиона. По нему видно, когда с документом в последний раз
// что-то происходило.
//
// Обе выборки отдают все три даты: у УПД и УКД своих выгрузки и ответа
// Далиона нет, и в запросе на их месте стоит пустая дата.
//
Функция ПоследнееСобытие(Выборка)

	Результат = '00010101';

	Результат = Макс(Результат, Выборка.ДатаЗагрузки);
	Результат = Макс(Результат, Выборка.ДатаВыгрузки);
	Результат = Макс(Результат, Выборка.ДатаОтветаДалион);

	Возврат Результат;

КонецФункции

Функция НормализоватьПериод(Знач ДатаНачала, Знач ДатаОкончания)

	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = ТекущаяДатаСеанса();
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = НачалоМесяца(ДатаОкончания);
	КонецЕсли;

	Возврат Новый Структура("Начало, Окончание",
		НачалоДня(ДатаНачала), КонецДня(ДатаОкончания));

КонецФункции

// Документы трёх реестров с итогами товаров.
//
// Товары считаются заранее, во временной таблице: соединять реестр со строками
// напрямую нельзя - документ размножился бы по числу позиций, и «Документов»
// в статистике стало бы количеством строк.
//
Функция ЗапросДокументов(Период)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.ИдентификаторСБИС КАК Идентификатор,
	|	Товары.ИсточникТоваров КАК ИсточникТоваров,
	|	КОЛИЧЕСТВО(1) КАК Строк,
	|	СУММА(Товары.Количество) КАК Количество,
	|	СУММА(Товары.Сумма) КАК Сумма,
	|	СУММА(Товары.СуммаНДС) КАК СуммаНДС
	|ПОМЕСТИТЬ ИтогиТоваров
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИсточникТоваров <> ""База2""
	|	И Товары.ИсточникТоваров <> ""УКД""
	|СГРУППИРОВАТЬ ПО
	|	Товары.ИдентификаторСБИС,
	|	Товары.ИсточникТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""ЭТрН"" КАК Раздел,
	|	ЭТрН.ИдентификаторСБИС КАК Идентификатор,
	|	ЭТрН.Номер КАК Номер,
	|	ЭТрН.Дата КАК Дата,
	|	ЭТрН.Контрагент КАК Контрагент,
	|	ЭТрН.Подписано КАК Подписано,
	|	ЭТрН.Утверждено КАК Утверждено,
	|	ЭТрН.МожноУтвердить КАК Готов,
	|	ЭТрН.ДатаЗагрузки КАК ДатаЗагрузки,
	|	ЭТрН.ДатаВыгрузки КАК ДатаВыгрузки,
	|	ЭТрН.ДатаОтветаДалион КАК ДатаОтветаДалион,
	|	Итоги.Строк КАК Строк,
	|	Итоги.Количество КАК Количество,
	|	Итоги.Сумма КАК Сумма,
	|	Итоги.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИтогиТоваров КАК Итоги
	|		ПО ЭТрН.ИдентификаторСБИС = Итоги.Идентификатор
	|			И Итоги.ИсточникТоваров <> ""УПД""
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК СвязаннаяУПД
	|		ПО ЭТрН.ИдентификаторУПД = СвязаннаяУПД.ИдентификаторСБИС
	|ГДЕ
	|	ЭТрН.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И СвязаннаяУПД.ИдентификаторСБИС ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""УПД"",
	|	УПД.ИдентификаторСБИС,
	|	УПД.Номер,
	|	УПД.Дата,
	|	УПД.Контрагент,
	|	УПД.Подписано,
	|	УПД.Утверждено,
	|	УПД.РасхожденийНет,
	|	УПД.ДатаЗагрузки,
	|	ДАТАВРЕМЯ(1, 1, 1),
	|	ДАТАВРЕМЯ(1, 1, 1),
	|	Итоги.Строк,
	|	Итоги.Количество,
	|	Итоги.Сумма,
	|	Итоги.СуммаНДС
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИтогиТоваров КАК Итоги
	|		ПО УПД.ИдентификаторСБИС = Итоги.Идентификатор
	|			И Итоги.ИсточникТоваров = ""УПД""
	|ГДЕ
	|	УПД.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""УКД"",
	|	УКД.ИдентификаторСБИС,
	|	УКД.Номер,
	|	УКД.Дата,
	|	УКД.Контрагент,
	|	УКД.Подписано,
	|	УКД.Утверждено,
	|	УКД.РасхожденийНет,
	|	УКД.ДатаЗагрузки,
	|	ДАТАВРЕМЯ(1, 1, 1),
	|	ДАТАВРЕМЯ(1, 1, 1),
	|	0,
	|	0,
	|	0,
	|	0
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|
	|УПОРЯДОЧИТЬ ПО
	|	Раздел,
	|	Дата,
	|	Номер";

	Запрос.УстановитьПараметр("ДатаНачала", Период.Начало);
	Запрос.УстановитьПараметр("ДатаОкончания", Период.Окончание);

	Возврат Запрос;

