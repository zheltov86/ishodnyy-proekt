// Электроэнергия - по наименованию или по единице измерения кВт*ч (ОКЕИ 245).
//
Функция ЭтоЭлектроэнергия(Наименование, ЕдиницаИзмерения)

	Текст = СтрЗаменить(ВРег(Наименование), " ", "");
	Для Каждого Признак Из СтрРазделить("ЭЛЕКТРОЭНЕРГ,ЭЛЕКТРИЧЕСКАЯЭНЕРГ,ЭЛЕКТРИЧЕСКОЙЭНЕРГ,ЭЛЕКТРОСНАБЖЕН", ",") Цикл
		Если СтрНайти(Текст, Признак) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Единица = СтрЗаменить(СтрЗаменить(СтрЗаменить(ВРег(СокрЛП(ЕдиницаИзмерения)), " ", ""), ".", ""), "·", "*");
	Возврат Единица = "КВТ*Ч" ИЛИ Единица = "КВТЧ" ИЛИ Единица = "245";

КонецФункции

// Суммирует строки снизу вверх. Документов у узла документа - один, у группы
// и у ВСЕГО - сумма по вложенным.
//
Процедура ПодвестиИтоги(Узел)

	Если Узел.Строки.Количество() = 0 Тогда
		Для Каждого ИмяКолонки Из СтрРазделить("Документов,Строк,Количество,Сумма,СуммаНДС", ",") Цикл
			Если Узел[ИмяКолонки] = Неопределено Тогда
				Узел[ИмяКолонки] = 0;
			КонецЕсли;
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Узел.Документов = 0;
	Узел.Строк      = 0;
	Узел.Количество = 0;
	Узел.Сумма      = 0;
	Узел.СуммаНДС   = 0;

	ЭтоДокумент = ЗначениеЗаполнено(Узел.Идентификатор);

	Для Каждого Подчиненный Из Узел.Строки Цикл
		ПодвестиИтоги(Подчиненный);
		Узел.Документов = Узел.Документов + Подчиненный.Документов;
		Узел.Строк      = Узел.Строк + Подчиненный.Строк;
		Узел.Количество = Узел.Количество + Подчиненный.Количество;
		Узел.Сумма      = Узел.Сумма + Подчиненный.Сумма;
		Узел.СуммаНДС   = Узел.СуммаНДС + Подчиненный.СуммаНДС;

		Если ТипЗнч(Подчиненный.ПоследнееСобытие) = Тип("Дата")
			И (ТипЗнч(Узел.ПоследнееСобытие) <> Тип("Дата")
				ИЛИ Подчиненный.ПоследнееСобытие > Узел.ПоследнееСобытие) Тогда
			Узел.ПоследнееСобытие = Подчиненный.ПоследнееСобытие;
		КонецЕсли;
	КонецЦикла;

	Если ЭтоДокумент Тогда
		Узел.Документов = 1;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
