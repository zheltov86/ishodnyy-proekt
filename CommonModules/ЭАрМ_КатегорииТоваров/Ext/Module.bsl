Функция ЕстьЛюбоеСлово(Слова, Образцы)

	Для Каждого Образец Из Образцы Цикл
		Части = СтрРазделить(Образец, " ", Ложь);
		Все = Истина;
		Для Каждого Часть Из Части Цикл
			Если НЕ ЕстьСлово(Слова, Часть) Тогда
				Все = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Все И Части.Количество() > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Слово наименования начинается с образца. Короткие образцы (до 4 букв) - только
// слово целиком или с окончанием до 2 букв: «лук» - «лука», но не «лукошко».
Функция ЕстьСлово(Слова, Образец)

	Для Каждого Слово Из Слова Цикл
		Если СтрНачинаетсяС(Слово, Образец) Тогда
			Если СтрДлина(Образец) > 4 ИЛИ СтрДлина(Слово) - СтрДлина(Образец) <= 2 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция СловаНаименования(Наименование)

	Слова = Новый Массив;
	Текст = НРег(СтрЗаменить(Строка(Наименование), "ё", "е"));
	Слово = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если НРег(Символ) <> ВРег(Символ) Тогда
			Слово = Слово + Символ;
		ИначеЕсли Слово <> "" Тогда
			Слова.Добавить(Слово);
			Слово = "";
		КонецЕсли;
	КонецЦикла;
	Если Слово <> "" Тогда
		Слова.Добавить(Слово);
	КонецЕсли;
	Возврат Слова;

