#КонецОбласти

#Область ОчередьСозданияНоменклатуры

// Ставит номенклатуру в очередь создания: название и данные из Далиона сохраняются
// в регистр, а регламентное задание позже создаёт по ним карточку УТ.
//
// Параметры:
//   Описание - Структура - Штрихкод, НаименованиеДалион, КодНоменклатурыДалион,
//              Артикул, Категория, ИННПоставщика, Поставщик, КодТовараПоставщика
//
Процедура ПоставитьВОчередьСоздания(Описание) Экспорт

	Штрихкод = СокрЛП(Описание.Штрихкод);
	Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат;
	КонецЕсли;

	Менеджер = РегистрыСведений.ЭАрМ_ОчередьСозданияНоменклатуры.СоздатьМенеджерЗаписи();
	Менеджер.Штрихкод = Лев(Штрихкод, 200);
	Менеджер.Прочитать();

	Менеджер.Штрихкод              = Лев(Штрихкод, 200);
	Менеджер.НаименованиеДалион    = Лев(СокрЛП(Описание.НаименованиеДалион), 500);
	Менеджер.КодНоменклатурыДалион = Лев(СокрЛП(Описание.КодНоменклатурыДалион), 50);
	Менеджер.Артикул               = Лев(СокрЛП(Описание.Артикул), 50);
	Менеджер.Категория             = Лев(СокрЛП(Описание.Категория), 50);
	Менеджер.ИННПоставщика         = Лев(СокрЛП(Описание.ИННПоставщика), 12);
	Менеджер.Поставщик             = Лев(СокрЛП(Описание.Поставщик), 200);
	Менеджер.КодТовараПоставщика   = Лев(СокрЛП(Описание.КодТовараПоставщика), 50);
	Менеджер.Статус                = "Ожидает";
	Менеджер.Ошибка                = "";
	Менеджер.ДатаОбновления        = ТекущаяДатаСеанса();
	Менеджер.Записать(Истина);

КонецПроцедуры

// Вход регламентного задания: обрабатывает очередь создания номенклатуры.
Процедура ВыполнитьЗаданиеСозданияНоменклатуры() Экспорт

	Если ЭАрМ_НастройкиСервер.ФоновыеЗаданияОтключены() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		// Запросы номенклатуры у Далиона отключены (14.10.2026): очередь создания
		// работает только по данным, которые уже пришли в заказах и приходных.
		// ОбработатьОтветыДалионаПоНоменклатуре и ОтправитьОчередьЗапросаДалиона
		// здесь больше не вызываются
		Итог = ОбработатьОчередьСоздания();
		Если Итог.Ошибок > 0 ИЛИ Итог.Создано > 0 Тогда
			ЗаписьЖурналаРегистрации("ЭАрМ.ОчередьСозданияНоменклатуры",
				УровеньЖурналаРегистрации.Информация, , ,
				СтрШаблон("обработано %1, создано %2, ошибок %3",
					Итог.Обработано, Итог.Создано, Итог.Ошибок));
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЭАрМ.ОчередьСозданияНоменклатуры",
			УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Создаёт номенклатуру УТ по записям очереди со статусом «Ожидает».
//
// Возвращаемое значение:
//   Структура - Обработано, Создано, Ошибок (Число)
//
Функция ОбработатьОчередьСоздания() Экспорт

	Итог = Новый Структура("Обработано, Создано, Ошибок", 0, 0, 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Штрихкод КАК Штрихкод,
	|	Очередь.НаименованиеДалион КАК НаименованиеДалион,
	|	Очередь.КодНоменклатурыДалион КАК КодНоменклатурыДалион,
	|	Очередь.Артикул КАК Артикул,
	|	Очередь.Категория КАК Категория,
	|	Очередь.ИННПоставщика КАК ИННПоставщика,
	|	Очередь.Поставщик КАК Поставщик,
	|	Очередь.КодТовараПоставщика КАК КодТовараПоставщика,
	|	Очередь.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОчередьСозданияНоменклатуры КАК Очередь
	|ГДЕ
	|	Очередь.Статус = ""Ожидает""
	|	ИЛИ Очередь.Статус = ""ЗапросДалион""";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Итог.Обработано = Итог.Обработано + 1;

		Менеджер = РегистрыСведений.ЭАрМ_ОчередьСозданияНоменклатуры.СоздатьМенеджерЗаписи();
		Менеджер.Штрихкод = СокрЛП(Выборка.Штрихкод);
		Менеджер.Прочитать();

		Номенклатура = НоменклатураПоШтрихкоду(НормализованныйШтрихкод(Выборка.Штрихкод));

		Если ЗначениеЗаполнено(Номенклатура) Тогда
			// Карточка уже есть - дозаполняем артикул данными Далиона, если они пришли
			Артикул = АртикулПоШтрихкоду(Выборка.Штрихкод);
			Если ЗначениеЗаполнено(Артикул) Тогда
				ЗаполнитьАртикулКарточки(Номенклатура, Артикул);
				Итог.Создано = Итог.Создано + 1;
				Менеджер.Статус = "Создана";
				Менеджер.Ошибка = "";
			Иначе
				// Запрос карточки у Далиона отключён: артикула нет - карточка всё
				// равно есть, строка очереди закрывается, а не ждёт Далион
				Итог.Создано = Итог.Создано + 1;
				Менеджер.Статус = "Создана";
				Менеджер.Ошибка = "артикул не заполнен: запрос номенклатуры у Далиона отключён";
			КонецЕсли;
		Иначе
			// Карточки нет - создаём
			Товар = Новый Структура("Наименование, Штрихкод, Категория",
				СокрЛП(Выборка.НаименованиеДалион), СокрЛП(Выборка.Штрихкод), СокрЛП(Выборка.Категория));
			Товар.Вставить("КодНоменклатурыДалион", СокрЛП(Выборка.КодНоменклатурыДалион));
			Товар.Вставить("АртикулДалион", СокрЛП(Выборка.Артикул));
			Товар.Вставить("ИННПоставщика", СокрЛП(Выборка.ИННПоставщика));
			Товар.Вставить("Поставщик", СокрЛП(Выборка.Поставщик));
			Товар.Вставить("КодТовараПоставщика", СокрЛП(Выборка.КодТовараПоставщика));

			ИтогСоздания = Новый Структура("Ошибок, Сообщения", 0, Новый Массив);
			Попытка
				СоздатьПоКатегории(Товар, ИтогСоздания);
			Исключение
				ИтогСоздания.Сообщения.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;

			// Не верим возврату СоздатьПоКатегории - проверяем по регистрам, что карточка есть
			Проверка = ПроверитьСозданиеНоменклатуры(Выборка.Штрихкод, Выборка.НаименованиеДалион);
			Если Проверка.Создана Тогда
				Итог.Создано = Итог.Создано + 1;
				Менеджер.Статус = "Создана";
				Менеджер.Ошибка = "";
			Иначе
				Итог.Ошибок = Итог.Ошибок + 1;
				Менеджер.Статус = "Ошибка";
				Если ЗначениеЗаполнено(Проверка.Проблема) Тогда
					ИтогСоздания.Сообщения.Добавить(Проверка.Проблема);
				КонецЕсли;
				Менеджер.Ошибка = Лев(СтрСоединить(ИтогСоздания.Сообщения, "; "), 500);
			КонецЕсли;
		КонецЕсли;
		Менеджер.ДатаОбновления = ТекущаяДатаСеанса();
		Менеджер.Записать(Истина);

	КонецЦикла;

	Возврат Итог;

КонецФункции

// Проверяет по регистрам, что номенклатура действительно создана: сначала по
// штрихкоду в УТ, затем по наименованию. Возвращает: Создана (Булево),
// Номенклатура (СправочникСсылка.Номенклатура), Проблема (Строка).
Функция ПроверитьСозданиеНоменклатуры(Штрихкод, Наименование) Экспорт

	Результат = Новый Структура("Создана, Номенклатура, Проблема",
		Ложь, Справочники.Номенклатура.ПустаяСсылка(), "");

	Код = НормализованныйШтрихкод(Штрихкод);
	Если ЗначениеЗаполнено(Код) Тогда
		Номенклатура = НоменклатураПоШтрихкоду(Код);
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			Результат.Создана = Истина;
			Результат.Номенклатура = Номенклатура;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// Штрихкод в УТ не записался - ищем карточку по наименованию
	Имя = СокрЛП(Наименование);
	Если ЗначениеЗаполнено(Имя) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Наименование = &Наименование
		|	И НЕ Номенклатура.ЭтоГруппа
		|	И НЕ Номенклатура.ПометкаУдаления";
		Запрос.УстановитьПараметр("Наименование", Имя);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.Создана = Истина;
			Результат.Номенклатура = Выборка.Ссылка;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Результат.Проблема = "номенклатура не создана: нет ни в регистре штрихкодов УТ, ни по наименованию";
	Возврат Результат;

КонецФункции

// Артикул для карточки по штрихкоду: код Далиона / артикул Далиона / артикул УПД /
// код поставщика (тот же порядок, что в ДополнитьКарточкуИзДанныхПоставки).
Функция АртикулПоШтрихкоду(Штрихкод)

	Поставка = ДанныеПоставкиТовара(Штрихкод);
	Для Каждого Имя Из СтрРазделить("АртикулДалион,КодНоменклатурыДалион,Артикул,КодТовараПоставщика", ",") Цикл
		Если Поставка.Свойство(Имя) И ЗначениеЗаполнено(Поставка[Имя]) Тогда
			Возврат СокрЛП(Поставка[Имя]);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Дозаполняет артикул уже созданной карточки номенклатуры УТ (если он пуст).
Процедура ЗаполнитьАртикулКарточки(Ссылка, Артикул)

	Если НЕ ЗначениеЗаполнено(Ссылка) ИЛИ НЕ ЗначениеЗаполнено(Артикул) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Объект = Ссылка.ПолучитьОбъект();
	Исключение
		Возврат;
	КонецПопытки;
	Если Объект = Неопределено ИЛИ ЗначениеЗаполнено(Объект.Артикул) Тогда
		Возврат;
	КонецЕсли;

	ДлинаАртикула = Метаданные.Справочники.Номенклатура.Реквизиты.Артикул.Тип.КвалификаторыСтроки.Длина;
	Объект.Артикул = ?(ДлинаАртикула = 0, Артикул, Лев(Артикул, ДлинаАртикула));
	Объект.Записать();

КонецПроцедуры

// Запрос номенклатуры у Далиона порциями.
//
// Штрихкод попадает в очередь (статус «КЗапросу»), когда меняются
// ЭАрМ_ШтрихкодыПоставщиков (связки, реестр и строки УПД, сверка) или
// ЭАрМ_ПарыНоменклатурыПоИмени. Задание отправляет очередь порциями
// (dataRequest, objects = Номенклатура, barcodes), ответ разбирает
// ЗагрузитьНоменклатуруДалион, после чего запись получает статус «Ожидает»
// и ОбработатьОчередьСоздания записывает номенклатуру в УТ.
//
// Статусы: КЗапросу -> ОжидаетДалион -> Ожидает -> Создана;
// НеНайденоВДалионе и Ошибка - конечные до нового изменения (не чаще раза в сутки).

Функция РазмерПорцииЗапросаДалиона()

	Возврат 200;

КонецФункции

Функция ПорцийЗаПроходЗапросаДалиона()

	Возврат 5;

КонецФункции

// Сутки: не чаще повторять запрос по тому же штрихкоду и не дольше ждать ответ.
Функция СрокЗапросаДалионаСекунд()

	Возврат 86400;

КонецФункции

Функция СтатусОчередиВРаботе(Статус)

	Возврат Статус = "Ожидает" ИЛИ Статус = "ЗапросДалион"
		ИЛИ Статус = "КЗапросу" ИЛИ Статус = "ОжидаетДалион";

КонецФункции

// Ставит штрихкод в очередь запроса номенклатуры у Далиона. Уже находящийся
// в работе штрихкод и обработанный меньше суток назад не ставится повторно.
//
// Параметры:
//   Штрихкод - Строка - только цифры, 8-50 знаков (ключи «БЕЗШК:» отбрасываются)
//
Процедура ПоставитьВОчередьЗапросаДалиона(Штрихкод) Экспорт

	Код = СокрЛП(Штрихкод);
	Если СтрДлина(Код) < 8 ИЛИ СтрДлина(Код) > 50 ИЛИ Код <> ТолькоЦифры(Код) Тогда
		Возврат;
	КонецЕсли;

	Менеджер = РегистрыСведений.ЭАрМ_ОчередьСозданияНоменклатуры.СоздатьМенеджерЗаписи();
	Менеджер.Штрихкод = Код;
	Менеджер.Прочитать();

	Если Менеджер.Выбран() Тогда
		Статус = СокрЛП(Менеджер.Статус);
		Если СтатусОчередиВРаботе(Статус) Тогда
			Возврат;
		КонецЕсли;
		Если ЗначениеЗаполнено(Менеджер.ДатаОбновления)
			И ТекущаяДатаСеанса() - Менеджер.ДатаОбновления < СрокЗапросаДалионаСекунд() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Менеджер.Штрихкод       = Код;
	Менеджер.Статус         = "КЗапросу";
	Менеджер.Ошибка         = "";
	Менеджер.ДатаОбновления = ТекущаяДатаСеанса();
	Менеджер.Записать(Истина);

КонецПроцедуры

// Отправляет в Далион штрихкоды со статусом «КЗапросу» порциями.
//
// Возвращаемое значение:
//   Структура - Порций, Штрихкодов, Ошибок (Число)
//
Функция ОтправитьОчередьЗапросаДалиона() Экспорт

	Итог = Новый Структура("Порций, Штрихкодов, Ошибок", 0, 0, 0);

	// Запросы номенклатуры у Далиона отключены (14.10.2026): регламентное
	// задание эту функцию не вызывает, а ЭАрМ_ЗапросыДалион тип «Номенклатура»
	// отсекает. Оставлена, чтобы не ломать внешние вызовы
	Возврат Итог;

	Размер = РазмерПорцииЗапросаДалиона();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Размер * ПорцийЗаПроходЗапросаДалиона(), "ЧГ=0") + "
	|	Очередь.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОчередьСозданияНоменклатуры КАК Очередь
	|ГДЕ
	|	Очередь.Статус = ""КЗапросу""
	|
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.ДатаОбновления";

	Штрихкоды = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Штрихкод");

	Для Начало = 0 По Штрихкоды.Количество() - 1 Цикл

		Если Начало % Размер <> 0 Тогда
			Продолжить;
		КонецЕсли;

		Порция = Новый Массив;
		Для Индекс = Начало По Мин(Начало + Размер, Штрихкоды.Количество()) - 1 Цикл
			Порция.Добавить(СокрЛП(Штрихкоды[Индекс]));
		КонецЦикла;

		Результат = ЭАрМ_ЗапросыДалион.ОтправитьЗапросДанных("Номенклатура",
			Новый Структура("barcodes", Порция));

		Для Каждого Код Из Порция Цикл
			Менеджер = РегистрыСведений.ЭАрМ_ОчередьСозданияНоменклатуры.СоздатьМенеджерЗаписи();
			Менеджер.Штрихкод = Код;
			Менеджер.Прочитать();
			Если НЕ Менеджер.Выбран() ИЛИ СокрЛП(Менеджер.Статус) <> "КЗапросу" Тогда
				Продолжить;
			КонецЕсли;
			Менеджер.Штрихкод = Код;
			Если Результат.Успех Тогда
				Менеджер.Статус = "ОжидаетДалион";
				Менеджер.Ошибка = "запрос " + Результат.ИдентификаторЗапроса;
				Менеджер.ДатаОбновления = ТекущаяДатаСеанса();
			Иначе
				Менеджер.Ошибка = Лев("запрос в Далион не отправлен: " + Результат.Ошибка, 500);
			КонецЕсли;
			Менеджер.Записать(Истина);
		КонецЦикла;

		Если НЕ Результат.Успех Тогда
			// Нет связи с каналом - остальные порции не пробуем, повтор в следующий проход
			Итог.Ошибок = Итог.Ошибок + 1;
			Прервать;
		КонецЕсли;

		Итог.Порций = Итог.Порций + 1;
		Итог.Штрихкодов = Итог.Штрихкодов + Порция.Количество();

	КонецЦикла;

	Возврат Итог;

КонецФункции

// Штрихкоды со статусом «ОжидаетДалион»: если Далион уже ответил (карточка
// сохранена после отправки запроса) - данные карточки в очередь создания
// (статус «Ожидает»); без ответа за сутки - «Ошибка».
//
Процедура ОбработатьОтветыДалионаПоНоменклатуре() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Штрихкод КАК Штрихкод,
	|	Очередь.ДатаОбновления КАК ДатаОтправки
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОчередьСозданияНоменклатуры КАК Очередь
	|ГДЕ
	|	Очередь.Статус = ""ОжидаетДалион""";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Код = СокрЛП(Выборка.Штрихкод);
		Карточка = КарточкаОтветаДалиона(Код, Выборка.ДатаОтправки);

		Менеджер = РегистрыСведений.ЭАрМ_ОчередьСозданияНоменклатуры.СоздатьМенеджерЗаписи();
		Менеджер.Штрихкод = Код;
		Менеджер.Прочитать();
		Если НЕ Менеджер.Выбран() ИЛИ СокрЛП(Менеджер.Статус) <> "ОжидаетДалион" Тогда
			Продолжить;
		КонецЕсли;
		Менеджер.Штрихкод = Код;

		Если Карточка <> Неопределено Тогда
			Менеджер.НаименованиеДалион    = Лев(СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(Карточка, "name", ""))), 500);
			Менеджер.КодНоменклатурыДалион = Лев(СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(Карточка, "code", ""))), 50);
			Менеджер.Артикул               = Лев(СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(Карточка, "article", ""))), 50);
			Менеджер.Ошибка                = "";

			// Карточка УТ уже есть - дозаполняем артикул здесь. Иначе очередь создания
			// без артикула Далиона ушла бы в одиночный запрос и зависла в «ЗапросДалион»
			НоменклатураУТ = НоменклатураПоШтрихкоду(НормализованныйШтрихкод(Код));
			Если ЗначениеЗаполнено(НоменклатураУТ) Тогда
				Артикул = СокрЛП(Менеджер.Артикул);
				Если НЕ ЗначениеЗаполнено(Артикул) Тогда
					Артикул = СокрЛП(Менеджер.КодНоменклатурыДалион);
				КонецЕсли;
				Попытка
					ЗаполнитьАртикулКарточки(НоменклатураУТ, Артикул);
					Менеджер.Статус = "Создана";
				Исключение
					Менеджер.Статус = "Ошибка";
					Менеджер.Ошибка = Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 500);
				КонецПопытки;
			Иначе
				Менеджер.Статус = "Ожидает";
			КонецЕсли;
		ИначеЕсли ТекущаяДатаСеанса() - Выборка.ДатаОтправки > СрокЗапросаДалионаСекунд() Тогда
			Менеджер.Статус = "Ошибка";
			Менеджер.Ошибка = "Далион не ответил на запрос номенклатуры за сутки";
		Иначе
			Продолжить;
		КонецЕсли;
		Менеджер.ДатаОбновления = ТекущаяДатаСеанса();
		Менеджер.Записать(Истина);

	КонецЦикла;

КонецПроцедуры

// Карточка Далиона, пришедшая в ответ на запрос: ищем по штрихкоду в регистре
// штрихкодов поставщиков и берём её, только если пакет карточки сохранён не раньше
// отправки запроса. Источник записи не проверяем: сверка могла его перезаписать.
//
Функция КарточкаОтветаДалиона(Штрихкод, ДатаОтправки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Штрихкоды.ИдентификаторНоменклатурыДалион КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ПакетыДалион КАК Пакеты
	|		ПО Пакеты.ТипОбъекта = ""НоменклатураДалион""
	|			И Пакеты.ИдентификаторОбъекта = Штрихкоды.ИдентификаторНоменклатурыДалион
	|ГДЕ
	|	Штрихкоды.Штрихкод В (&Штрихкоды)
	|	И Штрихкоды.ИдентификаторНоменклатурыДалион <> """"
	|	И Пакеты.ДатаОбработки >= &ДатаОтправки";
	Запрос.УстановитьПараметр("Штрихкоды", ВариантыШтрихкода(Штрихкод));
	Запрос.УстановитьПараметр("ДатаОтправки", ДатаОтправки);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("НоменклатураДалион", СокрЛП(Выборка.Идентификатор));

КонецФункции

// Ответ Далиона перечисляет штрихкоды, которых у него нет (barcodeSearch.found = false):
// такие записи закрываются сразу, без ожидания суток.
//
// Параметры:
//   НеНайденные - Массив из Строка - штрихкоды из ответа
//
Процедура ОтметитьНеНайденоеВДалионе(НеНайденные) Экспорт

	Для Каждого Штрихкод Из НеНайденные Цикл

		Код = СокрЛП(Штрихкод);
		Менеджер = РегистрыСведений.ЭАрМ_ОчередьСозданияНоменклатуры.СоздатьМенеджерЗаписи();
		Менеджер.Штрихкод = Код;
		Менеджер.Прочитать();
		Если НЕ Менеджер.Выбран() ИЛИ СокрЛП(Менеджер.Статус) <> "ОжидаетДалион" Тогда
			Продолжить;
		КонецЕсли;

		Менеджер.Штрихкод       = Код;
		Менеджер.Статус         = "НеНайденоВДалионе";
		Менеджер.Ошибка         = "Далион не нашёл номенклатуру по штрихкоду";
		Менеджер.ДатаОбновления = ТекущаяДатаСеанса();
		Менеджер.Записать(Истина);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
