Функция СсылкаПоУИД(ИмяСправочника, УИД)

	Менеджер = Справочники[ИмяСправочника];
	Если ТипЗнч(УИД) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(УИД) Тогда
		Возврат Менеджер.ПустаяСсылка();
	КонецЕсли;
	Попытка
		Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
	Исключение
		Возврат Менеджер.ПустаяСсылка();
	КонецПопытки;
	Если НЕ ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Менеджер.ПустаяСсылка();
	КонецЕсли;
	Возврат Ссылка;

