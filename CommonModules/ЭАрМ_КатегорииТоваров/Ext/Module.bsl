// Категории товаров реестра товаров заказов (алкоголь, пиво, молочная
// продукция, фрукты, овощи, прочее) и приведение номенклатуры УТ к нужным
// видам номенклатуры и группам.
//
// Категория определяется так:
//   алкоголь и пиво - ЭАрМ_АлкогольЕГАИС (признак строки УПД, марки ЕГАИС,
//                     ТН ВЭД 2203-2208, слова наименования);
//   ТН ВЭД строки УПД: 0401-0406 молочная продукция, 0701-0714 овощи,
//                     0803-0810 фрукты;
//   слова наименования с исключениями (сок, джем, чипсы, шоколад...).
// Категория - подсказка для раскладки номенклатуры, на сверку не влияет.
//
// Вид номенклатуры и группа для каждой категории хранятся в ЭАрМ_НастройкиЭДО
// УИДами: ключи Номенклатура_Вид_<Код>, Номенклатура_Группа_<Код>. Заимствованных
// справочников в расширении нет - ссылки восстанавливаются по УИД.

#Область ПрограммныйИнтерфейс

// Категории в порядке показа.
//
// Возвращаемое значение:
//   Массив из Структура - Код, Представление
//
Функция Категории() Экспорт

	Категории = Новый Массив;
	Для Каждого Описание Из СтрРазделить(
		"Алкоголь:Алкоголь,Пиво:Пиво,Молочная:Молочная продукция,Фрукты:Фрукты,Овощи:Овощи,Прочее:Прочее", ",") Цикл
		Части = СтрРазделить(Описание, ":");
		Категории.Добавить(Новый Структура("Код, Представление", Части[0], Части[1]));
	КонецЦикла;
	Возврат Категории;

КонецФункции

// Категория товара.
//
// Параметры:
//   Наименование - Строка
//   КодТНВЭД     - Строка - из строки УПД, если есть
//   Алкоголь     - Строка - признак строки УПД (ЭАрМ_ТоварыЭТрН.Алкоголь)
//   Маркировки   - Строка, Массив - коды маркировки (марки ЕГАИС)
//
// Возвращаемое значение:
//   Строка - код категории, см. Категории
//
Функция КатегорияТовара(Знач Наименование, Знач КодТНВЭД = "", Знач Алкоголь = "", Знач Маркировки = "") Экспорт

	КодТНВЭД = ТолькоЦифры(КодТНВЭД);

	// Алкоголь: признак, посчитанный при загрузке УПД, иначе - заново
	Если ЗначениеЗаполнено(Алкоголь) Тогда
		Возврат ?(СтрНайти(Алкоголь, " 500 ") > 0 ИЛИ СтрНайти(Алкоголь, " 510 ") > 0
			ИЛИ СтрНайти(Алкоголь, " 520 ") > 0 ИЛИ СтрНайти(НРег(Алкоголь), "пиво") > 0
			ИЛИ Лев(КодТНВЭД, 4) = "2203", "Пиво", "Алкоголь");
	КонецЕсли;
	Сведения = ЭАрМ_АлкогольЕГАИС.СведенияАлкоголя(Новый Структура("Наименование, КодТНВЭД, Маркировки",
		Наименование, КодТНВЭД, Маркировки));
	Если Сведения.Алкоголь Тогда
		Возврат ?(Сведения.Пиво, "Пиво", "Алкоголь");
	КонецЕсли;

	// ТН ВЭД надёжнее слов
	Группа = Число("0" + Лев(КодТНВЭД, 4));
	Если Группа >= 401 И Группа <= 406 Тогда
		Возврат "Молочная";
	ИначеЕсли Группа >= 701 И Группа <= 714 Тогда
		Возврат "Овощи";
	ИначеЕсли Группа >= 803 И Группа <= 810 Тогда
		Возврат "Фрукты";
	КонецЕсли;

	Слова = СловаНаименования(Наименование);
	Если Слова.Количество() = 0 Тогда
		Возврат "Прочее";
	КонецЕсли;

	// Молочное проверяется первым: «йогурт с бананом» - молочная продукция
	Если ЕстьЛюбоеСлово(Слова, СловаМолочное())
		И НЕ ЕстьЛюбоеСлово(Слова, СловаНеМолочное()) Тогда
		Возврат "Молочная";
	КонецЕсли;
	Если НЕ ЕстьЛюбоеСлово(Слова, СловаПереработка()) Тогда
		Если ЕстьЛюбоеСлово(Слова, СловаОвощи()) Тогда
			Возврат "Овощи";
		КонецЕсли;
		Если ЕстьЛюбоеСлово(Слова, СловаФрукты()) Тогда
			Возврат "Фрукты";
		КонецЕсли;
	КонецЕсли;

	Возврат "Прочее";

КонецФункции

// ТН ВЭД и признак алкоголя строк УПД по номерам позиций.
//
// Параметры:
//   ИдентификаторУПД - Строка
//
// Возвращаемое значение:
//   Соответствие - Строка (номер позиции) -> Структура: КодТНВЭД, Алкоголь, Маркировки
//
Функция ПризнакиПозицийУПД(ИдентификаторУПД) Экспорт

	Результат = Новый Соответствие;
	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.КодТНВЭД КАК КодТНВЭД,
	|	Товары.Алкоголь КАК Алкоголь,
	|	Товары.Маркировки КАК Маркировки
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &ИдентификаторУПД
	|	И Товары.ИсточникТоваров = ""УПД""";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Формат(Выборка.НомерПозиции, "ЧГ=0"),
			Новый Структура("КодТНВЭД, Алкоголь, Маркировки",
				Выборка.КодТНВЭД, Выборка.Алкоголь, Выборка.Маркировки));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Категория строки реестра товаров. Признаки берутся из первой позиции УПД
// линии, у которой они есть.
//
// Параметры:
//   Наименование - Строка
//   ПозицииУПД   - Строка - номера позиций УПД через ";" (ЭАрМ_РеестрТоваровЗаказов.ПозицииУПД)
//   ПризнакиУПД  - Соответствие - см. ПризнакиПозицийУПД
//   МаркиЕГАИС   - Строка - марки ЕГАИС линии
//
// Возвращаемое значение:
//   Строка - код категории
//
Функция КатегорияЛинии(Наименование, ПозицииУПД, ПризнакиУПД, МаркиЕГАИС = "") Экспорт

	КодТНВЭД = "";
	Алкоголь = "";
	Маркировки = МаркиЕГАИС;
	Если ПризнакиУПД <> Неопределено Тогда
		Для Каждого Позиция Из СтрРазделить(СокрЛП(ПозицииУПД), ";", Ложь) Цикл
			Признаки = ПризнакиУПД.Получить(СокрЛП(Позиция));
			Если Признаки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(КодТНВЭД) Тогда
				КодТНВЭД = Признаки.КодТНВЭД;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Алкоголь) Тогда
				Алкоголь = Признаки.Алкоголь;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Маркировки) Тогда
				Маркировки = Признаки.Маркировки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Попытка
		Возврат КатегорияТовара(Наименование, КодТНВЭД, Алкоголь, Маркировки);
	Исключение
		Возврат "Прочее";
	КонецПопытки;

КонецФункции

// Пересчитывает категории у всех строк реестра товаров заказов - для строк,
// записанных до появления категорий или после смены правил.
//
// Возвращаемое значение:
//   Структура - Цепочек, Строк, Изменено (Число), ПоКатегориям (Соответствие код -> число)
//
Функция ПересчитатьКатегорииРеестра() Экспорт

	Итог = Новый Структура("Цепочек, Строк, Изменено, ПоКатегориям", 0, 0, 0, Новый Соответствие);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Реестр.ИдентификаторЗаказа КАК ИдентификаторЗаказа,
	|	Реестр.ИдентификаторПоступления КАК ИдентификаторПоступления
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр";
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Итог.Цепочек = Итог.Цепочек + 1;

		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить("РегистрСведений.ЭАрМ_РеестрТоваровЗаказов");
			Элемент.УстановитьЗначение("ИдентификаторЗаказа", Выборка.ИдентификаторЗаказа);
			Элемент.УстановитьЗначение("ИдентификаторПоступления", Выборка.ИдентификаторПоступления);
			Блокировка.Заблокировать();

			Набор = РегистрыСведений.ЭАрМ_РеестрТоваровЗаказов.СоздатьНаборЗаписей();
			Набор.Отбор.ИдентификаторЗаказа.Установить(Выборка.ИдентификаторЗаказа);
			Набор.Отбор.ИдентификаторПоступления.Установить(Выборка.ИдентификаторПоступления);
			Набор.Прочитать();

			ПризнакиПоУПД = Новый Соответствие;
			Изменен = Ложь;
			Для Каждого Запись Из Набор Цикл
				ПризнакиУПД = ПризнакиПоУПД.Получить(Запись.ИдентификаторУПД);
				Если ПризнакиУПД = Неопределено Тогда
					ПризнакиУПД = ПризнакиПозицийУПД(Запись.ИдентификаторУПД);
					ПризнакиПоУПД.Вставить(Запись.ИдентификаторУПД, ПризнакиУПД);
				КонецЕсли;
				Категория = КатегорияЛинии(Запись.Номенклатура, Запись.ПозицииУПД, ПризнакиУПД, Запись.МаркиЕГАИС);
				Итог.Строк = Итог.Строк + 1;
				Итог.ПоКатегориям.Вставить(Категория, ЧислоИлиНоль(Итог.ПоКатегориям.Получить(Категория)) + 1);
				Если Запись.Категория <> Категория Тогда
					Запись.Категория = Категория;
					Итог.Изменено = Итог.Изменено + 1;
					Изменен = Истина;
				КонецЕсли;
			КонецЦикла;

			Если Изменен Тогда
				Набор.Записать(Истина);
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("ЭАрМ.КатегорииТоваров", УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Возврат Итог;

КонецФункции

// Данные для страницы «Виды номенклатуры» формы настроек: категории с видом и
// группой по умолчанию и номенклатура УТ реестра товаров (найденная по
// штрихкоду) с текущими и предлагаемыми видом и группой.
//
// Параметры:
//   ТолькоСверенные - Булево - только строки реестра с результатом «Совпадает»
//
// Возвращаемое значение:
//   Структура:
//     * Категории    - ТаблицаЗначений - Категория, Представление, Строк, Номенклатур,
//                      ВидНоменклатуры, ВидНоменклатурыУИД, Группа, ГруппаУИД
//     * Номенклатура - ТаблицаЗначений - Категория, Наименование, Штрихкод, Номенклатура,
//                      НоменклатураУИД, ВидТекущий, ГруппаТекущая, ВидНовый, ВидНовыйУИД,
//                      ГруппаНовая, ГруппаНоваяУИД, Пометка, Состояние
//
Функция ДанныеВидовНоменклатуры(ТолькоСверенные = Истина) Экспорт

	Категории = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Категория,Представление,ВидНоменклатуры,ВидНоменклатурыУИД,Группа,ГруппаУИД", ",") Цикл
		Категории.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Категории.Колонки.Добавить("Строк", Новый ОписаниеТипов("Число"));
	Категории.Колонки.Добавить("Номенклатур", Новый ОписаниеТипов("Число"));

	Для Каждого Описание Из Категории() Цикл
		НоваяСтрока = Категории.Добавить();
		НоваяСтрока.Категория     = Описание.Код;
		НоваяСтрока.Представление = Описание.Представление;
		Вид = СсылкаПоУИД("ВидыНоменклатуры", НастройкаСтрокой("Номенклатура_Вид_" + Описание.Код));
		Если ЗначениеЗаполнено(Вид) Тогда
			НоваяСтрока.ВидНоменклатуры    = Строка(Вид);
			НоваяСтрока.ВидНоменклатурыУИД = Строка(Вид.УникальныйИдентификатор());
		КонецЕсли;
		Группа = СсылкаПоУИД("Номенклатура", НастройкаСтрокой("Номенклатура_Группа_" + Описание.Код));
		Если ЗначениеЗаполнено(Группа) Тогда
			НоваяСтрока.Группа    = Строка(Группа);
			НоваяСтрока.ГруппаУИД = Строка(Группа.УникальныйИдентификатор());
		КонецЕсли;
	КонецЦикла;
	Категории.Индексы.Добавить("Категория");

	Номенклатура = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Категория,Наименование,Штрихкод,Номенклатура,НоменклатураУИД,"
		+ "ВидТекущий,ГруппаТекущая,ВидНовый,ВидНовыйУИД,ГруппаНовая,ГруппаНоваяУИД,Состояние", ",") Цикл
		Номенклатура.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Номенклатура.Колонки.Добавить("Пометка", Новый ОписаниеТипов("Булево"));

	// Товары реестра по категориям
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Реестр.Категория КАК Категория,
	|	Реестр.Номенклатура КАК Наименование,
	|	Реестр.Штрихкод КАК Штрихкод,
	|	КОЛИЧЕСТВО(*) КАК Строк
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр
	|ГДЕ
	|	(НЕ &ТолькоСверенные
	|			ИЛИ Реестр.Результат = ""Совпадает"")
	|
	|СГРУППИРОВАТЬ ПО
	|	Реестр.Категория,
	|	Реестр.Номенклатура,
	|	Реестр.Штрихкод";
	Запрос.УстановитьПараметр("ТолькоСверенные", ТолькоСверенные = Истина);
	Товары = Запрос.Выполнить().Выгрузить();

	// Номенклатура УТ по штрихкодам (EAN-13 и GTIN-14 с ведущим нулём)
	ВариантыШтрихкодов = Новый Массив;
	Для Каждого Товар Из Товары Цикл
		Для Каждого Вариант Из ВариантыШтрихкода(Товар.Штрихкод) Цикл
			ВариантыШтрихкодов.Добавить(Вариант);
		КонецЦикла;
	КонецЦикла;
	НоменклатураПоШтрихкоду = НоменклатураУТПоШтрихкодам(ВариантыШтрихкодов);

	Уже = Новый Соответствие;
	Для Каждого Товар Из Товары Цикл

		Категория = ?(ЗначениеЗаполнено(Товар.Категория), Товар.Категория, "Прочее");
		СтрокаКатегории = Категории.Найти(Категория, "Категория");
		Если СтрокаКатегории = Неопределено Тогда
			СтрокаКатегории = Категории.Найти("Прочее", "Категория");
			Категория = "Прочее";
		КонецЕсли;
		СтрокаКатегории.Строк = СтрокаКатегории.Строк + Товар.Строк;

		ДанныеУТ = Неопределено;
		Для Каждого Вариант Из ВариантыШтрихкода(Товар.Штрихкод) Цикл
			ДанныеУТ = НоменклатураПоШтрихкоду.Получить(Вариант);
			Если ДанныеУТ <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Ключ = Категория + "|" + ?(ДанныеУТ = Неопределено, "Д:" + Товар.Наименование, ДанныеУТ.УИД);
		Если Уже.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уже.Вставить(Ключ, Истина);

		НоваяСтрока = Номенклатура.Добавить();
		НоваяСтрока.Категория    = Категория;
		НоваяСтрока.Наименование = Товар.Наименование;
		НоваяСтрока.Штрихкод     = Товар.Штрихкод;

		Если ДанныеУТ = Неопределено Тогда
			НоваяСтрока.Состояние = "нет в УТ по штрихкоду";
			Продолжить;
		КонецЕсли;

		СтрокаКатегории.Номенклатур = СтрокаКатегории.Номенклатур + 1;
		НоваяСтрока.Номенклатура    = ДанныеУТ.Представление;
		НоваяСтрока.НоменклатураУИД = ДанныеУТ.УИД;
		НоваяСтрока.ВидТекущий      = ДанныеУТ.Вид;
		НоваяСтрока.ГруппаТекущая   = ДанныеУТ.Группа;

		Изменения = Новый Массив;
		Если ЗначениеЗаполнено(СтрокаКатегории.ВидНоменклатурыУИД)
			И СтрокаКатегории.ВидНоменклатурыУИД <> ДанныеУТ.ВидУИД Тогда
			НоваяСтрока.ВидНовый    = СтрокаКатегории.ВидНоменклатуры;
			НоваяСтрока.ВидНовыйУИД = СтрокаКатегории.ВидНоменклатурыУИД;
			Изменения.Добавить("вид");
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаКатегории.ГруппаУИД)
			И СтрокаКатегории.ГруппаУИД <> ДанныеУТ.ГруппаУИД Тогда
			НоваяСтрока.ГруппаНовая    = СтрокаКатегории.Группа;
			НоваяСтрока.ГруппаНоваяУИД = СтрокаКатегории.ГруппаУИД;
			Изменения.Добавить("группу");
		КонецЕсли;

		Если Изменения.Количество() > 0 Тогда
			НоваяСтрока.Состояние = "сменить " + СтрСоединить(Изменения, " и ");
			НоваяСтрока.Пометка   = Истина;
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаКатегории.ВидНоменклатурыУИД) Тогда
			НоваяСтрока.Состояние = "вид для категории не задан";
		Иначе
			НоваяСтрока.Состояние = "вид и группа совпадают";
		КонецЕсли;

	КонецЦикла;

	Номенклатура.Сортировать("Категория, Состояние, Наименование");

	Возврат Новый Структура("Категории, Номенклатура", Категории, Номенклатура);

КонецФункции

// Сохраняет вид номенклатуры и группу по категориям.
//
// Параметры:
//   Строки - Массив из Структура - Категория, ВидНоменклатурыУИД, ГруппаУИД
//
Процедура СохранитьВидыКатегорий(Строки) Экспорт

	Настройки = Новый Структура;
	Для Каждого СтрокаВида Из Строки Цикл
		Настройки.Вставить("Номенклатура_Вид_" + СтрокаВида.Категория, СокрЛП(СтрокаВида.ВидНоменклатурыУИД));
		Настройки.Вставить("Номенклатура_Группа_" + СтрокаВида.Категория, СокрЛП(СтрокаВида.ГруппаУИД));
	КонецЦикла;
	ЭАрМ_НастройкиСервер.СохранитьВсеНастройки(Настройки);

КонецПроцедуры

// Меняет вид номенклатуры и группу (родителя) у отмеченной номенклатуры УТ.
// Смену вида проверяет и доделывает сама УТ при записи (реквизиты по новому
// виду); если вид сменить нельзя, запись отклоняется и попадает в сообщения.
//
// Параметры:
//   Строки - Массив из Структура - НоменклатураУИД, ВидНовыйУИД, ГруппаНоваяУИД
//
// Возвращаемое значение:
//   Структура - Изменено, Ошибок (Число), Сообщения (Массив из Строка)
//
Функция ПрименитьВидыИГруппы(Строки) Экспорт

	Итог = Новый Структура("Изменено, Ошибок, Сообщения", 0, 0, Новый Массив);

	Для Каждого СтрокаПрименения Из Строки Цикл

		Ссылка = СсылкаПоУИД("Номенклатура", СтрокаПрименения.НоменклатураУИД);
		Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект.ЭтоГруппа Тогда
				// У группы номенклатуры нет вида - такую строку не меняем
				Продолжить;
			КонецЕсли;

			Вид = СсылкаПоУИД("ВидыНоменклатуры", СтрокаПрименения.ВидНовыйУИД);
			Если ЗначениеЗаполнено(Вид) И Объект.ВидНоменклатуры <> Вид Тогда
				ПроверитьВидНоменклатуры(Вид);
				Объект.ВидНоменклатуры = Вид;
			КонецЕсли;

			Группа = СсылкаПоУИД("Номенклатура", СтрокаПрименения.ГруппаНоваяУИД);
			Если ЗначениеЗаполнено(Группа) И Объект.Родитель <> Группа Тогда
				Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Группа, "ЭтоГруппа") <> Истина Тогда
					ВызватьИсключение СтрШаблон("«%1» - не группа номенклатуры", Группа);
				КонецЕсли;
				Объект.Родитель = Группа;
			КонецЕсли;

			Если Объект.Модифицированность() Тогда
				// Причины отказа УТ (смена вида невозможна и т.п.) приходят сообщениями
				ПолучитьСообщенияПользователю(Истина);
				Объект.Записать();
				Итог.Изменено = Итог.Изменено + 1;
			КонецЕсли;

		Исключение
			Итог.Ошибок = Итог.Ошибок + 1;
			Если Итог.Сообщения.Количество() < 50 Тогда
				Итог.Сообщения.Добавить(Строка(Ссылка) + ": " + ТекстОшибкиЗаписи(ИнформацияОбОшибке()));
			КонецЕсли;
		КонецПопытки;

	КонецЦикла;

	Возврат Итог;

КонецФункции

// УИД, представление и признак группы выбранной ссылки - для форм без
// заимствованных справочников.
//
// Параметры:
//   Ссылка - СправочникСсылка.ВидыНоменклатуры, СправочникСсылка.Номенклатура
//
// Возвращаемое значение:
//   Структура - УИД, Представление (Строка), ЭтоГруппа (Булево); Неопределено - пустая ссылка
//
Функция ОписаниеСсылки(Ссылка) Экспорт

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЭтоГруппа = Ложь;
	Попытка
		ЭтоГруппа = (ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ЭтоГруппа") = Истина);
	Исключение
		ЭтоГруппа = Ложь;
	КонецПопытки;
	Возврат Новый Структура("УИД, Представление, ЭтоГруппа",
		Строка(Ссылка.УникальныйИдентификатор()), Строка(Ссылка), ЭтоГруппа);

КонецФункции

#КонецОбласти

#Область СервисНоменклатуры

// Доступен ли сервис 1С:Номенклатура, встроенный в УТ: функциональная опция,
// права и логин интернет-поддержки (ИТС).
//
// Возвращаемое значение:
//   Структура - Доступен (Булево), Текст (Строка)
//
Функция СостояниеСервисаНоменклатуры() Экспорт

	Результат = Новый Структура("Доступен, Текст", Ложь, "");
	Попытка
		Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьСервисРаботаСНоменклатурой") Тогда
			Результат.Текст = "1С:Номенклатура в УТ выключена: НСИ и администрирование → Настройки номенклатуры → 1С:Номенклатура (кнопка «1С:Номенклатура»)";
		ИначеЕсли НЕ РаботаСНоменклатурой.ДоступнаФункциональностьПодсистемы() Тогда
			Результат.Текст = "1С:Номенклатура: не подключена интернет-поддержка (логин и пароль ИТС) или нет прав";
		Иначе
			Результат.Доступен = Истина;
			Результат.Текст = "1С:Номенклатура доступна";
		КонецЕсли;
	Исключение
		Результат.Текст = "1С:Номенклатура: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Недостающая номенклатура УТ для товаров реестра: сначала 1С:Номенклатура
// (сервис ищет штрихкод в базе, в каталоге 1С:Номенклатура и в Национальном
// каталоге, сам создаёт вид по категории сервиса и карточку), затем - по
// желанию - карточка по виду и группе категории. Найденной и созданной
// номенклатуре без группы ставится группа категории, штрихкод регистрируется.
//
// Параметры:
//   Товары             - Массив из Структура - Штрихкод, Категория, Наименование
//   ИспользоватьСервис - Булево - искать в 1С:Номенклатура
//   СоздаватьСамим     - Булево - не найденное в сервисе создать по виду категории
//   ТокенГИСМТ         - Строка - для Национального каталога (маркируемые товары); можно пусто
//
// Возвращаемое значение:
//   Структура - Отправлено, ИзСервиса, Создано, НеНайдено, Ошибок (Число), Сообщения (Массив из Строка)
//
Функция СоздатьНедостающуюНоменклатуру(Товары, ИспользоватьСервис = Истина, СоздаватьСамим = Ложь,
	ТокенГИСМТ = "") Экспорт

	Итог = Новый Структура("Отправлено, ИзСервиса, Создано, НеНайдено, Ошибок, Сообщения",
		0, 0, 0, 0, 0, Новый Массив);

	Оставшиеся = Новый Массив;
	Для Каждого Товар Из Товары Цикл
		Если ЗначениеЗаполнено(НормализованныйШтрихкод(Товар.Штрихкод)) Тогда
			Оставшиеся.Добавить(Товар);
		Иначе
			ДобавитьСообщение(Итог, Товар.Наименование + ": нет штрихкода");
		КонецЕсли;
	КонецЦикла;

	// Все товары идут в 1С:Номенклатура: сервис даёт бренд, производителя, ОКПД2, вес.
	// Вид, выбранный вручную, сохраняем: карточке, которую создал сервис, его
	// возвращает ДоделатьНоменклатуру. Была ли карточка в УТ до сервиса - чтобы не
	// менять вид чужой, давно заведённой номенклатуре
	СВыбраннымВидом = Новый Массив;
	Для Каждого Товар Из Оставшиеся Цикл
		Товар.Вставить("БылаВУТ", ЗначениеЗаполнено(НоменклатураПоШтрихкоду(НормализованныйШтрихкод(Товар.Штрихкод))));
	КонецЦикла;

	Если ИспользоватьСервис И Оставшиеся.Количество() > 0 Тогда
		Доступность = СостояниеСервисаНоменклатуры();
		Если Доступность.Доступен Тогда
			Оставшиеся = ЗагрузитьИзСервиса(Оставшиеся, ТокенГИСМТ, Итог);
		Иначе
			ДобавитьСообщение(Итог, Доступность.Текст);
		КонецЕсли;
	КонецЕсли;

	Для Каждого Товар Из СВыбраннымВидом Цикл
		Оставшиеся.Добавить(Товар);
	КонецЦикла;

	Итог.НеНайдено = Оставшиеся.Количество();

	Если СоздаватьСамим Тогда
		Для Каждого Товар Из Оставшиеся Цикл
			Если СоздатьПоКатегории(Товар, Итог) Тогда
				Итог.Создано = Итог.Создано + 1;
				Итог.НеНайдено = Итог.НеНайдено - 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Отправляет товары в 1С:Номенклатура пачками по 100 штрихкодов.
//
// Возвращаемое значение:
//   Массив из Структура - товары, которые сервис не нашёл
//
Функция ЗагрузитьИзСервиса(Товары, ТокенГИСМТ, Итог)

	НеНайдено = Новый Массив;
	Пачка = Новый Соответствие;
	ТоварыПачки = Новый Соответствие;

	Для Каждого Товар Из Товары Цикл
		Код = НормализованныйШтрихкод(Товар.Штрихкод);
		Если ТоварыПачки.Получить(Код) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Пачка.Вставить(Код, Новый Структура);
		ТоварыПачки.Вставить(Код, Товар);
		Если Пачка.Количество() >= 100 Тогда
			ОтправитьПачку(Пачка, ТоварыПачки, ТокенГИСМТ, Итог, НеНайдено);
			Пачка = Новый Соответствие;
			ТоварыПачки = Новый Соответствие;
		КонецЕсли;
	КонецЦикла;
	Если Пачка.Количество() > 0 Тогда
		ОтправитьПачку(Пачка, ТоварыПачки, ТокенГИСМТ, Итог, НеНайдено);
	КонецЕсли;

	Возврат НеНайдено;

КонецФункции

Процедура ОтправитьПачку(Пачка, ТоварыПачки, ТокенГИСМТ, Итог, НеНайдено)

	Итог.Отправлено = Итог.Отправлено + Пачка.Количество();

	Попытка
		Параметры = РаботаСНоменклатуройКлиентСервер.НовыеПараметрыПолученияНоменклатурыСервисаПоШтрихкодам();
		Параметры.ТокенГИСМТ = ?(ТипЗнч(ТокенГИСМТ) = Тип("Строка"), ТокенГИСМТ, "");
		Ответ = РаботаСНоменклатурой.ЗагрузитьНоменклатуруСервисаПоШтрихкодам(Пачка, Параметры);
	Исключение
		Ответ = Новый Структура("Отказ, Ошибка, Результат", Истина,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Новый Соответствие);
		ЗаписьЖурналаРегистрации("ЭАрМ.КатегорииТоваров", УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Ответ.Отказ Тогда
		Итог.Ошибок = Итог.Ошибок + 1;
		ДобавитьСообщение(Итог, "1С:Номенклатура: " + Ответ.Ошибка);
	КонецЕсли;

	Для Каждого КлючИЗначение Из ТоварыПачки Цикл

		Код = КлючИЗначение.Ключ;
		Товар = КлючИЗначение.Значение;
		Описание = ?(ТипЗнч(Ответ.Результат) = Тип("Соответствие"), Ответ.Результат.Получить(Код), Неопределено);

		Номенклатура = Неопределено;
		Если Описание <> Неопределено И НЕ Описание.Отказ И ТипЗнч(Описание.Результат) = Тип("Структура") Тогда
			Описание.Результат.Свойство("Номенклатура", Номенклатура);
		КонецЕсли;

		Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") И ЗначениеЗаполнено(Номенклатура) Тогда
			Итог.ИзСервиса = Итог.ИзСервиса + 1;
			ДоделатьНоменклатуру(Номенклатура, Код, Товар.Категория, Итог, Товар);
		Иначе
			НеНайдено.Добавить(Товар);
			Если Описание <> Неопределено И ЗначениеЗаполнено(Описание.Ошибка) Тогда
				ДобавитьСообщение(Итог, СтрШаблон("%1 (%2): %3", Товар.Наименование, Код, Описание.Ошибка));
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Группа категории (если у номенклатуры группы нет) и штрихкод.
Процедура ДоделатьНоменклатуру(Номенклатура, Штрихкод, Категория, Итог, Товар = Неопределено)

	// Карточку создал сервис только что: вид - выбранный вручную, пустые реквизиты -
	// из УПД и Далиона (то, чего сервис не дал)
	Если Товар <> Неопределено И НЕ (Товар.Свойство("БылаВУТ") И Товар.БылаВУТ) Тогда
		ДоделатьКарточкуСервиса(Номенклатура, Товар, Итог);
	КонецЕсли;

	Попытка
		Группа = ГруппаКатегории(Категория);
		Если ЗначениеЗаполнено(Группа)
			И НЕ ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "Родитель")) Тогда
			Объект = Номенклатура.ПолучитьОбъект();
			Объект.Родитель = Группа;
			ПолучитьСообщенияПользователю(Истина);
			Объект.Записать();
		КонецЕсли;
		// Строка приходит коробками - упаковка и штрихкоды коробки (ЭАрМ_УпаковкиНоменклатуры)
		Если НЕ ЭАрМ_УпаковкиНоменклатуры.ОбеспечитьДляСуществующей(Номенклатура, Штрихкод, Итог) Тогда
			ЗаписатьШтрихкод(Номенклатура, Штрихкод, Итог);
		КонецЕсли;
		СопоставитьСЕГАИС(Номенклатура, Штрихкод, Категория, Итог);
	Исключение
		Итог.Ошибок = Итог.Ошибок + 1;
		ДобавитьСообщение(Итог, Строка(Номенклатура) + ": " + ТекстОшибкиЗаписи(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Карточка номенклатуры по виду и группе категории: наименование из реестра,
// реквизиты по виду, для алкоголя - вид продукции, крепость, объём
// (ЭАрМ_АлкогольЕГАИС). Пишется только после проверки заполнения.
//
// Возвращаемое значение:
//   Булево - создана
//
Функция СоздатьПоКатегории(Товар, Итог) Экспорт

	Категория = ?(ЗначениеЗаполнено(Товар.Категория), Товар.Категория, "Прочее");

	// Вид, выбранный человеком в окне переноса (ВидУИД), сильнее вида категории
	ВидУИД = ?(Товар.Свойство("ВидУИД"), СокрЛП(Товар.ВидУИД), "");
	ВидВыбран = ЗначениеЗаполнено(ВидУИД);
	Вид = СсылкаПоУИД("ВидыНоменклатуры",
		?(ВидВыбран, ВидУИД, НастройкаСтрокой("Номенклатура_Вид_" + Категория)));
	Если НЕ ЗначениеЗаполнено(Вид) Тогда
		ДобавитьСообщение(Итог, СтрШаблон("%1: для категории «%2» не выбран вид номенклатуры", Товар.Наименование, Категория));
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ПроверитьВидНоменклатуры(Вид);
	Исключение
		ДобавитьСообщение(Итог, Товар.Наименование + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Штрихкод = НормализованныйШтрихкод(Товар.Штрихкод);
	Если ЗначениеЗаполнено(НоменклатураПоШтрихкоду(Штрихкод)) Тогда
		ДобавитьСообщение(Итог, СтрШаблон("%1: штрихкод %2 уже есть в УТ", Товар.Наименование, Штрихкод));
		Возврат Ложь;
	КонецЕсли;

	// Товар добавляется - данные карточки запрашиваем у Далиона (запись в очередь
	// запросов; сам запрос уйдёт порцией и появится в регистре запросов к Далиону).
	// Карточка Далиона уже есть - повторно не запрашиваем.
	Если КарточкаДалионаПоШтрихкоду(ВариантыШтрихкода(Штрихкод)) = Неопределено Тогда
		ПоставитьВОчередьЗапросаДалиона(Штрихкод);
	КонецЕсли;

	// Что знают о товаре документы поставки: ТН ВЭД, НДС, артикул, ГТД, страна,
	// поставщик. Переданное в Товар (из формы) не затирается
	Поставка = ДанныеПоставкиТовара(Товар.Штрихкод);
	Для Каждого КлючЗначение Из Поставка Цикл
		Если НЕ Товар.Свойство(КлючЗначение.Ключ) ИЛИ НЕ ЗначениеЗаполнено(Товар[КлючЗначение.Ключ]) Тогда
			Товар.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Попытка

		Объект = Справочники.Номенклатура.СоздатьЭлемент();
		Объект.ВидНоменклатуры    = Вид;
		Объект.Наименование       = СокрЛП(Товар.Наименование);
		Объект.НаименованиеПолное = СокрЛП(Товар.Наименование);
		Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(Объект);

		// Штрихкод нашёлся в Далионе - наименования как у номенклатуры Далиона
		ПрименитьНаименованияДалиона(Объект, Товар);

		// Группа: папки номенклатуры Далиона, а без них - группа категории
		Группа = ГруппаПоПутиДалиона(Товар.ГруппыДалион, Итог);
		Если НЕ ЗначениеЗаполнено(Группа) Тогда
			Группа = ГруппаКатегории(Категория);
		КонецЕсли;
		Если ЗначениеЗаполнено(Группа) Тогда
			Объект.Родитель = Группа;
		КонецЕсли;

		// ТН ВЭД и ставка НДС из строк УПД (если их передали)
		ДополнитьКарточкуИзДанныхПоставки(Объект, Товар);

		Если Категория = "Алкоголь" ИЛИ Категория = "Пиво" Тогда
			Сведения = ЭАрМ_АлкогольЕГАИС.СведенияАлкоголя(Новый Структура("Наименование", Товар.Наименование));
			Сведения.Алкоголь = Истина;
			Сведения.Пиво = Сведения.Пиво ИЛИ Категория = "Пиво";
			ЭАрМ_АлкогольЕГАИС.ЗаполнитьНоменклатуру(Объект, Сведения);

			// Типовой подбор для алкоголя мог сменить вид: выбор человека сохраняем
			Если ВидВыбран И Объект.ВидНоменклатуры <> Вид Тогда
				Объект.ВидНоменклатуры = Вид;
				Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(Объект);
			КонецЕсли;
		КонецЕсли;

		// Вид номенклатуры не задал единицу хранения - берём её из документов поставки:
		// строка УПД с этим штрихкодом, затем строка приходной Далиона
		Если НЕ ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) Тогда
			Единица = ЕдиницаХраненияИзПоставки(Товар.Штрихкод);
			Если ЗначениеЗаполнено(Единица.Ссылка) Тогда
				Объект.ЕдиницаИзмерения = Единица.Ссылка;
			Иначе
				ДобавитьСообщение(Итог, СтрШаблон("%1: единица хранения не найдена%2",
					Товар.Наименование, ?(ЗначениеЗаполнено(Единица.Текст), " (" + Единица.Текст + ")",
						" ни в УПД, ни в приходной - задайте её в виде номенклатуры")));
			КонецЕсли;
		КонецЕсли;

		// Единица хранения известна - вес и объём (для штучного товара)
		ЗаполнитьВесИОбъем(Объект, Товар);

		// Строка приходит коробками: единица хранения - штука, коробка - упаковка
		ДанныеУпаковки = ЭАрМ_УпаковкиНоменклатуры.ДанныеУпаковкиТовара(Товар.Штрихкод);
		Подготовка = ЭАрМ_УпаковкиНоменклатуры.ПодготовитьКарточку(Объект, ДанныеУпаковки, Итог);

		Если НЕ КарточкаПроходитПроверку(Объект, Товар, Итог) Тогда
			Возврат Ложь;
		КонецЕсли;

		// Карточка и её штрихкод - вместе или никак: иначе при сбое записи
		// штрихкода остаётся карточка, которую повторный запуск создаст ещё раз
		НачатьТранзакцию();
		Попытка
			Объект.Записать();
			Если ДанныеУпаковки.Коэффициент > 1 Тогда
				ШтрихкодШтуки = ЭАрМ_УпаковкиНоменклатуры.ЗавершитьКарточку(
					Объект.Ссылка, Подготовка, ДанныеУпаковки, Итог);
				Если ЗначениеЗаполнено(ШтрихкодШтуки) Тогда
					Штрихкод = ШтрихкодШтуки;
				КонецЕсли;
			Иначе
				ЗаписатьШтрихкод(Объект.Ссылка, Штрихкод, Итог, Истина);
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;

		СопоставитьСЕГАИС(Объект.Ссылка, Штрихкод, Категория, Итог);

		// Поставщик: найти или создать через ФНС, строка «Номенклатуры контрагентов».
		// Флаг «СвязыватьСПоставщиком» = Ложь пропускает привязку (выбор в реестрах).
		Если НЕ Товар.Свойство("СвязыватьСПоставщиком") ИЛИ Товар.СвязыватьСПоставщиком Тогда
			Если ЗначениеЗаполнено(Товар.ИННПоставщика) ИЛИ ЗначениеЗаполнено(Товар.Поставщик) Тогда
				ЭАрМ_НоменклатураПоставщиковУТ.ПривязатьКарточкуКПоставщику(Новый Структура(
					"Штрихкод, КодТовараПоставщика, НаименованиеПоставщика, ИННПоставщика, Поставщик, НоменклатураДалион",
					Штрихкод, Товар.КодТовараПоставщика, Товар.НаименованиеПоставщика,
					Товар.ИННПоставщика, Товар.Поставщик, Объект.Наименование), Итог);
			Иначе
				ДобавитьСообщение(Итог, Объект.Наименование + ": поставщик в документах не найден, к поставщику не привязана");
			КонецЕсли;
		КонецЕсли;

		// Карточка создана. Если артикула нет (кода/артикула Далиона нет в документах) -
		// ставим в очередь, регламентное задание запросит Далион и дозаполнит артикул.
		Если НЕ ЗначениеЗаполнено(Объект.Артикул) Тогда
			ПоставитьВОчередьСоздания(Новый Структура(
				"Штрихкод, НаименованиеДалион, КодНоменклатурыДалион, Артикул, Категория, ИННПоставщика, Поставщик, КодТовараПоставщика",
				Штрихкод, СокрЛП(Товар.Наименование), "", "", Категория,
				?(Товар.Свойство("ИННПоставщика"), СокрЛП(Товар.ИННПоставщика), ""),
				?(Товар.Свойство("Поставщик"), СокрЛП(Товар.Поставщик), ""),
				?(Товар.Свойство("КодТовараПоставщика"), СокрЛП(Товар.КодТовараПоставщика), "")));
			ДобавитьСообщение(Итог, Объект.Наименование + ": без артикула - в очереди на запрос данных Далиона");
		КонецЕсли;

		// Что записалось в УТ - видно в итоге: карточка и её вид номенклатуры
		ЗаписанныйВид = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ВидНоменклатуры");
		Если ЗаписанныйВид <> Вид Тогда
			ДобавитьСообщение(Итог, СтрШаблон("%1: создана, но вид номенклатуры «%2» вместо выбранного «%3»",
				Объект.Наименование, ЗаписанныйВид, Вид));
		Иначе
			ДобавитьСообщение(Итог, СтрШаблон("%1: создана, вид «%2», штрихкод %3%4",
				Объект.Наименование, ЗаписанныйВид, Штрихкод, ОписаниеДополнительных(Товар)));
		КонецЕсли;

		Возврат Истина;

	Исключение
		Итог.Ошибок = Итог.Ошибок + 1;
		ДобавитьСообщение(Итог, Товар.Наименование + ": " + ТекстОшибкиЗаписи(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Единица хранения новой карточки по документам поставки.
//
// Сначала строка УПД с этим штрихкодом (НаимЕдИзм или код ОКЕИ из XML), затем строка
// приходной Далиона (nomenclature.unit: код и наименование единицы). Текст единицы
// переводится в код ОКЕИ, ссылка берётся из классификатора УТ
// (УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора).
// Коробка и упаковка дают штуку: коробка станет упаковкой карточки
// (ЭАрМ_УпаковкиНоменклатуры), а хранится товар штуками.
//
// Возвращаемое значение:
//   Структура - Ссылка (СправочникСсылка.УпаковкиЕдиницыИзмерения или пусто),
//               Текст (Строка) - что нашлось в документах, если не распознано
//
Функция ЕдиницаХраненияИзПоставки(Штрихкод) Экспорт

	Результат = Новый Структура("Ссылка, Текст", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка(), "");

	Варианты = ЭАрМ_ПодборНоменклатуры.ВариантыШтрихкода(Штрихкод);
	Если Варианты.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Тексты = Новый Массив;

	// 0. Базовая единица номенклатуры Далиона (код, затем наименование)
	КарточкаДалиона = КарточкаДалионаПоШтрихкоду(Варианты);
	Если КарточкаДалиона <> Неопределено Тогда
		ЕдиницаДалиона = ЭАрМ_Служебный.ЗначениеУзла(КарточкаДалиона, "unit");
		Для Каждого Имя Из СтрРазделить("code,name", ",") Цикл
			Значение = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(ЕдиницаДалиона, Имя, "")));
			Если ЗначениеЗаполнено(Значение) Тогда
				Тексты.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// 1. Строка УПД
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 5
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.Штрихкод В (&Штрихкоды)
	|	И Товары.ЕдиницаИзмерения <> """"";
	Запрос.УстановитьПараметр("Штрихкоды", Варианты);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Тексты.Добавить(СокрЛП(Выборка.ЕдиницаИзмерения));
	КонецЦикла;

	// 2. Строка приходной Далиона
	Для Каждого Текст Из ЕдиницыИзПриходовДалиона(Варианты) Цикл
		Тексты.Добавить(Текст);
	КонецЦикла;

	Для Каждого Текст Из Тексты Цикл
		КодОКЕИ = КодОКЕИЕдиницы(Текст);
		Если НЕ ЗначениеЗаполнено(КодОКЕИ) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Единицы = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора(КодОКЕИ);
			Единица = Единицы.Получить(КодОКЕИ);
		Исключение
			Единица = Неопределено;
		КонецПопытки;
		Если ЗначениеЗаполнено(Единица) Тогда
			Результат.Ссылка = Единица;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Если Тексты.Количество() > 0 Тогда
		Результат.Текст = СтрШаблон("в документах «%1», в классификаторе УТ не найдена", Тексты[0]);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Единицы строк приходных Далиона с этим штрихкодом: код, затем наименование.
//
Функция ЕдиницыИзПриходовДалиона(Варианты)

	Результат = Новый Массив;

	Искомые = Новый Соответствие;
	Для Каждого Вариант Из Варианты Цикл
		Искомые.Вставить(Вариант, Истина);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 5
	|	Реестр.ИдентификаторПоступления КАК Поступление,
	|	Реестр.ДатаОбновления КАК ДатаОбновления
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр
	|ГДЕ
	|	Реестр.Штрихкод В (&Штрихкоды)
	|	И Реестр.ИдентификаторПоступления <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОбновления УБЫВ";
	Запрос.УстановитьПараметр("Штрихкоды", Варианты);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Объект = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ПриходнаяНакладная", Выборка.Поступление);
		Если Объект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Товар Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "goods")) Цикл

			Номенклатура = ЭАрМ_Служебный.ЗначениеУзла(Товар, "nomenclature");
			Если НЕ СтрокаДалионаСоШтрихкодом(Товар, Номенклатура, Искомые) Тогда
				Продолжить;
			КонецЕсли;

			Единица = ЭАрМ_Служебный.ЗначениеУзла(Номенклатура, "unit");
			Если ТипЗнч(Единица) = Тип("Строка") Тогда
				Результат.Добавить(СокрЛП(Единица));
			Иначе
				Для Каждого Имя Из СтрРазделить("code,name", ",") Цикл
					Значение = ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Единица, Имя, ""));
					Если ЗначениеЗаполнено(Значение) Тогда
						Результат.Добавить(СокрЛП(Значение));
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Возврат Результат;

		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СтрокаДалионаСоШтрихкодом(Товар, Номенклатура, Искомые)

	Кандидаты = Новый Массив;
	Кандидаты.Добавить(ЭАрМ_Служебный.ЗначениеУзла(Товар, "barcode", ""));
	Кандидаты.Добавить(ЭАрМ_Служебный.ЗначениеУзла(Номенклатура, "barcode", ""));
	Для Каждого Узел Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Товар, "barcodes")) Цикл
		Кандидаты.Добавить(?(ТипЗнч(Узел) = Тип("Строка"), Узел, ЭАрМ_Служебный.ЗначениеУзла(Узел, "barcode", "")));
	КонецЦикла;
	Для Каждого Узел Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Номенклатура, "barcodes")) Цикл
		Кандидаты.Добавить(?(ТипЗнч(Узел) = Тип("Строка"), Узел, ЭАрМ_Служебный.ЗначениеУзла(Узел, "barcode", "")));
	КонецЦикла;

	Для Каждого Кандидат Из Кандидаты Цикл
		Для Каждого Вариант Из ЭАрМ_ПодборНоменклатуры.ВариантыШтрихкода(ЭАрМ_Служебный.СтрокойИлиПусто(Кандидат)) Цикл
			Если Искомые.Получить(Вариант) <> Неопределено Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Код ОКЕИ по тексту единицы из документа: цифры - уже код, иначе по наименованию.
// Пусто - не распознано.
//
Функция КодОКЕИЕдиницы(Знач Текст)

	Текст = НРег(СокрЛП(СтрЗаменить(Текст, ".", "")));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Если СтрДлина(ТолькоЦифры(Текст)) = СтрДлина(Текст) Тогда
		// Код коробки или упаковки - товар хранится штуками
		Если Текст = "8751" ИЛИ Текст = "778" Тогда
			Возврат "796";
		КонецЕсли;
		Возврат Текст;
	КонецЕсли;

	Соответствия = Новый Соответствие;
	Для Каждого Пара Из СтрРазделить(
		"шт:796,штук:796,штука:796,штуки:796,кор:796,коробка:796,уп:796,упак:796,упаковка:796,"
		+ "ящ:796,ящик:796,бл:796,блок:796,пач:796,пачка:796,"
		+ "кг:166,килограмм:166,г:163,гр:163,грамм:163,"
		+ "л:112,литр:112,дм3:112,мл:111,миллилитр:111,"
		+ "бут:868,бутылка:868,пар:715,пара:715,м:006,метр:006", ",") Цикл
		Части = СтрРазделить(Пара, ":");
		Соответствия.Вставить(Части[0], Части[1]);
	КонецЦикла;

	Код = Соответствия.Получить(Текст);
	Возврат ?(Код = Неопределено, "", Код);

КонецФункции

// Карточка, которую только что создал сервис 1С:Номенклатура: выбранный вид и
// реквизиты из УПД и Далиона, которые остались пустыми.
//
Процедура ДоделатьКарточкуСервиса(Номенклатура, Товар, Итог)

	Попытка

		Поставка = ДанныеПоставкиТовара(Товар.Штрихкод);
		Для Каждого КлючЗначение Из Поставка Цикл
			Если НЕ Товар.Свойство(КлючЗначение.Ключ) ИЛИ НЕ ЗначениеЗаполнено(Товар[КлючЗначение.Ключ]) Тогда
				Товар.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЕсли;
		КонецЦикла;

		Объект = Номенклатура.ПолучитьОбъект();

		Если Товар.Свойство("ВидУИД") И ЗначениеЗаполнено(Товар.ВидУИД) Тогда
			Вид = СсылкаПоУИД("ВидыНоменклатуры", Товар.ВидУИД);
			Если ЗначениеЗаполнено(Вид) И Объект.ВидНоменклатуры <> Вид Тогда
				Объект.ВидНоменклатуры = Вид;
				Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(Объект);
			КонецЕсли;
		КонецЕсли;

		ДополнитьКарточкуИзДанныхПоставки(Объект, Товар);

		Если НЕ Объект.Модифицированность() Тогда
			Возврат;
		КонецЕсли;
		Если НЕ КарточкаПроходитПроверку(Объект, Товар, Итог) Тогда
			Возврат;
		КонецЕсли;
		Объект.Записать();
		ДобавитьСообщение(Итог, СтрШаблон("%1: из 1С:Номенклатура, вид «%2»%3", Объект.Наименование,
			Объект.ВидНоменклатуры, ОписаниеДополнительных(Товар)));

	Исключение
		ДобавитьСообщение(Итог, Строка(Номенклатура) + ": не доделана - " + ТекстОшибкиЗаписи(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Проверка заполнения карточки. Не прошла - снимаем необязательные реквизиты,
// поставленные из документов (флаги, вес, объём, производитель, марка), и проверяем
// снова: без них карточка всё равно нужна.
//
// Возвращаемое значение:
//   Булево - карточку можно записывать
//
Функция КарточкаПроходитПроверку(Объект, Товар, Итог)

	ПолучитьСообщенияПользователю(Истина);
	Если Объект.ПроверитьЗаполнение() Тогда
		Возврат Истина;
	КонецЕсли;
	ПервыеТексты = ТекстыСообщений();

	Снятые = ОткатитьНеобязательные(Объект, Товар);
	Если Снятые.Количество() > 0 Тогда
		Если Объект.ПроверитьЗаполнение() Тогда
			ДобавитьСообщение(Итог, СтрШаблон("%1: не поставлены %2 - карточка с ними не проходит проверку (%3)",
				Объект.Наименование, СтрСоединить(Снятые, ", "), СтрСоединить(ПервыеТексты, "; ")));
			Возврат Истина;
		КонецЕсли;
		ПервыеТексты = ТекстыСообщений();
	КонецЕсли;

	ДобавитьСообщение(Итог, СтрШаблон("%1: не заполнено - %2", Объект.Наименование, СтрСоединить(ПервыеТексты, "; ")));
	Возврат Ложь;

КонецФункции

Функция ТекстыСообщений()

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	Возврат Тексты;

КонецФункции

// Ставит реквизит карточки по первому из имён, которое есть в справочнике УТ, если
// он пуст. Прежнее значение запоминается в Товар.НеобязательныеРеквизиты - для отката.
//
// Возвращаемое значение:
//   Строка - имя поставленного реквизита; пусто, если не поставлен
//
Функция УстановитьНеобязательный(Объект, Товар, ИменаКандидаты, Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Реквизиты = Объект.Метаданные().Реквизиты;
	Для Каждого Имя Из СтрРазделить(ИменаКандидаты, ",", Ложь) Цикл
		Имя = СокрЛП(Имя);
		Реквизит = Реквизиты.Найти(Имя);
		Если Реквизит = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект[Имя]) Тогда
			Возврат "";
		КонецЕсли;
		Попытка
			Прежнее = Объект[Имя];
			Объект[Имя] = Реквизит.Тип.ПривестиЗначение(Значение);
		Исключение
			Возврат "";
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(Объект[Имя]) Тогда
			Возврат "";
		КонецЕсли;
		Если НЕ Товар.Свойство("НеобязательныеРеквизиты") Тогда
			Товар.Вставить("НеобязательныеРеквизиты", Новый Соответствие);
		КонецЕсли;
		Если Товар.НеобязательныеРеквизиты.Получить(Имя) = Неопределено Тогда
			Товар.НеобязательныеРеквизиты.Вставить(Имя, Новый Структура("Прежнее", Прежнее));
		КонецЕсли;
		Возврат Имя;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ОткатитьНеобязательные(Объект, Товар)

	Снятые = Новый Массив;
	Если НЕ Товар.Свойство("НеобязательныеРеквизиты") Тогда
		Возврат Снятые;
	КонецЕсли;
	Для Каждого КлючЗначение Из Товар.НеобязательныеРеквизиты Цикл
		Объект[КлючЗначение.Ключ] = КлючЗначение.Значение.Прежнее;
		Снятые.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	Товар.НеобязательныеРеквизиты = Новый Соответствие;
	Возврат Снятые;

КонецФункции

Функция ОписаниеДополнительных(Товар)

	Если НЕ Товар.Свойство("НеобязательныеРеквизиты") ИЛИ Товар.НеобязательныеРеквизиты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Имена = Новый Массив;
	Для Каждого КлючЗначение Из Товар.НеобязательныеРеквизиты Цикл
		Имена.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	Возврат "; заполнено: " + СтрСоединить(Имена, ", ");

КонецФункции

// Дополнительные реквизиты карточки из документов поставки:
//   - прослеживаемый товар - есть РНПТ в УПД (тогда и учёт по ГТД/РНПТ);
//   - подакцизный - акциз в строке УПД, табак (ТН ВЭД 2402-2404) или алкоголь (2203-2208);
//   - вес и объём - из названия («0,5 л», «250 г»), иначе из реквизитов Далиона;
//   - производитель, марка (бренд) - из реквизитов Далиона, по названию в справочнике УТ.
// Имена реквизитов УТ - несколько вариантов: ставится тот, что есть в справочнике.
//
Процедура ЗаполнитьДополнительныеРеквизиты(Объект, Товар)

	Если Товар.Свойство("РНПТ") И ЗначениеЗаполнено(Товар.РНПТ) Тогда
		УстановитьНеобязательный(Объект, Товар, "ПрослеживаемыйТовар", Истина);
		УстановитьНеобязательный(Объект, Товар, "ВестиУчетПоГТД,ИмпортныйТовар", Истина);
	КонецЕсли;

	КодТНВЭД = ?(Товар.Свойство("КодТНВЭД"), ТолькоЦифры(Товар.КодТНВЭД), "");
	Акциз = Товар.Свойство("СуммаАкциза") И ТипЗнч(Товар.СуммаАкциза) = Тип("Число") И Товар.СуммаАкциза > 0;
	Если Акциз ИЛИ ЭтоПодакцизныйТНВЭД(КодТНВЭД) Тогда
		УстановитьНеобязательный(Объект, Товар, "ПодакцизныйТовар", Истина);
	КонецЕсли;

	РеквизитыДалион = ?(Товар.Свойство("РеквизитыДалион"), Товар.РеквизитыДалион, Неопределено);

	ЗаполнитьВесИОбъем(Объект, Товар);

	// Производитель и марка (бренд) - по названию из Далиона
	ИмяПроизводителя = СтрокаРеквизитаДалиона(РеквизитыДалион, "Производитель,Изготовитель");
	Если ЗначениеЗаполнено(ИмяПроизводителя) Тогда
		УстановитьНеобязательный(Объект, Товар, "Производитель",
			ЭлементПоНаименованию(Объект, "Производитель", ИмяПроизводителя, Истина));
		УстановитьНеобязательный(Объект, Товар, "ПроизводительИмпортерКонтрагент",
			ЭлементПоНаименованию(Объект, "ПроизводительИмпортерКонтрагент", ИмяПроизводителя, Ложь));
	КонецЕсли;
	ИмяМарки = СтрокаРеквизитаДалиона(РеквизитыДалион, "Марка,Бренд,ТорговаяМарка");
	Если ЗначениеЗаполнено(ИмяМарки) Тогда
		УстановитьНеобязательный(Объект, Товар, "Марка",
			ЭлементПоНаименованию(Объект, "Марка", ИмяМарки, Истина));
	КонецЕсли;

КонецПроцедуры

// Вес и объём единицы хранения - только у штучного товара: из названия, иначе из
// реквизитов Далиона. Вызывается и после заполнения единицы хранения.
//
Процедура ЗаполнитьВесИОбъем(Объект, Товар)

	РеквизитыДалион = ?(Товар.Свойство("РеквизитыДалион"), Товар.РеквизитыДалион, Неопределено);

	// Вес и объём единицы хранения - только для штучного товара
	Если ЕдиницаШтучная(Объект) Тогда
		Наименование = ?(Товар.Свойство("НаименованиеДалион") И ЗначениеЗаполнено(Товар.НаименованиеДалион),
			Товар.НаименованиеДалион, Объект.Наименование);
		Мера = ВесИОбъемИзНаименования(Наименование);
		Если Мера.Вес = 0 Тогда
			ВесДалиона = ЧислоРеквизитаДалиона(РеквизитыДалион, "ВесНетто,Вес,ВесЕдиницы");
			Если ВесДалиона > 0 Тогда
				Мера.Вес = ВесДалиона;
				Мера.ЕдиницаВеса = "166";
			КонецЕсли;
		КонецЕсли;
		Если Мера.Вес > 0 Тогда
			УстановитьМеру(Объект, Товар, "Вес", Мера.Вес, Мера.ЕдиницаВеса);
		КонецЕсли;
		Если Мера.Объем > 0 Тогда
			УстановитьМеру(Объект, Товар, "Объем", Мера.Объем, Мера.ЕдиницаОбъема);
		КонецЕсли;
	КонецЕсли;


КонецПроцедуры

// Вес или объём: Использовать, Числитель, Знаменатель = 1, ЕдиницаИзмерения по ОКЕИ.
//
Процедура УстановитьМеру(Объект, Товар, Мера, Значение, КодОКЕИ)

	Реквизиты = Объект.Метаданные().Реквизиты;
	Если Реквизиты.Найти(Мера + "Числитель") = Неопределено ИЛИ ЗначениеЗаполнено(Объект[Мера + "Числитель"]) Тогда
		Возврат;
	КонецЕсли;

	Единица = Неопределено;
	Попытка
		Единица = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора(КодОКЕИ).Получить(КодОКЕИ);
	Исключение
		Единица = Неопределено;
	КонецПопытки;
	Если НЕ ЗначениеЗаполнено(Единица) Тогда
		Возврат;
	КонецЕсли;

	УстановитьНеобязательный(Объект, Товар, Мера + "Использовать", Истина);
	УстановитьНеобязательный(Объект, Товар, Мера + "Числитель", Значение);
	УстановитьНеобязательный(Объект, Товар, Мера + "Знаменатель", 1);
	УстановитьНеобязательный(Объект, Товар, Мера + "ЕдиницаИзмерения", Единица);

КонецПроцедуры

Функция ЕдиницаШтучная(Объект)

	Если НЕ ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ЕдиницаИзмерения, "ТипИзмеряемойВеличины")
			= Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Вес и объём из наименования: число и единица рядом - «300 г», «0,26кг», «0.5 л», «500мл».
// Берётся первое вхождение каждого вида.
//
// Возвращаемое значение:
//   Структура - Вес, ЕдиницаВеса (код ОКЕИ), Объем, ЕдиницаОбъема (код ОКЕИ)
//
Функция ВесИОбъемИзНаименования(Знач Наименование) Экспорт

	Результат = Новый Структура("Вес, ЕдиницаВеса, Объем, ЕдиницаОбъема", 0, "", 0, "");
	Текст = НРег(СтрЗаменить(Наименование, ",", ".")) + " ";
	Длина = СтрДлина(Текст);
	Позиция = 1;

	Пока Позиция <= Длина Цикл

		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		// Число (с точкой)
		Начало = Позиция;
		Пока Позиция <= Длина И СтрНайти("0123456789.", Сред(Текст, Позиция, 1)) > 0 Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		ТекстЧисла = Сред(Текст, Начало, Позиция - Начало);
		// Число сразу после «*» или «х» - кратность упаковки, не мера
		Предыдущий = ?(Начало > 1, Сред(Текст, Начало - 1, 1), " ");

		// Пробелы, затем буквы единицы
		Пока Позиция <= Длина И Сред(Текст, Позиция, 1) = " " Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		НачалоЕдиницы = Позиция;
		Пока Позиция <= Длина И СтрНайти("абвгдеёжзийклмнопрстуфхцчшщъыьэюяabcdefghijklmnopqrstuvwxyz", Сред(Текст, Позиция, 1)) > 0 Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		Единица = Сред(Текст, НачалоЕдиницы, Позиция - НачалоЕдиницы);

		Если Предыдущий = "*" ИЛИ Предыдущий = "х" ИЛИ Предыдущий = "x" ИЛИ Предыдущий = "/" Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Число = Число(ТекстЧисла);
		Исключение
			Продолжить;
		КонецПопытки;
		Если Число <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Если Результат.Вес = 0 И (Единица = "г" ИЛИ Единица = "гр" ИЛИ Единица = "грамм") Тогда
			Результат.Вес = Число;
			Результат.ЕдиницаВеса = "163";
		ИначеЕсли Результат.Вес = 0 И (Единица = "кг" ИЛИ Единица = "килограмм") Тогда
			Результат.Вес = Число;
			Результат.ЕдиницаВеса = "166";
		ИначеЕсли Результат.Объем = 0 И (Единица = "л" ИЛИ Единица = "литр" ИЛИ Единица = "литра") Тогда
			Результат.Объем = Число;
			Результат.ЕдиницаОбъема = "112";
		ИначеЕсли Результат.Объем = 0 И Единица = "мл" Тогда
			Результат.Объем = Число;
			Результат.ЕдиницаОбъема = "111";
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЭтоПодакцизныйТНВЭД(КодТНВЭД)

	Если СтрДлина(КодТНВЭД) < 4 Тогда
		Возврат Ложь;
	КонецЕсли;
	Группа = Число(Лев(КодТНВЭД, 4));
	Возврат Группа >= 2402 И Группа <= 2404 ИЛИ Группа >= 2203 И Группа <= 2208;

КонецФункции

// Элемент ТН ВЭД: находим по коду, нет - заводим с кодом из УПД.
//
Функция ЭлементКлассификатораТНВЭД(КодТНВЭД)

	Попытка
		Ссылка = Справочники.КлассификаторТНВЭД.НайтиПоКоду(КодТНВЭД);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
		Элемент = Справочники.КлассификаторТНВЭД.СоздатьЭлемент();
		Элемент.Код = КодТНВЭД;
		Элемент.Наименование = "ТН ВЭД " + КодТНВЭД + " (из УПД)";
		Если Элемент.Метаданные().Реквизиты.Найти("НаименованиеПолное") <> Неопределено Тогда
			Элемент.НаименованиеПолное = Элемент.Наименование;
		КонецЕсли;
		Элемент.Записать();
		Возврат Элемент.Ссылка;
	Исключение
		ЗаписьЖурналаРегистрации("ЭАрМ.КатегорииТоваров", УровеньЖурналаРегистрации.Предупреждение,,,
			СтрШаблон("ТН ВЭД %1 не заведён: %2", КодТНВЭД, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Справочники.КлассификаторТНВЭД.ПустаяСсылка();
	КонецПопытки;

КонецФункции

// Элемент справочника, на который ссылается реквизит карточки, по наименованию.
// Создать - только если разрешено (производитель, марка); контрагента - только найти.
//
Функция ЭлементПоНаименованию(Объект, ИмяРеквизита, Наименование, Создавать)

	Реквизит = Объект.Метаданные().Реквизиты.Найти(ИмяРеквизита);
	Если Реквизит = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Тип Из Реквизит.Тип.Типы() Цикл
		МетаданныеТипа = Метаданные.НайтиПоТипу(Тип);
		Если МетаданныеТипа = Неопределено ИЛИ НЕ Метаданные.Справочники.Содержит(МетаданныеТипа) Тогда
			Продолжить;
		КонецЕсли;
		Менеджер = Справочники[МетаданныеТипа.Имя];
		Попытка
			Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
			Если ЗначениеЗаполнено(Ссылка) Тогда
				Возврат Ссылка;
			КонецЕсли;
			Если НЕ Создавать Тогда
				Возврат Неопределено;
			КонецЕсли;
			Элемент = Менеджер.СоздатьЭлемент();
			Элемент.Наименование = Лев(Наименование, МетаданныеТипа.ДлинаНаименования);
			Элемент.Записать();
			Возврат Элемент.Ссылка;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Строка из реквизитов Далиона по первому найденному имени: для ссылки - наименование.
//
Функция СтрокаРеквизитаДалиона(РеквизитыДалион, Имена)

	Если РеквизитыДалион = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		Значение = ПредставлениеРеквизитаДалиона(РеквизитыДалион, СокрЛП(Имя));
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ЧислоРеквизитаДалиона(РеквизитыДалион, Имена)

	Если РеквизитыДалион = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		Значение = ЭАрМ_Служебный.ЗначениеУзла(РеквизитыДалион, СокрЛП(Имя));
		Если ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

// Сведения о товаре из документов поставки по штрихкоду.
//
// Строка УПД (ЭАрМ_ТоварыЭТрН) и её шапка: ТН ВЭД, ставка НДС, артикул, код и
// наименование у поставщика, ГТД, страна, поставщик (ИНН, название). Нет УПД -
// поставщик и артикул из приходной Далиона.
//
// Возвращаемое значение:
//   Структура - КодТНВЭД, СтавкаНДС, Артикул, КодТовараПоставщика,
//               НаименованиеПоставщика, НомерГТД, СтранаПроисхождения,
//               ИННПоставщика, Поставщик (Строка)
//
Функция ДанныеПоставкиТовара(Штрихкод) Экспорт

	Результат = Новый Структура("КодТНВЭД, СтавкаНДС, Артикул, КодТовараПоставщика, НаименованиеПоставщика, НомерГТД, СтранаПроисхождения, ИННПоставщика, Поставщик, АртикулДалион, НаименованиеДалион, НаименованиеПолноеДалион, РНПТ, КодНоменклатурыДалион",
		"", "", "", "", "", "", "", "", "", "", "", "", "", "");
	Результат.Вставить("СуммаАкциза", 0);
	// Реквизиты номенклатуры Далиона как есть (attributes карточки)
	Результат.Вставить("РеквизитыДалион", Неопределено);
	// Папки номенклатуры Далиона от корня: имена групп
	Результат.Вставить("ГруппыДалион", Новый Массив);

	Варианты = ЭАрМ_ПодборНоменклатуры.ВариантыШтрихкода(Штрихкод);
	Если Варианты.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Самая полная строка УПД: с ГТД и ТН ВЭД - выше
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Товары.КодТНВЭД КАК КодТНВЭД,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.Артикул КАК Артикул,
	|	Товары.КодТовараПоставщика КАК КодТовараПоставщика,
	|	Товары.Наименование КАК НаименованиеПоставщика,
	|	Товары.НомерГТД КАК НомерГТД,
	|	Товары.СтранаПроисхождения КАК СтранаПроисхождения,
	|	Товары.РНПТ КАК РНПТ,
	|	Товары.СуммаАкциза КАК СуммаАкциза,
	|	ЕСТЬNULL(УПД.ИННКонтрагента, """") КАК ИННПоставщика,
	|	ЕСТЬNULL(УПД.Контрагент, """") КАК Поставщик
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО Товары.ИдентификаторСБИС = УПД.ИдентификаторСБИС
	|ГДЕ
	|	Товары.Штрихкод В (&Штрихкоды)
	|	И Товары.ИсточникТоваров = ""УПД""
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерГТД УБЫВ,
	|	Товары.КодТНВЭД УБЫВ";
	Запрос.УстановитьПараметр("Штрихкоды", Варианты);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Для Каждого Имя Из СтрРазделить("КодТНВЭД,СтавкаНДС,Артикул,КодТовараПоставщика,НаименованиеПоставщика,НомерГТД,СтранаПроисхождения,ИННПоставщика,Поставщик,РНПТ", ",") Цикл
			Результат[Имя] = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(Выборка[Имя]));
		КонецЦикла;
		Результат.СуммаАкциза = ?(ТипЗнч(Выборка.СуммаАкциза) = Тип("Число"), Выборка.СуммаАкциза, 0);
	КонецЕсли;

	// Номенклатура Далиона: сначала её карточка (пакет «Номенклатура»), затем строка
	// приходной - она же даёт поставщика и НДС, если УПД нет
	ЗаполнитьИзКарточкиДалиона(Результат, КарточкаДалионаПоШтрихкоду(Варианты));
	ДополнитьИзПриходаДалиона(Результат, Варианты);

	Возврат Результат;

КонецФункции

Процедура ДополнитьИзПриходаДалиона(Результат, Варианты)

	Искомые = Новый Соответствие;
	Для Каждого Вариант Из Варианты Цикл
		Искомые.Вставить(Вариант, Истина);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 5
	|	Реестр.ИдентификаторПоступления КАК Поступление,
	|	Реестр.ДатаОбновления КАК ДатаОбновления
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр
	|ГДЕ
	|	Реестр.Штрихкод В (&Штрихкоды)
	|	И Реестр.ИдентификаторПоступления <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОбновления УБЫВ";
	Запрос.УстановитьПараметр("Штрихкоды", Варианты);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Объект = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ПриходнаяНакладная", Выборка.Поступление);
		Если Объект = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Товар Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "goods")) Цикл

			Номенклатура = ЭАрМ_Служебный.ЗначениеУзла(Товар, "nomenclature");
			Если НЕ СтрокаДалионаСоШтрихкодом(Товар, Номенклатура, Искомые) Тогда
				Продолжить;
			КонецЕсли;

			// Артикул строки (item.article), затем то, что не дала карточка Далиона
			Если НЕ ЗначениеЗаполнено(Результат.АртикулДалион) Тогда
				Результат.АртикулДалион = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(
					ЭАрМ_Служебный.ЗначениеПоПути(Товар, "item.article", "")));
			КонецЕсли;
			ЗаполнитьИзКарточкиДалиона(Результат, Номенклатура);
			Если НЕ ЗначениеЗаполнено(Результат.ИННПоставщика) Тогда
				Контрагент = ЭАрМ_Служебный.ЗначениеУзла(Объект, "counterparty");
				Результат.ИННПоставщика = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(
					ЭАрМ_Служебный.ЗначениеУзла(Контрагент, "inn", "")));
				Результат.Поставщик = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(
					ЭАрМ_Служебный.ЗначениеУзла(Контрагент, "name", "")));
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Результат.СтавкаНДС) Тогда
				Результат.СтавкаНДС = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(
					ЭАрМ_Служебный.ЗначениеУзла(Товар, "vatRate", "")));
			КонецЕсли;
			Возврат;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Карточка номенклатуры Далиона по штрихкоду: uid из «Штрихкодов поставщиков»,
// сама карточка - из регистра пакетов (тип «НоменклатураДалион»).
//
// Возвращаемое значение:
//   Соответствие, Неопределено
//
Функция КарточкаДалионаПоШтрихкоду(Варианты) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 5
	|	Штрихкоды.ИдентификаторНоменклатурыДалион КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод В (&Штрихкоды)
	|	И Штрихкоды.ИдентификаторНоменклатурыДалион <> """"";
	Запрос.УстановитьПараметр("Штрихкоды", Варианты);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Карточка = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("НоменклатураДалион", СокрЛП(Выборка.Идентификатор));
		Если ТипЗнч(Карточка) = Тип("Соответствие") Тогда
			Возврат Карточка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Заполняет пустые поля данных поставки из карточки номенклатуры Далиона
// (пакет «Номенклатура» или узел nomenclature строки приходной): наименования,
// артикул, папки, единица, ставка НДС, страна.
//
Процедура ЗаполнитьИзКарточкиДалиона(Результат, Карточка)

	Если Карточка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Поля = Новый Соответствие;
	Поля.Вставить("НаименованиеДалион", "name");
	Поля.Вставить("НаименованиеПолноеДалион", "fullName");
	Поля.Вставить("АртикулДалион", "article");
	Поля.Вставить("КодНоменклатурыДалион", "code");
	Для Каждого Пара Из Поля Цикл
		Если НЕ ЗначениеЗаполнено(Результат[Пара.Ключ]) Тогда
			Результат[Пара.Ключ] = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(Карточка, Пара.Значение, "")));
		КонецЕсли;
	КонецЦикла;

	Если Результат.ГруппыДалион.Количество() = 0 Тогда
		Для Каждого Группа Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Карточка, "groups")) Цикл
			ИмяГруппы = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(
				?(ТипЗнч(Группа) = Тип("Строка"), Группа, ЭАрМ_Служебный.ЗначениеУзла(Группа, "name", ""))));
			Если ЗначениеЗаполнено(ИмяГруппы) Тогда
				Результат.ГруппыДалион.Добавить(ИмяГруппы);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Реквизиты карточки Далиона (attributes): ставка НДС и страна, если их нет в УПД;
	// целиком - для производителя, марки, веса и объёма
	Реквизиты = ЭАрМ_Служебный.ЗначениеУзла(Карточка, "attributes");
	Если Реквизиты <> Неопределено И Результат.РеквизитыДалион = Неопределено Тогда
		Результат.РеквизитыДалион = Реквизиты;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Результат.СтавкаНДС) Тогда
		Результат.СтавкаНДС = ПредставлениеРеквизитаДалиона(Реквизиты, "СтавкаНДС");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Результат.СтранаПроисхождения) Тогда
		Результат.СтранаПроисхождения = ПредставлениеРеквизитаДалиона(Реквизиты, "СтранаПроисхождения");
	КонецЕсли;

КонецПроцедуры

// Значение реквизита карточки Далиона строкой: для ссылки - её наименование.
//
Функция ПредставлениеРеквизитаДалиона(Реквизиты, Имя)

	Значение = ЭАрМ_Служебный.ЗначениеУзла(Реквизиты, Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("Структура") Тогда
		Значение = ЭАрМ_Служебный.ЗначениеУзла(Значение, "name", "");
	КонецЕсли;
	Возврат СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(Значение));

КонецФункции

// Наименование и полное наименование карточки - как у номенклатуры Далиона.
//
Процедура ПрименитьНаименованияДалиона(Объект, Данные)

	Если НЕ Данные.Свойство("НаименованиеДалион") ИЛИ НЕ ЗначениеЗаполнено(Данные.НаименованиеДалион) Тогда
		Возврат;
	КонецЕсли;

	Реквизиты = Метаданные.Справочники.Номенклатура;
	Объект.Наименование = Лев(Данные.НаименованиеДалион, Реквизиты.ДлинаНаименования);
	Полное = ?(ЗначениеЗаполнено(Данные.НаименованиеПолноеДалион), Данные.НаименованиеПолноеДалион, Данные.НаименованиеДалион);
	ДлинаПолного = Реквизиты.Реквизиты.НаименованиеПолное.Тип.КвалификаторыСтроки.Длина;
	Объект.НаименованиеПолное = ?(ДлинаПолного = 0, Полное, Лев(Полное, ДлинаПолного));

КонецПроцедуры

// Группа номенклатуры УТ по папкам Далиона: на каждом уровне ищется группа с тем же
// названием у того же родителя, нет - создаётся.
//
// Параметры:
//   Имена - Массив из Строка - от корня к родителю товара
//
// Возвращаемое значение:
//   СправочникСсылка.Номенклатура - пустая, если папок нет или создать не удалось
//
Функция ГруппаПоПутиДалиона(Имена, Итог)

	Родитель = Справочники.Номенклатура.ПустаяСсылка();
	Если ТипЗнч(Имена) <> Тип("Массив") Тогда
		Возврат Родитель;
	КонецЕсли;

	Попытка
		Для Каждого Имя Из Имена Цикл

			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Номенклатура.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Номенклатура.ЭтоГруппа
			|	И НЕ Номенклатура.ПометкаУдаления
			|	И Номенклатура.Родитель = &Родитель
			|	И Номенклатура.Наименование = &Наименование";
			Запрос.УстановитьПараметр("Родитель", Родитель);
			Запрос.УстановитьПараметр("Наименование", Имя);
			Выборка = Запрос.Выполнить().Выбрать();

			Если Выборка.Следующий() Тогда
				Родитель = Выборка.Ссылка;
			Иначе
				Группа = Справочники.Номенклатура.СоздатьГруппу();
				Группа.Наименование = Лев(Имя, Метаданные.Справочники.Номенклатура.ДлинаНаименования);
				Группа.Родитель = Родитель;
				Группа.Записать();
				Родитель = Группа.Ссылка;
				ДобавитьСообщение(Итог, СтрШаблон("создана группа номенклатуры «%1»", Имя));
			КонецЕсли;

		КонецЦикла;
	Исключение
		ДобавитьСообщение(Итог, СтрШаблон("Группа «%1» из Далиона не создана: %2",
			СтрСоединить(Имена, " / "), ТекстОшибкиЗаписи(ИнформацияОбОшибке())));
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецПопытки;

	Возврат Родитель;

КонецФункции

// Обновляет у существующих карточек УТ наименование, полное наименование и группу
// по номенклатуре Далиона с тем же штрихкодом.
//
// Параметры:
//   Товары - Массив из Структура - НоменклатураУИД, Штрихкод
//
// Возвращаемое значение:
//   Структура - Обновлено, БезДалиона, Ошибок (Число), Сообщения (Массив из Строка)
//
Функция ОбновитьИзДалиона(Товары) Экспорт

	Итог = Новый Структура("Обновлено, БезДалиона, Ошибок, Сообщения", 0, 0, 0, Новый Массив);

	Для Каждого Товар Из Товары Цикл

		Номенклатура = СсылкаПоУИД("Номенклатура", Товар.НоменклатураУИД);
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		Данные = ДанныеПоставкиТовара(Товар.Штрихкод);
		Если НЕ ЗначениеЗаполнено(Данные.НаименованиеДалион) И Данные.ГруппыДалион.Количество() = 0 Тогда
			Итог.БезДалиона = Итог.БезДалиона + 1;
			ДобавитьСообщение(Итог, СтрШаблон("%1: штрихкод %2 не найден в приходных Далиона", Номенклатура, Товар.Штрихкод));
			Продолжить;
		КонецЕсли;

		Попытка
			Объект = Номенклатура.ПолучитьОбъект();
			Было = Объект.Наименование;
			ПрименитьНаименованияДалиона(Объект, Данные);
			Группа = ГруппаПоПутиДалиона(Данные.ГруппыДалион, Итог);
			Если ЗначениеЗаполнено(Группа) Тогда
				Объект.Родитель = Группа;
			КонецЕсли;
			Если Объект.Модифицированность() Тогда
				ПолучитьСообщенияПользователю(Истина);
				Объект.Записать();
				Итог.Обновлено = Итог.Обновлено + 1;
				ДобавитьСообщение(Итог, СтрШаблон("%1 -> %2%3", Было, Объект.Наименование,
					?(ЗначениеЗаполнено(Группа), " (группа " + СтрСоединить(Данные.ГруппыДалион, " / ") + ")", "")));
			КонецЕсли;
		Исключение
			Итог.Ошибок = Итог.Ошибок + 1;
			ДобавитьСообщение(Итог, Строка(Номенклатура) + ": " + ТекстОшибкиЗаписи(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Возврат Итог;

КонецФункции

// Страна мира УТ по коду ОКСМ («156») или по наименованию («КИТАЙ»).
//
Функция СтранаМираПоКоду(Знач Значение)

	Значение = СокрЛП(Значение);
	Попытка
		Если СтрДлина(ТолькоЦифры(Значение)) = СтрДлина(Значение) Тогда
			Страна = Справочники.СтраныМира.НайтиПоКоду(Значение);
			Если НЕ ЗначениеЗаполнено(Страна) Тогда
				// Нет в справочнике - типовая загрузка из классификатора ОКСМ
				Страна = Справочники.СтраныМира.ПустаяСсылка();
				Данные = УправлениеКонтактнойИнформацией.СтранаМираПоКодуИлиНаименованию(Значение);
				Если ЗначениеЗаполнено(Данные) Тогда
					Страна = Данные;
				КонецЕсли;
			КонецЕсли;
		Иначе
			Страна = Справочники.СтраныМира.НайтиПоНаименованию(Значение);
		КонецЕсли;
	Исключение
		Страна = Справочники.СтраныМира.ПустаяСсылка();
	КонецПопытки;

	Возврат Страна;

КонецФункции

// Номер ДТ - в справочник НомераГТД (если его там ещё нет), со страной происхождения.
//
Процедура НомерГТДВСправочник(НомерГТД, КодСтраны)

	Номер = СокрЛП(НомерГТД);
	Попытка
		Если ЗначениеЗаполнено(Справочники.НомераГТД.НайтиПоКоду(Номер)) Тогда
			Возврат;
		КонецЕсли;
		Объект = Справочники.НомераГТД.СоздатьЭлемент();
		Объект.Код = Номер;
		Страна = СтранаМираПоКоду(КодСтраны);
		Если ЗначениеЗаполнено(Страна) И Объект.Метаданные().Реквизиты.Найти("СтранаПроисхождения") <> Неопределено Тогда
			Объект.СтранаПроисхождения = Страна;
		КонецЕсли;
		Объект.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("ЭАрМ.КатегорииТоваров", УровеньЖурналаРегистрации.Предупреждение,,,
			СтрШаблон("ГТД %1: %2", Номер, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

// Товары для создания карточки УТ по строке прихода Далиона (после ручной пары):
// первый настоящий штрихкод строки, которого ещё нет в УТ. Наименование - Далиона.
//
// Параметры:
//   Наименование - Строка - товар Далиона
//   Штрихкоды    - Строка - через «;» или «,»
//
// Возвращаемое значение:
//   Массив из Структура - Наименование, Штрихкод, Категория; пустой - создавать нечего
//
Функция ТоварыБезКарточкиУТ(Наименование, Штрихкоды) Экспорт

	Результат = Новый Массив;
	Для Каждого Часть Из СтрРазделить(СтрЗаменить(Штрихкоды, ",", ";"), ";", Ложь) Цикл
		Код = НормализованныйШтрихкод(Часть);
		Если СтрДлина(Код) < 8 Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(НоменклатураПоШтрихкоду(Код)) Тогда
			Возврат Результат;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Наименование, Штрихкод, Категория",
			Наименование, Код, КатегорияТовара(Наименование)));
		Возврат Результат;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Создаёт номенклатуру УТ для товаров с видами, выбранными в окне видов: тот же путь,
// что «Создать недостающую». Возвращает текст итога для пользователя.
//
// Параметры:
//   Товары      - Массив из Структура - Наименование, Штрихкод, Категория
//   ВидыТоваров - Массив из Структура - Штрихкод, ВидУИД
//
Функция СоздатьНоменклатуруСВидами(Товары, ВидыТоваров) Экспорт

	ВидыПоШтрихкоду = Новый Соответствие;
	Для Каждого ВидТовара Из ВидыТоваров Цикл
		ВидыПоШтрихкоду.Вставить(ВидТовара.Штрихкод, ВидТовара.ВидУИД);
	КонецЦикла;

	Создаваемые = Новый Массив;
	Для Каждого Товар Из Товары Цикл
		Копия = Новый Структура("Наименование, Штрихкод, Категория", Товар.Наименование, Товар.Штрихкод, Товар.Категория);
		ВидУИД = ВидыПоШтрихкоду.Получить(Товар.Штрихкод);
		Если ВидУИД <> Неопределено Тогда
			Копия.Вставить("ВидУИД", ВидУИД);
		КонецЕсли;
		Если Товар.Свойство("СвязыватьСПоставщиком") Тогда
			Копия.Вставить("СвязыватьСПоставщиком", Товар.СвязыватьСПоставщиком);
		КонецЕсли;
		Создаваемые.Добавить(Копия);
	КонецЦикла;

	Попытка
		Итог = СоздатьНедостающуюНоменклатуру(Создаваемые, Истина, Истина);
	Исключение
		Возврат "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Тексты = Новый Массив;
	Тексты.Добавить(СтрШаблон("Товаров: %1, создано: %2, найдено в 1С:Номенклатура: %3, не создано: %4, ошибок: %5",
		Создаваемые.Количество(), Итог.Создано, Итог.ИзСервиса, Итог.НеНайдено, Итог.Ошибок));
	Для Каждого Сообщение Из Итог.Сообщения Цикл
		Тексты.Добавить("• " + Сообщение);
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

// Вид номенклатуры категории из настроек: то, что окно переноса предлагает по умолчанию.
//
// Возвращаемое значение:
//   Структура - УИД, Представление (Строка); пустые, если вид категории не задан
//
Функция ВидКатегорииПоУмолчанию(Категория) Экспорт

	Результат = Новый Структура("УИД, Представление", "", "");

	Вид = СсылкаПоУИД("ВидыНоменклатуры",
		НастройкаСтрокой("Номенклатура_Вид_" + ?(ЗначениеЗаполнено(Категория), Категория, "Прочее")));
	Если ЗначениеЗаполнено(Вид) Тогда
		Результат.УИД = Строка(Вид.УникальныйИдентификатор());
		Результат.Представление = Строка(Вид);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Задан ли вид номенклатуры для категории (настройка формы «Настройки ЕГАИС и виды
// номенклатуры»). Без вида карточку по категории создать нельзя.
//
Функция ВидКатегорииЗадан(Категория) Экспорт

	Вид = СсылкаПоУИД("ВидыНоменклатуры",
		НастройкаСтрокой("Номенклатура_Вид_" + ?(ЗначениеЗаполнено(Категория), Категория, "Прочее")));

	Возврат ЗначениеЗаполнено(Вид);

КонецФункции

// Данные поставки в новую карточку: ТН ВЭД (если есть в классификаторе УТ) и ставка НДС
// (если однозначно находится). Остальное остаётся по виду номенклатуры.
//
Процедура ДополнитьКарточкуИзДанныхПоставки(Объект, Товар)

	КодТНВЭД = "";
	Если Товар.Свойство("КодТНВЭД") Тогда
		КодТНВЭД = ТолькоЦифры(Товар.КодТНВЭД);
	КонецЕсли;
	Если СтрДлина(КодТНВЭД) >= 4 Тогда
		Попытка
			Ссылка = Справочники.КлассификаторТНВЭД.НайтиПоКоду(КодТНВЭД);
			Если ЗначениеЗаполнено(Ссылка) Тогда
				Объект.КодТНВЭД = Ссылка;
			КонецЕсли;
		Исключение
			// Нет ТН ВЭД в классификаторе УТ - карточка получит значение по виду
		КонецПопытки;
	КонецЕсли;

	Если Товар.Свойство("СтавкаНДС") И ЗначениеЗаполнено(Товар.СтавкаНДС) Тогда
		Ставка = СтавкаНДСПоТексту(Товар.СтавкаНДС);
		Если ЗначениеЗаполнено(Ставка) Тогда
			Объект.СтавкаНДС = Ставка;
		КонецЕсли;
	КонецЕсли;

	// Реквизиты ниже есть не во всех редакциях УТ - пишем только существующие и пустые
	Реквизиты = Объект.Метаданные().Реквизиты;

	// Артикул: из номенклатуры Далиона, иначе из УПД, иначе код товара поставщика
	// (ДопСведТов/КодТов)
	Артикул = "";
	Для Каждого Имя Из СтрРазделить("АртикулДалион,КодНоменклатурыДалион,Артикул,КодТовараПоставщика", ",") Цикл
		Если Товар.Свойство(Имя) И ЗначениеЗаполнено(Товар[Имя]) Тогда
			Артикул = СокрЛП(Товар[Имя]);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Артикул)
		И Реквизиты.Найти("Артикул") <> Неопределено И НЕ ЗначениеЗаполнено(Объект.Артикул) Тогда
		ДлинаАртикула = Метаданные.Справочники.Номенклатура.Реквизиты.Артикул.Тип.КвалификаторыСтроки.Длина;
		Объект.Артикул = ?(ДлинаАртикула = 0, Артикул, Лев(Артикул, ДлинаАртикула));
	КонецЕсли;

	Если Товар.Свойство("СтранаПроисхождения") И ЗначениеЗаполнено(Товар.СтранаПроисхождения)
		И Реквизиты.Найти("СтранаПроисхождения") <> Неопределено
		И НЕ ЗначениеЗаполнено(Объект.СтранаПроисхождения) Тогда
		Страна = СтранаМираПоКоду(Товар.СтранаПроисхождения);
		Если ЗначениеЗаполнено(Страна) Тогда
			Объект.СтранаПроисхождения = Страна;
		КонецЕсли;
	КонецЕсли;

	// ТН ВЭД, которого нет в классификаторе УТ, - заводим элемент классификатора
	Если НЕ ЗначениеЗаполнено(Объект.КодТНВЭД) И СтрДлина(КодТНВЭД) = 10 Тогда
		Объект.КодТНВЭД = ЭлементКлассификатораТНВЭД(КодТНВЭД);
	КонецЕсли;

	// Флаги, вес, объём, производитель, марка - необязательные: если с ними карточка не
	// проходит проверку заполнения, СоздатьПоКатегории их снимет (ОткатитьНеобязательные)
	ЗаполнитьДополнительныеРеквизиты(Объект, Товар);

	// ГТД в УТ живёт в строках документов (справочник НомераГТД), у карточки -
	// признак учёта по ГТД. Есть номер ДТ в УПД - товар импортный, признак ставим,
	// а сам номер заводим в справочник, чтобы он подставлялся при поступлении
	Если Товар.Свойство("НомерГТД") И ЗначениеЗаполнено(Товар.НомерГТД) Тогда
		УстановитьНеобязательный(Объект, Товар, "ВестиУчетПоГТД,ИмпортныйТовар", Истина);
		НомерГТДВСправочник(Товар.НомерГТД, ?(Товар.Свойство("СтранаПроисхождения"), Товар.СтранаПроисхождения, ""));
	КонецЕсли;

КонецПроцедуры

// Ставка НДС УТ по тексту УПД: «20%», «10», «20/120». «Без НДС» и неясное - пусто
// (останется ставка по умолчанию вида).
//
Функция СтавкаНДСПоТексту(Текст)

	Пустая = Справочники.СтавкиНДС.ПустаяСсылка();

	Цифры = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		ИначеЕсли ЗначениеЗаполнено(Цифры) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(Цифры) Тогда
		Возврат Пустая;
	КонецЕсли;

	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Ставки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтавкиНДС КАК Ставки
		|ГДЕ
		|	Ставки.Ставка = &Ставка
		|	И НЕ Ставки.ПометкаУдаления
		|	И Ставки.КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ставки.Основная УБЫВ";
		Запрос.УстановитьПараметр("Ставка", Число(Цифры));

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;

	Исключение
		// Ставка не определилась - остаётся по умолчанию
	КонецПопытки;

	Возврат Пустая;

КонецФункции

// Регистрирует штрихкод за номенклатурой, если он свободен.
//
// Параметры:
//   ЗанятыйОшибка - Булево - штрихкод чужой номенклатуры - исключение (при создании
//                   карточки), иначе только сообщение
//
Процедура ЗаписатьШтрихкод(Номенклатура, Штрихкод, Итог, ЗанятыйОшибка = Ложь)

	Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат;
	КонецЕсли;
	Менеджер = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
	Менеджер.Штрихкод = Штрихкод;
	Менеджер.Прочитать();
	Если Менеджер.Выбран() Тогда
		Если Менеджер.Номенклатура <> Номенклатура Тогда
			Текст = СтрШаблон("Штрихкод %1 уже принадлежит «%2»", Штрихкод, Менеджер.Номенклатура);
			Если ЗанятыйОшибка Тогда
				ВызватьИсключение Текст;
			КонецЕсли;
			ДобавитьСообщение(Итог, Текст);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Менеджер.Штрихкод     = Штрихкод;
	Менеджер.Номенклатура = Номенклатура;
	Попытка
		Менеджер.Записать();
	Исключение
		Текст = СтрШаблон("Штрихкод %1 не записан: %2", Штрихкод,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Если ЗанятыйОшибка Тогда
			ВызватьИсключение Текст;
		КонецЕсли;
		ДобавитьСообщение(Итог, Текст);
	КонецПопытки;

КонецПроцедуры

// Фасад: делегирует в ЭАрМ_ПодборНоменклатуры (единая точка входа).
Функция НоменклатураПоШтрихкоду(Штрихкод)

	Возврат ЭАрМ_ПодборНоменклатуры.НоменклатураПоШтрихкоду(Штрихкод);

КонецФункции

// Истина, если хотя бы один штрихкод из списка (через «;» или «,») уже есть в УТ
// (регистр штрихкодов номенклатуры). Пустые и короткие коды пропускаются.
Функция ЕстьКарточкаУТПоШтрихкодам(Штрихкоды) Экспорт

	Для Каждого Часть Из СтрРазделить(СтрЗаменить(Строка(Штрихкоды), ",", ";"), ";", Ложь) Цикл
		Код = НормализованныйШтрихкод(Часть);
		Если СтрДлина(Код) >= 8 И ЗначениеЗаполнено(НоменклатураПоШтрихкоду(Код)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Первый штрихкод строки реестра цифрами; GTIN-14 с ведущим нулём - в EAN-13,
// как штрихкоды хранит УТ.
Функция НормализованныйШтрихкод(Штрихкод)

	Варианты = ВариантыШтрихкода(Штрихкод);
	Если Варианты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Код = ТолькоЦифры(Варианты[0]);
	Если СтрДлина(Код) = 14 И СтрНачинаетсяС(Код, "0") Тогда
		Код = Сред(Код, 2);
	КонецЕсли;
	Возврат Код;

КонецФункции

// Группа номенклатуры категории из настроек; пусто, если не выбрана, удалена
// или это не группа (УИД мог подменить не тот элемент).
Функция ГруппаКатегории(Категория)

	Группа = СсылкаПоУИД("Номенклатура", НастройкаСтрокой("Номенклатура_Группа_" + Категория));
	Если НЕ ЗначениеЗаполнено(Группа) Тогда
		Возврат Группа;
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Группа, "ЭтоГруппа, ПометкаУдаления");
	Если Реквизиты.ЭтоГруппа <> Истина ИЛИ Реквизиты.ПометкаУдаления = Истина Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	Возврат Группа;

КонецФункции

// Вид номенклатуры для записи: не группа видов и не помечен на удаление.
Процедура ПроверитьВидНоменклатуры(Вид)

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Вид, "ЭтоГруппа, ПометкаУдаления");
	Если Реквизиты.ЭтоГруппа = Истина Тогда
		ВызватьИсключение СтрШаблон("«%1» - группа видов номенклатуры, нужен вид", Вид);
	ИначеЕсли Реквизиты.ПометкаУдаления = Истина Тогда
		ВызватьИсключение СтрШаблон("вид номенклатуры «%1» помечен на удаление", Вид);
	КонецЕсли;

КонецПроцедуры

// Для алкоголя и пива - сопоставление с продукцией ЕГАИС по алкокоду строки УПД.
Процедура СопоставитьСЕГАИС(Номенклатура, Штрихкод, Категория, Итог)

	Если Категория <> "Алкоголь" И Категория <> "Пиво" Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Причина = ЭАрМ_АлкогольЕГАИС.СопоставитьСЕГАИСПоШтрихкоду(Номенклатура, Штрихкод);
	Исключение
		Причина = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если ЗначениеЗаполнено(Причина) Тогда
		ДобавитьСообщение(Итог, Строка(Номенклатура) + ", ЕГАИС: " + Причина);
	КонецЕсли;

КонецПроцедуры

// Текст исключения плюс сообщения, которыми УТ объясняет отказ записи
// («Не удалось записать…» само по себе причину не называет).
Функция ТекстОшибкиЗаписи(Информация)

	Тексты = Новый Массив;
	Тексты.Добавить(КраткоеПредставлениеОшибки(Информация));
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Если ЗначениеЗаполнено(Сообщение.Текст) И Тексты.Найти(Сообщение.Текст) = Неопределено Тогда
			Тексты.Добавить(Сообщение.Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Тексты, "; ");

КонецФункции

Процедура ДобавитьСообщение(Итог, Текст)

	Если Итог.Сообщения.Количество() < 100 Тогда
		Итог.Сообщения.Добавить(Текст);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоменклатураУТПоШтрихкодам(Штрихкоды)

	Результат = Новый Соответствие;
	Если Штрихкоды.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.Номенклатура КАК Номенклатура,
	|	Штрихкоды.Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	|	Штрихкоды.Номенклатура.Родитель КАК Родитель
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод В (&Штрихкоды)
	|	И Штрихкоды.Номенклатура ССЫЛКА Справочник.Номенклатура
	|	И НЕ Штрихкоды.Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("Штрихкоды", Штрихкоды);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.Получить(Выборка.Штрихкод) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Данные = Новый Структура("УИД, Представление, Вид, ВидУИД, Группа, ГруппаУИД",
			Строка(Выборка.Номенклатура.УникальныйИдентификатор()), Строка(Выборка.Номенклатура),
			Строка(Выборка.ВидНоменклатуры), "", Строка(Выборка.Родитель), "");
		Если ЗначениеЗаполнено(Выборка.ВидНоменклатуры) Тогда
			Данные.ВидУИД = Строка(Выборка.ВидНоменклатуры.УникальныйИдентификатор());
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Родитель) Тогда
			Данные.ГруппаУИД = Строка(Выборка.Родитель.УникальныйИдентификатор());
		КонецЕсли;
		Результат.Вставить(Выборка.Штрихкод, Данные);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Штрихкод реестра и его варианты: первый из нескольких через ";" или ",",
// EAN-13 <-> GTIN-14 с ведущим нулём.
// Фасад: делегирует в ЭАрМ_ПодборНоменклатуры (единая реализация).
Функция ВариантыШтрихкода(Штрихкод)

	Возврат ЭАрМ_ПодборНоменклатуры.ВариантыШтрихкода(Штрихкод);

