#Область ПрограммныйИнтерфейс

// Создаёт или обновляет заказ поставщику по пакету Далиона.
//
Процедура ЗаписатьЗаказ(Объект) Экспорт

	Идентификатор = СокрЛП(ЭАрМ_Служебный.ЗначениеУзла(Объект, "uid", ""));
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	ДокументОбъект = ДокументПоИдентификатору(
		"ЭАрМ_ЗаказПоставщику", Идентификатор, Документы.ЭАрМ_ЗаказПоставщику);

	ЗаполнитьШапкуИзПакета(ДокументОбъект, Объект, Ложь);
	ДокументОбъект.ИдентификаторЗаказа = Идентификатор;
	ДокументОбъект.ДатаПоставкиПлан = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(
		ЭАрМ_Служебный.ЗначениеУзла(Объект, "deliveryDate", ""));
	ЗаполнитьТоварыИзПакета(ДокументОбъект, Объект);
	ДополнитьИзЦепочки(ДокументОбъект, Идентификатор, "");
	ЗаписатьДокументЗакупки(ДокументОбъект);

КонецПроцедуры

// Создаёт или обновляет приходную накладную по пакету Далиона.
//
Процедура ЗаписатьПоступление(Объект) Экспорт

	Идентификатор = СокрЛП(ЭАрМ_Служебный.ЗначениеУзла(Объект, "uid", ""));
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	ДокументОбъект = ДокументПоИдентификатору(
		"ЭАрМ_ПриходнаяНакладная", Идентификатор, Документы.ЭАрМ_ПриходнаяНакладная);

	ЗаполнитьШапкуИзПакета(ДокументОбъект, Объект, Истина);
	ДокументОбъект.ИдентификаторПоступления = Идентификатор;
	ДокументОбъект.ВходящийНомер = "";
	Для Каждого ИмяНомера Из СтрРазделить("incomingNumber,edoIncomingNumber,invoiceNumber", ",") Цикл
		НомерВходящий = СокрЛП(ЭАрМ_Служебный.ЗначениеУзла(Объект, ИмяНомера, ""));
		Если ЗначениеЗаполнено(НомерВходящий) Тогда
			ДокументОбъект.ВходящийНомер = Лев(НомерВходящий, 50);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ДокументОбъект.НомерПриходной = ДокументОбъект.Номер;

	ИдентификаторЗаказа = СокрЛП(ЭАрМ_Служебный.ЗначениеПоПути(
		Объект, "basis.purchaseOrder.uid", ""));
	Если ЗначениеЗаполнено(ИдентификаторЗаказа) Тогда
		ДокументОбъект.ИдентификаторЗаказа = ИдентификаторЗаказа;
		ДокументОбъект.ДокументОснование = НайтиСсылкуПоИдентификатору(
			"ЭАрМ_ЗаказПоставщику", ИдентификаторЗаказа);
	КонецЕсли;

	ЗаполнитьТоварыИзПакета(ДокументОбъект, Объект);
	ДополнитьИзЦепочки(ДокументОбъект, ДокументОбъект.ИдентификаторЗаказа, Идентификатор);
	ЗаписатьДокументЗакупки(ДокументОбъект);

	ЭАрМ_ПриемПакетовДалион.Трасса(Идентификатор, СтрШаблон(
		"Документ «Приходная накладная» записан: %1, строк %2, УПД «%3»",
		Строка(ДокументОбъект.Ссылка), ДокументОбъект.Товары.Количество(), ДокументОбъект.НомерУПД));

	// Документ читаем обратно: он должен быть в базе с теми же строками товаров
	ЭАрМ_ПриемПакетовДалион.ПроверитьКоличествоЗапросом(Идентификатор,
		"документ «Приходная накладная» с uid Далиона " + Идентификатор + " (строки товаров)",
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Документ.ЭАрМ_ПриходнаяНакладная.Товары КАК Товары
		|ГДЕ
		|	Товары.Ссылка.ИдентификаторДалион = &Идентификатор",
		Новый Структура("Идентификатор", Идентификатор), ДокументОбъект.Товары.Количество());

	Если ЗначениеЗаполнено(ДокументОбъект.ИдентификаторЗаказа) Тогда
		ОбновитьПоЦепочке(ДокументОбъект.ИдентификаторЗаказа, Идентификатор);
	КонецЕсли;

КонецПроцедуры

// Подтягивает в заказ и приход номера УПД/УКД, проведение Далиона и статус сверки.
//
Процедура ОбновитьПоЦепочке(ИдентификаторЗаказа, ИдентификаторПоступления) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторЗаказа) И НЕ ЗначениеЗаполнено(ИдентификаторПоступления) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ИдентификаторЗаказа) Тогда
		ОбновитьДокументПоЦепочке("ЭАрМ_ЗаказПоставщику", ИдентификаторЗаказа,
			ИдентификаторЗаказа, ИдентификаторПоступления);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИдентификаторПоступления) Тогда
		ОбновитьДокументПоЦепочке("ЭАрМ_ПриходнаяНакладная", ИдентификаторПоступления,
			ИдентификаторЗаказа, ИдентификаторПоступления);
	КонецЕсли;

КонецПроцедуры

// Товары ЭТрН, товары УПД и расхождения УКД для страниц формы документа.
//
// Ключи ТоварыУПД и СведенияУПД добавлены позже остальных: прежние вызовы
// читают только свои ключи и продолжают работать как раньше.
//
Функция ДанныеСвязанныхСтраниц(ИдентификаторУПД, ИдентификаторЭТрН) Экспорт

	Результат = Новый Структура("ТоварыЭТрН, РасхожденияУКД",
		НоваяТаблицаТоваровЭТрН(), НоваяТаблицаРасхожденийУКД());
	Результат.Вставить("ТоварыУПД", НоваяТаблицаТоваровУПД());
	Результат.Вставить("СведенияУПД", "");

	ЗаполнитьСтраницуУПД(Результат, ИдентификаторУПД);

	Если ЗначениеЗаполнено(ИдентификаторЭТрН) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.Наименование КАК Номенклатура,
		|	Товары.КодНоменклатуры КАК Код,
		|	Товары.Артикул КАК Артикул,
		|	Товары.Штрихкод КАК Штрихкод,
		|	Товары.Количество КАК Количество,
		|	Товары.Цена КАК Цена,
		|	Товары.Сумма КАК Сумма
		|ИЗ
		|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
		|ГДЕ
		|	Товары.ИдентификаторСБИС = &Идентификатор
		|	И Товары.ИсточникТоваров = ""ЭТрН""
		|
		|УПОРЯДОЧИТЬ ПО
		|	Товары.НомерПозиции";
		Запрос.УстановитьПараметр("Идентификатор", ИдентификаторЭТрН);
		Результат.ТоварыЭТрН = Запрос.Выполнить().Выгрузить();
	КонецЕсли;

	Если ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	УКД.Номер КАК НомерУКД,
		|	УКД.ИдентификаторСБИС КАК ИдентификаторСБИС
		|ИЗ
		|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
		|ГДЕ
		|	УКД.ИдентификаторОснования = &ИдентификаторУПД
		|
		|УПОРЯДОЧИТЬ ПО
		|	УКД.Дата УБЫВ";
		Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);
		ВыборкаУКД = Запрос.Выполнить().Выбрать();

		НомерУКД = "";
		Если ВыборкаУКД.Следующий() Тогда
			НомерУКД = СокрЛП(ВыборкаУКД.НомерУКД);
		КонецЕсли;

		Цепочки = ЦепочкиПоУПД(ИдентификаторУПД);
		ЗапросСверки = Новый Запрос;
		Для Каждого КлючЦепочки Из Цепочки Цикл
			ЗапросСверки.Текст =
			"ВЫБРАТЬ
			|	Сверка.НаименованиеУПД КАК Номенклатура,
			|	Сверка.КоличествоУПД КАК КоличествоУпд,
			|	Сверка.КоличествоПоступления КАК КоличествоУкд,
			|	Сверка.ЦенаУПД КАК ЦенаУпд,
			|	Сверка.ЦенаПоступления КАК ЦенаУкд,
			|	Сверка.Комментарий КАК Расхождение
			|ИЗ
			|	РегистрСведений.ЭАрМ_СверкаТоваровЦепочки КАК Сверка
			|ГДЕ
			|	Сверка.ИдентификаторЗаказа = &Заказ
			|	И Сверка.ИдентификаторПоступления = &Поступление
			|	И Сверка.Результат <> ""Совпадает""
			|	И Сверка.Результат <> """"";
			ЗапросСверки.УстановитьПараметр("Заказ", КлючЦепочки.Заказ);
			ЗапросСверки.УстановитьПараметр("Поступление", КлючЦепочки.Поступление);
			Таблица = ЗапросСверки.Выполнить().Выгрузить();
			Для Каждого СтрокаСверки Из Таблица Цикл
				СтрокаУКД = Результат.РасхожденияУКД.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаУКД, СтрокаСверки);
				СтрокаУКД.НомерУКД = НомерУКД;
				Если НЕ ЗначениеЗаполнено(СтрокаУКД.Номенклатура) Тогда
					СтрокаУКД.Номенклатура = СтрокаСверки.Расхождение;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьШапкуИзПакета(ДокументОбъект, Объект, ЭтоПоступление)

	ДокументОбъект.ИдентификаторДалион = СокрЛП(ЭАрМ_Служебный.ЗначениеУзла(Объект, "uid", ""));
	ДокументОбъект.Номер = Лев(СокрЛП(ЭАрМ_Служебный.ЗначениеУзла(Объект, "number", "")), 50);
	ДатаДокумента = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Объект, "date", ""));
	Если ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДокументОбъект.Дата = ДатаДокумента;
	ИначеЕсли НЕ ЗначениеЗаполнено(ДокументОбъект.Дата) Тогда
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;

	Контрагент = ЭАрМ_Служебный.ЗначениеУзла(Объект, "counterparty");
	Если Контрагент = Неопределено Тогда
		Контрагент = ЭАрМ_Служебный.ЗначениеПоПути(Объект, "contract.counterparty");
	КонецЕсли;
	ДокументОбъект.Поставщик = Лев(СокрЛП(ЭАрМ_Служебный.ЗначениеУзла(Контрагент, "name", "")), 200);
	ДокументОбъект.ИННПоставщика = Лев(СокрЛП(ЭАрМ_Служебный.ЗначениеУзла(Контрагент, "inn", "")), 12);
	ДокументОбъект.СуммаДокумента = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
		ЭАрМ_Служебный.ЗначениеУзла(Объект, "amount", 0));

	Удален = ЭАрМ_Служебный.ЗначениеУзла(Объект, "deletionMark", Ложь) = Истина;
	ДокументОбъект.ПометкаУдаления = Удален;
	ДокументОбъект.ПроведенВДалион =
		ЭАрМ_Служебный.ЗначениеУзла(Объект, "posted", Ложь) = Истина И НЕ Удален;

	Если ЭтоПоступление Тогда
		ДокументОбъект.НомерПриходной = ДокументОбъект.Номер;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьТоварыИзПакета(ДокументОбъект, Объект)

	ДокументОбъект.Товары.Очистить();

	Для Каждого Товар Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "goods")) Цикл

		Номенклатура = ЭАрМ_Служебный.ЗначениеУзла(Товар, "nomenclature");
		Карточка     = ЭАрМ_Служебный.ЗначениеУзла(Товар, "item");
		Коэффициент  = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "ratio", 1));
		Если Коэффициент = 0 Тогда
			Коэффициент = 1;
		КонецЕсли;
		Количество = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "quantity", 0)) * Коэффициент;
		Сумма = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "amount", 0));

		СтрокаТовара = ДокументОбъект.Товары.Добавить();
		СтрокаТовара.Номенклатура = Лев(СокрЛП(ЭАрМ_Служебный.ЗначениеУзла(Номенклатура, "name", "")), 500);
		СтрокаТовара.Код          = Лев(СокрЛП(ЭАрМ_Служебный.ЗначениеУзла(Номенклатура, "code", "")), 50);
		СтрокаТовара.Артикул      = Лев(СокрЛП(ЭАрМ_Служебный.ЗначениеУзла(Карточка, "article", "")), 50);
		СтрокаТовара.Штрихкод     = Лев(СокрЛП(ЭАрМ_Служебный.ЗначениеУзла(Товар, "barcode",
			ЭАрМ_Служебный.ЗначениеУзла(Номенклатура, "barcode", ""))), 200);
		СтрокаТовара.Количество   = Количество;
		СтрокаТовара.Сумма        = Сумма;
		ЦенаПакета = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(ЭАрМ_Служебный.ЗначениеУзла(Товар, "price", 0));
		Если ЦенаПакета <> 0 Тогда
			СтрокаТовара.Цена = ЦенаПакета / Коэффициент;
		ИначеЕсли Количество <> 0 И Сумма <> 0 Тогда
			СтрокаТовара.Цена = Сумма / Количество;
		Иначе
			СтрокаТовара.Цена = 0;
		КонецЕсли;
		СтрокаТовара.СтавкаНДС = Лев(СокрЛП(ЭАрМ_Служебный.ЗначениеУзла(Товар, "vatRate", "")), 10);
		СтрокаТовара.СуммаНДС  = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "vatAmount", 0));

	КонецЦикла;

КонецПроцедуры

Процедура ДополнитьИзЦепочки(ДокументОбъект, ИдентификаторЗаказа, ИдентификаторПоступления)

	Цепочка = НайтиЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления);
	Если Цепочка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьИзЦепочки(ДокументОбъект, Цепочка);

КонецПроцедуры

Процедура ОбновитьДокументПоЦепочке(ИмяДокумента, ИдентификаторДалион, ИдентификаторЗаказа, ИдентификаторПоступления)

	Ссылка = НайтиСсылкуПоИдентификатору(ИмяДокумента, ИдентификаторДалион);
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Цепочка = НайтиЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления);
	Если Цепочка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	ЗаполнитьИзЦепочки(ДокументОбъект, Цепочка);
	ЗаписатьДокументЗакупки(ДокументОбъект);

КонецПроцедуры

Процедура ЗаполнитьИзЦепочки(ДокументОбъект, Цепочка)

	// Номер УПД - текущей УПД цепочки, а не входящий номер приходной Далиона:
	// после аннулирования УПД поставщик может прислать замену под другим номером,
	// а в приходной так и остаётся старый. Цепочка отпустила аннулированную и
	// ждёт замену - номер очищается, чтобы документ не показывал закрытую УПД
	Если ЗначениеЗаполнено(Цепочка.НомерУПД) Тогда
		ДокументОбъект.НомерУПД = Цепочка.НомерУПД;
	ИначеЕсли НЕ ЗначениеЗаполнено(Цепочка.ИдентификаторУПД)
		И ЗначениеЗаполнено(Цепочка.ИдентификаторУПДАннулированной) Тогда
		ДокументОбъект.НомерУПД = "";
	КонецЕсли;
	Если ЗначениеЗаполнено(Цепочка.НомерПоступления) Тогда
		ДокументОбъект.НомерПриходной = Цепочка.НомерПоступления;
	КонецЕсли;
	ДокументОбъект.ИдентификаторУПД = Цепочка.ИдентификаторУПД;
	ДокументОбъект.ИдентификаторЭТрН = Цепочка.ИдентификаторЭТрН;
	Если ЗначениеЗаполнено(Цепочка.ИдентификаторЗаказа)
		И НЕ СтрНачинаетсяС(Цепочка.ИдентификаторЗаказа, "ПН:") Тогда
		ДокументОбъект.ИдентификаторЗаказа = Цепочка.ИдентификаторЗаказа;
	КонецЕсли;
	Если ЗначениеЗаполнено(Цепочка.ИдентификаторПоступления) Тогда
		ДокументОбъект.ИдентификаторПоступления = Цепочка.ИдентификаторПоступления;
	КонецЕсли;
	Если Цепочка.ПроведеноПоступление Тогда
		ДокументОбъект.ПроведенВДалион = Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(Цепочка.ТекстРасхождений) Тогда
		ДокументОбъект.КомментарийСверки = Цепочка.ТекстРасхождений;
	КонецЕсли;

	ДокументОбъект.НомерУКД = НомерУКДПоУПД(Цепочка.ИдентификаторУПД);
	ДокументОбъект.СтатусОтображения = СтатусОтображения(Цепочка);

КонецПроцедуры

Функция СтатусОтображения(Цепочка)

	РеквизитыУПД = Неопределено;
	Если ЗначениеЗаполнено(Цепочка.ИдентификаторУПД) Тогда
		РеквизитыУПД = РеквизитыУПД(Цепочка.ИдентификаторУПД);
	КонецЕсли;

	// Утвержден - утверждение уже ушло в СБИС, Подписан - СБИС принял подпись.
	// Для панели оба означают одно: документ отправлен, решение по нему принято
	Если РеквизитыУПД <> Неопределено
		И (РеквизитыУПД.СтатусПодписания = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.Подписан
			ИЛИ РеквизитыУПД.СтатусПодписания = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.Утвержден) Тогда
		Возврат "Отправлен";
	КонецЕсли;

	Если Цепочка.ЕстьРасхождения Тогда
		Возврат "Не совпала";
	КонецЕсли;

	Если РеквизитыУПД <> Неопределено И РеквизитыУПД.ЕстьУКД Тогда
		Возврат "Внимание";
	КонецЕсли;

	Если РеквизитыУПД <> Неопределено
		И (РеквизитыУПД.КОтправке
			ИЛИ РеквизитыУПД.СтатусПодписания = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ГотовКОтправке) Тогда
		Возврат "Готов к отправке";
	КонецЕсли;

	Если ЗначениеЗаполнено(Цепочка.ИдентификаторУПД)
		И ЗначениеЗаполнено(Цепочка.ДатаСверки)
		И НЕ Цепочка.ЕстьРасхождения Тогда
		Возврат "Все сошлось";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция РеквизитыУПД(ИдентификаторУПД)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.СтатусПодписания КАК СтатусПодписания,
	|	УПД.КОтправке КАК КОтправке,
	|	УПД.ЕстьУКД КАК ЕстьУКД,
	|	УПД.РасхожденийНет КАК РасхожденийНет
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.ИдентификаторСБИС = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторУПД);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция НомерУКДПоУПД(ИдентификаторУПД)

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УКД.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.ИдентификаторОснования = &ИдентификаторУПД
	|
	|УПОРЯДОЧИТЬ ПО
	|	УКД.Дата УБЫВ";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Лев(СокрЛП(Выборка.Номер), 50);
	КонецЕсли;
	Возврат "";

КонецФункции

Функция НайтиЦепочку(ИдентификаторЗаказа, ИдентификаторПоступления)

	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(ИдентификаторПоступления) Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
