// Товары УПД и строка сведений о ней для страницы «УПД».
//
// Товары берутся из регистра ЭАрМ_ТоварыЭТрН - туда их кладёт загрузка реестра
// УПД (ИсточникТоваров = "УПД"). В СБИС форма документа не ходит: открытие
// приходной не должно зависеть от связи. Если товаров в регистре ещё нет,
// об этом говорит строка сведений.
//
Процедура ЗаполнитьСтраницуУПД(Результат, ИдентификаторУПД)

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Результат.СведенияУПД = НСтр("ru = 'УПД к этой приходной ещё не найдена в цепочке закупки.'");
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Наименование КАК Номенклатура,
	|	Товары.КодНоменклатуры КАК Код,
	|	Товары.Артикул КАК Артикул,
	|	Товары.Штрихкод КАК Штрихкод,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.НомерПозиции КАК НомерПозиции
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &ИдентификаторУПД
	|	И Товары.ИсточникТоваров = ""УПД""
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерПозиции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.Контрагент КАК Контрагент,
	|	УПД.Состояние КАК Состояние,
	|	УПД.СтатусПодписания КАК СтатусПодписания,
	|	УПД.РасхожденийНет КАК РасхожденийНет,
	|	УПД.ДатаЗагрузки КАК ДатаЗагрузки
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.ИдентификаторСБИС = &ИдентификаторУПД";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	Пакет = Запрос.ВыполнитьПакет();
	Результат.ТоварыУПД = Пакет[0].Выгрузить();

	Шапка = Пакет[1].Выбрать();
	Если НЕ Шапка.Следующий() Тогда
		Результат.СведенияУПД = НСтр("ru = 'УПД из цепочки закупки нет в реестре УПД - загрузите реестр из СБИС.'");
		Возврат;
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = 'УПД № %1 от %2, %3'"),
		СокрЛП(Шапка.Номер), Формат(Шапка.Дата, "ДЛФ=D"), СокрЛП(Шапка.Контрагент)));
	Если ЗначениеЗаполнено(Шапка.Состояние) Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'в СБИС: %1'"), СокрЛП(Шапка.Состояние)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Шапка.СтатусПодписания) Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'подпись: %1'"), Шапка.СтатусПодписания));
	КонецЕсли;
	Части.Добавить(?(Шапка.РасхожденийНет,
		НСтр("ru = 'с приходом сошлась'"), НСтр("ru = 'с приходом не сверена или не сошлась'")));
	Если ЗначениеЗаполнено(Шапка.ДатаЗагрузки) Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'загружена %1'"), Формат(Шапка.ДатаЗагрузки, "ДЛФ=DT")));
	КонецЕсли;

	Если Результат.ТоварыУПД.Количество() = 0 Тогда
		Части.Добавить(НСтр("ru = 'товары ещё не загружены из СБИС - откройте реестр УПД и загрузите их'"));
	КонецЕсли;

	Результат.СведенияУПД = СтрСоединить(Части, " · ");

КонецПроцедуры

