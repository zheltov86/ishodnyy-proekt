////////////////////////////////////////////////////////////////////////////////
// Клиент HTTP API службы «Монитор папок» (FolderMonitor, Desktop\ОбменЭдо_08_09_2026\МониторПапок).
//
// Монитор следит за папкой пакетов Далиона и ставит каждый готовый файл
// (дописанный, переставший меняться) в очередь. Приём берёт пачку из очереди
// (строки → «В работе»), разбирает и подтверждает: Подтвердить или ОтметитьОшибку.
// Строку, взятую и не подтверждённую (сеанс упал), монитор сам вернёт в очередь.
//
// Подключение - ЭАрМ_НастройкиСервер.НастройкиМонитора (форма настроек, вкладка Далион).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Монитор включён в настройках ЭДО.
//
Функция Включен() Экспорт

	Возврат ЭАрМ_НастройкиСервер.НастройкиМонитора().Включен;

КонецФункции

// Берёт пачку новых строк очереди и помечает их «В работе».
//
// Параметры:
//   Количество - Число - сколько строк взять
//   ИдПапки    - Число - папка монитора; 0 - из настроек (там 0 - все папки)
//
// Возвращаемое значение:
//   Массив из Структура - Id, FileId, FolderId, Path, Reason, Attempts, CreatedUtc
//
Функция ВзятьИзОчереди(Количество = 10, ИдПапки = 0) Экспорт

	Подключение = ЭАрМ_НастройкиСервер.НастройкиМонитора();
	Тело = Новый Структура("Consumer, Count", "1С УТ: " + ИмяКомпьютера(), Количество);
	Папка = ?(ИдПапки > 0, ИдПапки, Подключение.ИдПапки);
	Если Папка > 0 Тогда
		Тело.Вставить("FolderId", Папка);
	КонецЕсли;

	Результат = Вызвать(Подключение, "POST", "/api/queue/take", Тело);
	Возврат ?(ТипЗнч(Результат) = Тип("Массив"), Результат, Новый Массив);

КонецФункции

Процедура Подтвердить(ИдСтроки, Комментарий = "") Экспорт

	Вызвать(ЭАрМ_НастройкиСервер.НастройкиМонитора(), "POST",
		"/api/queue/" + Формат(ИдСтроки, "ЧГ=0") + "/done", Новый Структура("Text", Комментарий));

КонецПроцедуры

Процедура ОтметитьОшибку(ИдСтроки, ТекстОшибки) Экспорт

	Вызвать(ЭАрМ_НастройкиСервер.НастройкиМонитора(), "POST",
		"/api/queue/" + Формат(ИдСтроки, "ЧГ=0") + "/error", Новый Структура("Text", ТекстОшибки));

КонецПроцедуры

// Скачивает файл из монитора во временный файл.
//
// Возвращаемое значение:
//   Строка - путь временного файла; удалить после разбора
//
Функция ПолучитьФайлВоВременный(ИдФайла, Расширение = "json") Экспорт

	Ответ = ВыполнитьЗапрос(ЭАрМ_НастройкиСервер.НастройкиМонитора(), "GET",
		"/api/files/" + Формат(ИдФайла, "ЧГ=0") + "/content");
	ВременныйФайл = ПолучитьИмяВременногоФайла(Расширение);
	Ответ.ПолучитьТелоКакДвоичныеДанные().Записать(ВременныйФайл);
	Возврат ВременныйФайл;

КонецФункции

// Просит монитор убрать файл в свой архив (zip по дням) - когда сервер 1С
// не видит папку и не может перенести файл в archive сам.
//
Процедура ПереместитьВАрхив(ИдФайла) Экспорт

	Вызвать(ЭАрМ_НастройкиСервер.НастройкиМонитора(), "POST",
		"/api/files/" + Формат(ИдФайла, "ЧГ=0") + "/archive", Новый Структура);

КонецПроцедуры

// Сводка монитора: очередь по статусам, ошибки за день, состояние папок.
// Соответствие: состав полей сводки меняется вместе с монитором, обращение по ключу не падает.
//
Функция Статистика() Экспорт

	Возврат Вызвать(ЭАрМ_НастройкиСервер.НастройкиМонитора(), "GET", "/api/stats", , Истина);

КонецФункции

// Проверка подключения для формы настроек.
//
// Возвращаемое значение:
//   Структура - Успех, Текст
//
Функция ПроверитьПодключение() Экспорт

	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Подключение = ЭАрМ_НастройкиСервер.НастройкиМонитора();

	Попытка
		Сводка = Вызвать(Подключение, "GET", "/api/stats", , Истина);
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		Результат.Текст = СтрШаблон(НСтр("ru = 'Монитор %1:%2 не отвечает: %3'"),
			Подключение.Сервер, Формат(Подключение.Порт, "ЧГ=0"), ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения));
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "МониторПапок.ПроверитьПодключение", ОшибкаИсключения);
		Возврат Результат;
	КонецПопытки;

	ОписаниеПапок = Новый Массив;
	Для Каждого ПапкаМонитора Из Сводка["Folders"] Цикл
		ОписаниеПапок.Добавить(СтрШаблон("%1 = %2 (%3)", Формат(ПапкаМонитора["Id"], "ЧГ=0"), ПапкаМонитора["Name"], ПапкаМонитора["Path"]));
	КонецЦикла;
	Очередь = Сводка["Queue"];

	Результат.Успех = Истина;
	Результат.Текст = СтрШаблон(НСтр("ru = 'Монитор %1 v%2 отвечает. Очередь: новых %3, в работе %4, ошибок %5. Папки (Id = имя): %6'"),
		Сводка["Machine"], Сводка["Version"], Формат(Очередь["New"], "ЧН=0; ЧГ=0"), Формат(Очередь["InWork"], "ЧН=0; ЧГ=0"),
		Формат(Очередь["Error"], "ЧН=0; ЧГ=0"),
		?(ОписаниеПапок.Количество() = 0, НСтр("ru = 'нет - добавьте папку пакетов в мониторе'"), СтрСоединить(ОписаниеПапок, "; ")));
	Результат.Текст = Результат.Текст + Символы.ПС + СверкаПапок(Сводка["Folders"], Подключение.ИдПапки);
	Возврат Результат;

КонецФункции

// Папки монитора для списка выбора «Папка в мониторе». Короткий таймаут:
// вызывается при открытии формы настроек, недоступный монитор не должен её вешать.
//
// Возвращаемое значение:
//   Массив из Структура - Id, Name, Path, Enabled; пустой - монитор не ответил
//
Функция Папки() Экспорт

	Подключение = ЭАрМ_НастройкиСервер.НастройкиМонитора();
	Подключение.Таймаут = 5;
	Результат = Новый Массив;
	Попытка
		Ответ = Вызвать(Подключение, "GET", "/api/folders", , Истина);
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "МониторПапок.Папки (список папок не получен)", ОшибкаИсключения);
		Возврат Результат;
	КонецПопытки;
	Для Каждого ПапкаМонитора Из Ответ Цикл
		Результат.Добавить(Новый Структура("Id, Name, Path, Enabled",
			ПапкаМонитора["Id"], ПапкаМонитора["Name"], ПапкаМонитора["Path"], ПапкаМонитора["Enabled"] = Истина));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Совпадает ли папка, которую монитор отдаёт в очередь, с папкой пакетов из настроек 1С.
// Буква сетевого диска (Z:) и UNC-путь (\\сервер\папка) могут быть одной папкой -
// сравнить их 1С не может, поэтому при расхождении - предупреждение с обоими путями.
//
Функция СверкаПапок(ПапкиМонитора, ИдПапки)

	КаталогПакетов = СокрЛП(ЭАрМ_НастройкиСервер.НастройкиЦепочки().КаталогПакетов);
	Если ИдПапки = 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'Папка в мониторе не выбрана (0 - все папки). Папка пакетов в 1С: %1'"), КаталогПакетов);
	КонецЕсли;

	Для Каждого ПапкаМонитора Из ПапкиМонитора Цикл
		Если ПапкаМонитора["Id"] <> ИдПапки Тогда
			Продолжить;
		КонецЕсли;
		ПутьМонитора = СокрЛП(ПапкаМонитора["Path"]);
		Если НРег(СтрЗаменить(ПутьМонитора + "\", "\\", "\")) = НРег(СтрЗаменить(КаталогПакетов + "\", "\\", "\")) Тогда
			Возврат СтрШаблон(НСтр("ru = 'Папка монитора %1 совпадает с папкой пакетов 1С: %2'"), Формат(ИдПапки, "ЧГ=0"), ПутьМонитора);
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'ВНИМАНИЕ: монитор следит за %1, а 1С читает пакеты из %2. Если это не одна папка (Z: = \\сервер\папка), выберите в мониторе папку пакетов 1С - иначе очередь будет не та.'"),
			ПутьМонитора, КаталогПакетов);
	КонецЦикла;

	Возврат СтрШаблон(НСтр("ru = 'ВНИМАНИЕ: в мониторе нет папки с Id %1 - выберите папку из списка'"), Формат(ИдПапки, "ЧГ=0"));

КонецФункции
Функция ВыполнитьЗапрос(Подключение, Метод, Путь, Тело = Неопределено)

	Соединение = Новый HTTPСоединение(Подключение.Сервер, Подключение.Порт, , , , Подключение.Таймаут);
	Запрос = Новый HTTPЗапрос(Путь);
	Запрос.Заголовки.Вставить("X-Api-Key", Подключение.Ключ);
	// Кириллица в заголовке - ответ 400: значение кодируется, монитор раскодирует
	Запрос.Заголовки.Вставить("X-Actor", КодироватьСтроку("1С УТ: " + ИмяПользователя(), СпособКодированияСтроки.КодировкаURL));
	Если Тело <> Неопределено Тогда
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(ВJSON(Тело), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Если Ответ.КодСостояния >= 300 Тогда
		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Попытка
			Разобрано = ИзJSON(ТекстОтвета);
			Если ТипЗнч(Разобрано) = Тип("Структура") И Разобрано.Свойство("Error") Тогда
				ТекстОтвета = Разобрано.Error;
			КонецЕсли;
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			// Ответ не JSON (например, страница прокси) - в тексте ошибки оставляем как есть
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "МониторПапок: ответ " + Путь + " не JSON", ОшибкаИсключения);
		КонецПопытки;
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Монитор папок: %1 %2 - код %3: %4'"), Метод, Путь, Ответ.КодСостояния, ТекстОтвета);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

Функция Вызвать(Подключение, Метод, Путь, Тело = Неопределено, ВСоответствие = Ложь)

	Ответ = ВыполнитьЗапрос(Подключение, Метод, Путь, Тело);
	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Возврат ?(ПустаяСтрока(ТекстОтвета), Неопределено, ИзJSON(ТекстОтвета, ВСоответствие));

КонецФункции

Функция ВJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Функция ИзJSON(Текст, ВСоответствие = Ложь)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, ВСоответствие);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

#КонецОбласти
