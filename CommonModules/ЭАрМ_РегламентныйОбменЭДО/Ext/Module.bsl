////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_РегламентныйОбменЭДО: получение документов ЭДО и выгрузка их в Далион.
//
// Единственная точка, откуда запускается обмен. Раньше документы забирала
// внешняя обработка по нажатию кнопки, а результат жил в таблице формы и
// пропадал вместе с ней. Теперь реестры лежат в регистрах сведений, а забирает
// их регламентное задание ЭАрМ_РегламентноеЗадание.
//
// Порядок одного сеанса:
//   1. Проверка настроек и признака "обмен включён".
//   2. Одна авторизация в СБИС на весь сеанс (сессия хранится в настройках).
//   3. Чтение реестра ЭТрН постранично -> регистр ЭАрМ_РеестрЭТрН.
//   4. Чтение реестра УПД постранично  -> регистр ЭАрМ_УПД_Входящий.
//   5. Выгрузка в Далион тех ЭТрН, что ещё не выгружены -> регистр товаров,
//      файл на FTP или в папку, отметка о выгрузке.
//   6. Разбор ответов Далиона (подтверждения) и повтор неудачных отправок.
//
// Каждый шаг доступен и вручную - из форм регистров, см. формы списка
// ЭАрМ_РеестрЭТрН и ЭАрМ_НастройкиЭДО.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Точка входа регламентного задания ЭАрМ_ОбновлениеРеестровЭДО.
//
// Наполнение регистров - единственное место, откуда идут запросы в СБИС.
// Всё остальное работает по уже загруженным данным.
//
Процедура ОбновитьРеестрыПоРасписанию() Экспорт

	Если ЭАрМ_НастройкиСервер.ФоновыеЗаданияОтключены() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
			Метаданные.РегламентныеЗадания.ЭАрМ_ОбновлениеРеестровЭДО);
	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("ОбновитьРеестрыПоРасписанию",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ОбновитьРеестры();

	// Алкоголь ЕГАИС: классификатор видов (один раз, если пуст) и признак алкоголя
	// строк УПД. Работает и без доступного СБИС - по уже загруженным регистрам.
	Попытка
		ЭАрМ_АлкогольЕГАИС.ОбеспечитьКлассификаторВидов();
	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("ОбеспечитьКлассификаторВидов",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		ИтогАлкоголь = ЭАрМ_АлкогольЕГАИС.ПересчитатьАлкогольТоваровУПД();
		Если ИтогАлкоголь.Изменено > 0 Тогда
			ЗаписатьВЖурнал("", "ПересчётАлкоголяУПД", Истина, СтрШаблон(
				НСтр("ru = 'Алкоголь УПД: строк %1, алкоголь %2, изменено %3'"),
				ИтогАлкоголь.Строк, ИтогАлкоголь.Алкоголь, ИтогАлкоголь.Изменено));
		КонецЕсли;
	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("ПересчётАлкоголяУПД",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// Сводка реестра УПД (суммы, статус приходной, ЭТрН отправлена) за 7 дней:
	// её читает форма реестра вместо пяти соединений на каждое обновление
	Попытка
		ОбновитьСводкуРеестраУПД(, НачалоДня(ТекущаяДатаСеанса()) - 7 * 86400);
	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("ОбновитьСводкуРеестраУПД",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// Бухгалтерия - и когда СБИС недоступен: подписанные УПД уже в реестре
	ОбменСБухгалтерией();

КонецПроцедуры

// Наполняет регистры данными из СБИС: сначала ЭТрН, потом УПД.
//
// Порядок не случаен. Сопоставление ищет УПД по номеру ЭТрН, поэтому к
// моменту, когда УПД ложится в регистр, реестр ЭТрН уже должен быть на
// месте - иначе первый же проход сопоставления ничего не найдёт.
//
// Что делает каждый шаг:
//   1. Реестр ЭТрН -> ЭАрМ_РеестрЭТрН, затем каждый документ целиком ->
//      ДанныеДокумента, его груз -> ЭАрМ_ТоварыЭТрН (источник "ЭТрН").
//   2. Реестр УПД -> ЭАрМ_УПД_Входящий, затем строки товаров ->
//      ЭАрМ_ТоварыЭТрН (источник "УПД").
//
// После этого обмену для сборки накладной хватает регистров.
//
// Возвращаемое значение:
//   Структура - см. ВыполнитьОбмен
//
Функция ОбновитьРеестры() Экспорт

	Итоги = НовыеИтогиОбмена();
	НачалоСеанса = ТекущаяУниверсальнаяДатаВМиллисекундах();

	ПроверкаНастроек = ЭАрМ_НастройкиСервер.ПроверитьЗаполнениеНастроекСБИС();
	Если НЕ ПроверкаНастроек.Успех Тогда
		ЗавершитьСеанс(Итоги, Ложь, ПроверкаНастроек.Ошибка, НачалоСеанса);
		Возврат Итоги;
	КонецЕсли;

	// Одна авторизация на всё наполнение: дальше sid передаётся явно
	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		ЗавершитьСеанс(Итоги, Ложь,
			НСтр("ru = 'Не удалось авторизоваться в СБИС, см. журнал регистрации'"),
			НачалоСеанса);
		Возврат Итоги;
	КонецЕсли;

	ЗагрузитьРеестрЭТрН(Сессия, Итоги);
	ЗагрузитьРеестрУПД(Сессия, Итоги);

	ЭАрМ_НастройкиСервер.СохранитьНастройку("ДатаПоследнегоОбмена",
		Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'"));

	ЗавершитьСеанс(Итоги, Истина, "", НачалоСеанса);

	Возврат Итоги;

КонецФункции

// Бухгалтерия (регламентное задание ЭАрМ_ОбновлениеРеестровЭДО): выгружает
// подписанные УПД, которые не ушли фоновым заданием после подписи (груз
// раскрылся позже, папка была недоступна), и читает ответы Бухгалтерии.
// Настройка ПапкаВыгрузкиБух пуста или «Автообмен с Бухгалтерией» выключен -
// ничего не делает (только вручную). Не падает.
//
Процедура ОбменСБухгалтерией()

	Если НЕ ЗначениеЗаполнено(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПапкаВыгрузкиБух")) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЭАрМ_ВыгрузкаНакладныхДляБух.АвтообменСБух() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		// Оба пути (после подписи и регламент) идут через одно фоновое задание
		// с общим ключом: параллельный проход не положит те же УПД вторым файлом.
		// Задание уже идёт - просто пропускаем, оно же всё и выгрузит
		ЭАрМ_ВыгрузкаНакладныхДляБух.ЗапуститьВыгрузкуВФоне();
	Исключение
		ЗаписатьВЖурнал("", "ВыгрузкаВБух", Ложь,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		Отмечено = ЭАрМ_ВыгрузкаНакладныхДляБух.ПрочитатьОтветыБухгалтерии();
		Если Отмечено > 0 Тогда
			ЗаписатьВЖурнал("", "ОтветБух", Истина, СтрШаблон(
				НСтр("ru = 'Прочитаны ответы БП по УПД: %1'"), Отмечено));
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал("", "ОтветБух", Ложь,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Сопоставляет товары по загруженным регистрам. Запросов в СБИС не делает.
//
// Проходит по документам реестра ЭТрН и по каждому решает, чем раскрыт
// товарный состав: строками самого ЭТрН или строками УПД. Итог решения
// ложится в реестр - ИсточникТоваров, ИдентификаторУПД, ПредставлениеУПД.
//
// Параметры:
//   ТолькоНераскрытые - Булево - обойти только те документы, по которым
//                       источник ещё не определён. Ложь - пересопоставить всё
//
// Возвращаемое значение:
//   Структура:
//     * Обработано  - Число
//     * Раскрыто    - Число - состав собран из УПД
//     * Нераскрыто  - Число - свёрнутые места, УПД не нашлась
//
Функция СопоставитьТоварыПоРегистрам(ТолькоНераскрытые = Истина) Экспорт

	Результат = Новый Структура("Обработано, Раскрыто, Нераскрыто", 0, 0, 0);

	Для Каждого СтрокаДокумента Из ДокументыДляСопоставления(ТолькоНераскрытые) Цикл

		Попытка

			УзелДокумента = ЭАрМ_ОбщийМодульОбмен.УзелИзJSON(СтрокаДокумента.ДанныеДокумента);
			Если УзелДокумента = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			//@skip-check query-in-loop
			РезультатГруза = ЭАрМ_ОбщийМодульОбмен.ПодобратьГрузПоРегистрам(
				СтрокаДокумента.Идентификатор, УзелДокумента);

			//@skip-check query-in-loop
			ОтметитьИсточникТоваров(СтрокаДокумента.Идентификатор, РезультатГруза);

			Результат.Обработано = Результат.Обработано + 1;
			Если РезультатГруза.ТоварыРаскрыты Тогда
				Результат.Раскрыто = Результат.Раскрыто + 1;
			Иначе
				Результат.Нераскрыто = Результат.Нераскрыто + 1;
			КонецЕсли;

		Исключение
			ЗаписатьВЖурнал(СтрокаДокумента.Идентификатор, "Сопоставление", Ложь,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	ЗаписатьВЖурнал("", "Сопоставление", Истина, СтрШаблон(
		НСтр("ru = 'Обработано %1, состав раскрыт по %2, не раскрыт по %3'"),
		Результат.Обработано, Результат.Раскрыто, Результат.Нераскрыто));

	Возврат Результат;

КонецФункции

// Точка входа регламентного задания ЭАрМ_РегламентноеЗадание.
//
Процедура ВыполнитьОбменПоРасписанию() Экспорт

	Если ЭАрМ_НастройкиСервер.ФоновыеЗаданияОтключены() Тогда
		Возврат;
	КонецЕсли;

	// Отметка БСП о начале задания полезна, но не обязательна: если состав
	// её параметров в конкретной сборке другой, обмен всё равно должен пойти
	Попытка
		ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
			Метаданные.РегламентныеЗадания.ЭАрМ_РегламентноеЗадание);
	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("ВыполнитьОбменПоРасписанию",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ВыполнитьОбмен();

КонецПроцедуры

// Выполняет сеанс обмена с Далионом по уже загруженным регистрам.
//
// В СБИС не ходит вовсе. Наполнение регистров - отдельный шаг с отдельным
// заданием (см. ОбновитьРеестры), и обмен опирается на то, что оно уже
// отработало. Так медленная часть - сеть - и быстрая - сборка накладных -
// перестали зависеть друг от друга: сорвавшийся СБИС больше не мешает
// выгрузить то, что уже разобрано.
//
// Вызывается и регламентным заданием, и вручную из формы, поэтому не
// выбрасывает исключений: всё, что случилось, лежит в результате и в
// регистре ЭАрМ_ЖурналОбменаЭДО.
//
// Параметры:
//   ТолькоЗагрузка - Булево - только сопоставить состав, ничего не выгружая
//
// Возвращаемое значение:
//   Структура:
//     * Успех           - Булево
//     * Ошибка          - Строка - причина, по которой сеанс не состоялся
//     * ЗагруженоЭТрН   - Число
//     * ЗагруженоУПД    - Число
//     * Выгружено       - Число
//     * ОшибокВыгрузки  - Число
//     * Сообщения       - Массив из Строка - протокол сеанса для показа в форме
//
Функция ВыполнитьОбмен(ТолькоЗагрузка = Ложь) Экспорт

	Итоги = НовыеИтогиОбмена();
	НачалоСеанса = ТекущаяУниверсальнаяДатаВМиллисекундах();

	НастройкиОбмена = ЭАрМ_НастройкиСервер.НастройкиОбмена();

	Если НЕ НастройкиОбмена.ОбменВключен Тогда
		ЗавершитьСеанс(Итоги, Ложь,
			НСтр("ru = 'Обмен выключен в настройках ЭДО'"), НачалоСеанса);
		Возврат Итоги;
	КонецЕсли;

	// Сопоставление идёт по регистрам, авторизация в СБИС здесь не нужна
	Сопоставление = СопоставитьТоварыПоРегистрам();
	ДобавитьСообщение(Итоги, СтрШаблон(
		НСтр("ru = 'Сопоставлено %1, состав раскрыт по %2, не раскрыт по %3'"),
		Сопоставление.Обработано, Сопоставление.Раскрыто, Сопоставление.Нераскрыто));

	// Алкоголь ЕГАИС: дозаполнение реквизитов номенклатуры и сопоставление с
	// классификатором по алкокоду строк УПД.
	Попытка
		ИтогНоменклатуры = ЭАрМ_АлкогольЕГАИС.ДозаполнитьАлкогольнуюНоменклатуру();
		ДобавитьСообщение(Итоги, СтрШаблон(
			НСтр("ru = 'Алкоголь ЕГАИС: проверено %1, заполнено %2, сопоставлено %3, ошибок %4'"),
			ИтогНоменклатуры.Проверено, ИтогНоменклатуры.Заполнено,
			ИтогНоменклатуры.Сопоставлено, ИтогНоменклатуры.Ошибок));
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ВыполнитьОбмен / Алкоголь ЕГАИС", ОшибкаИсключения);
		ДобавитьСообщение(Итоги, СтрШаблон(НСтр("ru = 'Алкоголь ЕГАИС: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ОшибкаИсключения)));
	КонецПопытки;

	Если НастройкиОбмена.ТолькоПриемИзДалиона Тогда
		ДобавитьСообщение(Итоги, НСтр(
			"ru = 'Отправка документов в Далион выключена: только приём из result'"));
	ИначеЕсли ЭАрМ_НастройкиСервер.АвтоотправкаВДалионВыключена() Тогда
		// В Далион - только вручную, из форм (ЭАрМ_НастройкиСервер.АвтоотправкаВДалионВыключена)
	ИначеЕсли НастройкиОбмена.ВыгружатьАвтоматически И НЕ ТолькоЗагрузка Тогда
		ВыгрузитьНевыгруженные("", Итоги, НастройкиОбмена);
	КонецЕсли;

	// Ответы Далиона забираем после выгрузки. Разбор и сверка идут следом
	// по уже прочитанным файлам: повторный ЗабратьОтветыДалион внутри
	// ЭАрМ_Вызов здесь не вызываем.
	ЗабратьОтветыДалион(Итоги);
	ОбработатьОтветыДалион(Итоги);

	// Пакеты Далиона, сверка цепочки и пломбы — отдельное задание
	// ЭАрМ_ОбработкаПакетовДалион (ключ ЭАрМ_ЦепочкаДалион). Раньше вызывали
	// отсюда, потому что дубль ЭАрМ_ОбменЦепочкиЗакупок выключен; оба сразу
	// разбирали одни файлы и держали ключ обмена до 30 минут.

	Попытка
		ТекстОчереди = ЭАрМ_ОбработкаПодтвержденийЭДО.СобратьГотовыеКОтправке();
		ДобавитьСообщение(Итоги, ТекстОчереди);
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ВыполнитьОбмен / Очередь ЭДО", ОшибкаИсключения);
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ОшибкаИсключения);
		ДобавитьСообщение(Итоги, СтрШаблон(
			НСтр("ru = 'Очередь ЭДО: %1'"), ТекстОшибки));
	КонецПопытки;

	ЭАрМ_НастройкиСервер.СохранитьНастройку("ДатаПоследнегоОбмена",
		Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'"));

	ЗавершитьСеанс(Итоги, Истина, "", НачалоСеанса);

	Возврат Итоги;

КонецФункции

// Забирает реестр ЭТрН из СБИС и обновляет регистр ЭАрМ_РеестрЭТрН.
//
// Читает страницами, пока СБИС отдаёт полные страницы: за глубину в месяц
// документов бывает больше, чем помещается в один ответ, а обработка брала
// только первую страницу.
//
// Параметры:
//   Сессия            - Строка - sid
//   Итоги             - Структура - см. ВыполнитьОбмен, пополняется по ходу
//   ЗагружатьДокументы - Булево - дочитать документы целиком и разложить их
//                       груз по регистрам. Ложь - только строки реестра
//
// Возвращаемое значение:
//   Число - сколько строк реестра записано
//
Функция ЗагрузитьРеестрЭТрН(Сессия, Итоги = Неопределено, ЗагружатьДокументы = Истина) Экспорт

	Если Итоги = Неопределено Тогда
		Итоги = НовыеИтогиОбмена();
	КонецЕсли;

	Отбор = ЭАрМ_НастройкиСервер.ПараметрыОтбораСБИС();
	Период = ПериодЗапроса(Отбор.ГлубинаДней);
	РазмерСтраницы = ?(Отбор.РазмерСтраницы > 0, Отбор.РазмерСтраницы, 100);

	ИдСессии = Сессия;
	Страница = 0;
	Записано = 0;
	ЗагруженныеДокументы = Новый Массив;

	Пока Страница < МаксимумСтраниц() Цикл

		РезультатСписка = ЭАрМ_ОбщийМодульОбмен.ПолучитьСписокДокументов(
			ИдСессии, Отбор.ТипДокумента, Отбор.Направление,
			Страница, РазмерСтраницы, Период.ДатаС, Период.ДатаПо);

		// Просроченная сессия выглядит как обычная ошибка бизнес-логики.
		// Отвечаем на неё повторным входом, а не остановкой обмена.
		Если НЕ РезультатСписка.Успех
			И ЭАрМ_ОбщийМодульОбмен.ЭтоОшибкаСессии(РезультатСписка.Ошибка)
			И Страница = 0 Тогда

			ИдСессии = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию(Истина);
			Если ЗначениеЗаполнено(ИдСессии) Тогда
				РезультатСписка = ЭАрМ_ОбщийМодульОбмен.ПолучитьСписокДокументов(
					ИдСессии, Отбор.ТипДокумента, Отбор.Направление,
					Страница, РазмерСтраницы, Период.ДатаС, Период.ДатаПо);
			КонецЕсли;

		КонецЕсли;

		Если НЕ РезультатСписка.Успех Тогда
			ДобавитьСообщение(Итоги, СтрШаблон(
				НСтр("ru = 'Реестр ЭТрН, страница %1: %2'"), Страница, РезультатСписка.Ошибка));
			ЗаписатьВЖурнал("", "ЗагрузкаЭТрН", Ложь, РезультатСписка.Ошибка);
			Прервать;
		КонецЕсли;

		Для Каждого ДокументРеестра Из РезультатСписка.Документы Цикл
			Попытка
				ЗаписатьСтрокуРеестраЭТрН(ДокументРеестра, Отбор.Направление);
				Записано = Записано + 1;

				// Список реестра запрашивается с ДопПоля "Подстановки", а груз
				// лежит именно в них. То есть товары всей страницы уже приехали
				// этим же запросом - разбираем их здесь и в СБИС не идём
				Если НЕ СохранитьДокументИТоварыЭТрН(ДокументРеестра) Тогда
					ЗагруженныеДокументы.Добавить(ИдентификаторДокумента(ДокументРеестра));
				КонецЕсли;

			Исключение
				ЗаписатьВЖурнал(ИдентификаторДокумента(ДокументРеестра), "ЗагрузкаЭТрН", Ложь,
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;

		// Признак "ЕстьЕще" СБИС отдаёт не всегда, поэтому опираемся ещё и на
		// размер страницы: неполная страница означает, что реестр кончился
		Если РезультатСписка.Документы.Количество() < РазмерСтраницы
			ИЛИ НЕ ЕстьСледующаяСтраница(РезультатСписка.Навигация) Тогда
			Прервать;
		КонецЕсли;

		Страница = Страница + 1;

	КонецЦикла;

	Итоги.ЗагруженоЭТрН = Итоги.ЗагруженоЭТрН + Записано;
	ДобавитьСообщение(Итоги, СтрШаблон(НСтр("ru = 'Реестр ЭТрН: получено %1'"), Записано));
	ЗаписатьВЖурнал("", "ЗагрузкаЭТрН", Истина,
		СтрШаблон(НСтр("ru = 'Получено документов: %1'"), Записано));

	// Сюда попадают только те, у кого в списке титулов не оказалось: дочитываем
	// их поштучно. Это подстраховка, а не основной путь - обычно список
	// приносит всё сам
	Если ЗагружатьДокументы И ЗагруженныеДокументы.Количество() > 0 Тогда
		ДобавитьСообщение(Итоги, СтрШаблон(
			НСтр("ru = 'Без груза в списке: %1, дочитываем поштучно'"),
			ЗагруженныеДокументы.Количество()));
		ЗагрузитьДокументыЭТрН(
			ДокументыЭТрНБезДанных(ЗагруженныеДокументы), ИдСессии, Итоги);
	КонецЕсли;

	Возврат Записано;

КонецФункции

// Документы реестра ЭТрН, узел которых ещё не сохранён в регистре.
//
// Параметры:
//   Идентификаторы - Массив из Строка - ограничить этими документами.
//                    Пустой массив или Неопределено - все документы реестра
//
// Возвращаемое значение:
//   Массив из Структура - Идентификатор, Номер
//
Функция ДокументыЭТрНБезДанных(Идентификаторы = Неопределено) Экспорт

	СписокИдентификаторов = ?(ТипЗнч(Идентификаторы) = Тип("Массив"),
		Идентификаторы, Новый Массив);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭТрН.ИдентификаторСБИС КАК Идентификатор,
	|	ЭТрН.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	НЕ ЭТрН.ДанныеПолучены
	|	И (&ВсеДокументы = ИСТИНА
	|			ИЛИ ЭТрН.ИдентификаторСБИС В (&Идентификаторы))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭТрН.Дата УБЫВ";
	Запрос.УстановитьПараметр("ВсеДокументы", СписокИдентификаторов.Количество() = 0);
	Запрос.УстановитьПараметр("Идентификаторы", СписокИдентификаторов);

	Результат = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Идентификатор, Номер",
			СокрЛП(Выборка.Идентификатор), СокрЛП(Выборка.Номер)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Дочитывает документы ЭТрН целиком и раскладывает их по регистрам.
//
// Устроено так же, как догрузка товаров УПД: сначала сеть на всю порцию
// с общим кешем соединений, потом запись одной транзакцией. В регистр
// реестра ложится узел документа целиком, в регистр товаров - его груз.
//
// Параметры:
//   СписокДокументов - Массив из Структура - см. ДокументыЭТрНБезДанных
//   Сессия    - Строка - sid
//   Итоги     - Структура - см. ВыполнитьОбмен
//
// Возвращаемое значение:
//   Число - сколько документов дочитано
//
Функция ЗагрузитьДокументыЭТрН(СписокДокументов, Сессия, Итоги = Неопределено) Экспорт

	Всего = СписокДокументов.Количество();
	Если Всего = 0 Тогда
		Возврат 0;
	КонецЕсли;

	СостояниеЗагрузки = НовоеСостояниеЗагрузкиТоваров(Сессия);

	Загружено = 0;
	Обработано = 0;
	ПроцентРанее = -1;

	РазмерПорции = РазмерПорцииЗаписиТоваров();
	Порция = Новый Массив;

	Для Каждого СтрокаДокумента Из СписокДокументов Цикл

		Обработано = Обработано + 1;

		// --- Этап 1: только сеть ---
		УзелДокумента = ПрочитатьДокументЭТрН(СтрокаДокумента, СостояниеЗагрузки);

		Если УзелДокумента <> Неопределено Тогда
			Порция.Добавить(Новый Структура("Идентификатор, Номер, Документ",
				СтрокаДокумента.Идентификатор, СтрокаДокумента.Номер, УзелДокумента));
		КонецЕсли;

		// --- Этап 2: одна транзакция на порцию ---
		Если Порция.Количество() >= РазмерПорции Тогда
			Загружено = Загружено + ЗаписатьПорциюДокументовЭТрН(Порция);
			Порция = Новый Массив;
		КонецЕсли;

		Процент = Цел(Обработано / Всего * 100);
		Если Процент <> ПроцентРанее Тогда
			ДлительныеОперации.СообщитьПрогресс(Процент, СтрШаблон(
				НСтр("ru = 'Документы ЭТрН: %1 из %2'"), Обработано, Всего));
			ПроцентРанее = Процент;
		КонецЕсли;

	КонецЦикла;

	Загружено = Загружено + ЗаписатьПорциюДокументовЭТрН(Порция);

	Если Итоги <> Неопределено Тогда
		ДобавитьСообщение(Итоги, СтрШаблон(
			НСтр("ru = 'Документы ЭТрН: дочитано %1 из %2'"), Загружено, Всего));
	КонецЕсли;

	ЗаписатьВЖурнал("", "ЗагрузкаДокументовЭТрН", Истина,
		СтрШаблон(НСтр("ru = 'Дочитано документов: %1 из %2'"), Загружено, Всего));

	Возврат Загружено;

КонецФункции

// Забирает реестр УПД из СБИС и обновляет регистр ЭАрМ_УПД_Входящий.
//
// Реестр и товары разнесены намеренно. Список реестра - это один запрос на
// страницу, а товары - отдельный поход в СБИС на каждый документ: чтение
// документа плюс скачивание и разбор XML-вложения, три-пять сетевых
// обращений. Пока товары тянулись прямо в цикле по документам, страница из
// сотни строк превращалась в сотни последовательных запросов - отсюда и
// время загрузки.
//
// Параметры:
//   Сессия          - Строка - sid
//   Итоги           - Структура - см. ВыполнитьОбмен
//   ЗагружатьТовары - Булево - Ложь: записать только реестр и выйти. Товары
//                     тогда догружает вызывающий - см. ДокументыУПДБезТоваров
//                     и ЗагрузитьТоварыУПДПоСписку. Так делает форма списка:
//                     реестр синхронно, товары фоновым заданием
//
// Возвращаемое значение:
//   Число - сколько строк реестра записано
//
Функция ЗагрузитьРеестрУПД(Сессия, Итоги = Неопределено, ЗагружатьТовары = Истина) Экспорт

	Чтение = ПрочитатьРеестрУПД(Сессия, Итоги);

	// Товары догружаем только по документам этого прогона: перебирать заново
	// всё, что когда-то не разобралось, регламентному обмену незачем.
	// Кого именно догружать - спрашиваем у регистра, одним запросом
	Если ЗагружатьТовары И Чтение.Идентификаторы.Количество() > 0 Тогда
		ЗагрузитьТоварыУПДПоСписку(
			ДокументыУПДБезТоваров(Чтение.Идентификаторы), Чтение.Сессия, Итоги);
	КонецЕсли;

	Возврат Чтение.Записано;

КонецФункции

// Читает реестр УПД из СБИС и обновляет регистр, товары не трогает.
//
// Отделено от ЗагрузитьРеестрУПД, чтобы вызывающий знал, какие документы
// приехали в этом прогоне: по ним он спросит у регистра, кому ещё нужны
// товары. Сами документы не тащим - только идентификаторы, остальное
// возьмётся запросом.
//
// Параметры:
//   Сессия - Строка - sid
//   Итоги  - Структура - см. ВыполнитьОбмен
//   ДатаС, ДатаПо - Строка - свой период "дд.ММ.гггг"; пусто - окно обмена (3 дня)
//
// Возвращаемое значение:
//   Структура:
//     * Записано       - Число - сколько строк реестра записано
//     * Сессия         - Строка - sid, возможно обновлённый по ходу
//     * Идентификаторы - Массив из Строка - документы этого прогона
//
Функция ПрочитатьРеестрУПД(Сессия, Итоги = Неопределено, ДатаС = "", ДатаПо = "") Экспорт

	Если Итоги = Неопределено Тогда
		Итоги = НовыеИтогиОбмена();
	КонецЕсли;

	Отбор = ЭАрМ_НастройкиСервер.ПараметрыОтбораСБИС();
	РазмерСтраницы = ?(Отбор.РазмерСтраницы > 0, Отбор.РазмерСтраницы, 100);

	ИдСессии = Сессия;
	Страница = 0;
	Записано = 0;
	ЗагруженныеДокументы = Новый Массив;

	// Просим товары сразу в списке. Если реестр этих узлов не понимает,
	// признак сбрасывается на первой же странице - см. ниже
	ДопПоляСписка = ЭАрМ_ОбщийМодульОбмен.ДопПоляСписка();

	// Один кеш соединений на всю загрузку реестра: скачивание вложений идёт
	// к одному и тому же хосту сотни раз подряд
	КешСписка = ЭАрМ_Служебный.НовыйКешСоединенийСБИС();

	Пока Страница < МаксимумСтраниц() Цикл

		ДлительныеОперации.СообщитьПрогресс(, СтрШаблон(
			НСтр("ru = 'Реестр УПД: страница %1'"), Страница + 1));

		РезультатСписка = ЭАрМ_ОбщийМодульОбмен.ПолучитьСписокУПД(
			ИдСессии, Отбор.ТипРеестраУПД, Отбор.ТипВложенияУПД,
			Страница, РазмерСтраницы, , Отбор.ГлубинаДней, ДопПоляСписка, ДатаС, ДатаПо);

		Если НЕ РезультатСписка.Успех
			И ЭАрМ_ОбщийМодульОбмен.ЭтоОшибкаСессии(РезультатСписка.Ошибка)
			И Страница = 0 Тогда

			ИдСессии = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию(Истина);
			Если ЗначениеЗаполнено(ИдСессии) Тогда
				РезультатСписка = ЭАрМ_ОбщийМодульОбмен.ПолучитьСписокУПД(
					ИдСессии, Отбор.ТипРеестраУПД, Отбор.ТипВложенияУПД,
					Страница, РазмерСтраницы, , Отбор.ГлубинаДней, ДопПоляСписка, ДатаС, ДатаПо);
			КонецЕсли;

		КонецЕсли;

		// Неизвестное имя узла в ДопПоля СБИС отвергает целиком. Если так -
		// повторяем страницу без них: тогда товары придётся дочитывать
		// поштучно, но реестр загрузится
		Если НЕ РезультатСписка.Успех И ЗначениеЗаполнено(ДопПоляСписка) Тогда

			ЗаписатьВЖурнал("", "ЗагрузкаУПД", Ложь, СтрШаблон(
				НСтр("ru = 'Реестр отверг доп. поля (%1), повторяем без них: %2'"),
				ДопПоляСписка, РезультатСписка.Ошибка));

			ДопПоляСписка = "";
			РезультатСписка = ЭАрМ_ОбщийМодульОбмен.ПолучитьСписокУПД(
				ИдСессии, Отбор.ТипРеестраУПД, Отбор.ТипВложенияУПД,
				Страница, РазмерСтраницы, , Отбор.ГлубинаДней, ДопПоляСписка, ДатаС, ДатаПо);

		КонецЕсли;

		Если НЕ РезультатСписка.Успех Тогда
			ДобавитьСообщение(Итоги, СтрШаблон(
				НСтр("ru = 'Реестр УПД, страница %1: %2'"), Страница, РезультатСписка.Ошибка));
			ЗаписатьВЖурнал("", "ЗагрузкаУПД", Ложь, РезультатСписка.Ошибка);
			Прервать;
		КонецЕсли;

		Для Каждого ДокументРеестра Из РезультатСписка.Документы Цикл

			// Реестр запрашивается без отбора форматов: ЭТрН и путевые листы
			// живут в своём реестре и сюда не пишутся. Документ без
			// распознанного формата пишется - вложений в строке списка может
			// просто не быть
			ФорматДокумента = ЭАрМ_Служебный.ФорматДокументаПоВложениям(ДокументРеестра);
			Если ФорматДокумента = "ЭТрН" ИЛИ ФорматДокумента = "ЭПЛ" Тогда
				Продолжить;
			КонецЕсли;

			Попытка
				ЗаписатьСтрокуРеестраУПД(ДокументРеестра, Отбор.ТипРеестраУПД);
				Записано = Записано + 1;

				// Вложения приехали вместе со страницей - значит документ в
				// СБИС читать не нужно, хватит скачать по ссылке сам XML
				Если НЕ СохранитьТоварыУПДИзСписка(ДокументРеестра, ИдСессии, КешСписка) Тогда
					ЗагруженныеДокументы.Добавить(ИдентификаторДокумента(ДокументРеестра));
				КонецЕсли;

			Исключение
				ИдентификаторСОшибкой = ИдентификаторДокумента(ДокументРеестра);
				Если ЗначениеЗаполнено(ИдентификаторСОшибкой)
					И ЗагруженныеДокументы.Найти(ИдентификаторСОшибкой) = Неопределено Тогда
					ЗагруженныеДокументы.Добавить(ИдентификаторСОшибкой);
				КонецЕсли;
				ЗаписатьВЖурнал(ИдентификаторСОшибкой, "ЗагрузкаУПД", Ложь,
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;

		Если РезультатСписка.Документы.Количество() < РазмерСтраницы
			ИЛИ НЕ ЕстьСледующаяСтраница(РезультатСписка.Навигация) Тогда
			Прервать;
		КонецЕсли;

		Страница = Страница + 1;

	КонецЦикла;

	// Корректировки, осевшие в реестре УПД (вид документа выяснился позже),
	// переносим сразу, а не ждём задание цепочки: иначе УКД видна в обоих реестрах
	Попытка
		ЭАрМ_КорректировкиУПД.ПеренестиКорректировкиИзРеестраУПД();
	Исключение
		ЗаписатьВЖурнал("", "ЗагрузкаУПД", Ложь,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Итоги.ЗагруженоУПД = Итоги.ЗагруженоУПД + Записано;
	ДобавитьСообщение(Итоги, СтрШаблон(НСтр("ru = 'Реестр УПД: получено %1'"), Записано));
	ЗаписатьВЖурнал("", "ЗагрузкаУПД", Истина,
		СтрШаблон(НСтр("ru = 'Получено документов: %1'"), Записано));

	Возврат Новый Структура("Записано, Сессия, Идентификаторы",
		Записано, ИдСессии, ЗагруженныеДокументы);

КонецФункции

// Документы реестра УПД, товаров которых ещё нет в ЭАрМ_ТоварыЭТрН.
//
// Один запрос на весь список вместо проверки по каждому документу: раньше
// на каждую строку реестра приходился отдельный запрос ЕстьТоварыВРегистре.
//
// Параметры:
//   Идентификаторы - Массив из Строка - ограничить этими документами.
//                    Пустой массив или Неопределено - все документы реестра,
//                    по которым товаров ещё нет
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Идентификатор - Строка - документ в СБИС
//     * Номер         - Строка - номер документа, им помечаются строки товаров
//
Функция ДокументыУПДБезТоваров(Идентификаторы = Неопределено) Экспорт

	СписокИдентификаторов = ?(ТипЗнч(Идентификаторы) = Тип("Массив"),
		Идентификаторы, Новый Массив);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК Идентификатор,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	НЕ УПД.ИдентификаторСБИС В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				Товары.ИдентификаторСБИС
	|			ИЗ
	|				РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|			ГДЕ
	|				Товары.ИсточникТоваров В (&ИсточникиУПД))
	|	И (&ВсеДокументы = ИСТИНА
	|			ИЛИ УПД.ИдентификаторСБИС В (&Идентификаторы))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УКД.ИдентификаторСБИС,
	|	УКД.Номер,
	|	УКД.Дата
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	НЕ УКД.ИдентификаторСБИС В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				Товары.ИдентификаторСБИС
	|			ИЗ
	|				РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|			ГДЕ
	|				Товары.ИсточникТоваров В (&ИсточникиУПД))
	|	И (&ВсеДокументы = ИСТИНА
	|			ИЛИ УКД.ИдентификаторСБИС В (&Идентификаторы))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("ВсеДокументы", СписокИдентификаторов.Количество() = 0);
	Запрос.УстановитьПараметр("Идентификаторы", СписокИдентификаторов);

	// Строки корректировок лежат под своим источником: без него УКД считалась
	// бы документом без товаров и перекачивалась на каждом проходе
	ИсточникиУПД = Новый Массив;
	ИсточникиУПД.Добавить("УПД");
	ИсточникиУПД.Добавить(ЭАрМ_КорректировкиУПД.ИсточникТоваровКорректировки());
	Запрос.УстановитьПараметр("ИсточникиУПД", ИсточникиУПД);

	Результат = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Идентификатор, Номер",
			СокрЛП(Выборка.Идентификатор), СокрЛП(Выборка.Номер)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Догружает товары по списку документов УПД.
//
// Это же - точка входа фонового задания: параметры сериализуемые, результат
// число. Форма списка запускает её порциями через
// ДлительныеОперации.ВыполнитьФункциюВНесколькоПотоков, регламентный обмен
// зовёт напрямую.
//
// Работа идёт порциями, и каждая порция проходит два раздельных этапа:
//
//   1. Сеть. Забираем товары по документам порции, ни разу не трогая базу.
//      На всю порцию - один кеш HTTPS-соединений: раньше каждый запрос и
//      каждое скачивание вложения поднимали TLS заново, а это три-четыре
//      рукопожатия на документ.
//
//   2. База. Пишем всё собранное одной транзакцией на порцию вместо
//      транзакции с блокировкой на каждый документ.
//
// Этапы разделены не ради красоты: писать внутри цикла означало бы держать
// блокировки регистра всё время, пока идут сетевые запросы.
//
// Сессия обновляется на ходу: прогон по сотне документов идёт дольше, чем
// живёт sid, и без этого хвост списка отваливался бы по авторизации.
//
// Параметры:
//   СписокДокументов - Массив из Структура - см. ДокументыУПДБезТоваров
//   Сессия           - Строка - sid
//   Итоги            - Структура - см. ВыполнитьОбмен
//
// Возвращаемое значение:
//   Число - по скольким документам товары записаны
//
Функция ЗагрузитьТоварыУПДПоСписку(СписокДокументов, Сессия, Итоги = Неопределено) Экспорт

	Всего = СписокДокументов.Количество();
	Если Всего = 0 Тогда
		Возврат 0;
	КонецЕсли;

	СостояниеЗагрузки = НовоеСостояниеЗагрузкиТоваров(Сессия);

	Загружено = 0;
	Обработано = 0;
	ПроцентРанее = -1;

	РазмерПорции = РазмерПорцииЗаписиТоваров();
	Порция = Новый Массив;

	Для Каждого СтрокаДокумента Из СписокДокументов Цикл

		Обработано = Обработано + 1;

		// --- Этап 1: только сеть ---
		ТоварыДокумента = ПолучитьТоварыДокументаУПД(СтрокаДокумента, СостояниеЗагрузки);

		Если ТоварыДокумента <> Неопределено Тогда
			Порция.Добавить(Новый Структура("Идентификатор, Номер, Товары",
				СтрокаДокумента.Идентификатор, СтрокаДокумента.Номер, ТоварыДокумента));
		КонецЕсли;

		// --- Этап 2: одна транзакция на порцию ---
		Если Порция.Количество() >= РазмерПорции Тогда
			Загружено = Загружено + ЗаписатьПорциюТоваровУПД(Порция);
			Порция = Новый Массив;
		КонецЕсли;

		// БСП не советует сообщать прогресс чаще ста раз за операцию,
		// поэтому дёргаем его только на смене процента
		Процент = Цел(Обработано / Всего * 100);
		Если Процент <> ПроцентРанее Тогда
			ДлительныеОперации.СообщитьПрогресс(Процент, СтрШаблон(
				НСтр("ru = 'Товары УПД: %1 из %2'"), Обработано, Всего));
			ПроцентРанее = Процент;
		КонецЕсли;

	КонецЦикла;

	Загружено = Загружено + ЗаписатьПорциюТоваровУПД(Порция);

	Если Итоги <> Неопределено Тогда
		ДобавитьСообщение(Итоги, СтрШаблон(
			НСтр("ru = 'Товары УПД: загружено по %1 документам из %2'"), Загружено, Всего));
	КонецЕсли;

	ЗаписатьВЖурнал("", "ЗагрузкаТоваровУПД", Истина,
		СтрШаблон(НСтр("ru = 'Товары загружены по %1 документам из %2'"), Загружено, Всего));

	Возврат Загружено;

КонецФункции

// Догружает товары одной уже найденной УПД. Используется формой реестра,
// если шапка УПД есть, а её строки в товарном регистре отсутствуют.
//
Функция ДогрузитьТоварыУПД(
		ИдентификаторУПД, НомерДокумента = "") Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат Ложь;
	КонецЕсли;

	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		ЗаписатьВЖурнал(ИдентификаторУПД, "ЗагрузкаТоваровУПД", Ложь,
			НСтр("ru = 'Не удалось получить сессию СБИС'"));
		Возврат Ложь;
	КонецЕсли;

	СписокДокументов = Новый Массив;
	СписокДокументов.Добавить(Новый Структура(
		"Идентификатор, Номер", ИдентификаторУПД, НомерДокумента));

	Возврат ЗагрузитьТоварыУПДПоСписку(
		СписокДокументов, Сессия) > 0;

КонецФункции

// Фоновое задание формы реестра УПД: догружает из СБИС товары УПД и груз
// связанной ЭТрН, которых ещё нет в регистре. Форма строит дерево сразу из
// базы и перестраивает его, когда задание вернёт Истина.
//
// Параметры:
//   ИдентификаторУПД  - Строка - пустая: товары УПД не нужны
//   НомерУПД          - Строка
//   ИдентификаторЭТрН - Строка - пустая: груз ЭТрН не нужен
//
// Возвращаемое значение:
//   Булево - что-то догружено
//
Функция ДогрузитьТоварыЦепочки(ИдентификаторУПД, НомерУПД, ИдентификаторЭТрН) Экспорт

	Догружено = Ложь;

	Если ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Попытка
			Догружено = ДогрузитьТоварыУПД(ИдентификаторУПД, НомерУПД);
		Исключение
			ЗаписатьВЖурнал(ИдентификаторУПД, "ЗагрузкаТоваровУПД", Ложь,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Если ЗначениеЗаполнено(ИдентификаторЭТрН) Тогда
		Попытка
			Если ОбновитьТоварыДокумента(ИдентификаторЭТрН).Успех Тогда
				Догружено = Истина;
			КонецЕсли;
		Исключение
			ЗаписатьВЖурнал(ИдентификаторЭТрН, "ЗагрузкаТоваровЭТрН", Ложь,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Возврат Догружено;

КонецФункции

// Записывает в реестр УПД документ, найденный в СБИС адресно - например,
// исходную УПД корректировки, которая старше окна загрузки реестра, - и
// догружает его товары.
//
// Параметры:
//   ДокументРеестра - Соответствие - элемент реестра СБИС
//   ТипРеестра      - Строка - Входящие или Отправленные
//
// Возвращаемое значение:
//   Строка - идентификатор записанного документа
//
Функция ЗагрузитьДокументРеестраУПД(ДокументРеестра, ТипРеестра) Экспорт

	Идентификатор = ИдентификаторДокумента(ДокументРеестра);
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат "";
	КонецЕсли;

	ЗаписатьСтрокуРеестраУПД(ДокументРеестра, ТипРеестра);
	ДогрузитьТоварыУПД(Идентификатор, ЗначениеСтрокой(ДокументРеестра, "Номер"));

	Возврат Идентификатор;

КонецФункции

// Перечитывает одну УПД из СБИС по идентификатору строки реестра.
//
// Реестр за 3 дня сюда не запрашивается: СБИС.ПрочитатьДокумент возвращает
// этот документ, строка реестра обновляется, XML с товарами скачивается заново.
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, Сообщение
//
Функция ЗагрузитьУПДТочечно(Идентификатор) Экспорт

	Результат = Новый Структура("Успех, Ошибка, Сообщение", Ложь, "", "");

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Результат.Ошибка = НСтр("ru = 'Выберите УПД в списке'");
		Возврат Результат;
	КонецЕсли;

	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Результат.Ошибка = НСтр("ru = 'Не удалось авторизоваться в СБИС, проверьте настройки ЭДО'");
		Возврат Результат;
	КонецЕсли;

	Чтение = ЭАрМ_ОбщийМодульОбмен.ПрочитатьДокумент(Идентификатор, Сессия, ,
		"Вложение,Стороны,Подстановки");
	Если НЕ Чтение.Успех И ЭАрМ_ОбщийМодульОбмен.ЭтоОшибкаСессии(Чтение.Ошибка) Тогда
		Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию(Истина);
		Если ЗначениеЗаполнено(Сессия) Тогда
			Чтение = ЭАрМ_ОбщийМодульОбмен.ПрочитатьДокумент(Идентификатор, Сессия, ,
				"Вложение,Стороны,Подстановки");
		КонецЕсли;
	КонецЕсли;

	Если НЕ Чтение.Успех ИЛИ Чтение.Документ = Неопределено Тогда
		Результат.Ошибка = ?(ЗначениеЗаполнено(Чтение.Ошибка), Чтение.Ошибка,
			НСтр("ru = 'СБИС не вернул документ'"));
		Возврат Результат;
	КонецЕсли;

	ТипРеестра = ТипРеестраУПД(Идентификатор);
	ЗаписатьСтрокуРеестраУПД(Чтение.Документ, ТипРеестра);

	ТоварыЗаписаны = СохранитьТоварыУПДИзСписка(Чтение.Документ, Сессия, Неопределено);
	Если НЕ ТоварыЗаписаны Тогда
		ДогрузитьТоварыУПД(Идентификатор, ЗначениеСтрокой(Чтение.Документ, "Номер"));
	КонецЕсли;

	ОбновитьПризнакЭТрНРеестраУПД(Идентификатор);

	Номер = ЗначениеСтрокой(Чтение.Документ, "Номер");
	Результат.Успех = Истина;
	Результат.Сообщение = СтрШаблон(НСтр("ru = 'УПД %1 перечитана из СБИС'"),
		?(ЗначениеЗаполнено(Номер), "№ " + Номер, Идентификатор));

	Возврат Результат;

КонецФункции

// Реестр, в котором строка уже лежит. Пустой - входящие.
//
Функция ТипРеестраУПД(Идентификатор)

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() И ЗначениеЗаполнено(МенеджерЗаписи.ТипРеестра) Тогда
		Возврат СокрЛП(МенеджерЗаписи.ТипРеестра);
	КонецЕсли;

	Возврат "Входящие";

КонецФункции

// Раскладывает документы по порциям для многопоточной догрузки товаров.
//
// Потоков берём столько, сколько разрешает БСП: в файловой базе и в модели
// сервиса это единица, и тогда порция будет одна - вызывающий код от этого
// не меняется.
//
// Параметры:
//   СписокДокументов - Массив из Структура - см. ДокументыУПДБезТоваров
//   Сессия    - Строка - sid
//
// Возвращаемое значение:
//   Соответствие - набор параметров для
//                  ДлительныеОперации.ВыполнитьФункциюВНесколькоПотоков:
//     * Ключ     - Строка - имя порции
//     * Значение - Массив - параметры вызова ЗагрузитьТоварыУПДПоСписку
//
Функция ПорцииДокументовУПД(СписокДокументов, Сессия) Экспорт

	НаборПараметров = Новый Соответствие;

	Если СписокДокументов.Количество() = 0 Тогда
		Возврат НаборПараметров;
	КонецЕсли;

	Потоков = ДлительныеОперации.ДопустимоеКоличествоПотоков();
	Если Потоков < 1 Тогда
		Потоков = 1;
	КонецЕсли;
	Если Потоков > СписокДокументов.Количество() Тогда
		Потоков = СписокДокументов.Количество();
	КонецЕсли;

	Порции = Новый Массив;
	Для Счетчик = 1 По Потоков Цикл
		Порции.Добавить(Новый Массив);
	КонецЦикла;

	// Раскладываем по кругу, а не подряд: документы разной тяжести
	// распределяются по потокам ровнее
	НомерПорции = 0;
	Для Каждого СтрокаДокумента Из СписокДокументов Цикл
		Порции[НомерПорции].Добавить(СтрокаДокумента);
		НомерПорции = НомерПорции + 1;
		Если НомерПорции = Потоков Тогда
			НомерПорции = 0;
		КонецЕсли;
	КонецЦикла;

	Для Индекс = 0 По Порции.ВГраница() Цикл

		Если Порции[Индекс].Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		ПараметрыВызова = Новый Массив;
		ПараметрыВызова.Добавить(Порции[Индекс]);
		ПараметрыВызова.Добавить(Сессия);

		НаборПараметров.Вставить(СтрШаблон("Порция%1", Индекс + 1), ПараметрыВызова);

	КонецЦикла;

	Возврат НаборПараметров;

КонецФункции

// Выгружает в Далион один документ реестра.
//
// Вынесено отдельно: этим же кодом пользуется команда "Выгрузить в Далион"
// формы списка регистра ЭАрМ_РеестрЭТрН, и поведение ручной выгрузки не должно
// отличаться от регламентной.
//
// Параметры:
//   ИдентификаторСБИС - Строка - документ в СБИС
//   Сессия            - Строка - sid. Пустая - будет получена
//
// Возвращаемое значение:
//   Структура:
//     * Успех            - Булево
//     * Ошибка           - Строка
//     * ИмяФайла         - Строка
//     * ПутьВыгрузки     - Строка
//     * ТоваровВыгружено - Число
//     * ТекстJSON        - Строка
//
// Берёт товары УПД из регистров по номеру документа.
//
// Правило подбора: в ЭТрН груз часто свёрнут в одну строку, хотя позиций в
// поставке много. Тогда по номеру ЭТрН находим УПД в реестре
// ЭАрМ_УПД_Входящий и берём все её строки товаров из ЭАрМ_ТоварыЭТрН.
// В СБИС при этом не ходим - только регистры.
//
// Параметры:
//   НомерДокумента - Строка - номер ЭТрН, он же номер искомой УПД
//
// Возвращаемое значение:
//   Структура:
//     * ИдентификаторУПД - Строка - уид найденной УПД, пусто - не нашли
//     * Представление    - Строка
//     * Позиции          - Массив из Структура - в том же виде, что отдаёт
//                          ЭАрМ_ОбщийМодульОбмен.ПолучитьГрузЭТрН
//
Функция ТоварыУПДИзРегистраПоНомеру(НомерДокумента) Экспорт

	Результат = Новый Структура("ИдентификаторУПД, Представление, Позиции",
		"", "", Новый Массив);

	Если НЕ ЗначениеЗаполнено(НомерДокумента) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.ИдентификаторСБИС КАК ИдентификаторУПД,
	|	УПД.Представление КАК Представление,
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.Наименование КАК Наименование,
	|	Товары.КодНоменклатуры КАК КодНоменклатуры,
	|	Товары.Артикул КАК Артикул,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Товары.СпособУпаковки КАК СпособУпаковки,
	|	Товары.КоличествоМест КАК КоличествоМест,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.МассаБрутто КАК МассаБрутто,
	|	Товары.МассаНетто КАК МассаНетто,
	|	Товары.КодВалюты КАК КодВалюты,
	|	Товары.Маркировки КАК Маркировки,
	|	Товары.Контейнеры КАК Контейнеры
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО УПД.ИдентификаторСБИС = Товары.ИдентификаторСБИС
	|ГДЕ
	|	Товары.НомерДокумента = &Номер
	|	И Товары.ИсточникТоваров = &ИсточникУПД
	|
	|УПОРЯДОЧИТЬ ПО
	|	УПД.Дата УБЫВ,
	|	НомерПозиции";
	Запрос.УстановитьПараметр("ИсточникУПД", "УПД");
	Запрос.УстановитьПараметр("Номер", СокрЛП(НомерДокумента));

	Выборка = Запрос.Выполнить().Выбрать();

	// Строки помечены номером так, как его написал поставщик, и точное
	// сравнение с номером ЭТрН срабатывает не всегда. Если не сошлось -
	// ищем саму УПД по нормализованному номеру и берём её строки по уиду
	Если НЕ Выборка.Следующий() Тогда

		НайденнаяУПД = УПДПоНормализованномуНомеру(НомерДокумента);

		Если НЕ ЗначениеЗаполнено(НайденнаяУПД.Идентификатор) Тогда
			Возврат Результат;
		КонецЕсли;

		Возврат ТоварыУПДИзРегистраПоИдентификатору(
			НайденнаяУПД.Идентификатор, НайденнаяУПД.Представление);

	КонецЕсли;

	Выборка.Сбросить();

	Пока Выборка.Следующий() Цикл

		// Строки идут по убыванию даты УПД: берём только самую свежую
		Если ЗначениеЗаполнено(Результат.ИдентификаторУПД)
			И Результат.ИдентификаторУПД <> Выборка.ИдентификаторУПД Тогда
			Прервать;
		КонецЕсли;

		Результат.ИдентификаторУПД = Выборка.ИдентификаторУПД;
		Результат.Представление    = Выборка.Представление;

		Результат.Позиции.Добавить(ПозицияИзЗаписиРегистра(Выборка));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строки товаров УПД по её идентификатору.
//
// Второй заход после ТоварыУПДИзРегистраПоНомеру: номер уже не нужен, УПД
// найдена, и строки берутся по измерению регистра - без перебора.
//
// Параметры:
//   ИдентификаторУПД - Строка - документ УПД в СБИС
//   Представление    - Строка - имя документа для показа
//
// Возвращаемое значение:
//   Структура - см. ТоварыУПДИзРегистраПоНомеру
//
Функция ТоварыУПДИзРегистраПоИдентификатору(ИдентификаторУПД, Представление = "")

	Результат = Новый Структура("ИдентификаторУПД, Представление, Позиции",
		"", "", Новый Массив);

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.ИдентификаторСБИС КАК ИдентификаторУПД,
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.Наименование КАК Наименование,
	|	Товары.КодНоменклатуры КАК КодНоменклатуры,
	|	Товары.Артикул КАК Артикул,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Товары.СпособУпаковки КАК СпособУпаковки,
	|	Товары.КоличествоМест КАК КоличествоМест,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.МассаБрутто КАК МассаБрутто,
	|	Товары.МассаНетто КАК МассаНетто,
	|	Товары.КодВалюты КАК КодВалюты,
	|	Товары.Маркировки КАК Маркировки,
	|	Товары.Контейнеры КАК Контейнеры
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &ИдентификаторУПД
	|	И Товары.ИсточникТоваров = &ИсточникУПД
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерПозиции";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);
	Запрос.УстановитьПараметр("ИсточникУПД", "УПД");

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Результат.ИдентификаторУПД = Выборка.ИдентификаторУПД;
		Результат.Представление    = Представление;
		Результат.Позиции.Добавить(ПозицияИзЗаписиРегистра(Выборка));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строки УПД для конкретной ЭТрН. Связь по идентификаторам/пакету точнее
// совпадения номера, поэтому номер используется только как запасной вариант.
//
Функция ТоварыУПДИзРегистраДляЭТрН(
		ИдентификаторЭТрН, НомерДокумента) Экспорт

	СвязаннаяУПД = НайтиУПДДляЭТрН(
		ИдентификаторЭТрН, НомерДокумента);

	Если ЗначениеЗаполнено(СвязаннаяУПД.Идентификатор) Тогда
		Возврат ТоварыУПДИзРегистраПоИдентификатору(
			СвязаннаяУПД.Идентификатор, СвязаннаяУПД.Представление);
	КонецЕсли;

	Возврат ТоварыУПДИзРегистраПоНомеру(НомерДокумента);

КонецФункции

// Документы реестра ЭТрН для сопоставления.
//
// Возвращаемое значение:
//   Массив из Структура - Идентификатор, ДанныеДокумента
//
Функция ДокументыДляСопоставления(ТолькоНераскрытые)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭТрН.ИдентификаторСБИС КАК Идентификатор,
	|	ЭТрН.ДанныеДокумента КАК ДанныеДокумента
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	ЭТрН.ДанныеПолучены
	|	И НЕ ЭТрН.Выгружен
	|	И (&ТолькоНераскрытые = ЛОЖЬ
	|			ИЛИ ЭТрН.ИсточникТоваров = """")
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭТрН.Дата УБЫВ";
	Запрос.УстановитьПараметр("ТолькоНераскрытые", ТолькоНераскрытые);

	Результат = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Идентификатор, ДанныеДокумента",
			СокрЛП(Выборка.Идентификатор), Выборка.ДанныеДокумента));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Записывает в реестр, чем раскрыт товарный состав документа.
//
Процедура ОтметитьИсточникТоваров(ИдентификаторСБИС, РезультатГруза)

	НачатьТранзакцию();
	Попытка

		МенеджерЗаписи = МенеджерРеестраЭТрН(ИдентификаторСБИС);

		Если МенеджерЗаписи <> Неопределено Тогда
			МенеджерЗаписи.ИсточникТоваров   = Лев(РезультатГруза.ИсточникТоваров, 20);
			МенеджерЗаписи.ИдентификаторУПД  = Лев(РезультатГруза.ИдентификаторУПД, 100);
			МенеджерЗаписи.ПредставлениеУПД  = Лев(РезультатГруза.ПредставлениеУПД, 150);
			МенеджерЗаписи.Записать(Истина);
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторСБИС,
			"ОтметитьИсточникТоваров (источник товаров не записан)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Достаёт сохранённый узел документа из реестра ЭТрН.
//
// Возвращаемое значение:
//   Соответствие - узел документа
//   Неопределено - документа в реестре нет либо он загружен без данных
//
Функция ДокументИзРеестра(ИдентификаторСБИС) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭТрН.ДанныеДокумента КАК ДанныеДокумента
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	ЭТрН.ИдентификаторСБИС = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторСБИС);

	Выборка = Запрос.Выполнить().Выбрать();

	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЭАрМ_ОбщийМодульОбмен.УзелИзJSON(Выборка.ДанныеДокумента);

КонецФункции

// Находит УПД в уже загруженном реестре по номеру.
//
// Реестр ЭАрМ_УПД_Входящий наполняется загрузкой, и искать документ заново
// в СБИС незачем: за номером и идентификатором ходить на сервер нужно только
// тогда, когда в реестре его действительно нет.
//
// Параметры:
//   НомерДокумента - Строка - номер ЭТрН, он же номер искомой УПД
//
// Возвращаемое значение:
//   Структура:
//     * Идентификатор - Строка - пусто, если в реестре не нашли
//     * Представление - Строка
//
Функция НайтиУПДВРеестреПоНомеру(НомерДокумента) Экспорт

	Результат = Новый Структура("Идентификатор, Представление", "", "");

	Если НЕ ЗначениеЗаполнено(НомерДокумента) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УПД.ИдентификаторСБИС КАК Идентификатор,
	|	УПД.Представление КАК Представление
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.Номер = &Номер
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УПД") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	УПД.Дата УБЫВ";
	Запрос.УстановитьПараметр("Номер", СокрЛП(НомерДокумента));

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Результат.Идентификатор = СокрЛП(Выборка.Идентификатор);
		Результат.Представление = СокрЛП(Выборка.Представление);
		Возврат Результат;
	КонецЕсли;

	// Точного совпадения нет - сравниваем нормализованные номера.
	// Поставщик пишет номер по-своему: "№ 070345", "0000-070345", разный
	// регистр. Для запроса это разные строки, для человека - один номер
	Возврат УПДПоНормализованномуНомеру(НомерДокумента);

КонецФункции

// Находит связанную УПД сначала по ключам цепочки СБИС, затем по номеру.
// Номер ЭТрН и номер УПД не обязаны совпадать.
//
Функция НайтиУПДДляЭТрН(ИдентификаторЭТрН, НомерДокумента = "") Экспорт

	Результат = Новый Структура("Идентификатор, Представление", "", "");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭТрН.КлючиСвязи КАК КлючиСвязи,
	|	ЭТрН.ДанныеДокумента КАК ДанныеДокумента
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	ЭТрН.ИдентификаторСБИС = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторЭТрН);

	ВыборкаЭТрН = Запрос.Выполнить().Выбрать();
	Если ВыборкаЭТрН.Следующий() Тогда

		// Штатная обработка Sbis1C связывает документы именно через
		// СопроводительныеДокументы.Отгрузка титула погрузки. Указанный там
		// идентификатор надёжнее номера и общих ключей пакета.
		Если ЗначениеЗаполнено(ВыборкаЭТрН.ДанныеДокумента) Тогда
			ДокументЭТрН = ЭАрМ_ОбщийМодульОбмен.УзелИзJSON(
				ВыборкаЭТрН.ДанныеДокумента);
			Для Каждого СвязанныйДокумент Из
				ЭАрМ_ОбщийМодульОбмен.СвязанныеДокументыЭТрН(
					ДокументЭТрН) Цикл

				Если СвязанныйДокумент.Роль <> "Отгрузка"
					ИЛИ НЕ ЗначениеЗаполнено(
						СвязанныйДокумент.Идентификатор) Тогда
					Продолжить;
				КонецЕсли;

				// УПД аннулировали, а титул ЭТрН по-прежнему указывает на неё:
				// ищем ту, что пришла взамен, по ключам и номеру
				Если ЭАрМ_УтверждениеСБИС.ДокументРеестраЗакрыт("ЭАрМ_УПД_Входящий",
					СокрЛП(СвязанныйДокумент.Идентификатор)) Тогда
					Продолжить;
				КонецЕсли;

				Результат.Идентификатор =
					СокрЛП(СвязанныйДокумент.Идентификатор);
				Результат.Представление = ?(
					ЗначениеЗаполнено(СвязанныйДокумент.Номер),
					СтрШаблон("УПД № %1", СвязанныйДокумент.Номер),
					СвязанныйДокумент.Наименование);
				Возврат Результат;

			КонецЦикла;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(ВыборкаЭТрН.КлючиСвязи) Тогда
			Возврат НайтиУПДВРеестреПоНомеру(НомерДокумента);
		КонецЕсли;

		Запрос.Текст =
		"ВЫБРАТЬ
		|	УПД.ИдентификаторСБИС КАК Идентификатор,
		|	УПД.Представление КАК Представление,
		|	УПД.КлючиСвязи КАК КлючиСвязи
		|ИЗ
		|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
		|ГДЕ
		|	УПД.КлючиСвязи <> """"
		|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УПД") + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	УПД.Дата УБЫВ";

		ВыборкаУПД = Запрос.Выполнить().Выбрать();
		Пока ВыборкаУПД.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(
				ЭАрМ_Служебный.СовпадениеКлючейСвязи(
					ВыборкаЭТрН.КлючиСвязи, ВыборкаУПД.КлючиСвязи)) Тогда
				Продолжить;
			КонецЕсли;

			Результат.Идентификатор = СокрЛП(ВыборкаУПД.Идентификатор);
			Результат.Представление = СокрЛП(ВыборкаУПД.Представление);
			Возврат Результат;
		КонецЦикла;

	КонецЕсли;

	Возврат НайтиУПДВРеестреПоНомеру(НомерДокумента);

КонецФункции

// Находит ЭТрН, выписанную по этой УПД.
//
// Зеркало НайтиУПДДляЭТрН: там от накладной идут к УПД, здесь - обратно.
// Связь в данных одна и та же, поэтому и порядок проверок тот же, от точного
// к приблизительному:
//   1. ссылка на УПД, уже проставленная в реестре ЭТрН разбором груза
//      или выгрузкой в Далион;
//   2. та же ссылка в строках товаров - реестр мог её не получить;
//   3. титул погрузки ЭТрН: СопроводительныеДокументы.Отгрузка указывает
//      УПД напрямую, это самый надёжный признак связи;
//   4. общие ключи пакета СБИС;
//   5. номер - у ЭТрН и её УПД он обычно совпадает.
//
// Шаги 3-5 идут одним перебором реестра: он ограничен глубиной запроса, и
// одна строка приходится на документ, а не на позицию товара. Разбор JSON
// дороже остальных проверок, поэтому документ разбирается только пока точное
// совпадение не найдено.
//
// Параметры:
//   ИдентификаторУПД - Строка - документ УПД в СБИС
//   НомерУПД         - Строка - номер УПД для сравнения номеров
//   КлючиСвязиУПД    - Строка - см. ЭАрМ_Служебный.КлючиСвязиДокумента
//
// Возвращаемое значение:
//   Структура:
//     * Идентификатор - Строка - ЭТрН в СБИС; пустая, если связь не нашлась
//     * Номер         - Строка - номер найденной ЭТрН
//
Функция НайтиЭТрНДляУПД(ИдентификаторУПД, НомерУПД = "", КлючиСвязиУПД = "") Экспорт

	Результат = Новый Структура("Идентификатор, Номер", "", "");

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭТрН.ИдентификаторСБИС КАК Идентификатор,
	|	ЭТрН.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	ЭТрН.ИдентификаторУПД = &ИдентификаторУПД
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("ЭТрН") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭТрН.Дата УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат КандидатЭТрНДляУПД(Выборка);
	КонецЕсли;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭТрН.ИдентификаторСБИС КАК Идентификатор,
	|	ЭТрН.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ПО ЭТрН.ИдентификаторСБИС = Товары.ИдентификаторСБИС
	|ГДЕ
	|	Товары.ИдентификаторУПД = &ИдентификаторУПД
	|	И Товары.ИсточникТоваров = &ИсточникЭТрН
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("ЭТрН") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭТрН.Дата УБЫВ";
	Запрос.УстановитьПараметр("ИсточникЭТрН", "ЭТрН");

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат КандидатЭТрНДляУПД(Выборка);
	КонецЕсли;

	// Перебор с разбором JSON каждой ЭТрН - самая дорогая часть: реестр ЭТрН
	// растёт, и на каждый выбор УПД в форме он читался целиком вместе с
	// ДанныеДокумента. ЭТрН одной поставки всегда рядом по дате с её УПД,
	// поэтому смотрим ±ОкноДней от даты УПД. Дату не узнали - весь реестр,
	// как раньше.
	ОкноДней = 60;
	ДатаУПД = ДатаДокументаУПДДляПоиска(ИдентификаторУПД);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭТрН.ИдентификаторСБИС КАК Идентификатор,
	|	ЭТрН.Номер КАК Номер,
	|	ЭТрН.КлючиСвязи КАК КлючиСвязи,
	|	ЭТрН.ДанныеПолучены КАК ДанныеПолучены,
	|	ЭТрН.ДанныеДокумента КАК ДанныеДокумента
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	(&БезОкна
	|			ИЛИ ЭТрН.Дата МЕЖДУ &НачалоОкна И &КонецОкна)
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("ЭТрН") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭТрН.Дата УБЫВ";
	Запрос.УстановитьПараметр("БезОкна", НЕ ЗначениеЗаполнено(ДатаУПД));
	Запрос.УстановитьПараметр("НачалоОкна",
		?(ЗначениеЗаполнено(ДатаУПД), НачалоДня(ДатаУПД) - ОкноДней * 86400, Дата(1, 1, 1)));
	Запрос.УстановитьПараметр("КонецОкна",
		?(ЗначениеЗаполнено(ДатаУПД), КонецДня(ДатаУПД) + ОкноДней * 86400, Дата(1, 1, 1)));

	ИскомыйНомер = ЭАрМ_Служебный.НомерДляСравнения(НомерУПД);

	// Разбор JSON каждой ЭТрН окна - больше половины времени выбора УПД в форме
	// (замеры 15.10.2026: ~0,8 с из 1,1 с, и у УПД без ЭТрН тоже). РольСвязиСУПД
	// ищет в связанных документах идентификатор УПД - нет его в тексте ЭТрН,
	// разбирать незачем, результат тот же. Идентификатор не только из латиницы и
	// цифр (в JSON мог стать \uXXXX) - разбор как раньше, без проверки текста
	ИскомыйИдентификатор = ВРег(СокрЛП(ИдентификаторУПД));
	ПроверятьТекст = ТолькоСимволыASCII(ИскомыйИдентификатор);

	ПоСсылке = Неопределено;
	ПоКлючам = Неопределено;
	ПоНомеру = Неопределено;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Выборка.ДанныеПолучены
			И (НЕ ПроверятьТекст ИЛИ СтрНайти(ВРег(Выборка.ДанныеДокумента), ИскомыйИдентификатор) > 0) Тогда

			Роль = РольСвязиСУПД(Выборка.ДанныеДокумента, ИдентификаторУПД);

			Если Роль = "Отгрузка" Тогда
				Возврат КандидатЭТрНДляУПД(Выборка);
			КонецЕсли;

			Если ЗначениеЗаполнено(Роль) И ПоСсылке = Неопределено Тогда
				ПоСсылке = КандидатЭТрНДляУПД(Выборка);
			КонецЕсли;

		КонецЕсли;

		Если ПоКлючам = Неопределено
			И ЗначениеЗаполнено(ЭАрМ_Служебный.СовпадениеКлючейСвязи(
				КлючиСвязиУПД, Выборка.КлючиСвязи)) Тогда
			ПоКлючам = КандидатЭТрНДляУПД(Выборка);
		КонецЕсли;

		Если ПоНомеру = Неопределено
			И ЗначениеЗаполнено(ИскомыйНомер)
			И ЭАрМ_Служебный.НомераСовпадают(Выборка.Номер, НомерУПД) Тогда
			ПоНомеру = КандидатЭТрНДляУПД(Выборка);
		КонецЕсли;

	КонецЦикла;

	Если ПоСсылке <> Неопределено Тогда
		Возврат ПоСсылке;
	КонецЕсли;

	Если ПоКлючам <> Неопределено Тогда
		Возврат ПоКлючам;
	КонецЕсли;

	Если ПоНомеру <> Неопределено Тогда
		Возврат ПоНомеру;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Дата документа УПД (или УКД) из реестра - для окна поиска ЭТрН.
//
// Возвращаемое значение:
//   Дата - пустая, если документа в реестрах нет
//
Функция ДатаДокументаУПДДляПоиска(ИдентификаторУПД)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.Дата КАК Дата
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.ИдентификаторСБИС = &ИдентификаторУПД
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УКД.Дата
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.ИдентификаторСБИС = &ИдентификаторУПД";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Дата) Тогда
			Возврат Выборка.Дата;
		КонецЕсли;
	КонецЦикла;

	Возврат Дата(1, 1, 1);

КонецФункции

// Ищет УПД в реестре по нормализованному номеру.
//
// Запрос сравнивает строки побайтно, а ЭАрМ_Служебный.НомерДляСравнения
// приводит номер к сопоставимому виду: верхний регистр, без пробелов, без "№"
// и без ведущих нулей. Тем же способом сравнивает документы поиск в СБИС
// (ЭАрМ_ОбщийМодульОбмен.НайтиУПДПоНомеру) - в регистрах правило должно быть
// то же, иначе одна и та же пара "ЭТрН - УПД" считается связанной на сервере
// и несвязанной в базе.
//
// Реестр УПД ограничен глубиной запроса, поэтому перебор дешёвый: одна строка
// на документ, а не на позицию товара.
//
// Возвращаемое значение:
//   Структура - Идентификатор, Представление; пусто, если не нашли
//
Функция УПДПоНормализованномуНомеру(НомерДокумента) Экспорт

	Результат = Новый Структура("Идентификатор, Представление", "", "");

	Искомый = ЭАрМ_Служебный.НомерДляСравнения(НомерДокумента);
	Если НЕ ЗначениеЗаполнено(Искомый) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК Идентификатор,
	|	УПД.Номер КАК Номер,
	|	УПД.Представление КАК Представление
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.Номер <> """"
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УПД") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	УПД.Дата УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если НЕ ЭАрМ_Служебный.НомераСовпадают(Выборка.Номер, НомерДокумента) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Идентификатор = СокрЛП(Выборка.Идентификатор);
		Результат.Представление = СокрЛП(Выборка.Представление);
		Прервать;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает раскрытый груз для JSON. Если в ЭТрН одна свёрнутая строка,
// а строки связанной УПД ещё не записаны, догружает УПД и повторяет подбор.
//
Функция ОбеспечитьТоварыУПДДляЭТрН(
		ИдентификаторСБИС, УзелДокумента) Экспорт

	РезультатГруза = ЭАрМ_ОбщийМодульОбмен.ПодобратьГрузПоРегистрам(
		ИдентификаторСБИС, УзелДокумента);

	ТоварыРаскрыты = Истина;
	РезультатГруза.Свойство("ТоварыРаскрыты", ТоварыРаскрыты);
	Если ТоварыРаскрыты Тогда
		Возврат РезультатГруза;
	КонецЕсли;

	НомерЭТрН = ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеУзла(УзелДокумента, "Номер", ""));
	СвязаннаяУПД = НайтиУПДДляЭТрН(ИдентификаторСБИС, НомерЭТрН);

	Если НЕ ЗначениеЗаполнено(СвязаннаяУПД.Идентификатор) Тогда
		РезультатГруза.Успех = Ложь;
		РезультатГруза.Ошибка = СтрШаблон(
			НСтр("ru = 'Товарный состав ЭТрН %1 не раскрыт: связанная УПД не найдена'"),
			НомерЭТрН);
		Возврат РезультатГруза;
	КонецЕсли;

	Если НЕ ДогрузитьТоварыУПД(
		СвязаннаяУПД.Идентификатор, НомерЭТрН) Тогда
		РезультатГруза.Успех = Ложь;
		РезультатГруза.Ошибка = СтрШаблон(
			НСтр("ru = 'УПД %1 найдена, но её товары не загружены. Проверьте журнал ЗагрузкаТоваровУПД'"),
			СвязаннаяУПД.Представление);
		Возврат РезультатГруза;
	КонецЕсли;

	РезультатГруза = ЭАрМ_ОбщийМодульОбмен.ПодобратьГрузПоРегистрам(
		ИдентификаторСБИС, УзелДокумента);

	Если РезультатГруза.Позиции.Количество() > 0 Тогда
		ОтметитьИсточникТоваров(ИдентификаторСБИС, РезультатГруза);
	КонецЕсли;

	ТоварыРаскрыты = Ложь;
	РезультатГруза.Свойство("ТоварыРаскрыты", ТоварыРаскрыты);
	Если НЕ ТоварыРаскрыты Тогда
		РезультатГруза.Успех = Ложь;
		РезультатГруза.Ошибка =
			НСтр("ru = 'После загрузки УПД товарный состав остался пустым'");
	КонецЕсли;

	Возврат РезультатГруза;

КонецФункции

// Выгружает в Далион один документ реестра - по данным регистров.
//
// В СБИС не ходит: и сам документ, и его груз, и строки УПД к этому моменту
// уже лежат в регистрах, их положило туда наполнение (см. ОбновитьРеестры).
// Если документа в регистре нет, выгрузка не состоится - это не ошибка
// связи, а признак того, что реестры не обновляли.
//
// Параметры:
//   ИдентификаторСБИС - Строка - документ в СБИС
//   Сессия            - Строка - оставлен для совместимости, не используется
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, ИмяФайла, ПутьВыгрузки, ТоваровВыгружено, ТекстJSON
//
Функция ВыгрузитьДокумент(ИдентификаторСБИС, Сессия = "") Экспорт

	Результат = Новый Структура(
		"Успех, Ошибка, ИмяФайла, ПутьВыгрузки, ТоваровВыгружено, ТекстJSON",
		Ложь, "", "", "", 0, "");

	Если НЕ ЗначениеЗаполнено(ИдентификаторСБИС) Тогда
		Результат.Ошибка = НСтр("ru = 'Не указан документ для выгрузки'");
		Возврат Результат;
	КонецЕсли;

	НастройкиОбмена = ЭАрМ_НастройкиСервер.НастройкиОбмена();
	Если НастройкиОбмена.ТолькоПриемИзДалиона Тогда
		Результат.Ошибка = НСтр(
			"ru = 'Отправка документов в Далион выключена: в настройках ЭДО включён только приём из result'");
		Возврат Результат;
	КонецЕсли;
	Направление = ЭАрМ_НастройкиСервер.ПараметрыОтбораСБИС().Направление;

	// --- 1. Берём документ из регистра и собираем груз по регистрам ---
	УзелДокумента = ДокументИзРеестра(ИдентификаторСБИС);

	Если УзелДокумента = Неопределено Тогда
		Результат.Ошибка = НСтр("ru = 'Документ не загружен в регистр. Обновите реестры ЭДО'");
		ОтметитьОшибкуВыгрузки(ИдентификаторСБИС, Результат.Ошибка);
		ЗаписатьВЖурнал(ИдентификаторСБИС, "Выгрузка", Ложь, Результат.Ошибка);
		Возврат Результат;
	КонецЕсли;

	РезультатГруза = ОбеспечитьТоварыУПДДляЭТрН(
		ИдентификаторСБИС, УзелДокумента);

	ДанныеНакладной = ЭАрМ_ОбщийМодульОбмен.ДанныеПриходнойНакладной(
		УзелДокумента, Направление, РезультатГруза);

	Если НЕ ДанныеНакладной.Успех Тогда
		Результат.Ошибка = ДанныеНакладной.Ошибка;
		ОтметитьОшибкуВыгрузки(ИдентификаторСБИС, Результат.Ошибка);
		ЗаписатьВЖурнал(ИдентификаторСБИС, "Выгрузка", Ложь, Результат.Ошибка);
		Возврат Результат;
	КонецЕсли;

	Результат.ТекстJSON = ЭАрМ_ОбщийМодульОбмен.СформироватьJSONДляДалион(ДанныеНакладной.Данные);
	Результат.ИмяФайла  = ЭАрМ_Служебный.ИмяФайлаВыгрузки(ДанныеНакладной.Данные);
	Результат.ТоваровВыгружено = ДанныеНакладной.Данные.ПриходнаяНакладная.Товары.Количество();

	// --- 2. Отмечаем в реестре, чем именно раскрыт состав ---
	// Сам груз в регистр не переписываем: он уже там, его положило наполнение

	// --- 3. Отправляем. Внешний вызов идёт вне транзакции ---
	Отправка = ОтправитьДанные(Результат.ТекстJSON, Результат.ИмяФайла, НастройкиОбмена);

	Результат.Успех = Отправка.Успех;
	Результат.Ошибка = Отправка.Ошибка;
	Результат.ПутьВыгрузки = Отправка.Путь;

	// --- 4. Отмечаем итог в реестре ---
	Если Результат.Успех Тогда
		ОтметитьВыгрузку(ИдентификаторСБИС, Результат, РезультатГруза);
		ЗаписатьВЖурнал(ИдентификаторСБИС, "Выгрузка", Истина,
			СтрШаблон(НСтр("ru = 'Выгружено строк: %1'"), Результат.ТоваровВыгружено),
			Результат.ИмяФайла);
	Иначе
		ОтметитьОшибкуВыгрузки(ИдентификаторСБИС, Результат.Ошибка);
		ЗаписатьВЖурнал(ИдентификаторСБИС, "Выгрузка", Ложь, Результат.Ошибка,
			Результат.ИмяФайла);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Готовит JSON приходной накладной, ничего не отправляя.
//
// Нужна команде "Показать JSON" формы реестра: посмотреть, что уйдёт
// в Далион, не отправляя и не меняя отметок о выгрузке.
//
// Параметры:
//   ИдентификаторСБИС - Строка - документ в СБИС
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, ИмяФайла, ТекстJSON, ТоваровВыгружено
//
Функция ПодготовитьJSON(ИдентификаторСБИС) Экспорт

	Результат = Новый Структура(
		"Успех, Ошибка, ИмяФайла, ТекстJSON, ТоваровВыгружено",
		Ложь, "", "", "", 0);

	УзелДокумента = ДокументИзРеестра(ИдентификаторСБИС);
	Если УзелДокумента = Неопределено Тогда
		Результат.Ошибка =
			НСтр("ru = 'Документ не загружен в регистр. Обновите реестры ЭДО'");
		Возврат Результат;
	КонецЕсли;

	Направление = ЭАрМ_НастройкиСервер.ПараметрыОтбораСБИС().Направление;
	РезультатГруза = ОбеспечитьТоварыУПДДляЭТрН(
		ИдентификаторСБИС, УзелДокумента);

	ДанныеНакладной = ЭАрМ_ОбщийМодульОбмен.ДанныеПриходнойНакладной(
		УзелДокумента, Направление, РезультатГруза);
	Если НЕ ДанныеНакладной.Успех Тогда
		Результат.Ошибка = ДанныеНакладной.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Результат.ТекстJSON =
		ЭАрМ_ОбщийМодульОбмен.СформироватьJSONДляДалион(
			ДанныеНакладной.Данные);
	Результат.ИмяФайла =
		ЭАрМ_Служебный.ИмяФайлаВыгрузки(ДанныеНакладной.Данные);
	Результат.ТоваровВыгружено =
		ДанныеНакладной.Данные.ПриходнаяНакладная.Товары.Количество();
	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// Перечитывает груз документа и обновляет регистр товаров.
//
// Команда "Показать груз" формы реестра: посмотреть строки документа,
// не выгружая его.
//
// Параметры:
//   ИдентификаторСБИС - Строка - документ в СБИС
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, Позиций
//
Функция ОбновитьТоварыДокумента(ИдентификаторСБИС) Экспорт

	Результат = Новый Структура("Успех, Ошибка, Позиций", Ложь, "", 0);

	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Результат.Ошибка = НСтр("ru = 'Не удалось авторизоваться в СБИС'");
		Возврат Результат;
	КонецЕсли;

	Направление = ЭАрМ_НастройкиСервер.ПараметрыОтбораСБИС().Направление;

	РезультатГруза = ЭАрМ_ОбщийМодульОбмен.ПодобратьГрузПоНомеру(
		ИдентификаторСБИС, Сессия, Направление);

	Если НЕ РезультатГруза.Успех Тогда
		Результат.Ошибка = РезультатГруза.Ошибка;
		Возврат Результат;
	КонецЕсли;

	ИсточникТоваров = "ЭТрН";
	РезультатГруза.Свойство("ИсточникТоваров", ИсточникТоваров);

	Если ИсточникТоваров = "УПД" Тогда
		// Раскрытые строки УПД уже хранятся под идентификатором самой УПД.
		// Под идентификатором ЭТрН сохраняем её собственный исходный груз,
		// иначе ветка "Товары ЭТрН" исчезает после ручного обновления.
		Если ЗначениеЗаполнено(РезультатГруза.ИдентификаторУПД) Тогда
			ЗаписатьТоварыЭТрН(
				РезультатГруза.ИдентификаторУПД, РезультатГруза,
				НомерИзРеестраПоИдентификатору(ИдентификаторСБИС));
			ОтметитьИсточникТоваров(ИдентификаторСБИС, РезультатГруза);
		КонецЕсли;

		ДокументЭТрН = ДокументИзРеестра(ИдентификаторСБИС);
		Если ДокументЭТрН <> Неопределено Тогда
			ИсходныйГруз = ЭАрМ_ОбщийМодульОбмен.ПолучитьГрузЭТрН(ДокументЭТрН);
			Если ИсходныйГруз.Успех
				И ИсходныйГруз.Позиции.Количество() > 0 Тогда
				ИсходныйГруз.Вставить("ИсточникТоваров", "ЭТрН");
				ЗаписатьТоварыЭТрН(ИдентификаторСБИС, ИсходныйГруз);
			КонецЕсли;
		КонецЕсли;
	Иначе
		ЗаписатьТоварыЭТрН(ИдентификаторСБИС, РезультатГруза);
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Позиций = РезультатГруза.Позиции.Количество();

	Возврат Результат;

КонецФункции

// Сбрасывает отметку о выгрузке, чтобы документ ушёл в Далион повторно.
//
// Параметры:
//   ИдентификаторСБИС - Строка - документ в СБИС
//
Процедура СброситьОтметкуВыгрузки(ИдентификаторСБИС) Экспорт

	НачатьТранзакцию();
	Попытка

		МенеджерЗаписи = МенеджерРеестраЭТрН(ИдентификаторСБИС);
		Если МенеджерЗаписи = Неопределено Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		МенеджерЗаписи.Выгружен         = Ложь;
		МенеджерЗаписи.ДатаВыгрузки     = '00010101';
		МенеджерЗаписи.ОшибкаВыгрузки   = "";
		МенеджерЗаписи.ПопытокВыгрузки  = 0;
		МенеджерЗаписи.Записать(Истина);

		ЗафиксироватьТранзакцию();
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторСБИС,
			"СброситьОтметкуВыгрузки (отметка выгрузки не снята)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

	ЗаписатьВЖурнал(ИдентификаторСБИС, "СбросВыгрузки", Истина,
		НСтр("ru = 'Отметка о выгрузке снята'"));

КонецПроцедуры

// Проверяет доступность СБИС: авторизуется и запрашивает одну строку реестра.
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, Сообщение
//
Функция ПроверитьПодключениеКСБИС() Экспорт

	Результат = Новый Структура("Успех, Ошибка, Сообщение", Ложь, "", "");

	ПроверкаНастроек = ЭАрМ_НастройкиСервер.ПроверитьЗаполнениеНастроекСБИС();
	Если НЕ ПроверкаНастроек.Успех Тогда
		Результат.Ошибка = ПроверкаНастроек.Ошибка;
		Возврат Результат;
	КонецЕсли;

	// Принудительно: проверка подключения должна проверять вход, а не то,
	// что в настройках лежит сохранённая сессия
	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию(Истина);
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Результат.Ошибка = НСтр("ru = 'Авторизация не прошла, см. журнал регистрации'");
		Возврат Результат;
	КонецЕсли;

	Отбор = ЭАрМ_НастройкиСервер.ПараметрыОтбораСБИС();
	Период = ПериодЗапроса(Отбор.ГлубинаДней);

	РезультатСписка = ЭАрМ_ОбщийМодульОбмен.ПолучитьСписокДокументов(
		Сессия, Отбор.ТипДокумента, Отбор.Направление, 0, 1,
		Период.ДатаС, Период.ДатаПо);

	Если НЕ РезультатСписка.Успех Тогда
		Результат.Ошибка = РезультатСписка.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Сообщение = СтрШаблон(
		НСтр("ru = 'СБИС отвечает. Сессия получена, документов на первой странице: %1'"),
		РезультатСписка.Документы.Количество());

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выгружает в Далион все документы реестра, которые ещё не выгружены.
//
Процедура ВыгрузитьНевыгруженные(Сессия, Итоги, НастройкиОбмена)

	МаксимумДокументов = ?(НастройкиОбмена.МаксимумДокументов > 0,
		НастройкиОбмена.МаксимумДокументов, 50);
	МаксимумПопыток = ?(НастройкиОбмена.МаксимумПопыток > 0,
		НастройкиОбмена.МаксимумПопыток, 3);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	Реестр.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК Реестр
	|ГДЕ
	|	НЕ Реестр.Выгружен
	|	И Реестр.ПопытокВыгрузки < &МаксимумПопыток
	|	И Реестр.ДанныеПолучены
	|
	|УПОРЯДОЧИТЬ ПО
	|	Реестр.Дата";
	Запрос.УстановитьПараметр("МаксимумПопыток", МаксимумПопыток);

	Выборка = Запрос.Выполнить().Выбрать();

	Обработано = 0;

	Пока Выборка.Следующий() Цикл

		Если Обработано >= МаксимумДокументов Тогда
			ДобавитьСообщение(Итоги, СтрШаблон(
				НСтр("ru = 'Достигнут предел документов за сеанс (%1), остальные уйдут следующим запуском'"),
				МаксимумДокументов));
			Прервать;
		КонецЕсли;

		//@skip-check query-in-loop
		РезультатВыгрузки = ВыгрузитьДокумент(Выборка.ИдентификаторСБИС, Сессия);

		Если РезультатВыгрузки.Успех Тогда
			Итоги.Выгружено = Итоги.Выгружено + 1;
		Иначе
			Итоги.ОшибокВыгрузки = Итоги.ОшибокВыгрузки + 1;
		КонецЕсли;

		Обработано = Обработано + 1;

	КонецЦикла;

	ДобавитьСообщение(Итоги, СтрШаблон(
		НСтр("ru = 'Выгружено в Далион: %1, с ошибкой: %2'"),
		Итоги.Выгружено, Итоги.ОшибокВыгрузки));

КонецПроцедуры

// Повторяет неудачные отправки и сверяет уже забранные ответы.
// Файлы из result читает ВыполнитьОбмен через ЗабратьОтветыДалион.
//
Процедура ОбработатьОтветыДалион(Итоги)

	Попытка
		ЭАрМ_ОбработкаПодтвержденийЭДО.ПовторитьНеудачныеОтправки();
		ЭАрМ_ОбработкаПодтвержденийЭДО.ОбработатьВходящиеЭТрНИзРегистра();
		ЭАрМ_ОбработкаПодтвержденийЭДО.СверитьСДалион();
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ДобавитьСообщение(Итоги, СтрШаблон(
			НСтр("ru = 'Разбор ответов Далиона: %1'"), ТекстОшибки));
		ЗаписатьВЖурнал("", "ОтветыДалион", Ложь, ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Записывает строку реестра ЭТрН, сохраняя отметки о выгрузке.
//
// Реестр перечитывается каждый сеанс, а отметки о выгрузке ставит только этот
// механизм: затирать их обновлением описательных полей нельзя, иначе документ
// уйдёт в Далион повторно.
//
Процедура ЗаписатьСтрокуРеестраЭТрН(ДокументРеестра, Направление)

	Идентификатор = ИдентификаторДокумента(ДокументРеестра);
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Стороны = ЭАрМ_ОбщийМодульОбмен.СтороныДокумента(ДокументРеестра, Направление);
	УзелСторон = ЭАрМ_Служебный.ЗначениеУзла(ДокументРеестра, "Стороны");
	РеквизитыКонтрагента = ЭАрМ_ОбщийМодульОбмен.РеквизитыСтороны(
		ЭАрМ_Служебный.СторонаПоНаправлению(ДокументРеестра, УзелСторон, Направление, Ложь));

	НачатьТранзакцию();
	Попытка

		ЗаблокироватьСтрокуРеестра("РегистрСведений.ЭАрМ_РеестрЭТрН", Идентификатор);

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_РеестрЭТрН.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
		МенеджерЗаписи.Прочитать();

		ЭтоНоваяСтрока = НЕ МенеджерЗаписи.Выбран();

		// Прочитать() очищает поля, если записи нет, - измерение задаём снова
		МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;

		МенеджерЗаписи.Номер       = Лев(ЗначениеСтрокой(ДокументРеестра, "Номер"), 50);
		МенеджерЗаписи.Дата        = ДатаДокументаСоВременемСоздания(ДокументРеестра);
		МенеджерЗаписи.Название    = Лев(ЗначениеСтрокой(ДокументРеестра, "Название"), 150);
		ЗаписатьСостояниеСБИС(МенеджерЗаписи, ДокументРеестра);
		// Сводка титулов - по тем же данным реестра: Подстановки запрашиваются
		// в списке (см. ДопПоляСписка), отдельно документ читать не нужно
		МенеджерЗаписи.СостояниеТитулов = Лев(
			ЭАрМ_ОбщийМодульОбмен.СводкаТитуловЭТрН(ДокументРеестра), 500);
		Если ЭАрМ_УтверждениеСБИС.ДокументЗакрытВСБИС(МенеджерЗаписи.КодСостояния, МенеджерЗаписи.Состояние) Тогда
			МенеджерЗаписи.МожноУтвердить = Ложь;
		КонецЕсли;
		// Отметку не снимаем: после утверждения СБИС ещё меняет название состояния
		ОтметитьПодписьПоСостоянию(МенеджерЗаписи);
		МенеджерЗаписи.Организация = Лев(Стороны.Организация, 200);
		МенеджерЗаписи.Контрагент  = Лев(Стороны.Контрагент, 200);
		МенеджерЗаписи.ИННКонтрагента = Лев(РеквизитыКонтрагента.ИНН, 20);
		МенеджерЗаписи.Направление = Направление;
		МенеджерЗаписи.АдресДоставки = Лев(
			ЭАрМ_ОбщийМодульОбмен.АдресДоставкиДокумента(ДокументРеестра), 500);
		МенеджерЗаписи.КлючиСвязи = Лев(
			ЭАрМ_Служебный.КлючиСвязиДокумента(ДокументРеестра), 500);

		Если ЭтоНоваяСтрока Тогда
			МенеджерЗаписи.ДатаЗагрузки = ТекущаяДатаСеанса();
			МенеджерЗаписи.Выгружен = Ложь;
		КонецЕсли;

		МенеджерЗаписи.Записать(Истина);

		ЗафиксироватьТранзакцию();
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ЗаписатьСтрокуРеестраЭТрН (строка реестра ЭТрН не записана)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Записывает строку реестра УПД.
//
// Записывает строки товаров УПД в регистр ЭАрМ_ТоварыЭТрН.
//
// Одна строка регистра - одна позиция номенклатуры. Ключ строки:
// ИдентификаторСБИС самой УПД плюс номер позиции; ИсточникТоваров = "УПД"
// отличает их от строк, разобранных из ЭТрН.
//
// Без этого регистровый подбор товаров по номеру (см.
// ТоварыУПДИзРегистраПоНомеру) не находил бы ничего до первой выгрузки:
// раньше строки УПД писались только под уид ЭТрН и только при выгрузке.
//
// Ни в СБИС, ни в запросы эта процедура больше не ходит: и проверку "товары
// уже есть", и номер документа вызывающий получает одним запросом на весь
// список - см. ДокументыУПДБезТоваров.
//
// Параметры:
//   ИдентификаторУПД - Строка - документ УПД в СБИС
//   НомерДокумента   - Строка - номер, которым помечаются строки товаров
//   ТоварыУПД        - Структура - см. ЭАрМ_ОбщийМодульОбмен.ПолучитьТоварыУПД
//
Процедура ЗаписатьТоварыУПД(ИдентификаторУПД, НомерДокумента, ТоварыУПД) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат;
	КонецЕсли;

	ЭтоКорректировка = ТоварыУПД.Свойство("ЭтоКорректировка") И ТоварыУПД.ЭтоКорректировка = Истина;

	РезультатГруза = ЭАрМ_Служебный.НовыйРезультатГруза();
	РезультатГруза.Успех = Истина;
	РезультатГруза.Идентификатор = Строка(ИдентификаторУПД);
	РезультатГруза.Позиции = ЭАрМ_ОбщийМодульОбмен.ПозицииИзТоваровУПД(ТоварыУПД.Товары);
	РезультатГруза.Вставить("ИсточникТоваров",
		?(ЭтоКорректировка, ЭАрМ_КорректировкиУПД.ИсточникТоваровКорректировки(), "УПД"));
	РезультатГруза.Вставить("ИдентификаторУПД", Строка(ИдентификаторУПД));

	// Строка УКД правит строку исходной УПД с тем же номером: номер позиции
	// берём из НомСтр, а не по порядку в корректировке
	Если ЭтоКорректировка Тогда
		ПронумероватьСтрокиКорректировки(РезультатГруза.Позиции, ТоварыУПД.Товары);
	КонецЕсли;

	ЗаписатьТоварыЭТрН(ИдентификаторУПД, РезультатГруза, НомерДокумента);

	// УКД: по каждой строке - как определён признак (уменьшение / увеличение / убрана)
	Если ЭтоКорректировка Тогда
		Для Каждого СтрокаУКД Из ТоварыУПД.Товары Цикл
			ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторУПД, СтрШаблон(
				"УКД № %1 загружена, строка %2 «%3»: кол-во %4 -> %5, сумма с НДС %6 -> %7 -> признак «%8» | КАК ОПРЕДЕЛЕНО: %9",
				НомерДокумента, СтрокаУКД.НомерСтроки, Лев(СтрокаУКД.Наименование, 60),
				СтрокаУКД.КоличествоДо, СтрокаУКД.Количество, СтрокаУКД.СуммаСНДСДо, СтрокаУКД.СуммаСНДС,
				СтрокаУКД.ПризнакИзменения, ПравилоПризнакаУКД(СтрокаУКД)));
		КонецЦикла;
	КонецЕсли;

	Если ЭтоКорректировка Тогда
		ЭАрМ_КорректировкиУПД.ЗафиксироватьРеквизитыКорректировки(ИдентификаторУПД, ТоварыУПД);
	КонецЕсли;

КонецПроцедуры

// Номера позиций строк УКД - номера строк исправляемой УПД. Повтор номера
// (разметку ФНС тоже заполняют с ошибками) уходит за пределы нумерации УПД,
// чтобы не нарушить ключ регистра товаров.
//
// Правило, по которому ЭАрМ_Служебный.ПризнакИзмененияУКД дал признак строке УКД, - словами.
//
Функция ПравилоПризнакаУКД(СтрокаУКД)

	Если СтрокаУКД.Количество = 0 И СтрокаУКД.КоличествоДо <> 0 Тогда
		Возврат "количество после 0 при количестве до " + СтрокаУКД.КоличествоДо + " - товар убран";
	КонецЕсли;
	Если СтрокаУКД.СуммаСНДСДо <> 0 И СтрокаУКД.СуммаСНДС <> СтрокаУКД.СуммаСНДСДо Тогда
		Возврат "по стоимости с НДС (есть «до»): после " + ?(СтрокаУКД.СуммаСНДС < СтрокаУКД.СуммаСНДСДо,
			"меньше - уменьшение", "больше - увеличение");
	КонецЕсли;
	Если СтрокаУКД.Количество <> СтрокаУКД.КоличествоДо Тогда
		Возврат ?(СтрокаУКД.СуммаСНДСДо = 0, "стоимости «до» нет - ", "стоимость та же - ") + "по количеству: после "
			+ ?(СтрокаУКД.Количество < СтрокаУКД.КоличествоДо, "меньше - уменьшение", "больше - увеличение");
	КонецЕсли;

	Возврат "стоимость и количество не изменились - без изменений";

КонецФункции

Процедура ПронумероватьСтрокиКорректировки(Позиции, СтрокиУКД)

	Занятые = Новый Соответствие;

	Для Индекс = 0 По Мин(Позиции.ВГраница(), СтрокиУКД.ВГраница()) Цикл

		НомерСтроки = СтрокиУКД[Индекс].НомерСтроки;
		Если НомерСтроки <= 0 ИЛИ Занятые.Получить(НомерСтроки) <> Неопределено Тогда
			НомерСтроки = 10000 + Индекс;
		КонецЕсли;

		Занятые.Вставить(НомерСтроки, Истина);
		Позиции[Индекс].НомерСтроки = НомерСтроки;

	КонецЦикла;

КонецПроцедуры

// Сколько документов пишем одной транзакцией.
//
// Порция - это компромисс: чем она больше, тем меньше транзакций, но тем
// дольше держатся блокировки и тем больше товаров висит в памяти. Полсотни
// документов - это порядка нескольких тысяч строк, немного.
//
Функция РазмерПорцииЗаписиТоваров()

	Возврат 50;

КонецФункции

// Состояние прохода по списку документов.
//
// Держит то, что живёт дольше одного документа: сессию (её обновляем на
// ходу) и кеш соединений на всю пачку.
//
// Имя не "Состояние": так называется метод глобального контекста, и путать
// их в чтении кода ни к чему.
//
// Возвращаемое значение:
//   Структура:
//     * Сессия        - Строка - sid, меняется при переавторизации
//     * КешСоединений - Соответствие - см. ЭАрМ_Служебный.НовыйКешСоединенийСБИС
//
Функция НовоеСостояниеЗагрузкиТоваров(Сессия)

	СостояниеЗагрузки = Новый Структура;
	СостояниеЗагрузки.Вставить("Сессия",        Сессия);
	СостояниеЗагрузки.Вставить("КешСоединений", ЭАрМ_Служебный.НовыйКешСоединенийСБИС());

	Возврат СостояниеЗагрузки;

КонецФункции

// Забирает товары одного документа. Только сеть, базу не трогает.
//
// Возвращаемое значение:
//   Структура - см. ЭАрМ_ОбщийМодульОбмен.ПолучитьТоварыУПД
//   Неопределено - товаров нет либо документ не прочитался
//
Функция ПолучитьТоварыДокументаУПД(СтрокаДокумента, СостояниеЗагрузки)

	Попытка

		ТоварыУПД = ЭАрМ_ОбщийМодульОбмен.ПолучитьТоварыУПД(
			СтрокаДокумента.Идентификатор, СостояниеЗагрузки.Сессия, ,
			СостояниеЗагрузки.КешСоединений);

		Если НЕ ТоварыУПД.Успех
			И ЭАрМ_ОбщийМодульОбмен.ЭтоОшибкаСессии(ТоварыУПД.Ошибка) Тогда

			СостояниеЗагрузки.Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию(Истина);

			Если ЗначениеЗаполнено(СостояниеЗагрузки.Сессия) Тогда
				ТоварыУПД = ЭАрМ_ОбщийМодульОбмен.ПолучитьТоварыУПД(
					СтрокаДокумента.Идентификатор, СостояниеЗагрузки.Сессия, ,
					СостояниеЗагрузки.КешСоединений);
			КонецЕсли;

		КонецЕсли;

		Если ТоварыУПД.Успех И ТоварыУПД.Товары.Количество() > 0 Тогда
			Возврат ТоварыУПД;
		КонецЕсли;

		ЗаписатьВЖурнал(СтрокаДокумента.Идентификатор, "ЗагрузкаТоваровУПД", Ложь,
			?(ЗначениеЗаполнено(ТоварыУПД.Ошибка), ТоварыУПД.Ошибка,
				НСтр("ru = 'XML УПД прочитан, но строки товаров не найдены'")));

	Исключение
		ЗаписатьВЖурнал(СтрокаДокумента.Идентификатор, "ЗагрузкаТоваровУПД", Ложь,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Сохраняет товары УПД, разобрав вложение по ссылке из строки списка.
//
// Список запрашивается с ДопПоля "Вложение", поэтому ссылка на XML приходит
// вместе со страницей и читать документ в СБИС не нужно. Скачать сам файл
// всё равно придётся: строки товаров УПД лежат только в нём, и одним
// запросом на всех их не получить.
//
// Товары ложатся в тот же регистр ЭАрМ_ТоварыЭТрН, что и груз ЭТрН, но с
// типом "УПД" и своим идентификатором. Номер документа проставляется в
// каждой строке - по нему сопоставление и находит УПД к нужной ЭТрН.
//
// Возвращаемое значение:
//   Булево - Истина, если товары разобраны и записаны
//
Функция СохранитьТоварыУПДИзСписка(ДокументРеестра, Сессия, КешСоединений)

	Идентификатор = ИдентификаторДокумента(ДокументРеестра);
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Ложь;
	КонецЕсли;

	ТоварыУПД = ЭАрМ_ОбщийМодульОбмен.ТоварыУПДИзУзлаДокумента(
		ДокументРеестра, Сессия, , КешСоединений);

	Если НЕ ТоварыУПД.Успех ИЛИ ТоварыУПД.Товары.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	// ЗаписатьТоварыЭТрН внутри управляет транзакцией и блокировкой.
	ЗаписатьТоварыУПД(Идентификатор,
		ЗначениеСтрокой(ДокументРеестра, "Номер"), ТоварыУПД);

	Возврат Истина;

КонецФункции

// Сохраняет документ и его груз прямо из строки списка реестра.
//
// Список запрашивается с ДопПоля "Подстановки", а груз ЭТрН лежит именно
// там - значит товары всей страницы уже пришли одним запросом, и читать
// каждый документ отдельно незачем. Товары складываются в общий регистр
// ЭАрМ_ТоварыЭТрН с типом "ЭТрН" и номером документа: по этому номеру
// сопоставление потом находит к ним строки УПД.
//
// Возвращаемое значение:
//   Булево - Истина, если груз в строке списка нашёлся и всё записано.
//            Ложь - титулов в списке нет, документ надо дочитывать
//
Функция СохранитьДокументИТоварыЭТрН(ДокументРеестра)

	Идентификатор = ИдентификаторДокумента(ДокументРеестра);
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Ложь;
	КонецЕсли;

	РезультатГруза = ЭАрМ_ОбщийМодульОбмен.ПолучитьГрузЭТрН(ДокументРеестра);

	Если НЕ РезультатГруза.Успех Тогда
		Возврат Ложь;
	КонецЕсли;

	Элемент = Новый Структура("Идентификатор, Номер, Документ",
		Идентификатор, ЗначениеСтрокой(ДокументРеестра, "Номер"), ДокументРеестра);

	НачатьТранзакцию();
	Попытка
		ЗаписатьДокументЭТрН(Элемент);
		ЗафиксироватьТранзакцию();
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"СохранитьДокументИТоварыЭТрН (ЭТрН и её товары не записаны)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Читает документ ЭТрН целиком. Только сеть, базу не трогает.
//
// Возвращаемое значение:
//   Соответствие - узел документа
//   Неопределено - не прочитался
//
Функция ПрочитатьДокументЭТрН(СтрокаДокумента, СостояниеЗагрузки)

	Попытка

		ДанныеДокумента = ЭАрМ_ОбщийМодульОбмен.ПрочитатьДокумент(
			СтрокаДокумента.Идентификатор, СостояниеЗагрузки.Сессия, , , СостояниеЗагрузки.КешСоединений);

		Если НЕ ДанныеДокумента.Успех
			И ЭАрМ_ОбщийМодульОбмен.ЭтоОшибкаСессии(ДанныеДокумента.Ошибка) Тогда

			СостояниеЗагрузки.Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию(Истина);

			Если ЗначениеЗаполнено(СостояниеЗагрузки.Сессия) Тогда
				ДанныеДокумента = ЭАрМ_ОбщийМодульОбмен.ПрочитатьДокумент(
					СтрокаДокумента.Идентификатор, СостояниеЗагрузки.Сессия, , , СостояниеЗагрузки.КешСоединений);
			КонецЕсли;

		КонецЕсли;

		Если ДанныеДокумента.Успех И ДанныеДокумента.Документ <> Неопределено Тогда
			Возврат ДанныеДокумента.Документ;
		КонецЕсли;

		ЗаписатьВЖурнал(СтрокаДокумента.Идентификатор, "ЗагрузкаДокументовЭТрН", Ложь,
			ДанныеДокумента.Ошибка);

	Исключение
		ЗаписатьВЖурнал(СтрокаДокумента.Идентификатор, "ЗагрузкаДокументовЭТрН", Ложь,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Пишет порцию товаров дочитанных документов УПД.
//
// В реестр ложится узел документа, в регистр товаров - его груз. Груз
// пишется с ИсточникТоваров = "ЭТрН": строки УПД лежат там же, но под своим
// идентификатором и своим источником, и одно другое не затирает.
//
// Возвращаемое значение:
//   Число - сколько документов записано
//
Функция ЗаписатьПорциюДокументовЭТрН(Порция)

	Если Порция.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		Для Каждого Элемент Из Порция Цикл
			ЗаписатьДокументЭТрН(Элемент);
		КонецЦикла;

		ЗафиксироватьТранзакцию();

		Возврат Порция.Количество();

	Исключение

		ОтменитьТранзакцию();

		ЗаписатьВЖурнал("", "ЗагрузкаДокументовЭТрН", Ложь, СтрШаблон(
			НСтр("ru = 'Порция из %1 документов не записана, пишем по одному: %2'"),
			Порция.Количество(),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));

	КонецПопытки;

	Записано = 0;

	Для Каждого Элемент Из Порция Цикл

		// Транзакция нужна каждому: ЗаписатьДокументЭТрН ставит управляемую
		// блокировку, а вне транзакции она не ставится
		НачатьТранзакцию();
		Попытка
			ЗаписатьДокументЭТрН(Элемент);
			ЗафиксироватьТранзакцию();
			Записано = Записано + 1;
		Исключение
			ОтменитьТранзакцию();
			ЗаписатьВЖурнал(Элемент.Идентификатор, "ЗагрузкаДокументовЭТрН", Ложь,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Возврат Записано;

КонецФункции

// Кладёт узел документа в реестр, а его груз - в регистр товаров.
//
Процедура ЗаписатьДокументЭТрН(Элемент)

	МенеджерЗаписи = МенеджерРеестраЭТрН(Элемент.Идентификатор);
	Если МенеджерЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстУзла = ЭАрМ_ОбщийМодульОбмен.ТекстJSONУзла(Элемент.Документ);

	МенеджерЗаписи.ДанныеДокумента = ТекстУзла;
	// Отбирать документы по самому полю нельзя: оно неограниченной длины,
	// а такие поля запрос сравнивать не умеет - отсюда отдельный признак
	МенеджерЗаписи.ДанныеПолучены = ЗначениеЗаполнено(ТекстУзла);
	// Полный документ содержит все титулы - сводку уточняем по нему
	МенеджерЗаписи.СостояниеТитулов = Лев(
		ЭАрМ_ОбщийМодульОбмен.СводкаТитуловЭТрН(Элемент.Документ), 500);
	МенеджерЗаписи.Записать(Истина);

	РезультатГруза = ЭАрМ_ОбщийМодульОбмен.ПолучитьГрузЭТрН(Элемент.Документ);

	Если РезультатГруза.Успех И РезультатГруза.Позиции.Количество() > 0 Тогда
		РезультатГруза.Вставить("ИсточникТоваров", "ЭТрН");
		ЗаписатьТоварыЭТрН(Элемент.Идентификатор, РезультатГруза, Элемент.Номер);
	КонецЕсли;

КонецПроцедуры

// Пишет собранную порцию товаров одной транзакцией.
//
// Каждый документ пишет ЗаписатьТоварыЭТрН в собственной транзакции:
// один битый документ не должен отменять товары остальных документов.
//
// Возвращаемое значение:
//   Число - сколько документов записано
//
Функция ЗаписатьПорциюТоваровУПД(Порция)

	Если Порция.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Записано = 0;

	// ЗаписатьТоварыЭТрН управляет собственной транзакцией. Внешняя
	// транзакция здесь приводила к двойному откату при ошибке одной УПД,
	// после чего резервная запись остальных документов не выполнялась.
	Для Каждого Элемент Из Порция Цикл
		Попытка
			ЗаписатьТоварыУПД(Элемент.Идентификатор, Элемент.Номер, Элемент.Товары);
			Записано = Записано + 1;
		Исключение
			ЗаписатьВЖурнал(Элемент.Идентификатор, "ЗагрузкаТоваровУПД", Ложь,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Возврат Записано;

КонецФункции

// Собирает описание найденной ЭТрН из строки выборки.
//
Функция КандидатЭТрНДляУПД(Выборка)

	Возврат Новый Структура("Идентификатор, Номер",
		СокрЛП(Выборка.Идентификатор), СокрЛП(Выборка.Номер));

КонецФункции

// Строка только из символов с кодом меньше 128 (латиница, цифры, знаки): такой
// текст JSON пишет как есть, без \uXXXX.
//
Функция ТолькоСимволыASCII(Текст)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если КодСимвола(Текст, Позиция) > 127 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат ЗначениеЗаполнено(Текст);

КонецФункции

// Ищет УПД среди связанных документов сохранённой ЭТрН.
//
// Роль возвращается, а не признак "да/нет": "Отгрузка" - это прямое указание
// титула погрузки, остальные роли слабее и годятся лишь как запасной вариант.
//
// Параметры:
//   ДанныеДокумента  - Строка - сохранённый узел ЭТрН в JSON
//   ИдентификаторУПД - Строка - искомый документ УПД в СБИС
//
// Возвращаемое значение:
//   Строка - роль связи; пустая, если этой УПД среди связанных нет
//
Функция РольСвязиСУПД(ДанныеДокумента, ИдентификаторУПД)

	ДокументЭТрН = ЭАрМ_ОбщийМодульОбмен.УзелИзJSON(ДанныеДокумента);
	Если ДокументЭТрН = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	НайденнаяРоль = "";
	Искомый = ВРег(СокрЛП(ИдентификаторУПД));

	Для Каждого СвязанныйДокумент Из
		ЭАрМ_ОбщийМодульОбмен.СвязанныеДокументыЭТрН(ДокументЭТрН) Цикл

		Если ВРег(СокрЛП(СвязанныйДокумент.Идентификатор)) <> Искомый Тогда
			Продолжить;
		КонецЕсли;

		Если СвязанныйДокумент.Роль = "Отгрузка" Тогда
			Возврат "Отгрузка";
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(НайденнаяРоль) Тогда
			НайденнаяРоль = СвязанныйДокумент.Роль;
		КонецЕсли;

	КонецЦикла;

	Возврат НайденнаяРоль;

КонецФункции

// Достаёт номер документа из реестров по его идентификатору.
//
// Строки товаров ищутся по номеру, поэтому он проставляется в каждой строке.
// Документ может лежать в реестре ЭТрН, УПД или УКД - смотрим все.
//
Функция НомерИзРеестраПоИдентификатору(ИдентификаторСБИС)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭТрН.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	ЭТрН.ИдентификаторСБИС = &Идентификатор
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	УПД.Номер
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.ИдентификаторСБИС = &Идентификатор
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	УКД.Номер
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.ИдентификаторСБИС = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторСБИС);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Номер) Тогда
			Возврат СокрЛП(Выборка.Номер);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Процедура ЗаписатьСтрокуРеестраУПД(ДокументРеестра, ТипРеестра)

	Идентификатор = ИдентификаторДокумента(ДокументРеестра);
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	// Во "Входящих" контрагент - отправитель, в "Отправленных" - получатель
	Направление = ?(ТипРеестра = "Отправленные", "Исходящий", "Входящий");
	Стороны = ЭАрМ_ОбщийМодульОбмен.СтороныДокумента(ДокументРеестра, Направление);

	// ИНН нужен цепочке закупки: по нему поступление Далиона связывается с УПД,
	// когда входящий номер введён с ошибкой. Берём так же, как реестр ЭТрН.
	УзелСторон = ЭАрМ_Служебный.ЗначениеУзла(ДокументРеестра, "Стороны");
	РеквизитыКонтрагента = ЭАрМ_ОбщийМодульОбмен.РеквизитыСтороны(
		ЭАрМ_Служебный.СторонаПоНаправлению(ДокументРеестра, УзелСторон, Направление, Ложь));
	// ИНН нашей организации - по нему выгрузка в Бухгалтерию находит организацию
	// надёжнее, чем по названию из СБИС
	РеквизитыОрганизации = ЭАрМ_ОбщийМодульОбмен.РеквизитыСтороны(
		ЭАрМ_Служебный.СторонаПоНаправлению(ДокументРеестра, УзелСторон, Направление, Истина));

	// Поле "Название" поставщик заполняет произвольно, а имена файлов ФНС
	// кодируют вид документа однозначно - формат берём по вложениям
	ФорматДокумента = Лев(ЭАрМ_Служебный.ФорматДокументаПоВложениям(ДокументРеестра), 50);

	// Корректировки (УКД) приходят тем же реестром СБИС, но хранятся в своём
	// регистре: в списке УПД их быть не должно. Уже перенесённая по XML
	// корректировка остаётся там, даже если имя вложения её не выдаёт
	ЭтоКорректировка = ФорматДокумента = ЭАрМ_КорректировкиУПД.ФорматКорректировки()
		ИЛИ ЭАрМ_КорректировкиУПД.ЕстьВРеестреКорректировок(Идентификатор);
	Если ЭтоКорректировка Тогда
		ЭАрМ_КорректировкиУПД.ПеренестиВРеестрКорректировок(Идентификатор);
	КонецЕсли;
	ИмяРегистра = ?(ЭтоКорректировка, "ЭАрМ_УКД_Входящий", "ЭАрМ_УПД_Входящий");

	НачатьТранзакцию();
	Попытка

		ЗаблокироватьСтрокуРеестра("РегистрСведений." + ИмяРегистра, Идентификатор);

		МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
		МенеджерЗаписи.Прочитать();

		ЭтоНоваяСтрока = НЕ МенеджерЗаписи.Выбран();
		ПрежняяДатаУПД = МенеджерЗаписи.Дата;
		МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;

		МенеджерЗаписи.Номер         = Лев(ЗначениеСтрокой(ДокументРеестра, "Номер"), 50);
		МенеджерЗаписи.Дата          = ДатаДокументаСоВременемСоздания(ДокументРеестра);
		МенеджерЗаписи.Наименование  = Лев(ЗначениеСтрокой(ДокументРеестра, "Название"), 150);
		МенеджерЗаписи.Представление = Лев(
			ЭАрМ_Служебный.ПредставлениеДокументаЭДО(ДокументРеестра), 150);
		// У корректировки формат один, поля под него в реестре УКД нет
		Если НЕ ЭтоКорректировка Тогда
			МенеджерЗаписи.Формат    = ФорматДокумента;
			// Время создания в СБИС: поставщик может прислать УПД с тем же
			// номером на замену - последней считается созданная позже.
			// Не пришло - прежнее значение не затираем. В Дата оно же пишется,
			// если у даты документа времени не было
			ДатаВремяСБИС = ДатаВремяСозданияСБИС(ДокументРеестра);
			Если ЗначениеЗаполнено(ДатаВремяСБИС) Тогда
				МенеджерЗаписи.ДатаВремяСБИС = ДатаВремяСБИС;
			КонецЕсли;
		КонецЕсли;
		ЗаписатьСостояниеСБИС(МенеджерЗаписи, ДокументРеестра);
		ОтметитьПодписьПоСостоянию(МенеджерЗаписи);
		МенеджерЗаписи.Организация   = Лев(Стороны.Организация, 200);
		МенеджерЗаписи.Контрагент    = Лев(Стороны.Контрагент, 200);
		МенеджерЗаписи.ИННКонтрагента = Лев(РеквизитыКонтрагента.ИНН, 20);
		// Только УПД (у реестра УКД поля нет). Пустой ИНН (СБИС не дал) прежнее значение не затирает
		Если НЕ ЭтоКорректировка И ЗначениеЗаполнено(РеквизитыОрганизации.ИНН) Тогда
			МенеджерЗаписи.ИННОрганизации = Лев(РеквизитыОрганизации.ИНН, 20);
		КонецЕсли;
		МенеджерЗаписи.ТипРеестра    = Лев(ТипРеестра, 30);
		МенеджерЗаписи.КлючиСвязи    = Лев(
			ЭАрМ_Служебный.КлючиСвязиДокумента(ДокументРеестра), 500);

		Если ЭтоНоваяСтрока Тогда
			МенеджерЗаписи.ДатаЗагрузки = ТекущаяДатаСеанса();
		КонецЕсли;

		// Дата оплаты - от договора поставщика в УТ; только УПД. Считаем у новой
		// строки, у строки без даты и при смене даты УПД: остальные пересчитывает
		// приём договора (ЭАрМ_ПриемПакетовДалион.ЗагрузитьДоговорыВУТ)
		Если НЕ ЭтоКорректировка И ТипРеестра <> "Отправленные"
			И (ЭтоНоваяСтрока ИЛИ НЕ ЗначениеЗаполнено(МенеджерЗаписи.ДатаОплаты)
				ИЛИ НачалоДня(ПрежняяДатаУПД) <> НачалоДня(МенеджерЗаписи.Дата)) Тогда
			Расчет = ЭАрМ_ВыгрузкаНакладныхДляБух.РасчетДатыОплатыУПД(МенеджерЗаписи.ИННКонтрагента,
				МенеджерЗаписи.Организация, МенеджерЗаписи.ИННОрганизации, МенеджерЗаписи.Дата);
			МенеджерЗаписи.ДатаОплаты = ?(Расчет.Найден, Расчет.ДатаПлатежа, Дата(1, 1, 1));
		КонецЕсли;

		МенеджерЗаписи.Записать(Истина);

		ЗафиксироватьТранзакцию();
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ЗаписатьСтрокуРеестраУПД (строка реестра УПД не записана)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Собирает позицию груза из строки регистра товаров.
//
// Обратное преобразование к ЗаписатьТоварыЭТрН: строки регистра снова
// становятся позициями в том виде, который понимают ЭАрМ_Служебный.ТоварыДляДалион
// и ШтрихкодыУпаковокДляДалион.
//
Функция ПозицияИзЗаписиРегистра(ЗаписьРегистра)

	Позиция = Новый Структура;
	Позиция.Вставить("НомерСтроки",      Число(ЗаписьРегистра.НомерПозиции));
	Позиция.Вставить("Наименование",     ЗаписьРегистра.Наименование);
	Позиция.Вставить("Номенклатура",     ЗаписьРегистра.КодНоменклатуры);
	Позиция.Вставить("Артикул",          ЗаписьРегистра.Артикул);
	Позиция.Вставить("ЕдиницаИзмерения", ЗаписьРегистра.ЕдиницаИзмерения);
	Позиция.Вставить("СпособУпаковки",   ЗаписьРегистра.СпособУпаковки);
	Позиция.Вставить("КоличествоМест",   ЗаписьРегистра.КоличествоМест);
	Позиция.Вставить("Цена",             ЗаписьРегистра.Цена);
	Позиция.Вставить("Стоимость",        ЗаписьРегистра.Сумма);
	Позиция.Вставить("СтавкаНДС",        ЗаписьРегистра.СтавкаНДС);
	Позиция.Вставить("СуммаНДС",         ЗаписьРегистра.СуммаНДС);
	Позиция.Вставить("МассаБрутто",      ЗаписьРегистра.МассаБрутто);
	Позиция.Вставить("МассаНетто",       ЗаписьРегистра.МассаНетто);
	Позиция.Вставить("КодВалюты",        ЗаписьРегистра.КодВалюты);

	// Тары в регистре нет - в ЭТрН она приходит только вместе с грузом
	Позиция.Вставить("ТараКод", "");

	Маркировки = Новый Массив;
	СтрокиМаркировок = СтрРазделить(ЗаписьРегистра.Маркировки, Символы.ПС, Ложь);
	Для Каждого КодМаркировки Из СтрокиМаркировок Цикл
		Маркировки.Добавить(СокрЛП(КодМаркировки));
	КонецЦикла;
	Позиция.Вставить("Маркировки", Маркировки);

	Контейнеры = Новый Массив;
	НомераКонтейнеров = СтрРазделить(ЗаписьРегистра.Контейнеры, ",", Ложь);
	Для Каждого НомерКонтейнера Из НомераКонтейнеров Цикл
		Контейнеры.Добавить(СокрЛП(НомерКонтейнера));
	КонецЦикла;
	Позиция.Вставить("Контейнеры", Контейнеры);

	Возврат Позиция;

КонецФункции

// Перезаписывает товары документа в регистре ЭАрМ_ТоварыЭТрН.
//
// Пишем набором записей с отбором по документу: строки могли пропасть или
// поменять нумерацию, а менеджер записи оставил бы старые.
//
Процедура ЗаписатьТоварыЭТрН(ИдентификаторСБИС, РезультатГруза, НомерДокумента = "")

	ИсточникТоваров = "ЭТрН";
	ИдентификаторУПД = "";
	Если ТипЗнч(РезультатГруза) = Тип("Структура") Тогда
		РезультатГруза.Свойство("ИсточникТоваров", ИсточникТоваров);
		РезультатГруза.Свойство("ИдентификаторУПД", ИдентификаторУПД);
	КонецЕсли;

	// Номер - то, по чему ищем строки: у ЭТрН и её УПД он совпадает
	Если НЕ ЗначениеЗаполнено(НомерДокумента) Тогда
		НомерДокумента = НомерИзРеестраПоИдентификатору(ИдентификаторСБИС);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		ЗаблокироватьСтрокуРеестра("РегистрСведений.ЭАрМ_ТоварыЭТрН", ИдентификаторСБИС);

		НаборЗаписей = РегистрыСведений.ЭАрМ_ТоварыЭТрН.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдентификаторСБИС.Установить(ИдентификаторСБИС);
		НаборЗаписей.Прочитать();

		// Фактические товары итогового ответа Базы2 живут под тем же
		// идентификатором. При обновлении исходного груза сохраняем их.
		Индекс = НаборЗаписей.Количество() - 1;
		Пока Индекс >= 0 Цикл
			Если НаборЗаписей[Индекс].ИсточникТоваров <> "База2" Тогда
				НаборЗаписей.Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;

		Для Каждого ОписаниеПозиции Из РезультатГруза.Позиции Цикл

			ЗаписьТовара = НаборЗаписей.Добавить();
			ЗаписьТовара.ИдентификаторСБИС = ИдентификаторСБИС;
			ЗаписьТовара.НомерПозиции      = ОписаниеПозиции.НомерСтроки;
			ЗаписьТовара.Наименование      = Лев(ОписаниеПозиции.Наименование, 500);
			ЗаписьТовара.КодНоменклатуры   = Лев(ОписаниеПозиции.Номенклатура, 50);
			ЗаписьТовара.Артикул           = Лев(ОписаниеПозиции.Артикул, 50);
			ЗаписьТовара.ЕдиницаИзмерения  = Лев(ОписаниеПозиции.ЕдиницаИзмерения, 20);
			ЗаписьТовара.СпособУпаковки    = Лев(ОписаниеПозиции.СпособУпаковки, 50);
			ЗаписьТовара.Количество        = ОписаниеПозиции.КоличествоМест;
			ЗаписьТовара.КоличествоМест    = ОписаниеПозиции.КоличествоМест;
			ЗаписьТовара.Цена              = ОписаниеПозиции.Цена;
			ЗаписьТовара.Сумма             = ОписаниеПозиции.Стоимость;
			ЗаписьТовара.СтавкаНДС         = Лев(ОписаниеПозиции.СтавкаНДС, 20);
			ЗаписьТовара.СуммаНДС          = ОписаниеПозиции.СуммаНДС;
			ЗаписьТовара.МассаБрутто       = ОписаниеПозиции.МассаБрутто;
			ЗаписьТовара.МассаНетто        = ОписаниеПозиции.МассаНетто;
			ЗаписьТовара.КодВалюты         = Лев(ЭАрМ_Служебный.СтрокойИлиПусто(
				ОписаниеПозиции.КодВалюты), 10);
			ЗаписьТовара.ИсточникТоваров   = Лев(ИсточникТоваров, 20);
			ЗаписьТовара.ИдентификаторУПД  = Лев(ИдентификаторУПД, 100);

			// Признак уменьшения/возврата строки: у строк УКД - "Убрана"/
			// "Уменьшение"/"Увеличение", у отрицательной строки УПД - "Возврат";
			// у позиций груза ЭТрН поля нет - остаётся пустым
			ЗаписьТовара.ПризнакИзменения = Лев(ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеПозиции, "ПризнакИзменения", "")), 20);
			ЗаписьТовара.НомерДокумента    = Лев(НомерДокумента, 50);
			ЗаписьТовара.Маркировок        = ОписаниеПозиции.Маркировки.Количество();
			ЗаписьТовара.Маркировки        = СтрСоединить(ОписаниеПозиции.Маркировки, Символы.ПС);
			ЗаписьТовара.Контейнеры        = Лев(ПредставлениеКонтейнеров(
				ОписаниеПозиции.Контейнеры), 200);

			// Код товара и GTIN приходят только в строках УПД; у груза ЭТрН
			// и у позиций, собранных из регистра, этих полей может не быть
			ШтрихкодСтроки = ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеПозиции, "Штрихкод", ""));
			ЗаписьТовара.КодТовараПоставщика = Лев(ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеПозиции, "КодТовара", "")), 50);
			ЗаписьТовара.Штрихкод            = Лев(ШтрихкодСтроки, 200);
			ЗаписьТовара.СпособПоискаШК      = ?(ЗначениеЗаполнено(ШтрихкодСтроки), "GTIN", "");

			// ТН ВЭД и признак алкоголя есть только у строк УПД (ЭАрМ_АлкогольЕГАИС)
			ЗаписьТовара.КодТНВЭД = Лев(ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеПозиции, "КодТНВЭД", "")), 20);
			ЗаписьТовара.Алкоголь = Лев(ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеПозиции, "Алкоголь", "")), 300);
			ЗаписьТовара.НомерГТД = Лев(ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеПозиции, "НомерГТД", "")), 100);
			ЗаписьТовара.СтранаПроисхождения = Лев(ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеПозиции, "СтранаПроисхождения", "")), 50);
			ЗаписьТовара.РНПТ = Лев(ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеПозиции, "РНПТ", "")), 100);
			ЗаписьТовара.СуммаАкциза = ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеПозиции, "СуммаАкциза", 0));

		КонецЦикла;

		НаборЗаписей.Записать(Истина);

		ЗафиксироватьТранзакцию();
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторСБИС,
			"ЗаписатьТоварыЭТрН (товары документа не записаны)", ОшибкаИсключения);
		ВызватьИсключение;
	КонецПопытки;

	// Сводку реестра УПД здесь не пишем: каждый документ менял бы строку
	// списка, и открытая таблица прыгала. Сводку догонит дерево цепочки
	// (ОбновитьСводкуУПД) и регламент ОбновитьСводкуРеестраУПД.

	// GTIN, пришедшие в УПД, - в штрихкоды поставщиков, если их там нет.
	// Сбой здесь не должен срывать загрузку товаров.
	Если ИсточникТоваров = "УПД" Тогда
		Попытка
			ЭАрМ_СверкаТоваровЦепочки.ДобавитьШтрихкодыИзУПД(ИдентификаторСБИС);
		Исключение
			ЗаписатьВЖурнал(ИдентификаторСБИС, "ШтрихкодыПоставщиков", Ложь,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	// Коды маркировки строк - в регистр кодов (Честный знак, марки ЕГАИС,
	// агрегаты). Сбой не должен срывать загрузку товаров.
	Попытка
		ЭАрМ_ЧестныйЗнак.ЗаписатьКодыДокумента(ИдентификаторСБИС);
	Исключение
		ЗаписатьВЖурнал(ИдентификаторСБИС, "КодыМаркировки", Ложь,
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Отмечает удачную выгрузку документа.
//
Процедура ОтметитьВыгрузку(ИдентификаторСБИС, РезультатВыгрузки, РезультатГруза)

	ИдентификаторУПД = "";
	ПредставлениеУПД = "";
	ИсточникТоваров  = "ЭТрН";
	Если ТипЗнч(РезультатГруза) = Тип("Структура") Тогда
		РезультатГруза.Свойство("ИдентификаторУПД", ИдентификаторУПД);
		РезультатГруза.Свойство("ПредставлениеУПД", ПредставлениеУПД);
		РезультатГруза.Свойство("ИсточникТоваров", ИсточникТоваров);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		МенеджерЗаписи = МенеджерРеестраЭТрН(ИдентификаторСБИС);
		Если МенеджерЗаписи = Неопределено Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		МенеджерЗаписи.Выгружен          = Истина;
		МенеджерЗаписи.ДатаВыгрузки      = ТекущаяДатаСеанса();
		МенеджерЗаписи.ИмяФайлаВыгрузки  = Лев(РезультатВыгрузки.ИмяФайла, 150);
		МенеджерЗаписи.ПутьВыгрузки      = Лев(РезультатВыгрузки.ПутьВыгрузки, 500);
		МенеджерЗаписи.ТоваровВыгружено  = РезультатВыгрузки.ТоваровВыгружено;
		МенеджерЗаписи.ОшибкаВыгрузки    = "";
		МенеджерЗаписи.ИдентификаторУПД  = Лев(ИдентификаторУПД, 100);
		МенеджерЗаписи.ПредставлениеУПД  = Лев(ПредставлениеУПД, 150);
		МенеджерЗаписи.ИсточникТоваров   = Лев(ИсточникТоваров, 20);
		МенеджерЗаписи.ПопытокВыгрузки   = МенеджерЗаписи.ПопытокВыгрузки + 1;
		МенеджерЗаписи.Записать(Истина);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЭАрМ_Служебный.ЗаписатьОшибку("ОтметитьВыгрузку",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Отмечает неудачную попытку выгрузки.
//
// Счётчик попыток нужен, чтобы документ, который не выгружается по своей
// причине (нет груза, отказ формата), не занимал очередь каждый сеанс.
//
Процедура ОтметитьОшибкуВыгрузки(ИдентификаторСБИС, ТекстОшибки)

	НачатьТранзакцию();
	Попытка

		МенеджерЗаписи = МенеджерРеестраЭТрН(ИдентификаторСБИС);
		Если МенеджерЗаписи = Неопределено Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		МенеджерЗаписи.ОшибкаВыгрузки  = Лев(ТекстОшибки, 500);
		МенеджерЗаписи.ПопытокВыгрузки = МенеджерЗаписи.ПопытокВыгрузки + 1;
		МенеджерЗаписи.Записать(Истина);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЭАрМ_Служебный.ЗаписатьОшибку("ОтметитьОшибкуВыгрузки",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Возвращает заблокированный менеджер записи реестра ЭТрН.
//
// Блокировка нужна из-за того, что выгружать документ может и регламентное
// задание, и пользователь из формы: отметку о выгрузке ставит тот, кто первым
// дошёл до записи, второй увидит уже проставленную.
//
// Возвращаемое значение:
//   РегистрСведенийМенеджерЗаписи, Неопределено - Неопределено, если строки
//   реестра нет: документ мог быть удалён из реестра между чтением и выгрузкой
//
Функция МенеджерРеестраЭТрН(ИдентификаторСБИС)

	ЗаблокироватьСтрокуРеестра("РегистрСведений.ЭАрМ_РеестрЭТрН", ИдентификаторСБИС);

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_РеестрЭТрН.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторСБИС;
	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат МенеджерЗаписи;

КонецФункции

// Отправляет готовый JSON выбранным в настройках транспортом.
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, Путь
//
Функция ОтправитьДанные(ТекстJSON, ИмяФайла, НастройкиОбмена)

	Результат = Новый Структура("Успех, Ошибка, Путь", Ложь, "", "");

	Транспорт = ВРег(СокрЛП(НастройкиОбмена.Транспорт));

	Если Транспорт = "FTP" Тогда

		Отправка = ЭАрМ_ОбщийМодульОбмен.ОтправитьТекстНаFTP(ТекстJSON, ИмяФайла);
		Результат.Успех  = Отправка.Успех;
		Результат.Ошибка = Отправка.Ошибка;
		Результат.Путь   = Отправка.ПутьНаFTP;

	ИначеЕсли Транспорт = "ПАПКА" Тогда

		Результат = ЗаписатьВПапку(ТекстJSON, ИмяФайла, НастройкиОбмена.ПапкаВыгрузки);

	ИначеЕсли Транспорт = "HTTP" Тогда

		Результат = ОтправитьПоHTTP(ТекстJSON, ИмяФайла, НастройкиОбмена.АдресСервисаДалион);

	Иначе

		Результат.Ошибка = СтрШаблон(
			НСтр("ru = 'Неизвестный транспорт обмена ""%1"". Допустимо: FTP, Папка, HTTP'"),
			НастройкиОбмена.Транспорт);

	КонецЕсли;

	Возврат Результат;

КонецФункции

// Кладёт файл в папку обмена.
//
Функция ЗаписатьВПапку(ТекстJSON, ИмяФайла, ПапкаВыгрузки)

	Результат = Новый Структура("Успех, Ошибка, Путь", Ложь, "", "");

	Если НЕ ЗначениеЗаполнено(ПапкаВыгрузки) Тогда
		Результат.Ошибка = НСтр("ru = 'Не указана папка выгрузки в настройках ЭДО'");
		Возврат Результат;
	КонецЕсли;

	Попытка

		Каталог = Новый Файл(ПапкаВыгрузки);
		Если НЕ Каталог.Существует() Тогда
			СоздатьКаталог(ПапкаВыгрузки);
		КонецЕсли;

		ПолныйПуть = ОбъединитьПуть(ПапкаВыгрузки, ИмяФайла);

		// Пишем через ЭАрМ_Служебный: там UTF-8 без BOM, а BOM ломает
		// разбор JSON на приёмной стороне
		ЭАрМ_Служебный.ЗаписатьТекстВФайл(ТекстJSON, ПолныйПуть);

		Результат.Успех = Истина;
		Результат.Путь  = ПолныйПуть;

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		// Путь и настройку - в текст: по одному «Отказано в доступе» не понять,
		// что папка из настроек на этом компьютере недоступна серверу 1С
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ЗаписатьВПапку (файл " + ИмяФайла + " в папку " + ПапкаВыгрузки + ")", ОшибкаИсключения);
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Ошибка записи в папку %1: %2. Проверьте «Папка выгрузки в Далион» в настройках ЭДО: папка должна быть на этом компьютере и доступна серверу 1С.'"),
			ПапкаВыгрузки, ОбработкаОшибок.КраткоеПредставлениеОшибки(ОшибкаИсключения));
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Отправляет JSON в сервис Далиона.
//
Функция ОтправитьПоHTTP(ТекстJSON, ИмяФайла, АдресСервиса)

	Результат = Новый Структура("Успех, Ошибка, Путь", Ложь, "", "");

	Если НЕ ЗначениеЗаполнено(АдресСервиса) Тогда
		Результат.Ошибка = НСтр("ru = 'Не указан адрес сервиса Далион в настройках ЭДО'");
		Возврат Результат;
	КонецЕсли;

	Попытка

		HTTPЗапрос = Новый HTTPЗапрос("/api/etrn/accept");
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		HTTPЗапрос.УстановитьТелоИзСтроки(ТекстJSON, "UTF-8",
			ИспользованиеByteOrderMark.НеИспользовать);

		Соединение = Новый HTTPСоединение(АдресСервиса, , , , , 60);
		Ответ = Соединение.ОтправитьДляОбработки(HTTPЗапрос);

		Если Ответ.КодСостояния <> 200 Тогда
			Результат.Ошибка = СтрШаблон(НСтр("ru = 'Далион ответил HTTP %1: %2'"),
				Ответ.КодСостояния, Лев(Ответ.ПолучитьТелоКакСтроку(), 300));
			Возврат Результат;
		КонецЕсли;

		Результат.Успех = Истина;
		Результат.Путь  = АдресСервиса + "/api/etrn/accept";

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ОтправитьПоHTTP (файл " + ИмяФайла + ")", ОшибкаИсключения);
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Ошибка отправки в Далион: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ОшибкаИсключения));
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Пишет строку в регистр ЭАрМ_ЖурналОбменаЭДО.
//
// Журнал регистрации остаётся основным местом для разбора ошибок, а этот
// регистр показывает ход обмена прямо в форме реестра, без прав на журнал.
//
Процедура ЗаписатьВЖурнал(ИдентификаторСБИС, Операция, Успех, Сообщение, ИмяФайла = "") Экспорт

	Попытка

		// Ключ записи журнала - секунда + идентификатор + операция: вторая запись той же
		// секунды затирала первую, и из подробной трассы в журнале оставалась одна строка
		// в секунду. Секунда уже занята - пишем следующей свободной: порядок сохраняется
		Период = ТекущаяДатаСеанса();
		ЗапросЗанятых = Новый Запрос(
		"ВЫБРАТЬ
		|	МАКСИМУМ(Журнал.Период) КАК Период
		|ИЗ
		|	РегистрСведений.ЭАрМ_ЖурналОбменаЭДО КАК Журнал
		|ГДЕ
		|	Журнал.ИдентификаторСБИС = &Идентификатор
		|	И Журнал.Операция = &Операция
		|	И Журнал.Период >= &Период");
		ЗапросЗанятых.УстановитьПараметр("Идентификатор", Лев(ИдентификаторСБИС, 100));
		ЗапросЗанятых.УстановитьПараметр("Операция", Лев(Операция, 50));
		ЗапросЗанятых.УстановитьПараметр("Период", Период);
		Занятые = ЗапросЗанятых.Выполнить().Выбрать();
		Если Занятые.Следующий() И ЗначениеЗаполнено(Занятые.Период) Тогда
			Период = Занятые.Период + 1;
		КонецЕсли;

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ЖурналОбменаЭДО.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период            = Период;
		МенеджерЗаписи.ИдентификаторСБИС  = Лев(ИдентификаторСБИС, 100);
		МенеджерЗаписи.Операция           = Лев(Операция, 50);
		МенеджерЗаписи.Успех              = Успех;
		МенеджерЗаписи.Сообщение          = Лев(Сообщение, 1000);
		МенеджерЗаписи.ИмяФайла           = Лев(ИмяФайла, 150);
		МенеджерЗаписи.Пользователь       = Лев(ИмяПользователя(), 100);
		МенеджерЗаписи.Записать(Истина);

	Исключение
		// Журнал обмена не должен ронять сам обмен
		ЭАрМ_Служебный.ЗаписатьОшибку("ЗаписатьВЖурнал",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// Всё, что пишется в журнал обмена, - ещё и в текстовый лог ТрассаПриема.log
	Попытка
		ЭАрМ_ПриемПакетовДалион.ЗаписатьВЛогСтрокуЖурнала(Операция, ИдентификаторСБИС, Сообщение, Успех, ИмяФайла);
	Исключение
		// лог не должен ронять обмен
	КонецПопытки;

КонецПроцедуры

// Заготовка итогов сеанса обмена.
//
Функция НовыеИтогиОбмена()

	Итоги = Новый Структура;
	Итоги.Вставить("Успех",          Истина);
	Итоги.Вставить("Ошибка",         "");
	Итоги.Вставить("ЗагруженоЭТрН",  0);
	Итоги.Вставить("ЗагруженоУПД",   0);
	Итоги.Вставить("Выгружено",      0);
	Итоги.Вставить("ОшибокВыгрузки", 0);
	Итоги.Вставить("ОтветовПолучено", 0);
	Итоги.Вставить("Длительность",   0);
	Итоги.Вставить("Сообщения",      Новый Массив);

	Возврат Итоги;

КонецФункции

// Закрывает сеанс: проставляет итог и пишет его в журнал обмена.
//
Процедура ЗавершитьСеанс(Итоги, Успех, Ошибка, НачалоСеанса)

	Итоги.Успех  = Успех;
	Итоги.Ошибка = Ошибка;
	Итоги.Длительность = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСеанса) / 1000;

	Если ЗначениеЗаполнено(Ошибка) Тогда
		ДобавитьСообщение(Итоги, Ошибка);
	КонецЕсли;

	ТекстИтога = СтрШаблон(
		НСтр("ru = 'ЭТрН: %1, УПД: %2, выгружено: %3, ошибок: %4, ответов: %5, за %6 с'"),
		Итоги.ЗагруженоЭТрН, Итоги.ЗагруженоУПД, Итоги.Выгружено,
		Итоги.ОшибокВыгрузки, Итоги.ОтветовПолучено,
		Формат(Итоги.Длительность, "ЧДЦ=1; ЧН=0"));

	Если ЗначениеЗаполнено(Ошибка) Тогда
		ТекстИтога = Ошибка + ". " + ТекстИтога;
	КонецЕсли;

	ЗаписатьВЖурнал("", "Сеанс", Успех, ТекстИтога);

	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'АРМ_ЭдоОбмен.Сеанс'", ОбщегоНазначения.КодОсновногоЯзыка()),
		?(Успех, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Предупреждение),
		, , ТекстИтога);

КонецПроцедуры

// Добавляет строку в протокол сеанса.
//
Процедура ДобавитьСообщение(Итоги, Сообщение)

	Итоги.Сообщения.Добавить(Сообщение);

КонецПроцедуры

// Период запроса реестра строками в формате СБИС.
//
// Само окно считает ЭАрМ_НастройкиСервер: тем же периодом ограничены реестр
// УПД и разовые вызовы списков из форм, и расходиться им незачем.
//
Функция ПериодЗапроса(ГлубинаДней)

	Возврат ЭАрМ_НастройкиСервер.ПериодЗапросаСБИС(ГлубинаДней);

КонецФункции

// Предел числа страниц одного реестра.
//
// Страховка от бесконечного цикла: если сервис перестанет отдавать признак
// конца реестра, обмен не должен ходить по кругу.
//
Функция МаксимумСтраниц()

	// Реестр УПД берётся за 3 дня и без отбора форматов - страниц больше, чем у ЭТрН
	Возврат 200;

КонецФункции

// Разбирает признак наличия следующей страницы.
//
Функция ЕстьСледующаяСтраница(Навигация)

	Если Навигация = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Признак = ЭАрМ_Служебный.ЗначениеУзла(Навигация, "ЕстьЕще");

	Если Признак = Неопределено Тогда
		// Признака нет - решает размер страницы, см. вызывающий код
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(Признак) = Тип("Булево") Тогда
		Возврат Признак;
	КонецЕсли;

	Возврат ВРег(СокрЛП(Строка(Признак))) = "ДА"
		ИЛИ ВРег(СокрЛП(Строка(Признак))) = "TRUE"
		ИЛИ СокрЛП(Строка(Признак)) = "1";

КонецФункции

// Идентификатор документа СБИС из элемента реестра.
//
Функция ИдентификаторДокумента(ДокументРеестра)

	Возврат Лев(ЗначениеСтрокой(ДокументРеестра, "Идентификатор"), 100);

КонецФункции

// Название состояния документа.
//
Функция СостояниеДокумента(ДокументРеестра)

	УзелСостояния = ЭАрМ_Служебный.ЗначениеУзла(ДокументРеестра, "Состояние");

	Возврат ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеУзла(УзелСостояния, "Название", ""));

КонецФункции

// Название и код состояния документа в СБИС. Закрытый документ (аннулирован,
// удалён, отозван) снимается с отправки; связи с ним снимает
// ЭАрМ_ЦепочкаЗакупки.ОтвязатьЗакрытыеДокументы.
//
Процедура ЗаписатьСостояниеСБИС(МенеджерЗаписи, ДокументРеестра)

	МенеджерЗаписи.Состояние    = Лев(СостояниеДокумента(ДокументРеестра), 100);
	МенеджерЗаписи.КодСостояния = Лев(ЭАрМ_УтверждениеСБИС.КодСостоянияСБИС(ДокументРеестра), 10);
	ЭАрМ_УтверждениеСБИС.ОтметитьАннулирование(МенеджерЗаписи);

	Если ЭАрМ_УтверждениеСБИС.ДокументЗакрытВСБИС(МенеджерЗаписи.КодСостояния, МенеджерЗаписи.Состояние) Тогда
		МенеджерЗаписи.КОтправке = Ложь;
	КонецЕсли;

КонецПроцедуры

// Поднимает отметки подписания по состоянию, которое отдал СБИС.
//
// Это и есть «проверить подпись в СБИС» на стороне загрузки реестра: пока
// состояние молчит о подписи, строка остаётся как была (обычной или жёлтой
// после отправки утверждения), а как только СБИС показал подпись - строка
// становится подписанной, то есть зелёной.
//
// Отметки только поднимаются: снимать их нельзя, СБИС ещё меняет название
// состояния уже после утверждения.
//
Процедура ОтметитьПодписьПоСостоянию(МенеджерЗаписи)

	Если НЕ ЭАрМ_УтверждениеСБИС.СостояниеГоворитОПодписи(МенеджерЗаписи.Состояние,
		МенеджерЗаписи.КодСостояния) Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.Утверждено = Истина;
	МенеджерЗаписи.Подписано  = Истина;

	ЭАрМ_УтверждениеСБИС.ПовыситьСтатусПодписания(МенеджерЗаписи,
		Перечисления.ЭАрМ_СтатусыПодписанияЭДО.Подписан);

КонецПроцедуры

// Значение узла документа строкой.
//
Функция ЗначениеСтрокой(Узел, ИмяСвойства)

	Возврат ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеУзла(Узел, ИмяСвойства, ""));

КонецФункции

// Дата документа для реестра. День - из «Дата», время - из создания в СБИС,
// если у даты документа его не было и создание пришлось на тот же день.
// Два УПД с одним номером в один день тогда различаются, и корректировка
// берёт поздний.
//
Функция ДатаДокументаСоВременемСоздания(ДокументРеестра)

	ДатаДокумента = ЭАрМ_Служебный.ДатаИзСтрокиСБИС(ЗначениеСтрокой(ДокументРеестра, "Дата"));
	ДатаВремя = ДатаВремяСозданияСБИС(ДокументРеестра);
	Если НЕ ЗначениеЗаполнено(ДатаВремя) Тогда
		Возврат ДатаДокумента;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда
		Возврат ДатаВремя;
	КонецЕсли;
	Если НачалоДня(ДатаДокумента) = НачалоДня(ДатаВремя)
		И ДатаДокумента = НачалоДня(ДатаДокумента) Тогда
		Возврат ДатаВремя;
	КонецЕсли;

	Возврат ДатаДокумента;

КонецФункции

// Дата и время создания документа в СБИС (ДатаВремяСоздания). СБИС пишет
// время через точки - «25.09.2026 13.22.05».
//
// Возвращаемое значение:
//   Дата - пустая, если СБИС поле не прислал
//
Функция ДатаВремяСозданияСБИС(ДокументРеестра)

	Текст = СокрЛП(ЗначениеСтрокой(ДокументРеестра, "ДатаВремяСоздания"));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат '00010101';
	КонецЕсли;

	Части = СтрРазделить(СтрЗаменить(Текст, "T", " "), " ", Ложь);
	Если Части.Количество() > 1 Тогда
		// Лев 8: «ЧЧ:ММ:СС», доли секунды (ISO «13:22:05.123») отбрасываем
		Текст = Части[0] + " " + Лев(СтрЗаменить(Части[1], ".", ":"), 8);
	КонецЕсли;

	Возврат ЭАрМ_Служебный.ДатаИзСтрокиСБИС(Текст);

КонецФункции

// Номера контейнеров позиции одной строкой.
//
Функция ПредставлениеКонтейнеров(Контейнеры)

	Если Контейнеры = Неопределено ИЛИ Контейнеры.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Номера = Новый Массив;
	Для Каждого ОписаниеКонтейнера Из Контейнеры Цикл
		Номер = "";
		Если ОписаниеКонтейнера.Свойство("Номер", Номер) И ЗначениеЗаполнено(Номер) Тогда
			Номера.Добавить(Строка(Номер));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Номера, ", ");

КонецФункции

// Склеивает каталог и имя файла в путь файловой системы.
//
Функция ОбъединитьПуть(Каталог, ИмяФайла) Экспорт

	Разделитель = ПолучитьРазделительПути();

	Путь = СокрЛП(Каталог);
	Если Прав(Путь, 1) = "\" ИЛИ Прав(Путь, 1) = "/" Тогда
		Возврат Путь + ИмяФайла;
	КонецЕсли;

	Возврат Путь + Разделитель + ИмяФайла;

КонецФункции

// Блокирует строки регистра по документу СБИС.
//
// Реестры обновляет и регламентное задание, и пользователь из формы. Без
// блокировки два таких обновления могут перекрыть друг друга, и отметка
// о выгрузке потеряется - документ уйдёт в Далион повторно.
//
// Вызывается только внутри транзакции.
//
// Параметры:
//   ИмяТаблицы        - Строка - полное имя таблицы регистра
//   ИдентификаторСБИС - Строка - значение измерения
//
Процедура ЗаблокироватьСтрокуРеестра(ИмяТаблицы, ИдентификаторСБИС) Экспорт

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(ИмяТаблицы);
	ЭлементБлокировки.УстановитьЗначение("ИдентификаторСБИС", ИдентификаторСБИС);
	Блокировка.Заблокировать();

КонецПроцедуры

// Пересчитывает сводку строк реестра УПД - ресурсы ЭТрНОтправлена, СуммаУПД,
// СуммаПриходной, СтатусПриходной (ДатаСводки - когда пересчитана). Раньше
// эти поля считала форма реестра пятью соединениями при КАЖДОМ перечитывании
// списка; теперь список читает готовые ресурсы, а считает их этот пересчёт:
//   - регламентное задание (ОбновитьРеестрыПоРасписанию) - за 7 дней;
//   - фон формы реестра раз в минуту - за видимый период;
//   - построение дерева цепочки, загрузка строк УПД, связь прихода - по УПД.
// Условия - те же, что были в запросе формы. Пишутся только изменившиеся
// строки, с блокировкой строки реестра; прочие ресурсы не трогаются.
//
// Параметры:
//   Идентификаторы - Массив - УПД; Неопределено - по периоду
//   ДатаС, ДатаПо  - Дата - период по дате УПД (пустые - без границы)
//   ТолькоБезСводки - Булево - только строки, где сводки ещё не было
//
// Возвращаемое значение:
//   Число - сколько строк обновлено
//
Функция ОбновитьСводкуРеестраУПД(Знач Идентификаторы = Неопределено, Знач ДатаС = Неопределено,
	Знач ДатаПо = Неопределено, Знач ТолькоБезСводки = Ложь) Экспорт

	Если ТипЗнч(Идентификаторы) = Тип("Массив") И Идентификаторы.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	// Дата оплаты (договор поставщика в УТ) - у строк, где её ещё нет. Свои
	// транзакции по строкам, сбой сводке не мешает: он виден в трассе
	Попытка
		ЭАрМ_ВыгрузкаНакладныхДляБух.ОбновитьДатыОплатыУПД(Идентификаторы, ДатаС, ДатаПо, , Истина);
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ОбновитьСводкуРеестраУПД (даты оплаты УПД не пересчитаны)", ИнформацияОбОшибке());
	КонецПопытки;

	// Отбор строк - шаблон с «#» вместо псевдонима таблицы
	Если ТипЗнч(Идентификаторы) = Тип("Массив") Тогда
		Отбор = "#.ИдентификаторСБИС В (&Идентификаторы)";
	Иначе
		Отбор =
		"(&НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
		|		ИЛИ #.Дата >= &НачалоПериода)
		|	И (&КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
		|		ИЛИ #.Дата <= &КонецПериода)";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УПД.ЭТрНОтправлена КАК БылоЭТрНОтправлена,
	|	УПД.СуммаУПД КАК БылоСуммаУПД,
	|	УПД.СуммаПриходной КАК БылоСуммаПриходной,
	|	УПД.СтатусПриходной КАК БылоСтатусПриходной,
	|	УПД.ДатаСводки КАК ДатаСводки,
	|	УПД.ЕстьУКД КАК ЕстьУКД,
	|	УПД.СуммаСУчетомУКД КАК БылоСуммаСУчетомУКД,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОтправленныеЭТрН.Отправлена, ЛОЖЬ)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭТрНОтправлена,
	|	ЕСТЬNULL(СобственныеСтроки.Сумма, ЕСТЬNULL(СтрокиПодЭТрН.Сумма, 0)) КАК СуммаУПД,
	|	ВЫБОР
	|		КОГДА НЕ Приходы.ИдентификаторУПД ЕСТЬ NULL
	|			ТОГДА Приходы.Сумма
	|		КОГДА УПД.СуммаДокументаДалион <> 0
	|			ТОГДА УПД.СуммаДокументаДалион
	|		ИНАЧЕ ЕСТЬNULL(ПриходыЭТрН.Сумма, 0)
	|	КОНЕЦ КАК СуммаПриходной,
	|	ВЫБОР
	|		КОГДА УПД.ЗамененаНа <> """"
	|				ИЛИ НЕ Замененные.ИдентификаторСБИС ЕСТЬ NULL
	|			ТОГДА ""Заменена""
	|		КОГДА УПД.СвереноВручную
	|			ТОГДА ""Сверено""
	|		КОГДА ЕСТЬNULL(Приходы.ЕстьРасхождения, ЛОЖЬ)
	|				ИЛИ ЕСТЬNULL(ПриходыЭТрН.ЕстьРасхождения, ЛОЖЬ)
	|			ТОГДА ""Расхождения""
	|		КОГДА ЕСТЬNULL(Приходы.Сверено, ЛОЖЬ)
	|			ТОГДА ""Сверено""
	|		КОГДА НЕ Приходы.ИдентификаторУПД ЕСТЬ NULL
	|				ИЛИ УПД.НомерДокументаДалион <> """"
	|			ТОГДА ""К УПД""
	|		КОГДА НЕ ПриходыЭТрН.ИдентификаторУПД ЕСТЬ NULL
	|			ТОГДА ""К ЭТрН""
	|		ИНАЧЕ ""Нет приходной""
	|	КОНЕЦ КАК СтатусПриходной
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЭТрН.ИдентификаторУПД КАК ИдентификаторУПД,
	|			ИСТИНА КАК Отправлена
	|		ИЗ
	|			РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|		ГДЕ
	|			ЭТрН.ИдентификаторУПД <> """"
	|			И ЭТрН.ИдентификаторУПД В (#УПДОтбора)
	|			И (ЭТрН.Подписано
	|				ИЛИ ЭТрН.Утверждено
	|				ИЛИ ЭТрН.СтатусПодписания В (
	|					ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан),
	|					ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Утвержден)))
	|		СГРУППИРОВАТЬ ПО
	|			ЭТрН.ИдентификаторУПД) КАК ОтправленныеЭТрН
	|		ПО УПД.ИдентификаторСБИС = ОтправленныеЭТрН.ИдентификаторУПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Товары.ИдентификаторСБИС КАК Идентификатор,
	|			СУММА(Товары.Сумма) КАК Сумма
	|		ИЗ
	|			РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ГДЕ
	|			Товары.ИсточникТоваров = ""УПД""
	|			И Товары.ИдентификаторСБИС В (#УПДОтбора)
	|		СГРУППИРОВАТЬ ПО
	|			Товары.ИдентификаторСБИС) КАК СобственныеСтроки
	|		ПО УПД.ИдентификаторСБИС = СобственныеСтроки.Идентификатор
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Товары.ИдентификаторУПД КАК Идентификатор,
	|			СУММА(Товары.Сумма) КАК Сумма
	|		ИЗ
	|			РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ГДЕ
	|			Товары.ИсточникТоваров = ""УПД""
	|			И Товары.ИдентификаторУПД В (#УПДОтбора)
	|		СГРУППИРОВАТЬ ПО
	|			Товары.ИдентификаторУПД) КАК СтрокиПодЭТрН
	|		ПО УПД.ИдентификаторСБИС = СтрокиПодЭТрН.Идентификатор
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ПоНомеру.ИдентификаторУПД КАК ИдентификаторУПД,
	|			СУММА(ПоНомеру.СуммаПоступления) КАК Сумма,
	|			МАКСИМУМ(ПоНомеру.ЕстьРасхождения) КАК ЕстьРасхождения,
	|			МИНИМУМ(ПоНомеру.Сверено) КАК Сверено
	|		ИЗ
	|			(ВЫБРАТЬ
	|				Поступления.ИдентификаторУПД КАК ИдентификаторУПД,
	|				Поступления.КлючПрихода КАК КлючПрихода,
	|				МАКСИМУМ(Поступления.СуммаПоступления) КАК СуммаПоступления,
	|				МАКСИМУМ(Поступления.ЕстьРасхождения) КАК ЕстьРасхождения,
	|				МАКСИМУМ(Поступления.Сверено) КАК Сверено
	|			ИЗ
	|				(ВЫБРАТЬ
	|					Цепочка.ИдентификаторУПД КАК ИдентификаторУПД,
	|					ВЫБОР
	|						КОГДА Цепочка.НомерПоступления <> """"
	|							ТОГДА Цепочка.НомерПоступления
	|						ИНАЧЕ Цепочка.ИдентификаторПоступления
	|					КОНЕЦ КАК КлючПрихода,
	|					Цепочка.СуммаПоступления КАК СуммаПоступления,
	|					Цепочка.ЕстьРасхождения КАК ЕстьРасхождения,
	|					ВЫБОР
	|						КОГДА Цепочка.ДатаСверки > ДАТАВРЕМЯ(1, 1, 1)
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ ЛОЖЬ
	|					КОНЕЦ КАК Сверено
	|				ИЗ
	|					РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|				ГДЕ
	|					Цепочка.ИдентификаторУПД <> """"
	|					И Цепочка.ИдентификаторПоступления <> """"
	|					И Цепочка.ИдентификаторУПД В (#УПДОтбора)) КАК Поступления
	|			СГРУППИРОВАТЬ ПО
	|				Поступления.ИдентификаторУПД,
	|				Поступления.КлючПрихода) КАК ПоНомеру
	|		СГРУППИРОВАТЬ ПО
	|			ПоНомеру.ИдентификаторУПД) КАК Приходы
	|		ПО УПД.ИдентификаторСБИС = Приходы.ИдентификаторУПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЭТрН.ИдентификаторУПД КАК ИдентификаторУПД,
	|			СУММА(ЭТрН.СуммаДокументаДалион) КАК Сумма,
	|			МАКСИМУМ(ЭТрН.ЕстьРасхождения) КАК ЕстьРасхождения
	|		ИЗ
	|			РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|		ГДЕ
	|			ЭТрН.ИдентификаторУПД <> """"
	|			И ЭТрН.НомерДокументаДалион <> """"
	|			И ЭТрН.ИдентификаторУПД В (#УПДОтбора)
	|		СГРУППИРОВАТЬ ПО
	|			ЭТрН.ИдентификаторУПД) КАК ПриходыЭТрН
	|		ПО УПД.ИдентификаторСБИС = ПриходыЭТрН.ИдентификаторУПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ (#Замененные) КАК Замененные
	|		ПО УПД.ИдентификаторСБИС = Замененные.ИдентификаторСБИС
	|ГДЕ
	|	#ОтборУПД
	|	И (НЕ &ТолькоБезСводки
	|		ИЛИ УПД.ДатаСводки = ДАТАВРЕМЯ(1, 1, 1))";

	// «Только без сводки» стоит и в подзапросах, а не только в итоговом
	// отборе. Раньше группировки по товарам, цепочке закупки и ЭТрН
	// сворачивали весь период, а строки со сводкой отбрасывались уже после
	// соединения: форма реестра при открытии и смене периода ждала полный
	// пересчёт, даже когда досчитывать было нечего. Итог тот же
	ОтборПодзапросов = Отбор + "
		|	И (НЕ &ТолькоБезСводки
		|		ИЛИ #.ДатаСводки = ДАТАВРЕМЯ(1, 1, 1))";

	УПДОтбора =
	"ВЫБРАТЬ
	|	Отобранные.ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК Отобранные
	|ГДЕ
	|	" + СтрЗаменить(ОтборПодзапросов, "#", "Отобранные");

	// Заменённые считаются среди УПД того же номера за весь реестр: замена
	// могла прийти позже периода. Условие «старой» - сама строка отбора
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#Замененные",
		ЭАрМ_ВыгрузкаНакладныхДляБух.ТекстЗапросаЗамененныхУПД(СтрЗаменить(ОтборПодзапросов, "#", "Старая")));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#УПДОтбора", УПДОтбора);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ОтборУПД", СтрЗаменить(Отбор, "#", "УПД"));

	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Запрос.УстановитьПараметр("НачалоПериода", ?(ЗначениеЗаполнено(ДатаС), НачалоДня(ДатаС), Дата(1, 1, 1)));
	Запрос.УстановитьПараметр("КонецПериода", ?(ЗначениеЗаполнено(ДатаПо), КонецДня(ДатаПо), Дата(1, 1, 1)));
	Запрос.УстановитьПараметр("ТолькоБезСводки", ТолькоБезСводки = Истина);

	Обновлено = 0;
	Момент = ТекущаяДатаСеанса();

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		// Ресурсы сумм - 2 знака: сравниваем округлённое, иначе лишний знак
		// источника давал бы «изменение» и перезапись строки каждый проход
		СуммаУПД = Окр(ЕстьNullЧисло(Выборка.СуммаУПД), 2);
		СуммаПриходной = Окр(ЕстьNullЧисло(Выборка.СуммаПриходной), 2);

		// Сумма с учётом корректировок - только у УПД с УКД: корректировка
		// правит строки, и считать её приходится построчно, как сверка.
		// Без УКД в ресурс пишем 0, колонка списка остаётся пустой
		СуммаСУчетомУКД = 0;
		Если Выборка.ЕстьУКД = Истина Тогда
			// Пока строки УКД не легли в регистр, показываем сумму УПД:
			// ноль выглядел бы как обнуление корректировкой
			СуммаСУчетомУКД = СуммаУПД;
			Попытка
				Скорректированная = ЭАрМ_СверкаТоваровЦепочки.СуммаУПДСУчетомУКД(Выборка.ИдентификаторСБИС);
			Исключение
				Скорректированная = Неопределено;
				ЗаписьЖурналаРегистрации("АРМ_ЭДО.СводкаРеестраУПД", УровеньЖурналаРегистрации.Предупреждение, , ,
					СтрШаблон("%1: сумма с учётом УКД: %2", Выборка.ИдентификаторСБИС,
						КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
			Если Скорректированная <> Неопределено Тогда
				СуммаСУчетомУКД = Окр(Скорректированная, 2);
			КонецЕсли;
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.ДатаСводки)
			И Выборка.БылоЭТрНОтправлена = Выборка.ЭТрНОтправлена
			И Выборка.БылоСуммаУПД = СуммаУПД
			И Выборка.БылоСуммаПриходной = СуммаПриходной
			И Выборка.БылоСтатусПриходной = Выборка.СтатусПриходной
			И Выборка.БылоСуммаСУчетомУКД = СуммаСУчетомУКД Тогда
			Продолжить;
		КонецЕсли;

		НачатьТранзакцию();
		Попытка

			ЗаблокироватьСтрокуРеестра("РегистрСведений.ЭАрМ_УПД_Входящий", Выборка.ИдентификаторСБИС);

			МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ИдентификаторСБИС = Выборка.ИдентификаторСБИС;
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.ЭТрНОтправлена = Выборка.ЭТрНОтправлена;
				МенеджерЗаписи.СуммаУПД = СуммаУПД;
				МенеджерЗаписи.СуммаПриходной = СуммаПриходной;
				МенеджерЗаписи.СуммаСУчетомУКД = СуммаСУчетомУКД;
				МенеджерЗаписи.СтатусПриходной = Выборка.СтатусПриходной;
				МенеджерЗаписи.ДатаСводки = Момент;
				МенеджерЗаписи.Записать(Истина);
				Обновлено = Обновлено + 1;
			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("АРМ_ЭДО.СводкаРеестраУПД", УровеньЖурналаРегистрации.Предупреждение, , ,
				СтрШаблон("%1: %2", Выборка.ИдентификаторСБИС, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

	Возврат Обновлено;

КонецФункции

Функция ЕстьNullЧисло(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);

КонецФункции

// То же для одной УПД, без исключений: вызывается после изменений данных
// (загрузка строк, связь прихода, дерево цепочки) и не должна их откатывать.
//
Процедура ОбновитьСводкуУПД(ИдентификаторУПД) Экспорт

	// Внутри чужой транзакции не пересчитываем: сбой пересчёта пометил бы её
	// к откату. Сводку догонит фон формы или регламентное задание
	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) ИЛИ ТранзакцияАктивна() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Идентификаторы = Новый Массив;
		Идентификаторы.Добавить(ИдентификаторУПД);
		ОбновитьСводкуРеестраУПД(Идентификаторы);
	Исключение
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.СводкаРеестраУПД", УровеньЖурналаРегистрации.Предупреждение, , ,
			СтрШаблон("%1: %2", ИдентификаторУПД, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОтветыДалион

// Забирает ответы Далиона из папки обмена.
//
// Формат файлов тот же, что и на FTP: response_<идентификатор>.json в каталоге
// ПапкаОбмена. Разбор и запись в реестр - общие с FTP-веткой
// (ПрименитьОтветДалион), различается только способ добраться до файла.
//
// Ответ нужен двум механизмам сразу: реестру ЭТрН и ожидаемым подтверждениям
// ЭД. Оба вызываются здесь, потому что файл после обработки уезжает в архив -
// и тот, кто прочитал его первым, обязан отработать за обоих. Поэтому читалка
// папки в системе одна: ЭАрМ_ОбработкаПодтвержденийЭДО.ПроверитьПапкуОбмена
// теперь зовёт эту же функцию, а не разбирает файлы сама.
//
// Параметры:
//   Итоги - Структура - см. ВыполнитьОбмен, пополняется по ходу
//
// Возвращаемое значение:
//   Число - сколько ответов разобрано
//
Функция ЗабратьОтветыИзПапки(Итоги = Неопределено) Экспорт

	Если Итоги = Неопределено Тогда
		Итоги = НовыеИтогиОбмена();
	КонецЕсли;

	ПутьКПапке = ЭАрМ_НастройкиСервер.НастройкиОбмена().ПапкаОбмена;

	Если НЕ ЗначениеЗаполнено(ПутьКПапке) Тогда
		ДобавитьСообщение(Итоги,
			НСтр("ru = 'Ответы Далиона не забраны: не указана папка обмена'"));
		Возврат 0;
	КонецЕсли;

	Каталог = Новый Файл(ПутьКПапке);
	Если НЕ Каталог.Существует() Тогда
		ДобавитьСообщение(Итоги, СтрШаблон(
			НСтр("ru = 'Ответы Далиона: папка обмена не найдена: %1'"), ПутьКПапке));
		Возврат 0;
	КонецЕсли;

	Разобрано = 0;

	Для Каждого ПутьКаталога Из КаталогиОтветовВПапке(ПутьКПапке) Цикл
		//@skip-check query-in-loop
		Разобрано = Разобрано + РазобратьОтветыКаталога(ПутьКаталога, Итоги);
	КонецЦикла;

	Если Разобрано > 0 Тогда
		ДобавитьСообщение(Итоги, СтрШаблон(
			НСтр("ru = 'Ответов Далиона разобрано: %1'"), Разобрано));
	КонецЕсли;

	Возврат Разобрано + ЗабратьПриходныеНакладныеДалион(Итоги);

КонецФункции

// Где в папке обмена искать ответы Базы2.
//
// Папка одна, а ходят в неё по-разному: База1 - локально, База2 - по FTP
// в тот же каталог. Ответы База2 кладёт в подкаталог result, тот же самый,
// что читает FTP-ветка ЗабратьОтветыДалион. Пока здесь смотрели только
// корень, ответы лежали в result нетронутыми, и в реестр ЭТрН не попадали
// ни статус Далиона, ни расхождения.
//
// Корень тоже смотрим: там ответы лежали раньше, и туда же пишет файловая
// ветка самой Базы2, когда FTP у неё не настроен.
//
// Возвращаемое значение:
//   Массив из Строка - существующие каталоги, без повторов
//
Функция КаталогиОтветовВПапке(ПапкаОбмена) Экспорт

	Кандидаты = Новый Массив;
	Кандидаты.Добавить(ПапкаОбмена);

	ПодкаталогОтветов = ЭАрМ_НастройкиСервер.НастройкиFTP().КаталогОтветов;
	Если ТипЗнч(ПодкаталогОтветов) <> Тип("Строка") Тогда
		ПодкаталогОтветов = "";
	КонецЕсли;
	ПодкаталогОтветов = СокрЛП(ПодкаталогОтветов);

	Если ЗначениеЗаполнено(ПодкаталогОтветов) Тогда
		Кандидаты.Добавить(ОбъединитьПуть(ПапкаОбмена, ПодкаталогОтветов));
	КонецЕсли;

	Результат = Новый Массив;
	Просмотренные = Новый Соответствие;

	Для Каждого Кандидат Из Кандидаты Цикл

		Путь = СокрЛП(Кандидат);
		Если НЕ ЗначениеЗаполнено(Путь) Тогда
			Продолжить;
		КонецЕсли;

		Ключ = ВРег(Путь);
		Если Просмотренные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Просмотренные.Вставить(Ключ, Истина);

		КаталогКандидата = Новый Файл(Путь);
		Если КаталогКандидата.Существует() Тогда
			Результат.Добавить(Путь);
		ИначеЕсли Кандидат = ПапкаОбмена Тогда
			// Раньше недоступная папка пропускалась молча, и файлы в ней просто
			// «висели». Самая частая причина - папка в профиле пользователя
			// Windows, а регламент работает от имени службы сервера 1С
			ЗаписьЖурналаРегистрации("АРМ_ЭДО.ПапкаОбмена", УровеньЖурналаРегистрации.Предупреждение, , ,
				ТекстНедоступнойПапки(Путь));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Объяснение, почему сервер 1С не видит папку обмена, - для журнала и
// сообщений об ошибке.
//
// Параметры:
//   Путь - Строка - папка из настроек ЭДО
//
// Возвращаемое значение:
//   Строка
//
Функция ТекстНедоступнойПапки(Путь) Экспорт

	Текст = СтрШаблон(НСтр("ru = 'Папка обмена %1 не видна серверу 1С: её нет или у учётной записи службы сервера 1С нет прав на неё.'"), Путь);

	ПутьВРег = ВРег(Путь);
	Если СтрНайти(ПутьВРег, "\USERS\") > 0 ИЛИ СтрНайти(ПутьВРег, "\ПОЛЬЗОВАТЕЛИ\") > 0 Тогда
		Текст = Текст + " " + НСтр("ru = 'Папка лежит в профиле пользователя Windows (рабочий стол, документы). Регламентные задания и серверные вызовы работают от имени службы 1С (обычно USR1CV8), а в чужой профиль Windows её не пускает. Перенесите папку обмена, например, в C:\ОбменЭДО, дайте службе 1С право на изменение и укажите новый путь в настройках ЭДО (Папка обмена, Папка выгрузки, каталоги цепочки) и у Далиона.'");
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Разбирает ответы одного каталога. Архив кладём рядом с файлом: ответ из
// result уезжает в result\archive, ответ из корня - в archive корня.
//
// Возвращаемое значение:
//   Число - сколько ответов разобрано
//
Функция РазобратьОтветыКаталога(ПутьКаталога, Итоги)

	Разобрано = 0;

	// Захваченные, но не разобранные (сеанс упал посреди разбора) дольше
	// 30 минут - обратно в очередь
	ВернутьЗависшиеОтветы(ПутьКаталога);

	Для Каждого НайденныйОтвет Из НайтиФайлы(ПутьКаталога, "response_*.json") Цикл

		// Захват до разбора: файл переименовывается в .processing, и второй
		// параллельный проход его уже не видит (раньше оба разбирали один
		// ответ и писали двойные записи в реестры). Не переименовался - его
		// забрал другой проход, пропускаем
		ФайлОтвета = ЗахватитьФайлОтвета(НайденныйОтвет);
		Если ФайлОтвета = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Попытка

			ДанныеОтвета = ПрочитатьФайлОбменаJSON(ФайлОтвета.ПолноеИмя);

			Если ДанныеОтвета = Неопределено Тогда
				ВызватьИсключение НСтр("ru = 'Ответ не разобрался как JSON'");
			КонецЕсли;

			//@skip-check query-in-loop
			РезультатПрименения = ПрименитьОтветДалион(ДанныеОтвета);

			Если РезультатПрименения.Успех Тогда
				Разобрано = Разобрано + 1;
			Иначе
				ДобавитьСообщение(Итоги, СтрШаблон("%1: %2",
					НайденныйОтвет.Имя, РезультатПрименения.Ошибка));
			КонецЕсли;

			// Подтверждения ЭД ждут тот же файл
			ИдентификаторЗапроса = ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "requestId", ""));

			Если ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
				//@skip-check query-in-loop
				ЭАрМ_ОбработкаПодтвержденийЭДО.ОбработатьОтветПодтверждения(
					ИдентификаторЗапроса,
					ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "approved", Ложь) = Истина,
					ЭАрМ_Служебный.СтрокойИлиПусто(
						ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "comment", "")));
			КонецЕсли;

			ПереместитьОтветВАрхив(ПутьКаталога, ФайлОтвета, НайденныйОтвет.Имя);

		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			ТекстОшибки = ЭАрМ_Служебный.ТекстИсключения(ОшибкаИсключения);
			ДобавитьСообщение(Итоги, СтрШаблон("%1: %2", НайденныйОтвет.Имя, ТекстОшибки));
			ЗаписатьВЖурнал("", "ОтветыДалион", Ложь,
				СтрШаблон("%1: %2", НайденныйОтвет.Имя, ТекстОшибки));
			// Как и раньше: при исключении ответ остаётся в папке и разбирается
			// следующим проходом - захват снимается, имя возвращается
			Попытка
				ПереместитьФайл(ФайлОтвета.ПолноеИмя, НайденныйОтвет.ПолноеИмя);
			Исключение
				// Не вернулся - вернёт ВернутьЗависшиеОтветы через 30 минут
				ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
					"РазобратьОтветыКаталога (захваченный файл " + ФайлОтвета.Имя + " не возвращён - вернёт ВернутьЗависшиеОтветы)",
					ИнформацияОбОшибке());
			КонецПопытки;
		КонецПопытки;

	КонецЦикла;

	Возврат Разобрано;

КонецФункции

// Переименовывает ответ в «<имя>.processing» - атомарный захват файла.
//
// Возвращаемое значение:
//   Файл - захваченный файл; Неопределено - файл уже забрал другой проход
//
Функция ЗахватитьФайлОтвета(ФайлОтвета) Экспорт

	ПутьЗахвата = ФайлОтвета.ПолноеИмя + ".processing";
	Попытка
		ПереместитьФайл(ФайлОтвета.ПолноеИмя, ПутьЗахвата);
	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ЗахватитьФайлОтвета (файл " + ФайлОтвета.Имя + " не захвачен - занят или нет прав)", ОшибкаИсключения);
		Возврат Неопределено;
	КонецПопытки;

	Возврат Новый Файл(ПутьЗахвата);

КонецФункции

// Ответы, захваченные дольше 30 минут назад и так и не разобранные (сеанс
// упал посреди разбора), возвращаются под исходное имя - их разберёт
// следующий проход.
//
Процедура ВернутьЗависшиеОтветы(ПутьКаталога)

	Для Каждого Захваченный Из НайтиФайлы(ПутьКаталога, "response_*.json.processing") Цикл
		Попытка
			Если ТекущаяДатаСеанса() - Захваченный.ПолучитьВремяИзменения() < 1800 Тогда
				Продолжить;
			КонецЕсли;
			ПереместитьФайл(Захваченный.ПолноеИмя,
				Лев(Захваченный.ПолноеИмя, СтрДлина(Захваченный.ПолноеИмя) - СтрДлина(".processing")));
		Исключение
			ОшибкаИсключения = ИнформацияОбОшибке();
			// Его как раз вернул или разбирает другой проход
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
				"ВернутьЗависшиеОтветы (не возвращён " + Захваченный.Имя + ")", ОшибкаИсключения);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Убирает разобранный ответ в подкаталог archive папки обмена.
//
// Оставленный в папке файл разбирается на каждом проходе, поэтому переносим
// его всегда - даже если применить ответ не удалось.
//
// Параметры:
//   ИмяВАрхиве - Строка - имя файла в архиве; пусто - имя самого файла (для
//                захваченного ответа - исходное имя без «.processing»)
//
Процедура ПереместитьОтветВАрхив(ПутьКПапке, ФайлОтвета, ИмяВАрхиве = "") Экспорт

	Попытка

		АрхивПуть = ОбъединитьПуть(ПутьКПапке, "archive");

		АрхивКаталог = Новый Файл(АрхивПуть);
		Если НЕ АрхивКаталог.Существует() Тогда
			СоздатьКаталог(АрхивПуть);
		КонецЕсли;

		// ПереместитьФайл падает на существующем приёмнике, а имя ответа
		// повторяется: response_<идентификатор>.json приходит на документ дважды
		ПутьВАрхиве = ОбъединитьПуть(АрхивПуть, ?(ЗначениеЗаполнено(ИмяВАрхиве), ИмяВАрхиве, ФайлОтвета.Имя));
		ФайлВАрхиве = Новый Файл(ПутьВАрхиве);
		Если ФайлВАрхиве.Существует() Тогда
			УдалитьФайлы(ПутьВАрхиве);
		КонецЕсли;

		ПереместитьФайл(ФайлОтвета.ПолноеИмя, ПутьВАрхиве);

	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("ЗабратьОтветыИзПапки", СтрШаблон(
			"Не удалось убрать в архив %1: %2", ФайлОтвета.Имя,
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

// Забирает ответы Далиона с FTP и раскладывает их по реестру ЭТрН.
//
// База2 кладёт ответы в <Каталог>/result файлами response_<идентификатор>.json.
// Идентификатор - это идентификатор документа в СБИС, тот самый, под которым
// документ лежит в реестре: другого сквозного ключа между базами нет.
//
// Ответов на один документ приходит два, и оба нужны:
//   * при приёме  - "Принято", документ создан, но ещё не проведён;
//   * после проведения - итог приёмки со списком расхождений.
// Поэтому запись реестра не закрывается первым ответом, а обновляется каждым.
//
// Параметры:
//   Итоги - Структура - см. ВыполнитьОбмен, пополняется по ходу
//
// Возвращаемое значение:
//   Число - сколько ответов разобрано
//
Функция ЗабратьОтветыДалион(Итоги = Неопределено) Экспорт

	Если Итоги = Неопределено Тогда
		Итоги = НовыеИтогиОбмена();
	КонецЕсли;

	// Ответы забираем тем же транспортом, каким выгружаем. Раньше здесь был
	// только FTP: при обмене через папку функция выходила на проверке адреса
	// FTP-сервера, и статусы Далиона в реестр ЭТрН не попадали вовсе.
	Если ВРег(СокрЛП(ЭАрМ_НастройкиСервер.НастройкиОбмена().Транспорт)) = "ПАПКА" Тогда
		Возврат ЗабратьОтветыИзПапки(Итоги);
	КонецЕсли;

	НастройкиПодключения = ЭАрМ_НастройкиСервер.НастройкиFTP();

	Если НЕ ЗначениеЗаполнено(НастройкиПодключения.Сервер) Тогда
		ДобавитьСообщение(Итоги,
			НСтр("ru = 'Ответы Далиона не забраны: не заполнен адрес FTP-сервера'"));
		Возврат 0;
	КонецЕсли;

	Каталоги = ЭАрМ_НастройкиСервер.КаталогиОбменаFTP();

	Попытка
		Соединение = ЭАрМ_Служебный.СоздатьСоединениеFTP(НастройкиПодключения);
	Исключение
		ТекстОшибки = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
		ДобавитьСообщение(Итоги, СтрШаблон(
			НСтр("ru = 'Ответы Далиона: не удалось подключиться к FTP: %1'"), ТекстОшибки));
		ЗаписатьВЖурнал("", "ОтветыДалион", Ложь, ТекстОшибки);
		Возврат 0;
	КонецПопытки;

	Попытка
		ЭАрМ_Служебный.ОбеспечитьКаталогFTP(Соединение, Каталоги.АрхивОтветов);
	Исключение
		// Без архива ответы всё равно читаются, поэтому обмен не прерываем.
		// Но и молчать нельзя: неархивированный ответ разбирается снова и снова
		ЗаписатьВЖурнал("", "ОтветыДалион", Ложь, СтрШаблон(
			НСтр("ru = 'Каталог архива %1 недоступен: %2'"),
			Каталоги.АрхивОтветов,
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
	КонецПопытки;

	Попытка
		ФайлыОтветов = Соединение.НайтиФайлы(Каталоги.Ответы, "response_*.json");
	Исключение
		ТекстОшибки = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
		ДобавитьСообщение(Итоги, СтрШаблон(
			НСтр("ru = 'Ответы Далиона: не читается каталог %1: %2'"),
			Каталоги.Ответы, ТекстОшибки));
		ЗаписатьВЖурнал("", "ОтветыДалион", Ложь, ТекстОшибки);
		Возврат 0;
	КонецПопытки;

	Разобрано = 0;

	Для Каждого ФайлНаСервере Из ФайлыОтветов Цикл

		ВременныйФайл = ПолучитьИмяВременногоФайла("json");

		Попытка

			Соединение.Получить(ФайлНаСервере.ПолноеИмя, ВременныйФайл);

			ЧтениеТекста = Новый ЧтениеТекста(ВременныйФайл, КодировкаТекста.UTF8);
			Содержимое = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();

			// Не всякий отправитель пишет UTF-8 без BOM, а ЧтениеJSON
			// на BOM спотыкается
			Если Лев(Содержимое, 1) = Символ(65279) Тогда
				Содержимое = Сред(Содержимое, 2);
			КонецЕсли;

			ДанныеОтвета = ЭАрМ_Служебный.ПрочитатьОтветJSON(СокрЛП(Содержимое));

			Если ДанныеОтвета = Неопределено Тогда
				ВызватьИсключение НСтр("ru = 'Ответ не разобрался как JSON'");
			КонецЕсли;

			//@skip-check query-in-loop
			РезультатПрименения = ПрименитьОтветДалион(ДанныеОтвета);

			Если РезультатПрименения.Успех Тогда
				Разобрано = Разобрано + 1;
			Иначе
				ДобавитьСообщение(Итоги, СтрШаблон("%1: %2",
					ФайлНаСервере.Имя, РезультатПрименения.Ошибка));
			КонецЕсли;

			// Файл убираем в архив в любом случае: неопознанный ответ,
			// оставленный в каталоге, будет разбираться каждый проход
			Попытка
				Соединение.Переместить(ФайлНаСервере.ПолноеИмя,
					Каталоги.АрхивОтветов + "/" + ФайлНаСервере.Имя);
			Исключение
				ЭАрМ_Служебный.ЗаписатьОшибку("ЗабратьОтветыДалион", СтрШаблон(
					"Не удалось убрать в архив %1: %2", ФайлНаСервере.Имя,
					ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
			КонецПопытки;

		Исключение
			ТекстОшибки = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
			ДобавитьСообщение(Итоги, СтрШаблон("%1: %2", ФайлНаСервере.Имя, ТекстОшибки));
			ЗаписатьВЖурнал("", "ОтветыДалион", Ложь,
				СтрШаблон("%1: %2", ФайлНаСервере.Имя, ТекстОшибки));
		КонецПопытки;

		УдалитьВременныйФайлОбмена(ВременныйФайл);

	КонецЦикла;

	Итоги.ОтветовПолучено = Итоги.ОтветовПолучено + Разобрано;

	Если Разобрано > 0 ИЛИ ФайлыОтветов.Количество() > 0 Тогда
		ДобавитьСообщение(Итоги, СтрШаблон(
			НСтр("ru = 'Ответы Далиона: разобрано %1 из %2'"),
			Разобрано, ФайлыОтветов.Количество()));
	КонецЕсли;

	ЗаписатьВЖурнал("", "ОтветыДалион", Истина,
		СтрШаблон(НСтр("ru = 'Разобрано ответов: %1'"), Разобрано));

	// Приходные накладные Далион кладёт в папку обмена всегда, каким бы
	// транспортом ни ходили ответы на заявки: выгрузка result_receipts - это
	// не ответ на документ, а отчёт базы о том, что она провела.
	Возврат Разобрано + ЗабратьПриходныеНакладныеДалион(Итоги);

КонецФункции

// Забирает выгрузки приходных накладных Далиона с диска.
//
// Читаем ровно там, откуда берём ответы Далиона: в настройках это "Папка
// ответов Далион", и указывает она на каталог result. Отдельного пути для
// накладных нет - если бы мы дописывали к настройке свой подкаталог, на
// базе с настройкой d:\obmen\result файлы искались бы в result\result.
//
// Ответы на заявки могут приходить и по FTP - как настроен транспорт.
// Приходные накладные Далион выкладывает только на диск, поэтому этот проход
// от транспорта не зависит.
//
// Параметры:
//   Итоги - Структура - см. ВыполнитьОбмен, пополняется по ходу
//
// Возвращаемое значение:
//   Число - сколько накладных разобрано
//
Функция ЗабратьПриходныеНакладныеДалион(Итоги = Неопределено) Экспорт

	Если Итоги = Неопределено Тогда
		Итоги = НовыеИтогиОбмена();
	КонецЕсли;

	ПутьКПапке = ЭАрМ_НастройкиСервер.НастройкиОбмена().ПапкаОбмена;

	Если НЕ ЗначениеЗаполнено(ПутьКПапке) Тогда
		ДобавитьСообщение(Итоги,
			НСтр("ru = 'Приходные накладные не забраны: не указана папка обмена'"));
		Возврат 0;
	КонецЕсли;

	Каталог = Новый Файл(ПутьКПапке);
	Если НЕ Каталог.Существует() Тогда
		ДобавитьСообщение(Итоги, СтрШаблон(
			НСтр("ru = 'Приходные накладные: папка обмена не найдена: %1'"), ПутьКПапке));
		Возврат 0;
	КонецЕсли;

	Разобрано = 0;

	// КаталогиОтветовВПапке отдаёт саму папку из настроек и, если он там есть,
	// вложенный result: одна база настроена на корень обмена, другая сразу на
	// каталог результатов, и обе раскладки должны читаться.
	Для Каждого ПутьКаталога Из КаталогиОтветовВПапке(ПутьКПапке) Цикл
		//@skip-check query-in-loop
		Разобрано = Разобрано + РазобратьПриходныеНакладныеКаталога(ПутьКаталога, Итоги);
	КонецЦикла;

	Если Разобрано > 0 Тогда
		ДобавитьСообщение(Итоги, СтрШаблон(
			НСтр("ru = 'Приходных накладных Далиона разобрано: %1'"), Разобрано));
	КонецЕсли;

	Возврат Разобрано;

КонецФункции

// Читает папку обмена и возвращает итог в виде, пригодном для показа.
//
// ЗабратьПриходныеНакладныеДалион копит объяснения в Итогах, а форме нужен
// не только счётчик: накладная, номер которой не нашёлся в реестрах, молча
// пропускается, и без этих строк непонятно, почему ничего не изменилось.
//
// Возвращаемое значение:
//   Структура:
//     * Разобрано - Число  - сколько накладных легло в реестры
//     * Сообщение - Строка - объяснения по ходу разбора, через перевод строки
//
Функция ПрочитатьПриходныеНакладныеИзПапки() Экспорт

	Итоги = НовыеИтогиОбмена();
	Разобрано = ЗабратьПриходныеНакладныеДалион(Итоги);

	Возврат Новый Структура("Разобрано, Сообщение",
		Разобрано, СтрСоединить(Итоги.Сообщения, Символы.ПС));

КонецФункции

// Записывает один ответ Далиона в реестр ЭТрН.
//
// Вынесена отдельно и экспортной: тем же кодом ответ применяют HTTP-сервис
// и разбор папки обмена, а не только чтение FTP.
//
// Параметры:
//   ДанныеОтвета - Соответствие, Структура - разобранный JSON ответа
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, ИдентификаторСБИС
//
Функция ПрименитьОтветДалион(ДанныеОтвета) Экспорт

	Результат = Новый Структура("Успех, Ошибка, ИдентификаторСБИС", Ложь, "", "");

	ИдентификаторСБИС = ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "requestId", ""));

	Если НЕ ЗначениеЗаполнено(ИдентификаторСБИС) Тогда
		Результат.Ошибка = НСтр("ru = 'В ответе нет requestId'");
		Возврат Результат;
	КонецЕсли;

	Результат.ИдентификаторСБИС = ИдентификаторСБИС;

	Ответ = РазобратьОтветДалион(ДанныеОтвета);

	НачатьТранзакцию();
	Попытка

		МенеджерЗаписи = МенеджерРеестраЭТрН(ИдентификаторСБИС);

		Если МенеджерЗаписи = Неопределено Тогда
			ОтменитьТранзакцию();
			// Ответ Далиона по ЭТрН, которой в реестре нет (старая, чужая или
			// удалённая из реестра): не ошибка обмена - файл уходит в архив,
			// строка в журнале информационная. В Далион отправляем только
			// вручную, поэтому такие ответы приходят по старым отправкам
			Результат.Успех = Истина;
			ЗаписатьВЖурнал(ИдентификаторСБИС, "ОтветДалион", Истина, СтрШаблон(
				НСтр("ru = 'Ответ Далиона пропущен: в реестре ЭТрН нет документа %1'"), ИдентификаторСБИС));
			Возврат Результат;
		КонецЕсли;

		МенеджерЗаписи.СтатусДалион         = Лев(Ответ.Статус, 30);
		МенеджерЗаписи.ДатаОтветаДалион     = ТекущаяДатаСеанса();
		МенеджерЗаписи.ПроведенВДалион      = Ответ.Проведен;
		МенеджерЗаписи.ЕстьРасхождения      = Ответ.ЕстьРасхождения;
		МенеджерЗаписи.КомментарийДалион    = Лев(Ответ.Комментарий, 500);
		МенеджерЗаписи.РасхожденияДалион    = Лев(Ответ.ТекстРасхождений, 1024);

		// Реквизиты документа приходят только со вторым ответом - тем,
		// что после проведения. Пустыми значениями первого ответа
		// затирать их нельзя
		Если ЗначениеЗаполнено(Ответ.НомерДокумента) Тогда
			МенеджерЗаписи.НомерДокументаДалион = Лев(Ответ.НомерДокумента, 50);
		КонецЕсли;
		Если ЗначениеЗаполнено(Ответ.ДатаДокумента) Тогда
			МенеджерЗаписи.ДатаДокументаДалион = Ответ.ДатаДокумента;
		КонецЕсли;
		Если Ответ.СуммаДокумента <> 0 Тогда
			МенеджерЗаписи.СуммаДокументаДалион = Ответ.СуммаДокумента;
		КонецЕсли;

		МенеджерЗаписи.Записать(Истина);
		Если Ответ.Проведен Тогда
			ЗаписатьТоварыИзОтветаДалион(
				ИдентификаторСБИС, Ответ.НомерДокумента, ДанныеОтвета);
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьВЖурнал(ИдентификаторСБИС, "ОтветДалион", Ложь, Результат.Ошибка);
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = Истина;

	ЗаписатьВЖурнал(ИдентификаторСБИС, "ОтветДалион", НЕ Ответ.ЕстьРасхождения,
		СтрШаблон(НСтр("ru = '%1. Документ Базы2: %2. %3'"),
			Ответ.Статус,
			?(ЗначениеЗаполнено(Ответ.НомерДокумента), Ответ.НомерДокумента,
				НСтр("ru = 'номер не прислан'")),
			Ответ.Комментарий));

	Возврат Результат;

КонецФункции

// Записывает приходные накладные Далиона из одного файла выгрузки.
//
// Файл - не ответ на заявку, а выгрузка проведённых накладных за период:
// "ПриходныеНакладные" со своими шапками и табличными частями. Связь с ЭДО
// одна - ВходящийНомер в шапке: туда Далион кладёт номер документа, по
// которому накладная заведена. Сначала ищем этот номер в реестре УПД, потом
// в реестре ЭТрН - номер у пары обычно один и тот же, а ведущей в цепочке
// стала УПД.
//
// Вынесена экспортной по той же причине, что и ПрименитьОтветДалион: файл
// может принести и папка обмена, и HTTP-сервис.
//
// Параметры:
//   ДанныеФайла - Соответствие, Структура - разобранный JSON выгрузки
//   Итоги       - Структура - см. НовыеИтогиОбмена
//
// Возвращаемое значение:
//   Число - сколько накладных легло в реестры
//
Функция ПрименитьПриходныеНакладныеДалион(ДанныеФайла, Итоги = Неопределено) Экспорт

	Записано = 0;

	Накладные = ЭАрМ_Служебный.ЗначениеВМассив(
		ЭАрМ_Служебный.ЗначениеУзла(ДанныеФайла, "ПриходныеНакладные"));

	Для Каждого Накладная Из Накладные Цикл

		//@skip-check query-in-loop
		Применение = ПрименитьПриходнуюНакладнуюДалион(Накладная);

		Если Применение.Успех Тогда
			Записано = Записано + 1;
			Продолжить;
		КонецЕсли;

		Если Итоги <> Неопределено Тогда
			ДобавитьСообщение(Итоги, Применение.Ошибка);
		КонецЕсли;

	КонецЦикла;

	Возврат Записано;

КонецФункции

// Записывает одну приходную накладную Далиона в реестры.
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, Идентификатор
//
Функция ПрименитьПриходнуюНакладнуюДалион(Накладная) Экспорт

	Результат = Новый Структура("Успех, Ошибка, Идентификатор", Ложь, "", "");

	Приход = РазобратьПриходнуюНакладнуюДалион(Накладная);

	Если НЕ ЗначениеЗаполнено(Приход.ВходящийНомер) Тогда
		Результат.Ошибка = СтрШаблон(
			НСтр("ru = 'Приходная накладная %1: в шапке нет ВходящегоНомера'"),
			Приход.Номер);
		Возврат Результат;
	КонецЕсли;

	СвязанныйДокумент = НайтиДокументЭДОПоНомеру(Приход.ВходящийНомер);

	Если НЕ ЗначениеЗаполнено(СвязанныйДокумент.Идентификатор) Тогда
		Результат.Ошибка = СтрШаблон(
			НСтр("ru = 'Приходная накладная %1: документа ЭДО с номером %2 в реестрах нет'"),
			Приход.Номер, Приход.ВходящийНомер);
		Возврат Результат;
	КонецЕсли;

	Результат.Идентификатор = СвязанныйДокумент.Идентификатор;

	ИдентификаторУПД  = "";
	ИдентификаторЭТрН = "";
	Если СвязанныйДокумент.Реестр = "УПД" Тогда
		ИдентификаторУПД = СвязанныйДокумент.Идентификатор;
		НайденнаяЭТрН = НайтиЭТрНДляУПД(ИдентификаторУПД, Приход.ВходящийНомер);
		ИдентификаторЭТрН = НайденнаяЭТрН.Идентификатор;
	Иначе
		ИдентификаторЭТрН = СвязанныйДокумент.Идентификатор;
		СвязаннаяУПД = НайтиУПДДляЭТрН(ИдентификаторЭТрН, Приход.ВходящийНомер);
		ИдентификаторУПД = СвязаннаяУПД.Идентификатор;
	КонецЕсли;

	ИдентификаторТоваров = ?(ЗначениеЗаполнено(ИдентификаторУПД),
		ИдентификаторУПД, ИдентификаторЭТрН);
	ПриходИзменился = ПриходОтличаетсяОтЗаписанного(
		ИдентификаторТоваров, ИдентификаторУПД, Приход);

	НачатьТранзакцию();
	Попытка

		Если ЗначениеЗаполнено(ИдентификаторУПД) Тогда
			ЗаписатьПриходнуюНакладнуюВРеестрУПД(ИдентификаторУПД, Приход,
				ЗначениеЗаполнено(ИдентификаторЭТрН));
		КонецЕсли;

		Если ЗначениеЗаполнено(ИдентификаторЭТрН) Тогда
			ЗаписатьПриходнуюНакладнуюВРеестрЭТрН(ИдентификаторЭТрН, Приход);
		КонецЕсли;

		ПерезаписатьТоварыБазы2(
			ИдентификаторТоваров, Приход.Номер, Приход.Позиции);

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Приходная накладная %1: %2'"),
			Приход.Номер,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписатьВЖурнал(СвязанныйДокумент.Идентификатор, "ПриходныеНакладные",
			Ложь, Результат.Ошибка);
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = Истина;

	// Сверку здесь не запускаем: задание цепочки само возьмёт цепочки,
	// у которых дата обновления новее даты сверки. Совпавший приход не метим.
	Если ПриходИзменился Тогда
		ЭАрМ_ЦепочкаЗакупки.ПометитьОткрытыеЦепочкиНаСверку(
			ИдентификаторУПД, ИдентификаторЭТрН);
	КонецЕсли;

	ЗаписатьВЖурнал(СвязанныйДокумент.Идентификатор, "ПриходныеНакладные", Истина,
		СтрШаблон(НСтр("ru = 'Приходная накладная %1 от %2, строк %3, ЭДО %4'"),
			Приход.Номер, Формат(Приход.Дата, "ДЛФ=D"),
			Приход.Позиции.Количество(), Приход.ВходящийНомер));

	Возврат Результат;

КонецФункции

// Приводит галочку «Есть ЭТрН» в реестре УПД к факту: к УПД есть ЭТрН.
//
// Раньше галочка ставилась только вместе с приходной Далиона и только через
// цепочку закупки: пока прихода нет или ЭТрН не попала в цепочку, она
// пустовала, хотя ЭТрН к УПД уже пришла. Теперь ЭТрН ищется так же, как
// форма реестра УПД: ЭТрН со ссылкой на УПД, товары ЭТрН со ссылкой на УПД,
// цепочка с этой УПД и ЭТрН.
//
// Параметры:
//   ИдентификаторУПД - Строка - одна УПД; пустая - весь реестр
//
// Возвращаемое значение:
//   Число - сколько галочек изменено
//
Функция ОбновитьПризнакЭТрНРеестраУПД(ИдентификаторУПД = "") Экспорт

	// Для одной УПД источники фильтруются по ней же: раньше временная таблица
	// собиралась по всем ЭТрН, всем строкам товаров ЭТрН и всем цепочкам -
	// на каждый выбор строки в форме реестра УПД

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЭТрН.ИдентификаторУПД КАК ИдентификаторУПД
	|ПОМЕСТИТЬ УПДсЭТрН
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	ЭТрН.ИдентификаторУПД <> """"
	|	И (&ВсеУПД
	|			ИЛИ ЭТрН.ИдентификаторУПД = &ИдентификаторУПД)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.ИдентификаторУПД
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторУПД <> """"
	|	И Товары.ИсточникТоваров = ""ЭТрН""
	|	И (&ВсеУПД
	|			ИЛИ Товары.ИдентификаторУПД = &ИдентификаторУПД)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Цепочка.ИдентификаторУПД
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторУПД <> """"
	|	И Цепочка.ИдентификаторЭТрН <> """"
	|	И (&ВсеУПД
	|			ИЛИ Цепочка.ИдентификаторУПД = &ИдентификаторУПД)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	ВЫБОР
	|		КОГДА УПДсЭТрН.ИдентификаторУПД ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьЭТрН
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ УПДсЭТрН КАК УПДсЭТрН
	|		ПО УПД.ИдентификаторСБИС = УПДсЭТрН.ИдентификаторУПД
	|ГДЕ
	|	(&ВсеУПД
	|			ИЛИ УПД.ИдентификаторСБИС = &ИдентификаторУПД)
	|	И (УПД.ЕстьЭТрН И УПДсЭТрН.ИдентификаторУПД ЕСТЬ NULL
	|			ИЛИ НЕ УПД.ЕстьЭТрН И НЕ УПДсЭТрН.ИдентификаторУПД ЕСТЬ NULL)";
	Запрос.УстановитьПараметр("ВсеУПД", НЕ ЗначениеЗаполнено(ИдентификаторУПД));
	Запрос.УстановитьПараметр("ИдентификаторУПД", ЭАрМ_Служебный.СтрокойИлиПусто(ИдентификаторУПД));

	Изменено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		НачатьТранзакцию();
		Попытка
			ЗаблокироватьСтрокуРеестра("РегистрСведений.ЭАрМ_УПД_Входящий", Выборка.ИдентификаторСБИС);
			МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ИдентификаторСБИС = Выборка.ИдентификаторСБИС;
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Выбран() И МенеджерЗаписи.ЕстьЭТрН <> Выборка.ЕстьЭТрН Тогда
				МенеджерЗаписи.ЕстьЭТрН = Выборка.ЕстьЭТрН;
				МенеджерЗаписи.Записать(Истина);
				Изменено = Изменено + 1;
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС, "ПризнакЭТрН", Ложь,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Возврат Изменено;

КонецФункции

// Кладёт принятое поступление Далиона в реестр УПД/ЭТрН и в товары База2.
// Цепочка уже знает связь; без этой записи форма реестра УПД не видит Далион.
//
Процедура ОтразитьПриходДалионаВРеестреЭДО(ИдентификаторУПД, ИдентификаторЭТрН, Приход) Экспорт

	Если Приход = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД)
		И НЕ ЗначениеЗаполнено(ИдентификаторЭТрН) Тогда
		ЭАрМ_ПриемПакетовДалион.Трасса("", СтрШаблон(
			"Документ: приход %1 в реестры не записан - у цепочки нет ни УПД, ни ЭТрН", Приход.Номер), Ложь);
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		Если ЗначениеЗаполнено(ИдентификаторУПД) Тогда
			ЗаписатьПриходнуюНакладнуюВРеестрУПД(ИдентификаторУПД, Приход,
				ЗначениеЗаполнено(ИдентификаторЭТрН));
			ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторУПД, СтрШаблон(
				"Документ: в строку реестра УПД %1 записан приход Далиона № %2 от %3, сумма %4, статус «%5», строк товаров %6",
				ИдентификаторУПД, Приход.Номер, Формат(Приход.Дата, "ДЛФ=D"),
				Формат(Приход.Сумма, "ЧДЦ=2; ЧГ=0"), Приход.Статус,
				?(Приход.Свойство("Позиции"), Приход.Позиции.Количество(), 0)));
		КонецЕсли;

		Если ЗначениеЗаполнено(ИдентификаторЭТрН) Тогда
			ЗаписатьПриходнуюНакладнуюВРеестрЭТрН(ИдентификаторЭТрН, Приход);
		КонецЕсли;

		ИдентификаторТоваров = ?(ЗначениеЗаполнено(ИдентификаторУПД),
			ИдентификаторУПД, ИдентификаторЭТрН);
		Если Приход.Свойство("Позиции") Тогда
			ПерезаписатьТоварыБазы2(ИдентификаторТоваров, Приход.Номер, Приход.Позиции);
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОшибкаИсключения = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЗаписатьВЖурнал(?(ЗначениеЗаполнено(ИдентификаторУПД), ИдентификаторУПД, ИдентификаторЭТрН),
			"ПриходныеНакладные", Ложь,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ОшибкаИсключения));
		// Транзакция отменена: приход в реестры УПД/ЭТрН и в товары «База2» не попал
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(
			?(ЗначениеЗаполнено(ИдентификаторУПД), ИдентификаторУПД, ИдентификаторЭТрН),
			"ОтразитьПриходДалионаВРеестреЭДО (транзакция отменена - реестр УПД, реестр ЭТрН и товары База2 не записаны)",
			ОшибкаИсключения);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииОтветов

// Раскладывает ответ Базы2 по понятным полям.
//
// Ключи те же, что пишет Расш1_ПриемДокументов: requestId, approved, comment,
// status, posted, hasDiscrepancies, discrepancies, documentNumber,
// documentDate, documentSum. Старый формат ответа знал только первые три,
// поэтому status и posted восстанавливаем из approved, когда их нет.
//
// Возвращаемое значение:
//   Структура - Статус, Проведен, ЕстьРасхождения, Комментарий,
//               ТекстРасхождений, НомерДокумента, ДатаДокумента, СуммаДокумента
//
Функция РазобратьОтветДалион(ДанныеОтвета)

	Ответ = Новый Структура;

	Принято = ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "approved");
	Проведен = ЭтоИстина(ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "posted"));

	Создан = ЭтоИстина(ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "created"));

	Статус = ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "status", ""));
	Если НЕ ЗначениеЗаполнено(Статус) Тогда
		// Старая База2 признака не присылала - выводим статус из того, что есть
		Статус = ?(НЕ ЭтоИстина(Принято), "ОшибкаОбработки",
			?(Проведен, "Проведен", ?(Создан, "СозданДокумент", "Принято")));
	КонецЕсли;

	Ответ.Вставить("Статус",   Статус);
	Ответ.Вставить("Проведен", Проведен);
	Ответ.Вставить("Создан",   Создан);
	// Товарный состав в Базе2 мог остаться пустым - тогда там одна шапка
	Ответ.Вставить("ТоварыЗаполнены",
		ЭтоИстина(ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "itemsFilled")));
	ЕстьЦеновыеРасхождения =
		ЭтоИстина(ЭАрМ_Служебный.ЗначениеУзла(
			ДанныеОтвета, "hasPreliminaryPriceDiscrepancies"))
		ИЛИ ЭтоИстина(ЭАрМ_Служебный.ЗначениеУзла(
			ДанныеОтвета, "hasPriceDiscrepancies"));
	Ответ.Вставить("ЕстьРасхождения",
		ЭтоИстина(ЭАрМ_Служебный.ЗначениеУзла(
			ДанныеОтвета, "hasDiscrepancies"))
		ИЛИ ЕстьЦеновыеРасхождения);
	Ответ.Вставить("Комментарий", ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "comment", "")));

	ТекстыРасхождений = Новый Массив;
	Для Каждого ИмяМассива Из СтрРазделить(
		"discrepancies,preliminaryPriceDiscrepancies,priceDiscrepancies",
		",", Ложь) Цикл
		ТекстРасхождения = ТекстРасхождений(
			ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, ИмяМассива));
		Если ЗначениеЗаполнено(ТекстРасхождения) Тогда
			ТекстыРасхождений.Добавить(ТекстРасхождения);
		КонецЕсли;
	КонецЦикла;
	Ответ.Вставить("ТекстРасхождений",
		СтрСоединить(ТекстыРасхождений, Символы.ПС));

	Ответ.Вставить("НомерДокумента", ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "documentNumber", "")));
	Ответ.Вставить("ДатаДокумента", ЭАрМ_Служебный.ДатаИзСтрокиСБИС(
		ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "documentDate", "")));
	Ответ.Вставить("СуммаДокумента", ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
		ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "documentSum", 0)));

	Возврат Ответ;

КонецФункции

// Собирает расхождения в читаемый текст для реестра.
//
// Строка расхождения приходит структурой: Номенклатура, КоличествоПоПоставщику,
// КоличествоФакт, Разница, Тип. У старых ответов расхождения могли быть
// простыми строками - их берём как есть.
//
Функция ТекстРасхождений(Расхождения)

	Если Расхождения = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Строки = Новый Массив;

	Для Каждого Расхождение Из ЭАрМ_Служебный.ЗначениеВМассив(Расхождения) Цикл

		Номенклатура = ЭАрМ_Служебный.ЗначениеУзла(Расхождение, "Номенклатура");

		Если Номенклатура = Неопределено Тогда
			Строки.Добавить(ЭАрМ_Служебный.СтрокойИлиПусто(Расхождение));
			Продолжить;
		КонецЕсли;

		Если ЭАрМ_Служебный.ЗначениеУзла(Расхождение, "Тип", "") = "Цена" Тогда
			Строки.Добавить(СтрШаблон(
				"%1: цена поставщика %2, цена Базы2 %3, разница %4",
				ЭАрМ_Служебный.СтрокойИлиПусто(Номенклатура),
				ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
					ЭАрМ_Служебный.ЗначениеУзла(
						Расхождение, "ЦенаПоПоставщику", 0)),
				ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
					ЭАрМ_Служебный.ЗначениеУзла(
						Расхождение, "ЦенаФакт", 0)),
				ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
					ЭАрМ_Служебный.ЗначениеУзла(
						Расхождение, "РазницаЦены", 0))));
			Продолжить;
		КонецЕсли;

		Строки.Добавить(СтрШаблон("%1: поставщик %2, факт %3 (%4)",
			ЭАрМ_Служебный.СтрокойИлиПусто(Номенклатура),
			ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
				ЭАрМ_Служебный.ЗначениеУзла(Расхождение, "КоличествоПоПоставщику", 0)),
			ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
				ЭАрМ_Служебный.ЗначениеУзла(Расхождение, "КоличествоФакт", 0)),
			ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(Расхождение, "Тип", ""))));

	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Сохраняет фактические товары проведённой накладной Базы2 в общем регистре.
//
Процедура ЗаписатьТоварыИзОтветаДалион(
		ИдентификаторСБИС, НомерДокументаДалион, ДанныеОтвета)

	Товары = ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "items");
	Если Товары = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Позиции = Новый Массив;

	Для Каждого Товар Из ЭАрМ_Служебный.ЗначениеВМассив(Товары) Цикл

		Позиция = Новый Структура;
		Позиция.Вставить("Наименование", ЭАрМ_Служебный.СтрокойИлиПусто(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "Номенклатура", "")));
		Позиция.Вставить("КодНоменклатуры", ЭАрМ_Служебный.СтрокойИлиПусто(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "КодНоменклатуры", "")));
		Позиция.Вставить("Артикул", ЭАрМ_Служебный.СтрокойИлиПусто(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "Артикул", "")));
		Позиция.Вставить("Количество", ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "Количество", 0)));
		Позиция.Вставить("Цена", ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "Цена", 0)));
		Позиция.Вставить("Сумма", ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "Сумма", 0)));
		Позиция.Вставить("СтавкаНДС", ЭАрМ_Служебный.СтрокойИлиПусто(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "СтавкаНДС", "")));
		Позиция.Вставить("СуммаНДС", ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "СуммаНДС", 0)));

		Позиции.Добавить(Позиция);

	КонецЦикла;

	ПерезаписатьТоварыБазы2(ИдентификаторСБИС, НомерДокументаДалион, Позиции);

КонецПроцедуры

// Перезаписывает фактические строки Базы2 под документом ЭДО.
//
// Отрицательные номера позиций не пересекаются с положительной нумерацией
// строк исходной ЭТрН/УПД под тем же идентификатором.
//
// Строки перезаписываются целиком: приход могли перепровести, и позиция,
// которой в нём больше нет, не должна остаться в регистре.
//
// Вызывается только внутри транзакции.
//
// Параметры:
//   ИдентификаторСБИС - Строка - документ ЭДО, к которому относится приход
//   НомерДокумента    - Строка - номер документа Базы2
//   Позиции           - Массив из Структура - Наименование, КодНоменклатуры,
//                       Артикул, Количество, Цена, Сумма, СтавкаНДС, СуммаНДС
//
// Истина, если шапка или строки прихода отличаются от уже записанных.
// Сумма, число строк, количество и цена. Совпавший файл сверку не будит.
//
Функция ПриходОтличаетсяОтЗаписанного(ИдентификаторТоваров, ИдентификаторУПД, Приход)

	ЗаписаннаяСумма = 0;
	Если ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Шапка = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
		Шапка.ИдентификаторСБИС = ИдентификаторУПД;
		Шапка.Прочитать();
		Если Шапка.Выбран() Тогда
			ЗаписаннаяСумма = Шапка.СуммаДокументаДалион;
		КонецЕсли;
	КонецЕсли;

	Если Окр(ЗаписаннаяСумма, 2) <> Окр(Приход.Сумма, 2) Тогда
		Возврат Истина;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.КодНоменклатуры КАК КодНоменклатуры,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &Идентификатор
	|	И Товары.ИсточникТоваров = ""База2""";
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторТоваров);

	Записанные = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Записанные.Добавить(Новый Структура("КодНоменклатуры, Количество, Цена",
			Выборка.КодНоменклатуры, Выборка.Количество, Выборка.Цена));
	КонецЦикла;

	Возврат КлючСтрокПрихода(Записанные) <> КлючСтрокПрихода(Приход.Позиции);

КонецФункции

// Код, количество и цена строк в одном порядке, чтобы сравнить состав прихода.
//
Функция КлючСтрокПрихода(Позиции)

	Ключи = Новый Массив;
	Для Каждого Позиция Из Позиции Цикл
		Ключи.Добавить(СокрЛП(Позиция.КодНоменклатуры) + "|"
			+ Формат(Окр(Позиция.Количество, 3), "ЧРД=.; ЧГ=0") + "|"
			+ Формат(Окр(Позиция.Цена, 2), "ЧРД=.; ЧГ=0"));
	КонецЦикла;
	Ключи.Сортировать();

	Возврат СтрСоединить(Ключи, Символы.ПС);

КонецФункции

Процедура ПерезаписатьТоварыБазы2(ИдентификаторСБИС, НомерДокумента, Позиции)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(
		"РегистрСведений.ЭАрМ_ТоварыЭТрН");
	ЭлементБлокировки.УстановитьЗначение(
		"ИдентификаторСБИС", ИдентификаторСБИС);
	Блокировка.Заблокировать();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Товары.НомерПозиции КАК НомерПозиции
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &Идентификатор
	|	И Товары.ИсточникТоваров = &Источник";
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторСБИС);
	Запрос.УстановитьПараметр("Источник", "База2");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Менеджер = РегистрыСведений.ЭАрМ_ТоварыЭТрН.СоздатьМенеджерЗаписи();
		Менеджер.ИдентификаторСБИС = Выборка.ИдентификаторСБИС;
		Менеджер.НомерПозиции = Выборка.НомерПозиции;
		Менеджер.Удалить();
	КонецЦикла;

	НомерПозиции = 0;
	Для Каждого ОписаниеПозиции Из Позиции Цикл

		НомерПозиции = НомерПозиции - 1;
		Менеджер = РегистрыСведений.ЭАрМ_ТоварыЭТрН.СоздатьМенеджерЗаписи();
		Менеджер.ИдентификаторСБИС = ИдентификаторСБИС;
		Менеджер.НомерПозиции = НомерПозиции;
		Менеджер.НомерДокумента = Лев(НомерДокумента, 50);
		Менеджер.ИсточникТоваров = "База2";
		Менеджер.Наименование = Лев(ОписаниеПозиции.Наименование, 500);
		Менеджер.КодНоменклатуры = Лев(ОписаниеПозиции.КодНоменклатуры, 50);
		Менеджер.Артикул = Лев(ОписаниеПозиции.Артикул, 50);
		Если ОписаниеПозиции.Свойство("Штрихкод") И ЗначениеЗаполнено(ОписаниеПозиции.Штрихкод) Тогда
			Менеджер.Штрихкод = Лев(ОписаниеПозиции.Штрихкод, 200);
		КонецЕсли;
		Менеджер.Количество = ОписаниеПозиции.Количество;
		Менеджер.Цена = ОписаниеПозиции.Цена;
		Менеджер.Сумма = ОписаниеПозиции.Сумма;
		Менеджер.СтавкаНДС = Лев(ОписаниеПозиции.СтавкаНДС, 20);
		Менеджер.СуммаНДС = ОписаниеПозиции.СуммаНДС;
		Менеджер.Записать(Истина);

	КонецЦикла;

	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторСБИС, СтрШаблон(
		"Запись: ЭАрМ_ТоварыЭТрН (источник «База2» - колонки Далиона в товарах УПД) под %1: приход № %2, строк %3",
		ИдентификаторСБИС, НомерДокумента, Позиции.Количество()), Позиции.Количество() > 0);

	// Строки «База2» читаем обратно: сколько записали, столько должно лежать в регистре
	ЭАрМ_ПриемПакетовДалион.ПроверитьКоличествоЗапросом(ИдентификаторСБИС,
		"ЭАрМ_ТоварыЭТрН «База2» под " + ИдентификаторСБИС,
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
		|ГДЕ
		|	Товары.ИдентификаторСБИС = &Идентификатор
		|	И Товары.ИсточникТоваров = &Источник",
		Новый Структура("Идентификатор, Источник", ИдентификаторСБИС, "База2"), Позиции.Количество());

КонецПроцедуры

// Разбирает выгрузки приходных накладных одного каталога.
//
// Файлы лежат рядом с ответами на заявки и читаются тем же проходом, поэтому
// и архивируются туда же: оставленный в папке файл разбирался бы на каждом
// круге заново.
//
// Возвращаемое значение:
//   Число - сколько накладных разобрано
//
Функция РазобратьПриходныеНакладныеКаталога(ПутьКаталога, Итоги)

	Разобрано = 0;

	Для Каждого ФайлВыгрузки Из НайтиФайлы(ПутьКаталога, "result_receipts_*.json") Цикл

		Попытка

			ДанныеФайла = ПрочитатьФайлОбменаJSON(ФайлВыгрузки.ПолноеИмя);

			Если ДанныеФайла = Неопределено Тогда
				ВызватьИсключение НСтр("ru = 'Выгрузка не разобралась как JSON'");
			КонецЕсли;

			//@skip-check query-in-loop
			Разобрано = Разобрано + ПрименитьПриходныеНакладныеДалион(ДанныеФайла, Итоги);

			ПереместитьОтветВАрхив(ПутьКаталога, ФайлВыгрузки);

		Исключение
			ТекстОшибки = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
			ДобавитьСообщение(Итоги, СтрШаблон("%1: %2", ФайлВыгрузки.Имя, ТекстОшибки));
			ЗаписатьВЖурнал("", "ПриходныеНакладные", Ложь,
				СтрШаблон("%1: %2", ФайлВыгрузки.Имя, ТекстОшибки));
		КонецПопытки;

	КонецЦикла;

	Возврат Разобрано;

КонецФункции

// Читает файл обмена и разбирает его как JSON.
//
// Возвращаемое значение:
//   Соответствие, Неопределено - разобранный узел
//
Функция ПрочитатьФайлОбменаJSON(ПолноеИмяФайла) Экспорт

	ЧтениеТекста = Новый ЧтениеТекста(ПолноеИмяФайла, КодировкаТекста.UTF8);
	Содержимое = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	// Не всякий отправитель пишет UTF-8 без BOM, а ЧтениеJSON на BOM спотыкается
	Если Лев(Содержимое, 1) = Символ(65279) Тогда
		Содержимое = Сред(Содержимое, 2);
	КонецЕсли;

	Возврат ЭАрМ_Служебный.ПрочитатьОтветJSON(СокрЛП(Содержимое));

КонецФункции

// Раскладывает приходную накладную Далиона по понятным полям.
//
// Возвращаемое значение:
//   Структура - ВходящийНомер, Номер, Представление, Дата, Проведен,
//               ПометкаУдаления, Статус, Сумма, Комментарий, Позиции
//
Функция РазобратьПриходнуюНакладнуюДалион(Накладная)

	Шапка = ЭАрМ_Служебный.ЗначениеУзла(Накладная, "Шапка");

	Приход = Новый Структура;
	Приход.Вставить("ВходящийНомер", ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеУзла(Шапка, "ВходящийНомер", "")));
	Приход.Вставить("Номер", ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеУзла(Шапка, "Номер", "")));
	Приход.Вставить("Представление", ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеПоПути(Шапка, "Ссылка.Представление", "")));
	Приход.Вставить("Дата", ЭАрМ_Служебный.ДатаИзСтрокиСБИС(
		ЭАрМ_Служебный.ЗначениеУзла(Шапка, "Дата", "")));
	Приход.Вставить("Сумма", ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
		ЭАрМ_Служебный.ЗначениеУзла(Шапка, "СуммаДокумента", 0)));
	Приход.Вставить("Комментарий", ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеУзла(Шапка, "Комментарий", "")));

	Проведен = ЭтоИстина(ЭАрМ_Служебный.ЗначениеУзла(Шапка, "Проведен"));
	Удален   = ЭтоИстина(ЭАрМ_Служебный.ЗначениеУзла(Шапка, "ПометкаУдаления"));

	Приход.Вставить("Проведен", Проведен И НЕ Удален);
	Приход.Вставить("ПометкаУдаления", Удален);
	Приход.Вставить("Статус", ?(Удален, "ПомеченНаУдаление",
		?(Проведен, "Проведен", "СозданДокумент")));

	Приход.Вставить("Позиции", ПозицииПриходнойНакладной(Накладная));

	Возврат Приход;

КонецФункции

// Строки товаров приходной накладной в общем виде.
//
// Номенклатура приходит ссылкой - представлением и уникальным
// идентификатором. Идентификатор базы Далиона в коде номенклатуры не нужен:
// сопоставление со строками УПД идёт по артикулу, коду поставщика или
// наименованию, а чужой GUID ни с чем не сойдётся.
//
// Возвращаемое значение:
//   Массив из Структура - см. ПерезаписатьТоварыБазы2
//
Функция ПозицииПриходнойНакладной(Накладная)

	Позиции = Новый Массив;

	Товары = ЭАрМ_Служебный.ЗначениеВМассив(
		ЭАрМ_Служебный.ЗначениеПоПути(Накладная, "ТабличныеЧасти.Товары"));

	Для Каждого Товар Из Товары Цикл

		Наименование = ЭАрМ_Служебный.СтрокойИлиПусто(
			ЭАрМ_Служебный.ЗначениеПоПути(Товар, "Номенклатура.Представление", ""));

		Если НЕ ЗначениеЗаполнено(Наименование) Тогда
			// Номенклатура могла прийти не ссылкой, а просто строкой
			Наименование = ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(Товар, "Номенклатура", ""));
		КонецЕсли;

		Позиция = Новый Структура;
		Позиция.Вставить("Наименование", Наименование);
		Позиция.Вставить("КодНоменклатуры", ЭАрМ_Служебный.СтрокойИлиПусто(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "Код", "")));
		Позиция.Вставить("Артикул", ЭАрМ_Служебный.СтрокойИлиПусто(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "Артикул", "")));
		Позиция.Вставить("Количество", ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "Количество", 0)));
		Позиция.Вставить("Цена", ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "Цена", 0)));
		Позиция.Вставить("Сумма", ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "Сумма", 0)));
		Позиция.Вставить("СтавкаНДС", ЭАрМ_Служебный.СтрокойИлиПусто(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "СтавкаНДС", "")));
		Позиция.Вставить("СуммаНДС", ЭАрМ_Служебный.ЧислоИзСтрокиСБИС(
			ЭАрМ_Служебный.ЗначениеУзла(Товар, "СуммаНДС", 0)));

		Позиции.Добавить(Позиция);

	КонецЦикла;

	Возврат Позиции;

КонецФункции

// Ищет документ ЭДО по номеру, которым его завели в Далионе.
//
// Сначала реестр УПД: ВходящийНомер приходной накладной - это её номер.
// Реестр ЭТрН остаётся запасным: номер у пары обычно один, но накладная
// могла быть заведена и по ЭТрН.
//
// Возвращаемое значение:
//   Структура:
//     * Идентификатор - Строка - документ в СБИС; пустая, если не нашли
//     * Реестр        - Строка - "УПД" либо "ЭТрН"
//
Функция НайтиДокументЭДОПоНомеру(НомерДокумента) Экспорт

	Результат = Новый Структура("Идентификатор, Реестр", "", "");

	НайденнаяУПД = НайтиУПДВРеестреПоНомеру(НомерДокумента);
	Если ЗначениеЗаполнено(НайденнаяУПД.Идентификатор) Тогда
		Результат.Идентификатор = НайденнаяУПД.Идентификатор;
		Результат.Реестр = "УПД";
		Возврат Результат;
	КонецЕсли;

	НайденнаяЭТрН = НайтиЭТрНВРеестреПоНомеру(НомерДокумента);
	Если ЗначениеЗаполнено(НайденнаяЭТрН) Тогда
		Результат.Идентификатор = НайденнаяЭТрН;
		Результат.Реестр = "ЭТрН";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Ищет ЭТрН в реестре по номеру: сначала точно, затем по нормализованному.
//
// Возвращаемое значение:
//   Строка - идентификатор СБИС; пустая, если не нашли
//
Функция НайтиЭТрНВРеестреПоНомеру(НомерДокумента)

	Искомый = ЭАрМ_Служебный.НомерДляСравнения(НомерДокумента);
	Если НЕ ЗначениеЗаполнено(Искомый) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭТрН.ИдентификаторСБИС КАК Идентификатор,
	|	ЭТрН.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	" + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("ЭТрН") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭТрН.Дата УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЭАрМ_Служебный.НомераСовпадают(Выборка.Номер, НомерДокумента) Тогда
			Возврат СокрЛП(Выборка.Идентификатор);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Кладёт шапку приходной накладной в строку реестра УПД.
//
// Вызывается только внутри транзакции.
//
Процедура ЗаписатьПриходнуюНакладнуюВРеестрУПД(ИдентификаторУПД, Приход, ЕстьЭТрН = Неопределено)

	ЗаблокироватьСтрокуРеестра("РегистрСведений.ЭАрМ_УПД_Входящий", ИдентификаторУПД);

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторУПД;
	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		// УПД из цепочки в реестре нет - приход всё равно отражается (товары
		// База2, документ), а не падает исключением вместе со всей записью
		ЗаписатьВЖурнал(ИдентификаторУПД, "ПриходныеНакладные", Истина, СтрШаблон(
			НСтр("ru = 'Приходная %1: в реестре УПД нет документа %2 - запись в реестр УПД пропущена'"),
			Приход.Номер, ИдентификаторУПД));
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторУПД, СтрШаблон(
			"Документ: УПД %1 из цепочки в реестре УПД нет - запись в реестр пропущена", ИдентификаторУПД), Ложь);
		Возврат;
	КонецЕсли;

	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторУПД, СтрШаблон(
		"Запись: реестр УПД № %1 ПЕРЕД записью прихода - было: приход Далиона «%2» от %3 на %4, статус «%5»; будет: приход № %6 от %7 на %8, статус «%9»",
		МенеджерЗаписи.Номер, МенеджерЗаписи.НомерДокументаДалион, Формат(МенеджерЗаписи.ДатаДокументаДалион, "ДЛФ=D"),
		Формат(МенеджерЗаписи.СуммаДокументаДалион, "ЧДЦ=2; ЧГ=0"), МенеджерЗаписи.СтатусДалион,
		Приход.Номер, Формат(Приход.Дата, "ДЛФ=D"), Формат(Приход.Сумма, "ЧДЦ=2; ЧГ=0"), Приход.Статус));

	// Прочитать() очищает поля, если записи нет, - измерение задаём снова
	МенеджерЗаписи.ИдентификаторСБИС     = ИдентификаторУПД;
	МенеджерЗаписи.СтатусДалион          = Лев(Приход.Статус, 30);
	МенеджерЗаписи.ПроведенВДалион       = Приход.Проведен;
	МенеджерЗаписи.НомерДокументаДалион  = Лев(Приход.Номер, 50);
	МенеджерЗаписи.ДатаДокументаДалион   = Приход.Дата;
	МенеджерЗаписи.СуммаДокументаДалион  = Приход.Сумма;
	МенеджерЗаписи.КомментарийДалион     = Лев(Приход.Комментарий, 500);
	// «Есть ЭТрН» - факт наличия ЭТрН у УПД, приходная на него не влияет.
	// Только ставим: снимает галочку ОбновитьПризнакЭТрНРеестраУПД по факту.
	Если ЕстьЭТрН = Истина Тогда
		МенеджерЗаписи.ЕстьЭТрН = Истина;
		// «Расхождений нет» и текст сверки здесь не ставим: с приходом и ЭТрН
		// на подпись идёт ЭТрН, а УПД - только после сверки цепочки
		// (ЭАрМ_ЦепочкаЗакупки.ЗафиксироватьСверку). Текст без сверки красил
		// бы строку красным до всякой проверки.
	КонецЕсли;
	МенеджерЗаписи.Записать(Истина);

	// ПОСЛЕ записи: строку читаем обратно - номер, дата и сумма прихода должны лежать в реестре
	ЭАрМ_ПриемПакетовДалион.ПроверитьЗаписьРегистра(ИдентификаторУПД, "ЭАрМ_УПД_Входящий",
		Новый Структура("ИдентификаторСБИС", ИдентификаторУПД),
		Новый Структура("НомерДокументаДалион, ДатаДокументаДалион, СуммаДокументаДалион",
			МенеджерЗаписи.НомерДокументаДалион, МенеджерЗаписи.ДатаДокументаДалион,
			МенеджерЗаписи.СуммаДокументаДалион));

КонецПроцедуры

// Кладёт шапку приходной накладной в строку реестра ЭТрН.
//
// Вызывается только внутри транзакции.
//
Процедура ЗаписатьПриходнуюНакладнуюВРеестрЭТрН(ИдентификаторЭТрН, Приход)

	МенеджерЗаписи = МенеджерРеестраЭТрН(ИдентификаторЭТрН);

	Если МенеджерЗаписи = Неопределено Тогда
		// ЭТрН привязана к цепочке, а из реестра пропала (перезагрузка реестра,
		// очистка, старый документ). Раньше здесь было исключение, и приходная
		// не отражалась ни в реестре УПД, ни в документе - пакет уходил в
		// «Ошибка». Теперь ЭТрН просто пропускается: главное - приход и УПД
		ЗаписатьВЖурнал(ИдентификаторЭТрН, "ПриходныеНакладные", Истина, СтрШаблон(
			НСтр("ru = 'Приходная %1: в реестре ЭТрН нет документа %2 - запись в реестр ЭТрН пропущена'"),
			Приход.Номер, ИдентификаторЭТрН));
		ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторЭТрН, СтрШаблон(
			"Документ: ЭТрН %1 из цепочки в реестре ЭТрН нет - пропущена, приход записан по УПД", ИдентификаторЭТрН));
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.СтатусДалион          = Лев(Приход.Статус, 30);
	// ЭТрН есть и приходная нашлась: статус «Готов к утверждению».
	// «К отправке» человек ставит сам; без прихода галочку снимаем.
	ЕстьПриход = ЗначениеЗаполнено(Приход.Номер);
	МенеджерЗаписи.МожноУтвердить        = ЕстьПриход;
	Если НЕ ЕстьПриход Тогда
		МенеджерЗаписи.КОтправке = Ложь;
	КонецЕсли;
	Если ЕстьПриход Тогда
		ЭАрМ_УтверждениеСБИС.ПовыситьСтатусПодписания(МенеджерЗаписи,
			Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ГотовКОтправке);
	ИначеЕсли МенеджерЗаписи.СтатусПодписания =
		Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ГотовКОтправке Тогда
		МенеджерЗаписи.СтатусПодписания =
			Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ПустаяСсылка();
	КонецЕсли;
	МенеджерЗаписи.ДатаОтветаДалион      = ТекущаяДатаСеанса();
	МенеджерЗаписи.ПроведенВДалион       = Приход.Проведен;
	МенеджерЗаписи.НомерДокументаДалион  = Лев(Приход.Номер, 50);
	МенеджерЗаписи.ДатаДокументаДалион   = Приход.Дата;
	МенеджерЗаписи.СуммаДокументаДалион  = Приход.Сумма;
	МенеджерЗаписи.КомментарийДалион     = Лев(Приход.Комментарий, 500);
	МенеджерЗаписи.Записать(Истина);

	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторЭТрН, СтрШаблон(
		"Запись: ЭАрМ_РеестрЭТрН № %1 - приход Далиона № %2 от %3 на %4, статус «%5», Можно утвердить %6",
		МенеджерЗаписи.Номер, Приход.Номер, Формат(Приход.Дата, "ДЛФ=D"),
		Формат(Приход.Сумма, "ЧДЦ=2; ЧГ=0"), Приход.Статус, МенеджерЗаписи.МожноУтвердить));

КонецПроцедуры

// Признак из JSON: приходит и булевым, и строкой "true".
//
Функция ЭтоИстина(Значение)

	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	ТекстПризнака = ВРег(СокрЛП(Строка(Значение)));

	Возврат ТекстПризнака = "TRUE" ИЛИ ТекстПризнака = "ДА" ИЛИ ТекстПризнака = "1";

КонецФункции

// Удаляет временный файл, не мешая основному результату при отказе.
//
Процедура УдалитьВременныйФайлОбмена(ПутьКФайлу)

	Попытка
		УдалитьФайлы(ПутьКФайлу);
	Исключение
		// временный файл подчистит система
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
