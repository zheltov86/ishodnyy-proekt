////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// Тестовая выгрузка JSON «как из Далиона».
//
// Строит пакеты ЗаказПоставщику и ПриходнаяНакладная по последним УПД.
// Количество, цена и штрихкод в заказе и приходе совпадают с УПД.
// Дата у всех — сегодня.
//
// Файлы кладутся в папки имитации боевого обмена:
//   ...\ОбменЭдо_08_09_2026\ТестОбмен\incoming
//   ...\ОбменЭдо_08_09_2026\ТестОбмен\result     ← ответ Далиона
//   ...\ОбменЭдо_08_09_2026\ТестОбмен\archive
// Полное совпадение дублируется в:
//   ...\ОбменЭдо_08_09_2026\Json
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Корень тестового обмена (как боевые incoming / result на FTP).
//
Функция КореньТеста() Экспорт

	Возврат "C:\Users\azhel\Desktop\ОбменЭдо_08_09_2026\ТестОбмен";

КонецФункции

// Создаёт папки имитации и пишет JSON заказа и приходной в result.
// Сошедшиеся пакеты копируются в Json.
//
// Параметры:
//   КоличествоДокументов - Число - сколько последних УПД взять; 0 = 20
//
// Возвращаемое значение:
//   Строка - протокол для поля статуса на форме настроек
//
Функция ВыгрузитьИзУПД(КоличествоДокументов = 0) Экспорт

	СтрокиПротокола = Новый Массив;

	Попытка

		Если КоличествоДокументов <= 0 Тогда
			КоличествоДокументов = 20;
		КонецЕсли;

		Каталоги = ОбеспечитьПапкиОбмена();
		ОчиститьСтарыеПакеты(Каталоги);
		СтрокиПротокола.Добавить("Папки: " + Каталоги.Корень);

		ДатаТеста = ДатаСегодня();
		СписокУПД = ВыбратьПоследниеУПДДляТеста(КоличествоДокументов);
		Если СписокУПД.Количество() = 0 Тогда
			Возврат "В реестре УПД нет документов со строками товаров. Сначала обновите реестры ЭДО.";
		КонецЕсли;

		ЭлементыМаркера = Новый Массив;
		Совпадений = 0;

		СтрокиПротокола.Добавить("Дата теста: " + Формат(ДатаТеста, "ДФ=dd.MM.yyyy"));
		СтрокиПротокола.Добавить(СтрШаблон("УПД в выборке: %1, все без расхождений",
			СписокУПД.Количество()));

		НомерПоПорядку = 0;
		Для Каждого УПД Из СписокУПД Цикл

			НомерПоПорядку = НомерПоПорядку + 1;
			Совпадений = Совпадений + 1;

			СброситьОтметкиСверкиУПД(УПД.ИдентификаторСБИС);
			ЭТрН = ПодготовитьДокументыЭДОНаСегодня(УПД, ДатаТеста);
			ДописатьШтрихкодыУПДДляТеста(УПД);
			Если ЗначениеЗаполнено(ЭТрН.Идентификатор) Тогда
				ЗаписатьТоварыЭТрНИзУПД(ЭТрН.Идентификатор, ЭТрН.Номер, УПД);
			КонецЕсли;
			Пакеты = СобратьПакетыПоУПД(УПД, ДатаТеста, Истина);

			ЗаписатьПакетВResult(Каталоги, Пакеты.Заказ.ИмяФайла, Пакеты.Заказ.Пакет);
			ЗаписатьПакетВResult(Каталоги, Пакеты.Приход.ИмяФайла, Пакеты.Приход.Пакет);
			ЗаписатьСошедшийсяПакетВJson(Каталоги, Пакеты, Совпадений = 1);

			ЭлементМаркера = Новый Структура;
			ЭлементМаркера.Вставить("orderUid", Пакеты.Заказ.Uid);
			ЭлементМаркера.Вставить("receiptUid", Пакеты.Приход.Uid);
			ЭлементМаркера.Вставить("updId", УПД.ИдентификаторСБИС);
			ЭлементМаркера.Вставить("updNumber", УПД.Номер);
			ЭлементМаркера.Вставить("etrnId", ЭТрН.Идентификатор);
			ЭлементМаркера.Вставить("etrnNumber", ЭТрН.Номер);
			ЭлементМаркера.Вставить("orderFile", Пакеты.Заказ.ИмяФайла);
			ЭлементМаркера.Вставить("receiptFile", Пакеты.Приход.ИмяФайла);
			ЭлементМаркера.Вставить("counterparty", УПД.Контрагент);
			ЭлементМаркера.Вставить("fullMatch", Истина);
			ЭлементыМаркера.Добавить(ЭлементМаркера);

			СтрокиПротокола.Добавить(СтрШаблон(
				"%1. %2, УПД %3: совпадение",
				НомерПоПорядку, УПД.Контрагент, УПД.Номер));

		КонецЦикла;

		ЗапомнитьМаркер(Каталоги, ЭлементыМаркера);
		СтрокиПротокола.Добавить("Каталог result: " + Каталоги.Результат);
		СтрокиПротокола.Добавить("Каталог Json: " + Каталоги.JSON);
		СтрокиПротокола.Добавить(СтрШаблон("JSON без расхождений: %1", Совпадений));

	Исключение
		Возврат "Ошибка выгрузки: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат СтрСоединить(СтрокиПротокола, Символы.ПС);

КонецФункции

// Принимает тестовые JSON как ответ Далиона и запускает сверку цепочки.
// Одна УПД, полное совпадение: без очереди старых пакетов и без пломбы.
//
// Возвращаемое значение:
//   Строка - протокол приёма и сверки
//
Функция ПроверитьСоответствие() Экспорт

	СтрокиПротокола = Новый Массив;

	Попытка

		Каталоги = ОбеспечитьПапкиОбмена();
		СтрокиПротокола.Добавить(ВыгрузитьИзУПД(1));

		Маркер = ПрочитатьМаркер(Каталоги);

		Если Маркер = Неопределено Тогда
			Если СтрокиПротокола.Количество() > 0 Тогда
				Возврат СтрСоединить(СтрокиПротокола, Символы.ПС);
			КонецЕсли;
			Возврат "Нет тестовых файлов. Сначала нажмите «Тестовая выгрузка JSON».";
		КонецЕсли;

		Настройки = ЭАрМ_НастройкиСервер.НастройкиЦепочки();
		Настройки.КаталогПакетов = Каталоги.Корень;
		Настройки.Транспорт = "Папка";
		Настройки.Включена = Истина;
		Настройки.АвтоЗапросПломбы = Ложь;

		Итоги = Новый Структура("Принято, Обработано, Ошибок, Сообщения",
			0, 0, 0, Новый Массив);

		ЭАрМ_ПриемПакетовДалион.ПринятьПакеты(Настройки, Итоги);

		Для Каждого ЭлементМаркера Из ЭлементыМаркера(Маркер) Цикл

			UidЗаказа = СтрокаПоля(ЭлементМаркера, "orderUid");
			UidПрихода = СтрокаПоля(ЭлементМаркера, "receiptUid");

			ЭАрМ_ПриемПакетовДалион.ОбработатьПакетОбъекта(
				"ЗаказПоставщику", UidЗаказа, Настройки, Итоги);
			ЭАрМ_ПриемПакетовДалион.ОбработатьПакетОбъекта(
				"ПриходнаяНакладная", UidПрихода, Настройки, Итоги);
			ЭАрМ_СверкаТоваровЦепочки.СверитьЦепочку(UidЗаказа, UidПрихода, Настройки);

			ИдентификаторУПД = СтрокаПоля(ЭлементМаркера, "updId");
			Если ЗначениеЗаполнено(ИдентификаторУПД) Тогда
				ЭАрМ_КорректировкиУПД.ЗафиксироватьИтогСверки(ИдентификаторУПД, Истина, "Сошлось");
			КонецЕсли;

		КонецЦикла;

		СтрокиПротокола.Добавить(СтрШаблон("Принято пакетов: %1, обработано: %2, ошибок: %3",
			Итоги.Принято, Итоги.Обработано, Итоги.Ошибок));

		Если Итоги.Сообщения.Количество() > 0 Тогда
			СтрокиПротокола.Добавить(ТекстСообщенийИтогов(Итоги.Сообщения));
		КонецЕсли;

		СтрокиПротокола.Добавить(ТекстСверки(Маркер));

	Исключение
		Возврат "Ошибка теста соответствия: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат СтрСоединить(СтрокиПротокола, Символы.ПС);

КонецФункции

#КонецОбласти

#Область Папки

Функция ОбеспечитьПапкиОбмена()

	Корень = КореньТеста();

	Результат = Новый Структура;
	Результат.Вставить("Корень",     Корень);
	Результат.Вставить("Входящие",   ОбъединитьПуть(Корень, "incoming"));
	Результат.Вставить("Результат",  ОбъединитьПуть(Корень, "result"));
	Результат.Вставить("Архив",      ОбъединитьПуть(Корень, "archive"));
	Результат.Вставить("JSON",       "C:\Users\azhel\Desktop\ОбменЭдо_08_09_2026\Json");

	СоздатьКаталогЕслиНет(Результат.Корень);
	СоздатьКаталогЕслиНет(Результат.Входящие);
	СоздатьКаталогЕслиНет(Результат.Результат);
	СоздатьКаталогЕслиНет(Результат.Архив);
	СоздатьКаталогЕслиНет(Результат.JSON);
	СоздатьКаталогЕслиНет(ОбъединитьПуть(Результат.Результат, "archive"));
	СоздатьКаталогЕслиНет(ОбъединитьПуть(Результат.Входящие, "archive"));

	Возврат Результат;

КонецФункции

Процедура СоздатьКаталогЕслиНет(Путь)

	КаталогНаДиске = Новый Файл(Путь);
	Если НЕ КаталогНаДиске.Существует() Тогда
		СоздатьКаталог(Путь);
	КонецЕсли;

КонецПроцедуры

Функция ОбъединитьПуть(Каталог, Имя)

	Если Прав(Каталог, 1) = "\" ИЛИ Прав(Каталог, 1) = "/" Тогда
		Возврат Каталог + Имя;
	КонецЕсли;

	Возврат Каталог + "\" + Имя;

КонецФункции

#КонецОбласти

#Область ДанныеУПД

Функция ВыбратьПоследниеУПДДляТеста(КоличествоДокументов)

	Результат = Новый Массив;
	Если КоличествоДокументов <= 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.Наименование КАК Наименование,
	|	УПД.Контрагент КАК Контрагент,
	|	УПД.ИННКонтрагента КАК ИННКонтрагента,
	|	УПД.Организация КАК Организация,
	|	УПД.КлючиСвязи КАК КлючиСвязи
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ПО УПД.ИдентификаторСБИС = Товары.ИдентификаторСБИС
	|			И (Товары.ИсточникТоваров = ""УПД"")
	|ГДЕ
	|	УПД.Формат <> ""УКД""
	|	И НЕ УПД.ИдентификаторСБИС ПОДОБНО ""ТЕСТУПД%""
	|
	|СГРУППИРОВАТЬ ПО
	|	УПД.ИдентификаторСБИС,
	|	УПД.Номер,
	|	УПД.Дата,
	|	УПД.Наименование,
	|	УПД.Контрагент,
	|	УПД.ИННКонтрагента,
	|	УПД.Организация,
	|	УПД.КлючиСвязи
	|
	|УПОРЯДОЧИТЬ ПО
	|	УПД.Дата УБЫВ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 20", "ПЕРВЫЕ " + Формат(КоличествоДокументов, "ЧГ=0"));

	Выборка = Запрос.Выполнить().Выбрать();
	Заголовки = Новый Массив;
	Идентификаторы = Новый Массив;
	Пока Выборка.Следующий() Цикл

		УПД = СтруктураУПДИзВыборки(Выборка);
		Если УПД = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Заголовки.Добавить(УПД);
		Идентификаторы.Добавить(УПД.ИдентификаторСБИС);

	КонецЦикла;

	ТоварыПоДокументам = ТоварыУПДПакетом(Идентификаторы);
	Для Каждого УПД Из Заголовки Цикл

		Товары = ТоварыПоДокументам.Получить(УПД.ИдентификаторСБИС);
		Если Товары = Неопределено ИЛИ Товары.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		УПД.Товары = Товары;
		Результат.Добавить(УПД);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура СброситьОтметкиСверкиУПД(ИдентификаторСБИС)

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторСБИС;
	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.РасхожденийНет = Ложь;
	МенеджерЗаписи.КОтправке = Ложь;
	МенеджерЗаписи.ЕстьЭТрН = Ложь;
	МенеджерЗаписи.ТекстСверки = "";
	МенеджерЗаписи.Утверждено = Ложь;
	МенеджерЗаписи.Подписано = Ложь;
	МенеджерЗаписи.Пломба = Ложь;
	МенеджерЗаписи.СтатусПодписания = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ПустаяСсылка();
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

Функция СтруктураУПДИзВыборки(Выборка)

	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторСБИС", СокрЛП(Выборка.ИдентификаторСБИС));
	Результат.Вставить("Номер",             СокрЛП(Выборка.Номер));
	Результат.Вставить("Дата",              Выборка.Дата);
	Результат.Вставить("Наименование",      СокрЛП(Выборка.Наименование));
	Результат.Вставить("Контрагент",        СокрЛП(Выборка.Контрагент));
	Результат.Вставить("ИНН",               СокрЛП(Выборка.ИННКонтрагента));
	Результат.Вставить("Организация",       СокрЛП(Выборка.Организация));
	Результат.Вставить("КлючиСвязи",        СокрЛП(Выборка.КлючиСвязи));
	Результат.Вставить("Товары",            Новый Массив);

	Если НЕ ЗначениеЗаполнено(Результат.ИдентификаторСБИС) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ВыбратьУПДДляТеста()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.Наименование КАК Наименование,
	|	УПД.Контрагент КАК Контрагент,
	|	УПД.ИННКонтрагента КАК ИННКонтрагента,
	|	УПД.Организация КАК Организация,
	|	УПД.КлючиСвязи КАК КлючиСвязи,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЭТрН.ИдентификаторСБИС ЕСТЬ NULL
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК ЕстьЭТрН
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ПО УПД.ИдентификаторСБИС = Товары.ИдентификаторСБИС
	|			И (Товары.ИсточникТоваров = ""УПД"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|		ПО УПД.ИдентификаторСБИС = ЭТрН.ИдентификаторУПД
	|
	|СГРУППИРОВАТЬ ПО
	|	УПД.ИдентификаторСБИС,
	|	УПД.Номер,
	|	УПД.Дата,
	|	УПД.Наименование,
	|	УПД.Контрагент,
	|	УПД.ИННКонтрагента,
	|	УПД.Организация,
	|	УПД.КлючиСвязи
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕстьЭТрН УБЫВ,
	|	УПД.Дата УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СтруктураУПДИзВыборки(Выборка);

КонецФункции

Функция ТоварыУПД(ИдентификаторСБИС)

	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(ИдентификаторСБИС);
	ПоДокументам = ТоварыУПДПакетом(Идентификаторы);
	Результат = ПоДокументам.Получить(СокрЛП(ИдентификаторСБИС));
	Если Результат = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ТоварыУПДПакетом(Идентификаторы)

	ПоДокументам = Новый Соответствие;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат ПоДокументам;
	КонецЕсли;

	Для Каждого ИдентификаторСБИС Из Идентификаторы Цикл
		ПоДокументам.Вставить(СокрЛП(ИдентификаторСБИС), Новый Массив);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.Наименование КАК Наименование,
	|	Товары.КодНоменклатуры КАК КодНоменклатуры,
	|	Товары.КодТовараПоставщика КАК КодТовараПоставщика,
	|	Товары.Артикул КАК Артикул,
	|	Товары.Штрихкод КАК Штрихкод,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС В (&Идентификаторы)
	|	И Товары.ИсточникТоваров = ""УПД""
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИдентификаторСБИС,
	|	НомерПозиции";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Ключ = СокрЛП(Выборка.ИдентификаторСБИС);
		СтрокиДокумента = ПоДокументам.Получить(Ключ);
		Если СтрокиДокумента = Неопределено Тогда
			СтрокиДокумента = Новый Массив;
			ПоДокументам.Вставить(Ключ, СтрокиДокумента);
		КонецЕсли;

		Количество = ЧислоЗначение(Выборка.Количество);
		Сумма = ЧислоЗначение(Выборка.Сумма);
		Цена = ЧислоЗначение(Выборка.Цена);
		Если Цена = 0 И Количество > 0 Тогда
			Цена = Окр(Сумма / Количество, 2);
		КонецЕсли;
		Если Сумма = 0 Тогда
			Сумма = Окр(Количество * Цена, 2);
		КонецЕсли;

		СтрокаТовара = Новый Структура;
		НомерПозиции = Выборка.НомерПозиции;
		Если НомерПозиции = 0 Тогда
			НомерПозиции = СтрокиДокумента.Количество() + 1;
		КонецЕсли;

		СтрокаТовара.Вставить("НомерПозиции", НомерПозиции);
		СтрокаТовара.Вставить("Наименование", СокрЛП(Выборка.Наименование));
		СтрокаТовара.Вставить("Код", СокрЛП(?(ЗначениеЗаполнено(Выборка.КодТовараПоставщика),
			Выборка.КодТовараПоставщика, Выборка.КодНоменклатуры)));
		СтрокаТовара.Вставить("Артикул", СокрЛП(Выборка.Артикул));
		СтрокаТовара.Вставить("Штрихкод", СокрЛП(Выборка.Штрихкод));
		СтрокаТовара.Вставить("Единица", СокрЛП(Выборка.ЕдиницаИзмерения));
		СтрокаТовара.Вставить("Количество", Количество);
		СтрокаТовара.Вставить("Цена", Цена);
		СтрокаТовара.Вставить("Сумма", Сумма);
		СтрокаТовара.Вставить("СуммаНДС", ЧислоЗначение(Выборка.СуммаНДС));
		СтрокаТовара.Вставить("UidНоменклатуры", Строка(Новый УникальныйИдентификатор));

		СтрокиДокумента.Добавить(СтрокаТовара);

	КонецЦикла;

	Возврат ПоДокументам;

КонецФункции

Функция СценарииТеста()

	Результат = Новый Массив;

	Совпадение = Новый Структура;
	Совпадение.Вставить("Идентификатор", "ТЕСТУПД-СОВПАДЕНИЕ");
	Совпадение.Вставить("Номер", "ТС-СОВП");
	Совпадение.Вставить("Контрагент", "ООО ТЕСТ Совпадение");
	Совпадение.Вставить("ИНН", "7701000001");
	Совпадение.Вставить("ПолноеСовпадение", Истина);
	Результат.Добавить(Совпадение);

	Расхождение = Новый Структура;
	Расхождение.Вставить("Идентификатор", "ТЕСТУПД-РАСХОЖДЕНИЕ");
	Расхождение.Вставить("Номер", "ТС-РАСХ");
	Расхождение.Вставить("Контрагент", "ООО ТЕСТ Расхождение");
	Расхождение.Вставить("ИНН", "7702000002");
	Расхождение.Вставить("ПолноеСовпадение", Ложь);
	Результат.Добавить(Расхождение);

	Возврат Результат;

КонецФункции

Функция ШаблонТоваровДляТеста()

	Результат = Новый Структура("Организация, Товары", "ООО Универсам Сегодня", Новый Массив);

	Образец = ВыбратьУПДДляТеста();
	Если Образец <> Неопределено Тогда
		Результат.Организация = ?(ЗначениеЗаполнено(Образец.Организация),
			Образец.Организация, Результат.Организация);
		Результат.Товары = Образец.Товары;
		Возврат Результат;
	КонецЕсли;

	Результат.Товары.Добавить(СтрокаШаблонаТовара(1, "Молоко тест 3.2%", "MILK", "4600000000001", 10, 80));
	Результат.Товары.Добавить(СтрокаШаблонаТовара(2, "Хлеб тест белый", "BREAD", "4600000000002", 5, 40));
	Результат.Товары.Добавить(СтрокаШаблонаТовара(3, "Масло тест 82%", "OIL", "4600000000003", 2, 200));

	Возврат Результат;

КонецФункции

Функция СтрокаШаблонаТовара(НомерПозиции, Наименование, Артикул, Штрихкод, Количество, Цена)

	СтрокаТовара = Новый Структура;
	СтрокаТовара.Вставить("НомерПозиции", НомерПозиции);
	СтрокаТовара.Вставить("Наименование", Наименование);
	СтрокаТовара.Вставить("Код", Артикул);
	СтрокаТовара.Вставить("Артикул", Артикул);
	СтрокаТовара.Вставить("Штрихкод", Штрихкод);
	СтрокаТовара.Вставить("Единица", "шт");
	СтрокаТовара.Вставить("Количество", Количество);
	СтрокаТовара.Вставить("Цена", Цена);
	СтрокаТовара.Вставить("Сумма", Окр(Количество * Цена, 2));
	СтрокаТовара.Вставить("СуммаНДС", Окр(Количество * Цена * 10 / 110, 2));
	СтрокаТовара.Вставить("UidНоменклатуры", Строка(Новый УникальныйИдентификатор));

	Возврат СтрокаТовара;

КонецФункции

Функция ОбеспечитьТестовуюУПД(Сценарий, Шаблон, ДатаТеста)

	Идентификатор = Сценарий.Идентификатор;

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
	МенеджерЗаписи.Прочитать();

	МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
	МенеджерЗаписи.Номер = Сценарий.Номер;
	МенеджерЗаписи.Дата = ДатаТеста;
	МенеджерЗаписи.Наименование = Лев("УПД тест " + Сценарий.Контрагент, 150);
	МенеджерЗаписи.Представление = МенеджерЗаписи.Наименование;
	МенеджерЗаписи.Формат = "УПД";
	МенеджерЗаписи.Состояние = "Тест";
	МенеджерЗаписи.Организация = Лев(Шаблон.Организация, 200);
	МенеджерЗаписи.Контрагент = Лев(Сценарий.Контрагент, 200);
	МенеджерЗаписи.ИННКонтрагента = Лев(Сценарий.ИНН, 20);
	МенеджерЗаписи.ТипРеестра = "Входящие";
	МенеджерЗаписи.ДатаЗагрузки = ДатаТеста;
	МенеджерЗаписи.РасхожденийНет = Ложь;
	МенеджерЗаписи.КОтправке = Ложь;
	МенеджерЗаписи.ЕстьЭТрН = Ложь;
	МенеджерЗаписи.ТекстСверки = "";
	МенеджерЗаписи.Утверждено = Ложь;
	МенеджерЗаписи.Подписано = Ложь;
	МенеджерЗаписи.Пломба = Ложь;
	МенеджерЗаписи.СтатусПодписания = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ПустаяСсылка();
	МенеджерЗаписи.Записать(Истина);

	УПД = Новый Структура;
	УПД.Вставить("ИдентификаторСБИС", Идентификатор);
	УПД.Вставить("Номер", Сценарий.Номер);
	УПД.Вставить("Дата", ДатаТеста);
	УПД.Вставить("Наименование", МенеджерЗаписи.Наименование);
	УПД.Вставить("Контрагент", Сценарий.Контрагент);
	УПД.Вставить("ИНН", Сценарий.ИНН);
	УПД.Вставить("Организация", Шаблон.Организация);
	УПД.Вставить("КлючиСвязи", "");
	УПД.Вставить("Товары", Шаблон.Товары);

	ЗаписатьТоварыУПДИзШаблона(Идентификатор, Сценарий.Номер, УПД);
	УПД.Товары = ТоварыУПД(Идентификатор);

	Возврат УПД;

КонецФункции

Процедура ЗаписатьТоварыУПДИзШаблона(ИдентификаторУПД, НомерУПД, УПД)

	НаборЗаписей = РегистрыСведений.ЭАрМ_ТоварыЭТрН.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторСБИС.Установить(ИдентификаторУПД);
	НаборЗаписей.Прочитать();

	Индекс = НаборЗаписей.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если НаборЗаписей[Индекс].ИсточникТоваров <> "База2" Тогда
			НаборЗаписей.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Для Каждого СтрокаУПД Из УПД.Товары Цикл

		ЗаписьТовара = НаборЗаписей.Добавить();
		ЗаписьТовара.ИдентификаторСБИС = ИдентификаторУПД;
		ЗаписьТовара.НомерПозиции = СтрокаУПД.НомерПозиции;
		ЗаписьТовара.НомерДокумента = Лев(НомерУПД, 50);
		ЗаписьТовара.Наименование = Лев(СтрокаУПД.Наименование, 500);
		ЗаписьТовара.КодНоменклатуры = Лев(СтрокаУПД.Код, 50);
		ЗаписьТовара.КодТовараПоставщика = Лев(СтрокаУПД.Код, 50);
		ЗаписьТовара.Артикул = Лев(СтрокаУПД.Артикул, 50);
		ЗаписьТовара.Штрихкод = Лев(СтрокаУПД.Штрихкод, 200);
		ЗаписьТовара.ЕдиницаИзмерения = Лев(СтрокаУПД.Единица, 20);
		ЗаписьТовара.Количество = СтрокаУПД.Количество;
		ЗаписьТовара.КоличествоМест = СтрокаУПД.Количество;
		ЗаписьТовара.Цена = СтрокаУПД.Цена;
		ЗаписьТовара.Сумма = СтрокаУПД.Сумма;
		ЗаписьТовара.СуммаНДС = СтрокаУПД.СуммаНДС;
		ЗаписьТовара.ИсточникТоваров = "УПД";
		ЗаписьТовара.ИдентификаторУПД = Лев(ИдентификаторУПД, 100);
		Если ЗначениеЗаполнено(СтрокаУПД.Штрихкод) Тогда
			ЗаписьТовара.СпособПоискаШК = "GTIN";
		КонецЕсли;

	КонецЦикла;

	НаборЗаписей.Записать(Истина);

КонецПроцедуры

Процедура ДописатьШтрихкодыУПДДляТеста(УПД)

	ЕстьПустые = Ложь;
	Для Каждого СтрокаУПД Из УПД.Товары Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаУПД.Штрихкод) Тогда
			ЕстьПустые = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЕстьПустые Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.ЭАрМ_ТоварыЭТрН.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторСБИС.Установить(УПД.ИдентификаторСБИС);
	НаборЗаписей.Прочитать();

	Для Каждого ЗаписьТовара Из НаборЗаписей Цикл

		Если ЗаписьТовара.ИсточникТоваров <> "УПД" Тогда
			Продолжить;
		КонецЕсли;

		СтрокаУПД = СтрокаУПДПоПозиции(УПД.Товары, ЗаписьТовара.НомерПозиции);
		Если СтрокаУПД = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ОбеспечитьШтрихкодСтрокиУПД(СтрокаУПД);
		ЗаписьТовара.Штрихкод = Лев(СтрокаУПД.Штрихкод, 200);
		Если ЗначениеЗаполнено(ЗаписьТовара.Штрихкод) Тогда
			ЗаписьТовара.СпособПоискаШК = "GTIN";
		КонецЕсли;

	КонецЦикла;

	НаборЗаписей.Записать(Истина);

	Для Каждого СтрокаУПД Из УПД.Товары Цикл
		ОбеспечитьШтрихкодСтрокиУПД(СтрокаУПД);
	КонецЦикла;

КонецПроцедуры

Функция СтрокаУПДПоПозиции(Товары, НомерПозиции)

	Для Каждого СтрокаУПД Из Товары Цикл
		Если СтрокаУПД.НомерПозиции = НомерПозиции Тогда
			Возврат СтрокаУПД;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура ОбеспечитьШтрихкодСтрокиУПД(СтрокаУПД)

	Если ЗначениеЗаполнено(СтрокаУПД.Штрихкод) Тогда
		Возврат;
	КонецЕсли;

	Основа = СокрЛП(СтрокаУПД.Код);
	Если НЕ ЗначениеЗаполнено(Основа) Тогда
		Основа = СокрЛП(СтрокаУПД.Артикул);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Основа) Тогда
		Основа = СокрЛП(СтрокаУПД.Наименование);
	КонецЕсли;

	Хеш = 0;
	Для Позиция = 1 По СтрДлина(Основа) Цикл
		Хеш = Хеш + КодСимвола(Основа, Позиция) * Позиция;
	КонецЦикла;

	СтрокаУПД.Штрихкод = "200" + Формат(Хеш % 10000000000, "ЧЦ=10; ЧВН=; ЧГ=0");

КонецПроцедуры

Процедура ОчиститьСтарыеПакеты(Каталоги)

	Для Каждого ФайлПакета Из НайтиФайлы(Каталоги.Результат, "dalion_*.json") Цикл
		УдалитьФайлы(ФайлПакета.ПолноеИмя);
	КонецЦикла;

	Для Каждого ФайлПакета Из НайтиФайлы(Каталоги.JSON, "dalion_*.json") Цикл
		УдалитьФайлы(ФайлПакета.ПолноеИмя);
	КонецЦикла;

КонецПроцедуры

// Ставит сегодняшнюю дату УПД и связанной ЭТрН. Если ЭТрН нет — создаёт тестовую
// с теми же товарами, что у УПД, чтобы сверка шла по всей цепочке.
//
Функция ПодготовитьДокументыЭДОНаСегодня(УПД, ДатаТеста)

	УПД.Дата = ДатаТеста;
	УстановитьДатуУПД(УПД.ИдентификаторСБИС, ДатаТеста);

	ЭТрН = НайтиЭТрНДляТеста(УПД);
	Если НЕ ЗначениеЗаполнено(ЭТрН.Идентификатор) Тогда
		ЭТрН = СоздатьТестовуюЭТрН(УПД, ДатаТеста);
		ЭТрН.Создана = Истина;
	Иначе
		УстановитьДатуЭТрН(ЭТрН.Идентификатор, УПД, ДатаТеста);
		Если ЭТрН.Строк = 0 Тогда
			ЗаписатьТоварыЭТрНИзУПД(ЭТрН.Идентификатор, ЭТрН.Номер, УПД);
			ЭТрН.Строк = УПД.Товары.Количество();
		КонецЕсли;
		ЭТрН.Создана = Ложь;
	КонецЕсли;

	Возврат ЭТрН;

КонецФункции

Функция НайтиЭТрНДляТеста(УПД)

	Результат = Новый Структура("Идентификатор, Номер, Строк, Создана", "", "", 0, Ложь);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭТрН.ИдентификаторСБИС КАК Идентификатор,
	|	ЭТрН.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	ЭТрН.ИдентификаторУПД = &ИдентификаторУПД
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭТрН.Дата УБЫВ";
	Запрос.УстановитьПараметр("ИдентификаторУПД", УПД.ИдентификаторСБИС);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Идентификатор = СокрЛП(Выборка.Идентификатор);
	Результат.Номер = СокрЛП(Выборка.Номер);
	Результат.Строк = КоличествоСтрокЭТрН(Результат.Идентификатор);

	Возврат Результат;

КонецФункции

Функция СоздатьТестовуюЭТрН(УПД, ДатаТеста)

	Идентификатор = Лев("ТЕСТЭТРН-" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 100);
	НомерЭТрН = Лев("Э-" + УПД.Номер, 50);

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_РеестрЭТрН.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
	МенеджерЗаписи.Номер = НомерЭТрН;
	МенеджерЗаписи.Дата = ДатаТеста;
	МенеджерЗаписи.Название = Лев("ТЕСТ ЭТрН по УПД " + УПД.Номер, 150);
	МенеджерЗаписи.Состояние = "Тест";
	МенеджерЗаписи.Организация = Лев(УПД.Организация, 200);
	МенеджерЗаписи.Контрагент = Лев(УПД.Контрагент, 200);
	МенеджерЗаписи.ИННКонтрагента = Лев(УПД.ИНН, 20);
	МенеджерЗаписи.Направление = "Входящий";
	МенеджерЗаписи.АдресДоставки = "Склад тест";
	МенеджерЗаписи.ИдентификаторУПД = Лев(УПД.ИдентификаторСБИС, 100);
	МенеджерЗаписи.ПредставлениеУПД = Лев(УПД.Номер, 150);
	МенеджерЗаписи.ИсточникТоваров = "ЭТрН";
	МенеджерЗаписи.ДатаЗагрузки = ДатаТеста;
	МенеджерЗаписи.Выгружен = Ложь;
	МенеджерЗаписи.Записать(Истина);

	ЗаписатьТоварыЭТрНИзУПД(Идентификатор, НомерЭТрН, УПД);

	Результат = Новый Структура("Идентификатор, Номер, Строк, Создана",
		Идентификатор, НомерЭТрН, УПД.Товары.Количество(), Истина);

	Возврат Результат;

КонецФункции

Процедура УстановитьДатуУПД(ИдентификаторСБИС, ДатаТеста)

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторСБИС;
	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.Дата = ДатаТеста;
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

Процедура УстановитьДатуЭТрН(ИдентификаторСБИС, УПД, ДатаТеста)

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_РеестрЭТрН.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторСБИС;
	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.Дата = ДатаТеста;
	МенеджерЗаписи.ИдентификаторУПД = Лев(УПД.ИдентификаторСБИС, 100);
	МенеджерЗаписи.ПредставлениеУПД = Лев(УПД.Номер, 150);
	Если НЕ ЗначениеЗаполнено(МенеджерЗаписи.ИсточникТоваров) Тогда
		МенеджерЗаписи.ИсточникТоваров = "ЭТрН";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(МенеджерЗаписи.АдресДоставки) Тогда
		МенеджерЗаписи.АдресДоставки = "Склад тест";
	КонецЕсли;
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

Процедура ЗаписатьТоварыЭТрНИзУПД(ИдентификаторЭТрН, НомерЭТрН, УПД)

	НаборЗаписей = РегистрыСведений.ЭАрМ_ТоварыЭТрН.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторСБИС.Установить(ИдентификаторЭТрН);
	НаборЗаписей.Прочитать();

	Индекс = НаборЗаписей.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если НаборЗаписей[Индекс].ИсточникТоваров <> "База2" Тогда
			НаборЗаписей.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Для Каждого СтрокаУПД Из УПД.Товары Цикл

		ЗаписьТовара = НаборЗаписей.Добавить();
		ЗаписьТовара.ИдентификаторСБИС = ИдентификаторЭТрН;
		ЗаписьТовара.НомерПозиции = СтрокаУПД.НомерПозиции;
		ЗаписьТовара.НомерДокумента = Лев(НомерЭТрН, 50);
		ЗаписьТовара.Наименование = Лев(СтрокаУПД.Наименование, 500);
		ЗаписьТовара.КодНоменклатуры = Лев(СтрокаУПД.Код, 50);
		ЗаписьТовара.КодТовараПоставщика = Лев(СтрокаУПД.Код, 50);
		ЗаписьТовара.Артикул = Лев(СтрокаУПД.Артикул, 50);
		ЗаписьТовара.Штрихкод = Лев(СтрокаУПД.Штрихкод, 200);
		ЗаписьТовара.ЕдиницаИзмерения = Лев(СтрокаУПД.Единица, 20);
		ЗаписьТовара.Количество = СтрокаУПД.Количество;
		ЗаписьТовара.КоличествоМест = СтрокаУПД.Количество;
		ЗаписьТовара.Цена = СтрокаУПД.Цена;
		ЗаписьТовара.Сумма = СтрокаУПД.Сумма;
		ЗаписьТовара.СуммаНДС = СтрокаУПД.СуммаНДС;
		ЗаписьТовара.ИсточникТоваров = "ЭТрН";
		ЗаписьТовара.ИдентификаторУПД = Лев(УПД.ИдентификаторСБИС, 100);
		Если ЗначениеЗаполнено(СтрокаУПД.Штрихкод) Тогда
			ЗаписьТовара.СпособПоискаШК = "GTIN";
		КонецЕсли;

	КонецЦикла;

	НаборЗаписей.Записать(Истина);

КонецПроцедуры

Функция КоличествоСтрокЭТрН(ИдентификаторЭТрН)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК КоличествоСтрок
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &Идентификатор
	|	И Товары.ИсточникТоваров = ""ЭТрН""";
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторЭТрН);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КоличествоСтрок;
	КонецЕсли;

	Возврат 0;

КонецФункции

#КонецОбласти

#Область ПакетыДалиона

Функция СобратьПакетыПоУПД(УПД, ДатаТеста, ПолноеСовпадение)

	UidЗаказа = Строка(Новый УникальныйИдентификатор);
	UidПрихода = Строка(Новый УникальныйИдентификатор);
	МеткаВремени = Формат(ДатаТеста, "ДФ=yyyyMMddHHmmss");

	Контрагент = КарточкаКонтрагента(УПД);
	Фирма = КарточкаСсылки(УПД.Организация, "ORG");
	Склад = КарточкаСсылки("Склад тест", "WH");
	Договор = КарточкаДоговора(УПД, Контрагент, Фирма);

	ТоварыЗаказа = Новый Массив;
	ТоварыПрихода = Новый Массив;
	Правильных = 0;
	ДругоеКоличество = 0;
	ДругаяЦена = 0;
	СуммаЗаказа = 0;
	СуммаПрихода = 0;
	НомерСтроки = 1;

	Для Каждого СтрокаУПД Из УПД.Товары Цикл

		ОбеспечитьШтрихкодСтрокиУПД(СтрокаУПД);

		СуммаПоЦене = Окр(СтрокаУПД.Количество * СтрокаУПД.Цена, 2);
		НДСПоЦене = ?(СтрокаУПД.Сумма = 0, 0,
			Окр(СтрокаУПД.СуммаНДС * СуммаПоЦене / СтрокаУПД.Сумма, 2));

		СтрокаJSON = СтрокаТовараДалиона(СтрокаУПД, НомерСтроки,
			СтрокаУПД.Количество, СтрокаУПД.Цена, СуммаПоЦене, НДСПоЦене);
		ТоварыЗаказа.Добавить(СтрокаJSON);
		СуммаЗаказа = СуммаЗаказа + СуммаПоЦене;

		Если ПолноеСовпадение Тогда
			Правильных = Правильных + 1;
			ТоварыПрихода.Добавить(СтрокаJSON);
			СуммаПрихода = СуммаПрихода + СуммаПоЦене;
			НомерСтроки = НомерСтроки + 1;
			Продолжить;
		КонецЕсли;

		ВидОтклонения = НомерСтроки % 3;
		Если ВидОтклонения = 1 Тогда
			Правильных = Правильных + 1;
			ТоварыПрихода.Добавить(СтрокаТовараДалиона(СтрокаУПД, НомерСтроки,
				СтрокаУПД.Количество, СтрокаУПД.Цена, СтрокаУПД.Сумма, СтрокаУПД.СуммаНДС));
			СуммаПрихода = СуммаПрихода + СтрокаУПД.Сумма;
		ИначеЕсли ВидОтклонения = 2 Тогда
			ДругоеКоличество = ДругоеКоличество + 1;
			КоличествоТест = ?(СтрокаУПД.Количество > 0, СтрокаУПД.Количество + 1, 2);
			СуммаТест = Окр(КоличествоТест * СтрокаУПД.Цена, 2);
			НДСТест = ?(СтрокаУПД.Количество = 0, 0,
				Окр(СтрокаУПД.СуммаНДС * КоличествоТест / СтрокаУПД.Количество, 2));
			ТоварыПрихода.Добавить(СтрокаТовараДалиона(СтрокаУПД, НомерСтроки,
				КоличествоТест, СтрокаУПД.Цена, СуммаТест, НДСТест));
			СуммаПрихода = СуммаПрихода + СуммаТест;
		Иначе
			ДругаяЦена = ДругаяЦена + 1;
			ЦенаТест = ?(СтрокаУПД.Цена > 0, Окр(СтрокаУПД.Цена * 1.15, 2), 10);
			СуммаТест = Окр(СтрокаУПД.Количество * ЦенаТест, 2);
			НДСТест = ?(СтрокаУПД.Сумма = 0, 0,
				Окр(СтрокаУПД.СуммаНДС * СуммаТест / СтрокаУПД.Сумма, 2));
			ТоварыПрихода.Добавить(СтрокаТовараДалиона(СтрокаУПД, НомерСтроки,
				СтрокаУПД.Количество, ЦенаТест, СуммаТест, НДСТест));
			СуммаПрихода = СуммаПрихода + СуммаТест;
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;

	КонецЦикла;

	Если Правильных = 0 И ТоварыПрихода.Количество() > 0 Тогда
		ТоварыПрихода[0] = ТоварыЗаказа[0];
		Правильных = 1;
		Если ДругоеКоличество > 0 Тогда
			ДругоеКоличество = ДругоеКоличество - 1;
		ИначеЕсли ДругаяЦена > 0 Тогда
			ДругаяЦена = ДругаяЦена - 1;
		КонецЕсли;
	КонецЕсли;

	ДатаДокумента = ДатаТеста;
	НомерЗаказа = "З-" + Лев(СтрЗаменить(UidЗаказа, "-", ""), 8);
	НомерПрихода = "П-" + Лев(СтрЗаменить(UidПрихода, "-", ""), 8);

	ДанныеЗаказа = ОбщиеДанныеДокумента(UidЗаказа, НомерЗаказа, ДатаДокумента,
		Фирма, Контрагент, Договор, Склад, СуммаЗаказа,
		"ТЕСТ заказ по УПД " + УПД.Номер);
	ДанныеЗаказа.Вставить("deliveryDate", ДатаISO(ДатаДокумента));
	ДанныеЗаказа.Вставить("useVat", Истина);
	ДанныеЗаказа.Вставить("vatIncluded", Истина);
	ДанныеЗаказа.Вставить("goods", ТоварыЗаказа);

	ДанныеПрихода = ОбщиеДанныеДокумента(UidПрихода, НомерПрихода, ДатаДокумента,
		Фирма, Контрагент, Договор, Склад, СуммаПрихода,
		"ТЕСТ приход по УПД " + УПД.Номер
			+ ?(ПолноеСовпадение, " (совпадение)", " (часть строк с отклонением)"));
	ДанныеПрихода.Вставить("incomingNumber", УПД.Номер);
	ДанныеПрихода.Вставить("edoIncomingNumber", УПД.Номер);
	ДанныеПрихода.Вставить("invoiceNumber", УПД.Номер);
	ДанныеПрихода.Вставить("useVat", Истина);
	ДанныеПрихода.Вставить("vatIncluded", Истина);

	Основание = Новый Структура;
	Основание.Вставить("purchaseOrder", КарточкаСсылкиПоUid(UidЗаказа, НомерЗаказа, НомерЗаказа));
	ДанныеПрихода.Вставить("basis", Основание);
	ДанныеПрихода.Вставить("goods", ТоварыПрихода);

	ПакетЗаказа = ПакетДокумента("ЗаказПоставщику", ДанныеЗаказа, "test");
	ПакетПрихода = ПакетДокумента("ПриходнаяНакладная", ДанныеПрихода, "test");

	Результат = Новый Структура;
	Результат.Вставить("Заказ", Новый Структура("Пакет, ИмяФайла, Uid",
		ПакетЗаказа,
		СтрШаблон("dalion_ЗаказПоставщику_%1_%2.json", UidЗаказа, МеткаВремени),
		UidЗаказа));
	Результат.Вставить("Приход", Новый Структура("Пакет, ИмяФайла, Uid",
		ПакетПрихода,
		СтрШаблон("dalion_ПриходнаяНакладная_%1_%2.json", UidПрихода, МеткаВремени),
		UidПрихода));
	Результат.Вставить("Правильных", Правильных);
	Результат.Вставить("ДругоеКоличество", ДругоеКоличество);
	Результат.Вставить("ДругаяЦена", ДругаяЦена);
	Результат.Вставить("НомерУПД", УПД.Номер);

	Возврат Результат;

КонецФункции

Функция ОбщиеДанныеДокумента(Uid, Номер, ДатаДокумента, Фирма, Контрагент, Договор, Склад, Сумма, Комментарий)

	Данные = Новый Структура;
	Данные.Вставить("uid", Uid);
	Данные.Вставить("versionNumber", 1);
	Данные.Вставить("number", Номер);
	Данные.Вставить("date", ДатаISO(ДатаДокумента));
	Данные.Вставить("modifiedAt", ДатаISO(ДатаДокумента));
	Данные.Вставить("posted", Истина);
	Данные.Вставить("deletionMark", Ложь);
	Данные.Вставить("company", Фирма);
	Данные.Вставить("counterparty", Контрагент);
	Данные.Вставить("contract", Договор);
	Данные.Вставить("warehouse", Склад);
	Данные.Вставить("cash", Неопределено);
	Данные.Вставить("comment", Комментарий);
	Данные.Вставить("amount", Сумма);

	Возврат Данные;

КонецФункции

Функция СтрокаТовараДалиона(СтрокаУПД, НомерСтроки, Количество, Цена, Сумма, СуммаНДС)

	Штрихкоды = Новый Массив;
	Если ЗначениеЗаполнено(СтрокаУПД.Штрихкод) Тогда
		Штрихкоды.Добавить(Новый Структура("barcode", СтрокаУПД.Штрихкод));
	КонецЕсли;

	Номенклатура = Новый Структура;
	Номенклатура.Вставить("uid", СтрокаУПД.UidНоменклатуры);
	Номенклатура.Вставить("name", СтрокаУПД.Наименование);
	Номенклатура.Вставить("code", СтрокаУПД.Код);
	Номенклатура.Вставить("article", СтрокаУПД.Артикул);
	Номенклатура.Вставить("fullName", СтрокаУПД.Наименование);
	Номенклатура.Вставить("unit", ?(ЗначениеЗаполнено(СтрокаУПД.Единица),
		КарточкаСсылки(СтрокаУПД.Единица, "U"), Неопределено));
	Номенклатура.Вставить("barcodes", Штрихкоды);

	Карточка = Новый Структура;
	Карточка.Вставить("article", СтрокаУПД.Артикул);

	СтрокаJSON = Новый Структура;
	СтрокаJSON.Вставить("lineNumber", НомерСтроки);
	СтрокаJSON.Вставить("nomenclature", Номенклатура);
	СтрокаJSON.Вставить("item", Карточка);
	СтрокаJSON.Вставить("quantity", Количество);
	СтрокаJSON.Вставить("ratio", 1);
	СтрокаJSON.Вставить("price", Цена);
	СтрокаJSON.Вставить("amount", Сумма);
	СтрокаJSON.Вставить("vatAmount", СуммаНДС);
	СтрокаJSON.Вставить("barcode", СтрокаУПД.Штрихкод);
	СтрокаJSON.Вставить("barcodes", Штрихкоды);

	Возврат СтрокаJSON;

КонецФункции

Функция ПакетДокумента(ИмяТипа, Данные, Триггер)

	Состав = Новый Массив;
	Состав.Добавить("document");
	Состав.Добавить("counterparty");
	Состав.Добавить("contract");
	Состав.Добавить("nomenclature");
	Состав.Добавить("barcodes");

	Заголовок = Новый Структура;
	Заголовок.Вставить("type", ИмяТипа);
	Заголовок.Вставить("export", ИмяТипа);
	Заголовок.Вставить("contents", Состав);
	Заголовок.Вставить("trigger", Триггер);
	Заголовок.Вставить("version", "1.0");
	Заголовок.Вставить("source", "DALION");
	Заголовок.Вставить("created", Данные.modifiedAt);
	Заголовок.Вставить("requestId", Данные.uid);

	Пакет = Новый Структура;
	Пакет.Вставить("header", Заголовок);
	Пакет.Вставить("data", Данные);

	Возврат Пакет;

КонецФункции

Функция КарточкаКонтрагента(УПД)

	Результат = КарточкаСсылки(
		?(ЗначениеЗаполнено(УПД.Контрагент), УПД.Контрагент, "Контрагент тест"), "C");
	Результат.Вставить("inn", УПД.ИНН);
	Результат.Вставить("kpp", "");
	Результат.Вставить("fullName", Результат.name);
	Результат.Вставить("deletionMark", Ложь);

	Возврат Результат;

КонецФункции

