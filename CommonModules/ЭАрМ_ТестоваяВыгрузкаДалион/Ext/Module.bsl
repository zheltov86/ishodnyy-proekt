#КонецОбласти

#Область Файлы

Процедура ЗаписатьПакетВResult(Каталоги, ИмяФайла, Пакет)

	ЗаписатьПакетВКаталог(Каталоги.Результат, ИмяФайла, Пакет);

КонецПроцедуры

Процедура ЗаписатьСошедшийсяПакетВJson(Каталоги, Пакеты, ПервыйСошедшийся)

	ЗаписатьПакетВКаталог(Каталоги.JSON, Пакеты.Заказ.ИмяФайла, Пакеты.Заказ.Пакет);
	ЗаписатьПакетВКаталог(Каталоги.JSON, Пакеты.Приход.ИмяФайла, Пакеты.Приход.Пакет);

	Если ПервыйСошедшийся Тогда
		ЗаписатьПакетВКаталог(Каталоги.JSON, "dalion_ЗаказПоставщику_совпадение.json", Пакеты.Заказ.Пакет);
		ЗаписатьПакетВКаталог(Каталоги.JSON, "dalion_ПриходнаяНакладная_совпадение.json", Пакеты.Приход.Пакет);
		ЗаписатьПакетВКаталог(Каталоги.JSON, "dalion_ЗаказПоставщику_одинаковые.json", Пакеты.Заказ.Пакет);
		ЗаписатьПакетВКаталог(Каталоги.JSON, "dalion_ПриходнаяНакладная_одинаковые.json", Пакеты.Приход.Пакет);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьПакетВКаталог(Каталог, ИмяФайла, Пакет)

	Путь = ОбъединитьПуть(Каталог, ИмяФайла);

	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьJSON.ОткрытьФайл(Путь, "UTF-8", , ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Пакет);
	ЗаписьJSON.Закрыть();

КонецПроцедуры

Процедура ЗапомнитьМаркер(Каталоги, ЭлементыМаркера)

	Маркер = Новый Структура;
	Маркер.Вставить("items", ЭлементыМаркера);
	Если ЭлементыМаркера.Количество() > 0 Тогда
		Первый = ЭлементыМаркера[0];
		Маркер.Вставить("orderUid", Первый.orderUid);
		Маркер.Вставить("receiptUid", Первый.receiptUid);
		Маркер.Вставить("updId", Первый.updId);
		Маркер.Вставить("updNumber", Первый.updNumber);
	КонецЕсли;

	Путь = ОбъединитьПуть(Каталоги.Корень, "last_test.json");
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ОткрытьФайл(Путь, "UTF-8");
	ЗаписатьJSON(ЗаписьJSON, Маркер);
	ЗаписьJSON.Закрыть();

КонецПроцедуры

Функция ЕстьФайлыResult(Каталоги)

	Найденные = НайтиФайлы(Каталоги.Результат, "dalion_*.json");
	Возврат Найденные.Количество() > 0;

КонецФункции

Функция ПрочитатьМаркер(Каталоги)

	Путь = ОбъединитьПуть(Каталоги.Корень, "last_test.json");
	ФайлМаркера = Новый Файл(Путь);
	Если НЕ ФайлМаркера.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.ОткрытьФайл(Путь, "UTF-8");
	Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция ТекстСверки(Маркер)

	СтрокиОтчёта = Новый Массив;
	СтрокиОтчёта.Добавить("Сверка (кратко, без построчной распечатки):");

	Для Каждого ЭлементМаркера Из ЭлементыМаркера(Маркер) Цикл

		Заголовок = СокрЛП(СтрокаПоля(ЭлементМаркера, "counterparty"));
		Если НЕ ЗначениеЗаполнено(Заголовок) Тогда
			Заголовок = СтрокаПоля(ЭлементМаркера, "updNumber");
		КонецЕсли;

		СтрокиОтчёта.Добавить(Заголовок + ": " + ТекстСверкиЦепочки(ЭлементМаркера));

	КонецЦикла;

	Если СтрокиОтчёта.Количество() = 1 Тогда
		Возврат "Нет данных маркера теста.";
	КонецЕсли;

	Возврат СтрСоединить(СтрокиОтчёта, Символы.ПС);

КонецФункции

Функция ЭлементыМаркера(Маркер)

	Результат = Новый Массив;

	Если ТипЗнч(Маркер) = Тип("Соответствие") Тогда
		Элементы = Маркер.Получить("items");
		Если ТипЗнч(Элементы) = Тип("Массив") И Элементы.Количество() > 0 Тогда
			Возврат Элементы;
		КонецЕсли;
	КонецЕсли;

	Результат.Добавить(Маркер);
	Возврат Результат;

КонецФункции

Функция ТекстСверкиЦепочки(Маркер)

	UidЗаказа = СтрокаПоля(Маркер, "orderUid");
	UidПрихода = СтрокаПоля(Маркер, "receiptUid");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сверка.ПозицияСверки КАК ПозицияСверки,
	|	Сверка.НоменклатураЗаказа КАК НоменклатураЗаказа,
	|	Сверка.НоменклатураПоступления КАК НоменклатураПоступления,
	|	Сверка.НаименованиеУПД КАК НаименованиеУПД,
	|	Сверка.НаименованиеЭТрН КАК НаименованиеЭТрН,
	|	Сверка.КоличествоЗаказа КАК КоличествоЗаказа,
	|	Сверка.КоличествоПоступления КАК КоличествоПоступления,
	|	Сверка.КоличествоУПД КАК КоличествоУПД,
	|	Сверка.КоличествоЭТрН КАК КоличествоЭТрН,
	|	Сверка.ЦенаЗаказа КАК ЦенаЗаказа,
	|	Сверка.ЦенаПоступления КАК ЦенаПоступления,
	|	Сверка.ЦенаУПД КАК ЦенаУПД,
	|	Сверка.Результат КАК Результат,
	|	Сверка.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ЭАрМ_СверкаТоваровЦепочки КАК Сверка
	|ГДЕ
	|	Сверка.ИдентификаторЗаказа = &Заказ
	|	И Сверка.ИдентификаторПоступления = &Приход
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПозицияСверки";
	Запрос.УстановитьПараметр("Заказ", UidЗаказа);
	Запрос.УстановитьПараметр("Приход", UidПрихода);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат "сверка ещё не записалась, УПД " + СтрокаПоля(Маркер, "updNumber");
	КонецЕсли;

	Совпало = 0;
	Расхождений = 0;
	Примеры = Новый Массив;

	Пока Выборка.Следующий() Цикл

		РезультатСтроки = СокрЛП(Выборка.Результат);
		Если НРег(РезультатСтроки) = "совпадает" Тогда
			Совпало = Совпало + 1;
			Продолжить;
		КонецЕсли;

		Расхождений = Расхождений + 1;
		Если Примеры.Количество() >= 3 Тогда
			Продолжить;
		КонецЕсли;

		ИмяСтроки = СокрЛП(?(ЗначениеЗаполнено(Выборка.НоменклатураЗаказа),
			Выборка.НоменклатураЗаказа,
			?(ЗначениеЗаполнено(Выборка.НаименованиеУПД), Выборка.НаименованиеУПД, Выборка.НаименованиеЭТрН)));
		Примеры.Добавить(?(ЗначениеЗаполнено(ИмяСтроки), ИмяСтроки, РезультатСтроки));

	КонецЦикла;

	Если Расхождений = 0 Тогда
		Возврат СтрШаблон("сошлось, строк %1", Совпало);
	КонецЕсли;

	Текст = СтрШаблон("совпало %1, расхождений %2", Совпало, Расхождений);
	Если Примеры.Количество() > 0 Тогда
		Текст = Текст + "; например: " + СтрСоединить(Примеры, "; ");
	КонецЕсли;

	Возврат Текст;

КонецФункции

Функция ТекстСообщенийИтогов(Сообщения)

	Лимит = 15;
	Если Сообщения.Количество() <= Лимит Тогда
		Возврат СтрСоединить(Сообщения, Символы.ПС);
	КонецЕсли;

	Показано = Новый Массив;
	Для Индекс = 0 По Лимит - 1 Цикл
		Показано.Добавить(Сообщения[Индекс]);
	КонецЦикла;
	Показано.Добавить(СтрШаблон("... ещё %1 сообщений", Сообщения.Количество() - Лимит));

	Возврат СтрСоединить(Показано, Символы.ПС);

КонецФункции

#КонецОбласти

#Область ПломбаТеста

// После чистой сверки (количество и цена) — тот же автомат, что в боевом обмене:
// запрос setSeal в incoming и разбор ответа Далиона из result.
//
Функция ПрогнатьПломбуПослеСверки(Каталоги, Настройки, Маркер, Итоги)

	Настройки.КаталогЗапросовДалион = Каталоги.Входящие;
	Настройки.АвтоЗапросПломбы = Истина;

	СтрокиПротокола = Новый Массив;
	ЕстьСошедшая = Ложь;

	Для Каждого ЭлементМаркера Из ЭлементыМаркера(Маркер) Цикл

		ИдентификаторУПД = СтрокаПоля(ЭлементМаркера, "updId");
		НомерУПД = СтрокаПоля(ЭлементМаркера, "updNumber");
		Контрагент = СтрокаПоля(ЭлементМаркера, "counterparty");

		Если БулевоПоля(ЭлементМаркера, "fullMatch") И УПДСошласьПоТоварамИЦенам(ИдентификаторУПД) Тогда
			ОтметитьУПДГотоваКПломбе(ИдентификаторУПД);
			ЕстьСошедшая = Истина;
			СтрокиПротокола.Добавить(СтрШаблон(
				"Пломба: %1, УПД %2 — товары и цены сошлись, запрос setSeal",
				Контрагент, НомерУПД));
		Иначе
			СтрокиПротокола.Добавить(СтрШаблон(
				"Пломба: %1, УПД %2 — товары или цены не сошлись, запрос не уходит",
				Контрагент, НомерУПД));
		КонецЕсли;

	КонецЦикла;

	Если НЕ ЕстьСошедшая Тогда
		Возврат СтрСоединить(СтрокиПротокола, Символы.ПС);
	КонецЕсли;

	ЭАрМ_ЦепочкаЗакупки.ЗапроситьПломбы(Настройки);
	СтрокиПротокола.Добавить(ИмитироватьОтветПломбыДалион(Каталоги, Настройки, Маркер, Итоги));

	Возврат СтрСоединить(СтрокиПротокола, Символы.ПС);

КонецФункции

Функция УПДСошласьПоТоварамИЦенам(ИдентификаторУПД)

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		Возврат Ложь;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторУПД;
	МенеджерЗаписи.Прочитать();

	Возврат МенеджерЗаписи.Выбран() И МенеджерЗаписи.РасхожденийНет;

КонецФункции

Процедура ОтметитьУПДГотоваКПломбе(ИдентификаторУПД)

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторУПД;
	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.Утверждено = Истина;
	МенеджерЗаписи.Подписано = Истина;
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

Функция ИмитироватьОтветПломбыДалион(Каталоги, Настройки, Маркер, Итоги)

	СтрокиПротокола = Новый Массив;
	ЗаписаноОтветов = 0;

	Для Каждого ЭлементМаркера Из ЭлементыМаркера(Маркер) Цикл

		Если НЕ БулевоПоля(ЭлементМаркера, "fullMatch") Тогда
			Продолжить;
		КонецЕсли;

		Цепочка = ЦепочкаПоступления(СтрокаПоля(ЭлементМаркера, "receiptUid"));
		Если Цепочка = Неопределено Тогда
			СтрокиПротокола.Добавить("Пломба: цепочка поступления не найдена");
			Продолжить;
		КонецЕсли;

		Если Цепочка.СтатусПломбы <> "Запрошена" ИЛИ НЕ ЗначениеЗаполнено(Цепочка.ИдентификаторЗапросаПломбы) Тогда
			СтрокиПротокола.Добавить(СтрШаблон(
				"Пломба: запрос не ушёл (%1)",
				?(ЗначениеЗаполнено(Цепочка.КомментарийПломбы), Цепочка.КомментарийПломбы, Цепочка.СтатусПломбы)));
			Продолжить;
		КонецЕсли;

		Ответы = Новый Массив;
		ОтветДокумента = Новый Структура;
		ОтветДокумента.Вставить("uid", Цепочка.ИдентификаторПоступления);
		ОтветДокумента.Вставить("number", Цепочка.НомерПоступления);
		ОтветДокумента.Вставить("found", Истина);
		ОтветДокумента.Вставить("posted", Истина);
		ОтветДокумента.Вставить("sealed", Истина);
		ОтветДокумента.Вставить("sealState", "Установлена");
		ОтветДокумента.Вставить("error", "");
		Ответы.Добавить(ОтветДокумента);

		Заголовок = Новый Структура;
		Заголовок.Вставить("type", "serviceResponse");
		Заголовок.Вставить("version", "1.0");
		Заголовок.Вставить("source", "DALION");
		Заголовок.Вставить("created", ДатаISO(ТекущаяДатаСеанса()));
		Заголовок.Вставить("requestId", Цепочка.ИдентификаторЗапросаПломбы);

		Пакет = Новый Структура;
		Пакет.Вставить("header", Заголовок);
		Пакет.Вставить("data", Ответы);

		ИмяФайла = СтрШаблон("dalion_serviceResponse_%1.json", Цепочка.ИдентификаторЗапросаПломбы);
		ЗаписатьПакетВResult(Каталоги, ИмяФайла, Пакет);
		ЗаписаноОтветов = ЗаписаноОтветов + 1;
		СтрокиПротокола.Добавить("Пломба: ответ Далиона " + ИмяФайла);

	КонецЦикла;

	Если ЗаписаноОтветов = 0 Тогда
		Возврат СтрСоединить(СтрокиПротокола, Символы.ПС);
	КонецЕсли;

	ЭАрМ_ПриемПакетовДалион.ПринятьПакеты(Настройки, Итоги);
	ЭАрМ_ПриемПакетовДалион.ОбработатьПакеты(Настройки, Итоги);

	СтрокиПротокола.Добавить(СтрШаблон(
		"Пломба: принято ответов, обработано пакетов %1, ошибок %2",
		Итоги.Обработано, Итоги.Ошибок));

	Возврат СтрСоединить(СтрокиПротокола, Символы.ПС);

КонецФункции

Функция ЦепочкаПоступления(ИдентификаторПоступления)

	Если НЕ ЗначениеЗаполнено(ИдентификаторПоступления) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	Цепочка.НомерПоступления КАК НомерПоступления,
	|	Цепочка.СтатусПломбы КАК СтатусПломбы,
	|	Цепочка.ИдентификаторЗапросаПломбы КАК ИдентификаторЗапросаПломбы,
	|	Цепочка.КомментарийПломбы КАК КомментарийПломбы
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления = &ИдентификаторПоступления";
	Запрос.УстановитьПараметр("ИдентификаторПоступления", ИдентификаторПоступления);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторПоступления", СокрЛП(Выборка.ИдентификаторПоступления));
	Результат.Вставить("НомерПоступления", СокрЛП(Выборка.НомерПоступления));
	Результат.Вставить("СтатусПломбы", СокрЛП(Выборка.СтатусПломбы));
	Результат.Вставить("ИдентификаторЗапросаПломбы", СокрЛП(Выборка.ИдентификаторЗапросаПломбы));
	Результат.Вставить("КомментарийПломбы", СокрЛП(Выборка.КомментарийПломбы));

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Служебные

Функция ДатаСегодня()

	Возврат ТекущаяДатаСеанса();

КонецФункции

Функция ДатаISO(Значение)

	Если ТипЗнч(Значение) <> Тип("Дата") ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");

КонецФункции

Функция ЧислоЗначение(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция СтрокаПоля(Узел, ИмяПоля)

	Если ТипЗнч(Узел) = Тип("Соответствие") Тогда
		Значение = Узел.Получить(ИмяПоля);
	ИначеЕсли ТипЗнч(Узел) = Тип("Структура") Тогда
		Значение = Неопределено;
		Узел.Свойство(ИмяПоля, Значение);
	Иначе
		Возврат "";
	КонецЕсли;

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция БулевоПоля(Узел, ИмяПоля)

	Если ТипЗнч(Узел) = Тип("Соответствие") Тогда
		Значение = Узел.Получить(ИмяПоля);
	ИначеЕсли ТипЗнч(Узел) = Тип("Структура") Тогда
		Значение = Неопределено;
		Узел.Свойство(ИмяПоля, Значение);
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Возврат Значение = Истина;

КонецФункции

#КонецОбласти
