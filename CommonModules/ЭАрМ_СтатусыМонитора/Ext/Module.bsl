////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_СтатусыМонитора: обмен с Бухгалтерией без кнопок.
//
// Два регламентных задания (у каждого свой ключ, чтобы не стоять в очереди
// за другими):
//   ЭАрМ_ПрименениеПакетов (раз в 5 минут) - ПрименениеПакетов: статусы от
//     Монитора папок (файлы ut_Статусы_*.json) пишутся в реестры УПД и УКД;
//   ЭАрМ_СверкаСБух (раз в 3 часа) - СверкаСБух: «что есть в Бухгалтерии» по
//     последнему файлу ПоступленияБП_*_авто.json, который БП пишет сама.
//
// Формат файла статусов - МониторПапок (BpPortions.BuildStatusJson):
//   {"header":{"type":"ut_Статусы","version":"1","created":"...","packetId":"..."},
//    "items":[{"Идентификатор","Вид","Состояние","Текст","ДокументБух","Порция",
//              "ФайлПакета","Дата"}]}
// Запись в реестры - ЭАрМ_ВыгрузкаНакладныхДляБух.ПрименитьСтатусМонитора и
// ОтметитьСверкуСБух; здесь - файлы, повторный приём (идемпотентность) и расписание.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Регламентное задание ЭАрМ_ПрименениеПакетов.
// Настройка «Статусы Бух через монитор» выключена - ничего не делает.
//
Процедура ПрименениеПакетов() Экспорт

	Если ЭАрМ_НастройкиСервер.ФоновыеЗаданияОтключены() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
			Метаданные.РегламентныеЗадания.ЭАрМ_ПрименениеПакетов);
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ПрименениеПакетов (начало регламентного задания)", ИнформацияОбОшибке());
	КонецПопытки;

	Если ЭАрМ_НастройкиСервер.ЗначениеНастройки("Статусы_ЧерезМонитор") <> Истина Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ПрименитьПакетыСтатусов();
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "ПрименениеПакетов", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Читает файлы ut_Статусы_*.json из папки статусов и применяет их к реестрам.
// Применённый пакет (packetId уже есть в регистре ЭАрМ_ПринятыеПакетыМонитора)
// повторно не пишется: файл уходит в archive\. Битый файл - в error\ с записью
// в трассу «ОШИБКА ПРОВЕРКИ». Для каждого файла Монитору остаётся квитанция
// monitor_response_<имя файла>.json в той же папке.
//
// Параметры:
//   Папка - Строка - папка статусов; пусто - ПапкаВыгрузкиБух + подпапка из настроек
//
// Возвращаемое значение:
//   Структура:
//     * Файлов    - Число
//     * Применено - Число - строк статусов записано
//     * Пропущено - Число - строк без документа в реестрах, устаревших и уже применённых пакетов
//     * Ошибок    - Число
//
Функция ПрименитьПакетыСтатусов(Знач Папка = "") Экспорт

	Итог = Новый Структура("Файлов, Применено, Пропущено, Ошибок", 0, 0, 0, 0);

	Если НЕ ЗначениеЗаполнено(Папка) Тогда
		Папка = ПапкаСтатусов();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Папка) ИЛИ НЕ ФайлСуществует(Папка) Тогда
		Возврат Итог;
	КонецЕсли;

	// Файлы по порядку имён: в имени время пакета
	Имена = Новый СписокЗначений;
	Для Каждого Файл Из НайтиФайлы(Папка, "ut_Статусы_*.json", Ложь) Цикл
		Если Файл.ЭтоФайл() Тогда
			Имена.Добавить(Файл.Имя);
		КонецЕсли;
	КонецЦикла;
	Имена.СортироватьПоЗначению();

	Для Каждого ЭлементИмени Из Имена Цикл

		Если Итог.Файлов >= 200 Тогда
			Прервать;
		КонецЕсли;

		Файл = Новый Файл(ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Папка, ЭлементИмени.Значение));
		// Монитор ещё дописывает файл - возьмём следующим проходом
		Если Файл.ПолучитьВремяИзменения() > ТекущаяДата() - 3 Тогда
			Продолжить;
		КонецЕсли;

		Итог.Файлов = Итог.Файлов + 1;
		ПрименитьФайлСтатусов(Файл, Папка, Итог);

	КонецЦикла;

	Если Итог.Файлов > 0 Тогда
		ЭАрМ_ПриемПакетовДалион.Трасса("", СтрШаблон(
			НСтр("ru = 'Статусы монитора: файлов %1, строк записано %2, пропущено %3, ошибок %4'"),
			Итог.Файлов, Итог.Применено, Итог.Пропущено, Итог.Ошибок), Итог.Ошибок = 0);
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Регламентное задание ЭАрМ_СверкаСБух: сверка «что есть в Бух» по последнему
// файлу ПоступленияБП_*_авто.json (его пишет БП, за 60 дней, всех контрагентов).
//
Процедура СверкаСБух() Экспорт

	Если ЭАрМ_НастройкиСервер.ФоновыеЗаданияОтключены() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
			Метаданные.РегламентныеЗадания.ЭАрМ_СверкаСБух);
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"СверкаСБух (начало регламентного задания)", ИнформацияОбОшибке());
	КонецПопытки;

	Если НЕ ЭАрМ_ВыгрузкаНакладныхДляБух.АвтообменСБух() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ВыполнитьСверкуСБух();
	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "СверкаСБух", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Сверка с БП по последнему файлу *_авто.json: УПД и УКД с парой в БП получают
// «Отправлено в БП», у подписанных УПД без пары - «Нет в Бух - отправить снова»,
// возвраты БП - в колонку «Возврат в Бух». Итог - в трассу.
//
// Параметры:
//   Папка - Строка - папка с файлами; пусто - ПапкаВыгрузкиБух + подпапка из настроек
//
// Возвращаемое значение:
//   Строка - итог для трассы
//
Функция ВыполнитьСверкуСБух(Знач Папка = "") Экспорт

	Если НЕ ЗначениеЗаполнено(Папка) Тогда
		Папка = ПапкаСверкиСБух();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Папка) ИЛИ НЕ ФайлСуществует(Папка) Тогда
		Возврат "";
	КонецЕсли;

	Последний = Неопределено;
	ВремяПоследнего = '00010101';
	Для Каждого Файл Из НайтиФайлы(Папка, "*_авто.json", Ложь) Цикл
		Если НЕ Файл.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;
		ВремяФайла = Файл.ПолучитьВремяИзменения();
		Если Последний = Неопределено ИЛИ ВремяФайла > ВремяПоследнего Тогда
			Последний = Файл;
			ВремяПоследнего = ВремяФайла;
		КонецЕсли;
	КонецЦикла;

	Если Последний = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Обработка = Обработки.ЭАрМ_ВыгрузкаВБух.Создать();
	Сверка = Обработка.СопоставитьПоступленияБП(Новый ДвоичныеДанные(Последний.ПолноеИмя));

	Если НЕ Сверка.Успех Тогда
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки("", "СверкаСБух: файл " + Последний.Имя, Сверка.Ошибка);
		Возврат "";
	КонецЕсли;

	Результат = ЭАрМ_ВыгрузкаНакладныхДляБух.ОтметитьСверкуСБух(Сверка);

	Для Каждого ТекстОшибки Из Результат.Ошибки Цикл
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки("", "СверкаСБух: запись в реестр", ТекстОшибки);
	КонецЦикла;

	Текст = СтрШаблон(НСтр("ru = 'Сверка с БП (%1): сопоставлено УПД %2, УКД %3 (новых отметок УПД %4, УКД %5), нет в Бух %6, возвратов %7 (отмечено в реестре %8), ошибок записи %9'"),
		Последний.Имя, Результат.СопоставленоУПД, Результат.СопоставленоУКД, Результат.УПД, Результат.УКД,
		Результат.НетВБух, Результат.Возвратов, Результат.ОтмеченоВозвратов, Результат.Ошибки.Количество());
	ЭАрМ_ПриемПакетовДалион.Трасса("", Текст, Результат.Ошибки.Количество() = 0);

	Возврат Текст;

КонецФункции

// Приводит расписания заданий этого модуля к рабочим: ЭАрМ_ПрименениеПакетов -
// каждые 5 минут, ЭАрМ_СверкаСБух - каждые 3 часа, ЭАрМ_ОбработкаОчереди -
// каждую минуту. Расписание, в котором человек
// уже задал свой повтор в течение дня, не трогает.
//
Процедура ПроверитьРасписания() Экспорт

	ПривестиРасписание(Метаданные.РегламентныеЗадания.ЭАрМ_ПрименениеПакетов, 5 * 60);
	ПривестиРасписание(Метаданные.РегламентныеЗадания.ЭАрМ_СверкаСБух, 3 * 3600);
	// Очередь событий (ЭАрМ_ОчередьСобытий): раз в минуту, пустая очередь - один запрос
	ПривестиРасписание(Метаданные.РегламентныеЗадания.ЭАрМ_ОбработкаОчереди, 60);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Папка файлов статусов: ПапкаВыгрузкиБух + подпапка (настройка «Статусы_Подпапка»).
//
Функция ПапкаСтатусов()

	Корень = СокрЛП(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПапкаВыгрузкиБух"));
	Если НЕ ЗначениеЗаполнено(Корень) Тогда
		Возврат "";
	КонецЕсли;

	Подпапка = СокрЛП(ЭАрМ_НастройкиСервер.ЗначениеНастройки("Статусы_Подпапка"));
	Возврат ?(ЗначениеЗаполнено(Подпапка), ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Корень, Подпапка), Корень);

КонецФункции

// Папка файлов поступлений БП: ПапкаВыгрузкиБух + подпапка (настройка «Сверка_Подпапка»).
//
Функция ПапкаСверкиСБух()

	Корень = СокрЛП(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПапкаВыгрузкиБух"));
	Если НЕ ЗначениеЗаполнено(Корень) Тогда
		Возврат "";
	КонецЕсли;

	Подпапка = СокрЛП(ЭАрМ_НастройкиСервер.ЗначениеНастройки("Сверка_Подпапка"));
	Возврат ?(ЗначениеЗаполнено(Подпапка), ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Корень, Подпапка), Корень);

КонецФункции

// Один файл статусов: разбор, повторный приём, запись строк, архив / error, квитанция.
//
Процедура ПрименитьФайлСтатусов(Файл, Папка, Итог)

	Ошибки = Новый Массив;
	ИдентификаторПакета = "";

	Разбор = ПрочитатьФайлСтатусов(Файл.ПолноеИмя);
	Если НЕ Разбор.Успех Тогда
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки("", "ПрименениеПакетов: файл " + Файл.Имя, Разбор.Ошибка);
		Ошибки.Добавить(Разбор.Ошибка);
		Итог.Ошибок = Итог.Ошибок + 1;
		ПереместитьФайлСтатусов(Файл, Папка, "error");
		ЗаписатьКвитанцию(Папка, Файл.Имя, "", 0, 0, Ошибки);
		Возврат;
	КонецЕсли;

	ИдентификаторПакета = Разбор.ИдентификаторПакета;
	Строки = Разбор.Строки;

	// Этот пакет уже применён: повторно не пишем
	Если ПакетУжеПринят(ИдентификаторПакета) Тогда
		Итог.Пропущено = Итог.Пропущено + Строки.Количество();
		ПереместитьФайлСтатусов(Файл, Папка, "archive");
		ЗаписатьКвитанцию(Папка, Файл.Имя, ИдентификаторПакета, 0, Строки.Количество(), Ошибки);
		Возврат;
	КонецЕсли;

	Применено = 0;
	Пропущено = 0;

	Для Каждого Элемент Из Строки Цикл

		Идентификатор = СокрЛП(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "Идентификатор"));

		Попытка
			Результат = ЭАрМ_ВыгрузкаНакладныхДляБух.ПрименитьСтатусМонитора(Элемент,
				ДатаСтатусаИзТекста(ЭАрМ_Служебный.ЗначениеУзла(Элемент, "Дата")), Файл.Имя);
			Если Результат.Применено Тогда
				Применено = Применено + 1;
			Иначе
				Пропущено = Пропущено + 1;
				Если ЗначениеЗаполнено(Результат.Пояснение) Тогда
					ЭАрМ_ПриемПакетовДалион.Трасса(Идентификатор,
						"Статус монитора пропущен: " + Результат.Пояснение, Ложь);
				КонецЕсли;
			КонецЕсли;
		Исключение
			ТекстОшибки = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
			Ошибки.Добавить(СтрШаблон("%1: %2", Идентификатор, ТекстОшибки));
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(Идентификатор, "ПрименениеПакетов: строка статуса", ТекстОшибки);
		КонецПопытки;

	КонецЦикла;

	Итог.Применено = Итог.Применено + Применено;
	Итог.Пропущено = Итог.Пропущено + Пропущено;
	Итог.Ошибок = Итог.Ошибок + Ошибки.Количество();

	Если Ошибки.Количество() > 0 Тогда
		// Пакет не считается применённым: исправят причину и положат файл снова
		ПереместитьФайлСтатусов(Файл, Папка, "error");
		ЗаписатьКвитанцию(Папка, Файл.Имя, ИдентификаторПакета, Применено, Пропущено, Ошибки);
		Возврат;
	КонецЕсли;

	ЗаписатьПринятыйПакет(ИдентификаторПакета, Файл.Имя, Строки.Количество());
	ПереместитьФайлСтатусов(Файл, Папка, "archive");
	ЗаписатьКвитанцию(Папка, Файл.Имя, ИдентификаторПакета, Применено, Пропущено, Ошибки);

КонецПроцедуры

// Читает файл статусов и проверяет шапку.
//
// Возвращаемое значение:
//   Структура: Успех, Ошибка, ИдентификаторПакета, Строки (Массив)
//
Функция ПрочитатьФайлСтатусов(ПолноеИмя)

	Результат = Новый Структура("Успех, Ошибка, ИдентификаторПакета, Строки", Ложь, "", "", Новый Массив);

	Попытка
		Чтение = Новый ЧтениеТекста(ПолноеИмя, КодировкаТекста.UTF8);
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
		Если Лев(Текст, 1) = Символ(65279) Тогда
			Текст = Сред(Текст, 2);
		КонецЕсли;

		ЧтениеДанных = Новый ЧтениеJSON;
		ЧтениеДанных.УстановитьСтроку(Текст);
		Корень = ПрочитатьJSON(ЧтениеДанных);
		ЧтениеДанных.Закрыть();
	Исключение
		Результат.Ошибка = НСтр("ru = 'Файл не прочитан как JSON: '")
			+ ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Корень) <> Тип("Структура") Тогда
		Результат.Ошибка = НСтр("ru = 'В корне файла не объект JSON'");
		Возврат Результат;
	КонецЕсли;

	Шапка = ЭАрМ_Служебный.ЗначениеУзла(Корень, "header");
	Если ЭАрМ_Служебный.ЗначениеУзла(Шапка, "type") <> "ut_Статусы" Тогда
		Результат.Ошибка = НСтр("ru = 'Это не файл статусов: header.type должен быть ut_Статусы'");
		Возврат Результат;
	КонецЕсли;

	Результат.ИдентификаторПакета = СокрЛП(Строка(ЭАрМ_Служебный.ЗначениеУзла(Шапка, "packetId")));
	Если НЕ ЗначениеЗаполнено(Результат.ИдентификаторПакета) Тогда
		Результат.Ошибка = НСтр("ru = 'В шапке нет packetId'");
		Возврат Результат;
	КонецЕсли;

	Строки = ЭАрМ_Служебный.ЗначениеУзла(Корень, "items");
	Если ТипЗнч(Строки) <> Тип("Массив") Тогда
		Результат.Ошибка = НСтр("ru = 'Нет списка items'");
		Возврат Результат;
	КонецЕсли;

	Результат.Строки = Строки;
	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

Функция ПакетУжеПринят(ИдентификаторПакета)

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_ПринятыеПакетыМонитора.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторПакета = Лев(ИдентификаторПакета, 50);
	МенеджерЗаписи.Прочитать();

	Возврат МенеджерЗаписи.Выбран();

КонецФункции

Процедура ЗаписатьПринятыйПакет(ИдентификаторПакета, ИмяФайла, КоличествоСтрок)

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_ПринятыеПакетыМонитора.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторПакета = Лев(ИдентификаторПакета, 50);
	МенеджерЗаписи.Файл = Лев(ИмяФайла, 200);
	МенеджерЗаписи.Дата = ТекущаяДатаСеанса();
	МенеджерЗаписи.Строк = КоличествоСтрок;
	МенеджерЗаписи.Записать(Истина);

	ЭАрМ_ПриемПакетовДалион.ПроверитьЗаписьРегистра(ИдентификаторПакета, "ЭАрМ_ПринятыеПакетыМонитора",
		Новый Структура("ИдентификаторПакета", Лев(ИдентификаторПакета, 50)),
		Новый Структура("Файл, Строк", Лев(ИмяФайла, 200), КоличествоСтрок));

КонецПроцедуры

// Дата статуса из файла Монитора: «2026-10-19T12:58:26.543Z» - UTC, переводим в
// местное время сервера. Без «Z» дата считается местной. Не разобралась - сейчас.
//
Функция ДатаСтатусаИзТекста(Значение)

	Текст = СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));

	Цифры = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = "." Тогда
			Прервать;
		КонецЕсли;
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;

	Если СтрДлина(Цифры) < 14 Тогда
		Возврат ТекущаяДатаСеанса();
	КонецЕсли;

	Попытка
		Результат = Дата(Лев(Цифры, 14));
	Исключение
		Возврат ТекущаяДатаСеанса();
	КонецПопытки;

	Если Прав(Текст, 1) = "Z" Тогда
		Смещение = Окр((ТекущаяДата() - ТекущаяУниверсальнаяДата()) / 900) * 900;
		Результат = Результат + Смещение;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Файл уходит в подпапку (archive или error) папки статусов. Такое имя уже есть -
// к имени добавляется время.
//
Процедура ПереместитьФайлСтатусов(Файл, Папка, Подпапка)

	Каталог = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Папка, Подпапка);
	Если НЕ ФайлСуществует(Каталог) Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;

	Назначение = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Каталог, Файл.Имя);
	Если ФайлСуществует(Назначение) Тогда
		Назначение = ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Каталог, СтрШаблон("%1_%2%3",
			Файл.ИмяБезРасширения, Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss"), Файл.Расширение));
	КонецЕсли;

	ПереместитьФайл(Файл.ПолноеИмя, Назначение);

КонецПроцедуры

// Квитанция для Монитора: monitor_response_<имя файла>.json в папке статусов.
//
Процедура ЗаписатьКвитанцию(Папка, ИмяФайла, ИдентификаторПакета, Применено, Пропущено, Ошибки)

	Попытка

		Квитанция = Новый Структура;
		Квитанция.Вставить("packetId", ИдентификаторПакета);
		Квитанция.Вставить("applied", Применено);
		Квитанция.Вставить("skipped", Пропущено);
		Квитанция.Вставить("errors", Ошибки);

		ЗаписьДанных = Новый ЗаписьJSON;
		ЗаписьДанных.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
		ЗаписатьJSON(ЗаписьДанных, Квитанция);
		Текст = ЗаписьДанных.Закрыть();

		// Без BOM: Монитор читает файл как обычный JSON
		ДвоичныеДанныеКвитанции = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь);
		ДвоичныеДанныеКвитанции.Записать(
			ЭАрМ_РегламентныйОбменЭДО.ОбъединитьПуть(Папка, "monitor_response_" + ИмяФайла));

	Исключение
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторПакета,
			"ПрименениеПакетов: квитанция Монитору не записана", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура ПривестиРасписание(МетаЗадание, Секунд)

	Попытка

		УстановитьПривилегированныйРежим(Истина);

		Задание = РегламентныеЗадания.НайтиПредопределенное(МетаЗадание);
		Если Задание = Неопределено ИЛИ Задание.Расписание.ПериодПовтораВТечениеДня > 0 Тогда
			УстановитьПривилегированныйРежим(Ложь);
			Возврат;
		КонецЕсли;

		Расписание = Новый РасписаниеРегламентногоЗадания;
		Расписание.ПериодПовтораДней = 1;
		Расписание.ПериодПовтораВТечениеДня = Секунд;
		Задание.Расписание = Расписание;
		Задание.Записать();

		УстановитьПривилегированныйРежим(Ложь);

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("",
			"ПроверитьРасписания (" + МетаЗадание.Имя + ")", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Функция ФайлСуществует(Путь)

	Файл = Новый Файл(Путь);
	Возврат Файл.Существует();

КонецФункции

#КонецОбласти
