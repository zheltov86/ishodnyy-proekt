////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_УтверждениеСБИС: утверждение документов реестров УПД и ЭТрН в СБИС.
//
// Одна механика на оба реестра (вынесена из формы реестра УПД):
//   1. ПодготовитьПодписание - проверка запрета, СБИС.ПодготовитьДействие
//      "Утвердить" и скачивание вложений, которые требуется подписать;
//   2. подпись вложений на клиенте - закрытый ключ лежит у пользователя,
//      поэтому эта часть остаётся в формах;
//   3. ВыполнитьДействие - СБИС.ВыполнитьДействие с подписями и отметка
//      Утверждено в реестре;
//   4. ПроверитьПодписьВСБИС - спросить СБИС, видна ли подпись, и поднять
//      статус до Подписан.
//
// Очередь отправки подписывает пачку за два похода на сервер:
// ПодготовитьПакетПодписания -> подпись всех вложений на клиенте одним
// сертификатом -> ВыполнитьПакетДействий.
//
// Статус подписания ведёт цвет строки реестра (см.
// НастроитьОформлениеСтатусовПодписания):
//   пусто / Готов к утверждению - обычная строка;
//   Утвержден                   - в ЭТрН и УКД зелёная (отправлена); в УПД цветом сверки;
//   Подписан                    - в УПД зелёная строка; в ЭТрН и УКД галочка «Подписан».
//
// Реестр - "УПД" (ЭАрМ_УПД_Входящий), "УКД" (ЭАрМ_УКД_Входящий) или "ЭТрН"
// (ЭАрМ_РеестрЭТрН). Корректировку, переданную по старой памяти как "УПД",
// ищем в реестре УКД. Запреты:
//   УПД, УКД - нет флажка "К отправке" (по нему уходит утверждение в СБИС);
//   УПД  - нет отметки "Расхождений нет" (сверка с приходом Далиона);
//   УКД  - не найдена исходная УПД или УПД с учётом корректировки не сошлась;
//   ЭТрН - нет отметки "Можно утвердить" (не найдена приходная Далиона).
//          «К отправке» у ЭТрН не нужен: приходная сама даёт право подписи.
//          Товары сверять не обязательно: приход сам по себе даёт право подписи.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Спрашивает у СБИС подготовку утверждения и забирает файлы для подписи.
//
// СБИС на этом шаге сам формирует ответный титул и возвращает вложения
// с признаком ТребуемоеДействие = "Подписать". Файлы лежат на его диске
// по временным ссылкам, поэтому забираем их сразу.
//
// Для УПД титул покупателя из уже известных данных получается готовым.
// Для ЭТрН «Получен» СБИС отдаёт каркас ON_TRNACLGRPO без блока ПриемГрузГП:
// даты выгрузки, массу, места и адрес грузополучатель должен указать сам.
// Без этого ВыполнитьДействие отвечает «Не заполнен Прием груза получателем».
// Поэтому после скачивания дописываем ПриемГрузГП и подписываем уже его.
//
// Параметры:
//   Реестр          - Строка - "УПД", "УКД" или "ЭТрН"
//   Идентификатор   - Строка - документ в СБИС
//   НомерПодписанта - Число - 1 или 2, подписант из настроек (см.
//                     ЭАрМ_НастройкиСервер.ПодписантыСБИС); по умолчанию первый
//
// Возвращаемое значение:
//   Структура:
//     * Успех           - Булево
//     * Ошибка          - Строка
//     * Реестр          - Строка
//     * Идентификатор   - Строка
//     * Этап            - Структура - Идентификатор, Название
//     * Действие        - Строка - название действия
//     * Отпечаток       - Строка - отпечаток сертификата, как его знает СБИС
//     * ОтпечатокBase64 - Строка - тот же отпечаток для поиска в БСП
//     * Вложения        - Массив из Структура - Идентификатор, Имя, Данные, Подпись
//
Функция ПодготовитьПодписание(Реестр, Идентификатор, Знач НомерПодписанта = 1) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Реестр", Реестр);
	Результат.Вставить("Идентификатор", Идентификатор);
	Результат.Вставить("Этап", Неопределено);
	Результат.Вставить("Действие", "Утвердить");
	Результат.Вставить("Отпечаток", "");
	Результат.Вставить("ОтпечатокBase64", "");
	Результат.Вставить("Вложения", Новый Массив);
	// Кто подписывает - едет с подписанием до ВыполнитьДействие: там в СБИС
	// должен уйти тот же сертификат, которым подписаны вложения
	Результат.Вставить("НомерПодписанта", НомерПодписанта);

	Результат.Ошибка = ЗапретУтверждения(Реестр, Идентификатор);
	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		Возврат Результат;
	КонецЕсли;

	Сертификат = СертификатПодписанта(НомерПодписанта);
	Если Сертификат = Неопределено Тогда
		Результат.Ошибка = СтрШаблон(НСтр(
			"ru = 'В настройках ЭДО не заполнены реквизиты подписанта %1: отпечаток сертификата, ФИО и ИНН.'"),
			НомерПодписанта);
		Возврат Результат;
	КонецЕсли;

	Результат.Отпечаток = Сертификат.Отпечаток;
	Результат.ОтпечатокBase64 = ОтпечатокВBase64(Сертификат.Отпечаток);

	Если НЕ ЗначениеЗаполнено(Результат.ОтпечатокBase64) Тогда
		Результат.Ошибка = СтрШаблон(НСтр(
			"ru = 'Отпечаток %1 не похож на шестнадцатеричный: в нём должны быть только цифры и буквы A-F.'"),
			Сертификат.Отпечаток);
		Возврат Результат;
	КонецЕсли;

	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Результат.Ошибка = НСтр("ru = 'Не удалось авторизоваться в СБИС'");
		Возврат Результат;
	КонецЕсли;

	Адрес = ЭАрМ_НастройкиСервер.НастройкиСБИС().АдресСервера;

	Чтение = ЭАрМ_ОбщийМодульОбмен.ПрочитатьДокумент(Идентификатор, Сессия, Адрес);

	// Сессия просрочилась - входим заново и читаем ещё раз: иначе пачка из очереди
	// вся падала «Ошибкой отправки» и ждала автоповтора
	Если НЕ Чтение.Успех И ЭАрМ_ОбщийМодульОбмен.ЭтоОшибкаСессии(Чтение.Ошибка) Тогда
		Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию(Истина);
		Если ЗначениеЗаполнено(Сессия) Тогда
			Чтение = ЭАрМ_ОбщийМодульОбмен.ПрочитатьДокумент(Идентификатор, Сессия, Адрес);
		КонецЕсли;
	КонецЕсли;

	Если НЕ Чтение.Успех Тогда
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'СБИС.ПрочитатьДокумент: %1'"), Чтение.Ошибка);
		Возврат Результат;
	КонецЕсли;

	// Название действия берём у СБИС, а не придумываем: у УПД это «Утвердить»,
	// у ЭТрН на этапе грузополучателя оно может называться иначе
	Найдено = НайтиЭтапПодписания(Чтение.Документ, Реестр);
	Если Найдено = Неопределено Тогда
		ЗаписатьОжиданиеАннулирования(Идентификатор, Чтение.Документ);
		Результат.Ошибка = ПричинаНетЭтапаПодписания(Чтение.Документ, Реестр);
		Возврат Результат;
	КонецЕсли;

	Результат.Этап     = Найдено.Этап;
	Результат.Действие = Найдено.Действие;
	Этап = Найдено.Этап;

	ПараметрыЭтапа = Новый Структура;
	ЗаполнитьЗначенияСвойств(ПараметрыЭтапа, Этап);
	ПараметрыЭтапа.Вставить("Действие",
		Новый Структура("Название, Сертификат", Результат.Действие, Сертификат));

	ПараметрыМетода = Новый Структура("Документ",
		Новый Структура("Идентификатор, Этап", Идентификатор, ПараметрыЭтапа));

	ОтветМетода = ЭАрМ_Служебный.ВыполнитьМетодСБИС(
		"СБИС.ПодготовитьДействие", ПараметрыМетода, Сессия, Адрес);

	Если НЕ ОтветМетода.Успех Тогда
		Если ЭтоОтказЧужогоОператораЭПД(ОтветМетода.Ошибка) Тогда
			Результат.Ошибка = СтрШаблон(НСтр(
				"ru = 'Через СБИС не подписать: %1 Подпишите документ в кабинете этого оператора, автоповтора не будет.'"),
				СокрЛП(ОтветМетода.Ошибка));
		Иначе
			Результат.Ошибка = СтрШаблон(
				НСтр("ru = 'СБИС.ПодготовитьДействие: %1'"), ОтветМетода.Ошибка);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Попытка
		ЗаполнитьВложенияДляПодписи(Результат, ОтветМетода.Данные, Сессия);
	Исключение
		Результат.Ошибка = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если Результат.Вложения.Количество() = 0 Тогда
		Результат.Ошибка = НСтр("ru = 'СБИС не вернул ни одного вложения для подписи'");
		Возврат Результат;
	КонецЕсли;

	Если Реестр = "ЭТрН" Тогда
		Попытка
			ДозаполнитьТитулыГрузополучателя(Результат.Вложения, Идентификатор, Чтение.Документ);
		Исключение
			Результат.Ошибка = СтрШаблон(
				НСтр("ru = 'Не удалось заполнить приём груза в титуле грузополучателя: %1'"),
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
			Возврат Результат;
		КонецПопытки;
	КонецЕсли;

	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// Отправляет подписи в СБИС, отмечает утверждение в реестре и отдаёт ответ.
//
// Успех возвращается отдельным признаком, а не вычитывается из отчёта: отчёт
// содержит сырой ответ сервера, и слово «Ошибка:» внутри этого ответа делало
// бы удачную отправку неудачной.
//
// Параметры:
//   Реестр     - Строка - "УПД", "УКД" или "ЭТрН"
//   Подписание - Структура - Идентификатор, Этап, Действие, Вложения
//                (Идентификатор, Имя, Подпись; для дозаполненного титула
//                ЭТрН ещё Данные и ФайлЗаменён)
//
// Возвращаемое значение:
//   Структура:
//     * Успех - Булево - СБИС принял действие
//     * Отчет - Строка - запрос без подписей и полный ответ сервера
//
Функция ВыполнитьДействие(Реестр, Подписание) Экспорт

	Сертификат = СертификатПодписанта(НомерПодписантаПодписания(Подписание));
	Если Сертификат = Неопределено Тогда
		Возврат ОтказДействия(Реестр, Подписание, НСтр("ru = 'Реквизиты подписанта пропали из настроек'"));
	КонецЕсли;

	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Возврат ОтказДействия(Реестр, Подписание, НСтр("ru = 'Не удалось авторизоваться в СБИС'"));
	КонецЕсли;

	Адрес = ЭАрМ_НастройкиСервер.НастройкиСБИС().АдресСервера;

	ВложенияЗапроса = Новый Массив;

	Для Каждого Вложение Из Подписание.Вложения Цикл

		Если ТипЗнч(Вложение.Подпись) <> Тип("ДвоичныеДанные") Тогда
			Возврат ОтказДействия(Реестр, Подписание, СтрШаблон(
				НСтр("ru = 'Вложение %1 осталось без подписи'"), Вложение.Имя));
		КонецЕсли;

		ФайлПодписи = Новый Структура("ДвоичныеДанные",
			Base64БезПереносов(Вложение.Подпись));

		ОписаниеВложения = Новый Структура("Идентификатор, Подпись",
			Вложение.Идентификатор, Новый Структура("Файл", ФайлПодписи));

		// Титул 3 ЭТрН после ПодготовитьДействие мы дозаполнили. Подпись
		// стоит уже на изменённом XML, его же надо отдать СБИС на замену
		// сгенерированного каркаса, иначе он проверит пустой ПриемГрузГП.
		Если Вложение.Свойство("ФайлЗаменён") И Вложение.ФайлЗаменён Тогда

			Если НЕ Вложение.Свойство("Данные")
				ИЛИ ТипЗнч(Вложение.Данные) <> Тип("ДвоичныеДанные") Тогда
				Возврат ОтказДействия(Реестр, Подписание, СтрШаблон(
					НСтр("ru = 'Вложение %1 изменили перед подписью, но сам файл на отправку не передали'"),
					Вложение.Имя));
			КонецЕсли;

			ОписаниеВложения.Вставить("Файл", Новый Структура("Имя, ДвоичныеДанные",
				Вложение.Имя, Base64БезПереносов(Вложение.Данные)));

		КонецЕсли;

		ВложенияЗапроса.Добавить(ОписаниеВложения);

	КонецЦикла;

	ПараметрыЭтапа = Новый Структура;
	ЗаполнитьЗначенияСвойств(ПараметрыЭтапа, Подписание.Этап);
	ПараметрыЭтапа.Вставить("Действие",
		Новый Структура("Название, Сертификат", Подписание.Действие, Сертификат));
	ПараметрыЭтапа.Вставить("Вложение", ВложенияЗапроса);

	ПараметрыМетода = Новый Структура("Документ",
		Новый Структура("Идентификатор, Этап",
			Подписание.Идентификатор, ПараметрыЭтапа));

	ЧастиОтчёта = Новый Массив;
	ЧастиОтчёта.Добавить(СтрШаблон(НСтр("ru = '%1, документ СБИС: %2'"),
		Реестр, Подписание.Идентификатор));
	ЧастиОтчёта.Добавить("");
	ЧастиОтчёта.Добавить(НСтр("ru = '=== Подписано вложений ==='"));

	Для Каждого Вложение Из Подписание.Вложения Цикл
		ЧастиОтчёта.Добавить(СтрШаблон("%1 [%2]",
			Вложение.Имя, Вложение.Идентификатор));
	КонецЦикла;

	ЭАрМ_ПриемПакетовДалион.Трасса(Подписание.Идентификатор, СтрШаблон(
		"СБИС: отправляю действие «%1» по %2 № %3 (%4), подписанных вложений %5",
		Подписание.Действие, Реестр, ?(Подписание.Свойство("НомерДокумента"), Подписание.НомерДокумента, ""),
		Подписание.Идентификатор, Подписание.Вложения.Количество()));

	ОтветМетода = ЭАрМ_Служебный.ВыполнитьМетодСБИС(
		"СБИС.ВыполнитьДействие", ПараметрыМетода, Сессия, Адрес);

	// Между подготовкой и этим вызовом идёт подпись на клиенте, и сессия могла
	// просрочиться. Отказ по сессии - действие не выполнено: входим заново и
	// повторяем один раз (подписи не пересоздаются, они от документа, а не от сессии)
	Если НЕ ОтветМетода.Успех И ЭАрМ_ОбщийМодульОбмен.ЭтоОшибкаСессии(ОтветМетода.Ошибка) Тогда
		НоваяСессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию(Истина);
		Если ЗначениеЗаполнено(НоваяСессия) Тогда
			ОтветМетода = ЭАрМ_Служебный.ВыполнитьМетодСБИС(
				"СБИС.ВыполнитьДействие", ПараметрыМетода, НоваяСессия, Адрес);
			ЧастиОтчёта.Добавить(НСтр("ru = '(сессия СБИС обновлена, действие выполнено повторно)'"));
		КонецЕсли;
	КонецЕсли;

	ЧастиОтчёта.Добавить("");
	ЧастиОтчёта.Добавить(НСтр("ru = '=== СБИС.ВыполнитьДействие, ответ ==='"));
	ЧастиОтчёта.Добавить(ОтветМетода.Ответ);

	ЗаписатьРезультатУтверждения(Реестр, Подписание.Идентификатор, ОтветМетода);

	Если ОтветМетода.Успех Тогда
		ЭАрМ_ПриемПакетовДалион.Трасса(Подписание.Идентификатор, СтрШаблон(
			"СБИС: действие «%1» по %2 принято СБИС - ответ: %3", Подписание.Действие, Реестр,
			Лев(СтрЗаменить(СтрокаОтветаСБИС(ОтветМетода), Символы.ПС, " "), 400)));
	Иначе
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(Подписание.Идентификатор, "СБИС: ВыполнитьДействие",
			СтрШаблон("действие «%1» по %2 НЕ принято: %3; ответ: %4", Подписание.Действие, Реестр,
				ОтветМетода.Ошибка, Лев(СтрЗаменить(СтрокаОтветаСБИС(ОтветМетода), Символы.ПС, " "), 400)));
	КонецЕсли;

	Если НЕ ОтветМетода.Успех Тогда
		ЧастиОтчёта.Добавить("");
		ЧастиОтчёта.Добавить(СтрШаблон(НСтр("ru = 'Ошибка: %1'"), ОтветМетода.Ошибка));
	КонецЕсли;

	Возврат РезультатДействия(ОтветМетода.Успех, СтрСоединить(ЧастиОтчёта, Символы.ПС));

КонецФункции

// Отказ ВыполнитьДействие до вызова СБИС - с записью «ОШИБКА ПРОВЕРКИ» в логи: раньше
// причина была только в сообщении пользователю.
//
Функция ОтказДействия(Реестр, Подписание, Текст)

	ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(Подписание.Идентификатор, "СБИС: ВыполнитьДействие",
		СтрШаблон("%1 - действие «%2» не отправлено: %3", Реестр, Подписание.Действие, Текст));

	Возврат РезультатДействия(Ложь, Текст);

КонецФункции

// Ответ СБИС строкой для лога (ответ бывает структурой или строкой).
//
Функция СтрокаОтветаСБИС(ОтветМетода)

	Ответ = Неопределено;
	Если ТипЗнч(ОтветМетода) = Тип("Структура") И ОтветМетода.Свойство("Ответ", Ответ) Тогда
		Возврат ?(ТипЗнч(Ответ) = Тип("Строка"), Ответ, Строка(Ответ));
	КонецЕсли;

	Возврат "";

КонецФункции

// Результат ВыполнитьДействие одной строкой кода.
//
Функция РезультатДействия(Успех, Отчет)

	Возврат Новый Структура("Успех, Отчет", Успех, Отчет);

КонецФункции

// Номер подписанта, которым подписаны вложения; у старых вызовов без номера -
// первый.
//
Функция НомерПодписантаПодписания(Подписание)

	Если ТипЗнч(Подписание) = Тип("Структура")
		И Подписание.Свойство("НомерПодписанта")
		И ТипЗнч(Подписание.НомерПодписанта) = Тип("Число")
		И Подписание.НомерПодписанта > 0 Тогда
		Возврат Подписание.НомерПодписанта;
	КонецЕсли;

	Возврат 1;

КонецФункции

// Причина, по которой документ утверждать нельзя.
//
// Параметры:
//   Реестр        - Строка - "УПД", "УКД" или "ЭТрН"
//   Идентификатор - Строка - документ в СБИС
//
// Возвращаемое значение:
//   Строка - причина запрета; пустая, если утверждать можно
//
Функция ЗапретУтверждения(Реестр, Идентификатор, ПроверятьЭтапыСБИС = Ложь) Экспорт

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат НСтр("ru = 'Выберите документ в списке'");
	КонецЕсли;

	Если Реестр = "ЭТрН" Тогда

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_РеестрЭТрН.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
		МенеджерЗаписи.Прочитать();

		Если НЕ МенеджерЗаписи.Выбран() Тогда
			Возврат НСтр("ru = 'ЭТрН нет в реестре'");
		КонецЕсли;

		ЗапретСостояния = ЗапретПоСостояниюСБИС(МенеджерЗаписи);
		Если ЗначениеЗаполнено(ЗапретСостояния) Тогда
			Возврат ЗапретСостояния;
		КонецЕсли;

		Если НЕ МенеджерЗаписи.МожноУтвердить Тогда
			Возврат НСтр("ru = 'Утвердить нельзя: к ЭТрН не найдена приходная накладная Далиона (нет отметки «Можно утвердить»).'");
		КонецЕсли;

		// «К отправке» у ЭТрН не требуется: приходная накладная Далиона сама
		// даёт право подписи, а сюда приходят только ручные действия (кнопки
		// реестров, пачка очереди). Без приходной ЭТрН не подписывается -
		// проверка выше. Автоматически в очередь ЭТрН по-прежнему попадает
		// только с «К отправке» (ЭАрМ_ОбработкаПодтвержденийЭДО.ПеренестиЭТрНВОчередь).

		Возврат ЗапретСУчётомЭтапаСБИС("", Идентификатор, ПроверятьЭтапыСБИС);

	КонецЕсли;

	Если Реестр = "УКД" ИЛИ ЭАрМ_КорректировкиУПД.ЕстьВРеестреКорректировок(Идентификатор) Тогда

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_УКД_Входящий.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
		МенеджерЗаписи.Прочитать();

		Если НЕ МенеджерЗаписи.Выбран() Тогда
			Возврат НСтр("ru = 'Корректировки нет в реестре УКД'");
		КонецЕсли;

		ЗапретСостояния = ЗапретПоСостояниюСБИС(МенеджерЗаписи);
		Если ЗначениеЗаполнено(ЗапретСостояния) Тогда
			Возврат ЗапретСостояния;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(МенеджерЗаписи.ИдентификаторОснования) Тогда
			Возврат СтрШаблон(НСтр("ru = 'Утвердить корректировку нельзя: в реестре не найдена исходная УПД %1 от %2. Загрузите её из СБИС и откройте «Сверка корректировки».'"),
				МенеджерЗаписи.НомерОснования, Формат(МенеджерЗаписи.ДатаОснования, "ДЛФ=D"));
		КонецЕсли;

		// Исходная УПД аннулирована, отозвана или удалена: корректировать нечего, дождитесь
		// новой УПД взамен (корректировка перепривяжется к ней сама)
		Если ДокументРеестраЗакрыт("ЭАрМ_УПД_Входящий", МенеджерЗаписи.ИдентификаторОснования) Тогда
			Возврат СтрШаблон(НСтр("ru = 'Утвердить корректировку нельзя: исходная УПД %1 закрыта в СБИС (аннулирована, отозвана или удалена). Дождитесь новой УПД взамен.'"),
				МенеджерЗаписи.НомерОснования);
		КонецЕсли;

		Если НЕ МенеджерЗаписи.РасхожденийНет Тогда
			Возврат НСтр("ru = 'Утвердить корректировку нельзя: УПД с учётом корректировки не сошлась с приходной накладной Далиона. Подробности - «Сверка корректировки».'");
		КонецЕсли;

		Если НЕ МенеджерЗаписи.КОтправке И НЕ СтоитВОчередиКОтправке(Идентификатор) Тогда
			Возврат НСтр("ru = 'Отправка запрещена: нет отметки «К отправке» и документа нет в очереди «Ожидают отправки».'");
		КонецЕсли;

		Возврат ЗапретСУчётомЭтапаСБИС(ЗапретПоИтоговойСумме(МенеджерЗаписи.ИдентификаторОснования),
			Идентификатор, ПроверятьЭтапыСБИС);

	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат НСтр("ru = 'Документа нет в реестре УПД'");
	КонецЕсли;

	ЗапретСостояния = ЗапретПоСостояниюСБИС(МенеджерЗаписи);
	Если ЗначениеЗаполнено(ЗапретСостояния) Тогда
		Возврат ЗапретСостояния;
	КонецЕсли;

	Если НЕ МенеджерЗаписи.РасхожденийНет Тогда
		Возврат НСтр("ru = 'Утвердить нельзя: нет отметки «Расхождений нет». УПД должна сойтись с приходной накладной Далиона - дождитесь сверки цепочки закупки, устраните расхождения или получите корректировку («Сверка корректировки» покажет строки).'");
	КонецЕсли;

	Если НЕ МенеджерЗаписи.КОтправке И НЕ СтоитВОчередиКОтправке(Идентификатор) Тогда
		Возврат НСтр("ru = 'Отправка запрещена: нет отметки «К отправке» и документа нет в очереди «Ожидают отправки».'");
	КонецЕсли;

	Возврат ЗапретСУчётомЭтапаСБИС(ЗапретПоИтоговойСумме(Идентификатор), Идентификатор, ПроверятьЭтапыСБИС);

КонецФункции

// Состояние документа в реестре (код 27) ловит только «Ожидает аннулирования».
// Аннулирование, запрошенное иначе, видно лишь в этапах документа («В обработке»,
// этап «Аннулирование»): там уже нет действия «Утвердить». Поэтому перед тем как
// документ встанет в очередь («Готов к утверждению» / «К отправке»), этапы
// читаются из СБИС. Это один запрос на документ, поэтому проверка включается
// только там, где документ ставится в очередь, а не при каждом чтении запрета.
// Документ, который не удалось прочитать, не блокируется: решает подготовка к подписи.
//
Функция ЗапретСУчётомЭтапаСБИС(Запрет, Идентификатор, ПроверятьЭтапыСБИС)

	Если ЗначениеЗаполнено(Запрет) ИЛИ НЕ ПроверятьЭтапыСБИС Тогда
		Возврат Запрет;
	КонецЕсли;

	Попытка
		Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
		Если НЕ ЗначениеЗаполнено(Сессия) Тогда
			Возврат "";
		КонецЕсли;
		Адрес = ЭАрМ_НастройкиСервер.НастройкиСБИС().АдресСервера;
		Чтение = ЭАрМ_ОбщийМодульОбмен.ПрочитатьДокумент(Идентификатор, Сессия, Адрес);
		Если НЕ Чтение.Успех Тогда
			Возврат "";
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;

	ЗаписатьОжиданиеАннулирования(Идентификатор, Чтение.Документ);

	Если ЕстьЭтапАннулирования(Чтение.Документ) Тогда
		Возврат НСтр("ru = 'Утверждать нельзя: по документу идёт аннулирование (этап «Аннулирование» в СБИС). Примите решение в СБИС - согласиться или отклонить; после отклонения документ вернётся к утверждению.'");
	КонецЕсли;

	Возврат "";

КонецФункции

// Всё, что стоит в очереди «Ожидают отправки» (готово к отправке или ждёт
// повтора после ошибки), отправляется - без отметки «К отправке» в реестре:
// строка очереди и есть решение отправить.
//
Функция СтоитВОчередиКОтправке(Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Найдено
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторСБИС = &ИдентификаторСБИС
	|	И Очередь.Реестр <> """"
	|	И Очередь.Статус В (
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ПустаяСсылка))";
	Запрос.УстановитьПараметр("ИдентификаторСБИС", Идентификатор);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Последний рубеж перед подписью: итоговая сумма УПД (с учётом УКД) и
// приходной накладной Далиона пересчитывается по текущим документам. Отметки
// «Расхождений нет» мало - раньше её ставило одно наличие прихода и ЭТрН, а
// документы могли измениться после сверки.
//
Функция ЗапретПоИтоговойСумме(ИдентификаторУПД)

	// Человек принял расхождения (ручная отметка «Сверилось»): сумму он видел
	Если ЭАрМ_КорректировкиУПД.СведенияСверкиВручную(ИдентификаторУПД).Сверено Тогда
		Возврат "";
	КонецЕсли;

	Расхождение = ЭАрМ_СверкаТоваровЦепочки.РасхождениеИтоговойСуммыУПД(ИдентификаторУПД);
	Если НЕ ЗначениеЗаполнено(Расхождение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Утвердить нельзя: итоговая сумма УПД не совпадает с приходной накладной Далиона (%1).'"),
		Расхождение);

КонецФункции

// Реквизиты подписанта в том виде, в каком их ждёт СБИС.
//
// Параметры:
//   Номер - Число - 1 или 2, подписант из настроек; по умолчанию первый
//
// Возвращаемое значение:
//   Структура - Отпечаток, ФИО, ИНН и, если заполнена, Должность
//   Неопределено - настройки подписанта не заполнены
//
Функция СертификатПодписанта(Знач Номер = 1) Экспорт

	Подписант = ЭАрМ_НастройкиСервер.ПодписантСБИС(Номер);

	Если НЕ ЗначениеЗаполнено(Подписант.Отпечаток)
		ИЛИ НЕ ЗначениеЗаполнено(Подписант.ФИО)
		ИЛИ НЕ ЗначениеЗаполнено(Подписант.ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сертификат = Новый Структура;
	Сертификат.Вставить("Отпечаток", Подписант.Отпечаток);
	Сертификат.Вставить("ФИО",       Подписант.ФИО);
	Сертификат.Вставить("ИНН",       Подписант.ИНН);

	Если ЗначениеЗаполнено(Подписант.Должность) Тогда
		Сертификат.Вставить("Должность", Подписант.Должность);
	КонецЕсли;

	Возврат Сертификат;

КонецФункции

// Действия, которыми мы подписываем документ реестра, в порядке предпочтения.
//
// УПД и УКД утверждаются действием «Утвердить»: СБИС сам формирует титул
// покупателя и отдаёт его на подпись. У ЭТрН грузополучатель подписывает титул
// приёмки груза, и название действия на этом этапе задаёт СБИС - поэтому здесь
// список допустимых названий, а берётся первое, которое реально предложено.
// Отказные и служебные действия («Отклонить», «Не принят», «Переадресовать»,
// «Переназначить», «Аннулировать») сюда не входят и выбраны быть не могут.
//
// ЭТрН, как её показывает СБИС (Мз-00140470, 18.09.2026): этап «Приемка груза»,
// действия «Получен», «Получен частично», «Не принят», «Переназначить».
// Берём только «Получен» - полную приёмку, как и решено для ЭТрН: найденная
// приходная Далиона сама по себе даёт право подписи. Каркас титула 3 СБИС
// отдаёт пустым: ПриемГрузГП дописываем сами до подписи. «Получен частично» и
// «Не принят» - решение человека о расхождениях, программа их не выбирает.
//
// Только «Получен» (28.09.2026). Раньше в списке был запас «Утвердить,
// Подписать, Принять, Принять груз, Подтвердить» - и после нашего титула 3
// следующий этап ЭТрН с таким действием (например, подписать извещение после
// титула 4 перевозчика) принимался за неподписанную приёмку: проверка подписи
// считала ЭТрН неподписанной навсегда, а «Подписать» могло подписать не тот
// этап. Назовёт СБИС действие приёмки иначе - подготовка вернёт ошибку со
// списком этапов и действий (ПричинаНетЭтапаПодписания), тогда добавить сюда
// именно его.
//
// Параметры:
//   Реестр - Строка - "УПД", "УКД" или "ЭТрН"
//
// Возвращаемое значение:
//   Массив из Строка
//
Функция ДействияПодписания(Реестр) Экспорт

	Если Реестр = "ЭТрН" Тогда
		Возврат СтрРазделить("Получен", ",");
	КонецЕсли;

	Возврат СтрРазделить("Утвердить", ",");

КонецФункции

// Этап и действие для подписания: первое из ДействияПодписания(Реестр), которое
// предлагает документ. Название действия возвращается так, как его написал
// СБИС, - с ним же уйдут ПодготовитьДействие и ВыполнитьДействие.
//
// Возвращаемое значение:
//   Структура - Этап (Идентификатор, Название), Действие (Строка);
//   Неопределено - подходящего действия документ не предлагает
//
Функция НайтиЭтапПодписания(ДокументСБИС, Реестр) Экспорт

	Для Каждого Искомое Из ДействияПодписания(Реестр) Цикл

		Этап = ЭтапПоДействию(ДокументСБИС, Искомое);
		Если Этап = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Возврат Новый Структура("Этап, Действие", Этап,
			НазваниеДействияЭтапа(ДокументСБИС, Искомое));

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Почему подписать нечем - двумя разными случаями, которые раньше путались:
//   этапов нет вовсе   - документ отработан или ждёт не нас;
//   этап есть, но ни одного нашего действия в нём нет - СБИС называет действие
//                        иначе, чем знает ДействияПодписания. Так было с ЭТрН:
//                        этап «Приемка груза» ждал нас с действием «Получен», а
//                        ошибка писала «отработан или ждёт не нас».
// К тексту приложены этапы и действия, как их отдаёт СБИС.
//
Функция ПричинаНетЭтапаПодписания(ДокументСБИС, Реестр)

	ЭтапыЕсть = ЭАрМ_Служебный.ЗначениеВМассив(
		ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Этап")).Количество() > 0;

	Если ЭтапыЕсть И ЕстьЭтапАннулирования(ДокументСБИС) Тогда
		// Утверждать здесь нечего: СБИС ждёт решения по аннулированию. «Документ
		// аннулирован» и «Аннулирование отклонено» в список подписания не
		// добавляются - это решение человека, а не утверждение
		Причина = НСтр(
			"ru = 'Документ в процессе аннулирования: СБИС ждёт решения - «Документ аннулирован» (согласиться) или «Аннулирование отклонено». Утверждение невозможно, автоповтора не будет. Примите решение в СБИС; после «Аннулирование отклонено» документ вернётся к утверждению. СБИС сообщает:'");
	ИначеЕсли ЭтапыЕсть Тогда
		Причина = СтрШаблон(НСтр(
			"ru = 'Этап у документа есть, но ни одно его действие не входит в список, которым мы подписываем (%1). Нужное действие надо добавить в ЭАрМ_УтверждениеСБИС.ДействияПодписания. СБИС сейчас предлагает:'"),
			СтрСоединить(ДействияПодписания(Реестр), ", "));
	Иначе
		Причина = НСтр(
			"ru = 'Этапов, ожидающих действия, у документа нет: он уже отработан или сейчас ждёт другую сторону. СБИС сообщает:'");
	КонецЕсли;

	Возврат Причина + Символы.ПС + ОписаниеЭтаповИДействий(ДокументСБИС);

КонецФункции

// У документа есть этап «Аннулирование»: аннулирование запрошено, решения пока нет.
//
Функция ЕстьЭтапАннулирования(ДокументСБИС) Экспорт

	Для Каждого ОписаниеЭтапа Из ЭАрМ_Служебный.ЗначениеВМассив(
		ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Этап")) Цикл
		Название = ВРег(СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(
			ЭАрМ_Служебный.ЗначениеУзла(ОписаниеЭтапа, "Название", ""))));
		Если СтрНачинаетсяС(Название, "АННУЛИРОВАНИ") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Текст ошибки подготовки - «документ в процессе аннулирования» (см.
// ПричинаНетЭтапаПодписания): повторять такую отправку бессмысленно.
//
Функция ЭтоОжиданиеРешенияПоАннулированию(ТекстОшибки) Экспорт

	Возврат СтрНайти(НРег(ТекстОшибки), "в процессе аннулирования") > 0;

КонецФункции

// Название действия в написании СБИС (регистр букв может отличаться от нашего).
//
Функция НазваниеДействияЭтапа(ДокументСБИС, ДействиеЭтапа)

	Искомое = ВРег(СокрЛП(ДействиеЭтапа));

	Для Каждого ОписаниеЭтапа Из ЭАрМ_Служебный.ЗначениеВМассив(
		ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Этап")) Цикл
		Для Каждого ОписаниеДействия Из ЭАрМ_Служебный.ЗначениеВМассив(
			ЭАрМ_Служебный.ЗначениеУзла(ОписаниеЭтапа, "Действие")) Цикл
			Название = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеДействия, "Название", "")));
			Если ВРег(Название) = Искомое Тогда
				Возврат Название;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат ДействиеЭтапа;

КонецФункции

// Этапы и действия документа в СБИС - текстом, для человека.
//
// Для ЭТрН это главный способ узнать, как СБИС называет действие грузополучателя:
// показывается в ошибке подготовки и по кнопке «Этапы в СБИС» реестра ЭТрН.
//
Функция ОписаниеЭтаповИДействий(ДокументСБИС) Экспорт

	Строки = Новый Массив;

	СостояниеДокумента = ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Состояние");
	Если СостояниеДокумента <> Неопределено Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Состояние документа: %1'"),
			ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(СостояниеДокумента, "Название", "-"))));
	КонецЕсли;

	ЕстьЭтапы = Ложь;
	Для Каждого ОписаниеЭтапа Из ЭАрМ_Служебный.ЗначениеВМассив(
		ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Этап")) Цикл

		ЕстьЭтапы = Истина;
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Этап: %1'"),
			ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеЭтапа, "Название", "-"))));

		Для Каждого ОписаниеДействия Из ЭАрМ_Служебный.ЗначениеВМассив(
			ЭАрМ_Служебный.ЗначениеУзла(ОписаниеЭтапа, "Действие")) Цикл
			Строки.Добавить(СтрШаблон(НСтр("ru = '    действие «%1», требует подписи: %2'"),
				ЭАрМ_Служебный.СтрокойИлиПусто(
					ЭАрМ_Служебный.ЗначениеУзла(ОписаниеДействия, "Название", "-")),
				ЭАрМ_Служебный.СтрокойИлиПусто(
					ЭАрМ_Служебный.ЗначениеУзла(ОписаниеДействия, "ТребуетПодписания", "-"))));
		КонецЦикла;

	КонецЦикла;

	Если НЕ ЕстьЭтапы Тогда
		Строки.Добавить(НСтр("ru = 'Доступных этапов нет: документ уже отработан или ждёт не нас.'"));
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Этапы и действия документа прямо из СБИС и то, каким действием его подписали
// бы мы. Только чтение: ни подготовки, ни выполнения действий.
//
// Параметры:
//   Реестр        - Строка - "УПД", "УКД" или "ЭТрН"
//   Идентификатор - Строка - документ в СБИС
//
// Возвращаемое значение:
//   Строка
//
Функция ЭтапыДокументаВСБИС(Реестр, Идентификатор) Экспорт

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат НСтр("ru = 'Выберите документ в списке'");
	КонецЕсли;

	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Возврат НСтр("ru = 'Не удалось авторизоваться в СБИС'");
	КонецЕсли;

	Адрес = ЭАрМ_НастройкиСервер.НастройкиСБИС().АдресСервера;
	Чтение = ЭАрМ_ОбщийМодульОбмен.ПрочитатьДокумент(Идентификатор, Сессия, Адрес);
	Если НЕ Чтение.Успех Тогда
		Возврат СтрШаблон(НСтр("ru = 'СБИС.ПрочитатьДокумент: %1'"), Чтение.Ошибка);
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = '%1, документ СБИС: %2'"), Реестр, Идентификатор));
	Части.Добавить("");
	Части.Добавить(ОписаниеЭтаповИДействий(Чтение.Документ));
	Части.Добавить("");

	Найдено = НайтиЭтапПодписания(Чтение.Документ, Реестр);
	Если Найдено = Неопределено Тогда
		Части.Добавить(ПричинаНетЭтапаПодписания(Чтение.Документ, Реестр));
	Иначе
		Части.Добавить(СтрШаблон(НСтр("ru = 'Подписывать будем: этап «%1», действие «%2».'"),
			?(Найдено.Этап.Свойство("Название"), Найдено.Этап.Название, "-"),
			Найдено.Действие));
	КонецЕсли;

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// Этап, на котором доступно названное действие.
//
// Доступные этапы приходят в узле "Этап": у каждого идентификатор, название и
// массив действий. Не путать с "Событие" - там история уже выполненного.
//
// Возвращаемое значение:
//   Структура - Идентификатор, Название; Неопределено - подходящего этапа нет
//
Функция ЭтапПоДействию(ДокументСБИС, ДействиеЭтапа) Экспорт

	Искомое = ВРег(СокрЛП(ДействиеЭтапа));

	Для Каждого ОписаниеЭтапа Из ЭАрМ_Служебный.ЗначениеВМассив(
		ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Этап")) Цикл

		Найдено = Ложь;

		Для Каждого ОписаниеДействия Из ЭАрМ_Служебный.ЗначениеВМассив(
			ЭАрМ_Служебный.ЗначениеУзла(ОписаниеЭтапа, "Действие")) Цикл
			Если ВРег(СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеДействия, "Название", "")))) = Искомое Тогда
				Найдено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если НЕ Найдено Тогда
			Продолжить;
		КонецЕсли;

		Этап = Новый Структура;

		ИдентификаторЭтапа = ЭАрМ_Служебный.СтрокойИлиПусто(
			ЭАрМ_Служебный.ЗначениеУзла(ОписаниеЭтапа, "Идентификатор", ""));
		Если ЗначениеЗаполнено(ИдентификаторЭтапа) Тогда
			Этап.Вставить("Идентификатор", ИдентификаторЭтапа);
		КонецЕсли;

		Название = ЭАрМ_Служебный.СтрокойИлиПусто(
			ЭАрМ_Служебный.ЗначениеУзла(ОписаниеЭтапа, "Название", ""));
		Если ЗначениеЗаполнено(Название) Тогда
			Этап.Вставить("Название", Название);
		КонецЕсли;

		Возврат ?(Этап.Количество() > 0, Этап, Неопределено);

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// --- Подпись на сервере (отправка очереди регламентным заданием) ---
//
// Подпись на клиенте требует открытой формы и ключа на компьютере
// пользователя. Чтобы очередь уходила сама, регламентным заданием, ключ
// подписанта ставится на сервер 1С: криптопровайдер (КриптоПро) и контейнер
// ключа - для пользователя, от которого работает служба сервера 1С (rphost),
// сертификат - в его «Личные». Пароль контейнера: либо сохранён в КриптоПро,
// либо записывается командой формы очереди в безопасное хранилище.
//
// Настройки (ЭАрМ_НастройкиЭДО, необязательные):
//   ПодписьСервер_Модуль - имя криптопровайдера, по умолчанию
//                          «Crypto-Pro GOST R 34.10-2012 Cryptographic Service Provider»
//   ПодписьСервер_Путь   - путь к модулю (для КриптоПро в Windows - пусто)
//   ПодписьСервер_Тип    - тип провайдера, по умолчанию 80 (ГОСТ 2012/256)

// Менеджер криптографии и сертификат подписанта на сервере.
//
// Возвращаемое значение:
//   Структура - Менеджер, Сертификат; Неопределено - подпись на сервере
//               недоступна, причина в ТекстОшибки
//
Функция СредстваПодписиНаСервере(Знач НомерПодписанта, ТекстОшибки = "") Экспорт

	Подписант = ЭАрМ_НастройкиСервер.ПодписантСБИС(НомерПодписанта);
	Если НЕ ЗначениеЗаполнено(Подписант.Отпечаток) Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'у подписанта %1 не заполнен отпечаток сертификата'"), НомерПодписанта);
		Возврат Неопределено;
	КонецЕсли;

	Модуль = СокрЛП(Строка(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПодписьСервер_Модуль")));
	Путь = СокрЛП(Строка(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПодписьСервер_Путь")));
	ТипТекстом = СокрЛП(Строка(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПодписьСервер_Тип")));
	Попытка
		ТипМодуля = ?(ЗначениеЗаполнено(ТипТекстом), Число(ТипТекстом), 80);
	Исключение
		ТипМодуля = 80;
	КонецПопытки;

	Менеджер = Неопределено;
	ОписаниеОшибкиБСП = "";

	// Провайдер не задан явно - как на клиенте: программы из настроек
	// электронной подписи БСП (имя, тип, путь для Linux подбираются сами)
	Если НЕ ЗначениеЗаполнено(Модуль) Тогда
		Попытка
			Менеджер = ЭлектроннаяПодпись.МенеджерКриптографии("Подписание", Ложь, ОписаниеОшибкиБСП);
		Исключение
			ОписаниеОшибкиБСП = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Менеджер = Неопределено;
		КонецПопытки;
		Модуль = "Crypto-Pro GOST R 34.10-2012 Cryptographic Service Provider";
	КонецЕсли;

	Если Менеджер = Неопределено Тогда
		Попытка
			Менеджер = Новый МенеджерКриптографии(Модуль, Путь, ТипМодуля);
		Исключение
			ТекстОшибкиПровайдера = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'на сервере 1С (компьютер %1) не запускается криптопровайдер «%2» (тип %3): %4. Нужен КриптоПро CSP с серверной лицензией на этом компьютере, доступный пользователю службы 1С'"),
				ИмяКомпьютера(), Модуль, ТипМодуля, ТекстОшибкиПровайдера);
			Если ЗначениеЗаполнено(ОписаниеОшибкиБСП) Тогда
				ТекстОшибки = ТекстОшибки + СтрШаблон(НСтр("ru = '. Программы из настроек ЭП: %1'"), ОписаниеОшибкиБСП);
			КонецЕсли;
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;

	Попытка
		Хранилище = Менеджер.ПолучитьХранилищеСертификатов(
			ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
		Сертификат = Хранилище.НайтиПоОтпечатку(Base64Значение(ОтпечатокВBase64(Подписант.Отпечаток)));
	Исключение
		Сертификат = Неопределено;
	КонецПопытки;

	Если Сертификат = Неопределено Тогда
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'сертификат подписанта %1 (%2) не установлен в «Личные» пользователя службы сервера 1С'"),
			Подписант.ФИО, Подписант.Отпечаток);
		Возврат Неопределено;
	КонецЕсли;

	Пароль = ПарольКлючаНаСервере(НомерПодписанта);
	Если ЗначениеЗаполнено(Пароль) Тогда
		Менеджер.ПарольДоступаКЗакрытомуКлючу = Пароль;
	КонецЕсли;

	Возврат Новый Структура("Менеджер, Сертификат", Менеджер, Сертификат);

КонецФункции

// Подписывает на сервере вложения подготовленной пачки
// (см. ПодготовитьПакетПодписания). Подписание, у которого не подписалось хоть
// одно вложение, из пачки убирается - его причина в Ошибки.
//
// Возвращаемое значение:
//   Структура - Подписания (подписанные, готовые к ВыполнитьПакетДействий),
//               Ошибки (Массив из Структура: ИдентификаторЗапроса, Текст)
//
Функция ПодписатьПакетНаСервере(Подписания, Средства) Экспорт

	Результат = Новый Структура("Подписания, Ошибки", Новый Массив, Новый Массив);

	Для Каждого Подписание Из Подписания Цикл
		Попытка
			Для Каждого Вложение Из Подписание.Вложения Цикл
				Вложение.Подпись = Средства.Менеджер.Подписать(Вложение.Данные, Средства.Сертификат);
			КонецЦикла;
			Результат.Подписания.Добавить(Подписание);
		Исключение
			Результат.Ошибки.Добавить(Новый Структура("ИдентификаторЗапроса, Текст",
				Подписание.ИдентификаторЗапроса,
				СтрШаблон(НСтр("ru = 'Подпись на сервере не удалась: %1'"),
					КраткоеПредставлениеОшибки(ИнформацияОбОшибке()))));
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Пароль контейнера ключа подписанта для подписи на сервере - из безопасного
// хранилища; пусто - пароль сохранён в криптопровайдере (или его нет).
//
Функция ПарольКлючаНаСервере(НомерПодписанта)

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Пароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
			ВладелецПаролейКлючей(), КлючПароляКлюча(НомерПодписанта));
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		Пароль = "";
	КонецПопытки;

	Возврат ?(ТипЗнч(Пароль) = Тип("Строка"), Пароль, "");

КонецФункции

// Записывает пароль контейнера ключа подписанта в безопасное хранилище
// (не в регистр настроек). Пустой пароль - удаляет.
//
Процедура ЗаписатьПарольКлючаНаСервере(НомерПодписанта, Пароль) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Если ЗначениеЗаполнено(Пароль) Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
			ВладелецПаролейКлючей(), Пароль, КлючПароляКлюча(НомерПодписанта));
	Иначе
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(
			ВладелецПаролейКлючей(), КлючПароляКлюча(НомерПодписанта));
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция ВладелецПаролейКлючей()

	Возврат ОбщегоНазначения.ИдентификаторОбъектаМетаданных("РегистрСведений.ЭАрМ_НастройкиЭДО");

КонецФункции

Функция КлючПароляКлюча(НомерПодписанта)

	Возврат "ЭАрМ_ПарольКлючаПодписанта" + Формат(НомерПодписанта, "ЧГ=0");

КонецФункции

// Переводит шестнадцатеричный отпечаток в Base64.
//
// СБИС отдаёт отпечаток строкой вида D4CADF2D..., а БСП ищет сертификат по
// Base64 от тех же байтов - см. ЭлектроннаяПодпись.СвойстваСертификата.
//
// Возвращаемое значение:
//   Строка - Base64; пустая, если строка не шестнадцатеричная
//
Функция ОтпечатокВBase64(ОтпечатокHex) Экспорт

	ЦифрыHex = "0123456789ABCDEF";

	Очищенный = ВРег(СтрЗаменить(СокрЛП(ОтпечатокHex), " ", ""));

	Если СтрДлина(Очищенный) = 0 ИЛИ СтрДлина(Очищенный) % 2 <> 0 Тогда
		Возврат "";
	КонецЕсли;

	Буфер = Новый БуферДвоичныхДанных(СтрДлина(Очищенный) / 2);

	Для Позиция = 1 По СтрДлина(Очищенный) / 2 Цикл

		Старший = СтрНайти(ЦифрыHex, Сред(Очищенный, Позиция * 2 - 1, 1));
		Младший = СтрНайти(ЦифрыHex, Сред(Очищенный, Позиция * 2, 1));

		Если Старший = 0 ИЛИ Младший = 0 Тогда
			Возврат "";
		КонецЕсли;

		// Байт кладётся Установить: ЗаписатьБайт у буфера нет
		Буфер.Установить(Позиция - 1, (Старший - 1) * 16 + Младший - 1);

	КонецЦикла;

	Возврат Base64БезПереносов(
		ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер));

КонецФункции

// Поднимает статус подписания, не понижая уже достигнутый.
//
// «Ожидает УКД» стоит в перечислении последним (значения только добавляются
// в конец), но по смыслу он ниже «Готов к утверждению»: УПД, сошедшаяся
// с учётом корректировки, поднимается из него, как из пустого.
//
Процедура ПовыситьСтатусПодписания(МенеджерЗаписи, ЦелевойСтатус) Экспорт

	Попытка
		ТекущийСтатус = МенеджерЗаписи.СтатусПодписания;
	Исключение
		Возврат;
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(ЦелевойСтатус) Тогда
		Возврат;
	КонецЕсли;

	// «Нужна УКД» и «УКД есть, нет возврата из Далиона» стоят в конце, но ниже «Готов»
	Если ТекущийСтатус = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ОжидаетУКД
		ИЛИ ТекущийСтатус = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.НетВозвратаДалиона Тогда
		МенеджерЗаписи.СтатусПодписания = ЦелевойСтатус;
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущийСтатус)
		И Перечисления.ЭАрМ_СтатусыПодписанияЭДО.Индекс(ТекущийСтатус)
			>= Перечисления.ЭАрМ_СтатусыПодписанияЭДО.Индекс(ЦелевойСтатус) Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.СтатусПодписания = ЦелевойСтатус;

КонецПроцедуры

// Отправляет подписи по одному документу и сразу спрашивает СБИС о подписи.
//
// Для форм реестров, где подписывают текущую строку: без проверки строка
// осталась бы жёлтой до ближайшего регламента, хотя СБИС подпись уже принял.
//
// Параметры:
//   Реестр     - Строка - "УПД", "УКД" или "ЭТрН"
//   Подписание - Структура - Идентификатор, Этап, Действие, Вложения
//
// Возвращаемое значение:
//   Строка - отчёт ВыполнитьДействие, дополненный результатом проверки
//
Функция ВыполнитьДействиеСПроверкой(Реестр, Подписание) Экспорт

	Отправка = ВыполнитьДействие(Реестр, Подписание);

	Если НЕ Отправка.Успех Тогда
		Возврат Отправка.Отчет;
	КонецЕсли;

	Проверка = ПроверитьПодписьВСБИС(Реестр, Подписание.Идентификатор);

	Возврат Отправка.Отчет + Символы.ПС + Символы.ПС + ТекстПроверкиПодписи(Проверка);

КонецФункции

// Отправка подписей робота автоутверждения - для фонового задания формы.
//
// Сначала строка в очереди «Ожидаемые подтверждения ЭДО» с признаком
// «Подписано роботом», затем отправка: её итог («Отправлен на подпись»,
// «Подтверждено», «Ошибка отправки») ложится в эту строку.
//
// Параметры:
//   Реестр     - Строка - "ЭТрН"
//   Подписание - Структура - Идентификатор, Этап, Действие, Вложения
//
// Возвращаемое значение:
//   Строка - отчёт, см. ВыполнитьДействиеСПроверкой
//
Функция ВыполнитьДействиеРобота(Реестр, Подписание) Экспорт

	Попытка
		ЭАрМ_ОбработкаПодтвержденийЭДО.ПоставитьВОчередьРобота(Реестр, Подписание.Идентификатор);
	Исключение
		// Отметка в очереди не должна мешать самой подписи
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Подписание.Идентификатор, "АвтоутверждениеЭТрН", Ложь,
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат ВыполнитьДействиеСПроверкой(Реестр, Подписание);

КонецФункции

// Отправка подписей, поставленных человеком, - для фонового задания формы.
// Строка очереди этого документа теряет признак «Подписано роботом».
//
// Параметры:
//   Реестр     - Строка - "ЭТрН"
//   Подписание - Структура - Идентификатор, Этап, Действие, Вложения
//
// Возвращаемое значение:
//   Строка - отчёт, см. ВыполнитьДействиеСПроверкой
//
Функция ВыполнитьДействиеЧеловека(Реестр, Подписание) Экспорт

	Попытка
		ЭАрМ_ОбработкаПодтвержденийЭДО.СнятьПризнакРобота(Подписание.Идентификатор);
	Исключение
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Подписание.Идентификатор, "ОчередьЭДО", Ложь,
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат ВыполнитьДействиеСПроверкой(Реестр, Подписание);

КонецФункции

// Готовит подписание сразу для пачки документов очереди.
//
// Один вызов сервера вместо вызова на каждый документ: СБИС всё равно
// спрашивается по одному (СБИС.ПодготовитьДействие принимает один документ),
// но сессия и соединение берутся один раз, а клиент ходит на сервер однажды.
// Документ, которому подготовка не удалась, из пачки не выбрасывает остальные:
// его ошибка ложится в Ошибки и попадает в итоговый отчёт.
//
// Параметры:
//   ДокументыОчереди - Массив из Структура - Реестр, ИдентификаторСБИС,
//               ИдентификаторЗапроса, Номер, Контрагент
//               (см. ЭАрМ_ОбработкаПодтвержденийЭДО.ДокументыКПодписанию)
//
// Возвращаемое значение:
//   Структура:
//     * Подписания - Массив из Структура - см. ПодготовитьПодписание, плюс
//                    ИдентификаторЗапроса и НомерДокумента
//     * Ошибки     - Массив из Строка - документы, до подписи не дошедшие
//
Функция ПодготовитьПакетПодписания(ДокументыОчереди, Знач НомерПодписанта = 1) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Подписания", Новый Массив);
	Результат.Вставить("Ошибки",     Новый Массив);

	Для Каждого ДокументОчереди Из ДокументыОчереди Цикл

		Попытка
			Подготовка = ПодготовитьПодписание(
				ДокументОчереди.Реестр, ДокументОчереди.ИдентификаторСБИС, НомерПодписанта);
		Исключение
			Подготовка = Неопределено;
			Информация = ИнформацияОбОшибке();
			// В комментарий строки очереди влезает 500 символов. Подробное
			// представление начинается со стека вызовов, и сама причина
			// отрезалась: оставалось «Ошибка при вызове метода контекста» без
			// объяснения. В очередь - описание с первопричиной, стек - в журнал
			ТекстОшибки = ЭАрМ_Служебный.КраткийТекстОшибки(Информация);
			ЭАрМ_Служебный.ЗаписатьОшибку("ПодготовитьПакетПодписания",
				ЭАрМ_Служебный.ТекстИсключения(Информация));
		КонецПопытки;

		Если Подготовка = Неопределено Тогда
			Результат.Ошибки.Добавить(СтрШаблон("%1 %2: %3",
				ДокументОчереди.Реестр, ДокументОчереди.Номер, ТекстОшибки));
			ОтметитьОшибкуПодготовкиВОчереди(ДокументОчереди, ТекстОшибки);
			Продолжить;
		КонецЕсли;

		Если НЕ Подготовка.Успех Тогда
			Результат.Ошибки.Добавить(СтрШаблон("%1 %2: %3",
				ДокументОчереди.Реестр, ДокументОчереди.Номер, Подготовка.Ошибка));
			ОтметитьОшибкуПодготовкиВОчереди(ДокументОчереди, Подготовка.Ошибка);
			Продолжить;
		КонецЕсли;

		Подготовка.Вставить("ИдентификаторЗапроса", ДокументОчереди.ИдентификаторЗапроса);
		Подготовка.Вставить("НомерДокумента",       ДокументОчереди.Номер);

		Результат.Подписания.Добавить(Подготовка);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Документ не прошёл подготовку к подписи - строка очереди «Ошибка отправки»
// с автоповтором. Раньше ошибка уходила только в итог пачки, строка
// оставалась «Готовы к отправке», форма её в этом сеансе больше не брала, а
// автоповтор по времени её не видел - документ висел.
//
Процедура ОтметитьОшибкуПодготовкиВОчереди(ДокументОчереди, ТекстОшибки)

	Если НЕ ДокументОчереди.Свойство("ИдентификаторЗапроса")
		ИЛИ НЕ ЗначениеЗаполнено(ДокументОчереди.ИдентификаторЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЭАрМ_ОбработкаПодтвержденийЭДО.ОтметитьПослеОтправкиСБИС(ДокументОчереди.ИдентификаторЗапроса, Ложь,
			НСтр("ru = 'Не подготовлено к подписи: '") + ЭАрМ_Служебный.СтрокойИлиПусто(ТекстОшибки));
	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("ОтметитьОшибкуПодготовкиВОчереди",
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Отправляет в СБИС подписи сразу по всей пачке и возвращает общий отчёт.
//
// Парная к ПодготовитьПакетПодписания: клиент подписал все вложения одним
// сертификатом и одним менеджером криптографии и отдаёт их сюда одним вызовом.
// Каждый документ после отправки сразу перепроверяется в СБИС: если подпись
// там уже видна, строка станет зелёной, не дожидаясь регламента.
//
// Параметры:
//   Пакет - Массив из Структура - Реестр, Идентификатор, Этап, Действие,
//           Вложения, ИдентификаторЗапроса, НомерДокумента
//
// Возвращаемое значение:
//   Структура:
//     * Отчет       - Строка - подробности по каждому документу
//     * Отправлено  - Число
//     * Подписано   - Число - из них подтверждено подписью в СБИС
//     * Ошибок      - Число
//     * УПД, ЭТрН, УКД - Число - сколько успешно ушло по видам
//     * ТекстСводки - Строка - «Отправлено в СБИС: УПД …, ЭТрН …, УКД …»
//
Функция ВыполнитьПакетДействий(Пакет) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Отчет",      "");
	Результат.Вставить("Отправлено", 0);
	Результат.Вставить("Подписано",  0);
	Результат.Вставить("Ошибок",     0);
	Результат.Вставить("УПД",        0);
	Результат.Вставить("ЭТрН",       0);
	Результат.Вставить("УКД",        0);
	Результат.Вставить("ТекстСводки", "");

	ЧастиОтчёта = Новый Массив;
	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ОтправкаСБИС", Истина,
		СтрШаблон(НСтр("ru = 'Начата отправка пачки в СБИС: документов %1'"), Пакет.Количество()));

	Для Каждого Подписание Из Пакет Цикл

		Попытка
			Отправка = ВыполнитьДействие(Подписание.Реестр, Подписание);
		Исключение
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(Подписание.Идентификатор,
				"СБИС: ВыполнитьДействие (исключение при отправке " + Подписание.Реестр + ")", ИнформацияОбОшибке());
			Отправка = Новый Структура("Успех, Отчет", Ложь,
				СтрШаблон(НСтр("ru = 'Ошибка: %1'"),
					ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
		КонецПопытки;

		Если Отправка.Успех Тогда
			Результат.Отправлено = Результат.Отправлено + 1;
			ДобавитьОтправкуПоРеестру(Результат, Подписание.Реестр);
		Иначе
			Результат.Ошибок = Результат.Ошибок + 1;
		КонецЕсли;

		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Подписание.Идентификатор, "ОтправкаСБИС",
			Отправка.Успех, СтрШаблон("%1 %2: %3", Подписание.Реестр,
				Подписание.НомерДокумента, Отправка.Отчет));

		ЧастиОтчёта.Добавить(СтрШаблон("%1 %2", Подписание.Реестр, Подписание.НомерДокумента));
		ЧастиОтчёта.Добавить(Отправка.Отчет);

		// Отметки и проверка - под своей Попыткой: подписи в СБИС уже ушли,
		// и заблокированная строка очереди или оборванная связь не должны
		// останавливать остальную пачку
		Попытка

			// Сначала отметка об отправке (строка очереди желтеет), только потом
			// проверка подписи: иначе она перевела бы строку в «Подтверждено»,
			// а отметка тут же вернула бы её в «Отправлен на подпись»
			ЭАрМ_ОбработкаПодтвержденийЭДО.ОтметитьПослеОтправкиСБИС(
				Подписание.ИдентификаторЗапроса, Отправка.Успех, Отправка.Отчет);

			Если Отправка.Успех Тогда
				Проверка = ЭАрМ_ОбработкаПодтвержденийЭДО.ПроверитьПодписьСтрокиОчереди(
					Подписание.ИдентификаторЗапроса);
				Если Проверка.Подписан Тогда
					Результат.Подписано = Результат.Подписано + 1;
				КонецЕсли;
				ЧастиОтчёта.Добавить(ТекстПроверкиПодписи(Проверка));
			КонецЕсли;

		Исключение
			ТекстСбоя = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
			ЧастиОтчёта.Добавить(СтрШаблон(
				НСтр("ru = 'Подписи ушли, но отметки в очереди не записались: %1'"), ТекстСбоя));
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(Подписание.Идентификатор, "СБИС: отметка в очереди после отправки",
				"подпись ушла, но строка очереди не записана: " + ТекстСбоя);
			ЭАрМ_Служебный.ЗаписатьОшибку("ОчередьЭДО", СтрШаблон(
				НСтр("ru = '%1 %2: подписи отправлены, отметка не записана, %3'"),
				Подписание.Реестр, Подписание.НомерДокумента, ТекстСбоя));
		КонецПопытки;

		ЧастиОтчёта.Добавить("");

	КонецЦикла;

	Результат.Отчет = СтрСоединить(ЧастиОтчёта, Символы.ПС);
	Результат.ТекстСводки = ТекстСводкиОтправки(Результат);
	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ОтправкаСБИС",
		Результат.Ошибок = 0, Результат.ТекстСводки);

	Возврат Результат;

КонецФункции

// «Отправлено в СБИС: УПД 3, ЭТрН 2, УКД 1. Подпись подтверждена: 4, с ошибкой: 0.»
//
Функция ТекстСводкиОтправки(Итоги) Экспорт

	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = 'Отправлено в СБИС: УПД %1, ЭТрН %2, УКД %3'"),
		ЧислоИлиНольСводки(Итоги, "УПД"), ЧислоИлиНольСводки(Итоги, "ЭТрН"),
		ЧислоИлиНольСводки(Итоги, "УКД")));

	Если ЧислоИлиНольСводки(Итоги, "Подписано") > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'подпись подтверждена: %1'"), Итоги.Подписано));
	КонецЕсли;
	Если ЧислоИлиНольСводки(Итоги, "Ошибок") > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'с ошибкой: %1'"), Итоги.Ошибок));
	КонецЕсли;

	Возврат СтрСоединить(Части, ". ") + ".";

КонецФункции

Процедура ДобавитьОтправкуПоРеестру(Итоги, Реестр)

	Если Реестр = "ЭТрН" Тогда
		Итоги.ЭТрН = Итоги.ЭТрН + 1;
	ИначеЕсли Реестр = "УКД" Тогда
		Итоги.УКД = Итоги.УКД + 1;
	Иначе
		Итоги.УПД = Итоги.УПД + 1;
	КонецЕсли;

КонецПроцедуры

Функция ЧислоИлиНольСводки(Итоги, Имя)

	Если ТипЗнч(Итоги) <> Тип("Структура") ИЛИ НЕ Итоги.Свойство(Имя) Тогда
		Возврат 0;
	КонецЕсли;

	Значение = Итоги[Имя];
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);

КонецФункции

// Спрашивает СБИС, приняты ли подписи по документу, и отмечает это в реестре.
//
// Проверка нужна между «утверждение отправлено» и «подписано»: СБИС принимает
// действие сразу, а в состоянии документа подпись появляется позже.
//
// Параметры:
//   Реестр        - Строка - "УПД", "УКД" или "ЭТрН"
//   Идентификатор - Строка - документ в СБИС
//   Источник      - Строка - откуда вызвано (поле src журнала запросов СБИС)
//
// Возвращаемое значение:
//   Структура:
//     * Подписан  - Булево - подпись видна в СБИС, строку можно красить зелёным
//     * Состояние - Строка - название состояния документа в СБИС
//     * Ошибка    - Строка
//
Функция ПроверитьПодписьВСБИС(Реестр, Идентификатор, Источник = "ПроверитьПодписьВСБИС") Экспорт

	Результат = Новый Структура("Подписан, Состояние, Ошибка", Ложь, "", "");

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Результат.Ошибка = НСтр("ru = 'Не заполнен идентификатор документа'");
		Возврат Результат;
	КонецЕсли;

	Сессия = ЭАрМ_ОбщийМодульОбмен.ПолучитьСессию();
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Результат.Ошибка = НСтр("ru = 'Не удалось авторизоваться в СБИС'");
		Возврат Результат;
	КонецЕсли;

	Адрес = ЭАрМ_НастройкиСервер.НастройкиСБИС().АдресСервера;

	Попытка
		Чтение = ЭАрМ_ОбщийМодульОбмен.ПрочитатьДокумент(Идентификатор, Сессия, Адрес, , , Источник);
	Исключение
		Результат.Ошибка = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если НЕ Чтение.Успех Тогда
		Результат.Ошибка = Чтение.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Результат.Состояние = НазваниеСостоянияСБИС(Чтение.Документ);
	КодСостояния = КодСостоянияСБИС(Чтение.Документ);

	// Два признака принятой подписи. Первый - состояние документа: СБИС
	// переводит его в «Утвержден»/«Выполнено»/«Подписан». Второй - из документа
	// ушёл этап с действием «Утвердить»: подписывать в нём больше нечего.
	// Отказ, аннулирование и отзыв перебивают оба: там подписи нет.
	Если СостояниеГоворитОбОтказе(Результат.Состояние, КодСостояния) Тогда
		Возврат Результат;
	КонецЕсли;

	// Этап подписания ищется по тем же действиям, что и при отправке: для ЭТрН
	// искать «Утвердить» нельзя - его там может не быть вовсе, и тогда любая
	// ЭТрН сразу после отправки считалась бы подписанной
	Найдено = НайтиЭтапПодписания(Чтение.Документ, Реестр);
	Результат.Подписан = СостояниеГоворитОПодписи(Результат.Состояние, КодСостояния)
		ИЛИ Найдено = Неопределено;

	// Для строки очереди: что именно СБИС ещё ждёт от нас. Без этого строка
	// «Отправлен на подпись» висела молча, и не было видно, ждёт ли документ
	// ту же подпись или уже другой этап с похожим действием
	Если НЕ Результат.Подписан Тогда
		Результат.Вставить("Ожидает", СтрШаблон(НСтр("ru = 'этап «%1», действие «%2»'"),
			ЭАрМ_Служебный.СтрокойИлиПусто(ЭАрМ_Служебный.ЗначениеУзла(Найдено.Этап, "Название", "")),
			Найдено.Действие));
	КонецЕсли;

	Если Результат.Подписан Тогда
		ОтметитьПодписанным(Реестр, Идентификатор, Результат.Состояние, КодСостояния);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Название состояния документа СБИС говорит о принятой подписи.
//
// Одна формулировка на весь механизм: её же спрашивают загрузка реестра и
// сбор очереди, и расходиться им нельзя.
//
// Параметры:
//   Состояние - Строка - название состояния, как его отдаёт СБИС
//
// Возвращаемое значение:
//   Булево
//
Функция СостояниеГоворитОПодписи(Знач Состояние, Знач КодСостояния = "") Экспорт

	Код = СокрЛП(Строка(КодСостояния));
	Если ЗначениеЗаполнено(Код) И КодыСостоянийБезПодписи().Найти(Код) <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Текст = НРег(СокрЛП(Строка(Состояние)));

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ДокументЗакрытВСБИС("", Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	// «Не утвержден» и «не выполнен» - это ещё не подпись
	Если СтрНайти(Текст, "не утвержд") > 0 ИЛИ СтрНайти(Текст, "не выполнен") > 0
		ИЛИ СтрНайти(Текст, "не подписан") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	// «Ожидает подписания», «Отказано в подписании», «Подписание отклонено»
	// содержат «подписан», а «Выполнение завершено с проблемами» - «выполнен»,
	// но подписи в них нет
	Для Каждого Оборот Из СтрРазделить(
		"ожидает подписания|ожидается подпись|подписание отклонено|отказано в подписании|с проблемами", "|") Цикл
		Если СтрНайти(Текст, Оборот) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрНайти(Текст, "утвержд") > 0
		ИЛИ СтрНайти(Текст, "выполнен") > 0
		ИЛИ СтрНайти(Текст, "подписан") > 0;

КонецФункции

// Название состояния говорит об отказе: подписи по документу не будет.
//
// Параметры:
//   Состояние - Строка - название состояния, как его отдаёт СБИС
//
// Возвращаемое значение:
//   Булево
//
Функция СостояниеГоворитОбОтказе(Знач Состояние, Знач КодСостояния = "") Экспорт

	Если ДокументЗакрытВСБИС(КодСостояния, Состояние) Тогда
		Возврат Истина;
	КонецЕсли;

	Текст = НРег(СокрЛП(Строка(Состояние)));

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	// После отказа в аннулировании документ снова действует
	Если СокрЛП(Строка(КодСостояния)) = "40"
		ИЛИ СтрНайти(Текст, "отказано в аннулировании") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти(Текст, "отклон") > 0
		ИЛИ СтрНайти(Текст, "аннулир") > 0
		ИЛИ СтрНайти(Текст, "отозв") > 0
		ИЛИ СтрНайти(Текст, "удален") > 0
		ИЛИ СтрНайти(Текст, "отрицательно") > 0;

КонецФункции

// Коды состояния документа СБИС, после которых документа в обороте нет:
// 19 «Отозван мной», 20 «Удален контрагентом», 21 «Удален»,
// 22 «Аннулирован по соглашению». Коды - как в штатной обработке Sbis1C.
//
// Возвращаемое значение:
//   Массив из Строка
//
Функция КодыЗакрытыхДокументов() Экспорт

	Возврат СтрРазделить("19,20,21,22", ",");

КонецФункции

// Коды, при которых подписи в СБИС нет, как бы ни звучало название:
// проблемы доставки, завершено с проблемами, закрытые документы, ожидание
// подписи или аннулирования, отказы в подписи.
//
Функция КодыСостоянийБезПодписи()

	Возврат СтрРазделить("6,9,19,20,21,22,23,25,27,37,38,39", ",");

КонецФункции

// Документ закрыт в СБИС: аннулирован по соглашению, удалён или отозван.
// Утверждать его нельзя, а цепочка, корректировки и ЭТрН переходят
// к документу, который поставщик пришлёт взамен.
//
// Код надёжнее названия; строки, загруженные до появления кода в реестрах,
// проверяются по названию. «Ожидает аннулирования» (27) и «Отказано
// в аннулировании» (40) закрытием не считаются: первое ещё могут отклонить,
// после второго документ действует.
//
// Параметры:
//   КодСостояния - Строка, Число - Состояние.Код документа СБИС
//   Состояние    - Строка - Состояние.Название
//
// Возвращаемое значение:
//   Булево
//
// Ставит галку «Аннулирована» по коду и названию состояния. У реестров без
// этого ресурса (ЭТрН, УКД) ничего не меняет.
//
Процедура ОтметитьАннулирование(МенеджерЗаписи) Экспорт

	// У менеджера записи нет Метаданные() - наличие поля проверяем через структуру
	Поля = Новый Структура("Аннулирована, ОжидаетАннулирования", NULL, NULL);
	ЗаполнитьЗначенияСвойств(Поля, МенеджерЗаписи);

	Если Поля.Аннулирована = NULL Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.Аннулирована = ДокументЗакрытВСБИС(МенеджерЗаписи.КодСостояния, МенеджерЗаписи.Состояние);

	Если Поля.ОжидаетАннулирования = NULL Тогда
		Возврат;
	КонецЕсли;

	// Решение есть - аннулирована или отказано (40): не ждём. Код 27 - ждём.
	// Иначе прежнее значение: этап «Аннулирование» при состоянии «В обработке»
	// виден только при чтении документа (ЗаписатьОжиданиеАннулирования)
	Если МенеджерЗаписи.Аннулирована ИЛИ СокрЛП(Строка(МенеджерЗаписи.КодСостояния)) = "40" Тогда
		МенеджерЗаписи.ОжидаетАннулирования = Ложь;
	ИначеЕсли ДокументОжидаетАннулирования(МенеджерЗаписи.КодСостояния, МенеджерЗаписи.Состояние) Тогда
		МенеджерЗаписи.ОжидаетАннулирования = Истина;
	КонецЕсли;

КонецПроцедуры

// Отметка «Ожидает аннулирования» в реестре УПД по этапам документа, прочитанного
// из СБИС. У УКД и ЭТрН такого поля нет: строки реестра УПД с таким
// идентификатором нет - ничего не меняется.
//
// Параметры:
//   Идентификатор - Строка - документ в СБИС
//   ДокументСБИС  - Соответствие, Структура - ответ СБИС.ПрочитатьДокумент
//
Процедура ЗаписатьОжиданиеАннулирования(Идентификатор, ДокументСБИС) Экспорт

	// Внутри чужой транзакции не пишем: ИзменитьСтрокуРеестра при отсутствии
	// строки отменяет транзакцию, а с ней и внешнюю
	Если ТранзакцияАктивна() Тогда
		Возврат;
	КонецЕсли;

	Ждёт = ЕстьЭтапАннулирования(ДокументСБИС);

	// Писать только если строка УПД есть и отметка меняется: у УКД и ЭТрН строки
	// в реестре УПД нет
	МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
	МенеджерЗаписи.Прочитать();
	Если НЕ МенеджерЗаписи.Выбран() ИЛИ МенеджерЗаписи.ОжидаетАннулирования = Ждёт Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЭАрМ_КорректировкиУПД.ИзменитьСтрокуРеестра("ЭАрМ_УПД_Входящий", Идентификатор,
			Новый Структура("ОжидаетАннулирования", Ждёт));
	Исключение
		// Отметка - подсказка для списка, сбой её записи не мешает проверке
		ЗаписьЖурналаРегистрации("ЭАрМ.Аннулирование", УровеньЖурналаРегистрации.Предупреждение, , ,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция ДокументЗакрытВСБИС(Знач КодСостояния, Знач Состояние = "") Экспорт

	Код = СокрЛП(Строка(КодСостояния));
	Если ЗначениеЗаполнено(Код) Тогда
		Возврат КодыЗакрытыхДокументов().Найти(Код) <> Неопределено;
	КонецЕсли;

	Текст = НРег(СокрЛП(Строка(Состояние)));

	Возврат СтрНачинаетсяС(Текст, "аннулирован")
		ИЛИ СтрНачинаетсяС(Текст, "удален")
		ИЛИ СтрНачинаетсяС(Текст, "отозван");

КонецФункции

// Отправитель предложил аннулировать документ, решения ещё нет (код 27).
//
Функция ДокументОжидаетАннулирования(Знач КодСостояния, Знач Состояние = "") Экспорт

	Код = СокрЛП(Строка(КодСостояния));
	Если ЗначениеЗаполнено(Код) Тогда
		Возврат Код = "27";
	КонецЕсли;

	Возврат СтрНачинаетсяС(НРег(СокрЛП(Строка(Состояние))), "ожидает аннулирования");

КонецФункции

// Условие запроса «документ реестра не закрыт в СБИС» - то же правило, что
// ДокументЗакрытВСБИС, для отборов в запросах. У таблицы реестра должны быть
// поля КодСостояния и Состояние.
//
// Параметры:
//   Псевдоним - Строка - псевдоним таблицы реестра в запросе
//
// Возвращаемое значение:
//   Строка - текст условия
//
Функция УсловиеДокументНеЗакрыт(Псевдоним) Экспорт

	Текст =
	"НЕ (#.КодСостояния В (""" + СтрСоединить(КодыЗакрытыхДокументов(), """, """) + """))
	|	И НЕ (#.КодСостояния = """"
	|		И (#.Состояние ПОДОБНО ""Аннулирован%""
	|			ИЛИ #.Состояние ПОДОБНО ""Удален%""
	|			ИЛИ #.Состояние ПОДОБНО ""Отозван%""))";

	Возврат СтрЗаменить(Текст, "#", Псевдоним);

КонецФункции

// Документ реестра закрыт в СБИС (см. ДокументЗакрытВСБИС). Документа, которого
// в реестре нет, закрытым не считает.
//
// Параметры:
//   ИмяРегистра   - Строка - ЭАрМ_УПД_Входящий, ЭАрМ_УКД_Входящий или ЭАрМ_РеестрЭТрН
//   Идентификатор - Строка - документ в СБИС
//
// Возвращаемое значение:
//   Булево
//
Функция ДокументРеестраЗакрыт(ИмяРегистра, Идентификатор) Экспорт

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Ложь;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
	МенеджерЗаписи.Прочитать();

	Возврат МенеджерЗаписи.Выбран()
		И ДокументЗакрытВСБИС(МенеджерЗаписи.КодСостояния, МенеджерЗаписи.Состояние);

КонецФункции

// Код состояния документа, прочитанного из СБИС (Состояние.Код).
//
Функция КодСостоянияСБИС(ДокументСБИС) Экспорт

	УзелСостояния = ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Состояние");
	Код = ЭАрМ_Служебный.ЗначениеУзла(УзелСостояния, "Код", "");

	// JSON может отдать код и строкой, и числом
	Если ТипЗнч(Код) = Тип("Число") Тогда
		Возврат Формат(Код, "ЧГ=0");
	КонецЕсли;

	Возврат СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(Код));

КонецФункции

// Почему документ реестра нельзя утверждать по его состоянию в СБИС.
//
// Параметры:
//   ЗаписьРеестра - МенеджерЗаписи, Структура - с полями КодСостояния, Состояние
//
// Возвращаемое значение:
//   Строка - пустая, если состояние утверждению не мешает
//
Функция ЗапретПоСостояниюСБИС(ЗаписьРеестра) Экспорт

	Название = СокрЛП(ЗаписьРеестра.Состояние);
	Если НЕ ЗначениеЗаполнено(Название) Тогда
		Название = СтрШаблон(НСтр("ru = 'код %1'"), СокрЛП(ЗаписьРеестра.КодСостояния));
	КонецЕсли;

	Если ДокументЗакрытВСБИС(ЗаписьРеестра.КодСостояния, ЗаписьРеестра.Состояние) Тогда
		Возврат СтрШаблон(НСтр(
			"ru = 'Утверждать нельзя: в СБИС документ закрыт (%1). Документ, который поставщик пришлёт взамен, подвяжется к цепочке сам.'"),
			Название);
	КонецЕсли;

	Если ДокументОжидаетАннулирования(ЗаписьРеестра.КодСостояния, ЗаписьРеестра.Состояние) Тогда
		Возврат СтрШаблон(НСтр(
			"ru = 'Утверждать нельзя: поставщик предложил аннулировать документ (%1). Дождитесь решения по аннулированию в СБИС.'"),
			Название);
	КонецЕсли;

	Возврат "";

КонецФункции

// Отказ СБИС подписывать ЭПД, которую ведёт другой оператор:
// «В документе указан оператор ЭПД - Контур (Диадок). Пожалуйста,
// обработайте его в личном кабинете сервиса Контур (Диадок).»
//
// Это не сбой, а окончательный ответ: титул такой ЭТрН подписывается только
// у её оператора, и повтор через СБИС не поможет ни через 5 минут, ни через
// 6 часов. Сверяем по смыслу, без имени оператора - Диадок не единственный.
//
// Параметры:
//   ТекстОшибки - Строка - ответ СБИС или уже обёрнутый текст ошибки
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоОтказЧужогоОператораЭПД(ТекстОшибки) Экспорт

	Текст = НРег(ЭАрМ_Служебный.СтрокойИлиПусто(ТекстОшибки));

	Возврат СтрНайти(Текст, "оператор эпд") > 0
		И СтрНайти(Текст, "личном кабинете") > 0;

КонецФункции

// Отмечает в реестре, что СБИС принял подписи: строка становится зелёной.
// Для ЭТрН заодно пересчитывает сводку титулов: подпись нашего титула
// меняет состав титулов в документе, и колонка «Состояние титулов»
// обновляется сразу, а не при следующем чтении из СБИС.
//
// Параметры:
//   Реестр        - Строка - "УПД", "УКД" или "ЭТрН"
//   Идентификатор - Строка - документ в СБИС
//   СостояниеСБИС - Строка - название состояния; пустое не затирает прежнее
//   КодСостояния  - Строка - код состояния; пустой не затирает прежний
//
Процедура ОтметитьПодписанным(Реестр, Идентификатор, Знач СостояниеСБИС = "", Знач КодСостояния = "") Экспорт

	ИмяРегистра = ИмяРегистраРеестра(Реестр, Идентификатор);

	НачатьТранзакцию();
	Попытка

		ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра(
			"РегистрСведений." + ИмяРегистра, Идентификатор);

		МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Утверждено = Истина;
			МенеджерЗаписи.Подписано  = Истина;
			Если ЗначениеЗаполнено(СостояниеСБИС) Тогда
				МенеджерЗаписи.Состояние = Лев(СостояниеСБИС, 100);
			КонецЕсли;
			Если ЗначениеЗаполнено(КодСостояния) Тогда
				МенеджерЗаписи.КодСостояния = Лев(КодСостояния, 10);
			КонецЕсли;
			ОтметитьАннулирование(МенеджерЗаписи);
			ПовыситьСтатусПодписания(МенеджерЗаписи,
				Перечисления.ЭАрМ_СтатусыПодписанияЭДО.Подписан);

			// ЭТрН: подпись добавляет титул в документ - сводка титулов
			// на форме реестра пересчитывается сразу.
			// Вложенный Если, а не "И": в 1С оба операнда "И" вычисляются
			// всегда, и ДанныеПолучены у регистра УПД отсутствует
			Если ИмяРегистра = "ЭАрМ_РеестрЭТрН" Тогда
				Если МенеджерЗаписи.ДанныеПолучены Тогда
					Документ = ЭАрМ_ОбщийМодульОбмен.УзелИзJSON(МенеджерЗаписи.ДанныеДокумента);
					Если Документ <> Неопределено Тогда
						МенеджерЗаписи.СостояниеТитулов = Лев(
							ЭАрМ_ОбщийМодульОбмен.СводкаТитуловЭТрН(Документ), 500);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

			МенеджерЗаписи.Записать(Истина);
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЭАрМ_Служебный.ЗаписатьОшибку("СтатусПодписи" + Реестр, СтрШаблон(
			НСтр("ru = '%1 %2 подписан(а) в СБИС, но отметка в реестре не записана: %3'"),
			Реестр, Идентификатор, ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
	КонецПопытки;

	// Подпись видна в СБИС - строка очереди тоже «Подтверждено», откуда бы
	// документ ни отправляли
	Попытка
		ЭАрМ_ОбработкаПодтвержденийЭДО.ОтметитьОчередьПоДокументу(Идентификатор, Истина,
			СостояниеСБИС, Истина);
	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("ОчередьЭДО" + Реестр, СтрШаблон(
			НСтр("ru = '%1 %2: статус подписи в очереди не обновлён: %3'"),
			Реестр, Идентификатор, ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
	КонецПопытки;

	// Подписанный УПД или УКД - в папку Бухгалтерии фоновым заданием (логика
	// ВыгрузкаИзУт, ЭАрМ_ВыгрузкаВБух). Уже выгруженный второй раз не уходит;
	// не запустилось - доберёт регламентное задание
	Если ИмяРегистра = "ЭАрМ_УПД_Входящий" ИЛИ ИмяРегистра = "ЭАрМ_УКД_Входящий" Тогда
		Попытка
			ЭАрМ_ВыгрузкаНакладныхДляБух.ЗапуститьВыгрузкуВФоне();
		Исключение
			ЭАрМ_Служебный.ЗаписатьОшибку("ВыгрузкаВБух" + Реестр, СтрШаблон(
				НСтр("ru = '%1 %2 подписан, но в БП не выгружен: %3'"),
				Реестр, Идентификатор, ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Имя регистра реестра по его короткому названию.
//
// Корректировку, переданную по старой памяти как "УПД", ищем в реестре УКД.
//
// Параметры:
//   Реестр        - Строка - "УПД", "УКД" или "ЭТрН"
//   Идентификатор - Строка - документ в СБИС
//
// Возвращаемое значение:
//   Строка - имя регистра сведений
//
Функция ИмяРегистраРеестра(Реестр, Идентификатор) Экспорт

	Если Реестр = "ЭТрН" Тогда
		Возврат "ЭАрМ_РеестрЭТрН";
	ИначеЕсли Реестр = "УКД" ИЛИ ЭАрМ_КорректировкиУПД.ЕстьВРеестреКорректировок(Идентификатор) Тогда
		Возврат "ЭАрМ_УКД_Входящий";
	КонецЕсли;

	Возврат "ЭАрМ_УПД_Входящий";

КонецФункции

// Красит строки реестра по статусу подписания.
//
// Жёлтый фон больше не используется. «Утвержден» (отправлена) в ЭТрН и УКД
// зелёная. «Подписан» в этих реестрах строку не красит: отметка стоит галочкой
// в колонке «Подписан». В реестре УПД «Утвержден» тоже не красит строку,
// «Подписан» остаётся зелёной.
//
// Параметры:
//   УсловноеОформление    - УсловноеОформлениеДанных - оформление формы списка
//   ИмяСписка             - Строка - имя реквизита-списка, обычно "Список"
//   КраситьУтвержденные   - Булево - красить статус «Утвержден»
//   КраситьПодписанные    - Булево - зелёный фон у статуса «Подписан»
//   УтвержденныеЗеленые   - Булево - «Утвержден» зелёная (отправлена), а не жёлтая
//
Процедура НастроитьОформлениеСтатусовПодписания(УсловноеОформление, ИмяСписка = "Список",
	КраситьУтвержденные = Истина, КраситьПодписанные = Истина, УтвержденныеЗеленые = Ложь) Экспорт

	// Утверждение отправлено, подписи в СБИС ещё не видно
	Если КраситьУтвержденные ИЛИ УтвержденныеЗеленые Тогда
		ЭлементУтвержден = УсловноеОформление.Элементы.Добавить();

		ПолеУтвержден = ЭлементУтвержден.Поля.Элементы.Добавить();
		ПолеУтвержден.Поле = Новый ПолеКомпоновкиДанных(ИмяСписка);
		ПолеУтвержден.Использование = Истина;

		ОтборУтвержден = ЭлементУтвержден.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборУтвержден.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяСписка + ".СтатусПодписания");
		ОтборУтвержден.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ОтборУтвержден.ПравоеЗначение = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.Утвержден;
		ОтборУтвержден.Использование  = Истина;

		Если УтвержденныеЗеленые Тогда
			ЭлементУтвержден.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(220, 255, 220));
			ЭлементУтвержден.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(0, 100, 0));
		Иначе
			ЭлементУтвержден.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 245, 200));
			ЭлементУтвержден.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(120, 80, 0));
		КонецЕсли;
	КонецЕсли;

	Если НЕ КраситьПодписанные Тогда
		Возврат;
	КонецЕсли;

	// СБИС подтвердил подпись - зелёная строка
	ЭлементПодписан = УсловноеОформление.Элементы.Добавить();

	ПолеПодписан = ЭлементПодписан.Поля.Элементы.Добавить();
	ПолеПодписан.Поле = Новый ПолеКомпоновкиДанных(ИмяСписка);
	ПолеПодписан.Использование = Истина;

	ОтборПодписан = ЭлементПодписан.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПодписан.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяСписка + ".СтатусПодписания");
	ОтборПодписан.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПодписан.ПравоеЗначение = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.Подписан;
	ОтборПодписан.Использование  = Истина;

	ЭлементПодписан.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(220, 255, 220));
	ЭлементПодписан.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(0, 100, 0));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строка отчёта о том, увидел ли СБИС подпись.
//
Функция ТекстПроверкиПодписи(Проверка)

	Если Проверка.Подписан Тогда
		Возврат СтрШаблон(
			НСтр("ru = 'СБИС: подпись принята, состояние «%1»'"), Проверка.Состояние);
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = 'СБИС: подпись пока не видна, состояние «%1» %2'"),
		Проверка.Состояние, Проверка.Ошибка);

КонецФункции

// Название состояния документа, прочитанного из СБИС.
//
Функция НазваниеСостоянияСБИС(ДокументСБИС)

	УзелСостояния = ЭАрМ_Служебный.ЗначениеУзла(ДокументСБИС, "Состояние");

	Возврат ЭАрМ_Служебный.СтрокойИлиПусто(
		ЭАрМ_Служебный.ЗначениеУзла(УзелСостояния, "Название", ""));

КонецФункции

// Забирает с диска СБИС файлы вложений, которые требуется подписать.
//
Процедура ЗаполнитьВложенияДляПодписи(Результат, ДанныеОтвета, Сессия)

	Для Каждого ОписаниеЭтапа Из ЭАрМ_Служебный.ЗначениеВМассив(
		ЭАрМ_Служебный.ЗначениеУзла(ДанныеОтвета, "Этап")) Цикл

		Для Каждого ОписаниеВложения Из ЭАрМ_Служебный.ЗначениеВМассив(
			ЭАрМ_Служебный.ЗначениеУзла(ОписаниеЭтапа, "Вложение")) Цикл

			ТребуемоеДействие = ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеВложения, "ТребуемоеДействие", ""));

			Если ТребуемоеДействие <> "Подписать" Тогда
				Продолжить;
			КонецЕсли;

			Ссылка = ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеПоПути(ОписаниеВложения, "Файл.Ссылка", ""));

			Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
				Продолжить;
			КонецЕсли;

			Вложение = Новый Структура;
			Вложение.Вставить("Идентификатор", ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеУзла(ОписаниеВложения, "Идентификатор", "")));
			Вложение.Вставить("Имя", ЭАрМ_Служебный.СтрокойИлиПусто(
				ЭАрМ_Служебный.ЗначениеПоПути(ОписаниеВложения, "Файл.Имя", "")));
			Вложение.Вставить("Данные", СкачатьФайлВложения(Ссылка, Сессия));
			Вложение.Вставить("Подпись", Неопределено);
			Вложение.Вставить("ФайлЗаменён", Ложь);

			Результат.Вложения.Добавить(Вложение);

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Скачивает файл вложения по временной ссылке диска СБИС.
//
// Диск спрашивает сессию: без заголовка X-SBISSessionID он отвечает 403.
// Строку запроса не трогаем - в ней подпись ссылки, и перекодирование %2B
// или %3D сломает проверку на стороне диска.
//
Функция СкачатьФайлВложения(Ссылка, Сессия)

	URI = ОбщегоНазначенияКлиентСервер.СтруктураURI(Ссылка);

	АдресРесурса = URI.ПутьНаСервере;
	Если Лев(АдресРесурса, 1) <> "/" Тогда
		АдресРесурса = "/" + АдресРесурса;
	КонецЕсли;

	Соединение = Новый HTTPСоединение(URI.Хост, URI.Порт, , , , 60,
		ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение());

	Запрос = Новый HTTPЗапрос(АдресРесурса);
	Запрос.Заголовки.Вставить("X-SBISSessionID", Сессия);

	Ответ = Соединение.Получить(Запрос);

	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Файл вложения не скачался, код ответа %1. Адрес: %2'"),
			Ответ.КодСостояния, АдресРесурса);
	КонецЕсли;

	Возврат Ответ.ПолучитьТелоКакДвоичныеДанные();

КонецФункции

Процедура ЗаписатьРезультатУтверждения(Реестр, Идентификатор, ОтветМетода)

	Если ОтветМетода.Успех Тогда
		ОтметитьУтвержденным(Реестр, Идентификатор);
		ЗаписьЖурналаРегистрации("ЭАрМ_ЭДО.Утверждение" + Реестр,
			УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон(НСтр("ru = '%1 %2 подписан(а) и утверждён(а) в СБИС'"), Реестр, Идентификатор));
	Иначе
		ЭАрМ_Служебный.ЗаписатьОшибку("Утверждение" + Реестр, СтрШаблон(
			НСтр("ru = '%1 %2: утверждение не прошло, %3'"),
			Реестр, Идентификатор, ОтветМетода.Ошибка));
	КонецЕсли;

	// Строка очереди «Ожидаемые подтверждения ЭДО» - и при отправке кнопкой
	// реестра, мимо очереди. Пачка очереди потом пишет то же самое по своей
	// строке (ОтметитьПослеОтправкиСБИС), повтор безвреден
	Попытка
		ЭАрМ_ОбработкаПодтвержденийЭДО.ОтметитьОчередьПоДокументу(Идентификатор,
			ОтветМетода.Успех, ?(ОтветМетода.Успех, "", ОтветМетода.Ошибка));
	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("ОчередьЭДО" + Реестр, СтрШаблон(
			НСтр("ru = '%1 %2: статус в очереди не обновлён: %3'"),
			Реестр, Идентификатор, ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

// Фиксирует успешное завершение действия СБИС «Утвердить».
//
// Это ещё не подпись: СБИС принял действие, но в состоянии документа подпись
// появляется позже. Поэтому здесь только «Утвержден» - жёлтая строка, а
// «Подписан» и зелёный ставит ОтметитьПодписанным по ответу СБИС
// (см. ПроверитьПодписьВСБИС).
//
Процедура ОтметитьУтвержденным(Реестр, Идентификатор)

	ИмяРегистра = ИмяРегистраРеестра(Реестр, Идентификатор);

	НачатьТранзакцию();
	Попытка

		ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра(
			"РегистрСведений." + ИмяРегистра, Идентификатор);

		МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Утверждено = Истина;
			ПовыситьСтатусПодписания(МенеджерЗаписи,
				Перечисления.ЭАрМ_СтатусыПодписанияЭДО.Утвержден);
			МенеджерЗаписи.Записать(Истина);
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЭАрМ_Служебный.ЗаписатьОшибку("СтатусУтверждения" + Реестр, СтрШаблон(
			НСтр("ru = '%1 %2 утверждён(а) в СБИС, но отметка в реестре не записана: %3'"),
			Реестр, Идентификатор, ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

// Дописывает ПриемГрузГП в титуле грузополучателя, который СБИС сгенерировал
// пустым. Подпись потом ставится на уже заполненный XML.
//
Процедура ДозаполнитьТитулыГрузополучателя(Вложения, Идентификатор, ДокументСБИС)

	ФактыПриёмки = ФактыПриёмкиГруза(Идентификатор, ДокументСБИС);

	Для Каждого Вложение Из Вложения Цикл

		Если НЕ ЭтоТитулГрузополучателя(Вложение.Имя) Тогда
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(Вложение.Данные) <> Тип("ДвоичныеДанные") Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Титул грузополучателя %1 скачался не файлом'"), Вложение.Имя);
		КонецЕсли;

		ЗаполненныйФайл = ДозаполнитьПриемГрузаВXML(Вложение.Данные, Вложение.Имя, ФактыПриёмки);
		Если ЗаполненныйФайл = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Вложение.Данные = ЗаполненныйФайл;
		Вложение.ФайлЗаменён = Истина;

	КонецЦикла;

КонецПроцедуры

Функция ЭтоТитулГрузополучателя(ИмяФайла)

	Имя = ВРег(СокрЛП(ИмяФайла));

	Возврат СтрНайти(Имя, "ON_TRNACLGRPO") > 0
		ИЛИ СтрНайти(Имя, "ON_ETDGRPO") > 0;

КонецФункции

Функция ЭтоФорматЕТД(ИмяФайла)

	Возврат СтрНайти(ВРег(СокрЛП(ИмяФайла)), "ON_ETDGRPO") > 0;

КонецФункции

// Факты полной приёмки: приход Далиона даёт дату, титул 1 - адрес, массу и места.
// Состояние без замечаний, потому что «Получен» мы берём только при найденной
// приходной. Частичную приёмку и отказ программа не подписывает.
//
Функция ФактыПриёмкиГруза(Идентификатор, ДокументСБИС)

	Факты = Новый Структура;
	Факты.Вставить("ДатаПрибытия",   ТекущаяДатаСеанса());
	Факты.Вставить("ДатаУбытия",     ТекущаяДатаСеанса());
	Факты.Вставить("ДатаЗаявленная", ТекущаяДатаСеанса());
	Факты.Вставить("КоличествоМест", 1);
	Факты.Вставить("МассаБрутто",    1);
	Факты.Вставить("МассаНетто",     0);
	Факты.Вставить("АдресВыгрузки",  "");
	Факты.Вставить("СостояниеГруза",
		НСтр("ru = 'Груз принят без замечаний. Состояние груза, тары, упаковки, маркировки и опломбирования соответствует сопроводительным документам.'"));

	ДатаПрихода = Дата(1, 1, 1);
	АдресИзРеестра = "";

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_РеестрЭТрН.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
	МенеджерЗаписи.Прочитать();

	Если МенеджерЗаписи.Выбран() Тогда
		ДатаПрихода = МенеджерЗаписи.ДатаДокументаДалион;
		АдресИзРеестра = СокрЛП(МенеджерЗаписи.АдресДоставки);
	КонецЕсли;

	Груз = ЭАрМ_ОбщийМодульОбмен.ПолучитьГрузЭТрН(ДокументСБИС);

	Если ЗначениеЗаполнено(Груз.АдресДоставки) Тогда
		Факты.АдресВыгрузки = СокрЛП(Груз.АдресДоставки);
	Иначе
		Факты.АдресВыгрузки = АдресИзРеестра;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Факты.АдресВыгрузки) Тогда
		ВызватьИсключение НСтр(
			"ru = 'В ЭТрН нет адреса выгрузки, его некуда поставить в «Прием груза получателем».'");
	КонецЕсли;

	КоличествоМест = 0;
	МассаБрутто = 0;
	МассаНетто = 0;

	Для Каждого Позиция Из Груз.Позиции Цикл
		КоличествоМест = КоличествоМест + Позиция.КоличествоМест;
		МассаБрутто = МассаБрутто + Позиция.МассаБрутто;
		МассаНетто = МассаНетто + Позиция.МассаНетто;
	КонецЦикла;

	Если КоличествоМест = 0 И МассаБрутто = 0 Тогда
		ИтогиТоваров = ИтогиТоваровЭТрН(Идентификатор);
		КоличествоМест = ИтогиТоваров.КоличествоМест;
		МассаБрутто = ИтогиТоваров.МассаБрутто;
		МассаНетто = ИтогиТоваров.МассаНетто;
	КонецЕсли;

	Если КоличествоМест <= 0 Тогда
		КоличествоМест = 1;
	Иначе
		КоличествоМест = Цел(КоличествоМест);
	КонецЕсли;
	Если КоличествоМест > 9999 Тогда
		КоличествоМест = 9999;
	КонецЕсли;
	Если МассаБрутто <= 0 Тогда
		МассаБрутто = 1;
	КонецЕсли;

	Факты.КоличествоМест = КоличествоМест;
	Факты.МассаБрутто = МассаБрутто;
	Факты.МассаНетто = МассаНетто;

	ДатаПрибытия = ДатаПриёмкиПоФакту(ДатаПрихода);
	ДатаЗаявленная = ДатаИзСтрокиЭПД(Груз.ДоставитьДо);
	Если НЕ ЗначениеЗаполнено(ДатаЗаявленная) Тогда
		ДатаЗаявленная = ДатаПрибытия;
	КонецЕсли;

	Факты.ДатаПрибытия = ДатаПрибытия;
	Факты.ДатаЗаявленная = ДатаЗаявленная;
	Факты.ДатаУбытия = ДатаПрибытия + 15 * 60;

	Возврат Факты;

КонецФункции

Функция ИтогиТоваровЭТрН(Идентификатор)

	Итоги = Новый Структура("КоличествоМест, МассаБрутто, МассаНетто", 0, 0, 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Товары.КоличествоМест), 0) КАК КоличествоМест,
	|	ЕСТЬNULL(СУММА(Товары.МассаБрутто), 0) КАК МассаБрутто,
	|	ЕСТЬNULL(СУММА(Товары.МассаНетто), 0) КАК МассаНетто
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &Идентификатор
	|	И Товары.ИсточникТоваров = ""ЭТрН""";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Итоги.КоличествоМест = Выборка.КоличествоМест;
		Итоги.МассаБрутто = Выборка.МассаБрутто;
		Итоги.МассаНетто = Выборка.МассаНетто;
	КонецЕсли;

	Возврат Итоги;

КонецФункции

Функция ДатаПриёмкиПоФакту(ДатаПрихода)

	Сейчас = ТекущаяДатаСеанса();

	Если НЕ ЗначениеЗаполнено(ДатаПрихода) Тогда
		Возврат Сейчас;
	КонецЕсли;

	Если ДатаПрихода = НачалоДня(ДатаПрихода) Тогда
		Если НачалоДня(ДатаПрихода) = НачалоДня(Сейчас) Тогда
			Возврат Сейчас;
		КонецЕсли;
		Возврат ДатаПрихода + 10 * 60 * 60;
	КонецЕсли;

	Возврат ДатаПрихода;

КонецФункции

Функция ДатаИзСтрокиЭПД(ТекстДаты)

	ТекстДаты = СокрЛП(Строка(ТекстДаты));
	Если НЕ ЗначениеЗаполнено(ТекстДаты) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;

	ТекстДаты = СтрЗаменить(ТекстДаты, "T", " ");
	ТекстДаты = СтрЗаменить(ТекстДаты, "t", " ");

	ПозицияСмещения = СтрНайти(ТекстДаты, "+");
	Если ПозицияСмещения = 0 Тогда
		Для ИндексСимвола = 11 По СтрДлина(ТекстДаты) Цикл
			Если Сред(ТекстДаты, ИндексСимвола, 1) = "-" Тогда
				ПозицияСмещения = ИндексСимвола;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ПозицияСмещения > 0 Тогда
		ТекстДаты = СокрЛП(Лев(ТекстДаты, ПозицияСмещения - 1));
	КонецЕсли;

	Части = СтрРазделить(ТекстДаты, " ");
	Если Части.Количество() = 0 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;

	КускиДаты = СтрРазделить(Части[0], ".");
	Если КускиДаты.Количество() <> 3 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;

	Попытка
		Год = Число(КускиДаты[2]);
		Месяц = Число(КускиДаты[1]);
		День = Число(КускиДаты[0]);
		Час = 0;
		Минута = 0;
		Секунда = 0;
		Если Части.Количество() > 1 Тогда
			КускиВремени = СтрРазделить(Части[1], ":");
			Если КускиВремени.Количество() > 0 Тогда
				Час = Число(КускиВремени[0]);
			КонецЕсли;
			Если КускиВремени.Количество() > 1 Тогда
				Минута = Число(КускиВремени[1]);
			КонецЕсли;
			Если КускиВремени.Количество() > 2 Тогда
				Секунда = Число(КускиВремени[2]);
			КонецЕсли;
		КонецЕсли;
		Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

// Возвращает заполненный XML или Неопределено, если ПриемГрузГП уже был.
//
Функция ДозаполнитьПриемГрузаВXML(ДвоичныеДанные, ИмяФайла, ФактыПриёмки)

	ДокументDOM = ПрочитатьДокументDOM(ДвоичныеДанные);
	СодИнфГП = НайтиЭлементВДокументе(ДокументDOM, "СодИнфГП");

	Если СодИнфГП = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'В файле %1 нет узла СодИнфГП'"), ИмяФайла);
	КонецЕсли;

	ФорматЕТД = ЭтоФорматЕТД(ИмяФайла);
	ПриемГрузГП = НайтиЭлементПоИмени(СодИнфГП, "ПриемГрузГП");

	Если ПриемГрузаУжеЗаполнен(ПриемГрузГП, ФорматЕТД) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ФорматЕТД Тогда
		УстановитьАтрибутЕслиПусто(СодИнфГП, "СодОпер", "1");
	Иначе
		УстановитьАтрибутЕслиПусто(СодИнфГП, "СодОпПр",
			"Лицом, управомоченным на получение груза, при указанных обстоятельствах принят от перевозчика груз с указанными характеристиками");
	КонецЕсли;

	Если ПриемГрузГП = Неопределено Тогда
		ПриемГрузГП = СоздатьЭлементDOM(ДокументDOM, СодИнфГП, "ПриемГрузГП");
		ВставитьПередСлужебными(СодИнфГП, ПриемГрузГП);
	КонецЕсли;

	ЗаполнитьРеквизитыПриемаГруза(ДокументDOM, ПриемГрузГП, ФактыПриёмки, ФорматЕТД);

	Возврат ЗаписатьДокументDOM(ДокументDOM);

КонецФункции

Функция ПриемГрузаУжеЗаполнен(ПриемГрузГП, ФорматЕТД)

	Если ПриемГрузГП = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ФорматЕТД Тогда
		Возврат ЗначениеЗаполнено(ПриемГрузГП.ПолучитьАтрибут("ДатПриб"));
	КонецЕсли;

	Возврат ЗначениеЗаполнено(ПриемГрузГП.ПолучитьАтрибут("ФДатВрПриб"));

КонецФункции

Процедура ЗаполнитьРеквизитыПриемаГруза(ДокументDOM, ПриемГрузГП, ФактыПриёмки, ФорматЕТД)

	Если ФорматЕТД Тогда
		УстановитьАтрибутЕслиПусто(ПриемГрузГП, "ДатПриб", Формат(ФактыПриёмки.ДатаПрибытия, "ДФ=dd.MM.yyyy"));
	Иначе
		ДатаПрибытия = ДатаВремяЭПД(ФактыПриёмки.ДатаПрибытия);
		ДатаУбытия = ДатаВремяЭПД(ФактыПриёмки.ДатаУбытия);
		ДатаЗаявленная = ДатаВремяЭПД(ФактыПриёмки.ДатаЗаявленная);
		УстановитьАтрибутЕслиПусто(ПриемГрузГП, "ФДатВрПриб", ДатаПрибытия);
		УстановитьАтрибутЕслиПусто(ПриемГрузГП, "НалКоорТочВрФПр", "1");
		УстановитьАтрибутЕслиПусто(ПриемГрузГП, "ФДатВрУбыт", ДатаУбытия);
		УстановитьАтрибутЕслиПусто(ПриемГрузГП, "НалКоорТочВрФУб", "1");
		УстановитьАтрибутЕслиПусто(ПриемГрузГП, "ЗаявДатВрПриб", ДатаЗаявленная);
		УстановитьАтрибутЕслиПусто(ПриемГрузГП, "НалКоорТочВрЗПр", "1");
	КонецЕсли;

	УстановитьАтрибутЕслиПусто(ПриемГрузГП, "МетОпрМасс", "03");
	УстановитьАтрибутЕслиПусто(ПриемГрузГП, "КолМестПриемЧ", Формат(ФактыПриёмки.КоличествоМест, "ЧГ=0"));
	УстановитьАтрибутЕслиПусто(ПриемГрузГП, "ОбщСвСост", ФактыПриёмки.СостояниеГруза);
	УстановитьАтрибутЕслиПусто(ПриемГрузГП, "МасБрутЗначПрием", ЧислоДляXML(ФактыПриёмки.МассаБрутто, 3));

	Если ФактыПриёмки.МассаНетто > 0 Тогда
		УстановитьАтрибутЕслиПусто(ПриемГрузГП, "МасНетЗначПрием", ЧислоДляXML(ФактыПриёмки.МассаНетто, 3));
	КонецЕсли;

	АдрВыгруз = НайтиЭлементПоИмени(ПриемГрузГП, "АдрВыгруз");
	Если АдрВыгруз = Неопределено Тогда

		АдрВыгруз = СоздатьЭлементDOM(ДокументDOM, ПриемГрузГП, "АдрВыгруз");
		ПервыйУзел = ПриемГрузГП.ПервыйДочерний;
		Если ПервыйУзел = Неопределено Тогда
			ПриемГрузГП.ДобавитьДочерний(АдрВыгруз);
		Иначе
			ПриемГрузГП.ВставитьПеред(АдрВыгруз, ПервыйУзел);
		КонецЕсли;

	КонецЕсли;

	Если НайтиЭлементПоИмени(АдрВыгруз, "АдресИнф") = Неопределено
		И НайтиЭлементПоИмени(АдрВыгруз, "АдресРФ") = Неопределено Тогда

		АдресИнф = СоздатьЭлементDOM(ДокументDOM, АдрВыгруз, "АдресИнф");
		АдрВыгруз.ДобавитьДочерний(АдресИнф);
		АдресИнф.УстановитьАтрибут("КодСтр", "643");
		АдресИнф.УстановитьАтрибут("АдрТекст", Лев(ФактыПриёмки.АдресВыгрузки, 1000));

	КонецЕсли;

КонецПроцедуры

Функция ДатаВремяЭПД(ДатаВремя)

	Смещение = 3 * 3600;
	Попытка
		Смещение = ДатаВремя - УниверсальноеВремя(ДатаВремя);
	Исключение
		Смещение = 3 * 3600;
	КонецПопытки;

	Знак = "+";
	Если Смещение < 0 Тогда
		Знак = "-";
		Смещение = -Смещение;
	КонецЕсли;

	Часы = Цел(Смещение / 3600);
	Минуты = Цел((Смещение - Часы * 3600) / 60);

	Возврат Формат(ДатаВремя, "ДФ=dd.MM.yyyy") + "T"
		+ Формат(ДатаВремя, "ДФ=HH:mm:ss")
		+ Знак + Формат(Часы, "ЧЦ=2; ЧВН=; ЧН=00; ЧГ=0")
		+ ":" + Формат(Минуты, "ЧЦ=2; ЧВН=; ЧН=00; ЧГ=0");

КонецФункции

Функция ЧислоДляXML(Значение, ЗнаковПослеЗапятой)

	Возврат Формат(Значение, СтрШаблон("ЧРД=.; ЧН=0; ЧГ=0; ЧДЦ=%1", ЗнаковПослеЗапятой));

КонецФункции

Функция ПрочитатьДокументDOM(ДвоичныеДанные)

	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанные.Записать(ИмяФайла);

	ЧтениеXML = Новый ЧтениеXML;
	Попытка
		ЧтениеXML.ОткрытьФайл(ИмяФайла);
		Построитель = Новый ПостроительDOM;
		ДокументDOM = Построитель.Прочитать(ЧтениеXML);
		ЧтениеXML.Закрыть();
	Исключение
		ЧтениеXML.Закрыть();
		УдалитьФайлы(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьФайлы(ИмяФайла);

	Возврат ДокументDOM;

КонецФункции

Функция ЗаписатьДокументDOM(ДокументDOM)

	Кодировка = СокрЛП(ДокументDOM.КодировкаXML);
	Если НЕ ЗначениеЗаполнено(Кодировка) Тогда
		Кодировка = "windows-1251";
	КонецЕсли;

	ИмяФайла = ПолучитьИмяВременногоФайла("xml");

	ЗаписьXML = Новый ЗаписьXML;
	Попытка
		ЗаписьXML.ОткрытьФайл(ИмяФайла, Кодировка);
		ЗаписьDOM = Новый ЗаписьDOM;
		ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
		ЗаписьXML.Закрыть();
	Исключение
		ЗаписьXML.Закрыть();
		УдалитьФайлы(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;

	ДанныеФайла = Новый ДвоичныеДанные(ИмяФайла);
	УдалитьФайлы(ИмяФайла);

	Возврат ДанныеФайла;

КонецФункции

Функция НайтиЭлементВДокументе(ДокументDOM, ИмяЭлемента)

	Для Каждого Элемент Из ДокументDOM.ПолучитьЭлементыПоИмени(ИмяЭлемента) Цикл
		Возврат Элемент;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция НайтиЭлементПоИмени(Родитель, ИмяЭлемента)

	Если Родитель = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Искомое = ВРег(ИмяЭлемента);

	Для Каждого Узел Из Родитель.ДочерниеУзлы Цикл
		Если Узел.ТипУзла = ТипУзлаDOM.Элемент
			И ВРег(Узел.ЛокальноеИмя) = Искомое Тогда
			Возврат Узел;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция СоздатьЭлементDOM(ДокументDOM, Родитель, ИмяЭлемента)

	URI = Родитель.URIПространстваИмен;
	Если ЗначениеЗаполнено(URI) Тогда
		Возврат ДокументDOM.СоздатьЭлементНС(URI, ИмяЭлемента);
	КонецЕсли;

	Возврат ДокументDOM.СоздатьЭлемент(ИмяЭлемента);

КонецФункции

Процедура ВставитьПередСлужебными(Родитель, НовыйЭлемент)

	Якорь = Неопределено;

	Для Каждого Узел Из Родитель.ДочерниеУзлы Цикл
		Если Узел.ТипУзла <> ТипУзлаDOM.Элемент Тогда
			Продолжить;
		КонецЕсли;
		Имя = ВРег(Узел.ЛокальноеИмя);
		Если Имя = "ОТМЕТГП" ИЛИ Имя = "ИНФПОЛ" Тогда
			Якорь = Узел;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Якорь = Неопределено Тогда
		Родитель.ДобавитьДочерний(НовыйЭлемент);
	Иначе
		Родитель.ВставитьПеред(НовыйЭлемент, Якорь);
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьАтрибутЕслиПусто(Элемент, ИмяАтрибута, ЗначениеАтрибута)

	Если ЗначениеЗаполнено(Элемент.ПолучитьАтрибут(ИмяАтрибута)) Тогда
		Возврат;
	КонецЕсли;

	Элемент.УстановитьАтрибут(ИмяАтрибута, Строка(ЗначениеАтрибута));

КонецПроцедуры

// Base64 одной строкой: переносы внутри значения СБИС не ждёт.
//
Функция Base64БезПереносов(ДвоичныеДанные)

	Текст = Base64Строка(ДвоичныеДанные);
	Текст = СтрЗаменить(Текст, Символы.ВК, "");
	Текст = СтрЗаменить(Текст, Символы.ПС, "");

	Возврат Текст;

КонецФункции

#КонецОбласти
