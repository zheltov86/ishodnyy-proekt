////////////////////////////////////////////////////////////////////////////////
// Компания ООО «Универсам Сегодня»
// ЭАрМ_ОбработкаПодтвержденийЭДО: подтверждения, очередь на подписание в СБИС
// и разбор ответов Далиона.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// >>> НАЧАЛО — Точка входа для регламентного задания <<<
// Вызывать эту процедуру из регламентного задания.
//
//
// Папка читается первой, и каждый шаг - под своей Попыткой. Раньше шаги шли
// подряд без защиты, и перед чтением папки стояла проверка подписей в СБИС:
// СБИС не ответил или упал один документ - задание обрывалось, а файлы
// Далиона так и лежали в папке непрочитанными.
//
Процедура ЭАрМ_Вызов() Экспорт

	Если ЭАрМ_НастройкиСервер.ФоновыеЗаданияОтключены() Тогда
		Возврат;
	КонецЕсли;

	// Полный разбор ответа обновляет и реестр ЭТрН, и регистр подтверждений.
	// Сокращённая ПроверитьПапкуОбмена() архивировала файл до записи в реестр ЭТрН.
	Попытка
		ЭАрМ_РегламентныйОбменЭДО.ЗабратьОтветыДалион();
	Исключение
		ЗаписатьСбойШагаЗадания("Ответы Далиона из папки", ИнформацияОбОшибке());
	КонецПопытки;

	// Приходные накладные Далиона (result_receipts_*.json) - раньше их читали
	// только кнопки реестра УПД, и без открытой формы они висели в папке
	Попытка
		ЭАрМ_РегламентныйОбменЭДО.ПрочитатьПриходныеНакладныеИзПапки();
	Исключение
		ЗаписатьСбойШагаЗадания("Приходные накладные из папки", ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		ОбработатьВходящиеЭТрНИзРегистра();
	Исключение
		ЗаписатьСбойШагаЗадания("Досыл ЭТрН в Далион", ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		ПовторитьНеудачныеОтправки();
	Исключение
		ЗаписатьСбойШагаЗадания("Повтор неудачных отправок", ИнформацияОбОшибке());
	КонецПопытки;

	// Настройка «Автоотправка УПД» (по умолчанию выключена): сошедшиеся УПД
	// и УКД - в «К отправке» и в очередь с отметкой «Отправить», пачкой
	Попытка
		АвтоотправкаГотовыхУПД();
	Исключение
		ЗаписатьСбойШагаЗадания("Автоотправка УПД", ИнформацияОбОшибке());
	КонецПопытки;

	// Очередь «Ожидают отправки» -> СБИС отправляет своё регламентное задание
	// ЭАрМ_ОтправкаОчередиСБИС (интервал выбирается в форме очереди, по
	// умолчанию 5 минут) и запуск сразу после постановки в очередь. Здесь -
	// только проверка, что у задания есть расписание
	Попытка
		ПроверитьРасписаниеОтправкиОчереди();
	Исключение
		ЗаписатьСбойШагаЗадания("Расписание отправки очереди", ИнформацияОбОшибке());
	КонецПопытки;

	// Регламенты обмена с БП (применение статусов монитора, сверка с БП): в новой
	// базе расписание пустое - ставим 5 минут и 3 часа
	Попытка
		ЭАрМ_СтатусыМонитора.ПроверитьРасписания();
	Исключение
		ЗаписатьСбойШагаЗадания("Расписание регламентов монитора", ИнформацияОбОшибке());
	КонецПопытки;

	// Документы, которым утверждение уже ушло: спрашиваем СБИС, видна ли подпись.
	// В конце: это походы в СБИС, и их сбой не должен мешать чтению папки.
	// При флажке «Автоотправка» то же после каждой отправки делает задание
	// ЭАрМ_ОтправкаОчередиСБИС, и два задания опрашивали СБИС по одним
	// документам. Без флажка задание очереди выключено - тогда проверяем здесь
	Если ЭАрМ_НастройкиСервер.ЗначениеНастройки("АвтоотправкаУПД") <> Истина Тогда
		Попытка
			ПроверитьПодписиВОчереди("", Истина);
		Исключение
			ЗаписатьСбойШагаЗадания("Проверка подписей в СБИС", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	// Без этого шага документ, на который Далион не ответил, остаётся
	// в статусе "Ожидает" до бесконечности
	Попытка
		СверитьСДалион();
	Исключение
		ЗаписатьСбойШагаЗадания("Сверка с Далион", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры
// >>> КОНЕЦ — Точка входа <<<

// Ставит входящий ЭДО-документ в очередь на подтверждение в другую базу.
// Саму отправку выполняет регламентное задание, см. ПовторитьНеудачныеОтправки.
//
Процедура ОтправитьНаПодтверждение(ЭлектронныйДокумент) Экспорт

	// Проверка заполненности обязательных реквизитов
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭлектронныйДокумент,
		"Организация, Контрагент, ДатаАннулирования, ВидДокумента");

	Если НЕ ЗначениеЗаполнено(Реквизиты.Организация)
		ИЛИ НЕ ЗначениеЗаполнено(Реквизиты.Контрагент) Тогда
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'АРМ_ЭдоОбмен.ОтправитьНаПодтверждение'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Предупреждение, , ЭлектронныйДокумент,
			НСтр("ru = 'Не заполнены обязательные реквизиты (Организация или Контрагент)'"));
		Возврат;
	КонецЕсли;

	// Проверка: документ не аннулирован
	Если ЗначениеЗаполнено(Реквизиты.ДатаАннулирования) Тогда
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'АРМ_ЭдоОбмен.ОтправитьНаПодтверждение'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Предупреждение, , ЭлектронныйДокумент,
			НСтр("ru = 'Документ аннулирован, отправка на подтверждение невозможна'"));
		Возврат;
	КонецЕсли;

	// Проверка для ЭТрН: наличие связанного документа
	ТипДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		Реквизиты.ВидДокумента, "ТипДокумента");
	Если ТипДокумента = Перечисления.ТипыДокументовЭДО.ЭТрН Тогда
		Если НЕ СвязанныйЭТрННайден(ЭлектронныйДокумент) Тогда
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'АРМ_ЭдоОбмен.ОтправитьНаПодтверждение'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Предупреждение, , ЭлектронныйДокумент,
				НСтр("ru = 'Не найден документ ЭлектроннаяТранспортнаяНакладная'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Попытка
		ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор);

		// Сюда приходят из подписки на запись стандартного регистра состояний
		// ЭДО, то есть внутри чужой транзакции записи. Отправка по сети здесь
		// держала эту транзакцию и её блокировки, пока другая база не ответит,
		// а у веб-сервиса не было таймаута: зависший сервис вешал обмен ЭДО.
		// Теперь строка только встаёт в очередь, отправляет регламентное
		// задание (ПовторитьНеудачныеОтправки) - успех так же даёт «Ожидает»
		ЗаписатьСтатусОжидания(ЭлектронныйДокумент, ИдентификаторЗапроса,
			Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОжидаетПовторнойОтправки,
			НСтр("ru = 'Ждёт отправки в другую базу регламентным заданием'"));

	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'АРМ_ЭдоОбмен.ОтправитьНаПодтверждение'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , ЭлектронныйДокумент,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Обрабатывает ответ-подтверждение от другой базы.
//
Процедура ОбработатьОтветПодтверждения(ИдентификаторЗапроса, Подтверждено, Комментарий = "") Экспорт

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.ЭлектронныйДокумент КАК ЭлектронныйДокумент
		|ИЗ
		|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
		|ГДЕ
		|	Т.ИдентификаторЗапроса = &ИдентификаторЗапроса
		|	И Т.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает)";
		Запрос.УстановитьПараметр("ИдентификаторЗапроса", ИдентификаторЗапроса);

		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'АРМ_ЭдоОбмен.ОбработатьОтветПодтверждения'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Предупреждение, , ,
				СтрШаблон(НСтр("ru = 'Не найдена запись ожидания для идентификатора %1'"),
					ИдентификаторЗапроса));
			Возврат;
		КонецЕсли;

		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ЭлектронныйДокумент = Выборка.ЭлектронныйДокумент;

		НовыйСтатус = ?(Подтверждено,
			Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено,
			Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Отклонено);

		ЗаписатьСтатусОжидания(ЭлектронныйДокумент, ИдентификаторЗапроса,
			НовыйСтатус, Комментарий);

		// Подписание и отправка только для ЭДО-документов
		Если Подтверждено Тогда
			Попытка
				ПодписатьИОтправитьПослеПодтверждения(ЭлектронныйДокумент);
			Исключение
				// Для не-ЭДО документов (ЗаказКлиента и т.п.) — подписание не требуется
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'АРМ_ЭдоОбмен.ОбработатьОтветПодтверждения'",
						ОбщегоНазначения.КодОсновногоЯзыка()),
					УровеньЖурналаРегистрации.Информация, , ЭлектронныйДокумент,
					НСтр("ru = 'Документ не является ЭДО, подписание пропущено'"));
			КонецПопытки;
		КонецЕсли;

	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'АРМ_ЭдоОбмен.ОбработатьОтветПодтверждения'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Запускает утверждение, подписание и отправку электронного документа.
//
Процедура ПодписатьИОтправитьПослеПодтверждения(ЭлектронныйДокумент) Экспорт

	Попытка
		НаборДействий = ЭлектронныеДокументыЭДОКлиентСервер.НовыйНаборДействийПоЭДО();
		ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий,
			Перечисления.ДействияПоЭДО.Утвердить);
		ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий,
			Перечисления.ДействияПоЭДО.Подписать);
		ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий,
			Перечисления.ДействияПоЭДО.ПодготовитьКОтправке);
		ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий,
			Перечисления.ДействияПоЭДО.Отправить);

		ПараметрыВыполнения = ЭлектронныеДокументыЭДОКлиентСервер.НовыеПараметрыВыполненияДействийПоЭДО();
		ПараметрыВыполнения.НаборДействий = НаборДействий;
		ПараметрыВыполнения.ОбъектыДействий.ЭлектронныеДокументы.Добавить(ЭлектронныйДокумент);

		ЭлектронныеДокументыЭДО.ВыполнитьДействияПоИнтеграциямЭДО(ПараметрыВыполнения);

		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'АРМ_ЭдоОбмен.ПодписаниеИОтправка'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Информация, , ЭлектронныйДокумент,
			НСтр("ru = 'Документ утвержден, подписан и отправлен'"));

	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'АРМ_ЭдоОбмен.ПодписаниеИОтправка'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , ЭлектронныйДокумент,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Записывает статус ожидания подтверждения в регистр сведений.
//
Процедура ЗаписатьСтатусОжидания(ЭлектронныйДокумент, ИдентификаторЗапроса, Статус, Комментарий = "") Экспорт

	Попытка
		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЭлектронныйДокумент = ЭлектронныйДокумент;
		МенеджерЗаписи.ИдентификаторЗапроса = ИдентификаторЗапроса;
		// Без чтения ответ затирал дату отправки, а повторная отправка - дату ответа
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.ЭлектронныйДокумент = ЭлектронныйДокумент;
		МенеджерЗаписи.ИдентификаторЗапроса = ИдентификаторЗапроса;
		МенеджерЗаписи.Статус = Статус;
		МенеджерЗаписи.Комментарий = Комментарий;

		Если Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает Тогда
			МенеджерЗаписи.ДатаОтправки = ТекущаяДатаСеанса();
		Иначе
			МенеджерЗаписи.ДатаОтвета = ТекущаяДатаСеанса();
		КонецЕсли;

		МенеджерЗаписи.Записать(Истина);

	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'АРМ_ЭдоОбмен.ЗаписатьСтатусОжидания'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , ЭлектронныйДокумент,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Получает текущий статус документа из регистра.
//
//@skip-check doc-comment-export-function-return-section
Функция ПолучитьТекущийСтатус(ЭлектронныйДокумент) Экспорт

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
		|ГДЕ
		|	Т.ЭлектронныйДокумент = &ЭлектронныйДокумент
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаОтправки УБЫВ";
		Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокумент);

		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
			Возврат Неопределено;
		КонецЕсли;

		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Статус;

	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'АРМ_ЭдоОбмен.ПолучитьТекущийСтатус'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , ЭлектронныйДокумент,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Переносит в очередь ЭАрМ_ОжидаемыеПодтвержденияЭДО ЭТрН, УПД и УКД
// с отметкой «К отправке». Повторно уже лежащие в очереди документы не плодит.
// Новой строке флажок «Отправить» не ставит: в пачку она попадёт только после
// отметки в очереди.
//
// Возвращаемое значение:
//   Строка - сколько документов добавлено и обновлено
//
Функция СобратьГотовыеКОтправке() Экспорт

	Добавлено = 0;
	Обновлено = 0;

	ПеренестиЭТрНВОчередь(Добавлено, Обновлено);
	ПеренестиУПДВОчередь(Добавлено, Обновлено);
	ПеренестиУКДВОчередь(Добавлено, Обновлено);
	ПеренестиСвязанныеПоЦепочке(Добавлено, Обновлено);
	ПеренестиОтправленныеМимоОчереди(Добавлено);
	УбратьДублиОчереди();
	ДозаполнитьМагазинОчереди();

	// Отправленное кнопками реестров - в статусы очереди
	Обновлено = Обновлено + СинхронизироватьОчередьСРеестрами();

	Текст = СтрШаблон(НСтр("ru = 'В очередь готовых к отправке: добавлено %1, обновлено %2.'"),
		Добавлено, Обновлено);

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ОчередьЭДО", Истина, Текст);

	// Попало в очередь - сразу в СБИС (если отправка с сервера настроена)
	ЗапуститьОтправкуОчередиВФоне();

	Возврат Текст;

КонецФункции

// Документы очереди с отметкой «Отправить» для подписания в СБИС.
//
// Отбор тот же, что и у простановки отметки: уже отправленное и подписанное
// в пачку не попадает. Иначе отметка, оставшаяся от прошлого раза, ушла бы
// в СБИС ещё раз и вернулась ошибкой «нет этапа с действием».
//
// Параметры:
//   ОтборРеестра     - Строка - "ЭТрН", "УПД" или "УКД"; пустая - все реестры
//   ТолькоОтмеченные - Булево - Ложь отдаёт всё, что вообще можно отправить,
//                      не глядя на флажок: так работает «Отправить все ЭТрН»,
//                      которой нужно показать список до простановки отметок
//
// Возвращаемое значение:
//   Массив из Структура - Реестр, ИдентификаторСБИС, ИдентификаторЗапроса,
//     Номер, Контрагент
//
Функция ДокументыКПодписанию(Знач ОтборРеестра = "", Знач ТолькоОтмеченные = Истина) Экспорт

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Реестр КАК Реестр,
	|	Очередь.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
	|	Очередь.Номер КАК Номер,
	|	Очередь.Контрагент КАК Контрагент
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	(&ТолькоОтмеченные = ЛОЖЬ ИЛИ Очередь.Отправить)
	|	И Очередь.ИдентификаторСБИС <> """"
	|	И Очередь.Реестр <> """"
	|	И (&ОтборРеестра = """" ИЛИ Очередь.Реестр = &ОтборРеестра)
	|	И Очередь.Статус В (
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ПустаяСсылка))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.ДатаДокумента,
	|	Очередь.Номер";
	Запрос.УстановитьПараметр("ОтборРеестра", ОтборРеестра);
	Запрос.УстановитьПараметр("ТолькоОтмеченные", ТолькоОтмеченные);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура(
			"Реестр, ИдентификаторСБИС, ИдентификаторЗапроса, Номер, Контрагент",
			Выборка.Реестр, Выборка.ИдентификаторСБИС, Выборка.ИдентификаторЗапроса,
			Выборка.Номер, Выборка.Контрагент));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Очередь подписания в СБИС для таблицы формы.
//
// Форма показывает не динамический список, а таблицу значений: динамический
// список в 1С не редактируется, и флажок «Отправить» в нём нажать нельзя.
//
// Берутся только строки очереди СБИС: подтверждения из Далиона живут в том же
// регистре, но реестр у них не заполнен и человеку здесь не нужны. Сверху -
// отмеченные к отправке, затем ещё не ушедшие, затем отправленные: свежие
// по колонке «Отправлено» выше. Пустая дата отправки не всплывает наверх.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки как у реквизита формы «Очередь», плюс
//     * МожноОтправлять - Булево - отметку ставить можно. Отправленному
//       и подписанному документу отметка запрещена: подписывать в нём нечего,
//       СБИС на повторную отправку отвечает «нет этапа с действием»
//
// Параметры:
//   ТолькоМожноОтправлять - Булево - только то, что ещё можно отправить
//     («Готов к отправке», «Ошибка отправки», без статуса). Отбор в запросе:
//     история очереди растёт, и выгружать её целиком на каждое обновление
//     формы было долго
//
Функция ОчередьПодписания(ТолькоМожноОтправлять = Ложь) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Отправить КАК Отправить,
	|	Очередь.Статус КАК Статус,
	|	Очередь.Реестр КАК Реестр,
	|	Очередь.Номер КАК Номер,
	|	Очередь.ДатаДокумента КАК ДатаДокумента,
	|	Очередь.Контрагент КАК Контрагент,
	|	Очередь.Магазин КАК Магазин,
	|	Очередь.ДатаОтправки КАК ДатаОтправки,
	|	Очередь.ДатаОтвета КАК ДатаОтвета,
	|	Очередь.Комментарий КАК Комментарий,
	|	Очередь.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
	|	ВЫБОР
	|		КОГДА Очередь.Статус В (
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке),
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки),
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ПустаяСсылка))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК МожноОтправлять,
	|	Очередь.Бухгалтерия КАК Бухгалтерия
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.Реестр <> """"
	|	И (НЕ &ТолькоМожноОтправлять
	|		ИЛИ Очередь.Статус В (
	|			ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке),
	|			ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки),
	|			ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ПустаяСсылка)))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Отправить УБЫВ,
	|	ВЫБОР
	|		КОГДА ДатаОтправки = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ,
	|	ДатаОтправки УБЫВ,
	|	ДатаДокумента УБЫВ,
	|	Номер";
	Запрос.УстановитьПараметр("ТолькоМожноОтправлять", ТолькоМожноОтправлять = Истина);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Короткая сводка по очереди подписания для шапки формы.
//
// Считаются только строки очереди СБИС (у них заполнен Реестр): подтверждения
// из Далиона живут в том же регистре, но к подписанию отношения не имеют.
//
// Возвращаемое значение:
//   Строка - строка вида «Всего 12 · к отправке 5 · на подписи 4 · подписано 3»
//
Функция ИтогиОчереди() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(1) КАК Всего,
	|	СУММА(ВЫБОР
	|			КОГДА Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КОтправке,
	|	СУММА(ВЫБОР
	|			КОГДА Очередь.Статус В (
	|					ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОтправленНаПодпись),
	|					ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает))
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК НаПодписи,
	|	СУММА(ВЫБОР
	|			КОГДА Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Подписано,
	|	СУММА(ВЫБОР
	|			КОГДА Очередь.Статус В (
	|					ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки),
	|					ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Отклонено))
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СОшибкой,
	|	СУММА(ВЫБОР
	|			КОГДА Очередь.Отправить
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Отмечено
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.Реестр <> """"";

	Выборка = Запрос.Выполнить().Выбрать();

	Если НЕ Выборка.Следующий() ИЛИ Выборка.Всего = 0 Тогда
		Возврат НСтр("ru = 'Очередь пуста. Нажмите обновление — собрать готовые УПД, ЭТрН и УКД.'");
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = 'Всего %1'"), Выборка.Всего));
	Части.Добавить(СтрШаблон(НСтр("ru = 'к отправке %1'"), Выборка.КОтправке));
	Части.Добавить(СтрШаблон(НСтр("ru = 'на подписи %1'"), Выборка.НаПодписи));
	Части.Добавить(СтрШаблон(НСтр("ru = 'подписано %1'"), Выборка.Подписано));

	Если Выборка.СОшибкой > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'с ошибкой %1'"), Выборка.СОшибкой));
	КонецЕсли;

	Части.Добавить(СтрШаблон(НСтр("ru = 'отмечено к отправке %1'"), Выборка.Отмечено));

	Возврат СтрСоединить(Части, " · ");

КонецФункции

// Проставляет или снимает отметку «Отправить» по всей очереди.
//
// Отмечать можно только то, что ещё не ушло: подтверждённому и уже
// отправленному документу отметка ни к чему. Снимать её можно с любой строки.
//
// Параметры:
//   Отправить    - Булево - что проставить
//   ОтборРеестра - Строка - "ЭТрН", "УПД" или "УКД"; пустая - все реестры
//
Процедура УстановитьОтметкиОтправки(Отправить, Знач ОтборРеестра = "") Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.Отправить <> &Отправить
	|	И (&ОтборРеестра = """" ИЛИ Очередь.Реестр = &ОтборРеестра)";

	Если Отправить Тогда
		// Отправлять заново нечего: подписывать в таком документе нечего,
		// а СБИС на повторную отправку отвечает «нет этапа с действием»
		Запрос.Текст = Запрос.Текст + "
		|	И Очередь.Статус В (
		|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке),
		|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки),
		|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ПустаяСсылка))";
	КонецЕсли;

	Запрос.УстановитьПараметр("Отправить", Отправить);
	Запрос.УстановитьПараметр("ОтборРеестра", ОтборРеестра);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаписатьОтметкуОтправки(Выборка.ИдентификаторЗапроса, Отправить, Выборка.ЭлектронныйДокумент);
	КонецЦикла;

КонецПроцедуры

// Ручная смена статуса строк очереди СБИС (кнопка «Сменить статус»).
//
// «Готовы к отправке» - документ заново берут регламент и автоотправка
// (ДокументыДляАвтоотправки): сбрасываются даты отправки и ответа, счётчик
// повторов и признак робота. Если подписи в СБИС нет, в реестре снимается
// «Утверждено» (статус «Утвержден» - в «Готов к утверждению»): иначе
// СинхронизироватьОчередьСРеестрами вернула бы строку в «Отправлен на
// подпись». Подписанный документ заново не отправляется - строка остаётся
// как была, причина - в итоге.
// Флажок «Отправить» не ставится.
//
// Параметры:
//   ИдентификаторыЗапросов - Массив из Строка - строки очереди
//   НовыйСтатус            - ПеречислениеСсылка.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО
//
// Возвращаемое значение:
//   Структура - Изменено (Число), Пропущено (Массив из Строка - почему), ИдентификаторыСБИС (Массив)
//
Функция ИзменитьСтатусСтрокОчереди(ИдентификаторыЗапросов, НовыйСтатус) Экспорт

	Результат = Новый Структура("Изменено, Пропущено, ИдентификаторыСБИС", 0, Новый Массив, Новый Массив);
	Статусы = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО;
	Заново = (НовыйСтатус = Статусы.ГотовКОтправке);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
	|	Очередь.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Очередь.Реестр КАК Реестр,
	|	Очередь.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторЗапроса В (&Идентификаторы)
	|	И Очередь.Реестр <> """"";
	Запрос.УстановитьПараметр("Идентификаторы", ИдентификаторыЗапросов);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Представление = СтрШаблон("%1 %2", СокрЛП(Выборка.Реестр), СокрЛП(Выборка.Номер));

		НачатьТранзакцию();
		Попытка

			Если Заново Тогда
				Причина = СброситьУтверждениеВРеестре(Выборка.Реестр, Выборка.ИдентификаторСБИС);
				Если ЗначениеЗаполнено(Причина) Тогда
					ОтменитьТранзакцию();
					Результат.Пропущено.Добавить(СтрШаблон("%1: %2", Представление, Причина));
					Продолжить;
				КонецЕсли;
			КонецЕсли;

			МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ЭлектронныйДокумент  = Выборка.ЭлектронныйДокумент;
			МенеджерЗаписи.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
			МенеджерЗаписи.Прочитать();
			Если НЕ МенеджерЗаписи.Выбран() Тогда
				ОтменитьТранзакцию();
				Продолжить;
			КонецЕсли;

			МенеджерЗаписи.Статус = НовыйСтатус;
			Если Заново Тогда
				МенеджерЗаписи.ДатаОтправки     = Дата(1, 1, 1);
				МенеджерЗаписи.ДатаОтвета       = Дата(1, 1, 1);
				МенеджерЗаписи.ПопытокПовтора   = 0;
				МенеджерЗаписи.СледующаяПопытка = Дата(1, 1, 1);
				МенеджерЗаписи.ПодписаноРоботом = Ложь;
				МенеджерЗаписи.НеНайденоПодряд  = 0;
				МенеджерЗаписи.ПроверитьПосле   = Дата(1, 1, 1);
			КонецЕсли;
			МенеджерЗаписи.Комментарий = Лев(СтрШаблон(НСтр("ru = 'Статус «%1» поставлен вручную (%2, %3)%4'"),
				НовыйСтатус, Строка(ПользователиИнформационнойБазы.ТекущийПользователь()),
				Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"),
				?(Заново, НСтр("ru = ' - документ отправится заново'"), "")), 500);
			МенеджерЗаписи.Записать();

			ЗафиксироватьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			Результат.Пропущено.Добавить(СтрШаблон("%1: %2", Представление,
				ЭАрМ_Служебный.КраткийТекстОшибки(ИнформацияОбОшибке())));
			Продолжить;
		КонецПопытки;

		Результат.Изменено = Результат.Изменено + 1;
		Результат.ИдентификаторыСБИС.Добавить(СокрЛП(Выборка.ИдентификаторСБИС));
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС, "ОчередьЭДО", Истина,
			СтрШаблон(НСтр("ru = '%1: статус очереди вручную - «%2»'"), Представление, НовыйСтатус));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Снимает в реестре отметку «Утверждено», чтобы документ ушёл заново.
//
// Возвращаемое значение:
//   Строка - почему отправить заново нельзя (подписан в СБИС); пустая - можно
//
Функция СброситьУтверждениеВРеестре(Реестр, ИдентификаторСБИС)

	ИмяРегистра = ИмяРегистраРеестра(Реестр, ИдентификаторСБИС);

	ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра("РегистрСведений." + ИмяРегистра, ИдентификаторСБИС);

	МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторСБИС;
	МенеджерЗаписи.Прочитать();
	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат "";
	КонецЕсли;

	Если МенеджерЗаписи.Подписано
		ИЛИ МенеджерЗаписи.СтатусПодписания = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.Подписан
		ИЛИ ДокументУжеПодписанВСбис(МенеджерЗаписи.Состояние) Тогда
		Возврат НСтр("ru = 'документ уже подписан в СБИС - отправлять заново нечего'");
	КонецЕсли;

	Изменено = Ложь;
	Если МенеджерЗаписи.Утверждено Тогда
		МенеджерЗаписи.Утверждено = Ложь;
		Изменено = Истина;
	КонецЕсли;
	Если МенеджерЗаписи.СтатусПодписания = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.Утвержден Тогда
		МенеджерЗаписи.СтатусПодписания = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ГотовКОтправке;
		Изменено = Истина;
	КонецЕсли;
	Если Изменено Тогда
		МенеджерЗаписи.Записать(Истина);
	КонецЕсли;

	Возврат "";

КонецФункции

Процедура ЗаписатьОтметкуОтправки(ИдентификаторЗапроса, Отправить, ЭлектронныйДокумент = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторЗапроса = &ИдентификаторЗапроса";
	Запрос.УстановитьПараметр("ИдентификаторЗапроса", ИдентификаторЗапроса);

	Если ЭлектронныйДокумент <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Очередь.ЭлектронныйДокумент = &ЭлектронныйДокумент";
		Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокумент);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ЭлектронныйДокумент = Выборка.ЭлектронныйДокумент;
	МенеджерЗаписи.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
	МенеджерЗаписи.Прочитать();
	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.Отправить = Отправить;
	МенеджерЗаписи.Записать();

КонецПроцедуры

// Отмечает в очереди, чем закончилась отправка подписей в СБИС.
//
// Признак успеха передаётся явно: раньше он вычитывался из текста отчёта,
// а в отчёт входит сырой ответ сервера - слово «Ошибка:» внутри ответа
// записывало удачную отправку в неудачные.
//
// Параметры:
//   ИдентификаторЗапроса - Строка - строка очереди
//   Успех                - Булево - СБИС принял действие
//   ОтветСБИС            - Строка - отчёт; при неудаче ложится в комментарий
//
Процедура ОтметитьПослеОтправкиСБИС(ИдентификаторЗапроса, Успех, ОтветСБИС) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторЗапроса = &ИдентификаторЗапроса";
	Запрос.УстановитьПараметр("ИдентификаторЗапроса", ИдентификаторЗапроса);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ЭлектронныйДокумент = Выборка.ЭлектронныйДокумент;
	МенеджерЗаписи.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
	МенеджерЗаписи.Прочитать();
	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	Если Успех Тогда
		// «Отправлен на подпись», а не «Подтверждено»: СБИС принял действие,
		// но подпись в его состоянии появляется позже. Зелёным строка станет,
		// когда подпись увидит ПроверитьПодписиВОчереди
		МенеджерЗаписи.Отправить = Ложь;
		МенеджерЗаписи.ДатаОтправки = ТекущаяДатаСеанса();
		МенеджерЗаписи.Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОтправленНаПодпись;
		МенеджерЗаписи.Комментарий = Лев(
			НСтр("ru = 'Утверждение отправлено, ждём подпись в СБИС'"), 500);
		// Строку, на которой робот споткнулся, подписал человек из очереди
		МенеджерЗаписи.ПодписаноРоботом = Ложь;
		МенеджерЗаписи.ПопытокПовтора = 0;
		МенеджерЗаписи.СледующаяПопытка = Дата(1, 1, 1);
		МенеджерЗаписи.НеНайденоПодряд = 0;
		МенеджерЗаписи.ПроверитьПосле = Дата(1, 1, 1);
	Иначе
		// Повторная отправка через время: автоотправка берёт строку «Ошибка
		// отправки» снова, когда наступит СледующаяПопытка (5, 10, 20... минут,
		// не больше 6 часов), до МаксимумПопытокПовтора() раз. Дальше - только
		// кнопкой, после исправления причины
		ОтметитьОшибкуОтправкиСПовтором(МенеджерЗаписи, ОтветСБИС);
	КонецЕсли;

	МенеджерЗаписи.Записать();

	ЭАрМ_ПриемПакетовДалион.Трасса(ИдентификаторЗапроса, СтрШаблон(
		"СБИС: строка очереди %1 записана - статус «%2», следующая попытка %3, комментарий: %4",
		ИдентификаторЗапроса, МенеджерЗаписи.Статус, Формат(МенеджерЗаписи.СледующаяПопытка, "ДЛФ=DT"),
		Лев(СтрЗаменить(Строка(МенеджерЗаписи.Комментарий), Символы.ПС, " "), 300)), Успех);

КонецПроцедуры

// Статус строки очереди по документу СБИС - для отправки не из очереди.
//
// Кнопки реестров ЭТрН и УПД подписывают документ напрямую, минуя очередь,
// и строка очереди этого документа оставалась «Готов к отправке». Здесь её
// статус догоняет реестр. Строки ищутся по ИдентификаторСБИС (только очередь
// СБИС - с заполненным Реестр); уже подтверждённую не понижаем. Если
// документа в очереди нет, ничего не делаем.
//
// Параметры:
//   ИдентификаторСБИС - Строка
//   Успех             - Булево - Истина: утверждение ушло; Ложь: ошибка отправки
//   Комментарий       - Строка
//   Подписано         - Булево - СБИС уже показал подпись: «Подтверждено»
//
Процедура ОтметитьОчередьПоДокументу(ИдентификаторСБИС, Успех, Комментарий = "", Подписано = Ложь) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдентификаторСБИС) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторСБИС = &ИдентификаторСБИС
	|	И Очередь.Реестр <> """"
	|	И Очередь.Статус <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено)";
	Запрос.УстановитьПараметр("ИдентификаторСБИС", ИдентификаторСБИС);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЭлектронныйДокумент = Выборка.ЭлектронныйДокумент;
		МенеджерЗаписи.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
		МенеджерЗаписи.Прочитать();
		Если НЕ МенеджерЗаписи.Выбран() Тогда
			Продолжить;
		КонецЕсли;

		Если Подписано Тогда
			МенеджерЗаписи.НеНайденоПодряд = 0;
			МенеджерЗаписи.ПроверитьПосле = Дата(1, 1, 1);
			МенеджерЗаписи.Отправить = Ложь;
			МенеджерЗаписи.ДатаОтвета = ТекущаяДатаСеанса();
			Если НЕ ЗначениеЗаполнено(МенеджерЗаписи.ДатаОтправки) Тогда
				МенеджерЗаписи.ДатаОтправки = МенеджерЗаписи.ДатаОтвета;
			КонецЕсли;
			МенеджерЗаписи.Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено;
			МенеджерЗаписи.Комментарий = Лев(?(ЗначениеЗаполнено(Комментарий),
				СтрШаблон(НСтр("ru = 'Подписано в СБИС: %1'"), Комментарий),
				НСтр("ru = 'Подписано в СБИС'")), 500);
		ИначеЕсли Успех Тогда
			МенеджерЗаписи.НеНайденоПодряд = 0;
			МенеджерЗаписи.ПроверитьПосле = Дата(1, 1, 1);
			МенеджерЗаписи.Отправить = Ложь;
			МенеджерЗаписи.ДатаОтправки = ТекущаяДатаСеанса();
			МенеджерЗаписи.Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОтправленНаПодпись;
			МенеджерЗаписи.Комментарий = Лев(
				НСтр("ru = 'Утверждение отправлено из реестра, ждём подпись в СБИС'"), 500);
		Иначе
			// Ошибка кнопки реестра или автоотправки регламента - тоже с
			// повтором по времени: раньше строка оставалась «Ошибка отправки»
			// без времени повтора и её больше никто не брал
			ОтметитьОшибкуОтправкиСПовтором(МенеджерЗаписи, Комментарий);
		КонецЕсли;

		// Строку поставил робот автоутверждения - это видно в комментарии
		// при любом статусе, не только по признаку
		Если МенеджерЗаписи.ПодписаноРоботом Тогда
			МенеджерЗаписи.Комментарий = Лев(ПометкаРобота() + МенеджерЗаписи.Комментарий, 500);
		КонецЕсли;

		МенеджерЗаписи.Записать();

	КонецЦикла;

КонецПроцедуры

// Ставит документ в очередь «Ожидаемые подтверждения ЭДО» с признаком
// «Подписано роботом» перед тем, как робот автоутверждения его подпишет.
//
// Робот подписывает из реестра, мимо очереди; без этой строки подписанное
// роботом в очереди не появлялось, и отличить его от ручной подписи было
// нечем. Дальше статус строки ведут те же шаги, что и у кнопок реестров:
// «Отправлен на подпись» после отправки, «Подтверждено» после подписи в СБИС,
// «Ошибка отправки» при отказе (см. ОтметитьОчередьПоДокументу).
//
// Строка с признаком из автоотправки исключается (см. ДокументыДляАвтоотправки):
// подпись ставит только тот компьютер, где включено автоутверждение ЭТрН.
//
// Параметры:
//   Реестр        - Строка - "ЭТрН", "УПД" или "УКД"
//   Идентификатор - Строка - документ в СБИС
//
Процедура ПоставитьВОчередьРобота(Реестр, Идентификатор) Экспорт

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	ЗаписьРеестра = РегистрыСведений[ИмяРегистраРеестра(Реестр, Идентификатор)].СоздатьМенеджерЗаписи();
	ЗаписьРеестра.ИдентификаторСБИС = Идентификатор;
	ЗаписьРеестра.Прочитать();
	Если НЕ ЗаписьРеестра.Выбран() Тогда
		Возврат;
	КонецЕсли;

	Добавлено = 0;
	Обновлено = 0;
	ЗаписатьВОчередьОтправки(Реестр, Идентификатор, ЗаписьРеестра.Номер, ЗаписьРеестра.Дата,
		ЗаписьРеестра.Контрагент, Добавлено, Обновлено);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторСБИС = &ИдентификаторСБИС
	|	И Очередь.Реестр <> """"
	|	И Очередь.Статус <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено)";
	Запрос.УстановитьПараметр("ИдентификаторСБИС", Идентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЭлектронныйДокумент = Выборка.ЭлектронныйДокумент;
		МенеджерЗаписи.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
		МенеджерЗаписи.Прочитать();
		Если НЕ МенеджерЗаписи.Выбран() Тогда
			Продолжить;
		КонецЕсли;
		МенеджерЗаписи.ПодписаноРоботом = Истина;
		МенеджерЗаписи.Комментарий = Лев(ПометкаРобота()
			+ НСтр("ru = 'подписывает автоматически (автоутверждение ЭТрН)'"), 500);
		МенеджерЗаписи.Записать();
	КонецЦикла;

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Идентификатор, "АвтоутверждениеЭТрН", Истина,
		СтрШаблон(НСтр("ru = '%1 %2: робот подписывает, строка в очереди подписания'"),
			Реестр, СокрЛП(ЗаписьРеестра.Номер)));

КонецПроцедуры

// Человек подписывает документ сам (кнопкой реестра): строка очереди, которую
// поставил робот и на которой он споткнулся, больше не «Подписано роботом».
//
// Параметры:
//   Идентификатор - Строка - документ в СБИС
//
Процедура СнятьПризнакРобота(Идентификатор) Экспорт

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторСБИС = &ИдентификаторСБИС
	|	И Очередь.ПодписаноРоботом
	|	И Очередь.Статус <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено)";
	Запрос.УстановитьПараметр("ИдентификаторСБИС", Идентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЭлектронныйДокумент = Выборка.ЭлектронныйДокумент;
		МенеджерЗаписи.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.ПодписаноРоботом = Ложь;
			МенеджерЗаписи.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПометкаРобота()

	Возврат НСтр("ru = 'Робот: '");

КонецФункции

// Подтягивает статусы очереди к реестрам ЭТрН, УПД и УКД.
//
// Документ, отправленный кнопкой реестра до того, как отправка стала
// отмечаться в очереди, остался там «Готов к отправке». Здесь такие строки
// находятся одним запросом: в реестре «Подписано» (или статус «Подписан») -
// строка очереди «Подтверждено», в реестре «Утверждено» - «Отправлен на
// подпись». Вызывается при заполнении формы очереди и в «Собрать готовые».
//
// Возвращаемое значение:
//   Число - сколько строк очереди обновлено
//
Функция СинхронизироватьОчередьСРеестрами() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реестры.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	МАКСИМУМ(Реестры.Подписано) КАК Подписано,
	|	МАКСИМУМ(Реестры.Состояние) КАК Состояние
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЭТрН.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|		ВЫБОР
	|			КОГДА ЭТрН.Подписано
	|					ИЛИ ЭТрН.СтатусПодписания = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Подписано,
	|		ЭТрН.Состояние КАК Состояние
	|	ИЗ
	|		РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|	ГДЕ
	|		(ЭТрН.Утверждено
	|			ИЛИ ЭТрН.Подписано
	|			ИЛИ ЭТрН.СтатусПодписания В (
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Утвержден),
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)))
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		УПД.ИдентификаторСБИС,
	|		ВЫБОР
	|			КОГДА УПД.Подписано
	|					ИЛИ УПД.СтатусПодписания = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ,
	|		УПД.Состояние
	|	ИЗ
	|		РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|	ГДЕ
	|		(УПД.Утверждено
	|			ИЛИ УПД.Подписано
	|			ИЛИ УПД.СтатусПодписания В (
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Утвержден),
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)))
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		УКД.ИдентификаторСБИС,
	|		ВЫБОР
	|			КОГДА УКД.Подписано
	|					ИЛИ УКД.СтатусПодписания = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ,
	|		УКД.Состояние
	|	ИЗ
	|		РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|	ГДЕ
	|		(УКД.Утверждено
	|			ИЛИ УКД.Подписано
	|			ИЛИ УКД.СтатусПодписания В (
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Утвержден),
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)))) КАК Реестры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|		ПО Реестры.ИдентификаторСБИС = Очередь.ИдентификаторСБИС
	|ГДЕ
	|	Очередь.Реестр <> """"
	|	И Очередь.Статус В (
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОтправленНаПодпись),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ПустаяСсылка))
	|
	|СГРУППИРОВАТЬ ПО
	|	Реестры.ИдентификаторСБИС";

	Обновлено = 0;

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ОчередьЭДО", Ложь,
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		Возврат 0;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		// «Отправлен на подпись» трогаем, только если подпись уже видна
		Если Выборка.Подписано = 1 Тогда
			ОтметитьОчередьПоДокументу(Выборка.ИдентификаторСБИС, Истина, Выборка.Состояние, Истина);
		Иначе
			ОтметитьОчередьНеотправленную(Выборка.ИдентификаторСБИС);
		КонецЕсли;
		Обновлено = Обновлено + 1;
	КонецЦикла;

	Возврат Обновлено;

КонецФункции

// Строки очереди документа, утверждённого в реестре, которые ещё числятся
// неотправленными, - в «Отправлен на подпись». Уже отправленные не трогает.
//
Процедура ОтметитьОчередьНеотправленную(ИдентификаторСБИС)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторСБИС = &ИдентификаторСБИС
	|	И Очередь.Реестр <> """"
	|	И Очередь.Статус В (
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ПустаяСсылка))";
	Запрос.УстановитьПараметр("ИдентификаторСБИС", ИдентификаторСБИС);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЭлектронныйДокумент = Выборка.ЭлектронныйДокумент;
		МенеджерЗаписи.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
		МенеджерЗаписи.Прочитать();
		Если НЕ МенеджерЗаписи.Выбран() Тогда
			Продолжить;
		КонецЕсли;
		МенеджерЗаписи.Отправить = Ложь;
		Если НЕ ЗначениеЗаполнено(МенеджерЗаписи.ДатаОтправки) Тогда
			МенеджерЗаписи.ДатаОтправки = ТекущаяДатаСеанса();
		КонецЕсли;
		МенеджерЗаписи.Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОтправленНаПодпись;
		МенеджерЗаписи.Комментарий = Лев(?(МенеджерЗаписи.ПодписаноРоботом, ПометкаРобота(), "")
			+ НСтр("ru = 'Утверждение ушло из реестра, ждём подпись в СБИС'"), 500);
		МенеджерЗаписи.Записать();
	КонецЦикла;

КонецПроцедуры

// Спрашивает СБИС по отправленным документам очереди, приняты ли подписи.
//
// Строка очереди «Отправлен на подпись» - это документ, которому утверждение
// уже ушло. Как только СБИС показывает подпись, строка очереди становится
// «Подтверждено», а строка реестра - «Подписан» (зелёная).
//
// Автопроверка (из регламента) не дёргает СБИС впустую:
//   - тестовые идентификаторы (префикс ТЕСТ) не проверяются;
//   - три ответа «документ не найден» подряд переводят строку в «Нет в СБИС»,
//     и больше она автоматически не проверяется;
//   - после сбоя сети или таймаута строку не берут ещё ПаузаПослеСбояСети()
//     секунд: такие сбои в счётчик «не найден» не входят.
// Ручная проверка (кнопка «Проверить подпись») берёт всё, в том числе
// «Нет в СБИС», и пауз не знает.
//
// Параметры:
//   ИдентификаторЗапроса - Строка - проверить одну строку очереди;
//                          пустой - проверить все отправленные
//   Автоматически        - Булево - Истина: вызов из регламента, действуют
//                          ограничения выше; Ложь: ручная команда
//
// Возвращаемое значение:
//   Строка - сколько проверено и сколько подтвердилось
//
Функция ПроверитьПодписиВОчереди(Знач ИдентификаторЗапроса = "", Знач Автоматически = Ложь) Экспорт

	Статусы = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО;

	СтатусыПроверки = Новый Массив;
	СтатусыПроверки.Добавить(Статусы.ОтправленНаПодпись);
	СтатусыПроверки.Добавить(Статусы.Ожидает);
	Если НЕ Автоматически Тогда
		СтатусыПроверки.Добавить(Статусы.НетВСБИС);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Реестр КАК Реестр,
	|	Очередь.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
	|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Очередь.Номер КАК Номер,
	|	Очередь.ПроверитьПосле КАК ПроверитьПосле
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторСБИС <> """"
	|	И Очередь.Реестр <> """"
	|	И Очередь.Статус В (&СтатусыПроверки)";
	Запрос.УстановитьПараметр("СтатусыПроверки", СтатусыПроверки);

	Если ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Очередь.ИдентификаторЗапроса = &ИдентификаторЗапроса";
		Запрос.УстановитьПараметр("ИдентификаторЗапроса", ИдентификаторЗапроса);
	КонецЕсли;

	Проверено = 0;
	Подписано = 0;
	НеНайдено = 0;
	НетВСБИС = 0;
	Ошибок = 0;
	ПропущеноТест = 0;
	ПропущеноПауза = 0;
	ПерваяОшибка = "";
	Сейчас = ТекущаяДатаСеанса();

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Автоматически Тогда
			Если ЭтоТестовыйИдентификатор(Выборка.ИдентификаторСБИС) Тогда
				ПропущеноТест = ПропущеноТест + 1;
				Продолжить;
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.ПроверитьПосле) И Выборка.ПроверитьПосле > Сейчас Тогда
				ПропущеноПауза = ПропущеноПауза + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Проверено = Проверено + 1;

		//@skip-check query-in-loop
		Проверка = ПроверитьПодписьСтрокиОчереди(Выборка.ИдентификаторЗапроса, "ПроверитьПодписиВОчереди");

		Если Проверка.Подписан Тогда
			Подписано = Подписано + 1;
		ИначеЕсли Проверка.НеНайден Тогда
			НеНайдено = НеНайдено + 1;
			Если Проверка.НетВСБИС Тогда
				НетВСБИС = НетВСБИС + 1;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Проверка.Ошибка) Тогда
			Ошибок = Ошибок + 1;
			Если НЕ ЗначениеЗаполнено(ПерваяОшибка) Тогда
				ПерваяОшибка = СтрШаблон("%1 %2: %3", Выборка.Реестр, Выборка.Номер, Проверка.Ошибка);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	// Итог прогона: что проверено, подписано, «Нет в СБИС», сколько ошибок сети
	// и сколько строк не трогали (тест, пауза после сбоя)
	Текст = СтрШаблон(НСтр("ru = 'Проверка подписи в СБИС (%1): проверено %2, подписано %3, не найдено в СБИС %4 (из них стало «Нет в СБИС» %5), ошибок сети %6, пропущено: тест %7, пауза %8.'"),
		?(Автоматически, НСтр("ru = 'по расписанию'"), НСтр("ru = 'вручную'")),
		Проверено, Подписано, НеНайдено, НетВСБИС, Ошибок, ПропущеноТест, ПропущеноПауза);
	Если ЗначениеЗаполнено(ПерваяОшибка) Тогда
		Текст = Текст + " " + ПерваяОшибка;
	КонецЕсли;

	Если Проверено > 0 Тогда
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ОчередьЭДО", Ошибок = 0, Текст);
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Сколько ответов СБИС «документ не найден» подряд переводят строку очереди
// в «Нет в СБИС».
//
// Возвращаемое значение:
//   Число
//
Функция МаксимумОтветовНеНайден() Экспорт

	Возврат 3;

КонецФункции

// Пауза автопроверки подписи после сбоя сети или таймаута СБИС, секунд.
// Раз в 15 минут: чаще повторять незачем, а сбой в счётчик «не найден» не идёт.
//
Функция ПаузаПослеСбояСети()

	Возврат 15 * 60;

КонецФункции

// Идентификатор тестовый (префикс ТЕСТ): такие документы СБИС не знает,
// автоматически их не проверяют.
//
Функция ЭтоТестовыйИдентификатор(ИдентификаторСБИС)

	Идентификатор = ВРег(СокрЛП(ИдентификаторСБИС));
	Возврат СтрНачинаетсяС(Идентификатор, "ТЕСТ") ИЛИ СтрНачинаетсяС(Идентификатор, "TEST");

КонецФункции

// Ответ СБИС «Не найден документ с идентификатором ...». Любая другая ошибка
// (таймаут, обрыв связи, вход в СБИС) в счётчик «не найден» не идёт.
//
Функция ЭтоОтветНеНайден(ТекстОшибки)

	Возврат СтрНайти(НРег(Строка(ТекстОшибки)), "не найден документ") > 0;

КонецФункции

// Спрашивает СБИС по одной строке очереди, принята ли подпись.
//
// Подтверждённую строку больше не трогает: подпись по ней уже зафиксирована.
//
// Параметры:
//   ИдентификаторЗапроса - Строка - строка очереди
//   Источник             - Строка - откуда вызвано (поле src журнала запросов СБИС)
//
// Возвращаемое значение:
//   Структура:
//     * Подписан  - Булево - подпись видна в СБИС, строка стала зелёной
//     * Состояние - Строка - название состояния документа в СБИС
//     * Ошибка    - Строка
//     * НеНайден  - Булево - СБИС ответил «документ не найден» (считается подряд)
//     * НетВСБИС  - Булево - этим ответом строка стала «Нет в СБИС»
//     * СетеваяОшибка - Булево - таймаут, обрыв связи, вход в СБИС: в счётчик
//                       «не найден» не входит, автопроверка подождёт
//
Функция ПроверитьПодписьСтрокиОчереди(ИдентификаторЗапроса, Источник = "ПроверитьПодписьСтрокиОчереди") Экспорт

	Результат = Новый Структура("Подписан, Состояние, Ошибка, НеНайден, НетВСБИС, СетеваяОшибка",
		Ложь, "", "", Ложь, Ложь, Ложь);

	Если НЕ ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		Результат.Ошибка = НСтр("ru = 'Не заполнен идентификатор запроса'");
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Очередь.Реестр КАК Реестр,
	|	Очередь.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторЗапроса = &ИдентификаторЗапроса
	|	И Очередь.ИдентификаторСБИС <> """"
	|	И Очередь.Реестр <> """"
	|	И Очередь.Статус <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено)";
	Запрос.УстановитьПараметр("ИдентификаторЗапроса", ИдентификаторЗапроса);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Результат.Ошибка = НСтр("ru = 'Строка очереди не найдена или подпись уже подтверждена'");
		Возврат Результат;
	КонецЕсли;

	Проверка = ЭАрМ_УтверждениеСБИС.ПроверитьПодписьВСБИС(
		Выборка.Реестр, Выборка.ИдентификаторСБИС, Источник);

	ЗаполнитьЗначенияСвойств(Результат, Проверка);

	Если НЕ Результат.Подписан Тогда
		// В «Что произошло» - ответ СБИС: иначе строка «Отправлен на подпись»
		// висела молча, и было не понять, идёт ли проверка и чего ждёт СБИС
		Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
			Пояснение = НСтр("ru = 'Проверка подписи не удалась: '") + Результат.Ошибка;
			Если ЭтоОтветНеНайден(Результат.Ошибка) Тогда
				Результат.НеНайден = Истина;
			Иначе
				Результат.СетеваяОшибка = Истина;
			КонецЕсли;
		Иначе
			Ожидает = "";
			Проверка.Свойство("Ожидает", Ожидает);
			Пояснение = СтрШаблон(НСтр("ru = 'В СБИС «%1», подписи ещё нет%2'"), Результат.Состояние,
				?(ЗначениеЗаполнено(Ожидает), НСтр("ru = ', документ ждёт: '") + Ожидает, ""));
		КонецЕсли;
		ЗаписатьПояснениеПроверки(Выборка.ЭлектронныйДокумент, Выборка.ИдентификаторЗапроса, Пояснение, Результат);
		Возврат Результат;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ЭлектронныйДокумент = Выборка.ЭлектронныйДокумент;
	МенеджерЗаписи.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат Результат;
	КонецЕсли;

	МенеджерЗаписи.Отправить = Ложь;
	МенеджерЗаписи.ДатаОтвета = ТекущаяДатаСеанса();
	МенеджерЗаписи.Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено;
	МенеджерЗаписи.НеНайденоПодряд = 0;
	МенеджерЗаписи.ПроверитьПосле = Дата(1, 1, 1);
	МенеджерЗаписи.Комментарий = Лев(СтрШаблон(
		НСтр("ru = 'Подписано в СБИС: %1'"), Результат.Состояние), 500);
	МенеджерЗаписи.Записать();

	Возврат Результат;

КонецФункции

// Пишет в строку очереди итог проверки подписи, когда подписи в СБИС нет:
// комментарий «<ответ СБИС> (проверено дд.ММ ЧЧ:мм)», счётчик ответов «не
// найден» подряд и паузу автопроверки.
//
//   - СБИС не нашёл документ: счётчик + 1; на МаксимумОтветовНеНайден()-м
//     ответе подряд строка становится «Нет в СБИС» и автопроверка её бросает;
//   - сбой сети или таймаут: счётчик не меняется, автопроверка ждёт
//     ПаузаПослеСбояСети() секунд;
//   - СБИС документ нашёл, подписи ещё нет: счётчик и пауза сбрасываются,
//     строка «Нет в СБИС» возвращается в «Отправлен на подпись».
//
// Время в комментарии меняется каждый проход, поэтому сравниваем без него:
// тот же ответ СБИС строку не переписывает.
//
// Параметры:
//   Результат - Структура - см. ПроверитьПодписьСтрокиОчереди; поле НетВСБИС
//               здесь выставляется, когда этим ответом строка стала «Нет в СБИС»
//
Процедура ЗаписатьПояснениеПроверки(ЭлектронныйДокумент, ИдентификаторЗапроса, Знач Пояснение, Результат)

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ЭлектронныйДокумент = ЭлектронныйДокумент;
	МенеджерЗаписи.ИдентификаторЗапроса = ИдентификаторЗапроса;
	МенеджерЗаписи.Прочитать();
	Если НЕ МенеджерЗаписи.Выбран()
		ИЛИ МенеджерЗаписи.Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено Тогда
		Возврат;
	КонецЕсли;

	Статусы = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО;
	Сейчас = ТекущаяДатаСеанса();
	БылиНеНайдено = МенеджерЗаписи.НеНайденоПодряд;
	БылаПауза = МенеджерЗаписи.ПроверитьПосле;
	БылСтатус = МенеджерЗаписи.Статус;
	Лимит = МаксимумОтветовНеНайден();

	Если Результат.НеНайден Тогда

		МенеджерЗаписи.НеНайденоПодряд = Мин(БылиНеНайдено + 1, Лимит);
		МенеджерЗаписи.ПроверитьПосле = Дата(1, 1, 1);
		Если МенеджерЗаписи.НеНайденоПодряд >= Лимит Тогда
			МенеджерЗаписи.Статус = Статусы.НетВСБИС;
			Результат.НетВСБИС = (БылСтатус <> Статусы.НетВСБИС);
			Пояснение = СтрШаблон(НСтр("ru = 'Нет в СБИС: %1 ответа подряд «документ не найден», автопроверка остановлена. Кнопка «Проверить подпись» проверит вручную'"),
				Лимит);
		Иначе
			Пояснение = СтрШаблон(НСтр("ru = 'СБИС не нашёл документ (%1 из %2), проверим ещё раз'"),
				МенеджерЗаписи.НеНайденоПодряд, Лимит);
		КонецЕсли;

	ИначеЕсли Результат.СетеваяОшибка Тогда

		МенеджерЗаписи.ПроверитьПосле = Сейчас + ПаузаПослеСбояСети();
		// Ответ СБИС при сбое длинный: режем его, иначе время повтора обрежется
		Пояснение = Лев(Пояснение, 360) + СтрШаблон(НСтр("ru = ' (следующая автопроверка не раньше %1)'"),
			Формат(МенеджерЗаписи.ПроверитьПосле, "ДФ='дд.ММ ЧЧ:мм'"));

	Иначе

		// СБИС документ видит - значит «не найден» подряд закончилось
		МенеджерЗаписи.НеНайденоПодряд = 0;
		МенеджерЗаписи.ПроверитьПосле = Дата(1, 1, 1);
		Если БылСтатус = Статусы.НетВСБИС Тогда
			МенеджерЗаписи.Статус = Статусы.ОтправленНаПодпись;
		КонецЕсли;

	КонецЕсли;

	Суть = Лев(Пояснение, 440);
	ТоЖеПояснение = СтрНачинаетсяС(МенеджерЗаписи.Комментарий, Суть);
	Если ТоЖеПояснение
		И МенеджерЗаписи.НеНайденоПодряд = БылиНеНайдено
		И МенеджерЗаписи.ПроверитьПосле = БылаПауза
		И МенеджерЗаписи.Статус = БылСтатус Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.Комментарий = Суть + СтрШаблон(НСтр("ru = ' (проверено %1)'"),
		Формат(Сейчас, "ДФ='дд.ММ ЧЧ:мм'"));
	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		// Строку может держать отправка: итог и счётчик запишет следующий проход.
		// Но молча не оставляем - иначе «Нет в СБИС» не наступило бы без следа
		Результат.НетВСБИС = Ложь;
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение(ИдентификаторЗапроса,
			"СБИС: запись итога проверки подписи", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Кнопка «Утвердить» реестра УПД и «Получен» реестра ЭТрН.
//
// Человек принял решение по документу: ставим в реестре «К отправке» и сразу
// кладём документ в очередь ЭАрМ_ОжидаемыеПодтвержденияЭДО с отметкой
// «Отправить». В СБИС здесь ничего не уходит - подписывает очередь
// («Подписать отмеченные» / «Отправить все ЭТрН»).
//
// Проверки те же, что перед подписью (ЭАрМ_УтверждениеСБИС.ЗапретУтверждения):
// у УПД - «Расхождений нет» и итоговая сумма с приходом Далиона, у ЭТрН -
// «Можно утвердить». Флажок ставится в транзакции и откатывается, если
// документ утверждать нельзя: иначе «К отправке» осталась бы на документе,
// который в очередь не попал.
//
// Параметры:
//   Реестр         - Строка - "УПД", "УКД" или "ЭТрН"
//   Идентификаторы - Массив из Строка - документы СБИС
//   ЗапускатьОтправку - Булево - Ложь, если подписывает сама форма
//                       (кнопка «Отправить УКД») и очередь запускать не нужно
//
// Возвращаемое значение:
//   Структура:
//     * Поставлено - Число - сколько документов встало в очередь
//     * Ошибки     - Массив из Строка - почему остальные не встали
//
Функция ПоставитьНаУтверждение(Реестр, Идентификаторы, ЗапускатьОтправку = Истина) Экспорт

	Результат = Новый Структура("Поставлено, Ошибки", 0, Новый Массив);

	Для Каждого Идентификатор Из Идентификаторы Цикл

		Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;

		//@skip-check query-in-loop
		Ошибка = ПоставитьДокументНаУтверждение(Реестр, Идентификатор);

		Если ЗначениеЗаполнено(Ошибка) Тогда
			Результат.Ошибки.Добавить(Ошибка);
		Иначе
			Результат.Поставлено = Результат.Поставлено + 1;
			// УКД к этой УПД на подпись сами не встают: у них нет своей
			// «К отправке». Ручная сверка ставит им «Расхождений нет»,
			// но в очередь их кладёт только постановка УПД.
			Если Реестр = "УПД" Тогда
				Корректировки = ПоставитьГотовыеКорректировки(Идентификатор);
				Результат.Поставлено = Результат.Поставлено + Корректировки.Поставлено;
				Для Каждого ОшибкаКорректировки Из Корректировки.Ошибки Цикл
					Результат.Ошибки.Добавить(ОшибкаКорректировки);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Если Результат.Поставлено > 0 Тогда
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ОчередьЭДО", Истина,
			СтрШаблон(НСтр("ru = '%1: поставлено на утверждение %2'"),
				Реестр, Результат.Поставлено));
		// Попало в очередь - сразу в СБИС (если отправка с сервера настроена).
		// Кнопка «Отправить УКД» подписывает сама и очередь не запускает:
		// иначе тот же документ ушёл бы вторым разом с сервера.
		Если ЗапускатьОтправку Тогда
			ЗапуститьОтправкуОчередиВФоне();
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Снимает «К отправке» с документа реестра и убирает его из очереди,
// если утверждение ещё не ушло в СБИС. Отправленное не трогается: его
// судьбу решает уже СБИС.
//
// Параметры:
//   Реестр        - Строка - "УПД", "УКД" или "ЭТрН"
//   Идентификатор - Строка - документ СБИС
//
// Возвращаемое значение:
//   Строка - почему снять нельзя; пустая - снято
//
Функция СнятьСУтверждения(Реестр, Идентификатор) Экспорт

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат НСтр("ru = 'Выберите документ в списке'");
	КонецЕсли;

	ИмяРегистра = ИмяРегистраРеестра(Реестр, Идентификатор);

	НачатьТранзакцию();
	Попытка

		ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра(
			"РегистрСведений." + ИмяРегистра, Идентификатор);

		МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
		МенеджерЗаписи.Прочитать();

		Если НЕ МенеджерЗаписи.Выбран() Тогда
			ОтменитьТранзакцию();
			Возврат НСтр("ru = 'Документа нет в реестре'");
		КонецЕсли;

		Если МенеджерЗаписи.Утверждено ИЛИ МенеджерЗаписи.Подписано Тогда
			ОтменитьТранзакцию();
			Возврат СтрШаблон(НСтр("ru = '%1 %2: утверждение уже ушло в СБИС, снять нельзя'"),
				Реестр, МенеджерЗаписи.Номер);
		КонецЕсли;

		Если МенеджерЗаписи.КОтправке Тогда
			МенеджерЗаписи.КОтправке = Ложь;
			МенеджерЗаписи.Записать(Истина);
		КонецЕсли;

		УдалитьНеотправленноеИзОчереди(Идентификатор);

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	// С УПД снимаются и её УКД, которые ещё не ушли в СБИС: ставили их вместе.
	// Уже отправленную УКД СнятьСУтверждения не трогает и возвращает текст -
	// для УПД это не ошибка снятия.
	Если Реестр = "УПД" Тогда
		Для Каждого ИдентификаторУКД Из ЭАрМ_КорректировкиУПД.КорректировкиУПД(Идентификатор) Цикл
			Попытка
				СнятьСУтверждения("УКД", ИдентификаторУКД);
			Исключение
				ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(ИдентификаторУКД, "ОчередьЭДО", Ложь,
					ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	Возврат "";

КонецФункции

// УКД исходной УПД с «Расхождений нет» - в ту же очередь, что и УПД.
// Без своей «К отправке» корректировка в «Собрать готовые» не попадает,
// а ручная сверка этот флажок не ставит: она только принимает расхождения.
//
// Возвращаемое значение:
//   Структура - Поставлено (Число), Ошибки (Массив из Строка)
//
Функция ПоставитьГотовыеКорректировки(ИдентификаторУПД)

	Результат = Новый Структура("Поставлено, Ошибки", 0, Новый Массив);

	Для Каждого ИдентификаторУКД Из ЭАрМ_КорректировкиУПД.КорректировкиУПД(ИдентификаторУПД) Цикл

		Запись = РегистрыСведений.ЭАрМ_УКД_Входящий.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторСБИС = ИдентификаторУКД;
		Запись.Прочитать();
		Если НЕ Запись.Выбран()
			ИЛИ НЕ Запись.РасхожденийНет
			ИЛИ Запись.Подписано
			ИЛИ Запись.Утверждено Тогда
			Продолжить;
		КонецЕсли;

		//@skip-check query-in-loop
		Ошибка = ПоставитьДокументНаУтверждение("УКД", ИдентификаторУКД);
		Если ЗначениеЗаполнено(Ошибка) Тогда
			Результат.Ошибки.Добавить(Ошибка);
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(ИдентификаторУКД, "ОчередьЭДО", Ложь, Ошибка);
		Иначе
			Результат.Поставлено = Результат.Поставлено + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Точка входа для регламентного задания проверки папки обмена.
//
// Сама файлы не читает. Ответ Базы2 нужен двоим сразу - реестру ЭТрН и
// ожидаемым подтверждениям ЭД, - а после разбора файл уезжает в архив.
// Здесь была своя читалка на половину задачи: она отрабатывала только
// подтверждения и уносила файл в архив, после чего ЗабратьОтветыИзПапки
// уже нечего было разбирать. Статус Далиона и расхождения в реестр ЭТрН
// не попадали - тот из двух регламентных заданий, что успевал первым,
// забирал ответ себе.
//
Процедура ПроверитьПапкуОбмена() Экспорт

	ЭАрМ_РегламентныйОбменЭДО.ЗабратьОтветыИзПапки();

КонецПроцедуры

// Проверяет наличие связанного документа ЭлектроннаяТранспортнаяНакладная.
//
Функция СвязанныйЭТрННайден(ЭлектронныйДокумент)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Поле1
	|ИЗ
	|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК Связи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭлектроннаяТранспортнаяНакладная КАК ЭТрН
	|		ПО Связи.ОбъектУчета = ЭТрН.Ссылка
	|ГДЕ
	|	Связи.ЭлектронныйДокумент = &ЭлектронныйДокумент";
	Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокумент);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Повторяет неудачные отправки в Далион.
//
// Строки очереди подписания в СБИС (у них заполнен Реестр, а электронного
// документа нет) сюда не попадают: их повторяют подписью, а не отправкой
// в другую базу.
//
// Раньше повтор был бесконечным и без паузы: неудача снова ставила
// «ОжидаетПовторнойОтправки», документ слался в Далион на каждом проходе, а
// два прохода (два регламента) слали его дважды. Теперь:
//   - строка «берётся» под блокировкой: СледующаяПопытка сдвигается вперёд,
//     и параллельный проход её уже не выберет;
//   - неудача - ПопытокПовтора + 1, пауза растёт: 5, 10, 20, 40... мин, не
//     больше 6 часов;
//   - после МаксимумПопытокПовтора() автоповтор прекращается: статус
//     «ОшибкаОтправки» с комментарием. «ОжидаетПовторнойОтправки»,
//     поставленный вручную, повторяется всегда (с той же паузой).
//
Процедура ПовторитьНеудачныеОтправки() Экспорт

	// В Далион только вручную: регламент неудачные отправки не повторяет
	Если ЭАрМ_НастройкиСервер.АвтоотправкаВДалионВыключена() Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Т.ИдентификаторЗапроса КАК ИдентификаторЗапроса
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
	|ГДЕ
	|	Т.Реестр = """"
	|	И Т.СледующаяПопытка <= &Сейчас
	|	И (Т.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОжидаетПовторнойОтправки)
	|		ИЛИ Т.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки)
	|			И Т.ПопытокПовтора < &МаксимумПопыток)";
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("МаксимумПопыток", МаксимумПопытокПовтора());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Попыток = ВзятьСтрокуНаПовтор(Выборка.ЭлектронныйДокумент, Выборка.ИдентификаторЗапроса);
		Если Попыток = Неопределено Тогда
			// Строку уже взял другой проход или её статус сменился
			Продолжить;
		КонецЕсли;

		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ПовторОтправки",
			УровеньЖурналаРегистрации.Информация, , Выборка.ЭлектронныйДокумент,
			СтрШаблон("Повтор отправки %1 из %2, requestId=%3", Попыток + 1,
				МаксимумПопытокПовтора(), Выборка.ИдентификаторЗапроса));

		Успешно = ЭАрМ_ОбменСДругойБазой.ОтправитьДокументНаПодтверждение(
			Выборка.ЭлектронныйДокумент, Выборка.ИдентификаторЗапроса);

		Если Успешно Тогда
			ЗаписатьСтатусОжидания(Выборка.ЭлектронныйДокумент, Выборка.ИдентификаторЗапроса,
				Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает,
				"Повторная отправка успешна");
			ЗаписатьПопыткуПовтора(Выборка.ЭлектронныйДокумент, Выборка.ИдентификаторЗапроса, 0);
		Иначе
			Попыток = Попыток + 1;
			Если Попыток >= МаксимумПопытокПовтора() Тогда
				ЗаписатьСтатусОжидания(Выборка.ЭлектронныйДокумент, Выборка.ИдентификаторЗапроса,
					Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки,
					СтрШаблон("Повтор не удался %1 раз - автоповтор остановлен, отправьте вручную", Попыток));
			Иначе
				ЗаписатьСтатусОжидания(Выборка.ЭлектронныйДокумент, Выборка.ИдентификаторЗапроса,
					Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОжидаетПовторнойОтправки,
					СтрШаблон("Повтор не удался (%1 из %2)", Попыток, МаксимумПопытокПовтора()));
			КонецЕсли;
			ЗаписатьПопыткуПовтора(Выборка.ЭлектронныйДокумент, Выборка.ИдентификаторЗапроса, Попыток);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Сколько раз автоматически повторять отправку в Далион.
//
// «Ошибка отправки» с повтором: автоотправка формы и регламент берут строку
// снова, когда наступит СледующаяПопытка (5, 10, 20... минут, не больше
// 6 часов), до МаксимумПопытокПовтора() раз. Дальше - кнопкой или сменой
// статуса после исправления причины.
//
// Параметры:
//   МенеджерЗаписи - РегистрСведенийМенеджерЗаписи.ЭАрМ_ОжидаемыеПодтвержденияЭДО
//   ТекстОшибки    - Строка - в комментарий, с хвостом о следующей попытке
//
Процедура ОтметитьОшибкуОтправкиСПовтором(МенеджерЗаписи, ТекстОшибки)

	// Документ ждёт решения по аннулированию: подписывать нечем, восемь повторов
	// получили бы тот же ответ. Останавливаем автоповтор сразу
	Если ЭАрМ_УтверждениеСБИС.ЭтоОтказЧужогоОператораЭПД(ТекстОшибки)
		ИЛИ ЭАрМ_УтверждениеСБИС.ЭтоОжиданиеРешенияПоАннулированию(ТекстОшибки) Тогда
		// Документ ведёт другой оператор ЭПД - СБИС его не подпишет никогда.
		// Раньше строка восемь раз уходила на повтор и каждый раз получала
		// тот же отказ. Сразу ставим состояние «автоповторы исчерпаны»
		// (пустая СледующаяПопытка автоотправка не берёт) и снимаем отметку
		// «Отправить», чтобы строку не подхватила и ручная отправка отмеченных
		МенеджерЗаписи.Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки;
		МенеджерЗаписи.ПопытокПовтора = МаксимумПопытокПовтора();
		МенеджерЗаписи.СледующаяПопытка = Дата(1, 1, 1);
		МенеджерЗаписи.Отправить = Ложь;
		МенеджерЗаписи.Комментарий = Лев(ТекстОшибки, 500);
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки;
	МенеджерЗаписи.ПопытокПовтора = МенеджерЗаписи.ПопытокПовтора + 1;

	Если МенеджерЗаписи.ПопытокПовтора < МаксимумПопытокПовтора() Тогда
		МенеджерЗаписи.СледующаяПопытка = ТекущаяДатаСеанса()
			+ ПаузаПовтора(МенеджерЗаписи.ПопытокПовтора - 1);
		Хвост = СтрШаблон(НСтр("ru = ' · повтор в %1 (попытка %2 из %3)'"),
			Формат(МенеджерЗаписи.СледующаяПопытка, "ДФ='дд.ММ ЧЧ:мм'"),
			МенеджерЗаписи.ПопытокПовтора + 1, МаксимумПопытокПовтора());
	Иначе
		МенеджерЗаписи.СледующаяПопытка = Дата(1, 1, 1);
		Хвост = НСтр("ru = ' · автоповторы исчерпаны - отправьте кнопкой после исправления'");
	КонецЕсли;

	МенеджерЗаписи.Комментарий = Лев(ТекстОшибки, 500 - СтрДлина(Хвост)) + Хвост;

КонецПроцедуры

Функция МаксимумПопытокПовтора()

	Возврат 8;

КонецФункции

// Пауза перед следующим повтором: 5 минут, удваивается с каждой неудачей,
// не больше 6 часов.
//
Функция ПаузаПовтора(Попыток)

	Пауза = 300;
	Для Номер = 1 По Попыток Цикл
		Пауза = Пауза * 2;
		Если Пауза >= 21600 Тогда
			Возврат 21600;
		КонецЕсли;
	КонецЦикла;

	Возврат Пауза;

КонецФункции

// «Берёт» строку очереди на повтор: под блокировкой перечитывает её и, если
// она всё ещё ждёт повтора, сдвигает СледующаяПопытка на 10 минут вперёд -
// параллельный проход её не выберет, пока идёт отправка.
//
// Возвращаемое значение:
//   Число - сколько повторов уже было; Неопределено - строку брать не нужно
//
Функция ВзятьСтрокуНаПовтор(ЭлектронныйДокумент, ИдентификаторЗапроса)

	Попыток = Неопределено;

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО");
		ЭлементБлокировки.УстановитьЗначение("ЭлектронныйДокумент", ЭлектронныйДокумент);
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторЗапроса", ИдентификаторЗапроса);
		Блокировка.Заблокировать();

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЭлектронныйДокумент = ЭлектронныйДокумент;
		МенеджерЗаписи.ИдентификаторЗапроса = ИдентификаторЗапроса;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран()
			И МенеджерЗаписи.СледующаяПопытка <= ТекущаяДатаСеанса()
			И (МенеджерЗаписи.Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОжидаетПовторнойОтправки
				ИЛИ МенеджерЗаписи.Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки) Тогда
			Попыток = МенеджерЗаписи.ПопытокПовтора;
			МенеджерЗаписи.СледующаяПопытка = ТекущаяДатаСеанса() + 600;
			МенеджерЗаписи.Записать(Истина);
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ПовторОтправки", УровеньЖурналаРегистрации.Предупреждение, ,
			ЭлектронныйДокумент, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

	Возврат Попыток;

КонецФункции

// Счётчик повторов и момент следующего; 0 - успех, счётчик сброшен.
//
Процедура ЗаписатьПопыткуПовтора(ЭлектронныйДокумент, ИдентификаторЗапроса, Попыток)

	Попытка
		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЭлектронныйДокумент = ЭлектронныйДокумент;
		МенеджерЗаписи.ИдентификаторЗапроса = ИдентификаторЗапроса;
		МенеджерЗаписи.Прочитать();
		Если НЕ МенеджерЗаписи.Выбран() Тогда
			Возврат;
		КонецЕсли;
		МенеджерЗаписи.ПопытокПовтора = Попыток;
		МенеджерЗаписи.СледующаяПопытка = ?(Попыток = 0, Дата(1, 1, 1),
			ТекущаяДатаСеанса() + ПаузаПовтора(Попыток));
		МенеджерЗаписи.Записать(Истина);
	Исключение
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ПовторОтправки", УровеньЖурналаРегистрации.Предупреждение, ,
			ЭлектронныйДокумент, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Сверяет статусы с базой Далион.
//
// Очередь подписания в СБИС тоже стоит в «Ожидает», но её ждут не от Далиона,
// а от СБИС - такие строки (с заполненным Реестром) проверяет
// ПроверитьПодписиВОчереди.
//
Процедура СверитьСДалион() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Т.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
	|	Т.ДатаОтправки КАК ДатаОтправки
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
	|ГДЕ
	|	Т.Реестр = """"
	|	И Т.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает)
	|	И РАЗНОСТЬДАТ(Т.ДатаОтправки, &ТекущаяДата, ЧАС) > 1";

	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		СтатусВДалион = ЭАрМ_ОбменСДругойБазой.ПроверитьСтатусВДалион(Выборка.ИдентификаторЗапроса);

		Если СтатусВДалион = Неопределено Тогда
			ЗаписатьСтатусОжидания(Выборка.ЭлектронныйДокумент, Выборка.ИдентификаторЗапроса,
				Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.НеОбработаноВДалион,
				"Далион не ответил");
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// ============================================================================
// ДОСЫЛ В ДАЛИОН ДОКУМЕНТОВ РЕЕСТРА ЭТрН
// ============================================================================

// Досылает в Далион документы реестра ЭТрН, которые ещё не ушли.
//
// Регистра АРМ_ВходящиеЭТрН в конфигурации нет и не было - запрос к нему валил
// всё регламентное задание на первой же строке, вместе с обработкой
// подтверждений. Список того, что ещё не передано, ведёт РегистрСведений
// ЭАрМ_РеестрЭТрН: отбор здесь тот же, что и у основной выгрузки
// (ЭАрМ_РегламентныйОбменЭДО.ВыгрузитьНевыгруженные).
//
// Отправкой занимается ЭАрМ_РегламентныйОбменЭДО.ВыгрузитьДокумент - он же
// проставляет в реестре Выгружен, ДатаВыгрузки, ПопытокВыгрузки и
// ОшибкуВыгрузки, поэтому свои отметки здесь не нужны.
//
// Раньше вместо отправки вызывалась ЭАрМ_ПриемДокументовДалион.ПринятьДокумент-
// ЧерезHTTP. Это код приёмной стороны: он разбирает документ внутри самой
// Базы1 и шлёт callback, то есть документ в Далион так и не попадал.
//
Процедура ОбработатьВходящиеЭТрНИзРегистра() Экспорт

	НастройкиОбмена = ЭАрМ_НастройкиСервер.НастройкиОбмена();

	Если НЕ НастройкиОбмена.ОбменВключен Тогда
		Возврат;
	КонецЕсли;

	Если НастройкиОбмена.ТолькоПриемИзДалиона
		ИЛИ ЭАрМ_НастройкиСервер.АвтоотправкаВДалионВыключена() Тогда
		Возврат;
	КонецЕсли;

	МаксимумДокументов = ?(НастройкиОбмена.МаксимумДокументов > 0,
		НастройкиОбмена.МаксимумДокументов, 50);
	МаксимумПопыток = ?(НастройкиОбмена.МаксимумПопыток > 0,
		НастройкиОбмена.МаксимумПопыток, 3);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	Реестр.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК Реестр
	|ГДЕ
	|	НЕ Реестр.Выгружен
	|	И Реестр.ДанныеПолучены
	|	И Реестр.ПопытокВыгрузки < &МаксимумПопыток
	|
	|УПОРЯДОЧИТЬ ПО
	|	Реестр.Дата";
	Запрос.УстановитьПараметр("МаксимумПопыток", МаксимумПопыток);

	Выборка = Запрос.Выполнить().Выбрать();

	Обработано = 0;
	Отправлено = 0;
	Ошибок = 0;

	Пока Выборка.Следующий() Цикл

		Если Обработано >= МаксимумДокументов Тогда
			Прервать;
		КонецЕсли;

		Обработано = Обработано + 1;

		Попытка

			//@skip-check query-in-loop
			РезультатВыгрузки = ЭАрМ_РегламентныйОбменЭДО.ВыгрузитьДокумент(
				Выборка.ИдентификаторСБИС);

			Если РезультатВыгрузки.Успех Тогда
				Отправлено = Отправлено + 1;
			Иначе
				Ошибок = Ошибок + 1;
				ЗаписьЖурналаРегистрации("АРМ_ЭДО.ДосылЭТрН",
					УровеньЖурналаРегистрации.Предупреждение, , ,
					СтрШаблон("ЭТрН %1: %2",
						Выборка.ИдентификаторСБИС, РезультатВыгрузки.Ошибка));
			КонецЕсли;

		Исключение
			// Отметку о неудаче ведёт сам ВыгрузитьДокумент, здесь только
			// журнал: один сбойный документ не должен останавливать досыл
			Ошибок = Ошибок + 1;
			ЗаписьЖурналаРегистрации("АРМ_ЭДО.ДосылЭТрН",
				УровеньЖурналаРегистрации.Ошибка, , ,
				СтрШаблон("Ошибка выгрузки %1: %2",
					Выборка.ИдентификаторСБИС,
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

	Если Обработано > 0 Тогда
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.ДосылЭТрН",
			УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон("Досыл в Далион: отправлено %1, с ошибкой %2", Отправлено, Ошибок));
	КонецЕсли;

КонецПроцедуры

// Отбор здесь тот же, что и у ЭАрМ_УтверждениеСБИС.ЗапретУтверждения: «Можно
// утвердить» и «К отправке». Раньше в очередь попадала и ЭТрН, у которой просто
// заполнен номер приходной Далиона, - подписать её всё равно не давали, и она
// возвращалась из пачки ошибкой «Утвердить нельзя».
//
Процедура ПеренестиЭТрНВОчередь(Добавлено, Обновлено)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭТрН.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	ЭТрН.Номер КАК Номер,
	|	ЭТрН.Дата КАК Дата,
	|	ЭТрН.Контрагент КАК Контрагент,
	|	ЭТрН.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	ЭТрН.МожноУтвердить
	|	И ЭТрН.КОтправке
	|	И НЕ ЭТрН.Подписано
	|	И НЕ ЭТрН.Утверждено
	|	И ЭТрН.СтатусПодписания <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("ЭТрН") + "
	|	И НЕ (ЭТрН.КодСостояния = ""27"")";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если ДокументУжеПодписанВСбис(Выборка.Состояние) Тогда
			Продолжить;
		КонецЕсли;

		// Аннулирование, запрошенное не кодом 27, видно только в этапах документа
		Запрет = ЭАрМ_УтверждениеСБИС.ЗапретУтверждения("ЭТрН", Выборка.ИдентификаторСБИС, Истина);
		Если ЗначениеЗаполнено(Запрет) Тогда
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС,
				"ОчередьОтправки", Ложь, Запрет);
			Продолжить;
		КонецЕсли;

		УстановитьСтатусГотовности("ЭТрН", Выборка.ИдентификаторСБИС);
		ЗаписатьВОчередьОтправки("ЭТрН", Выборка.ИдентификаторСБИС,
			Выборка.Номер, Выборка.Дата, Выборка.Контрагент, Добавлено, Обновлено);

	КонецЦикла;

КонецПроцедуры

// Сошедшаяся УПД в очередь только с «К отправке», как ЭТрН. Иначе «Собрать
// готовые» клало бы все сверенные УПД без решения пользователя, и они уходили
// бы вместе с отмеченной ЭТрН другого поставщика.
//
Процедура ПеренестиУПДВОчередь(Добавлено, Обновлено)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.Контрагент КАК Контрагент,
	|	УПД.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.РасхожденийНет
	|	И УПД.КОтправке
	|	И НЕ УПД.Подписано
	|	И НЕ УПД.Утверждено
	|	И УПД.СтатусПодписания <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если ДокументУжеПодписанВСбис(Выборка.Состояние) Тогда
			Продолжить;
		КонецЕсли;

		// Итоговая сумма пересчитывается по текущим документам: с разной
		// суммой документ в очередь не встаёт, даже с отметками
		Запрет = ЭАрМ_УтверждениеСБИС.ЗапретУтверждения("УПД", Выборка.ИдентификаторСБИС, Истина);
		Если ЗначениеЗаполнено(Запрет) Тогда
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС,
				"ОчередьОтправки", Ложь, Запрет);
			Продолжить;
		КонецЕсли;

		УстановитьСтатусГотовности("УПД", Выборка.ИдентификаторСБИС);
		ЗаписатьВОчередьОтправки("УПД", Выборка.ИдентификаторСБИС,
			Выборка.Номер, Выборка.Дата, Выборка.Контрагент, Добавлено, Обновлено);

	КонецЦикла;

КонецПроцедуры

// Корректировки из своего реестра. Условие то же, что у УПД: исходная УПД с
// учётом корректировок сошлась с приходом, стоит «К отправке», а без найденной
// УПД сверки не было.
//
Процедура ПеренестиУКДВОчередь(Добавлено, Обновлено)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УКД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УКД.Номер КАК Номер,
	|	УКД.Дата КАК Дата,
	|	УКД.Контрагент КАК Контрагент,
	|	УКД.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	УКД.РасхожденийНет
	|	И УКД.КОтправке
	|	И УКД.ИдентификаторОснования <> """"
	|	И НЕ УКД.Подписано
	|	И НЕ УКД.Утверждено
	|	И УКД.СтатусПодписания <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если ДокументУжеПодписанВСбис(Выборка.Состояние) Тогда
			Продолжить;
		КонецЕсли;

		// Итоговая сумма пересчитывается по текущим документам: с разной
		// суммой документ в очередь не встаёт, даже с отметками
		Запрет = ЭАрМ_УтверждениеСБИС.ЗапретУтверждения("УКД", Выборка.ИдентификаторСБИС, Истина);
		Если ЗначениеЗаполнено(Запрет) Тогда
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС,
				"ОчередьОтправки", Ложь, Запрет);
			Продолжить;
		КонецЕсли;

		УстановитьСтатусГотовности("УКД", Выборка.ИдентификаторСБИС);
		ЗаписатьВОчередьОтправки("УКД", Выборка.ИдентификаторСБИС,
			Выборка.Номер, Выборка.Дата, Выборка.Контрагент, Добавлено, Обновлено);

	КонецЦикла;

КонецПроцедуры

// Если в очередь уже попал один документ поставки, подтягивает остальные
// готовые документы той же цепочки: ЭТрН, УПД и УКД по основанию УПД.
//
// Сами по себе они в очередь не сыпятся: нужна отметка «К отправке» хотя бы
// у одного. Иначе «собрать» снова утащило бы все сверенные УПД.
// У подтянутой УКД своей отметки может не быть (ручная сверка её не ставит):
// перед запретом утверждения отметка ставится здесь и снимается, если
// документ утверждать всё же нельзя.
//
Процедура ПеренестиСвязанныеПоЦепочке(Добавлено, Обновлено)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Очередь.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ПОМЕСТИТЬ ДокументыОчереди
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.Реестр <> """"
	|	И Очередь.Статус <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(Цепочка.ИдентификаторУПД, """") КАК ИдентификаторУПД,
	|	ЕСТЬNULL(Цепочка.ИдентификаторЭТрН, """") КАК ИдентификаторЭТрН
	|ПОМЕСТИТЬ КлючиЦепочек
	|ИЗ
	|	ДокументыОчереди КАК ДокументыОчереди
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ПО Цепочка.ИдентификаторУПД = ДокументыОчереди.ИдентификаторСБИС
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЕСТЬNULL(Цепочка.ИдентификаторУПД, ЕСТЬNULL(ЭТрН.ИдентификаторУПД, """")),
	|	ДокументыОчереди.ИдентификаторСБИС
	|ИЗ
	|	ДокументыОчереди КАК ДокументыОчереди
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ПО Цепочка.ИдентификаторЭТрН = ДокументыОчереди.ИдентификаторСБИС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|		ПО ЭТрН.ИдентификаторСБИС = ДокументыОчереди.ИдентификаторСБИС
	|ГДЕ
	|	ЕСТЬNULL(Цепочка.ИдентификаторУПД, """") <> """"
	|		ИЛИ ЕСТЬNULL(ЭТрН.ИдентификаторУПД, """") <> """"
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	УКД.ИдентификаторОснования,
	|	ЕСТЬNULL(Цепочка.ИдентификаторЭТрН, """")
	|ИЗ
	|	ДокументыОчереди КАК ДокументыОчереди
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|		ПО УКД.ИдентификаторСБИС = ДокументыОчереди.ИдентификаторСБИС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ПО Цепочка.ИдентификаторУПД = УКД.ИдентификаторОснования
	|ГДЕ
	|	УКД.ИдентификаторОснования <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""УПД"" КАК Реестр,
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.Контрагент КАК Контрагент,
	|	УПД.Состояние КАК Состояние
	|ИЗ
	|	КлючиЦепочек КАК КлючиЦепочек
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО УПД.ИдентификаторСБИС = КлючиЦепочек.ИдентификаторУПД
	|ГДЕ
	|	КлючиЦепочек.ИдентификаторУПД <> """"
	|	И УПД.РасхожденийНет
	|	И НЕ УПД.Подписано
	|	И НЕ УПД.Утверждено
	|	И УПД.СтатусПодписания <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""ЭТрН"",
	|	ЭТрН.ИдентификаторСБИС,
	|	ЭТрН.Номер,
	|	ЭТрН.Дата,
	|	ЭТрН.Контрагент,
	|	ЭТрН.Состояние
	|ИЗ
	|	КлючиЦепочек КАК КлючиЦепочек
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|		ПО ЭТрН.ИдентификаторСБИС = КлючиЦепочек.ИдентификаторЭТрН
	|ГДЕ
	|	КлючиЦепочек.ИдентификаторЭТрН <> """"
	|	И ЭТрН.МожноУтвердить
	|	И НЕ ЭТрН.Подписано
	|	И НЕ ЭТрН.Утверждено
	|	И ЭТрН.СтатусПодписания <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("ЭТрН") + "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""ЭТрН"",
	|	ЭТрН.ИдентификаторСБИС,
	|	ЭТрН.Номер,
	|	ЭТрН.Дата,
	|	ЭТрН.Контрагент,
	|	ЭТрН.Состояние
	|ИЗ
	|	КлючиЦепочек КАК КлючиЦепочек
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|		ПО ЭТрН.ИдентификаторУПД = КлючиЦепочек.ИдентификаторУПД
	|ГДЕ
	|	КлючиЦепочек.ИдентификаторУПД <> """"
	|	И ЭТрН.МожноУтвердить
	|	И НЕ ЭТрН.Подписано
	|	И НЕ ЭТрН.Утверждено
	|	И ЭТрН.СтатусПодписания <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|	И " + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("ЭТрН") + "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""УКД"",
	|	УКД.ИдентификаторСБИС,
	|	УКД.Номер,
	|	УКД.Дата,
	|	УКД.Контрагент,
	|	УКД.Состояние
	|ИЗ
	|	КлючиЦепочек КАК КлючиЦепочек
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|		ПО УКД.ИдентификаторОснования = КлючиЦепочек.ИдентификаторУПД
	|ГДЕ
	|	КлючиЦепочек.ИдентификаторУПД <> """"
	|	И УКД.РасхожденийНет
	|	И УКД.ИдентификаторОснования <> """"
	|	И НЕ УКД.Подписано
	|	И НЕ УКД.Утверждено
	|	И УКД.СтатусПодписания <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если ДокументУжеПодписанВСбис(Выборка.Состояние) Тогда
			Продолжить;
		КонецЕсли;

		Если Выборка.Реестр <> "ЭТрН" Тогда
			// Соседа тянет уже стоящий в очереди документ той же поставки.
			// Своей «К отправке» у УКД после ручной сверки нет: сверка пишет
			// «Расхождений нет», а флажок не ставит. ЗапретУтверждения без
			// флажка и без строки очереди такую УКД отвергает - она на
			// подпись не попадает. Флажок ставим до проверки и снимаем,
			// если утверждать всё же нельзя (сумма, закрытый документ).
			ИмяРегистра = ИмяРегистраРеестра(Выборка.Реестр, Выборка.ИдентификаторСБИС);
			Попытка
				Отметка = УстановитьКОтправке(ИмяРегистра, Выборка.ИдентификаторСБИС, Выборка.Реестр);
			Исключение
				ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС,
					"ОчередьОтправки", Ложь,
					ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
			Если ЗначениеЗаполнено(Отметка.Ошибка) Тогда
				ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС,
					"ОчередьОтправки", Ложь, Отметка.Ошибка);
				Продолжить;
			КонецЕсли;

			Запрет = ЭАрМ_УтверждениеСБИС.ЗапретУтверждения(Выборка.Реестр, Выборка.ИдентификаторСБИС, Истина);
			Если ЗначениеЗаполнено(Запрет) Тогда
				Если Отметка.Поставлен Тогда
					Попытка
						СнятьКОтправке(ИмяРегистра, Выборка.ИдентификаторСБИС);
					Исключение
						ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС,
							"ОчередьОтправки", Ложь,
							ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
					КонецПопытки;
				КонецЕсли;
				ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС,
					"ОчередьОтправки", Ложь, Запрет);
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		УстановитьСтатусГотовности(Выборка.Реестр, Выборка.ИдентификаторСБИС);
		ЗаписатьВОчередьОтправки(Выборка.Реестр, Выборка.ИдентификаторСБИС,
			Выборка.Номер, Выборка.Дата, Выборка.Контрагент, Добавлено, Обновлено);

	КонецЦикла;

КонецПроцедуры

// УПД и УКД, утверждённые или подписанные мимо очереди - кнопкой реестра или
// прямо в СБИС, - тоже в «Ожидают отправки»: раньше строка очереди появлялась
// только у документа с «К отправке», и такие документы в АРМ не было видно,
// а ответ Бухгалтерии по ним писался только в журнал.
//
// Строка встаёт сразу в своём статусе и без флажка «Отправить»: второй раз
// в СБИС она не уйдёт.
//   подписан        - «Подтверждено», в комментарии - состояние из СБИС;
//   только утверждён - «Отправлен на подпись», ждём подпись в СБИС.
// Берутся документы за последние ДнейОтправленныхМимоОчереди() дней по дате
// документа: иначе первый же сбор положил бы в очередь всю историю.
//
Процедура ПеренестиОтправленныеМимоОчереди(Добавлено)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	""УПД"" КАК Реестр,
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.Контрагент КАК Контрагент,
	|	УПД.Состояние КАК Состояние,
	|	ВЫБОР
	|		КОГДА УПД.Подписано
	|				ИЛИ УПД.СтатусПодписания = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Подписан,
	|	УПД.ВыгруженВБух КАК ВыгруженВБух
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|		ПО (Очередь.ИдентификаторСБИС = УПД.ИдентификаторСБИС)
	|ГДЕ
	|	Очередь.ИдентификаторСБИС ЕСТЬ NULL
	|	И УПД.Дата >= &НачалоПериода
	|	И УПД.ЗамененаНа = """"
	|	И (УПД.Утверждено
	|			ИЛИ УПД.Подписано
	|			ИЛИ УПД.СтатусПодписания В (
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Утвержден),
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)))
	|	И #УПДНеЗакрыт
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""УКД"",
	|	УКД.ИдентификаторСБИС,
	|	УКД.Номер,
	|	УКД.Дата,
	|	УКД.Контрагент,
	|	УКД.Состояние,
	|	ВЫБОР
	|		КОГДА УКД.Подписано
	|				ИЛИ УКД.СтатусПодписания = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ЛОЖЬ
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|		ПО (Очередь.ИдентификаторСБИС = УКД.ИдентификаторСБИС)
	|ГДЕ
	|	Очередь.ИдентификаторСБИС ЕСТЬ NULL
	|	И УКД.Дата >= &НачалоПериода
	|	И (УКД.Утверждено
	|			ИЛИ УКД.Подписано
	|			ИЛИ УКД.СтатусПодписания В (
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Утвержден),
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)))
	|	И #УКДНеЗакрыт";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#УПДНеЗакрыт",
		"(" + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УПД") + ")");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#УКДНеЗакрыт",
		"(" + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УКД") + ")");
	Запрос.УстановитьПараметр("НачалоПериода",
		НачалоДня(ТекущаяДатаСеанса()) - ДнейОтправленныхМимоОчереди() * 86400);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Состояние = СокрЛП(Выборка.Состояние);

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор);
		МенеджерЗаписи.ИдентификаторСБИС = Выборка.ИдентификаторСБИС;
		МенеджерЗаписи.Реестр            = Выборка.Реестр;
		МенеджерЗаписи.Номер             = Лев(Строка(Выборка.Номер), 50);
		МенеджерЗаписи.ДатаДокумента     = Выборка.Дата;
		МенеджерЗаписи.Контрагент        = Лев(Строка(Выборка.Контрагент), 200);
		ЗаполнитьМагазинЗаписиОчереди(МенеджерЗаписи, Выборка.Реестр, Выборка.ИдентификаторСБИС);
		МенеджерЗаписи.Отправить         = Ложь;
		МенеджерЗаписи.ДатаОтправки      = ТекущаяДатаСеанса();

		Если Выборка.Подписан Тогда
			МенеджерЗаписи.Статус      = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено;
			МенеджерЗаписи.ДатаОтвета  = МенеджерЗаписи.ДатаОтправки;
			МенеджерЗаписи.Комментарий = Лев(?(ЗначениеЗаполнено(Состояние),
				СтрШаблон(НСтр("ru = 'Подписано в СБИС: %1'"), Состояние),
				НСтр("ru = 'Подписано в СБИС'")), 500);
		Иначе
			МенеджерЗаписи.Статус      = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОтправленНаПодпись;
			МенеджерЗаписи.Комментарий = Лев(?(ЗначениеЗаполнено(Состояние),
				СтрШаблон(НСтр("ru = 'Утверждено мимо очереди, ждём подпись в СБИС: %1'"), Состояние),
				НСтр("ru = 'Утверждено мимо очереди, ждём подпись в СБИС'")), 500);
		КонецЕсли;

		// Ответ Бухгалтерии по уже выгруженной УПД писался только в журнал -
		// строки очереди не было; сам ответ придёт в поле при следующем чтении
		Если Выборка.ВыгруженВБух Тогда
			МенеджерЗаписи.Бухгалтерия = НСтр("ru = 'Выгружен в БП'");
		КонецЕсли;

		// Под блокировкой документа и с повторной проверкой: пока шёл запрос,
		// строку мог создать параллельный процесс - иначе дубль
		НачатьТранзакцию();
		Попытка
			ЗаблокироватьДокументОчереди(Выборка.Реестр, Выборка.ИдентификаторСБИС);
			Если ЕстьСтрокаОчередиСБИС(Выборка.ИдентификаторСБИС) Тогда
				ОтменитьТранзакцию();
				Продолжить;
			КонецЕсли;
			МенеджерЗаписи.Записать();
			ЗафиксироватьТранзакцию();
			Добавлено = Добавлено + 1;
		Исключение
			ОтменитьТранзакцию();
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС, "ОчередьОтправки", Ложь,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Есть ли у документа строка очереди СБИС (Реестр заполнен).
//
Функция ЕстьСтрокаОчередиСБИС(ИдентификаторСБИС)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Найдено
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторСБИС = &ИдентификаторСБИС
	|	И Очередь.Реестр <> """"";
	Запрос.УстановитьПараметр("ИдентификаторСБИС", ИдентификаторСБИС);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Убирает дубли очереди СБИС: у одного документа (ИдентификаторСБИС) должна
// быть одна строка. Остаётся строка, дальше всех ушедшая в СБИС:
// «Подтверждено», затем «Отправлен на подпись», «Ошибка отправки», «Готовы
// к отправке»; при равенстве - с более поздней отправкой. Флажок «Отправить»
// и поле «Бухгалтерия» переносятся в оставшуюся, если там пусто.
//
// Возвращаемое значение:
//   Число - сколько строк-дублей удалено
//
Функция УбратьДублиОчереди() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ПОМЕСТИТЬ Дубли
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.Реестр <> """"
	|	И Очередь.ИдентификаторСБИС <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	Очередь.ИдентификаторСБИС
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(*) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Очередь.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Очередь.Реестр КАК Реестр,
	|	Очередь.Номер КАК Номер,
	|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
	|	ВЫБОР
	|		КОГДА Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено)
	|			ТОГДА 1
	|		КОГДА Очередь.Статус В (
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОтправленНаПодпись),
	|				ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает))
	|			ТОГДА 2
	|		КОГДА Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки)
	|			ТОГДА 3
	|		ИНАЧЕ 4
	|	КОНЕЦ КАК Приоритет,
	|	Очередь.ДатаОтправки КАК ДатаОтправки
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Дубли КАК Дубли
	|		ПО Очередь.ИдентификаторСБИС = Дубли.ИдентификаторСБИС
	|ГДЕ
	|	Очередь.Реестр <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИдентификаторСБИС,
	|	Приоритет,
	|	ДатаОтправки УБЫВ";

	Строки = Запрос.Выполнить().Выгрузить();
	Если Строки.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Удалено = 0;
	Индекс = 0;
	Пока Индекс < Строки.Количество() Цикл

		Оставить = Строки[Индекс];
		Лишние = Новый Массив;
		Индекс = Индекс + 1;
		Пока Индекс < Строки.Количество() И Строки[Индекс].ИдентификаторСБИС = Оставить.ИдентификаторСБИС Цикл
			Лишние.Добавить(Строки[Индекс]);
			Индекс = Индекс + 1;
		КонецЦикла;

		НачатьТранзакцию();
		Попытка

			ЗаблокироватьДокументОчереди(Оставить.Реестр, Оставить.ИдентификаторСБИС);

			Основная = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
			Основная.ЭлектронныйДокумент  = Оставить.ЭлектронныйДокумент;
			Основная.ИдентификаторЗапроса = Оставить.ИдентификаторЗапроса;
			Основная.Прочитать();

			Для Каждого Лишняя Из Лишние Цикл
				Дубль = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
				Дубль.ЭлектронныйДокумент  = Лишняя.ЭлектронныйДокумент;
				Дубль.ИдентификаторЗапроса = Лишняя.ИдентификаторЗапроса;
				Дубль.Прочитать();
				Если НЕ Дубль.Выбран() Тогда
					Продолжить;
				КонецЕсли;
				Если Основная.Выбран() Тогда
					// Флажок имеет смысл только у строки, которую ещё можно отправить
					Если Дубль.Отправить И Оставить.Приоритет >= 3 Тогда
						Основная.Отправить = Истина;
					КонецЕсли;
					Если НЕ ЗначениеЗаполнено(Основная.Бухгалтерия) И ЗначениеЗаполнено(Дубль.Бухгалтерия) Тогда
						Основная.Бухгалтерия = Дубль.Бухгалтерия;
					КонецЕсли;
				КонецЕсли;
				Дубль.Удалить();
				Удалено = Удалено + 1;
			КонецЦикла;

			Если Основная.Выбран() Тогда
				Основная.Записать();
			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Оставить.ИдентификаторСБИС, "ОчередьЭДО", Ложь,
				НСтр("ru = 'Дубли очереди не убраны: '") + ЭАрМ_Служебный.КраткийТекстОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;

		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Оставить.ИдентификаторСБИС, "ОчередьЭДО", Истина,
			СтрШаблон(НСтр("ru = '%1 %2: убраны дубли очереди (%3)'"),
				СокрЛП(Оставить.Реестр), СокрЛП(Оставить.Номер), Лишние.Количество()));

	КонецЦикла;

	Возврат Удалено;

КонецФункции

// Глубина, на которую ПеренестиОтправленныеМимоОчереди смотрит назад.
//
Функция ДнейОтправленныхМимоОчереди()

	Возврат 30;

КонецФункции

// Отмечает в реестре, что документ поставлен в очередь на подпись.
//
// Именно «Готов к утверждению», а не «Утвержден»: в очередь документ попадает
// до всякой отправки, и красить его строку жёлтым ещё рано. Жёлтый ставит
// ЭАрМ_УтверждениеСБИС.ОтметитьУтвержденным - после нажатия «Утвердить
// и подписать».
//
Процедура УстановитьСтатусГотовности(Реестр, ИдентификаторСБИС)

	Если Реестр = "ЭТрН" Тогда
		МенеджерЗаписи = РегистрыСведений.ЭАрМ_РеестрЭТрН.СоздатьМенеджерЗаписи();
	ИначеЕсли Реестр = "УКД" Тогда
		МенеджерЗаписи = РегистрыСведений.ЭАрМ_УКД_Входящий.СоздатьМенеджерЗаписи();
	Иначе
		МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	КонецЕсли;

	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторСБИС;
	МенеджерЗаписи.Прочитать();
	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	ПрежнийСтатус = МенеджерЗаписи.СтатусПодписания;
	ЭАрМ_УтверждениеСБИС.ПовыситьСтатусПодписания(МенеджерЗаписи,
		Перечисления.ЭАрМ_СтатусыПодписанияЭДО.ГотовКОтправке);

	Если МенеджерЗаписи.СтатусПодписания <> ПрежнийСтатус Тогда
		МенеджерЗаписи.Записать();
	КонецЕсли;

КонецПроцедуры

// Отметить - Булево - поставить флажок «Отправить»: документ поставил человек
//   кнопкой «Утвердить»/«Получен», а не «Собрать готовые».
//
Процедура ЗаписатьВОчередьОтправки(Реестр, ИдентификаторСБИС, Номер, ДатаДокумента, Контрагент, Добавлено, Обновлено,
	Отметить = Ложь)

	Если НЕ ЗначениеЗаполнено(ИдентификаторСБИС) Тогда
		Возврат;
	КонецЕсли;

	// Строку документа создают параллельно регламент, фоновая автоотправка
	// формы и кнопки. Без блокировки два процесса одновременно не находили
	// строку и оба её создавали - в «Ожидают отправки» появлялись дубли.
	// Блокировка строки документа в реестре держит второй процесс, пока первый
	// не запишет, и второй находит уже созданную строку
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьДокументОчереди(Реестр, ИдентификаторСБИС);
		ЗаписатьВОчередьОтправкиПодБлокировкой(Реестр, ИдентификаторСБИС, Номер, ДатаДокумента, Контрагент,
			Добавлено, Обновлено, Отметить);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Блокирует документ очереди: строку его реестра (УПД, УКД или ЭТрН) по
// ИдентификаторСБИС. У регистра очереди ИдентификаторСБИС - ресурс, по нему
// управляемую блокировку не поставить. Только внутри транзакции.
//
Процедура ЗаблокироватьДокументОчереди(Реестр, ИдентификаторСБИС)

	ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра(
		"РегистрСведений." + ИмяРегистраРеестра(Реестр, ИдентификаторСБИС), ИдентификаторСБИС);

КонецПроцедуры

Процедура ЗаписатьВОчередьОтправкиПодБлокировкой(Реестр, ИдентификаторСБИС, Номер, ДатаДокумента, Контрагент,
	Добавлено, Обновлено, Отметить)

	// Только строки очереди СБИС: подтверждение Далиона с тем же документом
	// (Реестр пустой) - другая строка, её не перезаписываем
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторСБИС = &ИдентификаторСБИС
	|	И Очередь.Реестр <> """"";
	Запрос.УстановитьПараметр("ИдентификаторСБИС", ИдентификаторСБИС);

	Выборка = Запрос.Выполнить().Выбрать();

	МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();

	Если Выборка.Следующий() Тогда
		МенеджерЗаписи.ЭлектронныйДокумент = Выборка.ЭлектронныйДокумент;
		МенеджерЗаписи.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
		МенеджерЗаписи.Прочитать();
		ЭтоНовая = НЕ МенеджерЗаписи.Выбран();
	Иначе
		МенеджерЗаписи.ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор);
		ЭтоНовая = Истина;
	КонецЕсли;

	Если НЕ ЭтоНовая
		И МенеджерЗаписи.Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторСБИС;
	МенеджерЗаписи.Реестр = Реестр;
	МенеджерЗаписи.Номер = Лев(Строка(Номер), 50);
	МенеджерЗаписи.ДатаДокумента = ДатаДокумента;
	МенеджерЗаписи.Контрагент = Лев(Строка(Контрагент), 200);
	ЗаполнитьМагазинЗаписиОчереди(МенеджерЗаписи, Реестр, ИдентификаторСБИС);

	Если ЭтоНовая
		ИЛИ МенеджерЗаписи.Статус <> Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки Тогда
		МенеджерЗаписи.Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке;
		МенеджерЗаписи.НеНайденоПодряд = 0;
		МенеджерЗаписи.ПроверитьПосле = Дата(1, 1, 1);
	КонецЕсли;

	Если ЭтоНовая Тогда
		// Флажок ставит человек в очереди. Раньше новая строка сразу шла
		// в «Подписать отмеченные» вместе с чужими документами.
		МенеджерЗаписи.Отправить = Ложь;
		Добавлено = Добавлено + 1;
	Иначе
		Обновлено = Обновлено + 1;
	КонецЕсли;

	Если Отметить Тогда
		МенеджерЗаписи.Отправить = Истина;
		// Постановка заново прошла запрет утверждения: прежняя «Ошибка отправки»
		// (часто - сумма до ручной сверки) больше не держит документ до повтора.
		Если МенеджерЗаписи.Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки Тогда
			МенеджерЗаписи.Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке;
			МенеджерЗаписи.СледующаяПопытка = Дата(1, 1, 1);
		КонецЕсли;
	КонецЕсли;

	МенеджерЗаписи.Записать();

КонецПроцедуры

// Склад прихода Далион, иначе организация документа ЭДО. Пишется в очередь
// для отбора по магазинам; колонка на форме не выводится.
//
Процедура ЗаполнитьМагазинЗаписиОчереди(МенеджерЗаписи, Реестр, ИдентификаторСБИС)

	Магазин = МагазинДокументаОчереди(Реестр, ИдентификаторСБИС);
	Если ЗначениеЗаполнено(Магазин) Тогда
		МенеджерЗаписи.Магазин = Магазин;
	КонецЕсли;

КонецПроцедуры

Функция МагазинДокументаОчереди(Реестр, ИдентификаторСБИС)

	Если НЕ ЗначениеЗаполнено(ИдентификаторСБИС) Тогда
		Возврат "";
	КонецЕсли;

	Склад = СкладЦепочкиДокумента(Реестр, ИдентификаторСБИС);
	Если ЗначениеЗаполнено(Склад) Тогда
		Возврат Лев(Склад, 200);
	КонецЕсли;

	Если Реестр = "ЭТрН" Тогда
		МенеджерЗаписи = РегистрыСведений.ЭАрМ_РеестрЭТрН.СоздатьМенеджерЗаписи();
	ИначеЕсли Реестр = "УКД" Тогда
		МенеджерЗаписи = РегистрыСведений.ЭАрМ_УКД_Входящий.СоздатьМенеджерЗаписи();
	Иначе
		МенеджерЗаписи = РегистрыСведений.ЭАрМ_УПД_Входящий.СоздатьМенеджерЗаписи();
	КонецЕсли;

	МенеджерЗаписи.ИдентификаторСБИС = ИдентификаторСБИС;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		Возврат Лев(СокрЛП(МенеджерЗаписи.Организация), 200);
	КонецЕсли;

	Возврат "";

КонецФункции

Функция СкладЦепочкиДокумента(Реестр, ИдентификаторСБИС)

	ИдентификаторУПД = "";
	ИдентификаторЭТрН = "";

	Если Реестр = "ЭТрН" Тогда
		ИдентификаторЭТрН = ИдентификаторСБИС;
		МенеджерЭТрН = РегистрыСведений.ЭАрМ_РеестрЭТрН.СоздатьМенеджерЗаписи();
		МенеджерЭТрН.ИдентификаторСБИС = ИдентификаторСБИС;
		МенеджерЭТрН.Прочитать();
		Если МенеджерЭТрН.Выбран() Тогда
			ИдентификаторУПД = СокрЛП(МенеджерЭТрН.ИдентификаторУПД);
		КонецЕсли;
	ИначеЕсли Реестр = "УКД" Тогда
		МенеджерУКД = РегистрыСведений.ЭАрМ_УКД_Входящий.СоздатьМенеджерЗаписи();
		МенеджерУКД.ИдентификаторСБИС = ИдентификаторСБИС;
		МенеджерУКД.Прочитать();
		Если МенеджерУКД.Выбран() Тогда
			ИдентификаторУПД = СокрЛП(МенеджерУКД.ИдентификаторОснования);
		КонецЕсли;
	Иначе
		ИдентификаторУПД = ИдентификаторСБИС;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Склад КАК Склад
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Товары
	|ГДЕ
	|	Товары.Склад <> """"
	|	И &ИдентификаторУПД <> """"
	|	И Товары.ИдентификаторУПД = &ИдентификаторУПД
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Товары.Склад
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Товары
	|		ПО Товары.ИдентификаторПоступления = Цепочка.ИдентификаторПоступления
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления <> """"
	|	И Товары.Склад <> """"
	|	И (&ИдентификаторУПД <> """"
	|			И Цепочка.ИдентификаторУПД = &ИдентификаторУПД
	|		ИЛИ &ИдентификаторЭТрН <> """"
	|			И Цепочка.ИдентификаторЭТрН = &ИдентификаторЭТрН)";
	Запрос.УстановитьПараметр("ИдентификаторУПД", ИдентификаторУПД);
	Запрос.УстановитьПараметр("ИдентификаторЭТрН", ИдентификаторЭТрН);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.Склад);
	КонецЕсли;

	Возврат "";

КонецФункции

// Склады Далиона из реестра товаров заказов: ими заполняется отбор «Магазин».
//
Функция МагазиныДляОтбора() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Реестр.Склад КАК Магазин
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрТоваровЗаказов КАК Реестр
	|ГДЕ
	|	Реестр.Склад <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Магазин";

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Магазин");

КонецФункции

// Магазин строкам очереди без него. Только свежие документы и не больше
// порции за раз: строка, магазин которой не найти, остаётся пустой, и без
// ограничения перебиралась бы заново на каждом проходе регламента.
//
Процедура ДозаполнитьМагазинОчереди() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 200
	|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
	|	Очередь.Реестр КАК Реестр,
	|	Очередь.ИдентификаторСБИС КАК ИдентификаторСБИС
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.Реестр <> """"
	|	И Очередь.ИдентификаторСБИС <> """"
	|	И Очередь.Магазин = """"
	|	И Очередь.ДатаДокумента >= &НачалоПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.ДатаДокумента УБЫВ";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ТекущаяДатаСеанса()) - 14 * 86400);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЭлектронныйДокумент = Выборка.ЭлектронныйДокумент;
		МенеджерЗаписи.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
		МенеджерЗаписи.Прочитать();
		Если НЕ МенеджерЗаписи.Выбран() Тогда
			Продолжить;
		КонецЕсли;

		ЗаполнитьМагазинЗаписиОчереди(МенеджерЗаписи, Выборка.Реестр, Выборка.ИдентификаторСБИС);
		Если ЗначениеЗаполнено(МенеджерЗаписи.Магазин) Тогда
			МенеджерЗаписи.Записать();
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Сбой одного шага регламентного задания - в журнал обмена и журнал
// регистрации; остальные шаги продолжаются.
//
Процедура ЗаписатьСбойШагаЗадания(ИмяШага, ИнфОбОшибке)

	Текст = СтрШаблон("%1: %2", ИмяШага, ЭАрМ_Служебный.ТекстИсключения(ИнфОбОшибке));

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ПроверкаПапкиОбмена", УровеньЖурналаРегистрации.Ошибка, , ,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнфОбОшибке));

	Попытка
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ПроверкаПапки", Ложь, Текст);
	Исключение
		// Журнал обмена недоступен - запись в журнале регистрации уже есть
	КонецПопытки;

КонецПроцедуры

// Документ уже утверждён или выполнен в СБИС: в очередь на подпись его не кладём.
//
Функция ДокументУжеПодписанВСбис(Состояние)

	Возврат ЭАрМ_УтверждениеСБИС.СостояниеГоворитОПодписи(Состояние);

КонецФункции

// Автоотправка: готовые УПД/УКД и ЭТрН регламент ставит «К отправке» и кладёт
// в «Ожидают отправки» с отметкой «Отправить» - то же, что кнопки «Утвердить»
// и «Получен» (ПоставитьДокументНаУтверждение: те же запреты).
//
// УПД и УКД - флажок «Автоотправка УПД» (АвтоотправкаУПД). ЭТрН - «Автоотправка
// ЭТрН» (АвтоотправкаЭТрН). По умолчанию оба выключены. За проход - не больше
// РазмерПачкиАвтоотправки() документов, старые первыми.
//
// Документ, которому утверждение запрещено, встаёт в очередь «Ошибка
// отправки» с причиной: иначе он возглавлял бы каждую пачку и держал
// остальные. После исправления его отмечают в очереди вручную.
//
// Подпись этим шагом не делается: ключ подписанта у пользователя. Отправляет
// форма очереди или регламент ЭАрМ_ОтправкаОчередиСБИС (см. ДокументыДляАвтоотправки).
//
// Возвращаемое значение:
//   Число - сколько документов поставлено в очередь с отметкой
//
Функция АвтоотправкаГотовыхУПД() Экспорт

	БратьУПД  = ЭАрМ_НастройкиСервер.ЗначениеНастройки("АвтоотправкаУПД") = Истина;
	БратьЭТрН = ЭАрМ_НастройкиСервер.ЗначениеНастройки("АвтоотправкаЭТрН") = Истина;
	Если НЕ БратьУПД И НЕ БратьЭТрН Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	""УПД"" КАК Реестр,
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.Контрагент КАК Контрагент
	|ПОМЕСТИТЬ Готовые
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	&БратьУПД
	|	И УПД.СтатусПодписания = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.ГотовКОтправке)
	|	И УПД.РасхожденийНет
	|	И НЕ УПД.Утверждено
	|	И НЕ УПД.Подписано
	|	И УПД.ЗамененаНа = """"
	|	И #УПДНеЗакрыт
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""УКД"",
	|	УКД.ИдентификаторСБИС,
	|	УКД.Номер,
	|	УКД.Дата,
	|	УКД.Контрагент
	|ИЗ
	|	РегистрСведений.ЭАрМ_УКД_Входящий КАК УКД
	|ГДЕ
	|	&БратьУПД
	|	И УКД.СтатусПодписания = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.ГотовКОтправке)
	|	И УКД.РасхожденийНет
	|	И УКД.ИдентификаторОснования <> """"
	|	И НЕ УКД.Утверждено
	|	И НЕ УКД.Подписано
	|	И #УКДНеЗакрыт
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""ЭТрН"",
	|	ЭТрН.ИдентификаторСБИС,
	|	ЭТрН.Номер,
	|	ЭТрН.Дата,
	|	ЭТрН.Контрагент
	|ИЗ
	|	РегистрСведений.ЭАрМ_РеестрЭТрН КАК ЭТрН
	|ГДЕ
	|	&БратьЭТрН
	|	И ЭТрН.МожноУтвердить
	|	И НЕ ЭТрН.Подписано
	|	И НЕ ЭТрН.Утверждено
	|	И ЭТрН.СтатусПодписания <> ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыПодписанияЭДО.Подписан)
	|	И #ЭТрННеЗакрыт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ " + Формат(РазмерПачкиАвтоотправки(), "ЧГ=0") + "
	|	Готовые.Реестр КАК Реестр,
	|	Готовые.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Готовые.Номер КАК Номер,
	|	Готовые.Дата КАК Дата,
	|	Готовые.Контрагент КАК Контрагент
	|ИЗ
	|	Готовые КАК Готовые
	|ГДЕ
	|	НЕ Готовые.ИдентификаторСБИС В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					Очередь.ИдентификаторСБИС
	|				ИЗ
	|					РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|				ГДЕ
	|					Очередь.Реестр <> """"
	|					И (Очередь.Отправить
	|						ИЛИ Очередь.Статус В (
	|							ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОтправленНаПодпись),
	|							ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено),
	|							ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки),
	|							ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Отклонено))))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#УПДНеЗакрыт",
		"(" + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УПД") + ")");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#УКДНеЗакрыт",
		"(" + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("УКД") + ")");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ЭТрННеЗакрыт",
		"(" + ЭАрМ_УтверждениеСБИС.УсловиеДокументНеЗакрыт("ЭТрН") + ")");
	Запрос.УстановитьПараметр("БратьУПД", БратьУПД);
	Запрос.УстановитьПараметр("БратьЭТрН", БратьЭТрН);

	Поставлено = 0;
	Отказов = 0;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Ошибка = ПоставитьДокументНаУтверждение(Выборка.Реестр, Выборка.ИдентификаторСБИС);

		Если НЕ ЗначениеЗаполнено(Ошибка) Тогда
			Поставлено = Поставлено + 1;
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС, "АвтоотправкаУПД", Истина,
				СтрШаблон(НСтр("ru = '%1 %2: «К отправке», в очереди отмечен к отправке'"),
					Выборка.Реестр, Выборка.Номер));
			Если Выборка.Реестр = "УПД" Тогда
				Корректировки = ПоставитьГотовыеКорректировки(Выборка.ИдентификаторСБИС);
				Поставлено = Поставлено + Корректировки.Поставлено;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		// Запрет - строкой очереди с причиной, чтобы не стоять первым в каждой пачке
		Отказов = Отказов + 1;
		Попытка
			Добавлено = 0;
			Обновлено = 0;
			ЗаписатьВОчередьОтправки(Выборка.Реестр, Выборка.ИдентификаторСБИС, Выборка.Номер,
				Выборка.Дата, Выборка.Контрагент, Добавлено, Обновлено);
			ОтметитьОчередьПоДокументу(Выборка.ИдентификаторСБИС, Ложь,
				НСтр("ru = 'Автоотправка: '") + Ошибка);
		Исключение
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС, "АвтоотправкаУПД", Ложь,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Выборка.ИдентификаторСБИС, "АвтоотправкаУПД", Ложь, Ошибка);

	КонецЦикла;

	Если Поставлено + Отказов > 0 Тогда
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "АвтоотправкаУПД", Отказов = 0,
			СтрШаблон(НСтр("ru = 'Автоотправка УПД: отмечено к отправке %1, утверждать нельзя %2'"),
				Поставлено, Отказов));
	КонецЕсли;

	Если Поставлено > 0 Тогда
		ЗапуститьОтправкуОчередиВФоне();
	КонецЕсли;

	Возврат Поставлено;

КонецФункции

// --- Отправка очереди в СБИС на сервере ---
//
// Всё, что попало в очередь «Ожидают отправки» (строки СБИС в статусе «Готов
// к отправке»), уходит в СБИС само - фоновым заданием с ключом
// КлючОтправкиОчереди(): подготовка в СБИС, подпись на сервере ключом
// подписанта отправки очереди (настройка ПодписантОтправкиОчереди, выбирается
// в шапке формы очереди), отправка подписей. Запуск:
//   - регламентное задание (ЭАрМ_Вызов) - каждый проход;
//   - сразу после попадания в очередь: СобратьГотовыеКОтправке,
//     ПоставитьНаУтверждение, АвтоотправкаГотовыхУПД.
// Работает, только если включён флажок «Автоотправка» (АвтоотправкаУПД) и ключ
// подписанта установлен на сервере (ЭАрМ_УтверждениеСБИС.СредстваПодписиНаСервере).
// Иначе - как раньше: подписывает открытая форма ключом компьютера.

// Подписант, от имени которого очередь уходит в СБИС (1 или 2).
//
Функция ПодписантОтправкиОчереди() Экспорт

	Значение = ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПодписантОтправкиОчереди");
	Попытка
		Номер = Число(Значение);
	Исключение
		Номер = 0;
	КонецПопытки;

	Возврат ?(Номер = 2, 2, 1);

КонецФункции

// Отправка очереди с сервера возможна: флажок включён и ключ подписанта
// стоит на сервере.
//
Функция ОтправкаОчередиНаСервереНастроена(ТекстОшибки = "") Экспорт

	Если ЭАрМ_НастройкиСервер.ЗначениеНастройки("АвтоотправкаУПД") <> Истина Тогда
		ТекстОшибки = НСтр("ru = 'выключен флажок «Автоотправка»'");
		Возврат Ложь;
	КонецЕсли;

	Если МестоПодписиОчереди() <> "Сервер" Тогда
		ТекстОшибки = НСтр("ru = 'выбрана подпись на клиенте'");
		Возврат Ложь;
	КонецЕсли;

	Возврат ЭАрМ_УтверждениеСБИС.СредстваПодписиНаСервере(ПодписантОтправкиОчереди(), ТекстОшибки) <> Неопределено;

КонецФункции

// Где подписывается очередь (настройка МестоПодписиОчереди):
//   "Клиент" (по умолчанию) - открытая форма очереди или реестра УПД ключом
//             своего компьютера; регламент только сверяет и ставит в очередь;
//   "Сервер"  - регламентное задание ключом на сервере 1С; формы не подписывают.
//
Функция МестоПодписиОчереди() Экспорт

	Значение = СокрЛП(Строка(ЭАрМ_НастройкиСервер.ЗначениеНастройки("МестоПодписиОчереди")));
	Возврат ?(ВРег(Значение) = "СЕРВЕР", "Сервер", "Клиент");

КонецФункции

Процедура УстановитьМестоПодписиОчереди(Знач Место) Экспорт

	ЭАрМ_НастройкиСервер.СохранитьНастройку("МестоПодписиОчереди",
		?(ВРег(СокрЛП(Место)) = "СЕРВЕР", "Сервер", "Клиент"));

КонецПроцедуры

Функция КлючОтправкиОчереди()

	Возврат "ЭАрМ_ОтправкаОчередиСБИС";

КонецФункции

// Запускает отправку очереди фоновым заданием (не ждёт). Уже идёт - не
// запускает второе: ключ. Внутри транзакции не запускает - строки очереди ещё
// не видны заданию, их заберёт следующий запуск.
//
Процедура ЗапуститьОтправкуОчередиВФоне() Экспорт

	Если ТранзакцияАктивна()
		ИЛИ ЭАрМ_НастройкиСервер.ФоновыеЗаданияОтключены()
		ИЛИ ЭАрМ_НастройкиСервер.ЗначениеНастройки("АвтоотправкаУПД") <> Истина Тогда
		Возврат;
	КонецЕсли;

	// Тот же метод и ключ, что у регламентного задания ЭАрМ_ОтправкаОчередиСБИС:
	// платформа не даст запустить второе, пока идёт первое
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(Ложь);
	Попытка
		ФоновыеЗадания.Выполнить("ЭАрМ_ОбработкаПодтвержденийЭДО.ОтправитьОчередьПоРасписанию",
			ПараметрыЗадания, КлючОтправкиОчереди(), НСтр("ru = 'ЭДО: отправка очереди в СБИС'"));
	Исключение
		// Отправка уже идёт - она и заберёт новые строки
	КонецПопытки;

КонецПроцедуры

// Точка входа регламентного задания ЭАрМ_ОтправкаОчередиСБИС, запуска из кода
// (ЗапуститьОтправкуОчередиВФоне) и кнопки «Отправить неотправленное сейчас» формы
// настроек (ЗапуститьОтправкуНеотправленногоСейчас). Каждый шаг - в ОтметитьХодОтправки:
// форма показывает, что происходит и какой документ уходит.
//
// Параметры:
//   ИзРегламента - Булево - Ложь при запуске из кода и кнопкой
//   ПолныйПроход - Булево - сверка, постановка готовых и проверка подписей, как у регламента;
//                  Неопределено - как ИзРегламента (запуск из кода только отправляет)
//
Процедура ОтправитьОчередьПоРасписанию(ИзРегламента = Истина, ПолныйПроход = Неопределено) Экспорт

	Полный = ?(ПолныйПроход = Неопределено, ИзРегламента, ПолныйПроход = Истина);

	Если ЭАрМ_НастройкиСервер.ФоновыеЗаданияОтключены() Тогда
		ОтметитьХодОтправки(НСтр("ru = 'не запущено: в настройках отключены все фоновые задания ЭДО'"));
		Возврат;
	КонецЕсли;

	Если ИзРегламента Тогда
		Попытка
			ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
				Метаданные.РегламентныеЗадания.ЭАрМ_ОтправкаОчередиСБИС);
		Исключение
			ЭАрМ_Служебный.ЗаписатьОшибку("ОтправитьОчередьПоРасписанию",
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	ОтметитьХодОтправки(?(ИзРегламента, НСтр("ru = 'запуск по расписанию'"),
		?(Полный, НСтр("ru = 'запуск кнопкой «Отправить неотправленное сейчас»'"), НСтр("ru = 'запуск после постановки в очередь'"))));

	// По расписанию - и то, что раньше делала только открытая форма реестра
	// УПД: сверка ожидающих цепочек и постановка сошедшихся в очередь. Без
	// этого при закрытом реестре УПД не становились «Готов к утверждению» и
	// в очередь ничего не попадало. Запуск из кода (сразу после постановки)
	// сверку не делает - он только отправляет
	Если Полный Тогда
		ОтметитьХодОтправки(НСтр("ru = 'сверка ожидающих цепочек и постановка готовых УПД и УКД в очередь'"));
		СверитьИПоставитьГотовые();
	КонецЕсли;

	Итог = Неопределено;
	Попытка
		Итог = ОтправитьОчередьВСБИС();
	Исключение
		ТекстСбоя = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "СБИС: ОтправитьОчередьВСБИС", ИнформацияОбОшибке());
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ОтправкаОчереди", Ложь, ТекстСбоя);
		ОтметитьХодОтправки(НСтр("ru = 'СБОЙ отправки: '") + ТекстСбоя);
	КонецПопытки;

	// Подписанное и не отправленное в Бух - тем же заданием (если включён автообмен с БП)
	ТекстБух = "";
	Если Полный Тогда
		ТекстБух = ВыгрузитьВБухПоРасписанию(Итог);
	КонецЕсли;

	// Проверка подписи отправленных (УПД, УКД, ЭТрН) - и здесь, а не только в
	// ЭАрМ_Вызов: без расписания у того задания «Отправлен на подпись» не
	// становилось «Подтверждено» никогда
	Если Полный Тогда
		ОтметитьХодОтправки(НСтр("ru = 'проверка подписи отправленных в СБИС'"), 0, 0, Итог);
		Попытка
			ПроверитьПодписиВОчереди("", Истина);
		Исключение
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "СБИС: ПроверитьПодписиВОчереди", ИнформацияОбОшибке());
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ОчередьЭДО", Ложь,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Если Итог <> Неопределено Тогда
		ОтметитьХодОтправки(НСтр("ru = 'окончено: СБИС - '") + ?(ЗначениеЗаполнено(Итог.Текст), Итог.Текст,
			НСтр("ru = 'в очереди нечего отправлять'")) + ?(ЗначениеЗаполнено(ТекстБух), НСтр("ru = '; Бух - '") + ТекстБух, ""),
			0, 0, Итог);
	КонецЕсли;

КонецПроцедуры

// Сверка ожидающих цепочек (как таймер открытой формы реестра УПД) и
// постановка сошедшихся УПД и УКД в очередь. Только при включённой очереди
// (флажок «Автоотправка»). Идёт автосверка открытой формы - сверку
// пропускаем, чтобы не спорить за блокировки цепочек.
//
Процедура СверитьИПоставитьГотовые() Экспорт

	Если ЭАрМ_НастройкиСервер.ЗначениеНастройки("АвтоотправкаУПД") <> Истина Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ФоновоеЗаданиеИдёт("ЭАрМ_АвтосверкаУПД") Тогда
		Попытка
			ЭАрМ_СверкаТоваровЦепочки.СверитьОжидающиеДляФормы();
		Исключение
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ОтправкаОчереди", Ложь,
				НСтр("ru = 'Сверка цепочек перед отправкой: '")
				+ ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Попытка
		АвтоотправкаГотовыхУПД();
	Исключение
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "АвтоотправкаУПД", Ложь,
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция ФоновоеЗаданиеИдёт(Ключ)

	УстановитьПривилегированныйРежим(Истина);
	Отбор = Новый Структура("Ключ, Состояние", Ключ, СостояниеФоновогоЗадания.Активно);
	Возврат ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0;

КонецФункции

// Идёт ли сейчас отправка очереди (регламентом или запуском из кода) - для
// индикатора в шапке формы очереди.
//
Функция ОтправкаОчередиИдёт() Экспорт

	Возврат ФоновоеЗаданиеИдёт(КлючОтправкиОчереди());

КонецФункции

// Для индикатора отправки в шапке формы очереди.
//
// Возвращаемое значение:
//   Структура:
//     * Включено            - Булево - флажок «Автоотправка»
//     * Место               - Строка - "Клиент" / "Сервер"
//     * Идёт                - Булево - задание отправки сейчас работает
//     * СекундИдёт          - Число  - сколько уже идёт
//     * СекундДоСледующего  - Число  - до следующего запуска по расписанию; -1 - неизвестно
//     * СекундДоПовтора     - Число  - до ближайшего повтора «Ошибки отправки»; -1 - нет
//     * ЖдутОтправки        - Число
//
Функция СостояниеИндикатораОтправки() Экспорт

	Результат = Новый Структура("Включено, Место, Идёт, ИдётБухгалтерия, СекундИдёт, СекундДоСледующего, СекундДоПовтора, ЖдутОтправки, СегодняУПД, СегодняЭТрН, СегодняУКД",
		ЭАрМ_НастройкиСервер.ЗначениеНастройки("АвтоотправкаУПД") = Истина, МестоПодписиОчереди(),
		Ложь, Ложь, 0, -1, -1, 0, 0, 0, 0);

	УстановитьПривилегированныйРежим(Истина);

	// Время фоновых заданий - время сервера, поэтому и «сейчас» - ТекущаяДата()
	Сейчас = ТекущаяДата();
	Отбор = Новый Структура("Ключ, Состояние", КлючОтправкиОчереди(), СостояниеФоновогоЗадания.Активно);
	Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл
		Результат.Идёт = Истина;
		Результат.СекундИдёт = Макс(0, Сейчас - Задание.Начало);
	КонецЦикла;

	Попытка
		Результат.ИдётБухгалтерия = ЭАрМ_ВыгрузкаНакладныхДляБух.ВыгрузкаИдетВФоне();
	Исключение
		Результат.ИдётБухгалтерия = Ложь;
	КонецПопытки;

	Попытка
		Регламентное = РегламентныеЗадания.НайтиПредопределенное(
			Метаданные.РегламентныеЗадания.ЭАрМ_ОтправкаОчередиСБИС);
		Если Регламентное <> Неопределено И Регламентное.Использование Тогда
			Последнее = Регламентное.ПоследнееЗадание;
			Если Последнее <> Неопределено Тогда
				// Отсчёт от конца прошлого запуска: иначе таймер «следующая через»
				// тикал от начала задания и обнулялся, пока оно ещё шло
				МоментОтсчёта = ?(ЗначениеЗаполнено(Последнее.Конец), Последнее.Конец, Последнее.Начало);
				Результат.СекундДоСледующего = Макс(0,
					МоментОтсчёта + ИнтервалОтправкиОчереди() * 60 - Сейчас);
			Иначе
				Результат.СекундДоСледующего = 0;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Результат.СекундДоСледующего = -1;
	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МИНИМУМ(Очередь.СледующаяПопытка) КАК БлижайшийПовтор
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.Реестр <> """"
	|	И Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки)
	|	И Очередь.СледующаяПопытка > ДАТАВРЕМЯ(1, 1, 1)";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ТипЗнч(Выборка.БлижайшийПовтор) = Тип("Дата") Тогда
		Результат.СекундДоПовтора = Макс(0, Выборка.БлижайшийПовтор - ТекущаяДатаСеанса());
	КонецЕсли;

	Счетчики = СчетчикиОчереди();
	Результат.ЖдутОтправки = Счетчики.ЖдутОтправки;
	Результат.СегодняУПД  = Счетчики.СегодняУПД;
	Результат.СегодняЭТрН = Счетчики.СегодняЭТрН;
	Результат.СегодняУКД  = Счетчики.СегодняУКД;

	Возврат Результат;

КонецФункции

// Интервал регламентной отправки очереди, минут (настройка
// ИнтервалОтправкиОчереди, по умолчанию 5).
//
Функция ИнтервалОтправкиОчереди() Экспорт

	Попытка
		Минуты = Число(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ИнтервалОтправкиОчереди"));
	Исключение
		Минуты = 0;
	КонецПопытки;

	Возврат ?(Минуты > 0, Мин(Минуты, 1440), 5);

КонецФункции

// Сохраняет интервал и сразу переставляет расписание задания.
//
Процедура УстановитьИнтервалОтправкиОчереди(Знач Минуты) Экспорт

	Минуты = Макс(1, Мин(Окр(Минуты), 1440));
	ЭАрМ_НастройкиСервер.СохранитьНастройку("ИнтервалОтправкиОчереди", Формат(Минуты, "ЧГ=0"));
	ПроверитьРасписаниеОтправкиОчереди();

КонецПроцедуры

// Приводит расписание предопределённого задания ЭАрМ_ОтправкаОчередиСБИС
// к интервалу из настройки: «каждый день, повтор через N минут». Пустое
// расписание задания (новая база) тем самым получает 5 минут. Задание и
// функциональная опция ЭАрМ_ОчередьОтправкиСБИС включены, пока включён
// флажок «Автоотправка». Пишет, только если что-то расходится.
//
Процедура ПроверитьРасписаниеОтправкиОчереди() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	// Функциональная опция ЭАрМ_ОчередьОтправкиСБИС хранится в константе и
	// повторяет флажок «Автоотправка» (его пишут и форма очереди, и реестр УПД)
	Включено = (ЭАрМ_НастройкиСервер.ЗначениеНастройки("АвтоотправкаУПД") = Истина);
	Если Константы.ЭАрМ_ИспользоватьОчередьОтправкиСБИС.Получить() <> Включено Тогда
		Константы.ЭАрМ_ИспользоватьОчередьОтправкиСБИС.Установить(Включено);
	КонецЕсли;

	Задание = РегламентныеЗадания.НайтиПредопределенное(
		Метаданные.РегламентныеЗадания.ЭАрМ_ОтправкаОчередиСБИС);
	Если Задание = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Секунд = ИнтервалОтправкиОчереди() * 60;
	// Задание работает, пока есть что отправлять: в СБИС (флажок) или в Бух (автообмен с БП)
	Включено = Включено ИЛИ ВыгрузкаВБухПоРасписанию();
	Если Задание.Использование = Включено
		И Задание.Расписание.ПериодПовтораДней = 1
		И Задание.Расписание.ПериодПовтораВТечениеДня = Секунд Тогда
		Возврат;
	КонецЕсли;

	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ПериодПовтораДней = 1;
	Расписание.ПериодПовтораВТечениеДня = Секунд;

	Задание.Расписание = Расписание;
	Задание.Использование = Включено;
	Задание.Записать();

КонецПроцедуры

// Отправляет в СБИС всё, что ждёт в очереди: пачками по РазмерПачкиОтправки(),
// не больше ПачекЗаЗапускОтправки() пачек за запуск (обе - настройки, вкладка
// «Отправка и регламенты» формы настроек; по умолчанию 5 документов и 20 пачек). Документ, который не подготовился или не
// подписался, получает «Ошибка отправки» с причиной - иначе он возглавлял бы
// каждую пачку (исправляют и отправляют кнопкой). Не подготовился ни один
// документ пачки - это сбой СБИС, а не документов: запуск прекращается без
// отметок, следующий попробует снова.
//
// Возвращаемое значение:
//   Структура - Отправлено, Ошибок (Число), Текст (Строка)
//
Функция ОтправитьОчередьВСБИС() Экспорт

	Итог = Новый Структура("Отправлено, Ошибок, Текст, УПД, ЭТрН, УКД, Подписано", 0, 0, "", 0, 0, 0, 0);

	ТекстОшибки = "";
	Если НЕ ОтправкаОчередиНаСервереНастроена(ТекстОшибки) Тогда
		Итог.Текст = НСтр("ru = 'Отправка очереди с сервера не выполняется: '") + ТекстОшибки;
		// Так настроено (флажок «Автоотправка» выключен или подпись на клиенте) - не
		// ошибка: очередь отправляет форма «Ожидают отправки». В «ОШИБКА ПРОВЕРКИ» это
		// только засоряло файл ошибок
		ЭАрМ_ПриемПакетовДалион.Трасса("", "СБИС: " + Итог.Текст + " - так настроено, очередь отправляется из формы «Ожидают отправки»");
		ОтметитьХодОтправки(Итог.Текст + НСтр("ru = ' - регламент только ставит готовые в очередь, подписывает и отправляет форма «Ожидают отправки» или реестр УПД'"));
		Возврат Итог;
	КонецЕсли;

	НомерПодписанта = ПодписантОтправкиОчереди();
	Средства = ЭАрМ_УтверждениеСБИС.СредстваПодписиНаСервере(НомерПодписанта, ТекстОшибки);
	Если Средства = Неопределено Тогда
		Итог.Текст = ТекстОшибки;
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки("", "СБИС: отправка очереди",
			"нет средств подписи для подписанта " + НомерПодписанта + ": " + ТекстОшибки);
		ОтметитьХодОтправки(СтрШаблон(НСтр("ru = 'не отправлено: нет средств подписи на сервере для подписанта %1: %2'"),
			НомерПодписанта, ТекстОшибки));
		Возврат Итог;
	КонецЕсли;

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ОтправкаОчереди", Истина,
		НСтр("ru = 'Запуск отправки очереди в СБИС'"));
	ЭАрМ_ПриемПакетовДалион.Трасса("", "СБИС: запуск отправки очереди, подписант " + НомерПодписанта);

	Исключить = Новый Массив;

	Пачек = ПачекЗаЗапускОтправки();
	Для Проход = 1 По Пачек Цикл

		// Повтор по времени Исключить не видит - за один запуск документ всё
		// равно уходит не больше раза
		ДокументыПачки = Новый Массив;
		Для Каждого ДокументОчереди Из ДокументыДляАвтоотправки(Исключить) Цикл
			Если Исключить.Найти(ДокументОчереди.ИдентификаторСБИС) = Неопределено Тогда
				ДокументыПачки.Добавить(ДокументОчереди);
			КонецЕсли;
		КонецЦикла;
		Если ДокументыПачки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Для Каждого ДокументОчереди Из ДокументыПачки Цикл
			Исключить.Добавить(ДокументОчереди.ИдентификаторСБИС);
		КонецЦикла;
		СоставПачки = Новый Массив;
		Для Каждого ДокументОчереди Из ДокументыПачки Цикл
			СоставПачки.Добавить(СтрШаблон("%1 № %2 (%3)", ДокументОчереди.Реестр, ДокументОчереди.Номер,
				ДокументОчереди.ИдентификаторСБИС));
		КонецЦикла;
		ЭАрМ_ПриемПакетовДалион.Трасса("", СтрШаблон("СБИС: пачка %1 - документов %2: %3", Проход,
			ДокументыПачки.Количество(), СтрСоединить(СоставПачки, "; ")));
		ОтметитьХодОтправки(СтрШаблон(НСтр("ru = 'подготовка в СБИС: документов %1'"), ДокументыПачки.Количество()),
			Проход, Пачек, Итог, ДокументыДляХода(ДокументыПачки));

		Подготовка = ЭАрМ_УтверждениеСБИС.ПодготовитьПакетПодписания(ДокументыПачки, НомерПодписанта);

		Если Подготовка.Подписания.Количество() = 0 Тогда
			// Ни один не подготовился - скорее всего СБИС недоступен
			Итог.Текст = СтрСоединить(Подготовка.Ошибки, Символы.ПС);
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки("", "СБИС: подготовка пачки " + Проход,
				"ни один документ не подготовлен к подписи: " + СтрЗаменить(Итог.Текст, Символы.ПС, " | "));
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ОтправкаОчереди", Ложь,
				НСтр("ru = 'Отправка очереди прервана, ни один документ пачки не подготовлен: '") + Итог.Текст);
			Прервать;
		КонецЕсли;

		// Не подготовленные - «Ошибка отправки» с причиной
		Подготовленные = Новый Соответствие;
		Для Каждого Подписание Из Подготовка.Подписания Цикл
			Подготовленные.Вставить(Подписание.ИдентификаторЗапроса, Истина);
		КонецЦикла;
		Для Каждого ДокументОчереди Из ДокументыПачки Цикл
			Если Подготовленные.Получить(ДокументОчереди.ИдентификаторЗапроса) = Неопределено Тогда
				ОтметитьПослеОтправкиСБИС(ДокументОчереди.ИдентификаторЗапроса, Ложь,
					ОшибкаДокументаПачки(ДокументОчереди, Подготовка.Ошибки));
				ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки(ДокументОчереди.ИдентификаторСБИС, "СБИС: подготовка к подписи",
					ОшибкаДокументаПачки(ДокументОчереди, Подготовка.Ошибки));
				Итог.Ошибок = Итог.Ошибок + 1;
			КонецЕсли;
		КонецЦикла;

		ОтметитьХодОтправки(СтрШаблон(НСтр("ru = 'подпись ключом на сервере: документов %1'"), Подготовка.Подписания.Количество()),
			Проход, Пачек, Итог, ДокументыДляХода(ДокументыПачки));
		Подписи = ЭАрМ_УтверждениеСБИС.ПодписатьПакетНаСервере(Подготовка.Подписания, Средства);

		// Не подписался ни один - беда ключа (пароль, контейнер, лицензия), а не
		// документов: строки не трогаем, иначе вся очередь ушла бы в «Ошибка
		// отправки», которую автоотправка больше не берёт
		Если Подписи.Подписания.Количество() = 0 Тогда
			Итог.Текст = Подписи.Ошибки[0].Текст;
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки("", "СБИС: подпись пачки " + Проход,
				"ключ не подписал ни один документ: " + Итог.Текст);
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ОтправкаОчереди", Ложь,
				НСтр("ru = 'Отправка очереди прервана, ключ не подписал ни один документ: '") + Итог.Текст);
			Прервать;
		КонецЕсли;

		Для Каждого ОшибкаПодписи Из Подписи.Ошибки Цикл
			ОтметитьПослеОтправкиСБИС(ОшибкаПодписи.ИдентификаторЗапроса, Ложь, ОшибкаПодписи.Текст);
			ЭАрМ_ПриемПакетовДалион.ОшибкаПроверки("", "СБИС: подпись документа",
				"строка очереди " + ОшибкаПодписи.ИдентификаторЗапроса + " не подписана: " + ОшибкаПодписи.Текст);
			Итог.Ошибок = Итог.Ошибок + 1;
		КонецЦикла;

		Если Подписи.Подписания.Количество() > 0 Тогда
			ОтметитьХодОтправки(СтрШаблон(НСтр("ru = 'отправка подписей в СБИС: документов %1'"), Подписи.Подписания.Количество()),
				Проход, Пачек, Итог, ДокументыДляХода(ДокументыПачки));
			Отправка = ЭАрМ_УтверждениеСБИС.ВыполнитьПакетДействий(Подписи.Подписания);
			Итог.Отправлено = Итог.Отправлено + Отправка.Отправлено;
			Итог.Ошибок = Итог.Ошибок + Отправка.Ошибок;
			Итог.Подписано = Итог.Подписано + Отправка.Подписано;
			Итог.УПД  = Итог.УПД  + Отправка.УПД;
			Итог.ЭТрН = Итог.ЭТрН + Отправка.ЭТрН;
			Итог.УКД  = Итог.УКД  + Отправка.УКД;
		КонецЕсли;

	КонецЦикла;

	Если Итог.Отправлено + Итог.Ошибок > 0 Тогда
		Итог.Текст = ЭАрМ_УтверждениеСБИС.ТекстСводкиОтправки(Итог);
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ОтправкаОчереди", Итог.Ошибок = 0, Итог.Текст);
	КонецЕсли;
	ЭАрМ_ПриемПакетовДалион.Трасса("", СтрШаблон(
		"СБИС: отправка очереди окончена - отправлено %1 (УПД %2, ЭТрН %3, УКД %4), подписано в СБИС %5, ошибок %6",
		Итог.Отправлено, Итог.УПД, Итог.ЭТрН, Итог.УКД, Итог.Подписано, Итог.Ошибок), Итог.Ошибок = 0);

	Возврат Итог;

КонецФункции

// Текст ошибки подготовки для строки очереди: ПодготовитьПакетПодписания
// пишет ошибки строками «<Реестр> <Номер>: причина».
//
Функция ОшибкаДокументаПачки(ДокументОчереди, Ошибки)

	Начало = СтрШаблон("%1 %2:", ДокументОчереди.Реестр, ДокументОчереди.Номер);
	Для Каждого ТекстОшибки Из Ошибки Цикл
		Если СтрНачинаетсяС(ТекстОшибки, Начало) Тогда
			Возврат ТекстОшибки;
		КонецЕсли;
	КонецЦикла;

	Возврат НСтр("ru = 'Не подготовлен в СБИС к подписи'");

КонецФункции

// Сколько документов очереди СБИС отправлено за день (успешно ушли:
// «Отправлен на подпись» или уже «Подтверждено», дата отправки - этот день).
//
Функция ОтправленоВСБИСЗаДень(Знач День = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(День) Тогда
		День = ТекущаяДатаСеанса();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Отправлено
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.Реестр <> """"
	|	И Очередь.ДатаОтправки МЕЖДУ &Начало И &Конец
	|	И Очередь.Статус В (
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОтправленНаПодпись),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено))";
	Запрос.УстановитьПараметр("Начало", НачалоДня(День));
	Запрос.УстановитьПараметр("Конец", КонецДня(День));

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), ЧислоИлиНоль(Выборка.Отправлено), 0);

КонецФункции

// Сколько УПД, ЭТрН и УКД ушло в СБИС за день.
//
Функция ОтправленоВСБИСЗаДеньПоРеестрам(Знач День = Неопределено) Экспорт

	Результат = Новый Структура("УПД, ЭТрН, УКД", 0, 0, 0);
	Если НЕ ЗначениеЗаполнено(День) Тогда
		День = ТекущаяДатаСеанса();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Реестр КАК Реестр,
	|	КОЛИЧЕСТВО(*) КАК Отправлено
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.Реестр <> """"
	|	И Очередь.ДатаОтправки МЕЖДУ &Начало И &Конец
	|	И Очередь.Статус В (
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОтправленНаПодпись),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено))
	|СГРУППИРОВАТЬ ПО
	|	Очередь.Реестр";
	Запрос.УстановитьПараметр("Начало", НачалоДня(День));
	Запрос.УстановитьПараметр("Конец", КонецДня(День));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.Свойство(Выборка.Реестр) Тогда
			Результат[Выборка.Реестр] = ЧислоИлиНоль(Выборка.Отправлено);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Счётчики очереди СБИС для шапки формы «Ожидают отправки».
//
// Возвращаемое значение:
//   Структура:
//     * ЖдутОтправки      - Число - «Готов к отправке» или без статуса: то, что
//                           берёт автоотправка (см. ДокументыДляАвтоотправки)
//     * НаПодписи         - Число - «Отправлен на подпись», СБИС ещё не показал подпись
//     * Подписано         - Число - «Подтверждено»
//     * СОшибкой          - Число - «Ошибка отправки» / «Отклонено»
//     * ОтправленоСегодня - Число - см. ОтправленоВСБИСЗаДень
//     * ОтправленоВсего   - Число - НаПодписи + Подписано
//     * ГлубинаЖдут       - Дата - дата самого старого документа из ЖдутОтправки:
//                           готовы к отправке, но не подписаны и висят с этой даты
//     * ГлубинаНаПодписи  - Дата - то же для НаПодписи
//     Пустая дата - таких документов нет (или у них не заполнена дата).
//
Функция СчетчикиОчереди() Экспорт

	Результат = Новый Структура("ЖдутОтправки, НаПодписи, Подписано, СОшибкой, ОтправленоСегодня, ОтправленоВсего, СегодняУПД, СегодняЭТрН, СегодняУКД, ГлубинаЖдут, ГлубинаНаПодписи",
		0, 0, 0, 0, 0, 0, 0, 0, 0, Дата(1, 1, 1), Дата(1, 1, 1));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(ВЫБОР
	|			КОГДА Очередь.ИдентификаторСБИС <> """"
	|					И Очередь.Статус В (
	|						ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке),
	|						ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ПустаяСсылка))
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ЖдутОтправки,
	|	СУММА(ВЫБОР
	|			КОГДА Очередь.Статус В (
	|					ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОтправленНаПодпись),
	|					ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает))
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК НаПодписи,
	|	СУММА(ВЫБОР
	|			КОГДА Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Подтверждено)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Подписано,
	|	СУММА(ВЫБОР
	|			КОГДА Очередь.Статус В (
	|					ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки),
	|					ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Отклонено))
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СОшибкой,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА Очередь.ИдентификаторСБИС <> """"
	|					И Очередь.ДатаДокумента > ДАТАВРЕМЯ(1, 1, 1)
	|					И Очередь.Статус В (
	|						ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке),
	|						ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ПустаяСсылка))
	|				ТОГДА Очередь.ДатаДокумента
	|		КОНЕЦ) КАК ГлубинаЖдут,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА Очередь.ДатаДокумента > ДАТАВРЕМЯ(1, 1, 1)
	|					И Очередь.Статус В (
	|						ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОтправленНаПодпись),
	|						ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает))
	|				ТОГДА Очередь.ДатаДокумента
	|		КОНЕЦ) КАК ГлубинаНаПодписи
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.Реестр <> """"";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		// Пустой регистр даёт одну строку с NULL
		Результат.ЖдутОтправки = ЧислоИлиНоль(Выборка.ЖдутОтправки);
		Результат.НаПодписи    = ЧислоИлиНоль(Выборка.НаПодписи);
		Результат.Подписано    = ЧислоИлиНоль(Выборка.Подписано);
		Результат.СОшибкой     = ЧислоИлиНоль(Выборка.СОшибкой);
		Если ТипЗнч(Выборка.ГлубинаЖдут) = Тип("Дата") Тогда
			Результат.ГлубинаЖдут = Выборка.ГлубинаЖдут;
		КонецЕсли;
		Если ТипЗнч(Выборка.ГлубинаНаПодписи) = Тип("Дата") Тогда
			Результат.ГлубинаНаПодписи = Выборка.ГлубинаНаПодписи;
		КонецЕсли;
	КонецЕсли;

	Результат.ОтправленоСегодня = ОтправленоВСБИСЗаДень();
	Результат.ОтправленоВсего   = Результат.НаПодписи + Результат.Подписано;
	ПоРеестрам = ОтправленоВСБИСЗаДеньПоРеестрам();
	Результат.СегодняУПД  = ПоРеестрам.УПД;
	Результат.СегодняЭТрН = ПоРеестрам.ЭТрН;
	Результат.СегодняУКД  = ПоРеестрам.УКД;

	Возврат Результат;

КонецФункции

Функция ЧислоИлиНоль(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);

КонецФункции

// Сколько документов автоотправка ставит в очередь за один проход регламента
// (настройка ОтправкаСБИС_ВОчередьЗаПроход, по умолчанию 50).
// Отправляет их форма очереди - пачками по РазмерПачкиОтправки().
//
Функция РазмерПачкиАвтоотправки()

	Возврат ЧислоНастройкиВПределах("ОтправкаСБИС_ВОчередьЗаПроход", 50, 1, 500);

КонецФункции

// Сколько документов уходит в СБИС одной пачкой автоотправки
// (настройка ОтправкаСБИС_РазмерПачки, по умолчанию 5).
//
Функция РазмерПачкиОтправки() Экспорт

	Возврат ЧислоНастройкиВПределах("ОтправкаСБИС_РазмерПачки", 5, 1, 50);

КонецФункции

// Сколько пачек отправки за один запуск регламента
// (настройка ОтправкаСБИС_ПачекЗаЗапуск, по умолчанию 20).
//
Функция ПачекЗаЗапускОтправки() Экспорт

	Возврат ЧислоНастройкиВПределах("ОтправкаСБИС_ПачекЗаЗапуск", 20, 1, 200);

КонецФункции

// Целое число из настройки в пределах; не задано или не число - умолчание.
//
Функция ЧислоНастройкиВПределах(Ключ, ПоУмолчанию, Минимум, Максимум)

	Значение = ЭАрМ_НастройкиСервер.ЗначениеНастройки(Ключ);
	Если ТипЗнч(Значение) <> Тип("Число") ИЛИ Значение <= 0 Тогда
		Значение = ПоУмолчанию;
	КонецЕсли;

	Возврат Макс(Минимум, Мин(Окр(Значение), Максимум));

КонецФункции

#Область ХодОтправки

// ============================================================================
// ХОД ОТПРАВКИ НЕОТПРАВЛЕННОГО В СБИС (20.10.2026)
// ============================================================================
// Регламент ЭАрМ_ОтправкаОчередиСБИС и кнопка формы настроек пишут каждый шаг
// в настройку ОтправкаСБИС_Ход строкой «время|этап|пачка|пачек|отправлено|ошибок|документы»;
// вкладка «Отправка и регламенты» показывает её (ТекстХодаОтправки), при запуске
// кнопкой - раз в 2 секунды, как тест приёма и сверки.

// Записывает текущий шаг отправки. Ошибка записи отправку не останавливает.
//
// Параметры:
//   Этап      - Строка - что делается сейчас
//   Пачка     - Число - номер пачки (0 - вне пачек)
//   Пачек     - Число - сколько пачек не больше за запуск
//   Итог      - Структура, Неопределено - Отправлено, Ошибок на этот момент
//   Документы - Строка - какие документы в работе
//
Процедура ОтметитьХодОтправки(Этап, Пачка = 0, Пачек = 0, Итог = Неопределено, Документы = "") Экспорт

	Отправлено = 0;
	Ошибок = 0;
	Если ТипЗнч(Итог) = Тип("Структура") Тогда
		Итог.Свойство("Отправлено", Отправлено);
		Итог.Свойство("Ошибок", Ошибок);
	КонецЕсли;
	ЗаписатьХодОтправки(Этап, Пачка, Пачек, Отправлено, Ошибок, Документы);

КонецПроцедуры

// Шаг внутри пачки: какой документ уходит в СБИС сейчас (ЭАрМ_УтверждениеСБИС.ВыполнитьПакетДействий).
// Пачка и счётчики остаются от последнего ОтметитьХодОтправки.
//
Процедура ОтметитьХодОтправкиДокумента(Документ, Номер, Всего) Экспорт

	Части = ЧастиХодаОтправки();
	ЗаписатьХодОтправки(СтрШаблон(НСтр("ru = 'отправка в СБИС: документ %1 из %2'"), Номер, Всего),
		Части[2], Части[3], Части[4], Части[5], Документ);

КонецПроцедуры

Процедура ЗаписатьХодОтправки(Этап, Пачка, Пачек, Отправлено, Ошибок, Документы)

	Попытка
		Текст = СтрШаблон("%1|%2|%3|%4|%5|%6|%7", XMLСтрока(ТекущаяДатаСеанса()), БезЧерты(Этап),
			БезЧерты(Пачка), БезЧерты(Пачек), БезЧерты(Отправлено), БезЧерты(Ошибок), БезЧерты(Документы));
		ЭАрМ_НастройкиСервер.СохранитьНастройку("ОтправкаСБИС_Ход", Лев(Текст, 500));
	Исключение
		ЭАрМ_Служебный.ЗаписатьОшибку("ОтметитьХодОтправки", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция БезЧерты(Значение)

	Возврат СтрЗаменить(?(ТипЗнч(Значение) = Тип("Число"), Формат(Значение, "ЧН=0; ЧГ=0"), Строка(Значение)), "|", "/");

КонецФункции

// Поля записи хода: время, этап, пачка, пачек, отправлено, ошибок, документы.
//
Функция ЧастиХодаОтправки()

	Части = СтрРазделить(Строка(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ОтправкаСБИС_Ход")), "|", Истина);
	Пока Части.Количество() < 7 Цикл
		Части.Добавить("");
	КонецЦикла;
	Для Индекс = 2 По 5 Цикл
		Попытка
			Части[Индекс] = Число(Части[Индекс]);
		Исключение
			Части[Индекс] = 0;
		КонецПопытки;
	КонецЦикла;

	Возврат Части;

КонецФункции

// Документы пачки для хода: «УПД № 123, УКД № 45, …» (не больше 10, остальные - числом).
//
Функция ДокументыДляХода(ДокументыПачки)

	Список = Новый Массив;
	Для Каждого ДокументОчереди Из ДокументыПачки Цикл
		Если Список.Количество() = 10 Тогда
			Список.Добавить(СтрШаблон(НСтр("ru = 'и ещё %1'"), ДокументыПачки.Количество() - 10));
			Прервать;
		КонецЕсли;
		Список.Добавить(СтрШаблон("%1 № %2", ДокументОчереди.Реестр, ДокументОчереди.Номер));
	КонецЦикла;

	Возврат СтрСоединить(Список, ", ");

КонецФункции

// Ход отправки текстом для формы настроек: когда и что было последним шагом, пачка,
// документы, счётчики.
//
// Возвращаемое значение:
//   Строка
//
Функция ТекстХодаОтправки() Экспорт

	Запись = Строка(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ОтправкаСБИС_Ход"));
	Если НЕ ЗначениеЗаполнено(Запись) Тогда
		Возврат НСтр("ru = 'Отправка неотправленного ещё не запускалась.'");
	КонецЕсли;
	Части = ЧастиХодаОтправки();

	Момент = Дата(1, 1, 1);
	Попытка
		Момент = XMLЗначение(Тип("Дата"), Части[0]);
	Исключение
		Момент = Дата(1, 1, 1);
	КонецПопытки;

	Строки = Новый Массив;
	Если ЗначениеЗаполнено(Момент) Тогда
		Прошло = Макс(0, ТекущаяДатаСеанса() - Момент);
		Строки.Добавить(СтрШаблон(НСтр("ru = '%1 (%2 назад): %3'"), Формат(Момент, "ДФ='dd.MM HH:mm:ss'"),
			?(Прошло < 120, СтрШаблон(НСтр("ru = '%1 с'"), Прошло), СтрШаблон(НСтр("ru = '%1 мин'"), Цел(Прошло / 60))), Части[1]));
	Иначе
		Строки.Добавить(Части[1]);
	КонецЕсли;
	Если Части[2] > 0 Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Пачка %1 (не больше %2 за запуск)'"), Части[2], Части[3]));
	КонецЕсли;
	Если ЗначениеЗаполнено(Части[6]) Тогда
		Строки.Добавить(НСтр("ru = 'Документы: '") + Части[6]);
	КонецЕсли;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Отправлено %1, ошибок %2'"), Части[4], Части[5]));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Как сейчас настроена отправка неотправленного - пояснение под полями формы настроек.
//
// Возвращаемое значение:
//   Строка
//
Функция ОписаниеОтправкиПоРасписанию() Экспорт

	Строки = Новый Массив;
	Если ЭАрМ_НастройкиСервер.ФоновыеЗаданияОтключены() Тогда
		Строки.Добавить(НСтр("ru = 'Фоновые задания ЭДО отключены в настройках (вкладка «Далион и обмен») - регламент не работает.'"));
	КонецЕсли;
	ВСБИС = ЭАрМ_НастройкиСервер.ЗначениеНастройки("АвтоотправкаУПД") = Истина;
	ВБух = ВыгрузкаВБухПоРасписанию();
	Если НЕ ВСБИС И НЕ ВБух Тогда
		Строки.Добавить(НСтр("ru = 'Выключено: регламент неотправленное не собирает и не отправляет ни в СБИС, ни в Бух.'"));
		Возврат СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;

	Строки.Добавить(СтрШаблон(НСтр("ru = 'Регламент: каждые %1 мин.'"), ИнтервалОтправкиОчереди()));
	Если НЕ ВСБИС Тогда
		Строки.Добавить(НСтр("ru = 'СБИС: выключено (флажок «Собирать и отправлять неотправленное»).'"));
	Иначе
		Строки.Добавить(СтрШаблон(НСтр("ru = 'СБИС: пачка %1 документов, не больше %2 пачек за запуск, в очередь за проход - до %3.'"),
			РазмерПачкиОтправки(), ПачекЗаЗапускОтправки(), РазмерПачкиАвтоотправки()));
		Если МестоПодписиОчереди() = "Сервер" Тогда
			ТекстОшибки = "";
			Если ОтправкаОчередиНаСервереНастроена(ТекстОшибки) Тогда
				Строки.Добавить(СтрШаблон(НСтр("ru = 'Подпись на сервере, подписант %1: регламент сам собирает, подписывает и отправляет.'"),
					ПодписантОтправкиОчереди()));
			Иначе
				Строки.Добавить(НСтр("ru = 'Подпись на сервере НЕ готова: '") + ТекстОшибки
					+ НСтр("ru = '. Регламент только ставит готовые в очередь.'"));
			КонецЕсли;
		Иначе
			Хозяин = СокрЛП(Строка(ЭАрМ_НастройкиСервер.ЗначениеНастройки("Автоотправка_Компьютер")));
			Строки.Добавить(СтрШаблон(НСтр("ru = 'Подпись на клиенте: регламент собирает и ставит готовые в очередь, подписывает и отправляет открытая форма «Ожидают отправки» или реестр УПД%1.'"),
				?(ЗначениеЗаполнено(Хозяин), СтрШаблон(НСтр("ru = ' на компьютере %1'"), Хозяин), "")));
		КонецЕсли;
	КонецЕсли;
	Строки.Добавить(?(ВБух,
		СтрШаблон(НСтр("ru = 'Бух: подписанные и не выгруженные УПД и УКД (за %1 дн.) уходят в папку обмена с БП тем же регламентом.'"),
			ЭАрМ_ВыгрузкаНакладныхДляБух.ДнейАвтоотправки()),
		НСтр("ru = 'Бух: выключено (флажок «Выгружать подписанное в Бух» или не задана папка обмена с БП).'")));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Регламент отправки выгружает и в Бух: включён автообмен с БП и задана папка обмена.
//
Функция ВыгрузкаВБухПоРасписанию() Экспорт

	Возврат ЭАрМ_ВыгрузкаНакладныхДляБух.АвтообменСБух()
		И ЗначениеЗаполнено(ЭАрМ_НастройкиСервер.ЗначениеНастройки("ПапкаВыгрузкиБух"));

КонецФункции

// Шаг регламента «в Бух»: подписанные и не выгруженные УПД и УКД - в папку обмена
// с БП (ЭАрМ_ВыгрузкаНакладныхДляБух.ВыгрузитьПодписанныеУПД, как после подписи).
// Идёт фоновая выгрузка после подписи - этот шаг её не дублирует.
//
// Возвращаемое значение:
//   Строка - итог для хода
//
Функция ВыгрузитьВБухПоРасписанию(Итог)

	Если НЕ ВыгрузкаВБухПоРасписанию() Тогда
		Возврат НСтр("ru = 'выключено'");
	КонецЕсли;
	Если ЭАрМ_ВыгрузкаНакладныхДляБух.ВыгрузкаИдетВФоне() Тогда
		Возврат НСтр("ru = 'выгрузка уже идёт отдельным заданием (после подписи)'");
	КонецЕсли;

	ОтметитьХодОтправки(НСтр("ru = 'выгрузка подписанных УПД и УКД в Бух'"), 0, 0, Итог);
	Попытка
		Результат = ЭАрМ_ВыгрузкаНакладныхДляБух.ВыгрузитьПодписанныеУПД();
	Исключение
		ТекстСбоя = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
		ЭАрМ_ПриемПакетовДалион.ОшибкаПроверкиИсключение("", "Бух: выгрузка регламентом отправки", ИнформацияОбОшибке());
		Возврат НСтр("ru = 'СБОЙ: '") + ТекстСбоя;
	КонецПопытки;

	Если НЕ Результат.Успех Тогда
		Возврат НСтр("ru = 'не выгружено: '") + Результат.Ошибка;
	КонецЕсли;
	Если Результат.НакладныхВыгружено + Результат.КорректировокВыгружено = 0 Тогда
		Возврат НСтр("ru = 'нечего выгружать'");
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'выгружено УПД %1, УКД %2, файл %3'"),
		Результат.НакладныхВыгружено, Результат.КорректировокВыгружено, Результат.ИмяФайла);

КонецФункции

// Кнопка «Отправить неотправленное сейчас»: то же, что регламент (сверка, постановка
// готовых, отправка, проверка подписей), фоновым заданием с ключом регламента -
// пока идёт одна отправка, вторую платформа не запустит.
//
// Возвращаемое значение:
//   Структура - Задание (УникальныйИдентификатор или Неопределено), Ошибка (Строка)
//
Функция ЗапуститьОтправкуНеотправленногоСейчас() Экспорт

	Результат = Новый Структура("Задание, Ошибка", Неопределено, "");
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(Ложь);
	ПараметрыЗадания.Добавить(Истина);
	Попытка
		Задание = ФоновыеЗадания.Выполнить("ЭАрМ_ОбработкаПодтвержденийЭДО.ОтправитьОчередьПоРасписанию",
			ПараметрыЗадания, КлючОтправкиОчереди(), НСтр("ru = 'ЭДО: отправка неотправленного в СБИС (кнопкой)'"));
		Результат.Задание = Задание.УникальныйИдентификатор;
	Исключение
		Результат.Ошибка = НСтр("ru = 'Отправка уже идёт (регламент или кнопка) - её ход ниже обновляется кнопкой «Обновить».'");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Состояние запуска кнопкой и ход - для опроса формы раз в 2 секунды.
//
// Возвращаемое значение:
//   Структура - Состояние ("Активно", "Завершено", "Ошибка", "НеНайдено"), Текст
//
Функция СостояниеОтправкиНеотправленного(ИдентификаторЗадания) Экспорт

	Результат = Новый Структура("Состояние, Текст", "НеНайдено", ТекстХодаОтправки());
	Если НЕ ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Возврат Результат;
	КонецЕсли;
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если Задание = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Результат.Состояние = "Активно";
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Результат.Состояние = "Завершено";
	Иначе
		Результат.Состояние = "Ошибка";
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			Результат.Текст = Результат.Текст + Символы.ПС + НСтр("ru = 'Задание прервано: '")
				+ КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

// Фоновое задание автоотправки (ЭАрМ_ПанельУправленияЭДОСервер.
// ЗапуститьАвтоПачкуВФоне): сошедшиеся УПД и УКД - в очередь, следующие
// РазмерПачкиОтправки() документов очереди - подготовка в СБИС. Подписывает
// клиент, отправляет подписи второе фоновое задание.
//
// Параметры:
//   Исключить       - Массив из Строка - документы, уже взятые этим сеансом формы
//   НомерПодписанта - Число
//
// Возвращаемое значение:
//   Структура - Документы (Массив, см. ДокументыДляАвтоотправки),
//               Подписания и Ошибки (см. ЭАрМ_УтверждениеСБИС.ПодготовитьПакетПодписания)
//
Функция ПодготовитьАвтоПачку(Знач Исключить, Знач НомерПодписанта) Экспорт

	Результат = Новый Структура("Документы, Подписания, Ошибки",
		Новый Массив, Новый Массив, Новый Массив);

	// Реестр УПД -> очередь: «Готов к утверждению» становится «К отправке»
	Попытка
		АвтоотправкаГотовыхУПД();
	Исключение
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "АвтоотправкаУПД", Ложь,
			ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
	КонецПопытки;

	Результат.Документы = ДокументыДляАвтоотправки(Исключить);
	Если Результат.Документы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Подготовка = ЭАрМ_УтверждениеСБИС.ПодготовитьПакетПодписания(Результат.Документы, НомерПодписанта);
	Результат.Подписания = Подготовка.Подписания;
	Результат.Ошибки     = Подготовка.Ошибки;

	Возврат Результат;

КонецФункции

// Следующая пачка автоотправки формы очереди: всё, что в очереди ждёт
// отправки, - без оглядки на флажок «Отправить», старые первыми. Строки
// «Ошибка отправки» берутся только по времени повтора (СледующаяПопытка),
// иначе сорвавшийся документ уходил бы в каждую пачку. Строки робота
// (ПодписаноРоботом) не берутся вовсе: «Получен» по ЭТрН должен подписать
// тот компьютер, где включено автоутверждение, - иначе строка, оставшаяся
// от робота, уезжала бы чужим сертификатом из пачки очереди или с сервера.
// Их отправляет тот, кто отметит флажок «Отправить» вручную, или повторное
// автоутверждение на нужном компьютере.
//
// Параметры:
//   Исключить - Массив из Строка - документы, уже взятые в этом сеансе формы
//
// Возвращаемое значение:
//   Массив из Структура - как у ДокументыКПодписанию
//
Функция ДокументыДляАвтоотправки(Знач Исключить) Экспорт

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(РазмерПачкиОтправки(), "ЧГ=0") + "
	|	Очередь.Реестр КАК Реестр,
	|	Очередь.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
	|	Очередь.Номер КАК Номер,
	|	Очередь.Контрагент КАК Контрагент
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторСБИС <> """"
	|	И Очередь.Реестр <> """"
	|	И НЕ Очередь.ПодписаноРоботом
	|	И (НЕ Очередь.ИдентификаторСБИС В (&Исключить)
	|				И Очередь.Статус В (
	|					ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке),
	|					ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ПустаяСсылка))
	|			ИЛИ Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки)
	|				И Очередь.СледующаяПопытка > ДАТАВРЕМЯ(1, 1, 1)
	|				И Очередь.СледующаяПопытка <= &Сейчас)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.ДатаДокумента,
	|	Очередь.Номер";
	// Повтор «Ошибки отправки» по времени берётся и из уже взятых в сеансе
	// формы (Исключить): сорвавшийся документ получает время повтора, раньше
	// него снова не попадёт
	Запрос.УстановитьПараметр("Исключить", Исключить);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура(
			"Реестр, ИдентификаторСБИС, ИдентификаторЗапроса, Номер, Контрагент",
			Выборка.Реестр, Выборка.ИдентификаторСБИС, Выборка.ИдентификаторЗапроса,
			Выборка.Номер, Выборка.Контрагент));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Один документ для ПоставитьНаУтверждение.
//
// Три шага, и проверка запрета - вне транзакции: ЗапретУтверждения через
// итоговую сумму УПД пересобирает линии цепочки (НазначитьШтрихкоды и др.),
// а те сами блокируют и пишут регистры. Ошибка внутри них портила нашу
// транзакцию: «В данной транзакции уже происходили ошибки».
//   1. «К отправке» - короткая транзакция по строке реестра;
//   2. ЗапретУтверждения - без транзакции; при запрете флажок, поставленный
//      здесь, снимается обратно;
//   3. статус готовности и строка очереди - короткая транзакция.
//
// Возвращаемое значение:
//   Строка - почему документ не встал в очередь; пустая - встал
//
Функция ПоставитьДокументНаУтверждение(Реестр, Идентификатор)

	ИмяРегистра = ИмяРегистраРеестра(Реестр, Идентификатор);
	РеестрОчереди = ?(ИмяРегистра = "ЭАрМ_УКД_Входящий", "УКД", Реестр);
	Представление = СтрШаблон("%1 %2", РеестрОчереди, Идентификатор);

	Попытка
		Отметка = УстановитьКОтправке(ИмяРегистра, Идентификатор, РеестрОчереди);
	Исключение
		Возврат ОшибкаПостановки(Идентификатор, Представление, ИнформацияОбОшибке());
	КонецПопытки;

	Если ЗначениеЗаполнено(Отметка.Ошибка) Тогда
		Возврат Отметка.Ошибка;
	КонецЕсли;

	Представление = СтрШаблон("%1 %2", РеестрОчереди, Отметка.Номер);

	Попытка
		// Запрет читает реестр заново и видит уже поставленный флажок
		Запрет = ЭАрМ_УтверждениеСБИС.ЗапретУтверждения(РеестрОчереди, Идентификатор, Истина);
	Исключение
		Запрет = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
	КонецПопытки;

	Если ЗначениеЗаполнено(Запрет) Тогда
		Если Отметка.Поставлен Тогда
			Попытка
				СнятьКОтправке(ИмяРегистра, Идентификатор);
			Исключение
				ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Идентификатор, "ОчередьЭДО", Ложь,
					ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
		Возврат СтрШаблон("%1: %2", Представление, Запрет);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		УстановитьСтатусГотовности(РеестрОчереди, Идентификатор);

		Добавлено = 0;
		Обновлено = 0;
		ЗаписатьВОчередьОтправки(РеестрОчереди, Идентификатор, Отметка.Номер, Отметка.Дата,
			Отметка.Контрагент, Добавлено, Обновлено, Истина);

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Возврат ОшибкаПостановки(Идентификатор, Представление, ИнформацияОбОшибке());
	КонецПопытки;

	Возврат "";

КонецФункции

// Шаг 1 постановки: проверяет, что документ ещё не утверждён, и ставит
// «К отправке».
//
// Возвращаемое значение:
//   Структура - Ошибка, Поставлен (флажок поставили здесь), Номер, Дата, Контрагент
//
Функция УстановитьКОтправке(ИмяРегистра, Идентификатор, РеестрОчереди)

	Результат = Новый Структура("Ошибка, Поставлен, Номер, Дата, Контрагент", "", Ложь);

	НачатьТранзакцию();
	Попытка

		ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра(
			"РегистрСведений." + ИмяРегистра, Идентификатор);

		МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
		МенеджерЗаписи.Прочитать();

		Если НЕ МенеджерЗаписи.Выбран() Тогда
			ОтменитьТранзакцию();
			Результат.Ошибка = СтрШаблон(НСтр("ru = '%1 %2: документа нет в реестре'"),
				РеестрОчереди, Идентификатор);
			Возврат Результат;
		КонецЕсли;

		Если МенеджерЗаписи.Утверждено
			ИЛИ МенеджерЗаписи.Подписано
			ИЛИ МенеджерЗаписи.СтатусПодписания = Перечисления.ЭАрМ_СтатусыПодписанияЭДО.Подписан
			ИЛИ ДокументУжеПодписанВСбис(МенеджерЗаписи.Состояние) Тогда
			ОтменитьТранзакцию();
			Результат.Ошибка = СтрШаблон(НСтр("ru = '%1 %2: уже утверждён или подписан'"),
				РеестрОчереди, МенеджерЗаписи.Номер);
			Возврат Результат;
		КонецЕсли;

		Результат.Номер = МенеджерЗаписи.Номер;
		Результат.Дата = МенеджерЗаписи.Дата;
		Результат.Контрагент = МенеджерЗаписи.Контрагент;

		Если НЕ МенеджерЗаписи.КОтправке Тогда
			МенеджерЗаписи.КОтправке = Истина;
			МенеджерЗаписи.Записать(Истина);
			Результат.Поставлен = Истина;
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Снимает «К отправке», поставленный шагом 1, если документ утверждать нельзя.
//
Процедура СнятьКОтправке(ИмяРегистра, Идентификатор)

	НачатьТранзакцию();
	Попытка

		ЭАрМ_РегламентныйОбменЭДО.ЗаблокироватьСтрокуРеестра(
			"РегистрСведений." + ИмяРегистра, Идентификатор);

		МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторСБИС = Идентификатор;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() И МенеджерЗаписи.КОтправке Тогда
			МенеджерЗаписи.КОтправке = Ложь;
			МенеджерЗаписи.Записать(Истина);
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Текст ошибки постановки для пользователя; подробности - в журнал.
//
// Пользователю - причина ошибки, а не стек вызовов: подробное представление
// начинается со строк модуля, и в комментарий очереди (500 символов) сама
// причина («по причине: ...») не помещалась.
//
Функция ОшибкаПостановки(Идентификатор, Представление, ИнфОбОшибке)

	Текст = ЭАрМ_Служебный.ТекстИсключения(ИнфОбОшибке);
	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал(Идентификатор, "ОчередьЭДО", Ложь, Текст);

	Возврат СтрШаблон("%1: %2", Представление, ПричинаОшибки(ИнфОбОшибке));

КонецФункции

// Описание ошибки и её первопричина: «Ошибка при вызове метода контекста
// (Записать): <почему>».
//
Функция ПричинаОшибки(ИнфОбОшибке)

	Описание = СокрЛП(ИнфОбОшибке.Описание);

	Причина = ИнфОбОшибке.Причина;
	Первопричина = "";
	Пока Причина <> Неопределено Цикл
		Если ЗначениеЗаполнено(СокрЛП(Причина.Описание)) Тогда
			Первопричина = СокрЛП(Причина.Описание);
		КонецЕсли;
		Причина = Причина.Причина;
	КонецЦикла;

	Если ЗначениеЗаполнено(Первопричина) И Первопричина <> Описание Тогда
		Возврат Описание + ": " + Первопричина;
	КонецЕсли;

	Возврат Описание;

КонецФункции

// Регистр реестра по его короткому имени. Корректировку, переданную как
// «УПД», ищем в реестре УКД - так же делает ЗапретУтверждения.
//
Функция ИмяРегистраРеестра(Реестр, Идентификатор)

	Если Реестр = "ЭТрН" Тогда
		Возврат "ЭАрМ_РеестрЭТрН";
	ИначеЕсли Реестр = "УКД" ИЛИ ЭАрМ_КорректировкиУПД.ЕстьВРеестреКорректировок(Идентификатор) Тогда
		Возврат "ЭАрМ_УКД_Входящий";
	КонецЕсли;

	Возврат "ЭАрМ_УПД_Входящий";

КонецФункции

// Убирает из очереди строку документа, по которой утверждение ещё не ушло.
//
Процедура УдалитьНеотправленноеИзОчереди(ИдентификаторСБИС)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	Очередь.ИдентификаторЗапроса КАК ИдентификаторЗапроса
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Очередь
	|ГДЕ
	|	Очередь.ИдентификаторСБИС = &ИдентификаторСБИС
	|	И Очередь.Реестр <> """"
	|	И Очередь.Статус В (
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ГотовКОтправке),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ОшибкаОтправки),
	|		ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.ПустаяСсылка))";
	Запрос.УстановитьПараметр("ИдентификаторСБИС", ИдентификаторСБИС);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЭлектронныйДокумент = Выборка.ЭлектронныйДокумент;
		МенеджерЗаписи.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
		МенеджерЗаписи.Удалить();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
