////////////////////////////////////////////////////////////////////////////////
// Пересверка номенклатуры: неверные пары строк УПД и прихода Далиона.
//
// Сверка цепочки сводит строки УПД с приходом прежде всего по штрихкоду, а
// штрихкод строке УПД без GTIN подставляет регистр ЭАрМ_ШтрихкодыПоставщиков.
// Если туда однажды попала неверная пара (две строки одной цены сошлись
// крест-накрест), она дальше воспроизводит себя сама.
//
// Обработка ничего не удаляет. Она показывает строки УПД, чей штрихкод и чья
// пара в приходе не сходятся с наименованием, предлагает верную пару по имени,
// количеству и цене и по отметке связывает её штатной ручной парой
// (ЭАрМ_СверкаТоваровЦепочки.СвязатьСтрокуУПДСПриходом). Ручная пара в
// регистре надёжнее выученной сверкой и перекрывает её; неверная запись
// остаётся в регистре, но больше не выбирается.
//
// Сверка с 28.09.2026 идёт только по штрихкоду. Предложение по имени,
// количеству и цене здесь - подсказка человеку: пара появляется, только когда
// её подтвердили кнопкой «Связать отмеченные», и дальше находится по штрихкоду.
//
// Раньше была внешней обработкой ПересверкаНоменклатуры.epf; теперь в
// расширении и открывается кнопкой «Пересверка номенклатуры» из настроек ЭДО
// (РегистрСведений.ЭАрМ_НастройкиЭДО.ФормаНастроек). Приоритет источника
// берётся из общего модуля, а не из своей копии: модуль всегда той же версии.
//
// Под таблицей номенклатуры - варианты текущей строки: все записи регистра
// штрихкодов поставщиков этой номенклатуры и с её штрихкодами (в любом
// написании), и товары из УПД с тем же штрихкодом или похожим названием.
// Верные товары из УПД связываются ручной парой, неверные записи регистра
// удаляются - только по отметке и после вопроса.
////////////////////////////////////////////////////////////////////////////////

#Область ПеременныеФормы

// Число - идентификатор строки номенклатуры, чьи варианты сейчас показаны.
//
&НаКлиенте
Перем СтрокаВариантов;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаПо = КонецДня(ТекущаяДатаСеанса());
	ДатаС  = НачалоДня(ДатаПо) - 7 * 86400;
	ТолькоКонфликты = Истина;

	// Название поставщика выбирается из списка или вводится руками
	Элементы.НоменклатураНазваниеПоставщика.КнопкаВыпадающегоСписка = Истина;
	Элементы.НоменклатураНоменклатураДалион.КнопкаВыпадающегоСписка = Истина;
	Элементы.ПоставщикОтбор.КнопкаВыпадающегоСписка = Истина;
	ЗаполнитьСписокПоставщиков();

	НастроитьОформление();

	// Открыли из реестра УПД на конкретной УПД - сразу показываем её строки,
	// все, а не только конфликты: человек пришёл связать то, что не связалось
	Если ЗначениеЗаполнено(Параметры.НомерУПД) Тогда
		НомерУПД = Параметры.НомерУПД;
		Если ЗначениеЗаполнено(Параметры.ДатаУПД) Тогда
			ДатаС  = НачалоДня(Параметры.ДатаУПД);
			ДатаПо = КонецДня(Параметры.ДатаУПД);
		КонецЕсли;
		ТолькоКонфликты = Ложь;
		ПоказатьНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Показать(Команда)

	ПоказатьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьКонфликты(Команда)

	Для Каждого Строка Из Строки Цикл
		Строка.Отметка = Строка.Конфликт И ЗначениеЗаполнено(Строка.ПредлагаемаяПара);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)

	Для Каждого Строка Из Строки Цикл
		Строка.Отметка = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СвязатьОтмеченные(Команда)

	Отмечено = 0;
	Для Каждого Строка Из Строки Цикл
		Если Строка.Отметка Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;

	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте строки, которые нужно связать'"));
		Возврат;
	КонецЕсли;

	ТекстВопроса = СтрШаблон(НСтр("ru = 'Связать отмеченные строки (%1) с предложенными строками прихода?
		|В регистр штрихкодов поставщиков запишется ручная пара, штрихкоды УПД
		|назначатся заново, цепочки пересверятся. Записи регистра не удаляются.'"), Отмечено);

	ПоказатьВопрос(Новый ОписаниеОповещения("СвязатьОтмеченныеЗавершение", ЭтотОбъект),
		ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СвязатьОтмеченныеЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СвязатьОтмеченныеНаСервере();

КонецПроцедуры

#КонецОбласти

#Область Сбор

// Заполняет таблицу строк УПД за период или по номеру.
//
// Параметры:
//   Результаты - Соответствие - "ИдентификаторУПД|НомерПозиции" -> текст итога
//                прошлого действия, чтобы он не пропал при перечитывании
//
&НаСервере
Процедура ПоказатьНаСервере(Результаты = Неопределено)

	Строки.Очистить();

	ВсегоУПД   = 0;
	ВсегоСтрок = 0;
	Конфликтов = 0;
	БезПрихода = 0;

	Выборка = ВыбратьУПД();
	Пока Выборка.Следующий() Цикл
		ВсегоУПД = ВсегоУПД + 1;
		Итог = ДобавитьСтрокиУПД(Выборка, Результаты);
		Если Итог = Неопределено Тогда
			БезПрихода = БезПрихода + 1;
			Продолжить;
		КонецЕсли;
		ВсегоСтрок = ВсегоСтрок + Итог.Строк;
		Конфликтов = Конфликтов + Итог.Конфликтов;
	КонецЦикла;

	Итоги = СтрШаблон(НСтр("ru = 'УПД: %1 (без прихода Далиона: %2). Строк УПД: %3, конфликтов: %4.'"),
		ВсегоУПД, БезПрихода, ВсегоСтрок, Конфликтов);

КонецПроцедуры

&НаСервере
Функция ВыбратьУПД()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УПД.ИдентификаторСБИС КАК ИдентификаторСБИС,
	|	УПД.Номер КАК Номер,
	|	УПД.Дата КАК Дата,
	|	УПД.Контрагент КАК Контрагент,
	|	УПД.ИННКонтрагента КАК ИННКонтрагента
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	(&ЕстьНомер
	|				И УПД.Номер ПОДОБНО &ШаблонНомера
	|			ИЛИ НЕ &ЕстьНомер
	|				И УПД.Дата МЕЖДУ &ДатаС И &ДатаПо)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер";
	Запрос.УстановитьПараметр("ЕстьНомер", ЗначениеЗаполнено(СокрЛП(НомерУПД)));
	Запрос.УстановитьПараметр("ШаблонНомера", "%" + СокрЛП(НомерУПД) + "%");
	Запрос.УстановитьПараметр("ДатаС", НачалоДня(ДатаС));
	Запрос.УстановитьПараметр("ДатаПо", КонецДня(ДатаПо));

	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

// Строки одной УПД с их штрихкодом, текущей и предлагаемой парой.
//
// Возвращаемое значение:
//   Неопределено - у УПД нет цепочки с приходом Далиона, сравнивать не с чем
//   Структура - Строк, Конфликтов
//
&НаСервере
Функция ДобавитьСтрокиУПД(ОписаниеУПД, Результаты)

	Идентификатор = СокрЛП(ОписаниеУПД.ИдентификаторСБИС);

	Цепочка = ЭАрМ_ЦепочкаЗакупки.ЦепочкаПоУПД(Идентификатор);
	Если Цепочка = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Цепочка.ИдентификаторПоступления) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Позиции = ЭАрМ_ЦепочкаЗакупки.ПозицииПоступления(Цепочка.ИдентификаторПоступления);
	Если Позиции.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Штрихкоды строк прихода по источникам - в том же порядке, что и Позиции
	ШтрихкодыДалиона = ШтрихкодыПакетаДалиона(Цепочка.ИдентификаторПоступления);
	ШтрихкодыУТ      = ШтрихкодыУТПоПозициям(Позиции);

	ТоварыУПД = ТоварыУПД(Идентификатор);
	ТекущиеПары = ТекущиеПары(Цепочка, Идентификатор);
	ЗаписиШтрихкодов = ЗаписиШтрихкодов(ТоварыУПД);
	Предложения = ПодобратьПары(ТоварыУПД, Позиции);

	ПредставлениеУПД = СтрШаблон(НСтр("ru = '№%1 от %2, %3'"),
		ОписаниеУПД.Номер, Формат(ОписаниеУПД.Дата, "ДЛФ=D"), ОписаниеУПД.Контрагент);
	ИНН = СокрЛП(?(ЗначениеЗаполнено(Цепочка.ИННПоставщика), Цепочка.ИННПоставщика, ОписаниеУПД.ИННКонтрагента));
	Поставщик = СокрЛП(?(ЗначениеЗаполнено(Цепочка.Поставщик), Цепочка.Поставщик, ОписаниеУПД.Контрагент));

	Итог = Новый Структура("Строк, Конфликтов", 0, 0);

	Для Каждого Товар Из ТоварыУПД Цикл

		Итог.Строк = Итог.Строк + 1;

		Строка = Новый Структура;
		Строка.Вставить("ИдентификаторУПД",    Идентификатор);
		Строка.Вставить("УПД",                 ПредставлениеУПД);
		Строка.Вставить("НомерПозиции",        Товар.НомерПозиции);
		Строка.Вставить("Наименование",        СокрЛП(Товар.Наименование));
		Строка.Вставить("КодТовараПоставщика", СокрЛП(Товар.КодТовараПоставщика));
		Строка.Вставить("Количество",          Товар.Количество);
		Строка.Вставить("ЦенаСНДС",            ЦенаСНДС(Товар));
		Строка.Вставить("Штрихкод",            СокрЛП(Товар.Штрихкод));
		Строка.Вставить("СпособПоискаШК",      СокрЛП(Товар.СпособПоискаШК));
		Строка.Вставить("ИННПоставщика",       ИНН);
		Строка.Вставить("Поставщик",           Поставщик);
		// Собственный штрихкод строки - только GTIN из самой УПД: штрихкод,
		// подставленный регистром, мог быть чужим, и ручная пара его бы закрепила
		Строка.Вставить("ШтрихкодыУПД", ?(Строка.СпособПоискаШК = "GTIN", Строка.Штрихкод, ""));
		Строка.Вставить("ШтрихкодИзУПД", Строка.ШтрихкодыУПД);

		// Чей штрихкод строка получила из регистра
		Строка.Вставить("ТоварПоШтрихкоду", "");
		Строка.Вставить("ИсточникЗаписи", "");
		Если ЗначениеЗаполнено(Строка.Штрихкод) Тогда
			Запись = ЗаписьДляСтроки(ЗаписиШтрихкодов, Строка.Штрихкод, Строка.Наименование);
			Если Запись <> Неопределено Тогда
				Строка.ТоварПоШтрихкоду = СокрЛП(Запись.НоменклатураДалион);
				Строка.ИсточникЗаписи   = СокрЛП(Запись.Источник);
			КонецЕсли;
		КонецЕсли;

		// Как строку свела сверка цепочки
		НомерТекущей = ТекущиеПары.Получить(Товар.НомерПозиции);
		Строка.Вставить("ТекущаяПара", "");
		Если НомерТекущей <> Неопределено И НомерТекущей >= 1 И НомерТекущей <= Позиции.Количество() Тогда
			Строка.ТекущаяПара = СокрЛП(Позиции[НомерТекущей - 1].Наименование);
		КонецЕсли;

		// Как её свели бы имя, количество и цена
		Предложение = Предложения.Получить(Товар.НомерПозиции);
		Строка.Вставить("ПредлагаемаяПара",  "");
		Строка.Вставить("КоличествоПрихода", 0);
		Строка.Вставить("ЦенаПрихода",       0);
		Строка.Вставить("ОценкаИмени",       0);
		Строка.Вставить("ШтрихкодыПрихода",  "");
		Строка.Вставить("КлючиНоменклатуры", "");
		НомерПредложения = Неопределено;
		Если Предложение <> Неопределено Тогда
			НомерПредложения = Предложение.Индекс + 1;
			Позиция = Позиции[Предложение.Индекс];
			Строка.ПредлагаемаяПара  = СокрЛП(Позиция.Наименование);
			Строка.КоличествоПрихода = Позиция.Количество;
			Строка.ЦенаПрихода       = Позиция.Цена;
			Строка.ОценкаИмени       = Окр(Предложение.Оценка, 2);
			Строка.ШтрихкодыПрихода  = ШтрихкодыПозиции(Позиция);
			Строка.КлючиНоменклатуры = КлючиНоменклатуры(Позиция);
		КонецЕсли;

		// Штрихкоды Далиона и УТ - строки прихода, с которой строку свяжут:
		// предлагаемой пары, а без неё - той, с которой свела сверка
		ИндексПрихода = Неопределено;
		Если НомерПредложения <> Неопределено Тогда
			ИндексПрихода = НомерПредложения - 1;
		ИначеЕсли НомерТекущей <> Неопределено И НомерТекущей >= 1 И НомерТекущей <= Позиции.Количество() Тогда
			ИндексПрихода = НомерТекущей - 1;
		КонецЕсли;
		Строка.Вставить("ШтрихкодыДалиона", "");
		Строка.Вставить("ШтрихкодыУТ", "");
		Если ИндексПрихода <> Неопределено Тогда
			Если ИндексПрихода < ШтрихкодыДалиона.Количество() Тогда
				Строка.ШтрихкодыДалиона = ШтрихкодыДалиона[ИндексПрихода];
			КонецЕсли;
			Строка.ШтрихкодыУТ = ШтрихкодыУТ[ИндексПрихода];
		КонецЕсли;

		Причины = Новый Массив;
		Если НомерПредложения <> Неопределено Тогда
			Если НомерТекущей = Неопределено Тогда
				Причины.Добавить(НСтр("ru = 'нет пары в приходе'"));
			ИначеЕсли НомерТекущей <> НомерПредложения Тогда
				Причины.Добавить(НСтр("ru = 'сверено не с той строкой прихода'"));
			КонецЕсли;
		КонецЕсли;
		Если Строка.СпособПоискаШК <> "GTIN"
			И ЗначениеЗаполнено(Строка.ТоварПоШтрихкоду)
			И ЭАрМ_СверкаТоваровЦепочки.ОценкаПохожестиНаименований(
				Строка.Наименование, Строка.ТоварПоШтрихкоду) < 0.5
			И (НомерПредложения = Неопределено
				ИЛИ Строка.ТоварПоШтрихкоду <> Строка.ПредлагаемаяПара) Тогда
			Причины.Добавить(НСтр("ru = 'штрихкод от другого товара'"));
		КонецЕсли;

		Строка.Вставить("Конфликт", Причины.Количество() > 0);
		Строка.Вставить("Причина",  СтрСоединить(Причины, "; "));
		Строка.Вставить("Отметка",  Строка.Конфликт И НомерПредложения <> Неопределено);
		Строка.Вставить("Результат", "");
		Если Результаты <> Неопределено Тогда
			Строка.Результат = СокрЛП(Результаты.Получить(КлючСтроки(Идентификатор, Товар.НомерПозиции)));
		КонецЕсли;

		Если Строка.Конфликт Тогда
			Итог.Конфликтов = Итог.Конфликтов + 1;
		КонецЕсли;
		Если ТолькоКонфликты И НЕ Строка.Конфликт И НЕ ЗначениеЗаполнено(Строка.Результат) Тогда
			Продолжить;
		КонецЕсли;

		ЗаполнитьЗначенияСвойств(Строки.Добавить(), Строка);

	КонецЦикла;

	Возврат Итог;

КонецФункции

&НаСервере
Функция ТоварыУПД(Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.НомерПозиции КАК НомерПозиции,
	|	Товары.Наименование КАК Наименование,
	|	Товары.КодТовараПоставщика КАК КодТовараПоставщика,
	|	Товары.Штрихкод КАК Штрихкод,
	|	Товары.СпособПоискаШК КАК СпособПоискаШК,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|ГДЕ
	|	Товары.ИдентификаторСБИС = &Идентификатор
	|	И Товары.ИсточникТоваров = ""УПД""
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерПозиции";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Цена УПД в регистре - без НДС, у Далиона - с НДС: сравниваем по сумме строки.
//
&НаСервере
Функция ЦенаСНДС(Товар)

	Если Товар.Количество <> 0 И Товар.Сумма <> 0 Тогда
		Возврат Окр(Товар.Сумма / Товар.Количество, 2);
	КонецЕсли;

	Возврат Товар.Цена;

КонецФункции

// Пары, сложенные сверкой цепочки: номер позиции УПД -> номер строки прихода
// (номер строки прихода - порядок товаров в пакете, как у ПозицииПоступления).
//
&НаСервере
Функция ТекущиеПары(Цепочка, ИдентификаторУПД)

	Результат = Новый Соответствие;

	СтрокиРеестра = ЭАрМ_РеестрТоваровЗаказов.СтрокиЦепочки(
		Цепочка.ИдентификаторЗаказа, Цепочка.ИдентификаторПоступления, ИдентификаторУПД);

	Для Каждого СтрокаРеестра Из СтрокиРеестра Цикл
		НомераПН = НомераИзСтроки(СтрокаРеестра.СтрокиПН);
		Если НомераПН.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого НомерУПДСтроки Из НомераИзСтроки(СтрокаРеестра.ПозицииУПД) Цикл
			Результат.Вставить(НомерУПДСтроки, НомераПН[0]);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция НомераИзСтроки(Текст)

	Результат = Новый Массив;
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Часть Из СтрРазделить(Текст, ";", Ложь) Цикл
		Попытка
			Результат.Добавить(Число(СокрЛП(Часть)));
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Записи регистра штрихкодов поставщиков по штрихкодам строк УПД.
//
&НаСервере
Функция ЗаписиШтрихкодов(ТоварыУПД)

	Штрихкоды = Новый Массив;
	Для Каждого Товар Из ТоварыУПД Цикл
		Штрихкод = СокрЛП(Товар.Штрихкод);
		Если ЗначениеЗаполнено(Штрихкод) И Штрихкоды.Найти(Штрихкод) = Неопределено Тогда
			Штрихкоды.Добавить(Штрихкод);
		КонецЕсли;
	КонецЦикла;

	Если Штрихкоды.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.КлючНаименования КАК КлючНаименования,
	|	Штрихкоды.НоменклатураДалион КАК НоменклатураДалион,
	|	Штрихкоды.Источник КАК Источник,
	|	Штрихкоды.ДатаОбновления КАК ДатаОбновления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод В (&Штрихкоды)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОбновления УБЫВ";
	Запрос.УстановитьПараметр("Штрихкоды", Штрихкоды);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Запись, по которой строка получила штрихкод: тот же штрихкод под именем
// строки, иначе любая запись этого штрихкода с номенклатурой Далиона.
//
&НаСервере
Функция ЗаписьДляСтроки(Записи, Штрихкод, Наименование)

	Если Записи.Колонки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ключ = ЭАрМ_СверкаТоваровЦепочки.КлючНаименования(Наименование);
	Запасная = Неопределено;

	Для Каждого Запись Из Записи Цикл
		Если СокрЛП(Запись.Штрихкод) <> Штрихкод Тогда
			Продолжить;
		КонецЕсли;
		Если Запись.КлючНаименования = Ключ Тогда
			Возврат Запись;
		КонецЕсли;
		Если Запасная = Неопределено И ЗначениеЗаполнено(Запись.НоменклатураДалион) Тогда
			Запасная = Запись;
		КонецЕсли;
	КонецЦикла;

	Возврат Запасная;

КонецФункции

// Пары строк УПД и строк прихода по имени, количеству и цене - без
// штрихкодов, которые и могли увести сверку в сторону. Все возможные пары
// собираются заранее и раздаются от лучшей к худшей, строка прихода
// достаётся одной строке УПД.
//
// Возвращаемое значение:
//   Соответствие - номер позиции УПД -> Структура (Индекс - индекс в Позиции, Оценка)
//
&НаСервере
Функция ПодобратьПары(ТоварыУПД, Позиции)

	Кандидаты = Новый ТаблицаЗначений;
	Кандидаты.Колонки.Добавить("НомерПозиции", Новый ОписаниеТипов("Число"));
	Кандидаты.Колонки.Добавить("Индекс",       Новый ОписаниеТипов("Число"));
	Кандидаты.Колонки.Добавить("Оценка",       Новый ОписаниеТипов("Число"));
	Кандидаты.Колонки.Добавить("Балл",         Новый ОписаниеТипов("Число"));

	Для Каждого Товар Из ТоварыУПД Цикл

		ЦенаУПД = ЦенаСНДС(Товар);

		Для Индекс = 0 По Позиции.ВГраница() Цикл

			Позиция = Позиции[Индекс];
			Оценка = ЭАрМ_СверкаТоваровЦепочки.ОценкаПохожестиНаименований(
				Товар.Наименование, Позиция.Наименование);
			КоличествоСошлось = Макс(Товар.Количество - Позиция.Количество,
				Позиция.Количество - Товар.Количество) < 0.001;
			ЦенаСошлась = Макс(ЦенаУПД - Позиция.Цена, Позиция.Цена - ЦенаУПД) <= 0.02;

			// Одни цифры без хоть какого-то сходства имени пару не дают: две
			// ветчины по 55 рублей как раз и разошлись крест-накрест
			Если Оценка < 0.5 И НЕ (Оценка > 0 И КоличествоСошлось И ЦенаСошлась) Тогда
				Продолжить;
			КонецЕсли;

			Кандидат = Кандидаты.Добавить();
			Кандидат.НомерПозиции = Товар.НомерПозиции;
			Кандидат.Индекс       = Индекс;
			Кандидат.Оценка       = Оценка;
			Кандидат.Балл         = Оценка + ?(КоличествоСошлось, 0.2, 0) + ?(ЦенаСошлась, 0.1, 0);

		КонецЦикла;

	КонецЦикла;

	Кандидаты.Сортировать("Балл Убыв, НомерПозиции, Индекс");

	Результат = Новый Соответствие;
	Занятые = Новый Соответствие;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Результат.Получить(Кандидат.НомерПозиции) <> Неопределено
			ИЛИ Занятые.Получить(Кандидат.Индекс) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Занятые.Вставить(Кандидат.Индекс, Истина);
		Результат.Вставить(Кандидат.НомерПозиции,
			Новый Структура("Индекс, Оценка", Кандидат.Индекс, Кандидат.Оценка));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Штрихкоды строк прихода так, как их прислал Далион в пакете: без добора
// из регистра штрихкодов поставщиков, который делает ПозицииПоступления.
// Порядок - порядок товаров пакета, как у ПозицииПоступления.
//
// Возвращаемое значение:
//   Массив из Строка - штрихкоды строки через "; "
//
&НаСервере
Функция ШтрихкодыПакетаДалиона(ИдентификаторПоступления)

	Результат = Новый Массив;

	Попытка
		Объект = ЭАрМ_ПриемПакетовДалион.ДанныеОбъекта("ПриходнаяНакладная", ИдентификаторПоступления);
	Исключение
		Возврат Результат;
	КонецПопытки;
	Если Объект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Товар Из ЭАрМ_Служебный.ЗначениеВМассив(ЭАрМ_Служебный.ЗначениеУзла(Объект, "goods")) Цикл

		Номенклатура = ЭАрМ_Служебный.ЗначениеУзла(Товар, "nomenclature");

		Список = Новый Массив;
		ДобавитьШтрихкодПакета(Список, ЭАрМ_Служебный.ЗначениеУзла(Товар, "barcode", ""));
		ДобавитьШтрихкодПакета(Список, ЭАрМ_Служебный.ЗначениеУзла(Номенклатура, "barcode", ""));
		ДобавитьШтрихкодыУзлаПакета(Список, Товар);
		ДобавитьШтрихкодыУзлаПакета(Список, Номенклатура);

		Результат.Добавить(СтрСоединить(Список, "; "));

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ДобавитьШтрихкодыУзлаПакета(Список, Узел)

	Для Каждого ОписаниеШтрихкода Из ЭАрМ_Служебный.ЗначениеВМассив(
		ЭАрМ_Служебный.ЗначениеУзла(Узел, "barcodes")) Цикл
		Если ТипЗнч(ОписаниеШтрихкода) = Тип("Строка") Тогда
			ДобавитьШтрихкодПакета(Список, ОписаниеШтрихкода);
		Иначе
			ДобавитьШтрихкодПакета(Список, ЭАрМ_Служебный.ЗначениеУзла(ОписаниеШтрихкода, "barcode", ""));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьШтрихкодПакета(Список, Значение)

	Текст = СокрЛП(ЭАрМ_Служебный.СтрокойИлиПусто(Значение));
	Если ЗначениеЗаполнено(Текст) И Список.Найти(Текст) = Неопределено Тогда
		Список.Добавить(Текст);
	КонецЕсли;

КонецПроцедуры

// Штрихкоды номенклатуры УТ (регистр ШтрихкодыНоменклатуры) для строк
// прихода. Номенклатура УТ - с тем же УИД, что uid номенклатуры Далиона; не
// нашлась по УИД - по коду Далиона среди кодов УТ, с пометкой «по коду»:
// коды у Далиона и УТ могут не совпадать (см. ЭАрМ_ДиагностикаШтрихкодов).
//
// Возвращаемое значение:
//   Массив из Строка - по строке на позицию, штрихкоды через "; "
//
&НаСервере
Функция ШтрихкодыУТПоПозициям(Позиции)

	Результат = Новый Массив;
	Ссылки = Новый Массив;
	Коды   = Новый Массив;
	УидыПозиций = Новый Массив;

	Для Каждого Позиция Из Позиции Цикл
		Результат.Добавить("");
		Уид = "";
		Если Позиция.Свойство("ИдентификаторНоменклатуры") Тогда
			Уид = НРег(СокрЛП(Позиция.ИдентификаторНоменклатуры));
		КонецЕсли;
		Если ЗначениеЗаполнено(Уид) Тогда
			Попытка
				Ссылки.Добавить(Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Уид)));
			Исключение
				Уид = "";
			КонецПопытки;
		КонецЕсли;
		УидыПозиций.Добавить(Уид);
		Код = СокрЛП(Позиция.КодНоменклатуры);
		Если ЗначениеЗаполнено(Код) И Коды.Найти(Код) = Неопределено Тогда
			Коды.Добавить(Код);
		КонецЕсли;
	КонецЦикла;

	Если Ссылки.Количество() = 0 И Коды.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ПоУид  = Новый Соответствие;
	ПоКоду = Новый Соответствие;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Штрихкоды.Штрихкод КАК Штрихкод,
		|	Штрихкоды.Номенклатура КАК Номенклатура,
		|	Штрихкоды.Номенклатура.Код КАК Код
		|ИЗ
		|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
		|ГДЕ
		|	(Штрихкоды.Номенклатура В (&Ссылки)
		|		ИЛИ Штрихкоды.Номенклатура.Код В (&Коды))";
		Запрос.УстановитьПараметр("Ссылки", Ссылки);
		Запрос.УстановитьПараметр("Коды", Коды);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Штрихкод = СокрЛП(Выборка.Штрихкод);
			Если НЕ ЗначениеЗаполнено(Штрихкод) ИЛИ НЕ ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьВСписок(ПоУид, НРег(Строка(Выборка.Номенклатура.УникальныйИдентификатор())), Штрихкод);
			ДобавитьВСписок(ПоКоду, СокрЛП(Выборка.Код), Штрихкод);
		КонецЦикла;
	Исключение
		// Регистра штрихкодов номенклатуры в базе нет - колонка останется пустой
		Возврат Результат;
	КонецПопытки;

	Для Индекс = 0 По Позиции.ВГраница() Цикл
		Список = Неопределено;
		Если ЗначениеЗаполнено(УидыПозиций[Индекс]) Тогда
			Список = ПоУид.Получить(УидыПозиций[Индекс]);
		КонецЕсли;
		Если Список <> Неопределено Тогда
			Результат[Индекс] = СтрСоединить(Список, "; ");
			Продолжить;
		КонецЕсли;
		Список = ПоКоду.Получить(СокрЛП(Позиции[Индекс].КодНоменклатуры));
		Если Список <> Неопределено Тогда
			Результат[Индекс] = СтрСоединить(Список, "; ") + " " + НСтр("ru = '(по коду)'");
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ДобавитьВСписок(Соответствие, Ключ, Значение)

	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;

	Список = Соответствие.Получить(Ключ);
	Если Список = Неопределено Тогда
		Список = Новый Массив;
		Соответствие.Вставить(Ключ, Список);
	КонецЕсли;
	Если Список.Найти(Значение) = Неопределено Тогда
		Список.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ШтрихкодыПозиции(Позиция)

	Если Позиция.Свойство("Штрихкоды") И ТипЗнч(Позиция.Штрихкоды) = Тип("Массив") Тогда
		Возврат СтрСоединить(Позиция.Штрихкоды, ";");
	КонецЕсли;

	Возврат СокрЛП(Позиция.Штрихкод);

КонецФункции

// Номенклатура Далиона строки прихода в виде, который ждёт
// СвязатьСтрокуУПДСПриходом: "uid:...;код:...". uid - как в пакете: сверка
// сравнивает его с пакетом без приведения регистра.
//
&НаСервере
Функция КлючиНоменклатуры(Позиция)

	Ключи = Новый Массив;
	Если Позиция.Свойство("ИдентификаторНоменклатуры") И ЗначениеЗаполнено(Позиция.ИдентификаторНоменклатуры) Тогда
		Ключи.Добавить("uid:" + СокрЛП(Позиция.ИдентификаторНоменклатуры));
	КонецЕсли;
	Если ЗначениеЗаполнено(Позиция.КодНоменклатуры) Тогда
		Ключи.Добавить("код:" + СокрЛП(Позиция.КодНоменклатуры));
	КонецЕсли;

	Возврат СтрСоединить(Ключи, ";");

КонецФункции

&НаСервереБезКонтекста
Функция КлючСтроки(ИдентификаторУПД, НомерПозиции)

	Возврат СокрЛП(ИдентификаторУПД) + "|" + Формат(НомерПозиции, "ЧГ=0");

КонецФункции

#КонецОбласти

#Область Исправление

// Связывает отмеченные строки с предложенными строками прихода штатной ручной
// парой и перечитывает таблицу. Ничего не удаляет.
//
&НаСервере
Процедура СвязатьОтмеченныеНаСервере()

	Результаты = Новый Соответствие;
	Связано = 0;
	Ошибок  = 0;

	Для Каждого Строка Из Строки Цикл

		Если НЕ Строка.Отметка Тогда
			Продолжить;
		КонецЕсли;

		Ключ = КлючСтроки(Строка.ИдентификаторУПД, Строка.НомерПозиции);

		Если НЕ ЗначениеЗаполнено(Строка.ПредлагаемаяПара) Тогда
			Результаты.Вставить(Ключ, НСтр("ru = 'Нет предложенной строки прихода - связать не с чем'"));
			Ошибок = Ошибок + 1;
			Продолжить;
		КонецЕсли;

		СтрокаУПД = Новый Структура("Наименование, КодТовараПоставщика, Штрихкоды",
			Строка.Наименование, Строка.КодТовараПоставщика, Строка.ШтрихкодыУПД);
		СтрокаПрихода = Новый Структура("Наименование, Штрихкоды, КлючиНоменклатуры",
			Строка.ПредлагаемаяПара, Строка.ШтрихкодыПрихода, Строка.КлючиНоменклатуры);

		Попытка
			Итог = ЭАрМ_СверкаТоваровЦепочки.СвязатьСтрокуУПДСПриходом(Строка.ИдентификаторУПД,
				СтрокаУПД, СтрокаПрихода, Строка.ИННПоставщика, Строка.Поставщик,
				ПерезаписатьПринудительно);
			Результаты.Вставить(Ключ, Итог.Текст);
			Если Итог.Успех Тогда
				Связано = Связано + 1;
			Иначе
				Ошибок = Ошибок + 1;
			КонецЕсли;
		Исключение
			Результаты.Вставить(Ключ, ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
			Ошибок = Ошибок + 1;
		КонецПопытки;

	КонецЦикла;

	ПоказатьНаСервере(Результаты);

	Итоги = СтрШаблон(НСтр("ru = 'Связано строк: %1, не удалось: %2. %3'"), Связано, Ошибок, Итоги);

КонецПроцедуры

#КонецОбласти

#Область НоменклатураИШтрихкоды

// Вторая страница: номенклатура Далиона со штрихкодами из регистра
// ЭАрМ_ШтрихкодыПоставщиков и название товара у поставщика. Название правится
// руками или выбирается из названий УПД поставщика; к выбранной паре
// подставляется ШК из УПД (GTIN из XML) - и пара пишется ручной парой.
// Поставщик выбирается по наименованию. Номенклатуру Далиона для пары можно
// подобрать вручную из приходных накладных поставщика: выбрать из списка,
// ввести штрихкод (в любом написании) или часть названия.

&НаКлиенте
Процедура ЗагрузитьНоменклатуру(Команда)

	ЗагрузитьНоменклатуруНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура НоменклатураНазваниеПоставщикаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Номенклатура.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПодставитьШКИзУПД(ТекущиеДанные.ПолучитьИдентификатор());

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПары(Команда)

	Отмечено = 0;
	Для Каждого Строка Из Номенклатура Цикл
		Если Строка.Записать Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;

	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте строки «Записать» - или просто измените в них название поставщика'"));
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("ЗаписатьПарыЗавершение", ЭтотОбъект),
		СтрШаблон(НСтр("ru = 'Записать пары (%1)? Название поставщика и ШК из УПД лягут ручной парой к номенклатуре Далиона, цепочки этих УПД пересверятся.'"),
			Отмечено), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПарыЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаписатьПарыНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьДублиШК(Команда)

	Найдено = УбратьДублиШК(Истина);
	Если Найдено.Удалить = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Дублей в штрихкодах поставщиков нет'"));
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("УдалитьДублиШКЗавершение", ЭтотОбъект),
		СтрШаблон(НСтр("ru = 'Найдено дублей: %1 (в %2 группах) - один штрихкод, записанный по-разному (с нулём, GTIN-14, 01+GTIN), под тем же названием.
			|В каждой группе остаётся самая надёжная запись, данные остальных переносятся в неё. Удалить дубли?'"),
			Найдено.Удалить, Найдено.Групп), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьДублиШКЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Итог = УбратьДублиШК(Ложь);
	ИтогиНоменклатуры = Итог.Текст;

КонецПроцедуры

&НаКлиенте
Процедура НоменклатураНоменклатураДалионПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Номенклатура.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();
	Варианты = НайтиТоварыПрихода(ТекущиеДанные.НоменклатураДалион);

	Если Варианты.Количество() = 1 Тогда
		ПрименитьТоварПрихода(ИдентификаторСтроки, Варианты[0].Значение);
	ИначеЕсли Варианты.Количество() > 1 Тогда
		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ВыборТовараПриходаЗавершение", ЭтотОбъект,
			ИдентификаторСтроки), Варианты, Элемент);
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'В приходных накладных поставщика не найдено ни по штрихкоду, ни по названию. Загрузите номенклатуру с поставщиком или уточните текст.'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыборТовараПриходаЗавершение(ВыбранныйЭлемент, ИдентификаторСтроки) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПрименитьТоварПрихода(ИдентификаторСтроки, ВыбранныйЭлемент.Значение);

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНоменклатуруНаСервере()

	Номенклатура.Очистить();
	ТоварыПоставщика.Очистить();
	ТоварыПрихода.Очистить();
	Варианты.Очистить();
	ИтогиВариантов = "";

	// Поставщика ищем по наименованию; ИНН - только внутренний ключ записей
	Поставщик = СокрЛП(ПоставщикОтбор);
	ИННы = Новый Массив;
	Если ЗначениеЗаполнено(Поставщик) Тогда
		ИННы = ИННПоставщикаПоНаименованию(Поставщик);
		ЗагрузитьТоварыПоставщика(ИННы);
		ЗагрузитьТоварыПрихода(ИННы, Поставщик);
	КонецЕсли;

	СписокВыбора = Элементы.НоменклатураНазваниеПоставщика.СписокВыбора;
	СписокВыбора.Очистить();
	Для Каждого Товар Из ТоварыПоставщика Цикл
		СписокВыбора.Добавить(Товар.Наименование);
	КонецЦикла;
	СписокВыбора.СортироватьПоЗначению();

	// Подбор номенклатуры Далиона: в списке - название и штрихкоды прихода,
	// выбирается само название; штрихкод или часть названия можно ввести руками
	СписокВыбора = Элементы.НоменклатураНоменклатураДалион.СписокВыбора;
	СписокВыбора.Очистить();
	Для Каждого Товар Из ТоварыПрихода Цикл
		СписокВыбора.Добавить(Товар.Наименование, Товар.Представление);
	КонецЦикла;
	СписокВыбора.СортироватьПоЗначению();

	Записи = ЗаписиНоменклатуры(ИННы, ЗначениеЗаполнено(Поставщик), СокрЛП(ПоискНоменклатуры));

	Группы = Новый Соответствие;
	Порядок = Новый Массив;

	Для Каждого Запись Из Записи Цикл

		Уид = СокрЛП(Запись.Уид);
		Группа = Группы.Получить(Уид);
		Если Группа = Неопределено Тогда
			Группа = НоваяГруппаНоменклатуры();
			Группы.Вставить(Уид, Группа);
			Порядок.Добавить(Уид);
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Группа.НоменклатураДалион) Тогда
			Группа.НоменклатураДалион = СокрЛП(Запись.НоменклатураДалион);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Группа.КодДалион) Тогда
			Группа.КодДалион = СокрЛП(Запись.КодНоменклатурыДалион);
		КонецЕсли;
		ДобавитьШтрихкодГруппы(Группа, Запись.Штрихкод);

		// Пара с названием поставщика: запись, где название - не само имя
		// Далиона. Записи отсортированы от надёжного источника - берём первую
		Если НЕ ЗначениеЗаполнено(Группа.НазваниеПоставщика)
			И Запись.КлючНаименования <> ЭАрМ_СверкаТоваровЦепочки.КлючНаименования(Запись.НоменклатураДалион)
			И (ИННы.Количество() = 0 ИЛИ ИННы.Найти(СокрЛП(Запись.ИННПоставщика)) <> Неопределено) Тогда
			Группа.НазваниеПоставщика = СокрЛП(Запись.НаименованиеПоставщика);
			Группа.КодПоставщика      = СокрЛП(Запись.КодТовараПоставщика);
			Группа.ИсточникПары       = СокрЛП(Запись.Источник);
			Группа.ИНН                = СокрЛП(Запись.ИННПоставщика);
		КонецЕсли;

	КонецЦикла;

	// Номенклатура из приходных поставщика, которой в регистре ещё нет
	Для Каждого Товар Из ТоварыПрихода Цикл
		Ключ = ?(ЗначениеЗаполнено(Товар.Уид), Товар.Уид, "код:" + Товар.Код + "|" + Товар.Наименование);
		Если Группы.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Группа = НоваяГруппаНоменклатуры();
		Группа.НоменклатураДалион = Товар.Наименование;
		Группа.КодДалион          = Товар.Код;
		Для Каждого Штрихкод Из СтрРазделить(Товар.Штрихкоды, ";", Ложь) Цикл
			ДобавитьШтрихкодГруппы(Группа, Штрихкод);
		КонецЦикла;
		Группы.Вставить(Ключ, Группа);
		Порядок.Добавить(Ключ);
	КонецЦикла;

	БезПары = 0;
	ВзятыеНазвания = Новый Соответствие;

	Для Каждого Ключ Из Порядок Цикл

		Группа = Группы.Получить(Ключ);
		Если НЕ ЗначениеЗаполнено(Группа.НазваниеПоставщика) Тогда
			БезПары = БезПары + 1;
		ИначеЕсли ТолькоБезПары Тогда
			ВзятыеНазвания.Вставить(ЭАрМ_СверкаТоваровЦепочки.КлючНаименования(Группа.НазваниеПоставщика), Истина);
			Продолжить;
		КонецЕсли;

		Строка = Номенклатура.Добавить();
		Строка.ИдентификаторДалион = ?(СтрНачинаетсяС(Ключ, "код:"), "", Ключ);
		Строка.НоменклатураДалион  = Группа.НоменклатураДалион;
		Строка.КодДалион           = Группа.КодДалион;
		Строка.ШтрихкодыДалиона    = СтрСоединить(Группа.Штрихкоды, "; ");
		Строка.НазваниеПоставщика  = Группа.НазваниеПоставщика;
		Строка.КодПоставщика       = Группа.КодПоставщика;
		Строка.ИсточникПары        = Группа.ИсточникПары;
		Строка.ИННПоставщика       = Группа.ИНН;

		Если ЗначениеЗаполнено(Строка.НазваниеПоставщика) Тогда
			ВзятыеНазвания.Вставить(ЭАрМ_СверкаТоваровЦепочки.КлючНаименования(Строка.НазваниеПоставщика), Истина);
			ЗаполнитьПоНазваниюПоставщика(Строка);
		КонецЕсли;

	КонецЦикла;

	// Товары из УПД поставщика без пары: номенклатуру Далиона к ним подбирают
	// вручную по штрихкоду или названию из приходных
	ТоварыБезПары = 0;
	Для Каждого Товар Из ТоварыПоставщика Цикл
		Если ВзятыеНазвания.Получить(Товар.КлючНаименования) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТоварыБезПары = ТоварыБезПары + 1;
		Строка = Номенклатура.Добавить();
		Строка.НазваниеПоставщика = Товар.Наименование;
		ЗаполнитьПоНазваниюПоставщика(Строка);
		Строка.Результат = НСтр("ru = 'Нет пары - подберите номенклатуру Далиона по ШК или названию'");
	КонецЦикла;

	Таблица = РеквизитФормыВЗначение("Номенклатура");
	Таблица.Сортировать("НоменклатураДалион, НазваниеПоставщика");
	ЗначениеВРеквизитФормы(Таблица, "Номенклатура");

	ИтогиНоменклатуры = СтрШаблон(
		НСтр("ru = 'Номенклатуры Далиона: %1, без названия поставщика: %2. Товаров в УПД поставщика: %3, из них без пары: %4. Номенклатуры в приходных: %5.%6'"),
		Порядок.Количество(), БезПары, ТоварыПоставщика.Количество(), ТоварыБезПары, ТоварыПрихода.Количество(),
		?(ЗначениеЗаполнено(Поставщик), "", " " + НСтр("ru = 'Выберите поставщика - будут названия из его УПД, ШК к паре и подбор из приходных.'")));

КонецПроцедуры

&НаСервереБезКонтекста
Функция НоваяГруппаНоменклатуры()

	Возврат Новый Структура("НоменклатураДалион, КодДалион, Штрихкоды, Каноны,
		|НазваниеПоставщика, КодПоставщика, ИсточникПары, ИНН",
		"", "", Новый Массив, Новый Соответствие, "", "", "", "");

КонецФункции

// Штрихкод в любом написании (с нулём, GTIN-14) - в группе один раз.
//
&НаСервереБезКонтекста
Процедура ДобавитьШтрихкодГруппы(Группа, Знач Штрихкод)

	Штрихкод = СокрЛП(Штрихкод);
	Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат;
	КонецЕсли;

	Канон = ЭАрМ_СверкаТоваровЦепочки.КаноническийШтрихкод(Штрихкод);
	Если НЕ ЗначениеЗаполнено(Канон) Тогда
		Канон = ВРег(Штрихкод);
	КонецЕсли;
	Если Группа.Каноны.Получить(Канон) = Неопределено Тогда
		Группа.Каноны.Вставить(Канон, Истина);
		Группа.Штрихкоды.Добавить(Штрихкод);
	КонецЕсли;

КонецПроцедуры

// ИНН поставщика по наименованию из УПД: точное совпадение, иначе по части
// наименования.
//
&НаСервереБезКонтекста
Функция ИННПоставщикаПоНаименованию(Поставщик)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УПД.ИННКонтрагента КАК ИНН,
	|	ВЫБОР
	|		КОГДА УПД.Контрагент = &Поставщик
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Порядок
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.Контрагент ПОДОБНО &Шаблон
	|	И УПД.ИННКонтрагента <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	Запрос.УстановитьПараметр("Шаблон", "%" + Поставщик + "%");

	Результат = Новый Массив;
	ЕстьТочное = Ложь;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Нашёлся точный - частичные совпадения других поставщиков не берём
		Если Выборка.Порядок = 1 И ЕстьТочное Тогда
			Прервать;
		КонецЕсли;
		ЕстьТочное = ЕстьТочное ИЛИ Выборка.Порядок = 0;
		ИНН = СокрЛП(Выборка.ИНН);
		Если Результат.Найти(ИНН) = Неопределено Тогда
			Результат.Добавить(ИНН);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Список наименований поставщиков из УПД - для выбора в отборе.
//
&НаСервере
Процедура ЗаполнитьСписокПоставщиков()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УПД.Контрагент КАК Контрагент
	|ИЗ
	|	РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|ГДЕ
	|	УПД.Контрагент <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагент";

	СписокВыбора = Элементы.ПоставщикОтбор.СписокВыбора;
	СписокВыбора.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокВыбора.Добавить(СокрЛП(Выборка.Контрагент));
	КонецЦикла;

КонецПроцедуры

// Записи регистра штрихкодов поставщиков с номенклатурой Далиона. С
// поставщиком - номенклатура, которая хоть раз связывалась с ним; поиск - по
// имени Далиона и названию поставщика. Сначала надёжные источники и свежие.
//
&НаСервере
Функция ЗаписиНоменклатуры(ИННы, ЕстьПоставщик, Поиск)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Штрихкоды.ИдентификаторНоменклатурыДалион КАК Уид,
	|	Штрихкоды.НоменклатураДалион КАК НоменклатураДалион,
	|	Штрихкоды.КодНоменклатурыДалион КАК КодНоменклатурыДалион,
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.НаименованиеПоставщика КАК НаименованиеПоставщика,
	|	Штрихкоды.КлючНаименования КАК КлючНаименования,
	|	Штрихкоды.ИННПоставщика КАК ИННПоставщика,
	|	Штрихкоды.КодТовараПоставщика КАК КодТовараПоставщика,
	|	Штрихкоды.Источник КАК Источник,
	|	Штрихкоды.ДатаОбновления КАК ДатаОбновления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.ИдентификаторНоменклатурыДалион В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				Отбор.ИдентификаторНоменклатурыДалион
	|			ИЗ
	|				РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Отбор
	|			ГДЕ
	|				Отбор.ИдентификаторНоменклатурыДалион <> """"
	|				И (НЕ &ЕстьПоставщик
	|					ИЛИ Отбор.ИННПоставщика В (&ИННы))
	|				И (НЕ &ЕстьПоиск
	|					ИЛИ Отбор.НоменклатураДалион ПОДОБНО &Шаблон
	|					ИЛИ Отбор.НаименованиеПоставщика ПОДОБНО &Шаблон))";
	Запрос.УстановитьПараметр("ЕстьПоставщик", ЕстьПоставщик);
	Запрос.УстановитьПараметр("ИННы", ИННы);
	Запрос.УстановитьПараметр("ЕстьПоиск", ЗначениеЗаполнено(Поиск));
	Запрос.УстановитьПараметр("Шаблон", "%" + Поиск + "%");

	Записи = Запрос.Выполнить().Выгрузить();

	Записи.Колонки.Добавить("Приоритет", Новый ОписаниеТипов("Число"));
	Для Каждого Запись Из Записи Цикл
		Запись.Приоритет = ПриоритетИсточника(Запись.Источник);
	КонецЦикла;
	Записи.Сортировать("Приоритет, ДатаОбновления Убыв");

	Возврат Записи;

КонецФункции

// Товары из УПД поставщика: название, код, GTIN из XML и последняя УПД с этим
// названием - по ней пишется ручная пара и пересверяется цепочка.
//
&НаСервере
Процедура ЗагрузитьТоварыПоставщика(ИННы)

	Если ИННы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Наименование КАК Наименование,
	|	Товары.КодТовараПоставщика КАК КодТовараПоставщика,
	|	ВЫБОР
	|		КОГДА Товары.СпособПоискаШК = ""GTIN""
	|			ТОГДА Товары.Штрихкод
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Штрихкод,
	|	Товары.ИдентификаторСБИС КАК ИдентификаторУПД,
	|	УПД.Контрагент КАК Поставщик,
	|	УПД.ИННКонтрагента КАК ИНН,
	|	УПД.Дата КАК Дата
	|ИЗ
	|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
	|		ПО Товары.ИдентификаторСБИС = УПД.ИдентификаторСБИС
	|ГДЕ
	|	Товары.ИсточникТоваров = ""УПД""
	|	И УПД.ИННКонтрагента В (&ИННы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("ИННы", ИННы);

	ПоКлючу = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Наименование = СокрЛП(Выборка.Наименование);
		Ключ = ЭАрМ_СверкаТоваровЦепочки.КлючНаименования(Наименование);
		Если НЕ ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;

		// Свежая УПД первой; GTIN берём из любой, где он был
		Товар = ПоКлючу.Получить(Ключ);
		Если Товар = Неопределено Тогда
			Товар = ТоварыПоставщика.Добавить();
			Товар.Наименование        = Наименование;
			Товар.КлючНаименования    = Ключ;
			Товар.КодТовараПоставщика = СокрЛП(Выборка.КодТовараПоставщика);
			Товар.ИдентификаторУПД    = СокрЛП(Выборка.ИдентификаторУПД);
			Товар.Поставщик           = СокрЛП(Выборка.Поставщик);
			Товар.ИНН                 = СокрЛП(Выборка.ИНН);
			ПоКлючу.Вставить(Ключ, Товар);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Товар.Штрихкод) Тогда
			Товар.Штрихкод = СокрЛП(Выборка.Штрихкод);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Номенклатура Далиона из приходных накладных поставщика - то, из чего
// подбирается пара вручную. Приходные - по цепочкам закупки с этим
// поставщиком, последние ПриходныхДляПодбора(); штрихкоды - как у сверки.
//
&НаСервере
Процедура ЗагрузитьТоварыПрихода(ИННы, Поставщик)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 50
	|	Цепочка.ИдентификаторПоступления КАК ИдентификаторПоступления,
	|	МАКСИМУМ(Цепочка.ДатаПоступления) КАК ДатаПоступления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ЦепочкаЗакупки КАК Цепочка
	|ГДЕ
	|	Цепочка.ИдентификаторПоступления <> """"
	|	И (Цепочка.ИННПоставщика В (&ИННы)
	|		ИЛИ Цепочка.Поставщик ПОДОБНО &Шаблон)
	|
	|СГРУППИРОВАТЬ ПО
	|	Цепочка.ИдентификаторПоступления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПоступления УБЫВ";
	Запрос.УстановитьПараметр("ИННы", ИННы);
	Запрос.УстановитьПараметр("Шаблон", "%" + Поставщик + "%");

	ПоКлючу = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Попытка
			//@skip-check query-in-loop
			Позиции = ЭАрМ_ЦепочкаЗакупки.ПозицииПоступления(Выборка.ИдентификаторПоступления);
		Исключение
			Продолжить;
		КонецПопытки;

		Для Каждого Позиция Из Позиции Цикл

			Уид = "";
			Если Позиция.Свойство("ИдентификаторНоменклатуры") Тогда
				Уид = СокрЛП(Позиция.ИдентификаторНоменклатуры);
			КонецЕсли;
			Наименование = СокрЛП(Позиция.Наименование);
			Код = СокрЛП(Позиция.КодНоменклатуры);
			Ключ = ?(ЗначениеЗаполнено(Уид), Уид, "код:" + Код + "|" + Наименование);

			Товар = ПоКлючу.Получить(Ключ);
			Если Товар = Неопределено Тогда
				Товар = ТоварыПрихода.Добавить();
				Товар.Наименование = Наименование;
				Товар.Код          = Код;
				Товар.Уид          = Уид;
				ПоКлючу.Вставить(Ключ, Товар);
			КонецЕсли;

			Штрихкоды = СтрРазделить(Товар.Штрихкоды, ";", Ложь);
			Для Каждого Штрихкод Из СтрРазделить(ШтрихкодыПозиции(Позиция), ";", Ложь) Цикл
				Штрихкод = СокрЛП(Штрихкод);
				Если ЗначениеЗаполнено(Штрихкод) И Штрихкоды.Найти(Штрихкод) = Неопределено Тогда
					Штрихкоды.Добавить(Штрихкод);
				КонецЕсли;
			КонецЦикла;
			Товар.Штрихкоды = СтрСоединить(Штрихкоды, ";");

		КонецЦикла;

	КонецЦикла;

	Для Каждого Товар Из ТоварыПрихода Цикл
		Товар.Представление = Товар.Наименование
			+ ?(ЗначениеЗаполнено(Товар.Штрихкоды), " | ШК: " + СтрЗаменить(Товар.Штрихкоды, ";", ", "), "")
			+ ?(ЗначениеЗаполнено(Товар.Код), " | код " + Товар.Код, "");
	КонецЦикла;

КонецПроцедуры

// Номенклатура прихода по введённому тексту: точное название, штрихкод
// (в любом написании - с нулём, GTIN-14) или часть названия.
//
// Возвращаемое значение:
//   СписокЗначений - значение - индекс в ТоварыПрихода, представление - товар
//
&НаСервере
Функция НайтиТоварыПрихода(Знач Текст)

	Результат = Новый СписокЗначений;
	Текст = СокрЛП(Текст);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	// Выбрано из списка - точное название
	Для Индекс = 0 По ТоварыПрихода.Количество() - 1 Цикл
		Если ВРег(ТоварыПрихода[Индекс].Наименование) = ВРег(Текст) Тогда
			Результат.Добавить(Индекс, ТоварыПрихода[Индекс].Представление);
		КонецЕсли;
	КонецЦикла;
	Если Результат.Количество() > 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Штрихкод
	ТолькоЦифры = СтрДлина(Текст) >= 8;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			ТолькоЦифры = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ТолькоЦифры Тогда
		Для Индекс = 0 По ТоварыПрихода.Количество() - 1 Цикл
			Для Каждого Штрихкод Из СтрРазделить(ТоварыПрихода[Индекс].Штрихкоды, ";", Ложь) Цикл
				Если ЭАрМ_СверкаТоваровЦепочки.ШтрихкодыСовпадают(СокрЛП(Штрихкод), Текст) Тогда
					Результат.Добавить(Индекс, ТоварыПрихода[Индекс].Представление);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Часть названия
	Искомое = НРег(Текст);
	Для Индекс = 0 По ТоварыПрихода.Количество() - 1 Цикл
		Если СтрНайти(НРег(ТоварыПрихода[Индекс].Наименование), Искомое) > 0 Тогда
			Результат.Добавить(Индекс, ТоварыПрихода[Индекс].Представление);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ставит строке пары номенклатуру Далиона из прихода: название, код, uid и
// штрихкоды; ШК из УПД сверяется с ними заново.
//
&НаСервере
Процедура ПрименитьТоварПрихода(ИдентификаторСтроки, ИндексТовара)

	Строка = Номенклатура.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Строка = Неопределено ИЛИ ИндексТовара < 0 ИЛИ ИндексТовара >= ТоварыПрихода.Количество() Тогда
		Возврат;
	КонецЕсли;

	Товар = ТоварыПрихода[ИндексТовара];
	Строка.НоменклатураДалион  = Товар.Наименование;
	Строка.КодДалион           = Товар.Код;
	Строка.ИдентификаторДалион = Товар.Уид;
	Строка.ШтрихкодыДалиона    = СтрЗаменить(Товар.Штрихкоды, ";", "; ");
	Строка.ИсточникПары        = НСтр("ru = 'подобрано вручную'");

	Если ЗначениеЗаполнено(Строка.НазваниеПоставщика) Тогда
		ЗаполнитьПоНазваниюПоставщика(Строка);
	КонецЕсли;
	Строка.Записать = ЗначениеЗаполнено(Строка.НазваниеПоставщика);

КонецПроцедуры

&НаСервере
Процедура ПодставитьШКИзУПД(ИдентификаторСтроки)

	Строка = Номенклатура.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьПоНазваниюПоставщика(Строка);
	Строка.Записать = ЗначениеЗаполнено(Строка.НазваниеПоставщика);
	Строка.ИсточникПары = НСтр("ru = 'изменено вручную'");

КонецПроцедуры

// ШК из УПД, код и УПД к названию поставщика строки.
//
&НаСервере
Процедура ЗаполнитьПоНазваниюПоставщика(Строка)

	Строка.ШтрихкодУПД      = "";
	Строка.ИдентификаторУПД = "";
	Строка.ШКСовпадает      = Ложь;
	Строка.Результат        = "";

	Ключ = ЭАрМ_СверкаТоваровЦепочки.КлючНаименования(Строка.НазваниеПоставщика);
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;

	Найденные = ТоварыПоставщика.НайтиСтроки(Новый Структура("КлючНаименования", Ключ));
	Если Найденные.Количество() = 0 Тогда
		Если ТоварыПоставщика.Количество() > 0 Тогда
			Строка.Результат = НСтр("ru = 'Такого названия нет в УПД поставщика - выберите из списка'");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Товар = Найденные[0];
	Строка.ШтрихкодУПД      = Товар.Штрихкод;
	Строка.ИдентификаторУПД = Товар.ИдентификаторУПД;
	Строка.Поставщик        = Товар.Поставщик;
	Строка.ИННПоставщика    = Товар.ИНН;
	Если ЗначениеЗаполнено(Товар.КодТовараПоставщика) Тогда
		Строка.КодПоставщика = Товар.КодТовараПоставщика;
	КонецЕсли;

	Если ЗначениеЗаполнено(Строка.ШтрихкодУПД) Тогда
		Для Каждого Штрихкод Из СтрРазделить(Строка.ШтрихкодыДалиона, ";", Ложь) Цикл
			Если ЭАрМ_СверкаТоваровЦепочки.ШтрихкодыСовпадают(СокрЛП(Штрихкод), Строка.ШтрихкодУПД) Тогда
				Строка.ШКСовпадает = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьПарыНаСервере()

	Записано = 0;
	Ошибок = 0;

	Для Каждого Строка Из Номенклатура Цикл

		Если НЕ Строка.Записать Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Строка.НазваниеПоставщика) Тогда
			Строка.Результат = НСтр("ru = 'Не указано название у поставщика'");
			Ошибок = Ошибок + 1;
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Строка.НоменклатураДалион)
			ИЛИ НЕ ЗначениеЗаполнено(Строка.ИдентификаторДалион + Строка.КодДалион + Строка.ШтрихкодыДалиона) Тогда
			Строка.Результат = НСтр("ru = 'Не подобрана номенклатура Далиона - выберите её по ШК или названию из приходных'");
			Ошибок = Ошибок + 1;
			Продолжить;
		КонецЕсли;

		// Без УПД с этим названием нечего пересверить, а СвязатьСтрокуУПДСПриходом
		// с пустой УПД пересверила бы все цепочки без УПД
		Если НЕ ЗначениеЗаполнено(Строка.ИдентификаторУПД) Тогда
			Строка.Результат = НСтр("ru = 'Названия нет в УПД поставщика (выберите поставщика и название из списка)'");
			Ошибок = Ошибок + 1;
			Продолжить;
		КонецЕсли;

		Ключи = Новый Массив;
		Если ЗначениеЗаполнено(Строка.ИдентификаторДалион) Тогда
			Ключи.Добавить("uid:" + Строка.ИдентификаторДалион);
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.КодДалион) Тогда
			Ключи.Добавить("код:" + Строка.КодДалион);
		КонецЕсли;

		СтрокаУПД = Новый Структура("Наименование, КодТовараПоставщика, Штрихкоды",
			Строка.НазваниеПоставщика, Строка.КодПоставщика, Строка.ШтрихкодУПД);
		СтрокаПрихода = Новый Структура("Наименование, Штрихкоды, КлючиНоменклатуры",
			Строка.НоменклатураДалион, СтрЗаменить(Строка.ШтрихкодыДалиона, " ", ""),
			СтрСоединить(Ключи, ";"));

		Попытка
			Итог = ЭАрМ_СверкаТоваровЦепочки.СвязатьСтрокуУПДСПриходом(Строка.ИдентификаторУПД,
				СтрокаУПД, СтрокаПрихода, Строка.ИННПоставщика, Строка.Поставщик,
				ПерезаписатьПринудительно);
			Строка.Результат = Итог.Текст;
			Если Итог.Успех Тогда
				Строка.Записать = Ложь;
				Строка.ИсточникПары = "РучнаяПара";
				Записано = Записано + 1;
			Иначе
				Ошибок = Ошибок + 1;
			КонецЕсли;
		Исключение
			Строка.Результат = ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке());
			Ошибок = Ошибок + 1;
		КонецПопытки;

	КонецЦикла;

	ИтогиНоменклатуры = СтрШаблон(НСтр("ru = 'Записано пар: %1, не удалось: %2.'"), Записано, Ошибок);

КонецПроцедуры

// Дубли регистра штрихкодов поставщиков: один штрихкод в разных написаниях
// (EAN-13, GTIN-14 с нулём, UPC-A, 01+GTIN) под тем же названием - это одна
// запись. В группе остаётся самая надёжная (источник, есть номенклатура
// Далиона, свежая); пустые поля оставшейся заполняются из удаляемых.
//
// Параметры:
//   ТолькоПосчитать - Булево - Истина: ничего не удалять, вернуть число
//
// Возвращаемое значение:
//   Структура - Групп, Удалить, Текст
//
&НаСервереБезКонтекста
Функция УбратьДублиШК(ТолькоПосчитать)

	Результат = Новый Структура("Групп, Удалить, Текст", 0, 0, "");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.КлючНаименования КАК КлючНаименования,
	|	Штрихкоды.Источник КАК Источник,
	|	Штрихкоды.ДатаОбновления КАК ДатаОбновления,
	|	Штрихкоды.ИдентификаторНоменклатурыДалион КАК ИдентификаторНоменклатурыДалион
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды";
	Записи = Запрос.Выполнить().Выгрузить();

	Записи.Колонки.Добавить("Группа", Новый ОписаниеТипов("Строка"));
	Записи.Колонки.Добавить("Приоритет", Новый ОписаниеТипов("Число"));
	Записи.Колонки.Добавить("БезНоменклатуры", Новый ОписаниеТипов("Число"));
	Для Каждого Запись Из Записи Цикл
		Канон = ЭАрМ_СверкаТоваровЦепочки.КаноническийШтрихкод(Запись.Штрихкод);
		Если ЗначениеЗаполнено(Канон)
			И НЕ ЭАрМ_СверкаТоваровЦепочки.ЭтоКлючБезШтрихкода(Запись.Штрихкод) Тогда
			Запись.Группа = Канон + "|" + Запись.КлючНаименования;
		КонецЕсли;
		Запись.Приоритет = ПриоритетИсточника(Запись.Источник);
		Запись.БезНоменклатуры = ?(ЗначениеЗаполнено(Запись.ИдентификаторНоменклатурыДалион), 0, 1);
	КонецЦикла;
	Записи.Сортировать("Группа, Приоритет, БезНоменклатуры, ДатаОбновления Убыв");

	// Группа -> Массив записей, первая - остаётся
	Группы = Новый Массив;
	Текущая = Неопределено;
	ТекущийКлюч = Неопределено;
	Для Каждого Запись Из Записи Цикл
		Если НЕ ЗначениеЗаполнено(Запись.Группа) Тогда
			Продолжить;
		КонецЕсли;
		Если Запись.Группа <> ТекущийКлюч Тогда
			ТекущийКлюч = Запись.Группа;
			Текущая = Новый Массив;
			Группы.Добавить(Текущая);
		КонецЕсли;
		Текущая.Добавить(Запись);
	КонецЦикла;

	Для Каждого Группа Из Группы Цикл
		Если Группа.Количество() > 1 Тогда
			Результат.Групп  = Результат.Групп + 1;
			Результат.Удалить = Результат.Удалить + Группа.Количество() - 1;
		КонецЕсли;
	КонецЦикла;

	Если ТолькоПосчитать ИЛИ Результат.Удалить = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Поля = СтрРазделить("ИННПоставщика,Поставщик,КодТовараПоставщика,НоменклатураДалион,"
		+ "КодНоменклатурыДалион,ИдентификаторНоменклатурыДалион", ",");

	Удалено = 0;
	Ошибок = 0;
	Примеры = Новый Массив;

	Для Каждого Группа Из Группы Цикл

		Если Группа.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;

		НачатьТранзакцию();
		Попытка

			Оставить = РегистрыСведений.ЭАрМ_ШтрихкодыПоставщиков.СоздатьМенеджерЗаписи();
			Оставить.Штрихкод         = Группа[0].Штрихкод;
			Оставить.КлючНаименования = Группа[0].КлючНаименования;
			Оставить.Прочитать();

			Для Индекс = 1 По Группа.ВГраница() Цикл

				Лишняя = РегистрыСведений.ЭАрМ_ШтрихкодыПоставщиков.СоздатьМенеджерЗаписи();
				Лишняя.Штрихкод         = Группа[Индекс].Штрихкод;
				Лишняя.КлючНаименования = Группа[Индекс].КлючНаименования;
				Лишняя.Прочитать();
				Если НЕ Лишняя.Выбран() Тогда
					Продолжить;
				КонецЕсли;

				Для Каждого Поле Из Поля Цикл
					Если НЕ ЗначениеЗаполнено(Оставить[Поле]) И ЗначениеЗаполнено(Лишняя[Поле]) Тогда
						Оставить[Поле] = Лишняя[Поле];
					КонецЕсли;
				КонецЦикла;

				Если Примеры.Количество() < 20 Тогда
					Примеры.Добавить(СтрШаблон("%1 -> %2 (%3)",
						СокрЛП(Лишняя.Штрихкод), СокрЛП(Оставить.Штрихкод), СокрЛП(Лишняя.НаименованиеПоставщика)));
				КонецЕсли;

				Лишняя.Удалить();
				Удалено = Удалено + 1;

			КонецЦикла;

			Если Оставить.Выбран() Тогда
				Оставить.Записать(Истина);
			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			Ошибок = Ошибок + 1;
			ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ДублиШК", Ложь,
				ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Результат.Удалить = Удалено;
	Результат.Текст = СтрШаблон(НСтр("ru = 'Удалено дублей штрихкодов: %1 (групп: %2), ошибок: %3.'"),
		Удалено, Результат.Групп, Ошибок);

	ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ДублиШК", Ошибок = 0,
		Результат.Текст + ?(Примеры.Количество() > 0,
			" " + НСтр("ru = 'Удалённое -> оставленное:'") + " " + СтрСоединить(Примеры, "; "), ""));

	Возврат Результат;

КонецФункции

// Надёжность записи регистра штрихкодов по источнику, меньше - надёжнее
// (см. ЭАрМ_СверкаТоваровЦепочки.ПриоритетИсточникаШтрихкода).
//
&НаСервереБезКонтекста
Функция ПриоритетИсточника(Источник)

	Возврат ЭАрМ_СверкаТоваровЦепочки.ПриоритетИсточникаШтрихкода(Источник);

КонецФункции

#КонецОбласти

#Область Варианты

// Варианты перечитываются чуть позже активизации: при прокрутке списка
// стрелками сервер не дёргается на каждую строку.
//
&НаКлиенте
Процедура НоменклатураПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ОбновитьВариантыТекущейСтроки", 0.3, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВариантыТекущейСтроки()

	ТекущиеДанные = Элементы.Номенклатура.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		СтрокаВариантов = Неопределено;
		Варианты.Очистить();
		ИтогиВариантов = "";
		Возврат;
	КонецЕсли;

	Идентификатор = ТекущиеДанные.ПолучитьИдентификатор();
	Если Идентификатор = СтрокаВариантов Тогда
		Возврат;
	КонецЕсли;

	СтрокаВариантов = Идентификатор;
	ЗаполнитьВариантыНаСервере(Идентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ВариантыСвязатьПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Варианты.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Связать
		И ТекущиеДанные.Вид <> ВидВариантаУПД() Тогда
		ТекущиеДанные.Связать = Ложь;
		ПоказатьПредупреждение(, НСтр("ru = 'Связывается товар из УПД. Запись регистра уже связана - если она неверная, отметьте «Удалить».'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВариантыУдалитьПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Варианты.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Удалить
		И ТекущиеДанные.Вид <> ВидВариантаРегистр() Тогда
		ТекущиеДанные.Удалить = Ложь;
		ПоказатьПредупреждение(, НСтр("ru = 'Удаляется только запись регистра штрихкодов. Товар из УПД в регистре ещё не записан - удалять нечего.'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьПодозрительные(Команда)

	Отмечено = 0;
	Для Каждого Вариант Из Варианты Цикл
		Вариант.Удалить = Вариант.Вид = ВидВариантаРегистр() И Вариант.Подозрение;
		Отмечено = Отмечено + ?(Вариант.Удалить, 1, 0);
	КонецЦикла;

	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Подозрительных записей у этой номенклатуры нет'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СвязатьВарианты(Команда)

	Отмечено = 0;
	Для Каждого Вариант Из Варианты Цикл
		Отмечено = Отмечено + ?(Вариант.Связать, 1, 0);
	КонецЦикла;

	Если Отмечено = 0 ИЛИ СтрокаВариантов = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте «Связать» у товаров из УПД'"));
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("СвязатьВариантыЗавершение", ЭтотОбъект),
		СтрШаблон(НСтр("ru = 'Связать отмеченные товары из УПД (%1) с номенклатурой Далиона текущей строки?
			|Запишется ручная пара, цепочки этих УПД пересверятся.'"), Отмечено),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СвязатьВариантыЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		СвязатьВариантыНаСервере(СтрокаВариантов);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьВарианты(Команда)

	Отмечено = 0;
	Для Каждого Вариант Из Варианты Цикл
		Отмечено = Отмечено + ?(Вариант.Удалить, 1, 0);
	КонецЦикла;

	Если Отмечено = 0 ИЛИ СтрокаВариантов = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте «Удалить» у неверных записей регистра'"));
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("УдалитьВариантыЗавершение", ЭтотОбъект),
		СтрШаблон(НСтр("ru = 'Удалить из регистра штрихкодов поставщиков отмеченные записи (%1)?
			|Отменить нельзя. Сверка перестанет находить пары по этим штрихкодам и названиям.'"), Отмечено),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьВариантыЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		УдалитьВариантыНаСервере(СтрокаВариантов);
	КонецЕсли;

КонецПроцедуры

// Заполняет варианты строки номенклатуры.
//
// Параметры:
//   ИдентификаторСтроки - Число - строка таблицы Номенклатура
//   Результаты          - Соответствие - "Вид|Штрихкод|КлючНаименования" -> итог
//                         прошлого действия, чтобы он не пропал при перечитывании
//
&НаСервере
Процедура ЗаполнитьВариантыНаСервере(ИдентификаторСтроки, Результаты = Неопределено)

	Варианты.Очистить();
	ИтогиВариантов = "";

	Строка = Номенклатура.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИмяДалиона = СокрЛП(Строка.НоменклатураДалион);
	Уид = СокрЛП(Строка.ИдентификаторДалион);
	Код = СокрЛП(Строка.КодДалион);

	ШтрихкодыДалиона = Новый Массив;
	Для Каждого Штрихкод Из СтрРазделить(Строка.ШтрихкодыДалиона, ";", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Штрихкод)) Тогда
			ШтрихкодыДалиона.Добавить(СокрЛП(Штрихкод));
		КонецЕсли;
	КонецЦикла;

	// Все написания штрихкодов Далиона (EAN-13, GTIN-14 с нулём, UPC-A) - для отбора
	ВариантыШК = Новый Массив;
	Для Каждого Штрихкод Из ШтрихкодыДалиона Цикл
		Для Каждого КлючЗначение Из ЭАрМ_СверкаТоваровЦепочки.КлючиШтрихкода(Штрихкод) Цикл
			Если ВариантыШК.Найти(КлючЗначение.Ключ) = Неопределено Тогда
				ВариантыШК.Добавить(Лев(КлючЗначение.Ключ, 200));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Показанные = Новый Соответствие;
	ДобавитьВариантыРегистра(ИмяДалиона, Уид, Код, ШтрихкодыДалиона, ВариантыШК, Показанные);
	ДобавитьВариантыУПД(ИмяДалиона, ШтрихкодыДалиона, ВариантыШК, Показанные);

	Если Результаты <> Неопределено Тогда
		Для Каждого Вариант Из Варианты Цикл
			Вариант.Результат = СокрЛП(Результаты.Получить(КлючВарианта(Вариант)));
		КонецЦикла;
	КонецЕсли;

	ВРегистре = 0;
	Подозрительных = 0;
	ИзУПД = 0;
	Для Каждого Вариант Из Варианты Цикл
		Если Вариант.Вид = ВидВариантаРегистр() Тогда
			ВРегистре = ВРегистре + 1;
			Подозрительных = Подозрительных + ?(Вариант.Подозрение, 1, 0);
		Иначе
			ИзУПД = ИзУПД + 1;
		КонецЕсли;
	КонецЦикла;

	ИтогиВариантов = СтрШаблон(
		НСтр("ru = '«%1»: записей в регистре %2 (подозрительных %3), товаров из УПД без пары %4. Зелёный штрихкод - есть у Далиона, розовая строка - похоже, неверная пара.'"),
		ИмяДалиона, ВРегистре, Подозрительных, ИзУПД);

КонецПроцедуры

// Записи регистра этой номенклатуры (по uid, без него - по коду Далиона) и
// записи с её штрихкодами под любой номенклатурой: штрихкод, записанный за
// другим товаром Далиона, и есть неверная пара.
//
&НаСервере
Процедура ДобавитьВариантыРегистра(ИмяДалиона, Уид, Код, ШтрихкодыДалиона, ВариантыШК, Показанные)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.КлючНаименования КАК КлючНаименования,
	|	Штрихкоды.НаименованиеПоставщика КАК НаименованиеПоставщика,
	|	Штрихкоды.КодТовараПоставщика КАК КодТовараПоставщика,
	|	Штрихкоды.Поставщик КАК Поставщик,
	|	Штрихкоды.ИННПоставщика КАК ИННПоставщика,
	|	Штрихкоды.НоменклатураДалион КАК НоменклатураДалион,
	|	Штрихкоды.КодНоменклатурыДалион КАК КодНоменклатурыДалион,
	|	Штрихкоды.ИдентификаторНоменклатурыДалион КАК ИдентификаторНоменклатурыДалион,
	|	Штрихкоды.Источник КАК Источник,
	|	Штрихкоды.ДатаОбновления КАК ДатаОбновления
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК Штрихкоды
	|ГДЕ
	|	(&ЕстьУид И Штрихкоды.ИдентификаторНоменклатурыДалион = &Уид
	|		ИЛИ НЕ &ЕстьУид И &ЕстьКод И Штрихкоды.КодНоменклатурыДалион = &Код
	|		ИЛИ Штрихкоды.Штрихкод В (&ВариантыШК))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Штрихкоды.Штрихкод,
	|	Штрихкоды.НаименованиеПоставщика";
	Запрос.УстановитьПараметр("ЕстьУид", ЗначениеЗаполнено(Уид));
	Запрос.УстановитьПараметр("Уид", Уид);
	Запрос.УстановитьПараметр("ЕстьКод", ЗначениеЗаполнено(Код));
	Запрос.УстановитьПараметр("Код", Код);
	Запрос.УстановитьПараметр("ВариантыШК", ВариантыШК);

	КлючИмениДалиона = ЭАрМ_СверкаТоваровЦепочки.КлючНаименования(ИмяДалиона);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Вариант = Варианты.Добавить();
		Вариант.Вид                    = ВидВариантаРегистр();
		Вариант.Штрихкод               = СокрЛП(Выборка.Штрихкод);
		Вариант.ШтрихкодКанон          = ЭАрМ_СверкаТоваровЦепочки.КаноническийШтрихкод(Вариант.Штрихкод);
		Вариант.КлючНаименования       = СокрЛП(Выборка.КлючНаименования);
		Вариант.НаименованиеПоставщика = СокрЛП(Выборка.НаименованиеПоставщика);
		Вариант.КодПоставщика          = СокрЛП(Выборка.КодТовараПоставщика);
		Вариант.Поставщик              = СокрЛП(Выборка.Поставщик);
		Вариант.ИННПоставщика          = СокрЛП(Выборка.ИННПоставщика);
		Вариант.НоменклатураЗаписи     = СокрЛП(Выборка.НоменклатураДалион);
		Вариант.Источник               = СокрЛП(Выборка.Источник);
		Вариант.ДатаОбновления         = Выборка.ДатаОбновления;
		Вариант.ШКЕстьУДалиона         = ШтрихкодЕстьСреди(Вариант.Штрихкод, ШтрихкодыДалиона);
		Вариант.ПохожестьИмени         = Окр(ЭАрМ_СверкаТоваровЦепочки.ОценкаПохожестиНаименований(
			Вариант.НаименованиеПоставщика, ИмяДалиона), 2);

		// Штрихкод этой номенклатуры записан за другим товаром Далиона
		Если ЗначениеЗаполнено(Уид) Тогда
			Вариант.ЧужаяНоменклатура = ЗначениеЗаполнено(Выборка.ИдентификаторНоменклатурыДалион)
				И СокрЛП(Выборка.ИдентификаторНоменклатурыДалион) <> Уид;
		Иначе
			Вариант.ЧужаяНоменклатура = ЗначениеЗаполнено(Выборка.КодНоменклатурыДалион)
				И СокрЛП(Выборка.КодНоменклатурыДалион) <> Код;
		КонецЕсли;

		// Своя запись с чужим штрихкодом и непохожим названием - скорее всего,
		// пара сложилась крест-накрест. Запись под собственным именем Далиона
		// не подозрительна: это карточка Далиона как она есть
		Вариант.Подозрение = Вариант.ЧужаяНоменклатура
			ИЛИ НЕ Вариант.ШКЕстьУДалиона
				И Вариант.ПохожестьИмени < 0.5
				И Вариант.КлючНаименования <> КлючИмениДалиона;

		Показанные.Вставить(Вариант.КлючНаименования, Истина);

	КонецЦикла;

КонецПроцедуры

// Товары из УПД, которые ещё не записаны к этой номенклатуре: с её штрихкодом
// в GTIN строки УПД (любой поставщик) и - если выбран поставщик - с похожим
// названием из его УПД.
//
&НаСервере
Процедура ДобавитьВариантыУПД(ИмяДалиона, ШтрихкодыДалиона, ВариантыШК, Показанные)

	Если ВариантыШК.Количество() > 0 Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.Наименование КАК Наименование,
		|	Товары.КодТовараПоставщика КАК КодТовараПоставщика,
		|	Товары.Штрихкод КАК Штрихкод,
		|	Товары.ИдентификаторСБИС КАК ИдентификаторУПД,
		|	УПД.Контрагент КАК Поставщик,
		|	УПД.ИННКонтрагента КАК ИНН,
		|	УПД.Дата КАК Дата
		|ИЗ
		|	РегистрСведений.ЭАрМ_ТоварыЭТрН КАК Товары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭАрМ_УПД_Входящий КАК УПД
		|		ПО Товары.ИдентификаторСБИС = УПД.ИдентификаторСБИС
		|ГДЕ
		|	Товары.ИсточникТоваров = ""УПД""
		|	И Товары.СпособПоискаШК = ""GTIN""
		|	И Товары.Штрихкод В (&ВариантыШК)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
		Запрос.УстановитьПараметр("ВариантыШК", ВариантыШК);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДобавитьВариантУПД(ИмяДалиона, ШтрихкодыДалиона, Выборка.Наименование, Выборка.КодТовараПоставщика,
				Выборка.Штрихкод, Выборка.ИдентификаторУПД, Выборка.Поставщик, Выборка.ИНН, Показанные);
		КонецЦикла;

	КонецЕсли;

	// Похожие названия из УПД выбранного поставщика - лучшие по оценке
	Похожие = Новый ТаблицаЗначений;
	Похожие.Колонки.Добавить("Индекс", Новый ОписаниеТипов("Число"));
	Похожие.Колонки.Добавить("Оценка", Новый ОписаниеТипов("Число"));
	Для Индекс = 0 По ТоварыПоставщика.Количество() - 1 Цикл
		Оценка = ЭАрМ_СверкаТоваровЦепочки.ОценкаПохожестиНаименований(
			ТоварыПоставщика[Индекс].Наименование, ИмяДалиона);
		Если Оценка >= 0.5 Тогда
			Похожий = Похожие.Добавить();
			Похожий.Индекс = Индекс;
			Похожий.Оценка = Оценка;
		КонецЕсли;
	КонецЦикла;
	Похожие.Сортировать("Оценка Убыв");

	Добавлено = 0;
	Для Каждого Похожий Из Похожие Цикл
		Если Добавлено >= 15 Тогда
			Прервать;
		КонецЕсли;
		Товар = ТоварыПоставщика[Похожий.Индекс];
		Если ДобавитьВариантУПД(ИмяДалиона, ШтрихкодыДалиона, Товар.Наименование, Товар.КодТовараПоставщика,
			Товар.Штрихкод, Товар.ИдентификаторУПД, Товар.Поставщик, Товар.ИНН, Показанные) Тогда
			Добавлено = Добавлено + 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращаемое значение:
//   Булево - строка добавлена (название ещё не показано)
//
&НаСервере
Функция ДобавитьВариантУПД(ИмяДалиона, ШтрихкодыДалиона, Наименование, КодТовара, Штрихкод, ИдентификаторУПД,
	Поставщик, ИНН, Показанные)

	Ключ = ЭАрМ_СверкаТоваровЦепочки.КлючНаименования(Наименование);
	Если НЕ ЗначениеЗаполнено(Ключ) ИЛИ Показанные.Получить(Ключ) <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Показанные.Вставить(Ключ, Истина);

	Вариант = Варианты.Добавить();
	Вариант.Вид                    = ВидВариантаУПД();
	Вариант.Штрихкод               = СокрЛП(Штрихкод);
	Вариант.ШтрихкодКанон          = ЭАрМ_СверкаТоваровЦепочки.КаноническийШтрихкод(Вариант.Штрихкод);
	Вариант.КлючНаименования       = Ключ;
	Вариант.НаименованиеПоставщика = СокрЛП(Наименование);
	Вариант.КодПоставщика          = СокрЛП(КодТовара);
	Вариант.Поставщик              = СокрЛП(Поставщик);
	Вариант.ИННПоставщика          = СокрЛП(ИНН);
	Вариант.ИдентификаторУПД       = СокрЛП(ИдентификаторУПД);
	Вариант.ШКЕстьУДалиона         = ШтрихкодЕстьСреди(Вариант.Штрихкод, ШтрихкодыДалиона);
	Вариант.ПохожестьИмени         = Окр(ЭАрМ_СверкаТоваровЦепочки.ОценкаПохожестиНаименований(
		Вариант.НаименованиеПоставщика, ИмяДалиона), 2);
	Вариант.Источник               = НСтр("ru = 'УПД, не связан'");

	Возврат Истина;

КонецФункции

&НаСервере
Процедура СвязатьВариантыНаСервере(ИдентификаторСтроки)

	Строка = Номенклатура.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ключи = Новый Массив;
	Если ЗначениеЗаполнено(Строка.ИдентификаторДалион) Тогда
		Ключи.Добавить("uid:" + СокрЛП(Строка.ИдентификаторДалион));
	КонецЕсли;
	Если ЗначениеЗаполнено(Строка.КодДалион) Тогда
		Ключи.Добавить("код:" + СокрЛП(Строка.КодДалион));
	КонецЕсли;
	СтрокаПрихода = Новый Структура("Наименование, Штрихкоды, КлючиНоменклатуры",
		Строка.НоменклатураДалион, СтрЗаменить(Строка.ШтрихкодыДалиона, " ", ""), СтрСоединить(Ключи, ";"));

	Результаты = Новый Соответствие;
	Связано = 0;
	Ошибок = 0;

	Для Каждого Вариант Из Варианты Цикл

		Если НЕ Вариант.Связать Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Вариант.ИдентификаторУПД) Тогда
			Результаты.Вставить(КлючВарианта(Вариант), НСтр("ru = 'Нет УПД с этим товаром - связать не по чему'"));
			Ошибок = Ошибок + 1;
			Продолжить;
		КонецЕсли;

		СтрокаУПД = Новый Структура("Наименование, КодТовараПоставщика, Штрихкоды",
			Вариант.НаименованиеПоставщика, Вариант.КодПоставщика, Вариант.Штрихкод);

		Попытка
			Итог = ЭАрМ_СверкаТоваровЦепочки.СвязатьСтрокуУПДСПриходом(Вариант.ИдентификаторУПД,
				СтрокаУПД, СтрокаПрихода, Вариант.ИННПоставщика, Вариант.Поставщик,
				ПерезаписатьПринудительно);
			Результаты.Вставить(КлючВарианта(Вариант), Итог.Текст);
			Если Итог.Успех Тогда
				Связано = Связано + 1;
			Иначе
				Ошибок = Ошибок + 1;
			КонецЕсли;
		Исключение
			Результаты.Вставить(КлючВарианта(Вариант), ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
			Ошибок = Ошибок + 1;
		КонецПопытки;

	КонецЦикла;

	// Связанный товар теперь запись регистра - её итог ищем под этим видом
	Для Каждого КлючЗначение Из Новый ФиксированноеСоответствие(Результаты) Цикл
		Результаты.Вставить(СтрЗаменить(КлючЗначение.Ключ, ВидВариантаУПД() + "|", ВидВариантаРегистр() + "|"),
			КлючЗначение.Значение);
	КонецЦикла;

	ЗаполнитьВариантыНаСервере(ИдентификаторСтроки, Результаты);
	ИтогиВариантов = СтрШаблон(НСтр("ru = 'Связано: %1, не удалось: %2. %3'"), Связано, Ошибок, ИтогиВариантов);

КонецПроцедуры

&НаСервере
Процедура УдалитьВариантыНаСервере(ИдентификаторСтроки)

	Удалено = 0;
	Ошибок = 0;
	Примеры = Новый Массив;
	Результаты = Новый Соответствие;

	Для Каждого Вариант Из Варианты Цикл

		Если НЕ Вариант.Удалить ИЛИ Вариант.Вид <> ВидВариантаРегистр() Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			МенеджерЗаписи = РегистрыСведений.ЭАрМ_ШтрихкодыПоставщиков.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Штрихкод         = Вариант.Штрихкод;
			МенеджерЗаписи.КлючНаименования = Вариант.КлючНаименования;
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.Удалить();
				Удалено = Удалено + 1;
				Если Примеры.Количество() < 20 Тогда
					Примеры.Добавить(СтрШаблон("%1 «%2» (%3)", Вариант.Штрихкод,
						Вариант.НаименованиеПоставщика, Вариант.НоменклатураЗаписи));
				КонецЕсли;
			КонецЕсли;
		Исключение
			Ошибок = Ошибок + 1;
			Результаты.Вставить(КлючВарианта(Вариант), ЭАрМ_Служебный.ТекстИсключения(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Если Удалено > 0 ИЛИ Ошибок > 0 Тогда
		ЭАрМ_РегламентныйОбменЭДО.ЗаписатьВЖурнал("", "ШтрихкодыПоставщиков", Ошибок = 0,
			СтрШаблон(НСтр("ru = 'Пересверка номенклатуры: удалено записей %1, ошибок %2. %3'"),
				Удалено, Ошибок, СтрСоединить(Примеры, "; ")));
	КонецЕсли;

	ЗаполнитьВариантыНаСервере(ИдентификаторСтроки, Результаты);
	ИтогиВариантов = СтрШаблон(НСтр("ru = 'Удалено записей: %1, ошибок: %2. %3'"), Удалено, Ошибок, ИтогиВариантов);

КонецПроцедуры

// Штрихкод совпадает с одним из списка в любом написании.
//
&НаСервереБезКонтекста
Функция ШтрихкодЕстьСреди(Штрихкод, Штрихкоды)

	Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Другой Из Штрихкоды Цикл
		Если ЭАрМ_СверкаТоваровЦепочки.ШтрихкодыСовпадают(Штрихкод, Другой) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КлючВарианта(Вариант)

	Возврат Вариант.Вид + "|" + Вариант.Штрихкод + "|" + Вариант.КлючНаименования;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидВариантаРегистр()

	Возврат НСтр("ru = 'В регистре'");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидВариантаУПД()

	Возврат НСтр("ru = 'В УПД'");

КонецФункции

#КонецОбласти

#Область Оформление

&НаСервере
Процедура НастроитьОформление()

	// Конфликт - розовая строка
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Строки.Имя);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Строки.Конфликт");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 228, 228));

	// Предлагаемая пара - жирным, чтобы глаз шёл к ней
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СтрокиПредлагаемаяПара.Имя);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Строки.Конфликт");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина));

	// Вторая страница: ШК из УПД есть, а у номенклатуры Далиона такого нет -
	// пара, скорее всего, не та
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НоменклатураШтрихкодУПД.Имя);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Номенклатура.ШКСовпадает");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Ложь;
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Номенклатура.ШтрихкодУПД");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Заполнено;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 228, 228));

	// Варианты: подозрительная запись регистра - розовая строка
	ДобавитьОформлениеВарианта(Элементы.Варианты.Имя, "Варианты.Подозрение",
		"ЦветФона", Новый Цвет(255, 228, 228));

	// Штрихкод есть у номенклатуры Далиона - зелёный
	ДобавитьОформлениеВарианта(Элементы.ВариантыШтрихкод.Имя, "Варианты.ШКЕстьУДалиона",
		"ЦветФона", Новый Цвет(220, 255, 220));
	ДобавитьОформлениеВарианта(Элементы.ВариантыШтрихкодКанон.Имя, "Варианты.ШКЕстьУДалиона",
		"ЦветФона", Новый Цвет(220, 255, 220));

	// Запись с этим штрихкодом числится за другим товаром Далиона - красным
	ДобавитьОформлениеВарианта(Элементы.ВариантыНоменклатураЗаписи.Имя, "Варианты.ЧужаяНоменклатура",
		"ЦветТекста", Новый Цвет(180, 0, 0));

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеВарианта(ИмяПоля, ПутьКПризнаку, ИмяПараметра, Значение)

	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ПутьКПризнаку);
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра(ИмяПараметра, Значение);

КонецПроцедуры

#КонецОбласти
