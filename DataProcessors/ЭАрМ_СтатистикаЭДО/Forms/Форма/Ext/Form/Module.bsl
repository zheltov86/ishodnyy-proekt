////////////////////////////////////////////////////////////////////////////////
// Форма обработки ЭАрМ_СтатистикаЭДО.
//
// Три взгляда на документы ЭДО за период:
//   «Статистика»                 - сколько документов, строк и денег в каждом
//                                  состоянии подписи и что с ними делать;
//   «Итоги товаров ЭТрН»         - те же ЭТрН, но с товарами, деревом;
//   «Заказы, приходы, УПД и ЭТрН» - цепочка закупки одной строкой.
//
// Данные считает ЭАрМ_СтатистикаЭДО: форма только показывает и оформляет.
// Даты везде с временем - по ним видно, когда с документом в последний раз
// что-то происходило.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаНачала    = НачалоМесяца(ТекущаяДатаСеанса());
	ДатаОкончания = КонецДня(ТекущаяДатаСеанса());

	НастроитьКолонки();
	НастроитьЦвета();

	ПосчитатьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Показать(Команда)

	Состояние(НСтр("ru = 'Считаем итоги...'"));
	ПосчитатьНаСервере();
	Состояние();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПосчитатьНаСервере()

	Начало = ТекущаяДатаСеанса();

	Статистика.Загрузить(ЭАрМ_СтатистикаЭДО.ТаблицаСтатистики(ДатаНачала, ДатаОкончания));
	ЗначениеВРеквизитФормы(
		ЭАрМ_СтатистикаЭДО.ДеревоИтоговЭТрН(ДатаНачала, ДатаОкончания), "ИтогиЭТрН");
	Цепочка.Загрузить(ЭАрМ_СтатистикаЭДО.ТаблицаЦепочки(ДатаНачала, ДатаОкончания));

	Посчитано = СтрШаблон(
		НСтр("ru = 'Период %1 - %2. Посчитано %3, срезов %4, строк цепочки %5.'"),
		Формат(ДатаНачала, "ДЛФ=D"), Формат(ДатаОкончания, "ДЛФ=D"),
		Формат(Начало, "ДЛФ=DT"), Статистика.Количество(), Цепочка.Количество());

КонецПроцедуры

// Даты с временем, числа с разделителями, подписи по-человечески.
//
&НаСервере
Процедура НастроитьКолонки()

	ФорматДатыСВременем = "ДЛФ=DT";
	ФорматЧисла         = "ЧЦ=15; ЧДЦ=2; ЧРГ=' '";
	ФорматКоличества    = "ЧЦ=15; ЧДЦ=3; ЧРГ=' '";
	ФорматЦелого        = "ЧЦ=10; ЧДЦ=0; ЧРГ=' '";

	УстановитьФормат("СтатистикаДокументов",       ФорматЦелого,     8);
	УстановитьФормат("СтатистикаСтрок",            ФорматЦелого,     8);
	УстановитьФормат("СтатистикаКоличество",       ФорматКоличества, 14);
	УстановитьФормат("СтатистикаСумма",            ФорматЧисла,      16);
	УстановитьФормат("СтатистикаСуммаНДС",         ФорматЧисла,      14);
	УстановитьФормат("СтатистикаПоследнееСобытие", ФорматДатыСВременем, 16);
	УстановитьФормат("СтатистикаРаздел",           "",  8);
	УстановитьФормат("СтатистикаПоказатель",       "", 26);
	УстановитьФормат("СтатистикаЧтоДелать",        "",  0);

	УстановитьФормат("ИтогиЭТрНПредставление",    "", 52);
	УстановитьФормат("ИтогиЭТрНСостояние",        "", 26);
	УстановитьФормат("ИтогиЭТрНДокументов",       ФорматЦелого,     8);
	УстановитьФормат("ИтогиЭТрНСтрок",            ФорматЦелого,     8);
	УстановитьФормат("ИтогиЭТрНКоличество",       ФорматКоличества, 14);
	УстановитьФормат("ИтогиЭТрНСумма",            ФорматЧисла,      16);
	УстановитьФормат("ИтогиЭТрНСуммаНДС",         ФорматЧисла,      14);
	УстановитьФормат("ИтогиЭТрНПоследнееСобытие", ФорматДатыСВременем, 16);

	УстановитьФормат("ЦепочкаДатаЗаказа",       ФорматДатыСВременем, 16);
	УстановитьФормат("ЦепочкаДатаПоставкиПлан", ФорматДатыСВременем, 16);
	УстановитьФормат("ЦепочкаДатаПоступления",  ФорматДатыСВременем, 16);
	УстановитьФормат("ЦепочкаДатаУПД",          ФорматДатыСВременем, 16);
	УстановитьФормат("ЦепочкаДатаСверки",       ФорматДатыСВременем, 16);
	УстановитьФормат("ЦепочкаДатаОбновления",   ФорматДатыСВременем, 16);
	УстановитьФормат("ЦепочкаСуммаЗаказа",      ФорматЧисла, 14);
	УстановитьФормат("ЦепочкаСуммаПоступления", ФорматЧисла, 14);
	УстановитьФормат("ЦепочкаСостояниеУПД",     "", 24);
	УстановитьФормат("ЦепочкаСостояниеЭТрН",    "", 24);

КонецПроцедуры

// Формат и ширина одной колонки. Нулевая ширина означает «не задавать» -
// такую колонку тянет разметка.
//
&НаСервере
Процедура УстановитьФормат(ИмяКолонки, Формат, Ширина)

	Колонка = Элементы.Найти(ИмяКолонки);
	Если Колонка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Формат) Тогда
		Колонка.Формат = Формат;
	КонецЕсли;

	Если Ширина > 0 Тогда
		Колонка.Ширина = Ширина;
	КонецЕсли;

КонецПроцедуры

// Тот же светофор, что и в реестрах: зелёное подписано, жёлтое ждёт подписи,
// красное требует работы.
//
&НаСервере
Процедура НастроитьЦвета()

	ЗеленыйФон  = Новый Цвет(220, 255, 220);
	ЗеленыйТекст = Новый Цвет(0, 100, 0);
	ЖелтыйФон   = Новый Цвет(255, 245, 200);
	ЖелтыйТекст = Новый Цвет(120, 80, 0);
	КрасныйФон  = Новый Цвет(255, 224, 224);
	КрасныйТекст = Новый Цвет(140, 0, 0);

	ДобавитьЦвет("Статистика", "Статистика.Показатель",
		ЭАрМ_СтатистикаЭДО.СостояниеПодписан(), ЗеленыйФон, ЗеленыйТекст);
	ДобавитьЦвет("Статистика", "Статистика.Показатель",
		ЭАрМ_СтатистикаЭДО.СостояниеОтправлен(), ЖелтыйФон, ЖелтыйТекст);
	ДобавитьЦвет("Статистика", "Статистика.Показатель",
		ЭАрМ_СтатистикаЭДО.СостояниеНадоОбработать(), КрасныйФон, КрасныйТекст);

	ДобавитьЦвет("ИтогиЭТрН", "ИтогиЭТрН.Состояние",
		ЭАрМ_СтатистикаЭДО.СостояниеПодписан(), ЗеленыйФон, ЗеленыйТекст);
	ДобавитьЦвет("ИтогиЭТрН", "ИтогиЭТрН.Состояние",
		ЭАрМ_СтатистикаЭДО.СостояниеОтправлен(), ЖелтыйФон, ЖелтыйТекст);
	ДобавитьЦвет("ИтогиЭТрН", "ИтогиЭТрН.Состояние",
		ЭАрМ_СтатистикаЭДО.СостояниеНадоОбработать(), КрасныйФон, КрасныйТекст);

	ДобавитьЦвет("Цепочка", "Цепочка.СостояниеЭТрН",
		ЭАрМ_СтатистикаЭДО.СостояниеПодписан(), ЗеленыйФон, ЗеленыйТекст);
	ДобавитьЦвет("Цепочка", "Цепочка.СостояниеЭТрН",
		ЭАрМ_СтатистикаЭДО.СостояниеОтправлен(), ЖелтыйФон, ЖелтыйТекст);
	ДобавитьЦвет("Цепочка", "Цепочка.СостояниеЭТрН",
		ЭАрМ_СтатистикаЭДО.СостояниеНадоОбработать(), КрасныйФон, КрасныйТекст);

КонецПроцедуры

&НаСервере
Процедура ДобавитьЦвет(ИмяТаблицы, ИмяПоляОтбора, Значение, ЦветФона, ЦветТекста)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы);
	ОформляемоеПоле.Использование = Истина;

	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяПоляОтбора);
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Значение;
	Отбор.Использование  = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);

КонецПроцедуры

#КонецОбласти
