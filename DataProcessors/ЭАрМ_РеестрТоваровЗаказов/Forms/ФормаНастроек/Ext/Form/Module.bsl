////////////////////////////////////////////////////////////////////////////////
// Настройки монитора «Реестр товаров по заказам».
//
// Здесь всё, что относится к настройке и обслуживанию монитора: группировка и
// период при открытии, автообновление, исправление цен, пересборка реестра и
// загрузка штрихкодов поставщика. Настройки хранятся для каждого пользователя
// (ЭАрМ_РеестрТоваровЗаказов.НастройкиМонитора).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Настройки = ЭАрМ_РеестрТоваровЗаказов.НастройкиМонитора();
	Группировка            = Настройки.Группировка;
	ПериодПоУмолчанию      = Настройки.ПериодПоУмолчанию;
	ТолькоРасхождения      = Настройки.ТолькоРасхождения;
	Автообновление         = Настройки.Автообновление;
	ИнтервалАвтообновления = Настройки.ИнтервалАвтообновления;
	ДатаДокументаИзУПД     = Настройки.ДатаДокументаИзУПД;

	Элементы.Группировка.СписокВыбора.Добавить("Поставщик", НСтр("ru = 'По контрагентам'"));
	Элементы.Группировка.СписокВыбора.Добавить("Склад", НСтр("ru = 'По магазинам'"));
	Элементы.Группировка.СписокВыбора.Добавить("Организация", НСтр("ru = 'По организациям: приходные и товары'"));
	Элементы.ПериодПоУмолчанию.СписокВыбора.Добавить("Месяц", НСтр("ru = 'С начала месяца'"));
	Элементы.ПериодПоУмолчанию.СписокВыбора.Добавить("Неделя", НСтр("ru = 'С начала недели'"));
	Элементы.ПериодПоУмолчанию.СписокВыбора.Добавить("Сегодня", НСтр("ru = 'Сегодня'"));

	ОбслуживаниеДатаНачала    = НачалоМесяца(ТекущаяДатаСеанса());
	ОбслуживаниеДатаОкончания = КонецДня(ТекущаяДатаСеанса());

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	ЗаписатьНастройки();
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	ЗаписатьНастройки();

КонецПроцедуры

// Пересверяет цепочки «заказ - УПД - приход» периода и пересобирает строки реестра.
//
&НаКлиенте
Процедура ОбновитьРеестр(Команда)

	Состояние(НСтр("ru = 'Обновление реестра: пересверка цепочек...'"));
	ОбновитьРеестрНаСервере(ОбслуживаниеДатаНачала, ОбслуживаниеДатаОкончания);
	Состояние();

	Оповестить("ЭАрМ_РеестрТоваровОбновлён");

КонецПроцедуры

&НаКлиенте
Процедура ПересопоставитьПоНазванию(Команда)

	Состояние(НСтр("ru = 'Сопоставление по названию...'"));
	ПересопоставитьПоНазваниюНаСервере(ОбслуживаниеДатаНачала, ОбслуживаниеДатаОкончания);
	Состояние();

	Оповестить("ЭАрМ_РеестрТоваровОбновлён");

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьШтрихкоды(Команда)

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Файл штрихкодов поставщика'");
	ПараметрыДиалога.Фильтр = НСтр("ru = 'Штрихкоды поставщика (*.json;*.txt;*.csv)|*.json;*.txt;*.csv|Все файлы (*.*)|*.*'");

	НачатьПомещениеФайлаНаСервер(
		Новый ОписаниеОповещения("ПослеПомещенияФайлаШтрихкодов", ЭтотОбъект), , ,
		ПараметрыДиалога, УникальныйИдентификатор);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаписатьНастройки()

	ЗаписатьНастройкиНаСервере();
	// Монитор перечитывает настройки и перестраивает дерево
	Оповестить("ЭАрМ_НастройкиРеестраТоваров");

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиНаСервере()

	Настройки = Новый Структура;
	Настройки.Вставить("Группировка", Группировка);
	Настройки.Вставить("ПериодПоУмолчанию", ПериодПоУмолчанию);
	Настройки.Вставить("ТолькоРасхождения", ТолькоРасхождения);
	Настройки.Вставить("Автообновление", Автообновление);
	Настройки.Вставить("ИнтервалАвтообновления", ИнтервалАвтообновления);
	Настройки.Вставить("ДатаДокументаИзУПД", ДатаДокументаИзУПД);
	ЭАрМ_РеестрТоваровЗаказов.СохранитьНастройкиМонитора(Настройки);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайлаШтрихкодов(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт

	Если ОписаниеПомещенногоФайла = Неопределено
		ИЛИ ОписаниеПомещенногоФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	ЗагрузитьШтрихкодыНаСервере(ОписаниеПомещенногоФайла.Адрес,
		ОписаниеПомещенногоФайла.СсылкаНаФайл.Имя, ИННПоставщикаЗагрузки, ПоставщикЗагрузки);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбновитьРеестрНаСервере(ДатаНачала, ДатаОкончания)

	Итоги = ЭАрМ_РеестрТоваровЗаказов.ОбновитьРеестр(ДатаНачала, ДатаОкончания);

	СообщитьПользователю(СтрШаблон(НСтр("ru = 'Реестр обновлён: цепочек %1, строк %2, ошибок %3.'"),
		Итоги.Цепочек, Итоги.Строк, Итоги.Ошибок));
	Для Каждого ТекстСообщения Из Итоги.Сообщения Цикл
		СообщитьПользователю(ТекстСообщения);
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПересопоставитьПоНазваниюНаСервере(ДатаНачала, ДатаОкончания)

	Итоги = ЭАрМ_СверкаТоваровЦепочки.ПересопоставитьПоНазванию(ДатаНачала, ДатаОкончания);

	СообщитьПользователю(СтрШаблон(
		НСтр("ru = 'Сопоставление по названию: цепочек %1, сопоставлено строк %2, осталось без пары %3, ошибок %4.'"),
		Итоги.Цепочек, Итоги.Сопоставлено, Итоги.Осталось, Итоги.Ошибок));
	Для Каждого ТекстСообщения Из Итоги.Сообщения Цикл
		СообщитьПользователю(ТекстСообщения);
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗагрузитьШтрихкодыНаСервере(АдресФайла, ИмяФайла, ИННПоставщика, Поставщик)

	Попытка
		Итоги = ЭАрМ_РеестрТоваровЗаказов.ЗагрузитьШтрихкодыПоставщика(АдресФайла, ИмяФайла,
			ИННПоставщика, Поставщик);
		СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Штрихкоды поставщика «%1»: загружено %2, пропущено %3. Чтобы они попали в сверку, обновите реестр за период.'"),
			Итоги.Поставщик, Итоги.Загружено, Итоги.Пропущено));
	Исключение
		СообщитьПользователю(НСтр("ru = 'Штрихкоды не загружены: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СообщитьПользователю(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
