////////////////////////////////////////////////////////////////////////////////
// Монитор поставок для менеджеров: организация (поставщик, магазин) -> приход -> товары.
//
// Только данные УПД из СБИС и прихода Далиона: каждый товар показан один раз,
// его количество и цена по УПД и по приходу стоят в одной строке. Цену прихода
// можно изменить в любой строке с приходом.
//
// Настройки монитора (группировка, период, автообновление) - в форме «Настройки».
// Автообновление сравнивает метку реестра и перечитывает дерево, только если
// реестр изменился.
////////////////////////////////////////////////////////////////////////////////

// Цена прихода в ячейке до правки: пока комментарий не введён, в строке остаётся она.
&НаКлиенте
Перем СтараяЦенаПН;

// Ключ поставки, реквизиты которой сейчас в шапке над таблицей.
&НаКлиенте
Перем КлючДокументовШапки;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Настройки = ЭАрМ_РеестрТоваровЗаказов.НастройкиМонитора();
	ПрименитьНастройки(Настройки);

	ДатаНачала    = ЭАрМ_РеестрТоваровЗаказов.НачалоПериодаМонитора(Настройки.ПериодПоУмолчанию);
	ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	ТолькоРасхождения = Настройки.ТолькоРасхождения;

	Элементы.ОтборСклад.КнопкаВыпадающегоСписка = Истина;
	Элементы.ОтборОрганизация.КнопкаВыпадающегоСписка = Истина;
	Элементы.ОтборПоставщик.КнопкаВыпадающегоСписка = Истина;
	ОбновитьСпискиОтборовНаСервере();

	ОформитьДерево();
	ЗаполнитьДеревоНаСервере();

КонецПроцедуры

// Сохранённые отборы (контрагент, магазин) восстанавливаются после
// ПриСозданииНаСервере - дерево перестраивается под них.
//
&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	ОбновитьСпискиОтборовНаСервере();
	ЗаполнитьДеревоНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Открывается свёрнутым: организации (контрагенты, магазины) и их приходные
	// без товаров - товары раскрываются по приходной
	СвернутьВсе(Неопределено);
	ПодключитьАвтообновление();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ЭАрМ_НастройкиРеестраТоваров" Тогда
		ПрименитьНастройкиНаСервере();
		ПодключитьАвтообновление();
		ОбновитьПоОтбору();
	ИначеЕсли ИмяСобытия = "ЭАрМ_РеестрТоваровОбновлён" Тогда
		ОбновитьПоОтбору();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьДанные(Команда)

	ОбновитьПоОтбору();

КонецПроцедуры

&НаКлиенте
Процедура Настройки(Команда)

	ОткрытьФорму("Обработка.ЭАрМ_РеестрТоваровЗаказов.Форма.ФормаНастроек", , ЭтаФорма);

КонецПроцедуры

// Приходная, выгруженная позже УПД (старые приходные из архива), может остаться
// без УПД: регламент связывает только часть открытых цепочек за проход.
// Команда ищет УПД по номеру приходной сразу и пересверяет цепочку.
//
&НаКлиенте
Процедура ПривязатьУПД(Команда)

	Идентификатор = ПоступлениеТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите заказ или товар поставки, у которой есть приход'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Поиск УПД к приходной...'"));
	Текст = ПерепривязатьУПДНаСервере(Идентификатор);
	Состояние();

	ПоказатьПредупреждение(, Текст);
	ОбновитьПоОтбору();

КонецПроцедуры

// Объясняет, почему найденная по номеру УПД не привязалась: уже занята другой
// приходной, аннулирована, не совпал ИНН или её ещё нет в реестре УПД.
//
&НаКлиенте
Процедура ПочемуНетУПД(Команда)

	Идентификатор = ПоступлениеТекущейСтроки();
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите заказ или товар поставки, у которой есть приход'"));
		Возврат;
	КонецЕсли;

	ПоказатьПредупреждение(, ДиагностикаУПДНаСервере(Идентификатор), , НСтр("ru = 'Почему нет УПД'"));

КонецПроцедуры

&НаКлиенте
Функция ПоступлениеТекущейСтроки()

	Данные = Элементы.Дерево.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Данные.ИдентификаторПоступления;

КонецФункции

&НаСервереБезКонтекста
Функция ПерепривязатьУПДНаСервере(ИдентификаторПоступления)

	Возврат ЭАрМ_ЦепочкаЗакупки.ПерепривязатьУПДКПоступлению(ИдентификаторПоступления);

КонецФункции

&НаСервереБезКонтекста
Функция ДиагностикаУПДНаСервере(ИдентификаторПоступления)

	Возврат ЭАрМ_ЦепочкаЗакупки.ДиагностикаСвязиУПД(ИдентификаторПоступления);

КонецФункции

&НаКлиенте
Процедура РазвернутьВсе(Команда)

	Для Каждого УзелВерхний Из Дерево.ПолучитьЭлементы() Цикл
		Элементы.Дерево.Развернуть(УзелВерхний.ПолучитьИдентификатор(), Истина);
	КонецЦикла;

КонецПроцедуры

// Контрагенты и заказы без товаров: видно, где что ждёт и где расхождения.
//
&НаКлиенте
Процедура СвернутьВсе(Команда)

	Для Каждого УзелВерхний Из Дерево.ПолучитьЭлементы() Цикл
		Идентификатор = УзелВерхний.ПолучитьИдентификатор();
		Элементы.Дерево.Развернуть(Идентификатор, Ложь);
		Для Каждого УзелЗаказа Из УзелВерхний.ПолучитьЭлементы() Цикл
			Элементы.Дерево.Свернуть(УзелЗаказа.ПолучитьИдентификатор());
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Период, отборы и поиск применяются сразу, отдельной кнопки «Показать» нет.
//
&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ОбновитьПоОтбору();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоОтбору()

	РаскрытиеДерева = СостояниеДерева();
	ЗаполнитьДеревоНаСервере();
	ОбновитьСпискиОтборовНаСервере();
	ВосстановитьСостояниеДерева(РаскрытиеДерева);

	// После перечитывания реквизиты могли измениться (цена, УПД взамен)
	КлючДокументовШапки = Неопределено;
	Подключаемый_ПоказатьДокументы();

КонецПроцедуры

// Шапка над таблицей: УПД и приход поставки, на строке которой стоит курсор
// (на самой поставке или на её товаре), - строка на документ.
//
&НаКлиенте
Процедура ДеревоПриАктивизацииСтроки(Элемент)

	ОтключитьОбработчикОжидания("Подключаемый_ПоказатьДокументы");
	ПодключитьОбработчикОжидания("Подключаемый_ПоказатьДокументы", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПоказатьДокументы()

	Данные = Элементы.Дерево.ТекущиеДанные;
	Ключ = "";
	Если Данные <> Неопределено Тогда
		Ключ = Данные.ИдентификаторЗаказа + "|" + Данные.ИдентификаторПоступления;
	КонецЕсли;
	Если Ключ = КлючДокументовШапки Тогда
		Возврат;
	КонецЕсли;
	КлючДокументовШапки = Ключ;

	Реквизиты = РеквизитыДокументовНаСервере(
		?(Данные = Неопределено, "", Данные.ИдентификаторЗаказа),
		?(Данные = Неопределено, "", Данные.ИдентификаторПоступления));

	ШапкаУПД    = Реквизиты.ШапкаУПД;
	ШапкаПриход = Реквизиты.ШапкаПриход;

КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыДокументовНаСервере(ИдентификаторЗаказа, ИдентификаторПоступления)

	Возврат ЭАрМ_РеестрТоваровЗаказов.РеквизитыДокументовПоставки(ИдентификаторЗаказа, ИдентификаторПоступления);

КонецФункции

#КонецОбласти

#Область ИсправлениеЦены

// Цена прихода правится прямо в строке товара, у которой есть приход.
// До комментария цена в ячейке остаётся прежней.
//
&НаКлиенте
Процедура ДеревоПередНачаломИзменения(Элемент, Отказ)

	Данные = Элемент.ТекущиеДанные;
	Если Данные = Неопределено ИЛИ Элемент.ТекущийЭлемент <> Элементы.ДеревоЦенаПН Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если НЕ СтрокаСПриходом(Данные) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	СтараяЦенаПН = Данные.ЦенаПН;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоЦенаПНПриИзменении(Элемент)

	Данные = Элементы.Дерево.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НоваяЦена = Данные.ЦенаПН;
	// В ячейке остаётся прежняя цена, пока не введён комментарий и сервер не принял правку
	Данные.ЦенаПН = СтараяЦенаПН;

	Если ТипЗнч(НоваяЦена) <> Тип("Число") ИЛИ НоваяЦена <= 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Цена должна быть больше нуля. Цена не изменена.'"));
		Возврат;
	КонецЕсли;

	Если Окр(НоваяЦена, 4) = Окр(СтараяЦенаПН, 4) Тогда
		Возврат;
	КонецЕсли;

	ПараметрыПравки = ПараметрыПравкиЦены(Данные);
	ПараметрыПравки.Вставить("НоваяЦена", НоваяЦена);
	ЗапроситьКомментарийЦены(ПараметрыПравки);

КонецПроцедуры

// Двойной щелчок по строке товара с приходом: новая цена, затем комментарий.
//
&НаКлиенте
Процедура ДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Данные = Элемент.ТекущиеДанные;
	Если Данные = Неопределено ИЛИ НЕ СтрокаСПриходом(Данные) Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ВвестиНовуюЦену(Данные);

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьЦену(Команда)

	Данные = Элементы.Дерево.ТекущиеДанные;
	Если Данные = Неопределено ИЛИ НЕ СтрокаСПриходом(Данные) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку товара, по которой есть приход: цена меняется в приходной.'"));
		Возврат;
	КонецЕсли;

	ВвестиНовуюЦену(Данные);

КонецПроцедуры

&НаКлиенте
Процедура ВвестиНовуюЦену(Данные)

	ПараметрыПравки = ПараметрыПравкиЦены(Данные);
	ПоУмолчанию = ?(ЗначениеЗаполнено(Данные.ЦенаУПД), Данные.ЦенаУПД, Данные.ЦенаПН);
	ПоказатьВводЧисла(Новый ОписаниеОповещения("ИсправитьЦенуЦенаВведена", ЭтотОбъект, ПараметрыПравки), ПоУмолчанию,
		СтрШаблон(НСтр("ru = 'Новая цена в приходной «%1» (сейчас %2, в УПД %3)'"),
			Данные.Представление, Данные.ЦенаПН, Данные.ЦенаУПД), 15, 2);

КонецПроцедуры

// Строка товара, по которой есть строка в приходе: только у неё цену можно исправить.
//
&НаКлиенте
Функция СтрокаСПриходом(Данные)

	Возврат ЗначениеЗаполнено(Данные.СтрокиПН) И ЗначениеЗаполнено(Данные.ИдентификаторПоступления);

КонецФункции

&НаКлиенте
Функция ПараметрыПравкиЦены(Данные)

	Возврат Новый Структура("ИдентификаторЗаказа, ИдентификаторПоступления, СтрокиПН, Представление, СтараяЦена",
		Данные.ИдентификаторЗаказа, Данные.ИдентификаторПоступления, Данные.СтрокиПН, Данные.Представление,
		Данные.ЦенаПН);

КонецФункции

&НаКлиенте
Процедура ИсправитьЦенуЦенаВведена(Цена, ПараметрыПравки) Экспорт

	Если Цена = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Цена <= 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Цена должна быть больше нуля. Цена не изменена.'"));
		Возврат;
	КонецЕсли;

	ПараметрыПравки.Вставить("НоваяЦена", Цена);
	ЗапроситьКомментарийЦены(ПараметрыПравки);

КонецПроцедуры

// Окно комментария к новой цене: без комментария цена не меняется.
//
&НаКлиенте
Процедура ЗапроситьКомментарийЦены(ПараметрыПравки)

	ПоказатьВводСтроки(Новый ОписаниеОповещения("ИсправитьЦенуКомментарийВведен", ЭтотОбъект, ПараметрыПравки), "",
		СтрШаблон(НСтр("ru = 'Цена «%1»: %2 -> %3. Комментарий: почему меняется цена (обязательно)'"),
			ПараметрыПравки.Представление, ПараметрыПравки.СтараяЦена, ПараметрыПравки.НоваяЦена), 500, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ИсправитьЦенуКомментарийВведен(Комментарий, ПараметрыПравки) Экспорт

	Если Комментарий = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(Комментарий)) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет комментария - цену изменить нельзя. Цена не изменена.'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Исправление цены и пересверка...'"));
	Итог = ИсправитьЦенуНаСервере(ПараметрыПравки.ИдентификаторЗаказа, ПараметрыПравки.ИдентификаторПоступления,
		ПараметрыПравки.СтрокиПН, ПараметрыПравки.НоваяЦена, СокрЛП(Комментарий), ДатаДокументаИзУПД);
	Состояние();

	// Короткое оповещение (длинный текст в него не помещается), подробности - по строкам в сообщениях
	Если Итог.Успех Тогда
		Для Каждого ТекстСтроки Из Итог.Строки Цикл
			СообщитьПользователю(ТекстСтроки);
		КонецЦикла;
		ПоказатьОповещениеПользователя(НСтр("ru = 'Цена подтверждена'"), , Лев(Итог.Кратко, 100));
	Иначе
		ПоказатьПредупреждение(, Итог.Текст);
	КонецЕсли;

	// Строка перечитывается из реестра после пересверки
	ОбновитьПоОтбору();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИсправитьЦенуНаСервере(ИдентификаторЗаказа, ИдентификаторПоступления, СтрокиПН, НоваяЦена, Комментарий,
		ДатаДокументаИзУПД = Ложь)

	Возврат ЭАрМ_ПравкиЦен.ИсправитьЦену(ИдентификаторЗаказа, ИдентификаторПоступления, СтрокиПН, НоваяЦена,
		Комментарий, ДатаДокументаИзУПД);

КонецФункции

#КонецОбласти

#Область Автообновление

// Обработчик ожидания пересоздаётся при каждом изменении настроек.
//
&НаКлиенте
Процедура ПодключитьАвтообновление()

	ОтключитьОбработчикОжидания("Подключаемый_Автообновление");
	Если Автообновление Тогда
		ПодключитьОбработчикОжидания("Подключаемый_Автообновление", Макс(ИнтервалАвтообновления, 15));
	КонецЕсли;

КонецПроцедуры

// Дёшево спрашивает метку реестра; дерево перестраивается, только если реестр
// изменился - тогда новые поставки отмечаются.
//
&НаКлиенте
Процедура Подключаемый_Автообновление()

	Если МеткаРеестраНаСервере(ДатаНачала, ДатаОкончания) = МеткаРеестра Тогда
		Возврат;
	КонецЕсли;
	// Дерево заливается заново - без этого свёрнутые узлы раскрывались,
	// а курсор уезжал в начало
	РаскрытиеДерева = СостояниеДерева();
	ЗаполнитьДеревоНаСервере(Истина);
	ВосстановитьСостояниеДерева(РаскрытиеДерева);

КонецПроцедуры

&НаСервереБезКонтекста
Функция МеткаРеестраНаСервере(Знач Начало, Знач Окончание)

	Попытка
		Возврат ЭАрМ_РеестрТоваровЗаказов.МеткаРеестра(Начало, КонецДня(Макс(Окончание, ТекущаяДатаСеанса())));
	Исключение
		// Метка не должна мешать работе формы: постоянное значение не вызывает перечитывания
		Возврат "?";
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрименитьНастройки(Настройки)

	РежимГруппировки       = Настройки.Группировка;
	Автообновление         = Настройки.Автообновление;
	ИнтервалАвтообновления = Настройки.ИнтервалАвтообновления;
	ДатаДокументаИзУПД     = Настройки.ДатаДокументаИзУПД;

КонецПроцедуры

&НаСервере
Процедура ПрименитьНастройкиНаСервере()

	ПрименитьНастройки(ЭАрМ_РеестрТоваровЗаказов.НастройкиМонитора());

КонецПроцедуры

&НаСервере
Процедура ОбновитьСпискиОтборовНаСервере()

	Попытка
		Списки = ЭАрМ_РеестрТоваровЗаказов.СкладыИПоставщикиРеестра(ДатаНачала, ДатаОкончания);
	Исключение
		Возврат;
	КонецПопытки;

	Элементы.ОтборСклад.СписокВыбора.Очистить();
	Для Каждого Значение Из Списки.Склады Цикл
		Элементы.ОтборСклад.СписокВыбора.Добавить(Значение);
	КонецЦикла;
	Элементы.ОтборПоставщик.СписокВыбора.Очистить();
	Для Каждого Значение Из Списки.Поставщики Цикл
		Элементы.ОтборПоставщик.СписокВыбора.Добавить(Значение);
	КонецЦикла;
	Элементы.ОтборОрганизация.СписокВыбора.Очистить();
	Для Каждого Значение Из Списки.Организации Цикл
		Элементы.ОтборОрганизация.СписокВыбора.Добавить(Значение);
	КонецЦикла;

КонецПроцедуры

// Что раскрыто в дереве и на какой строке курсор - до перезаливки дерева.
//
// Возвращаемое значение:
//   Структура:
//     * Раскрытые - Соответствие - ключ узла -> Истина
//     * Известные - Соответствие - ключи всех узлов контрагентов и заказов
//     * Текущая   - Строка - ключ текущей строки
//
&НаКлиенте
Функция СостояниеДерева()

	Снимок = Новый Структура("Раскрытые, Известные, Текущая",
		Новый Соответствие, Новый Соответствие, "");

	Для Каждого УзелВерхний Из Дерево.ПолучитьЭлементы() Цикл
		КлючВерхнего = КлючУзлаДерева("", УзелВерхний);
		Снимок.Известные.Вставить(КлючВерхнего, Истина);
		Если Элементы.Дерево.Развернут(УзелВерхний.ПолучитьИдентификатор()) Тогда
			Снимок.Раскрытые.Вставить(КлючВерхнего, Истина);
		КонецЕсли;
		Для Каждого УзелЗаказа Из УзелВерхний.ПолучитьЭлементы() Цикл
			КлючЗаказа = КлючУзлаДерева(КлючВерхнего, УзелЗаказа);
			Снимок.Известные.Вставить(КлючЗаказа, Истина);
			Если Элементы.Дерево.Развернут(УзелЗаказа.ПолучитьИдентификатор()) Тогда
				Снимок.Раскрытые.Вставить(КлючЗаказа, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ТекущиеДанные = Элементы.Дерево.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Снимок.Текущая = КлючСтрокиДерева(ТекущиеДанные);
	КонецЕсли;

	Возврат Снимок;

КонецФункции

// Возвращает раскрытие и курсор после перезаливки. Узлы, которых раньше не
// было, показываются как при открытии: новый верхний узел раскрыт до
// приходных, новая приходная свёрнута.
//
&НаКлиенте
Процедура ВосстановитьСостояниеДерева(Снимок)

	ИдентификаторТекущей = Неопределено;

	Для Каждого УзелВерхний Из Дерево.ПолучитьЭлементы() Цикл

		КлючВерхнего = КлючУзлаДерева("", УзелВерхний);
		Идентификатор = УзелВерхний.ПолучитьИдентификатор();

		Если Снимок.Известные.Получить(КлючВерхнего) = Неопределено Тогда
			Элементы.Дерево.Развернуть(Идентификатор, Ложь);
		ИначеЕсли Снимок.Раскрытые.Получить(КлючВерхнего) <> Неопределено Тогда
			Элементы.Дерево.Развернуть(Идентификатор, Ложь);
		КонецЕсли;

		Если КлючСтрокиДерева(УзелВерхний) = Снимок.Текущая Тогда
			ИдентификаторТекущей = Идентификатор;
		КонецЕсли;

		Для Каждого УзелЗаказа Из УзелВерхний.ПолучитьЭлементы() Цикл

			КлючЗаказа = КлючУзлаДерева(КлючВерхнего, УзелЗаказа);
			ИдентификаторЗаказа = УзелЗаказа.ПолучитьИдентификатор();

			Если Снимок.Известные.Получить(КлючЗаказа) = Неопределено Тогда
				// Новая приходная - свёрнутой, как при открытии
			ИначеЕсли Снимок.Раскрытые.Получить(КлючЗаказа) <> Неопределено Тогда
				Элементы.Дерево.Развернуть(ИдентификаторЗаказа, Ложь);
			КонецЕсли;

			Если ИдентификаторТекущей = Неопределено И ЗначениеЗаполнено(Снимок.Текущая) Тогда
				Если КлючСтрокиДерева(УзелЗаказа) = Снимок.Текущая Тогда
					ИдентификаторТекущей = ИдентификаторЗаказа;
				Иначе
					Для Каждого СтрокаТовара Из УзелЗаказа.ПолучитьЭлементы() Цикл
						Если КлючСтрокиДерева(СтрокаТовара) = Снимок.Текущая Тогда
							ИдентификаторТекущей = СтрокаТовара.ПолучитьИдентификатор();
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Если ИдентификаторТекущей <> Неопределено Тогда
		Элементы.Дерево.ТекущаяСтрока = ИдентификаторТекущей;
	КонецЕсли;

КонецПроцедуры

// Ключ узла контрагента или заказа: не зависит от идентификаторов строк,
// которые при перезаливке дерева меняются.
//
&НаКлиенте
Функция КлючУзлаДерева(КлючРодителя, Узел)

	Если ЗначениеЗаполнено(Узел.ИдентификаторЗаказа) ИЛИ ЗначениеЗаполнено(Узел.ИдентификаторПоступления) Тогда
		Возврат КлючРодителя + "/" + Узел.ИдентификаторЗаказа + "|" + Узел.ИдентификаторПоступления;
	КонецЕсли;

	Возврат КлючРодителя + "/" + Узел.Представление;

КонецФункции

// Ключ любой строки дерева для возврата курсора.
//
&НаКлиенте
Функция КлючСтрокиДерева(СтрокаДерева)

	Возврат СтрШаблон("%1|%2|%3|%4", СтрокаДерева.ИдентификаторЗаказа,
		СтрокаДерева.ИдентификаторПоступления, СтрокаДерева.Штрихкод, СтрокаДерева.Представление);

КонецФункции

// Параметры:
//   ОтмечатьНовые - Булево - отметить поставки, которых не было в прошлый раз
//                   (автообновление); при ручном показе и смене отборов не отмечаются
//
&НаСервере
Процедура ЗаполнитьДеревоНаСервере(ОтмечатьНовые = Ложь)

	Отбор = ЭАрМ_РеестрТоваровЗаказов.НовыйОтборДереваРеестра();
	Отбор.Группировка  = РежимГруппировки;
	Отбор.Склад        = ОтборСклад;
	Отбор.Поставщик    = ОтборПоставщик;
	Отбор.Организация  = ОтборОрганизация;
	Отбор.Наименование = СокрЛП(ПоискНаименование);

	Известные = Новый Соответствие;
	Для Каждого Ключ Из СтрРазделить(ИзвестныеПоставки, Символы.ПС, Ложь) Цикл
		Известные.Вставить(Ключ, Истина);
	КонецЦикла;
	Если ОтмечатьНовые Тогда
		Отбор.ИзвестныеПоставки = Известные;
	КонецЕсли;

	// При автообновлении окончание периода подтягивается к текущему дню:
	// иначе поставки следующего дня не попадут в открытую с вечера форму
	Окончание = ?(ОтмечатьНовые, КонецДня(Макс(ДатаОкончания, ТекущаяДатаСеанса())), ДатаОкончания);

	ДеревоДанных = ЭАрМ_РеестрТоваровЗаказов.ДеревоРеестра(ДатаНачала, Окончание, ТолькоРасхождения, Отбор);
	ЗначениеВРеквизитФормы(ДеревоДанных, "Дерево");

	Новых = 0;
	Для Каждого Ключ Из ЭАрМ_РеестрТоваровЗаказов.КлючиПоставокДерева(ДеревоДанных) Цикл
		Если Известные.Получить(Ключ) = Неопределено Тогда
			Известные.Вставить(Ключ, Истина);
			Новых = Новых + 1;
		КонецЕсли;
	КонецЦикла;
	Ключи = Новый Массив;
	Для Каждого КлючЗначение Из Известные Цикл
		Ключи.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	ИзвестныеПоставки = СтрСоединить(Ключи, Символы.ПС);

	МеткаРеестра = МеткаРеестраНаСервере(ДатаНачала, ДатаОкончания);
	Дополнение = ?(ОтмечатьНовые И Новых > 0, СтрШаблон("новых поставок: %1", Новых),
		"обновлено " + Формат(ТекущаяДатаСеанса(), "ДФ='HH:mm:ss'"));
	ЗаполнитьМониторНаСервере(ДеревоДанных, Дополнение);

КонецПроцедуры

// Строка над деревом: что не сошлось (количество, цена, нет в УПД / приходе).
//
&НаСервере
Процедура ЗаполнитьМониторНаСервере(ДеревоДанных, Дополнение)

	Проблемы = ЭАрМ_ПравкиЦен.ПроблемыДерева(ДеревоДанных);
	Дублей = 0;
	Для Каждого УзелВерхний Из ДеревоДанных.Строки Цикл
		Для Каждого УзелЗаказа Из УзелВерхний.Строки Цикл
			Для Каждого Товар Из УзелЗаказа.Строки Цикл
				Если Товар.ВозможныйДубль = Истина Тогда
					Дублей = Дублей + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	МониторИтог = Проблемы.Текст
		+ ?(Дублей > 0, СтрШаблон("  ·  возможных дублей (строк): %1 - свяжите парой в реестре УПД", Дублей), "")
		+ "  ·  " + Дополнение;

	Если Проблемы.Проблем > 0 ИЛИ Дублей > 0 Тогда
		Элементы.МониторИтог.ЦветФона = Новый Цвет(255, 230, 230);
		Элементы.МониторИтог.ЦветТекста = Новый Цвет(140, 0, 0);
	Иначе
		Элементы.МониторИтог.ЦветФона = Новый Цвет(220, 255, 220);
		Элементы.МониторИтог.ЦветТекста = Новый Цвет(0, 100, 0);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СообщитьПользователю(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#Область УсловноеОформление

&НаСервере
Процедура ОформитьДерево()

	// Пришло - зелёным, не сошлись цена или количество - красным.
	// «Нет в УПД / в приходе» и узлы не красятся
	ПодсветитьРезультатДерева("Совпадает", Новый Цвет(220, 255, 220), Новый Цвет(0, 100, 0));

	Красные = Новый СписокЗначений;
	Красные.Добавить("Количество");
	Красные.Добавить("Цена");
	ПодсветитьРезультатыДерева(Красные, Новый Цвет(255, 224, 224), Новый Цвет(140, 0, 0));

	СкрытьПодтверждениеДалионБезЗапроса();

КонецПроцедуры

// Колонка «В Далион» только после отправки serviceRequest editReceiptPrices.
//
&НаСервере
Процедура СкрытьПодтверждениеДалионБезЗапроса()

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ДобавитьОформляемоеПоле(ЭлементОформления, "ДеревоПодтвержденоВДалион");
	ДобавитьОтбор(ЭлементОформления, "Дерево.ЗапросВДалион", ВидСравненияКомпоновкиДанных.Равно, Ложь);

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь);

КонецПроцедуры

&НаСервере
Процедура ПодсветитьРезультатДерева(ЗначениеРезультата, ЦветФона, ЦветТекста)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ДобавитьОформляемоеПоле(ЭлементОформления, "Дерево");
	ДобавитьОтбор(ЭлементОформления, "Дерево.Результат", ВидСравненияКомпоновкиДанных.Равно, ЗначениеРезультата);

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);

КонецПроцедуры

&НаСервере
Процедура ПодсветитьРезультатыДерева(ЗначенияРезультата, ЦветФона, ЦветТекста)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ДобавитьОформляемоеПоле(ЭлементОформления, "Дерево");
	ДобавитьОтбор(ЭлементОформления, "Дерево.Результат", ВидСравненияКомпоновкиДанных.ВСписке, ЗначенияРезультата);

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформляемоеПоле(ЭлементОформления, ИмяПоля)

	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ОформляемоеПоле.Использование = Истина;

КонецПроцедуры

&НаСервере
Процедура ДобавитьОтбор(ЭлементОформления, ИмяПоля, ВидСравнения, Значение)

	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Отбор.ВидСравнения   = ВидСравнения;
	Отбор.ПравоеЗначение = Значение;
	Отбор.Использование  = Истина;

КонецПроцедуры

#КонецОбласти
