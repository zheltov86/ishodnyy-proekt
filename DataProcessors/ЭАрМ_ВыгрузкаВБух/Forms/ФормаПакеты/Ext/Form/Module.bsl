// Пакеты, отправленные в Бухгалтерию (журнал ЭАрМ_ПакетыБух), и что по ним
// ответила Бухгалтерия: принят ли документ, что создано или почему нет.
// Отправка - после подписи (ЭАрМ_ВыгрузкаНакладныхДляБух), ответы - регламентным
// заданием или кнопкой «Прочитать ответы».

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПериодС = НачалоДня(ТекущаяДатаСеанса()) - 7 * 86400;
	ПериодПо = КонецДня(ТекущаяДатаСеанса());
	ЗаполнитьПакеты();

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ЗаполнитьПакеты();
	ПоказатьДокументыПакета();

КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьОтветы(Команда)

	ТекстСостояния = ПрочитатьОтветыНаСервере();
	ЗаполнитьПакеты();
	ПоказатьДокументыПакета();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьОтветыНаСервере()

	Отмечено = ЭАрМ_ВыгрузкаНакладныхДляБух.ПрочитатьОтветыБухгалтерии();
	Возврат СтрШаблон(НСтр("ru = 'Прочитано ответов БП по документам: %1'"), Отмечено);

КонецФункции

&НаКлиенте
Процедура ОтправитьСейчас(Команда)

	ТекстСостояния = ОтправитьСейчасНаСервере();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправитьСейчасНаСервере()

	Если ЭАрМ_ВыгрузкаНакладныхДляБух.ВыгрузкаИдетВФоне() Тогда
		Возврат НСтр("ru = 'Отправка в БП уже идёт - нажмите «Обновить» через минуту'");
	КонецЕсли;
	ЭАрМ_ВыгрузкаНакладныхДляБух.ЗапуститьВыгрузкуВФоне(Истина);

	Возврат НСтр("ru = 'Отправка подписанных в БП запущена в фоне - нажмите «Обновить» через минуту'");

КонецФункции

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)

	ЗаполнитьПакеты();
	ПоказатьДокументыПакета();

КонецПроцедуры

&НаКлиенте
Процедура ПакетыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьДокументыПакета", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДокументыПакета()

	ТекущиеДанные = Элементы.Пакеты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ДокументыПакета.Очистить();
		Возврат;
	КонецЕсли;

	ЗаполнитьДокументыПакета(ТекущиеДанные.Файл);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПакеты()

	Пакеты.Загрузить(ЭАрМ_ВыгрузкаНакладныхДляБух.ПакетыБух(ПериодС, ПериодПо));

	Документов = 0;
	ВБух = 0;
	НеСоздано = 0;
	БезОтвета = 0;
	Для Каждого СтрокаПакета Из Пакеты Цикл
		Документов = Документов + СтрокаПакета.Документов;
		ВБух = ВБух + СтрокаПакета.ВБух;
		НеСоздано = НеСоздано + СтрокаПакета.НеСоздано;
		БезОтвета = БезОтвета + СтрокаПакета.БезОтвета;
	КонецЦикла;

	Итог = СтрШаблон(НСтр("ru = 'Пакетов: %1, документов: %2 - в БП есть: %3, не создано: %4, без ответа: %5'"),
		Пакеты.Количество(), Документов, ВБух, НеСоздано, БезОтвета);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументыПакета(Знач ИмяФайла)

	ДокументыПакета.Загрузить(ЭАрМ_ВыгрузкаНакладныхДляБух.ДокументыПакетаБух(ИмяФайла));

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЖурналы(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("ОчиститьЖурналыЗавершение", ЭтотОбъект),
		НСтр("ru = 'Удалить из журнала записи старше 30 дней, которые больше не нужны (документы, которые в БП есть)?'"),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЖурналыЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ТекстСостояния = ОчиститьЖурналыНаСервере();
	Обновить(Неопределено);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОчиститьЖурналыНаСервере()

	Возврат ЭАрМ_ВыгрузкаНакладныхДляБух.ОчиститьЖурналПакетовБух(30);

КонецФункции
