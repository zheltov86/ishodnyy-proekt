// ============================================================================
// Форма внешней обработки ВыгрузкаИзУт в расширении (ЭАрМ_ВыгрузкаВБух, 16.10.2026):
// открывается из подсистемы «АРМ ЭДО» без файла .epf. Код - тот же, что у
// ВыгрузкаИзУт (фон БСП - «Обработка.ЭАрМ_ВыгрузкаВБух»). Правки - в
// БухВыгрузка\ОбменУТ_БУХ\ВыгрузкаИзУт и переносить сюда (скрипт ut_port_forms).
// ============================================================================

////////////////////////////////////////////////////////////////////////////////
// Форма «Выгрузка УПД и УКД из УТ в Бухгалтерию».
//
// Папка обмена, контрагент (часть наименования или ИНН) и период по дате УПД / УКД.
// «Показать» - дерево «Что выгружаем»: подписанные УПД (как их выгрузила бы
// автоматическая выгрузка) и УКД (до / после по цепочке) за период, с
// отметкой и проверкой сумм и НДС. Отбор по контрагенту, поиск по номеру УПД,
// «С УКД» и «Только не выгруженные» применяются сразу, без повторного чтения; период -
// по «Показать». Поиск по номеру показывает всю цепочку найденной УПД (и
// уже выгружавшиеся документы). «Выгрузить в папку» - отмеченные документы одним файлом, который
// затем читает обработка ВыгрузкаБух в БП.
//
// ЦЕПОЧКА РАЗВЁРНУТА ДЕРЕВОМ (дерево раскрыто целиком):
//   Цепочка УПД № ... от ...: УПД и УКД - N   (группа, отметка на всю цепочку)
//     УПД № ...                                (документ)
//       1. Товар 22% ...                       - строки как в документе БП
//     УКД № ..., 1-я в цепочке
//       поз. 3 ...: было -> стало
//     УКД № ..., 2-я в цепочке
// УПД без УКД - сразу документом. Цепочка выгружается целиком: отмечен хоть
// один документ - уходят УПД и все подписанные УКД. Галочка «Без проверки
// подписи» - в файл только отмеченные УПД и УКД, как есть, в том числе
// неподписанные. Отбор по контрагенту, поиск по номеру и «Только не
// выгруженные» - тоже цепочками.
//
// Уровень строки дерева: 0 - группа цепочки, 1 - документ (УПД / УКД, отметка),
// 2 - строка документа.
//
// СВЕРКА ПО АКТУ (вкладка «Сверка по акту»): акт поставщика Excel / MXL или
// «Приходы из БП» строками, каждой строке - документы УТ всеми способами,
// статусы (ПЕРЕНЕСТИ, НЕ ГОТОВ, НЕТ В ЭДО, ЛИШНЕЕ В БП, СУММА, КАНДИДАТЫ,
// ДУБЛЬ, АННУЛИРОВАНА, ВОЗВРАТ, БУМАЖНЫЙ...), «Собрать в выгрузку».
//
// СВЕРКА С БП БЕЗ ДУБЛЕЙ («Приходы из БП...», вкладка «Приходы из БП»): файл
// поступлений БП за период (ВыгрузкаБух, «Выгрузить приходы для УТ») - пары в
// реестрах УТ; что уже есть в БП («Есть в БП»), не отмечается и не выгружается,
// УКД к поступлению БП уходит со ссылкой на него.
////////////////////////////////////////////////////////////////////////////////

// Фоновая сборка, пока идёт (см. НачатьСборку): Вид, Ид, Адрес, ИмяФайла,
// Префикс, Начало, Ход. Неопределено - сборки в фоне нет.
&НаКлиенте
Перем ФоноваяСборка;

// Истина - после чтения («Показать») выполнить подготовку к отправке.
&НаКлиенте
Перем ПодготовкаПослеЧтения;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Папка = ЗагрузитьНастройку("Папка", "");
	Если НЕ ЗначениеЗаполнено(Папка) Тогда
		Папка = РеквизитФормыВЗначение("Объект").ПапкаИзНастроекУТ();
	КонецЕсли;
	Контрагент = ЗагрузитьНастройку("Контрагент", "");
	ПериодС = ЗагрузитьНастройку("ПериодС", НачалоМесяца(ТекущаяДатаСеанса()));
	// Пустое начало - выгрузка УТ берёт всю историю: подставляем начало месяца
	Если НЕ ЗначениеЗаполнено(ПериодС) Тогда
		ПериодС = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
	ПериодПо = ЗагрузитьНастройку("ПериодПо", '00010101');
	ТолькоНеВыгруженные = ЗагрузитьНастройку("ТолькоНеВыгруженные", Истина);
	СУКД = ЗагрузитьНастройку("СУКД", Истина);
	БезПроверкиПодписи = ЗагрузитьНастройку("БезПроверкиПодписи", Ложь);
	СтарыеУКД = ЗагрузитьНастройку("СтарыеУКД", Ложь);
	ОтправлятьБезДоговора = ЗагрузитьНастройку("ОтправлятьБезДоговора", Ложь);
	ТолькоУКД = ЗагрузитьНастройку("ТолькоУКД", Ложь);
	СобиратьВФоне = ЗагрузитьНастройку("СобиратьВФоне", Истина);
	ЛимитСборкиМинут = ЗагрузитьНастройку("ЛимитСборкиМинут", 15);
	НастроитьПодсветку();
	// Список отбора - поставщики УПД сразу, без «Показать»
	ЗаполнитьСписокКонтрагентов(Неопределено);

	// Версия сборки - первой строкой: по ней видно, что открыт новый .epf
	Информация = НСтр("ru = 'Версия обработки: 16.10.2026-16 («Отметить к отправке» - только не отправлявшееся, итог: ждут ответа, не собрано, УКД без УПД; подписанные УПД без строк товаров видны в «Реестре»; поиск «Контрагент» / «Номер» отбирает и «Реестр»; вкладка «Реестр»: цепочка на строку и дерево, настройки отдельной формой, «Подробно»; поиск УПД / УКД для отправки, из УТ уходит всё - проверки в БП, без задвоения УКД, фон и на старой БСП, почему пусто по контрагенту, охват контрагентов файла БП).'")
		+ Символы.ПС + НСтр("ru = 'Укажите папку обмена, период и (по желанию) контрагента, нажмите «Показать». В базу при этом ничего не пишется.'");
	ЗаполнитьПриходыБП(Новый Массив, Неопределено);
	СборкаПериодС = ПериодС;
	СборкаПериодПо = ПериодПо;
	СборкаВид = "Все";
	Для Каждого Вид Из СтрРазделить("Все,УКД,УПД", ",") Цикл
		Элементы.СборкаОтборВид.СписокВыбора.Добавить(Вид);
	КонецЦикла;
	Элементы.СборкаОтборВид.РежимВыбораИзСписка = Истина;
	Для Каждого ЭлементСписка Из Элементы.Контрагент.СписокВыбора Цикл
		Элементы.СборкаКонтрагент.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
		Элементы.ПриходыОтправкаКонтрагент.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	ПриходыОтправкаС = ПериодС;
	ПриходыОтправкаПо = ПериодПо;
	ИнформацияСборки = НСтр("ru = 'Сборка: период, контрагент (из списка), «Собрать» - все УКД (и старые) и УПД периода по одной строке. «Результат проверки»: есть в БП / нет - отправить / не отправится (причина). Надёжнее сначала загрузить «Приходы из БП». Отметьте нужные (или «Отметить к отправке») и «Отправить в БП».'");
	ИнформацияАкта = НСтр("ru = 'Сверка по акту: «Загрузить акт…» - акт сверки поставщика (Excel / MXL) или файл «Приходы из БП»; без акта - «Собрать по поставщику». Каждой строке ищутся документы УТ (УПД, УКД, ЭТрН, приходная Далиона, заказ) и что уже есть в БП. «Собрать в выгрузку» отмечает недостающее в дереве «Что выгружаем». Номер, дату и суммы строки можно поправить и нажать «Найти документы».'");

	ПриСозданииЗапросаДалиона();

	// Главное - «Реестр» и кнопки; настройки - отдельной формой, остальное -
	// по флажку «Подробно» (16.10.2026)
	ПоказатьПодробноУТ = ЗагрузитьНастройку("ПоказатьПодробно", Ложь);
	Элементы.ОтборПоставщикРеестрПоле.РежимВыбораИзСписка = Истина;
	Элементы.ОтборПоставщикРеестрПоле.КнопкаОчистки = Истина;
	УстановитьВидимостьПодробноУТ();
	Элементы.СтраницыВыгрузки.ТекущаяСтраница = Элементы.СтраницаРеестрУТ;
	ПодсказкаРеестрУТ = НСтр("ru = 'Период и контрагент - «Показать»: здесь цепочки УПД → УКД, внизу - документы выбранной. Отметьте и «Отправить отмеченные».'");

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	// Форма закрыта - её фоновая сборка больше не нужна
	Если ФоноваяСборка <> Неопределено И НЕ ЗавершениеРаботы Тогда
		ОтключитьОбработчикОжидания("ПроверитьСборку");
		ОтменитьСборкуНаСервере(ФоноваяСборка.Ид);
		ФоноваяСборка = Неопределено;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПапкаПриИзменении(Элемент)

	СохранитьНастройку("Папка", СокрЛП(Папка));

КонецПроцедуры

&НаКлиенте
Процедура ПапкаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Каталог = Папка;
	Диалог.Заголовок = НСтр("ru = 'Папка обмена с БП'");
	Диалог.Показать(Новый ОписаниеОповещения("ПапкаВыборЗавершение", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ПапкаВыборЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено ИЛИ ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Папка = ВыбранныеФайлы[0];
	СохранитьНастройку("Папка", Папка);

КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)

	СохранитьНастройку("ПериодС", ПериодС);
	СохранитьНастройку("ПериодПо", ПериодПо);

	// Прочитанное - за прежний период: дерево нужно собрать заново
	Если ЗначениеЗаполнено(АдресДанных) Тогда
		Информация = НСтр("ru = 'Период изменён - нажмите «Показать», чтобы собрать дерево за новый период.'");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	СохранитьНастройку("Контрагент", СокрЛП(Контрагент));
	СохранитьНастройку("ТолькоНеВыгруженные", ТолькоНеВыгруженные);
	СохранитьНастройку("СУКД", СУКД);

	Если ЗначениеЗаполнено(АдресДанных) Тогда
		ЗаполнитьТаблицуНаСервере();
		РазвернутьДерево();
	КонецЕсли;
	Если ЗначениеЗаполнено(АдресПриходовБП) Тогда
		ОбновитьПриходыБПНаСервере();
	КонецЕсли;
	Если ЗначениеЗаполнено(АдресРеестраУТ) Тогда
		ВывестиРеестрУТ();
		СоставЦепочкиУТ.ПолучитьЭлементы().Очистить();
	КонецЕсли;

КонецПроцедуры

// Таблица «Приходы из БП» заново (отбор по контрагенту), без повторной сверки.
&НаСервере
Процедура ОбновитьПриходыБПНаСервере()

	Данные = ?(ЗначениеЗаполнено(АдресДанных), ПолучитьИзВременногоХранилища(АдресДанных), Неопределено);
	Сверка = ПолучитьИзВременногоХранилища(АдресПриходовБП);
	ЗаполнитьПриходыБП(?(Данные = Неопределено, Новый Массив, Данные), Сверка);

КонецПроцедуры

&НаКлиенте
Процедура БезПроверкиПодписиПриИзменении(Элемент)

	СохранитьНастройку("БезПроверкиПодписи", БезПроверкиПодписи);
	Если БезПроверкиПодписи Тогда
		Информация = НСтр("ru = 'Без проверки подписи: в файл уйдут только отмеченные УПД и УКД. Неподписанные УКД появятся в таблице после «Показать».'");
	Иначе
		Информация = НСтр("ru = 'Проверка подписи включена: неподписанные УКД в файл не уйдут. Список обновится по «Показать».'");
	КонецЕсли;

КонецПроцедуры

// «Без УПД (только УКД)»: УПД скрываются сразу; непривязанные и старые УКД
// собираются при чтении - если чтение было без них, нужно «Показать».
&НаКлиенте
Процедура ТолькоУКДПриИзменении(Элемент)

	СохранитьНастройку("ТолькоУКД", ТолькоУКД);
	Если ЗначениеЗаполнено(АдресДанных) Тогда
		ЗаполнитьТаблицуНаСервере();
		РазвернутьДерево();
	КонецЕсли;
	Если ТолькоУКД Тогда
		Информация = НСтр("ru = 'Без УПД: в таблице и в файле только УКД - все УКД периода (привязанные, непривязанные и старые). Нажмите «Показать», чтобы собрать и непривязанные. В БП поступление найдётся по номеру УПД (и без букв) или по дате и строкам, привязка проверяется.'")
			+ Символы.ПС + Информация;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтарыеУКДПриИзменении(Элемент)

	СохранитьНастройку("СтарыеУКД", СтарыеУКД);
	Если СтарыеУКД Тогда
		Информация = НСтр("ru = 'Старые УКД: после «Показать» в таблице появятся УКД без УПД в реестре УТ и УКД, чья УПД уже не выгружается. «До» - из файла УКД в СБИС, в БП - к поступлению по номеру УПД (в т.ч. без букв).'");
	Иначе
		Информация = НСтр("ru = 'Старые УКД выключены: УКД без исходной УПД в УТ не выгружаются. Список обновится по «Показать».'");
	КонецЕсли;

КонецПроцедуры

// «Собирать в фоне» и «Лимит, мин» - запоминаются.
&НаКлиенте
Процедура СобиратьВФонеПриИзменении(Элемент)

	СохранитьНастройку("СобиратьВФоне", СобиратьВФоне);

КонецПроцедуры

&НаКлиенте
Процедура ЛимитСборкиМинутПриИзменении(Элемент)

	СохранитьНастройку("ЛимитСборкиМинут", ЛимитСборкиМинут);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНакладные

// Отметка - только у документов (уровень 1) и сразу на всю цепочку: УПД и её
// УКД выгружаются только вместе
&НаКлиенте
Процедура НакладныеОтметкаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Накладные.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Группа цепочки - отметка на всю цепочку
	Если ТекущиеДанные.Уровень = 0 И ЗначениеЗаполнено(ТекущиеДанные.КлючЦепочки) Тогда
		ОтметитьЦепочку(Накладные.ПолучитьЭлементы(), ТекущиеДанные.КлючЦепочки, ТекущиеДанные.Отметка);
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.Уровень <> 1 Тогда
		ТекущиеДанные.Отметка = Ложь;
		Возврат;
	КонецЕсли;

	// Уже есть в БП (сверка с файлом поступлений) - не выгружается
	Если ТекущиеДанные.ВБП И ТекущиеДанные.Отметка И НЕ ЭтоПовторнаяОтправка(ТекущиеДанные.Идентификатор) Тогда
		ТекущиеДанные.Отметка = Ложь;
		ЗапроситьПовторнуюОтправку("Накладные", ТекущиеДанные.ПолучитьИдентификатор(), ТекущиеДанные.Идентификатор,
			ТекущиеДанные.ДокументБП);
		Возврат;
	КонецЕсли;

	// Без проверки подписи отметка - только эта строка: в файл уйдёт она сама
	Если БезПроверкиПодписи Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущиеДанные.КлючЦепочки) Тогда
		ОтметитьЦепочку(Накладные.ПолучитьЭлементы(), ТекущиеДанные.КлючЦепочки, ТекущиеДанные.Отметка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьЦепочку(Строки, КлючЦепочки, Отметка)

	Для Каждого СтрокаДерева Из Строки Цикл
		Если СтрокаДерева.Уровень <= 1 И СтрокаДерева.КлючЦепочки = КлючЦепочки Тогда
			// Есть в БП - не отмечается
			СтрокаДерева.Отметка = Отметка И (НЕ СтрокаДерева.ВБП ИЛИ ЭтоПовторнаяОтправка(СтрокаДерева.Идентификатор));
		КонецЕсли;
		ОтметитьЦепочку(СтрокаДерева.ПолучитьЭлементы(), КлючЦепочки, Отметка);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоказатьУПД(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПериодС) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите начало периода: без него попадут УПД за всю историю.'"));
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПериодС) И ЗначениеЗаполнено(ПериодПо) И ПериодС > ПериодПо Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Начало периода позже конца.'"));
		Возврат;
	КонецЕсли;

	НачатьСборку("Показать");

КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Папка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите папку обмена с БП.'"));
		Возврат;
	КонецЕсли;

	Счетчики = Новый Структура("Отмечено, Повторно", 0, 0);
	ПосчитатьОтмеченные(Накладные.ПолучитьЭлементы(), Счетчики);

	Если Счетчики.Отмечено = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте документы в дереве «Что выгружаем».'"));
		Возврат;
	КонецЕсли;

	Если БезПроверкиПодписи Тогда
		ТекстВопроса = СтрШаблон(НСтр("ru = 'Выгрузить отмеченные УПД и УКД (%1) как есть, без проверки подписи, одним файлом в папку %2? Уйдут только строки с отметкой, в том числе неподписанные. Остальные документы цепочки не добавляются.'"),
			Счетчики.Отмечено, Папка);
	Иначе
		ТекстВопроса = СтрШаблон(НСтр("ru = 'Выгрузить отмеченные УПД и УКД (%1) одним файлом в папку %2? Цепочки уходят ЦЕЛИКОМ: к каждому отмеченному добавятся УПД и УКД его цепочки (и уже выгружавшиеся, и скрытые отбором). Неподписанные УКД тоже уходят.'"),
			Счетчики.Отмечено, Папка);
	КонецЕсли;
	Если ЗначениеЗаполнено(АдресПриходовБП) Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС + НСтр("ru = 'Сверка с БП загружена: то, что уже есть в БП, не уйдёт; УКД к поступлениям БП уйдут со ссылкой на поступление.'");
	КонецЕсли;
	Если Счетчики.Повторно > 0 Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС + СтрШаблон(
			НСтр("ru = 'Из них уже выгружались: %1 - БП уже полученные второй раз не создаёт.'"),
			Счетчики.Повторно);
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("ВыгрузитьЗавершение", ЭтотОбъект),
		ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Пишем файл выгрузки...'"));
	ТекстРезультата = ВыгрузитьНаСервере();
	Состояние();

	РазвернутьДерево();
	ПоказатьПредупреждение(, ТекстРезультата);

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	УстановитьОтметки(Накладные.ПолучитьЭлементы(), Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)

	УстановитьОтметки(Накладные.ПолучитьЭлементы(), Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьОтветы(Команда)

	Отмечено = ПрочитатьОтветыНаСервере();
	Если Отмечено < 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Ответы не прочитаны: модуль выгрузки УТ недоступен (подробности - в журнале регистрации).'"));
	Иначе
		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru = 'Прочитано ответов БП: %1. Статусы - в поле «БП» очереди «Ожидает подтверждения ЭДО».'"),
			Отмечено));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПосчитатьОтмеченные(Строки, Счетчики)

	Для Каждого СтрокаДерева Из Строки Цикл
		Если СтрокаДерева.Уровень = 1 И СтрокаДерева.Отметка
			И (НЕ СтрокаДерева.ВБП ИЛИ ЭтоПовторнаяОтправка(СтрокаДерева.Идентификатор)) Тогда
			Счетчики.Отмечено = Счетчики.Отмечено + 1;
			Если СтрокаДерева.Выгружена Тогда
				Счетчики.Повторно = Счетчики.Повторно + 1;
			КонецЕсли;
		КонецЕсли;
		ПосчитатьОтмеченные(СтрокаДерева.ПолучитьЭлементы(), Счетчики);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметки(Строки, Отметка)

	Для Каждого СтрокаДерева Из Строки Цикл
		Если СтрокаДерева.Уровень = 1
			ИЛИ СтрокаДерева.Уровень = 0 И ЗначениеЗаполнено(СтрокаДерева.КлючЦепочки) Тогда
			СтрокаДерева.Отметка = Отметка И (НЕ СтрокаДерева.ВБП ИЛИ ЭтоПовторнаяОтправка(СтрокаДерева.Идентификатор));
		КонецЕсли;
		УстановитьОтметки(СтрокаДерева.ПолучитьЭлементы(), Отметка);
	КонецЦикла;

КонецПроцедуры

// Цепочки развёрнуты целиком: УПД, её строки и УКД со строками.
&НаКлиенте
Процедура РазвернутьДерево()

	Для Каждого СтрокаДерева Из Накладные.ПолучитьЭлементы() Цикл
		Элементы.Накладные.Развернуть(СтрокаДерева.ПолучитьИдентификатор(), Истина);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПрочитатьНаСервере()

	ПрименитьПрочитанное(ОбъектДляЧтения().ПрочитатьДокументы(ПериодС, ПериодПо, БезПроверкиПодписи,
		СтарыеУКД ИЛИ ТолькоУКД));

КонецПроцедуры

// Прочитанное (ПрочитатьДокументы - здесь или в фоне, см. НачатьСборку) - в
// дерево «Что выгружаем», список контрагентов и «Приходы из БП».
&НаСервере
Процедура ПрименитьПрочитанное(Результат)

	ПропущеныУПД = ТекстПропущенныхУПД(Результат);

	Если НЕ Результат.Успех Тогда
		АдресДанных = "";
		Дерево = РеквизитФормыВЗначение("Накладные");
		Дерево.Строки.Очистить();
		ЗначениеВРеквизитФормы(Дерево, "Накладные");
		Информация = Результат.Ошибка;
		ПоясненияУКД = "";
		Элементы.ПоясненияУКД.Видимость = Ложь;
		ЗаполнитьСписокКонтрагентов(Неопределено);
		ПрименитьПриходыБП(Новый Массив);
		Возврат;
	КонецЕсли;

	// Какие УКД периода не выгружаются и почему - над таблицей
	ПоясненияУКД = СтрСоединить(Результат.Пояснения, Символы.ПС);
	Элементы.ПоясненияУКД.Видимость = ЗначениеЗаполнено(ПоясненияУКД);

	// Сверка с файлом поступлений БП: что уже есть в БП - отметкой в данных
	ПрименитьПриходыБП(Результат.Документы);

	АдресДанных = ПоместитьВоВременноеХранилище(Результат.Документы, УникальныйИдентификатор);

	// Список выбора контрагента - поставщики УПД и контрагенты документов периода
	ЗаполнитьСписокКонтрагентов(Результат.Документы);

	ЗаполнитьТаблицуБезСбоя(Результат.Документы);

	// Главное - «Реестр»: цепочка на строку, внизу её документы (16.10.2026);
	// загружены «Номера из Бух» - сведены и с ними
	Если ЗначениеЗаполнено(АдресНомеровБух) Тогда
		ПрименитьНомераБух();
	Иначе
		ЗаполнитьРеестрУТ(Результат.Документы);
	КонецЕсли;
	Элементы.СтраницыВыгрузки.ТекущаяСтраница = Элементы.СтраницаРеестрУТ;

КонецПроцедуры

// Подписанные УПД периода, которые выгрузка УТ не собрала (нет строк товаров,
// ошибка сборки), - в «Реестре» их нет, в Бух они не уйдут: текст для
// подсказки реестра и итога «Отметить к отправке» (16.10.2026).
&НаСервере
Функция ТекстПропущенныхУПД(Результат)

	Пропущены = Неопределено;
	Если НЕ Результат.Успех ИЛИ НЕ Результат.Свойство("Пропущены", Пропущены)
		ИЛИ ТипЗнч(Пропущены) <> Тип("Массив") ИЛИ Пропущены.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Список = Новый Массив;
	Для Каждого Пропуск Из Пропущены Цикл
		Если Список.Количество() = 10 Тогда
			Список.Добавить(СтрШаблон(НСтр("ru = 'и ещё %1'"), Пропущены.Количество() - 10));
			Прервать;
		КонецЕсли;
		Список.Добавить(СтрШаблон("№ %1 от %2 (%3): %4", Пропуск.Номер, Формат(Пропуск.Дата, "ДЛФ=D"),
			Пропуск.Контрагент, Пропуск.Причина));
	КонецЦикла;

	Возврат СтрШаблон(НСтр("ru = 'Не собраны и в БП не уйдут - подписанные УПД периода: %1. %2'"),
		Пропущены.Количество(), СтрСоединить(Список, "; "));

КонецФункции

// ИНН контрагента, выбранного из списка (представление «Наименование (ИНН)»);
// введён текст вручную - пусто.
&НаСервере
Функция ИННВыбранногоКонтрагента(Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	ЭлементСписка = Элементы.Контрагент.СписокВыбора.НайтиПоЗначению(Значение);
	Если ЭлементСписка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Представление = СокрЛП(ЭлементСписка.Представление);
	Начало = СтрНайти(Представление, "(", НаправлениеПоиска.СКонца);
	Если Начало = 0 ИЛИ Прав(Представление, 1) <> ")" Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Сред(Представление, Начало + 1, СтрДлина(Представление) - Начало - 1));

КонецФункции

// Список выбора поля «Контрагент»: поставщики наших УПД из реестра УТ
// (ЭАрМ_УПД_Входящий: наименование и ИНН) за период отбора и 90 дней до него -
// цепочки УКД тянут УПД раньше периода; плюс контрагенты прочитанных документов
// (Документы - Массив из ПрочитатьДокументы; Неопределено - только реестр).
// Значение - наименование (отбор ищет часть наименования или ИНН), в списке
// виден и ИНН. Не зависит от того, удалось ли «Показать».
&НаСервере
Процедура ЗаполнитьСписокКонтрагентов(Документы)

	ПоНаименованию = Новый Соответствие;
	Порядок = Новый СписокЗначений;

	ДатаС = ?(ЗначениеЗаполнено(ПериодС), НачалоДня(ПериодС), НачалоМесяца(ТекущаяДатаСеанса())) - 90 * 86400;
	Попытка
		Дней = Макс(30, Цел((ТекущаяДатаСеанса() - ДатаС) / 86400) + 1);
		Для Каждого Описание Из РеквизитФормыВЗначение("Объект").ПоставщикиУПД(Дней) Цикл
			Наименование = ?(ЗначениеЗаполнено(Описание.Наименование), Описание.Наименование, Описание.ИНН);
			Если ЗначениеЗаполнено(Наименование) И ПоНаименованию.Получить(ВРег(Наименование)) = Неопределено Тогда
				ПоНаименованию.Вставить(ВРег(Наименование), Истина);
				Порядок.Добавить(Наименование, СтрШаблон("%1 (%2)", Наименование, Описание.ИНН));
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("ОбменУТ.ВыгрузкаВБух", УровеньЖурналаРегистрации.Ошибка, , ,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Документы <> Неопределено Тогда
		Для Каждого Элемент Из Документы Цикл
			Наименование = СокрЛП(Элемент.Описание.Контрагент);
			Если ЗначениеЗаполнено(Наименование) И ПоНаименованию.Получить(ВРег(Наименование)) = Неопределено Тогда
				ПоНаименованию.Вставить(ВРег(Наименование), Истина);
				Порядок.Добавить(Наименование, ?(ЗначениеЗаполнено(Элемент.Описание.ИНН),
					СтрШаблон("%1 (%2)", Наименование, СокрЛП(Элемент.Описание.ИНН)), Наименование));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Порядок.СортироватьПоПредставлению();
	Элементы.Контрагент.СписокВыбора.Очистить();
	Для Каждого ЭлементСписка Из Порядок Цикл
		Элементы.Контрагент.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;

КонецПроцедуры

// Цепочки контрагента из отбора «Контрагент» (часть наименования или ИНН; выбран
// из списка - ещё и по ИНН): в дереве и в выгрузке - только они. Отбор пуст -
// Неопределено (все).
&НаСервере
Функция ЦепочкиОтмеченныхКонтрагентов(Данные)

	Отбор = ВРег(СокрЛП(Контрагент));
	Если НЕ ЗначениеЗаполнено(Отбор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОтборИНН = ИННВыбранногоКонтрагента(Контрагент);
	Результат = Новый Соответствие;
	Для Каждого Элемент Из Данные Цикл
		Описание = Элемент.Описание;
		Если СтрНайти(ВРег(Описание.Контрагент), Отбор) > 0 ИЛИ СтрНайти(ВРег(Описание.ИНН), Отбор) > 0
			ИЛИ ЗначениеЗаполнено(ОтборИНН) И СокрЛП(Описание.ИНН) = ОтборИНН Тогда
			Результат.Вставить(Описание.КлючЦепочки, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// «Очистить отбор»: контрагент и номер - пусто, дерево и «Приходы из БП» заново.
&НаКлиенте
Процедура ОчиститьОтбор(Команда)

	Контрагент = "";
	НомерУПД = "";
	СохранитьНастройку("Контрагент", "");
	Если ЗначениеЗаполнено(АдресДанных) Тогда
		ЗаполнитьТаблицуНаСервере();
		РазвернутьДерево();
	КонецЕсли;
	Если ЗначениеЗаполнено(АдресПриходовБП) Тогда
		ОбновитьПриходыБПНаСервере();
	КонецЕсли;
	Если ЗначениеЗаполнено(АдресРеестраУТ) Тогда
		ВывестиРеестрУТ();
		СоставЦепочкиУТ.ПолучитьЭлементы().Очистить();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()

	Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	Если Данные = Неопределено Тогда
		Информация = НСтр("ru = 'Данные устарели - нажмите «Показать».'");
		Возврат;
	КонецЕсли;

	ЗаполнитьТаблицуБезСбоя(Данные);

КонецПроцедуры

// Сбой построения дерева не должен отменять остальное (исключение в серверном
// вызове отменяет все изменения формы - пропадал и список контрагентов):
// причина - в «Информации» и журнале регистрации.
&НаСервере
Процедура ЗаполнитьТаблицуБезСбоя(Данные)

	Попытка
		ЗаполнитьТаблицу(Данные);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ОбменУТ.ВыгрузкаВБух", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Информация = НСтр("ru = 'Таблица не построена: '") + ТекстОшибки
			+ НСтр("ru = ' (подробно - журнал регистрации, событие «ОбменУТ.ВыгрузкаВБух»). Список контрагентов заполнен.'");
	КонецПопытки;

КонецПроцедуры

// Дерево «Что выгружаем» по прочитанным УПД и УКД (данные уже по порядку
// цепочек) с отбором по контрагенту и «Только не выгруженные». Отметка - на
// ещё не выгруженных и тех, что в БП создадутся (нет ошибки в проверке).
//
&НаСервере
Процедура ЗаполнитьТаблицу(Данные)

	Дерево = РеквизитФормыВЗначение("Накладные");
	Дерево.Строки.Очистить();

	// Приходные Далиона по ид УПД - ссылкой в колонку «Документ УТ»
	ПриходныеУПД = ПриходныеПоУПД(Данные);

	Отбор = ВРег(СокрЛП(Контрагент));
	// Выбран из списка - отбор ещё и по ИНН: у УКД наименование из реестра УКД
	// может быть записано иначе, чем у УПД
	ОтборИНН = ИННВыбранногоКонтрагента(Контрагент);
	НомерОтбор = НомерДляПоиска(НомерУПД);
	// Поиск по номеру - цепочками: УПД с этим номером или УКД с этим номером
	// (своим или исходной УПД) - показывается вся цепочка
	НайденныеЦепочки = Новый Соответствие;
	Если ЗначениеЗаполнено(НомерОтбор) Тогда
		Для Каждого Элемент Из Данные Цикл
			Описание = Элемент.Описание;
			Если СтрНайти(НомерДляПоиска(Описание.Номер), НомерОтбор) > 0
				ИЛИ Описание.Вид = "УКД" И СтрНайти(НомерДляПоиска(НомерИзЦепочки(Описание.Цепочка)), НомерОтбор) > 0 Тогда
				НайденныеЦепочки.Вставить(Описание.КлючЦепочки, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// «Только не выгруженные» - цепочками: цепочка скрывается, только если в ней
	// всё уже выгружалось
	ЦепочкиСНевыгруженными = Новый Соответствие;
	ЦепочкиКОтметке = Новый Соответствие;
	Для Каждого Элемент Из Данные Цикл
		// Без УПД - цепочку «невыгруженной» делают только УКД
		Если ТолькоУКД И Элемент.Описание.Вид = "УПД" Тогда
			Продолжить;
		КонецЕсли;
		// Есть в БП (сверка с файлом поступлений) - как выгруженный
		Если НЕ Элемент.Описание.Выгружена И НЕ ЕстьВБП(Элемент.Описание) Тогда
			ЦепочкиСНевыгруженными.Вставить(Элемент.Описание.КлючЦепочки, Истина);
		КонецЕсли;
		// Из УТ уходит всё ещё не выгруженное, проверки - в БП (15.10.2026)
		Если НЕ Элемент.Описание.Выгружена Тогда
			ЦепочкиКОтметке.Вставить(Элемент.Описание.КлючЦепочки, Истина);
		КонецЕсли;
	КонецЦикла;
	Выгруженных = 0;
	УПД = 0;
	УКД = 0;
	СОшибками = 0;
	УКДСОшибкой = 0;
	СкрытоУКДВыгруженных = 0;
	СкрытоУКДГалочкой = 0;
	ВБПВсего = 0;
	УКДкПоступлениюБП = 0;

	// Отбор по контрагенту - цепочками: подходит хоть один документ цепочки
	// (у УКД контрагент - из реестра УКД, наименование может отличаться от УПД)
	ЦепочкиКонтрагента = Новый Соответствие;
	Если ЗначениеЗаполнено(Отбор) Тогда
		Для Каждого Элемент Из Данные Цикл
			Описание = Элемент.Описание;
			Если СтрНайти(ВРег(Описание.Контрагент), Отбор) > 0 ИЛИ СтрНайти(ВРег(Описание.ИНН), Отбор) > 0
				ИЛИ ЗначениеЗаполнено(ОтборИНН) И СокрЛП(Описание.ИНН) = ОтборИНН Тогда
				ЦепочкиКонтрагента.Вставить(Описание.КлючЦепочки, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Отбор «Контрагент» - и для выгрузки (см. ЦепочкиОтмеченныхКонтрагентов)
	ЦепочкиОтмеченных = ЦепочкиОтмеченныхКонтрагентов(Данные);

	// 1. Что показываем (данные уже по порядку цепочек: УПД, затем её УКД)
	Показываемые = Новый Массив;
	УКДВЦепочке = Новый Соответствие;
	Для Каждого Элемент Из Данные Цикл

		Описание = Элемент.Описание;

		Если ЦепочкиОтмеченных <> Неопределено И ЦепочкиОтмеченных.Получить(Описание.КлючЦепочки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(Отбор) И ЦепочкиКонтрагента.Получить(Описание.КлючЦепочки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(НомерОтбор) И НайденныеЦепочки.Получить(Описание.КлючЦепочки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// «С УКД» снята - только УПД (УКД не показываются и не выгружаются)
		// «Без УПД (только УКД)» - УПД не показываются и в файл не уходят
		Если ТолькоУКД И Описание.Вид = "УПД" Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ СУКД И Описание.Вид = "УКД" Тогда
			СкрытоУКДГалочкой = СкрытоУКДГалочкой + 1;
			Продолжить;
		КонецЕсли;

		// Ищут по номеру - показываем и уже выгружавшиеся
		Если ТолькоНеВыгруженные И НЕ ЗначениеЗаполнено(НомерОтбор)
			И ЦепочкиСНевыгруженными.Получить(Описание.КлючЦепочки) = Неопределено Тогда
			Если Описание.Вид = "УКД" Тогда
				СкрытоУКДВыгруженных = СкрытоУКДВыгруженных + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Показываемые.Добавить(Элемент);
		Если Описание.Вид = "УКД" Тогда
			УКДВЦепочке.Вставить(Описание.КлючЦепочки,
				?(УКДВЦепочке.Получить(Описание.КлючЦепочки) = Неопределено, 0, УКДВЦепочке.Получить(Описание.КлючЦепочки)) + 1);
		КонецЕсли;

	КонецЦикла;

	// УКД цепочки - строкой в колонке «УКД цепочки» УПД и группы цепочки
	КартаУКД = Новый Соответствие;
	Для Каждого Элемент Из Показываемые Цикл
		Описание = Элемент.Описание;
		Если Описание.Вид <> "УКД" Тогда
			Продолжить;
		КонецЕсли;
		Пометка = ?(Описание.Ошибка, НСтр("ru = ' - ошибка'"),
			?(Описание.Выгружена, НСтр("ru = ' - уже выгружена'"), ""));
		ДобавитьСтрокуУКД(КартаУКД, Описание.КлючЦепочки, СтрШаблон(НСтр("ru = '№ %1 от %2%3'"),
			СокрЛП(Описание.Номер), Формат(Описание.Дата, "ДЛФ=D"), Пометка));
	КонецЦикла;

	// УКД по цепочкам (из видимых документов) - для блока под УПД в таблице
	УКДПоЦепочке = УКДПоЦепочкам(Показываемые);
	БлокУКДПодУПД = Новый Соответствие;

	// 2. Дерево. Цепочка с УКД - РАЗВЁРНУТОЙ ГРУППОЙ: «Цепочка УПД № ...»,
	// внутри по порядку УПД, 1-я УКД, 2-я УКД... (у каждого - его строки). УПД
	// без УКД - сразу документом. Отметка - на всю цепочку: отмечены все её
	// документы без ошибки, если в цепочке есть ещё не выгружавшееся
	Группы = Новый Соответствие;
	Для Каждого Элемент Из Показываемые Цикл

		Описание = Элемент.Описание;
		ЧислоУКД = УКДВЦепочке.Получить(Описание.КлючЦепочки);
		ОтмечатьЦепочку = ЦепочкиКОтметке.Получить(Описание.КлючЦепочки) <> Неопределено;

		Если ЧислоУКД = Неопределено Тогда
			Родитель = Дерево;
		Иначе
			Группа = Группы.Получить(Описание.КлючЦепочки);
			Если Группа = Неопределено Тогда
				Группа = Дерево.Строки.Добавить();
				Группа.Уровень = 0;
				Группа.КлючЦепочки = Описание.КлючЦепочки;
				Группа.Цепочка = Описание.Цепочка;
				Группа.Вид = НСтр("ru = 'Цепочка'");
				Группа.Номер = СтрШаблон(НСтр("ru = 'Цепочка %1: УПД и УКД - %2'"), Описание.Цепочка, ЧислоУКД);
				Группа.Дата = Описание.ДатаЦепочки;
				Группа.Контрагент = Описание.Контрагент;
				Группа.ИНН = Описание.ИНН;
				Группа.Организация = Описание.Организация;
				Группа.Склад = Описание.Склад;
				Группа.Комментарий = Описание.Комментарий;
				Группа.Отметка = ОтмечатьЦепочку;
				Группа.Строк = 0;
				Группа.Статус = НСтр("ru = 'Выгружается целиком: УПД и все подписанные УКД по порядку'");
				Группы.Вставить(Описание.КлючЦепочки, Группа);
			КонецЕсли;
			Родитель = Группа;
		КонецЕсли;

		СтрокаДокумента = Родитель.Строки.Добавить();
		Если Описание.Вид = "УКД" Тогда
			УКД = УКД + 1;
		Иначе
			УПД = УПД + 1;
		КонецЕсли;

		ЗаполнитьЗначенияСвойств(СтрокаДокумента, Описание);
		Если НЕ ЗначениеЗаполнено(СтрокаДокумента.ДокументУТ) Тогда
			СтрокаДокумента.ДокументУТ = ПриходныеУПД.Получить(ВРег(ИдентификаторУПДЭлемента(Элемент)));
		КонецЕсли;
		Если Описание.Вид = "УПД" Тогда
			СтрокаДокумента.УКДЦепочки = ТекстУКДЦепочки(КартаУКД, Описание.КлючЦепочки);
		КонецЕсли;
		СтрокаДокумента.Уровень = 1;
		СтрокаДокумента.Отметка = ОтмечатьЦепочку И НЕ Описание.Выгружена;
		Если Описание.Ошибка Тогда
			СтрокаДокумента.Статус = НСтр("ru = 'Проверьте (уйдёт, решит БП): '") + КраткаяПричинаУТ(Описание.Проверка);
			СОшибками = СОшибками + 1;
			Если Описание.Вид = "УКД" Тогда
				УКДСОшибкой = УКДСОшибкой + 1;
			КонецЕсли;
		Иначе
			СтрокаДокумента.Статус = ?(Описание.Выгружена,
				НСтр("ru = 'Уже выгружалась в БП'"), НСтр("ru = 'Не выгружалась'"));
		КонецЕсли;
		Если Описание.ДобавленаДляЦепочки Тогда
			СтрокаДокумента.Статус = СтрокаДокумента.Статус + НСтр("ru = ' (вне периода - звено цепочки)'");
		КонецЕсли;
		СтрокаДокумента.Итог = ИтогОписания(Описание);
		Если СтрокаДокумента.Итог = 0 И Описание.Выгружена Тогда
			СтрокаДокумента.Итог = 3;
		КонецЕсли;
		// Сверка с файлом поступлений БП: уже есть в БП - не выгружается
		Если ЕстьВБП(Описание) Тогда
			СтрокаДокумента.Статус = НСтр("ru = 'Есть в БП: '") + Описание.ДокументБП
				+ НСтр("ru = ' - уйдёт, БП второй раз не создаст'");
			СтрокаДокумента.Итог = 3;
			ВБПВсего = ВБПВсего + 1;
		ИначеЕсли ВнеФайлаБП(Описание) Тогда
			СтрокаДокумента.Статус = НСтр("ru = 'В файле БП этого контрагента нет - не проверено (уйдёт, проверит БП) | '")
				+ СтрокаДокумента.Статус;
			СтрокаДокумента.Итог = Макс(СтрокаДокумента.Итог, 1);
		ИначеЕсли Описание.Вид = "УКД" И ЗначениеЗаполнено(ЗначениеПоля(Описание, "ПоступлениеБП")) Тогда
			СтрокаДокумента.Статус = СтрокаДокумента.Статус + НСтр("ru = '; в БП - '") + Описание.ДокументБП;
			УКДкПоступлениюБП = УКДкПоступлениюБП + 1;
		КонецЕсли;
		// УКД: что уйдёт в БП (изменение со знаком, цена / количество по позициям) - первым
		Если Описание.Вид = "УКД" И НЕ ЕстьВБП(Описание) И ЗначениеЗаполнено(ЗначениеПоля(Описание, "ЧтоУйдетВБП")) Тогда
			СтрокаДокумента.Статус = Описание.ЧтоУйдетВБП + " | " + СтрокаДокумента.Статус;
		КонецЕсли;
		Если Описание.Выгружена Тогда
			Выгруженных = Выгруженных + 1;
		КонецЕсли;

		// Склад и комментарий цепочки - с УПД (у УКД - те же, с её УПД)
		Если ЧислоУКД <> Неопределено Тогда
			Если Описание.Вид = "УПД" Тогда
				Родитель.ДокументУТ = СтрокаДокумента.ДокументУТ;
				Родитель.Склад = Описание.Склад;
				Родитель.Комментарий = Описание.Комментарий;
				Родитель.Контрагент = Описание.Контрагент;
			ИначеЕсли НЕ ЗначениеЗаполнено(Родитель.Склад) Тогда
				Родитель.Склад = Описание.Склад;
			КонецЕсли;
			Родитель.Строк = Родитель.Строк + 1;
		КонецЕсли;

		ДобавитьСтрокиДокумента(СтрокаДокумента, Элемент);

		// Под строками УПД - те же УКД, что уйдут в «ПриходныеКорректировки» JSON
		// (отметка и выгрузка - по документу УКД в цепочке ниже)
		Если Описание.Вид = "УПД" И БлокУКДПодУПД.Получить(Описание.КлючЦепочки) = Неопределено Тогда
			ДобавитьБлокУКДПодУПД(СтрокаДокумента, УКДПоЦепочке.Получить(Описание.КлючЦепочки));
			БлокУКДПодУПД.Вставить(Описание.КлючЦепочки, Истина);
		КонецЕсли;

	КонецЦикла;

	Для Каждого КлючЗначение Из Группы Цикл
		КлючЗначение.Значение.УКДЦепочки = ТекстУКДЦепочки(КартаУКД, КлючЗначение.Ключ);
	КонецЦикла;

	// Нет УПД в группе (не выгружается из УТ или скрыта) - видно в статусе
	Для Каждого КлючЗначение Из Группы Цикл
		ЕстьУПД = Ложь;
		Для Каждого СтрокаДерева Из КлючЗначение.Значение.Строки Цикл
			Если СтрокаДерева.Вид = "УПД" Тогда
				ЕстьУПД = Истина;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЕстьУПД Тогда
			КлючЗначение.Значение.Статус = ?(ТолькоУКД,
				НСтр("ru = 'Без УПД: уходят только УКД - в БП поступление ищется по номеру УПД (и без букв) или по дате и строкам, привязка проверяется'"),
				НСтр("ru = 'УПД цепочки в выгрузке нет (не подписана / закрыта / заменена в УТ) - УКД пойдут на поступление, уже созданное в БП'"));
		КонецЕсли;
	КонецЦикла;

	// Сверка с БП: УПД цепочки есть в БП - уходят только новые УКД
	Для Каждого КлючЗначение Из Группы Цикл
		Документов = 0;
		ВсеВБП = Истина;
		УПДвБП = "";
		НовыхУКД = 0;
		ИзменениеУКД = 0;
		Для Каждого СтрокаДерева Из КлючЗначение.Значение.Строки Цикл
			Если СтрокаДерева.Уровень <> 1 Тогда
				Продолжить;
			КонецЕсли;
			Документов = Документов + 1;
			Если СтрокаДерева.ВБП Тогда
				Если СтрокаДерева.Вид = "УПД" Тогда
					УПДвБП = СтрокаДерева.ДокументБП;
				КонецЕсли;
			Иначе
				ВсеВБП = Ложь;
				Если СтрокаДерева.Вид = "УКД" Тогда
					НовыхУКД = НовыхУКД + 1;
					// В итог цепочки - то, что уйдёт (без УКД с ошибкой)
					Если СтрокаДерева.Итог <> 2 Тогда
						ИзменениеУКД = ИзменениеУКД + СтрокаДерева.Изменение;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Документов > 0 И ВсеВБП Тогда
			КлючЗначение.Значение.Статус = НСтр("ru = 'Вся цепочка есть в БП - не выгружается'");
		ИначеЕсли ЗначениеЗаполнено(УПДвБП) Тогда
			КлючЗначение.Значение.Статус = СтрШаблон(
				НСтр("ru = 'УПД есть в БП (%1) - уйдут только новые УКД (%2), к этому поступлению'"), УПДвБП, НовыхУКД);
		КонецЕсли;
		КлючЗначение.Значение.Изменение = ИзменениеУКД;
		Если НовыхУКД > 0 Тогда
			КлючЗначение.Значение.Статус = КлючЗначение.Значение.Статус
				+ СтрШаблон(НСтр("ru = '; УКД в БП (%1): итого %2'"), НовыхУКД, ТекстЗнакаИзменения(ИзменениеУКД));
			КлючЗначение.Значение.ЧтоУйдетВБП = СтрШаблон(НСтр("ru = 'УКД цепочки в БП (%1): итого %2'"),
				НовыхУКД, ТекстЗнакаИзменения(ИзменениеУКД));
		КонецЕсли;
	КонецЦикла;

	ПроставитьИтогГрупп(Дерево.Строки);
	ЗначениеВРеквизитФормы(Дерево, "Накладные");

	// Вкладка «Действия УКД»: что уйдёт в БП по каждой УКД и итог
	ЗаполнитьДействияУКД(Показываемые, ПриходныеУПД, Данные);

	// Ищут по номеру: УКД с этим номером, которые есть в реестре УТ, но не в
	// таблице, - с причиной
	Диагностика = "";
	Если ЗначениеЗаполнено(НомерОтбор) Тогда
		Показанные = Новый Соответствие;
		Для Каждого Элемент Из Показываемые Цикл
			Если Элемент.Описание.Вид = "УКД" Тогда
				Показанные.Вставить(ВРег(СокрЛП(Элемент.Описание.Идентификатор)), Истина);
			КонецЕсли;
		КонецЦикла;
		Прочитанные = Новый Соответствие;
		Для Каждого Элемент Из Данные Цикл
			Если Элемент.Описание.Вид = "УКД" Тогда
				Прочитанные.Вставить(ВРег(СокрЛП(Элемент.Описание.Идентификатор)), Истина);
			КонецЕсли;
		КонецЦикла;
		Попытка
			Причины = РеквизитФормыВЗначение("Объект").ДиагностикаУКД(НомерУПД, ПериодС, ПериодПо,
				СтарыеУКД, БезПроверкиПодписи, Показанные, Прочитанные);
			Если Причины.Количество() > 0 Тогда
				Диагностика = " " + СтрСоединить(Причины, " ");
			КонецЕсли;
		Исключение
			Диагностика = " " + НСтр("ru = 'Проверка УКД по реестру не выполнилась: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Если ЗначениеЗаполнено(НомерОтбор) И НайденныеЦепочки.Количество() = 0 Тогда
		Информация = СтрШаблон(
			НСтр("ru = 'УПД / УКД с номером «%1» среди документов периода (%2) не найдена: расширьте период и нажмите «Показать». Не подписанные, закрытые и заменённые УПД в выгрузку не попадают.'"),
			СокрЛП(НомерУПД), Данные.Количество()) + Диагностика;
		Возврат;
	КонецЕсли;

	Информация = ?(ЗначениеЗаполнено(НомерОтбор), СтрШаблон(НСтр("ru = 'Поиск по номеру «%1»: цепочек %2. '"),
		СокрЛП(НомерУПД), НайденныеЦепочки.Количество()), "") + СтрШаблон(
		НСтр("ru = 'Документов за период: %1, в дереве: УПД %2, УКД %3 (уже выгружались %4; в БП не создадутся %5). Под УПД - строки поступления в БП; ниже блок «УКД в JSON» (файл: ПриходныеКорректировки, не в ТЧ УПД). Отметка УКД - документ УКД в цепочке. Отметьте нужные и нажмите «Выгрузить в папку».'"),
		Данные.Количество(), УПД, УКД, Выгруженных, СОшибками);

	// Почему УКД нет в дереве или они не отмечены
	ПроУКД = Новый Массив;
	Если УКДСОшибкой > 0 Тогда
		ПроУКД.Добавить(СтрШаблон(НСтр("ru = 'УКД с ошибкой не отмечены: %1 (причина - в «Проверка»)'"), УКДСОшибкой));
	КонецЕсли;
	Если СкрытоУКДВыгруженных > 0 Тогда
		ПроУКД.Добавить(СтрШаблон(НСтр("ru = 'скрыты УКД полностью выгружавшихся цепочек: %1 (снимите «Только не выгруженные»)'"), СкрытоУКДВыгруженных));
	КонецЕсли;
	Если СкрытоУКДГалочкой > 0 Тогда
		ПроУКД.Добавить(СтрШаблон(НСтр("ru = 'УКД скрыты галочкой «С УКД»: %1'"), СкрытоУКДГалочкой));
	КонецЕсли;
	Если ПроУКД.Количество() > 0 Тогда
		Информация = Информация + " " + СтрСоединить(ПроУКД, "; ") + ".";
	КонецЕсли;
	Если ЗначениеЗаполнено(АдресПриходовБП) Тогда
		Информация = Информация + " " + СтрШаблон(
			НСтр("ru = 'Сверка с БП: уже есть в БП - %1 (не отмечены и не выгружаются), УКД к поступлениям БП - %2 (уйдут со ссылкой на поступление).'"),
			ВБПВсего, УКДкПоступлениюБП);
	КонецЕсли;
	// Отбор по контрагенту, а в дереве пусто - почему
	Если ЗначениеЗаполнено(Отбор) И УПД + УКД = 0 Тогда
		ВсегоКонтрагента = 0;
		СкрытоВыгруженных = 0;
		Для Каждого Элемент Из Данные Цикл
			Если ЦепочкиКонтрагента.Получить(Элемент.Описание.КлючЦепочки) <> Неопределено Тогда
				ВсегоКонтрагента = ВсегоКонтрагента + 1;
				Если ЦепочкиСНевыгруженными.Получить(Элемент.Описание.КлючЦепочки) = Неопределено Тогда
					СкрытоВыгруженных = СкрытоВыгруженных + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Информация = Информация + Символы.ПС + ПочемуПустоПоКонтрагенту(ОтборИНН, ВсегоКонтрагента, СкрытоВыгруженных);
	КонецЕсли;
	Информация = Информация + Диагностика;

КонецПроцедуры

// Почему по отбору «Контрагент» дерево пустое: документы прочитаны, но скрыты
// «Только не выгруженные» (цепочки выгружены / есть в БП), или в выгрузке УТ
// их нет - тогда что о контрагенте в реестре УПД УТ за период.
&НаСервере
Функция ПочемуПустоПоКонтрагенту(ИНН, ВсегоКонтрагента, СкрытоВыгруженных)

	Если ВсегоКонтрагента > 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'По «%1» прочитано документов: %2; в цепочках, которые уже выгружались или есть в БП: %3 - скрыты галочкой «Только не выгруженные» (снимите её, чтобы увидеть).'"),
			СокрЛП(Контрагент), ВсегоКонтрагента, СкрытоВыгруженных);
	КонецЕсли;

	Реестр = РеквизитФормыВЗначение("Объект").РеестрКонтрагентаЗаПериод(ИНН, СокрЛП(Контрагент), ПериодС, ПериодПо);
	Если Реестр = Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'По «%1» в прочитанных документах ничего нет (реестр УПД УТ не прочитан - журнал регистрации).'"),
			СокрЛП(Контрагент));
	КонецЕсли;
	Если Реестр.Всего = 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'По «%1»%2 в реестре УПД УТ за период УПД нет - проверьте период (по дате УПД) и контрагента.'"),
			СокрЛП(Контрагент), ?(ЗначениеЗаполнено(ИНН), " (ИНН " + ИНН + ")", ""));
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'По «%1» в выгрузке УТ документов нет, а в реестре УПД УТ за период УПД: %2 (подписано %3, аннулировано %4, заменено %5, уже выгружено в БП %6). Из УТ выгружаются только подписанные, не закрытые и не заменённые УПД с товарами - подпишите или проверьте их в реестре.'"),
		СокрЛП(Контрагент), Реестр.Всего, Реестр.Подписано, Реестр.Аннулировано, Реестр.Заменено, Реестр.Выгружено);

КонецФункции

// Строки документа - под строкой документа, так, как они будут в документе
// БП (как у Далиона): строка на позицию УПД, номенклатура - «Товар <ставка>»
// (свёрнута по НДС номенклатура, не строки), количество, цена с НДС (сумма /
// количество), сумма с НДС, прямая ставка, НДС. Товар и код УПД - справочно: в
// документ БП не идут, «Код» в табличной части БП - код номенклатуры «Товар
// <ставка>» в справочнике БП. У УКД - изменяемые позиции: «после», «до» - в
// «Проверке».
//
// УКД видимой цепочки по ключу исходной УПД, по порядку в цепочке.
//
&НаСервереБезКонтекста
Функция УКДПоЦепочкам(Показываемые)

	Результат = Новый Соответствие;
	Для Каждого Элемент Из Показываемые Цикл
		Если Элемент.Вид <> "УКД" Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Элемент.Описание.КлючЦепочки;
		Список = Результат.Получить(Ключ);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Результат.Вставить(Ключ, Список);
		КонецЕсли;
		Список.Добавить(Элемент);
	КонецЦикла;

	Для Каждого КлючЗначение Из Результат Цикл
		Список = КлючЗначение.Значение;
		Если Список.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Сорт = Новый СписокЗначений;
		Для Каждого Элемент Из Список Цикл
			Сорт.Добавить(Элемент, Формат(Элемент.Описание.ПорядокВЦепочке, "ЧЦ=4; ЧВН=; ЧН=0000; ЧГ=0"));
		КонецЦикла;
		Сорт.СортироватьПоПредставлению();
		Список.Очистить();
		Для Каждого ЭлементСписка Из Сорт Цикл
			Список.Добавить(ЭлементСписка.Значение);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Справочно под строками УПД: данные УКД, как в JSON «ПриходныеКорректировки».
//
// «Подготовить к отправке»: перечитать («Показать», в фоне - как обычно), затем
// подготовка (ПодготовитьНаСервере).
&НаКлиенте
Процедура ПодготовитьКОтправке(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;
	ПодготовкаПослеЧтения = Истина;
	ПоказатьУПД(Команда);

КонецПроцедуры

// Подготовка прочитанного к отправке: корректировки по приходной Далиона
// (прошлые - заменяются), перерасчёт строк, сверка с БП, таблица и «Действия
// УКД»; цепочки, где проверка не сошлась (красные в «Действиях УКД»), - без
// отметки, к отправке - только сошедшиеся. Возвращает итог.
&НаСервере
Функция ПодготовитьНаСервере()

	Данные = Неопределено;
	Если ЗначениеЗаполнено(АдресДанных) Тогда
		Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	КонецЕсли;
	Если Данные = Неопределено Тогда
		ИнформацияПодготовки = НСтр("ru = 'Нет прочитанных документов - подготовка не выполнена (нажмите «Показать»).'");
		Возврат ИнформацияПодготовки;
	КонецЕсли;

	Обработка = ОбъектДляЧтения();

	// Прошлая подготовка - корректировки по приходной заново
	Подготовленные = Новый Массив;
	Для Каждого Элемент Из Данные Цикл
		Если ЗначениеПоля(Элемент.Описание, "ПоПриходной") <> Истина Тогда
			Подготовленные.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	ПоПриходным = Обработка.КорректировкиПоПриходным(Подготовленные);
	// Корректировка по приходной - после последнего документа своей цепочки
	Для Каждого Документ Из ПоПриходным.Документы Цикл
		Место = Подготовленные.Количество();
		Для Индекс = 0 По Подготовленные.ВГраница() Цикл
			Если Подготовленные[Индекс].Описание.КлючЦепочки = Документ.Описание.КлючЦепочки Тогда
				Место = Индекс + 1;
			КонецЕсли;
		КонецЦикла;
		Подготовленные.Вставить(Место, Документ);
	КонецЦикла;

	Пересчет = Обработка.ПересчитатьСтрокиДокументов(Подготовленные);

	ПрименитьПриходыБП(Подготовленные);
	ПоместитьВоВременноеХранилище(Подготовленные, АдресДанных);
	ЗаполнитьТаблицуБезСбоя(Подготовленные);

	// Цепочки, где проверка не сошлась, - без отметки
	Цепочки = Новый Соответствие;
	Для Каждого Элемент Из Подготовленные Цикл
		Цепочки.Вставить(ВРег(СокрЛП(Элемент.Описание.Идентификатор)), Элемент.Описание.КлючЦепочки);
	КонецЦикла;
	НеСошлись = Новый Соответствие;
	Для Каждого СтрокаДействия Из ДействияУКД Цикл
		Если НЕ СтрокаДействия.Проверено И ЗначениеЗаполнено(СтрокаДействия.Идентификатор) Тогда
			Ключ = Цепочки.Получить(ВРег(СокрЛП(СтрокаДействия.Идентификатор)));
			Если Ключ <> Неопределено Тогда
				НеСошлись.Вставить(Ключ, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	// Из УТ уходит всё - отметки не снимаются, замечания решает БП (15.10.2026)
	Дерево = РеквизитФормыВЗначение("Накладные");

	КОтправке = 0;
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		Если СтрокаДерева.Уровень = 1 И СтрокаДерева.Отметка Тогда
			КОтправке = КОтправке + 1;
		КонецЕсли;
		Для Каждого Подчиненная Из СтрокаДерева.Строки Цикл
			Если Подчиненная.Уровень = 1 И Подчиненная.Отметка Тогда
				КОтправке = КОтправке + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ИнформацияПодготовки = СтрШаблон(
		НСтр("ru = 'Подготовлено: корректировок по приходной Далиона - %1; пересчитано цен - %2, НДС - %3; цепочек с замечаниями (уйдут, решит БП) - %4; документов к отправке - %5. Отправка - «Выгрузить в папку».'"),
		ПоПриходным.Документы.Количество(), Пересчет.Цен, Пересчет.НДС, НеСошлись.Количество(), КОтправке)
		+ ?(ПоПриходным.Пояснения.Количество() = 0, "", Символы.ПС + СтрСоединить(ПоПриходным.Пояснения, Символы.ПС));

	Возврат ИнформацияПодготовки;

КонецФункции

// Снять отметку у строк дерева цепочек из НеСошлись (группа и документы).
&НаСервере
Процедура СнятьОтметкиЦепочек(Строки, НеСошлись)

	Для Каждого СтрокаДерева Из Строки Цикл
		Если ЗначениеЗаполнено(СтрокаДерева.КлючЦепочки) И НеСошлись.Получить(СтрокаДерева.КлючЦепочки) <> Неопределено Тогда
			СтрокаДерева.Отметка = Ложь;
		КонецЕсли;
		Если СтрокаДерева.Уровень = 0 Тогда
			СнятьОтметкиЦепочек(СтрокаДерева.Строки, НеСошлись);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Вкладка «Действия УКД»: одна строка - одна УКД, которой ещё нет в БП (из
// показанных в «Что выгружаем»): действие, сумма «до», знак, на сколько,
// итоговая сумма («после»), приходная Далиона цепочки; последняя строка -
// итого. Проверка (иначе строка красная): УКД собрана без ошибок; знак - как
// требует приходная: УПД с УКД (сумма УПД + изменения всех УКД цепочки)
// меньше приходной - нужно уменьшение, больше - увеличение; изменение цепочки
// (сумма изменений всех её УКД, что уходят) - как в реестре УТ («Сумма с УКД»
// минус «Сумма УПД», колонка «По реестру УТ»): иначе в БП уйдёт не то
// (например, УПД 5000, УКД −1000, а в БП 6000 - знак перевёрнут).
&НаСервере
Процедура ЗаполнитьДействияУКД(Показываемые, ПриходныеУПД, Данные)

	ДействияУКД.Очистить();

	// Итог цепочки: сумма УПД и изменения всех её УКД - по всем прочитанным
	// документам (отборы таблицы на сверку не влияют)
	СуммыУПД = Новый Соответствие;
	ИзмененияЦепочек = Новый Соответствие;
	// Только УКД из СБИС (без корректировок по приходной) - для сверки с реестром
	ИзмененияЭДО = Новый Соответствие;
	Для Каждого Элемент Из Данные Цикл
		Описание = Элемент.Описание;
		Если Описание.Вид = "УПД" Тогда
			СуммыУПД.Вставить(Описание.КлючЦепочки, Описание.Сумма);
		Иначе
			Было = ИзмененияЦепочек.Получить(Описание.КлючЦепочки);
			ИзмененияЦепочек.Вставить(Описание.КлючЦепочки,
				?(Было = Неопределено, 0, Было) + Описание.Сумма - Описание.СуммаДо);
			Если ЗначениеПоля(Описание, "ПоПриходной") <> Истина Тогда
				Было = ИзмененияЭДО.Получить(Описание.КлючЦепочки);
				ИзмененияЭДО.Вставить(Описание.КлючЦепочки,
					?(Было = Неопределено, 0, Было) + Описание.Сумма - Описание.СуммаДо);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Ссылки = Новый Массив;
	Для Каждого КлючЗначение Из ПриходныеУПД Цикл
		Если ЗначениеЗаполнено(КлючЗначение.Значение) И Ссылки.Найти(КлючЗначение.Значение) = Неопределено Тогда
			Ссылки.Добавить(КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	СуммыПриходных = СуммыПриходныхДалиона(Ссылки);

	// Изменение цепочки по реестру УТ («Сумма с УКД» - «Сумма УПД»)
	ИдентификаторыУПД = Новый Массив;
	Для Каждого КлючЗначение Из ИзмененияЦепочек Цикл
		Если НЕ СтрНачинаетсяС(КлючЗначение.Ключ, "СТАР|") Тогда
			ИдентификаторыУПД.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Реестр = РеквизитФормыВЗначение("Объект").СуммыРеестраУПД(ИдентификаторыУПД);
	ЦепочкиВИтоге = Новый Соответствие;
	ИтогоПоРеестру = 0;

	ИтогоДо = 0;
	ИтогоИзменение = 0;
	ИтогоПосле = 0;
	ВсеВерны = Истина;
	Для Каждого Элемент Из Показываемые Цикл

		Описание = Элемент.Описание;
		Если Описание.Вид <> "УКД" ИЛИ ЕстьВБП(Описание) ИЛИ ВнеФайлаБП(Описание) Тогда
			Продолжить;
		КонецЕсли;

		Изменение = Описание.Сумма - Описание.СуммаДо;
		СтрокаДействия = ДействияУКД.Добавить();
		СтрокаДействия.Действие = СтрШаблон(НСтр("ru = '%1 · УКД № %2 · УПД № %3'"),
			?(Изменение < 0, НСтр("ru = 'Уменьшение'"), ?(Изменение > 0, НСтр("ru = 'Увеличение'"), НСтр("ru = 'Сумма не меняется'"))),
			СокрЛП(Описание.Номер), НомерИзЦепочки(Описание.Цепочка));
		СтрокаДействия.Сумма = Описание.СуммаДо;
		СтрокаДействия.Знак = ?(Изменение < 0, "−", ?(Изменение > 0, "+", ""));
		СтрокаДействия.НаСколько = Макс(Изменение, -Изменение);
		СтрокаДействия.ИтоговаяСумма = Описание.Сумма;
		СтрокаДействия.Идентификатор = Описание.Идентификатор;

		// Корректировки у нас только уменьшают: увеличение - не так
		Верно = НЕ Описание.Ошибка И Изменение < 0.01;
		Приходная = ПриходныеУПД.Получить(Описание.КлючЦепочки);
		СуммаПриходной = ?(Приходная = Неопределено, Неопределено, СуммыПриходных.Получить(Приходная));
		СуммаУПД = СуммыУПД.Получить(Описание.КлючЦепочки);
		Если СуммаПриходной <> Неопределено Тогда
			СтрокаДействия.Приходная = СуммаПриходной;
			Если СуммаУПД <> Неопределено Тогда
				Нужно = СуммаУПД + ИзмененияЦепочек.Получить(Описание.КлючЦепочки) - СуммаПриходной;
				Если Нужно <= -0.01 И Изменение > 0 ИЛИ Нужно >= 0.01 И Изменение < 0 Тогда
					Верно = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		// Изменение цепочки - как в реестре УТ
		ПоРеестру = Реестр.Получить(Описание.КлючЦепочки);
		Если ПоРеестру <> Неопределено И ПоРеестру.ЕстьУКД И ПоРеестру.СуммаСУчетомУКД <> 0 Тогда
			ОжидаетсяИзменение = ПоРеестру.СуммаСУчетомУКД - ПоРеестру.СуммаУПД;
			СтрокаДействия.ПоРеестру = ОжидаетсяИзменение;
			ИзменениеЦепочки = ИзмененияЭДО.Получить(Описание.КлючЦепочки);
			ИзменениеЦепочки = ?(ИзменениеЦепочки = Неопределено, 0, ИзменениеЦепочки);
			Если Макс(ИзменениеЦепочки - ОжидаетсяИзменение, ОжидаетсяИзменение - ИзменениеЦепочки) >= 0.01 Тогда
				Верно = Ложь;
			КонецЕсли;
			Если ЦепочкиВИтоге.Получить(Описание.КлючЦепочки) = Неопределено Тогда
				ЦепочкиВИтоге.Вставить(Описание.КлючЦепочки, Истина);
				ИтогоПоРеестру = ИтогоПоРеестру + ОжидаетсяИзменение;
			КонецЕсли;
		КонецЕсли;
		СтрокаДействия.Проверено = Верно;
		СтрокаДействия.Итог = ?(Верно, 0, 2);
		ВсеВерны = ВсеВерны И Верно;

		ИтогоДо = ИтогоДо + Описание.СуммаДо;
		ИтогоИзменение = ИтогоИзменение + Изменение;
		ИтогоПосле = ИтогоПосле + Описание.Сумма;

	КонецЦикла;

	Если ДействияУКД.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Итого = ДействияУКД.Добавить();
	Итого.Действие = СтрШаблон(НСтр("ru = 'Итого УКД: %1'"), ДействияУКД.Количество() - 1);
	Итого.Сумма = ИтогоДо;
	Итого.Знак = ?(ИтогоИзменение < 0, "−", ?(ИтогоИзменение > 0, "+", ""));
	Итого.НаСколько = Макс(ИтогоИзменение, -ИтогоИзменение);
	Итого.ИтоговаяСумма = ИтогоПосле;
	Итого.ПоРеестру = ИтогоПоРеестру;
	Итого.Проверено = ВсеВерны;
	Итого.Итог = ?(ВсеВерны, 3, 2);

КонецПроцедуры

&НаСервере
Процедура ДобавитьБлокУКДПодУПД(СтрокаУПД, УКДЦепочки)

	Если УКДЦепочки = Неопределено ИЛИ УКДЦепочки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СтрокаЗаголовка = СтрокаУПД.Строки.Добавить();
	СтрокаЗаголовка.Уровень = 2;
	СтрокаЗаголовка.Цепочка = СтрокаУПД.Цепочка;
	СтрокаЗаголовка.Вид = НСтр("ru = 'УКД в JSON'");
	СтрокаЗаголовка.Номер = НСтр("ru = 'ПриходныеКорректировки (не в ТЧ УПД)'");
	СтрокаЗаголовка.Статус = НСтр("ru = 'В том же файле, отдельный массив; отметка и выгрузка — документы «УКД» в цепочке ниже'");

	Для Каждого Элемент Из УКДЦепочки Цикл

		Описание = Элемент.Описание;
		СтрокаУКД = СтрокаУПД.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаУКД, Описание);
		СтрокаУКД.Уровень = 2;
		СтрокаУКД.Цепочка = СтрокаУПД.Цепочка;
		СтрокаУКД.Вид = НСтр("ru = 'УКД (данные файла)'");
		СтрокаУКД.Номер = СтрШаблон(НСтр("ru = '№ %1'"), СокрЛП(Описание.Номер));
		СтрокаУКД.Отметка = Ложь;
		Если Описание.Ошибка Тогда
			СтрокаУКД.Статус = НСтр("ru = 'Не выгрузится: '") + КраткаяПричинаУТ(Описание.Проверка);
		Иначе
			СтрокаУКД.Статус = ?(Описание.Выгружена,
				НСтр("ru = 'Уже выгружалась'"), НСтр("ru = 'Пойдёт в ПриходныеКорректировки'"));
		КонецЕсли;
		СтрокаУКД.Итог = ИтогОписания(Описание);
		Если НЕ ЗначениеЗаполнено(СтрокаУКД.ДокументУТ) Тогда
			СтрокаУКД.ДокументУТ = СтрокаУПД.ДокументУТ;
		КонецЕсли;

		ДобавитьСтрокиДокумента(СтрокаУКД, Элемент, 3);

	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокиДокумента(СтрокаДокумента, Элемент, УровеньСтроки = 2)

	ТабличныеЧасти = Неопределено;
	Если ТипЗнч(Элемент.Данные) = Тип("Структура") Тогда
		Элемент.Данные.Свойство("ТабличныеЧасти", ТабличныеЧасти);
	КонецЕсли;
	Товары = Неопределено;
	Если ТипЗнч(ТабличныеЧасти) = Тип("Структура") Тогда
		ТабличныеЧасти.Свойство("Товары", Товары);
	КонецЕсли;
	Если ТипЗнч(Товары) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	ЭтоУКД = (Элемент.Вид = "УКД");
	Обработка = РеквизитФормыВЗначение("Объект");

	// Позиции: у УПД - состав строк ставок (строка ставки без состава - сама),
	// у УКД - строки файла
	Позиции = Новый Массив;
	Для Каждого СтрокаТовара Из Товары Цикл
		Состав = ЗначениеПоля(СтрокаТовара, "Состав");
		Если НЕ ЭтоУКД И ТипЗнч(Состав) = Тип("Массив") И Состав.Количество() > 0 Тогда
			Для Каждого Позиция Из Состав Цикл
				Позиции.Добавить(Новый Структура("Строка, СтавкаНДС", Позиция,
					ЗначениеПоля(СтрокаТовара, "СтавкаНДС")));
			КонецЦикла;
		Иначе
			Позиции.Добавить(Новый Структура("Строка, СтавкаНДС", СтрокаТовара,
				ЗначениеПоля(СтрокаТовара, "СтавкаНДС")));
		КонецЕсли;
	КонецЦикла;

	НомерСтроки = 0;
	Для Каждого Позиция Из Позиции Цикл

		СтрокаТовара = Позиция.Строка;
		Ставка = ЗначениеПоля(СтрокаТовара, "СтавкаНДС");
		Если НЕ ЗначениеЗаполнено(Ставка) Тогда
			Ставка = Позиция.СтавкаНДС;
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;
		СтрокаДерева = СтрокаДокумента.Строки.Добавить();
		СтрокаДерева.Уровень = УровеньСтроки;
		СтрокаДерева.Цепочка = СтрокаДокумента.Цепочка;
		СтрокаДерева.Вид = НСтр("ru = 'строка'");
		СтрокаДерева.НомерСтроки = НомерСтроки;
		СтрокаДерева.НоменклатураБП = Обработка.НоменклатураБП(Ставка);
		СтрокаДерева.ТоварУПД = ЗначениеПоля(ЗначениеПоля(СтрокаТовара, "Номенклатура"), "Представление");
		Если НЕ ЗначениеЗаполнено(СтрокаДерева.ТоварУПД) Тогда
			СтрокаДерева.ТоварУПД = ЗначениеПоля(СтрокаТовара, "Наименование");
		КонецЕсли;
		СтрокаДерева.КодТовара = ЗначениеПоля(СтрокаТовара, "КодНоменклатуры");
		СтрокаДерева.ЕдИзм = ЗначениеПоля(СтрокаТовара, "ЕдиницаИзмерения");
		СтрокаДерева.Номер = ?(ЭтоУКД, СтрШаблон(НСтр("ru = 'поз. %1'"), ЗначениеПоля(СтрокаТовара, "НомерПозиции")),
			Формат(НомерСтроки, "ЧГ=0"));
		СтрокаДерева.Ставки = Обработка.ПрямаяСтавкаДляБП(Ставка);
		СтрокаДерева.Количество = ЧислоПоля(СтрокаТовара, "Количество");
		СтрокаДерева.Сумма = ЧислоПоля(СтрокаТовара, "Сумма");
		СтрокаДерева.СуммаНДС = ЧислоПоля(СтрокаТовара, "СуммаНДС");
		// Цена с НДС - как в документе БП: сумма / количество
		СтрокаДерева.Цена = ?(СтрокаДерева.Количество = 0, 0, Окр(СтрокаДерева.Сумма / СтрокаДерева.Количество, 2));
		СтрокаДерева.Строк = 1;

		Замечания = Новый Массив;
		Если СтрокаДерева.Количество <> Окр(СтрокаДерева.Количество, 3) Тогда
			Замечания.Добавить(НСтр("ru = 'количество больше 3 знаков после запятой - в БП округлится'"));
		КонецЕсли;
		Если СтрокаДерева.Количество <> 0
			И Окр(СтрокаДерева.Цена * Окр(СтрокаДерева.Количество, 3), 2) <> СтрокаДерева.Сумма Тогда
			Замечания.Добавить(СтрШаблон(НСтр("ru = 'цена × кол-во = %1, сумма %2: в БП сумма - как в УПД (пересчитается, если строку править вручную)'"),
				Формат(Окр(СтрокаДерева.Цена * Окр(СтрокаДерева.Количество, 3), 2), "ЧДЦ=2; ЧН=0,00"),
				Формат(СтрокаДерева.Сумма, "ЧДЦ=2; ЧН=0,00")));
		КонецЕсли;
		Если СтрНайти(Ставка, "/") > 0 Тогда
			Замечания.Добавить(СтрШаблон(НСтр("ru = 'в УПД расчётная ставка %1 - в БП прямая'"), Ставка));
		КонецЕсли;

		Если ЭтоУКД Тогда
			СтрокаДерева.СуммаДо = ЧислоПоля(СтрокаТовара, "СуммаДо");
			СтрокаДерева.СуммаНДСДо = ЧислоПоля(СтрокаТовара, "СуммаНДСДо");
			// Изменение строки со знаком и что меняется (цена / количество) - в БП уйдёт оно
			СтрокаДерева.Изменение = СтрокаДерева.Сумма - СтрокаДерева.СуммаДо;
			СтрокаДерева.ЧтоУйдетВБП = Обработка.ТекстИзмененияСтроки(СтрокаТовара);
			Замечания.Вставить(0, СтрокаДерева.ЧтоУйдетВБП + "; " + СтрШаблон(НСтр("ru = 'было: %1 × %2 = %3 (НДС %4, %5) - стало: %6 × %7 = %8 (НДС %9, %10)'"),
				ЧислоПоля(СтрокаТовара, "КоличествоДо"), ЧислоПоля(СтрокаТовара, "ЦенаДо"), ЧислоПоля(СтрокаТовара, "СуммаДо"),
				ЧислоПоля(СтрокаТовара, "СуммаНДСДо"), Обработка.ПрямаяСтавкаДляБП(ЗначениеПоля(СтрокаТовара, "СтавкаНДСДо")),
				СтрокаДерева.Количество, СтрокаДерева.Цена, СтрокаДерева.Сумма, СтрокаДерева.СуммаНДС, СтрокаДерева.Ставки));
		КонецЕсли;

		// У УКД первое - «было - стало» (справка), остальное - проверить
		СтрокаДерева.Итог = ?(Замечания.Количество() > ?(ЭтоУКД, 1, 0), 1, 0);
		СтрокаДерева.Проверка = СтрСоединить(Замечания, "; ");

	КонецЦикла;

КонецПроцедуры

// Двойной щелчок - документ УТ строки (приходная Далиона); у строки товара и
// группы цепочки - документа выше по дереву.
&НаКлиенте
Процедура НакладныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ДанныеСтроки = Накладные.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Пока ДанныеСтроки <> Неопределено И НЕ ЗначениеЗаполнено(ДанныеСтроки.ДокументУТ) Цикл
		ДанныеСтроки = ДанныеСтроки.ПолучитьРодителя();
	КонецЦикла;
	Если ДанныеСтроки <> Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, ДанныеСтроки.ДокументУТ);
	КонецЕсли;

КонецПроцедуры

// Соответствие ВРег(ид УПД) -> приходная Далиона (Документ.ЭАрМ_ПриходнаяНакладная).
&НаСервереБезКонтекста
Функция ПриходныеПоУПД(Данные)

	Результат = Новый Соответствие;
	Идентификаторы = Новый Массив;
	Для Каждого Элемент Из Данные Цикл
		Идентификатор = ИдентификаторУПДЭлемента(Элемент);
		Если ЗначениеЗаполнено(Идентификатор) И Идентификаторы.Найти(Идентификатор) = Неопределено Тогда
			Идентификаторы.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Возврат ПриходныеПоИдентификаторам(Идентификаторы);

КонецФункции

// Соответствие ВРег(ид УПД) -> приходная Далиона по списку идентификаторов УПД.
&НаСервереБезКонтекста
Функция ПриходныеПоИдентификаторам(Идентификаторы)

	Результат = Новый Соответствие;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Ссылка,
		|	Док.ИдентификаторУПД КАК ИдентификаторУПД
		|ИЗ
		|	Документ.ЭАрМ_ПриходнаяНакладная КАК Док
		|ГДЕ
		|	Док.ИдентификаторУПД В (&Идентификаторы)
		|	И НЕ Док.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Док.Дата");
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Результат;
	КонецПопытки;
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(ВРег(СокрЛП(Выборка.ИдентификаторУПД)), Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Приходные Далиона по входящему номеру поступления БП, когда пары в УТ нет
// (бумажная УПД, УПД не загружена из СБИС): тот же ИНН поставщика, номер «как
// читает человек» (ЭАрМ_Служебный.НомерДляСравнения) совпал с номером УПД,
// входящим номером или номером приходной; ближайшая по дате к поступлению (не
// дальше 60 дней). Соответствие ВРег(УИД поступления) -> приходная.
&НаСервереБезКонтекста
Функция ПриходныеПоВходящимНомерам(Поступления)

	Результат = Новый Соответствие;
	ИННы = Новый Массив;
	Искомые = Новый Массив;
	ДатаС = '39991231';
	ДатаПо = '00010101';
	Для Каждого Поступление Из Поступления Цикл
		Если ЗначениеЗаполнено(Поступление.ИдентификаторУТ) ИЛИ НЕ ЗначениеЗаполнено(Поступление.КонтрагентИНН)
			ИЛИ НЕ ЗначениеЗаполнено(Поступление.ВходящийНомер) Тогда
			Продолжить;
		КонецЕсли;
		Если ИННы.Найти(Поступление.КонтрагентИНН) = Неопределено Тогда
			ИННы.Добавить(Поступление.КонтрагентИНН);
		КонецЕсли;
		Дата = ?(ЗначениеЗаполнено(Поступление.ВходящаяДата), Поступление.ВходящаяДата, Поступление.Дата);
		Искомые.Добавить(Новый Структура("УИД, ИНН, Номер, Дата", Поступление.УИД, СокрЛП(Поступление.КонтрагентИНН),
			ЭАрМ_Служебный.НомерДляСравнения(Поступление.ВходящийНомер), Дата));
		Если ЗначениеЗаполнено(Дата) Тогда
			ДатаС = Мин(ДатаС, Дата);
			ДатаПо = Макс(ДатаПо, Дата);
		КонецЕсли;
	КонецЦикла;
	Если Искомые.Количество() = 0 ИЛИ ДатаС > ДатаПо Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Ссылка,
		|	Док.ИННПоставщика КАК ИНН,
		|	Док.Дата КАК Дата,
		|	Док.НомерУПД КАК НомерУПД,
		|	Док.ВходящийНомер КАК ВходящийНомер,
		|	Док.НомерПриходной КАК НомерПриходной
		|ИЗ
		|	Документ.ЭАрМ_ПриходнаяНакладная КАК Док
		|ГДЕ
		|	Док.ИННПоставщика В (&ИНН)
		|	И Док.Дата МЕЖДУ &ДатаС И &ДатаПо
		|	И НЕ Док.ПометкаУдаления");
	Запрос.УстановитьПараметр("ИНН", ИННы);
	Запрос.УстановитьПараметр("ДатаС", НачалоДня(ДатаС) - 60 * 86400);
	Запрос.УстановитьПараметр("ДатаПо", КонецДня(ДатаПо) + 60 * 86400);
	Попытка
		Таблица = Запрос.Выполнить().Выгрузить();
	Исключение
		Возврат Результат;
	КонецПопытки;

	Для Каждого Искомое Из Искомые Цикл
		Лучшая = Неопределено;
		ЛучшиеДни = 0;
		Для Каждого Приходная Из Таблица Цикл
			Если СокрЛП(Приходная.ИНН) <> Искомое.ИНН Тогда
				Продолжить;
			КонецЕсли;
			Если ЭАрМ_Служебный.НомерДляСравнения(Приходная.НомерУПД) <> Искомое.Номер
				И ЭАрМ_Служебный.НомерДляСравнения(Приходная.ВходящийНомер) <> Искомое.Номер
				И ЭАрМ_Служебный.НомерДляСравнения(Приходная.НомерПриходной) <> Искомое.Номер Тогда
				Продолжить;
			КонецЕсли;
			Дней = ?(ЗначениеЗаполнено(Искомое.Дата), (НачалоДня(Приходная.Дата) - НачалоДня(Искомое.Дата)) / 86400, 0);
			Дней = ?(Дней < 0, -Дней, Дней);
			Если Дней > 60 Тогда
				Продолжить;
			КонецЕсли;
			Если Лучшая = Неопределено ИЛИ Дней < ЛучшиеДни Тогда
				Лучшая = Приходная.Ссылка;
				ЛучшиеДни = Дней;
			КонецЕсли;
		КонецЦикла;
		Если Лучшая <> Неопределено Тогда
			Результат.Вставить(ВРег(Искомое.УИД), Лучшая);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ид исходной УПД документа таблицы (у УПД - свой, у УКД - её УПД).
