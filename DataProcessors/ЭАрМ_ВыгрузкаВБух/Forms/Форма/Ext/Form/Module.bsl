	Для Каждого Узел Из СвязиПриходовБП.ПолучитьЭлементы() Цикл
		Элементы.СвязиПриходовБП.Свернуть(Узел.ПолучитьИдентификатор());
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПриходыБПВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ДанныеСтроки = ПриходыБП.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;

	Если Поле = Элементы.ПриходыБПДокументУТ И ЗначениеЗаполнено(ДанныеСтроки.ДокументУТ) Тогда
		ПоказатьЗначение(, ДанныеСтроки.ДокументУТ);
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.НомерУТ) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'У этого документа БП нет пары в УТ - в дереве «Что выгружаем» его нет.'"));
		Возврат;
	КонецЕсли;

	НомерУПД = ДанныеСтроки.НомерУТ;
	Если ЗначениеЗаполнено(АдресДанных) Тогда
		ЗаполнитьТаблицуНаСервере();
		РазвернутьДерево();
	КонецЕсли;
	Элементы.СтраницыВыгрузки.ТекущаяСтраница = Элементы.СтраницаЧтоВыгружаем;

