// Номер исходной УПД из представления цепочки «УПД № <номер> от <дата>».
//
&НаСервереБезКонтекста
Функция НомерИзЦепочки(Цепочка)

	Начало = СтрНайти(Цепочка, "№ ");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = Начало + 2;
	Конец = СтрНайти(Цепочка, " от ", НаправлениеПоиска.СНачала, Начало);

	Возврат ?(Конец = 0, Сред(Цепочка, Начало), Сред(Цепочка, Начало, Конец - Начало));

