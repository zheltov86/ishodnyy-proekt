// Сумма для текста: «1 234,50» (как ФорматСуммы модуля объекта - форма его не видит).
// Изменение суммы со знаком: «− уменьшение на 124,08» / «+ увеличение на
// 10,00» / «сумма не меняется» (как ТекстЗнакаИзменения объекта).
&НаКлиентеНаСервереБезКонтекста
Функция ТекстЗнакаИзменения(Изменение)

	Если Изменение < 0 Тогда
		Возврат НСтр("ru = '− уменьшение на '") + ФорматСуммы(-Изменение);
	ИначеЕсли Изменение > 0 Тогда
		Возврат НСтр("ru = '+ увеличение на '") + ФорматСуммы(Изменение);
	КонецЕсли;

	Возврат НСтр("ru = 'сумма не меняется'");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФорматСуммы(Сумма)

	Возврат Формат(Сумма, "ЧДЦ=2; ЧН=0,00");

КонецФункции

// Суммы приходных Далиона: Соответствие ссылка -> СуммаДокумента.
&НаСервереБезКонтекста
Функция СуммыПриходныхДалиона(Приходные)

	Результат = Новый Соответствие;
	Если Приходные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Ссылка,
		|	Док.СуммаДокумента КАК СуммаДокумента
		|ИЗ
		|	Документ.ЭАрМ_ПриходнаяНакладная КАК Док
		|ГДЕ
		|	Док.Ссылка В (&Приходные)");
	Запрос.УстановитьПараметр("Приходные", Приходные);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Выборка.СуммаДокумента);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ТолькоПроблемыСвязейПриИзменении(Элемент)

	ВывестиСвязиПриходов();

КонецПроцедуры

&НаКлиенте
Процедура СвязиПриходовБПВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ДанныеСтроки = СвязиПриходовБП.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;

	Если ЗначениеЗаполнено(ДанныеСтроки.Ссылка) Тогда
		ПоказатьЗначение(, ДанныеСтроки.Ссылка);
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.НомерУТ) Тогда
		Если ДанныеСтроки.ПолучитьЭлементы().Количество() > 0 Тогда
			Если Элементы.СвязиПриходовБП.Развернут(ВыбраннаяСтрока) Тогда
				Элементы.СвязиПриходовБП.Свернуть(ВыбраннаяСтрока);
			Иначе
				Элементы.СвязиПриходовБП.Развернуть(ВыбраннаяСтрока);
			КонецЕсли;
		Иначе
			ПоказатьПредупреждение(, НСтр("ru = 'У этого документа нет пары в УТ - открыть нечего.'"));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	НомерУПД = ДанныеСтроки.НомерУТ;
	Если ЗначениеЗаполнено(АдресДанных) Тогда
		ЗаполнитьТаблицуНаСервере();
		РазвернутьДерево();
	КонецЕсли;
	Элементы.СтраницыВыгрузки.ТекущаяСтраница = Элементы.СтраницаЧтоВыгружаем;

КонецПроцедуры

&НаКлиенте
Процедура СвязиРазвернутьВсе(Команда)

	Для Каждого Узел Из СвязиПриходовБП.ПолучитьЭлементы() Цикл
		Элементы.СвязиПриходовБП.Развернуть(Узел.ПолучитьИдентификатор(), Истина);
	КонецЦикла;

КонецПроцедуры

