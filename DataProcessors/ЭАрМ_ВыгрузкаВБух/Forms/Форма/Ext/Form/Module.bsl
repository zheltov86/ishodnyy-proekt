	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);

КонецФункции

&НаСервере
Функция ВыгрузитьНаСервере()

	Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	Если Данные = Неопределено Тогда
		Возврат НСтр("ru = 'Данные устарели - нажмите «Показать» и повторите.'");
	КонецЕсли;

	Дерево = РеквизитФормыВЗначение("Накладные");

	Отмеченные = Новый Соответствие;
	Для Каждого СтрокаДерева Из Дерево.Строки.НайтиСтроки(Новый Структура("Уровень, Отметка", 1, Истина), Истина) Цикл
		Отмеченные.Вставить(СтрокаДерева.Идентификатор, Истина);
	КонецЦикла;

	ДобавленоДляЦепочки = 0;
	// Отбор по контрагентам: выгружаются только их цепочки, даже если отмечено другое
	ЦепочкиОтмеченных = ЦепочкиОтмеченныхКонтрагентов(Данные);
	ВнеОтбора = 0;

	// Без проверки подписи - ровно отмеченные УПД и УКД.
	// Иначе цепочка целиком: отмечен хоть один документ - уходят УПД и УКД
	// этой цепочки. Подпись УКД выгрузку не блокирует. «С УКД» снята - не
	// добавляем скрытые УКД, но уже отмеченные в таблице не снимаем.
	Если НЕ БезПроверкиПодписи Тогда
		ОтмеченныеЦепочки = Новый Соответствие;
		Для Каждого Элемент Из Данные Цикл
			Если Отмеченные.Получить(Элемент.Идентификатор) <> Неопределено
				И ЗначениеЗаполнено(Элемент.Описание.КлючЦепочки) Тогда
				ОтмеченныеЦепочки.Вставить(Элемент.Описание.КлючЦепочки, Истина);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Элемент Из Данные Цикл
			Если ОтмеченныеЦепочки.Получить(Элемент.Описание.КлючЦепочки) = Неопределено
				ИЛИ ЦепочкиОтмеченных <> Неопределено И ЦепочкиОтмеченных.Получить(Элемент.Описание.КлючЦепочки) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Элемент.Вид = "УКД" И НЕ СУКД
				И Отмеченные.Получить(Элемент.Идентификатор) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			// Из УТ уходит всё (и звенья с замечаниями, и «есть в БП») - проверяет
			// и решает БП при создании (15.10.2026)
			Если Отмеченные.Получить(Элемент.Идентификатор) = Неопределено Тогда
				Отмеченные.Вставить(Элемент.Идентификатор, Истина);
				ДобавленоДляЦепочки = ДобавленоДляЦепочки + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// В файл - по порядку цепочек (данные уже упорядочены: УПД, затем УКД)
	НакладныеКВыгрузке = Новый Массив;
	КорректировкиКВыгрузке = Новый Массив;
	ПропущеноВБП = 0;
	СоСсылкойНаПоступление = 0;
	Для Каждого Элемент Из Данные Цикл
		Если Отмеченные.Получить(Элемент.Идентификатор) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Не собранная УКД (ошибка при чтении) - данных для файла нет
		Если Элемент.Данные = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// «Без УПД» - УПД цепочки в файл не идут, даже если цепочка их подтянула
		Если ТолькоУКД И Элемент.Вид = "УПД" Тогда
			Продолжить;
		КонецЕсли;
		Если ЦепочкиОтмеченных <> Неопределено И ЦепочкиОтмеченных.Получить(Элемент.Описание.КлючЦепочки) = Неопределено Тогда
			ВнеОтбора = ВнеОтбора + 1;
			Продолжить;
		КонецЕсли;
		// Уже есть в БП по файлу поступлений - уходит тоже: БП второй раз не создаст
		Если ЕстьВБП(Элемент.Описание) Тогда
			ПропущеноВБП = ПропущеноВБП + 1;
		КонецЕсли;
		Если Элемент.Вид = "УКД" И ЗначениеЗаполнено(ЗначениеПоля(Элемент.Описание, "ПоступлениеБП")) Тогда
			СоСсылкойНаПоступление = СоСсылкойНаПоступление + 1;
		КонецЕсли;
		Если Элемент.Вид = "УКД" Тогда
			КорректировкиКВыгрузке.Добавить(Элемент.Данные);
		Иначе
			НакладныеКВыгрузке.Добавить(Элемент.Данные);
		КонецЕсли;
	КонецЦикла;

	Если НакладныеКВыгрузке.Количество() + КорректировкиКВыгрузке.Количество() = 0 И ПропущеноВБП > 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'Выгружать нечего: все отмеченные документы (%1) уже есть в БП по сверке с файлом поступлений.'"),
			ПропущеноВБП);
	КонецЕсли;

	ТекстСверки = "";
	Если ВнеОтбора > 0 Тогда
		ТекстСверки = Символы.ПС + СтрШаблон(НСтр("ru = 'Не выгружено - другие контрагенты (отбор по контрагентам): %1.'"), ВнеОтбора);
	КонецЕсли;
	Если ПропущеноВБП > 0 ИЛИ СоСсылкойНаПоступление > 0 Тогда
		ТекстСверки = ТекстСверки + Символы.ПС + СтрШаблон(
			НСтр("ru = 'Сверка с БП: по файлу уже есть в БП - %1 (ушли тоже, БП второй раз не создаст); УКД со ссылкой на поступление БП - %2.'"),
			ПропущеноВБП, СоСсылкойНаПоступление);
	КонецЕсли;

	Результат = ОбъектДляЧтения().ВыгрузитьВПапку(Папка,
		НакладныеКВыгрузке, КорректировкиКВыгрузке, ПериодС, ПериодПо);

	Если НЕ Результат.Успех Тогда
		Возврат Результат.Ошибка;
	КонецЕсли;

	СохранитьНастройку("Папка", СокрЛП(Папка));

	// Выгруженные - в данных и в дереве: при повторном показе видно, что ушло
	Выгружены = Новый Соответствие;
	Для Каждого Идентификатор Из Результат.Выгружены Цикл
		Выгружены.Вставить(Идентификатор, Истина);
	КонецЦикла;
	Для Каждого Элемент Из Данные Цикл
		Если Выгружены.Получить(Элемент.Идентификатор) <> Неопределено Тогда
			Элемент.Описание.Выгружена = Истина;
		КонецЕсли;
	КонецЦикла;
	ПоместитьВоВременноеХранилище(Данные, АдресДанных);

	Для Каждого СтрокаДерева Из Дерево.Строки.НайтиСтроки(Новый Структура("Уровень", 1), Истина) Цикл
		Если Выгружены.Получить(СтрокаДерева.Идентификатор) <> Неопределено Тогда
			СтрокаДерева.Выгружена = Истина;
			СтрокаДерева.Отметка = Ложь;
			СтрокаДерева.Статус = СтрШаблон(НСтр("ru = 'Выгружена: %1'"), Результат.ИмяФайла);
			Если СтрокаДерева.Итог = 0 Тогда
				СтрокаДерева.Итог = 3;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ЗначениеВРеквизитФормы(Дерево, "Накладные");

	Если БезПроверкиПодписи Тогда
		Возврат СтрШаблон(
			НСтр("ru = 'Выгружено УПД: %1, УКД: %2, строк: %3. Без проверки подписи: ушли только отмеченные в таблице УПД и УКД.
			|Файл: %4
			|Дальше - в БП: обработка «Приходные накладные из УТ» (ВыгрузкаБух), папка %5, «Прочитать» и «Создать» (сначала поступления, затем корректировки).'"),
			Результат.Накладных, Результат.Корректировок, Результат.Строк, Результат.ПутьКФайлу, Папка) + ТекстСверки
			+ ТекстЗамечанийУКД(Результат);
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = 'Выгружено УПД: %1, УКД: %2, строк: %3. Цепочки - целиком: добавлено к отмеченным (УПД и УКД тех же цепочек): %6.
		|Файл: %4
		|Дальше - в БП: обработка «Приходные накладные из УТ» (ВыгрузкаБух), папка %5, «Прочитать» и «Создать» (сначала поступления, затем корректировки).'"),
		Результат.Накладных, Результат.Корректировок, Результат.Строк, Результат.ПутьКФайлу, Папка,
		ДобавленоДляЦепочки) + ТекстСверки + ТекстЗамечанийУКД(Результат);

КонецФункции

&НаСервере
Функция ПрочитатьОтветыНаСервере()

	Возврат РеквизитФормыВЗначение("Объект").ПрочитатьОтветыБухгалтерии();

КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьНастройку(Имя, Значение)

	ХранилищеОбщихНастроек.Сохранить("ОбменУТ_ВыгрузкаВБух", Имя, Значение);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗагрузитьНастройку(Имя, ЗначениеПоУмолчанию)

	Значение = ХранилищеОбщихНастроек.Загрузить("ОбменУТ_ВыгрузкаВБух", Имя);
	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат Значение;

КонецФункции

#КонецОбласти

// «УКД к прошлым приходам»: все УКД периода (и старые), у которых поступление
// уже было раньше - УПД цепочки выгружалась / есть в БП (по «Приходам из БП»)
// / в выгрузке УТ её нет (старая). Включается «Без УПД (только УКД)», отмечаются
// только такие УКД без ошибок и без отметки «Есть в БП»; остальное снимается.
// Перед созданием БП ещё раз проверяет: идентификатор ЭДО, номер УКД, привязку
// к поступлению (контрагент, организация, даты, суммы по ставке).
&НаКлиенте
Процедура УКДКПрошлымПриходам(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПериодС) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите начало периода.'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Собираем УКД к прошлым приходам...'"));
	ТекстИтога = УКДКПрошлымПриходамНаСервере();
	Состояние();

	РазвернутьДерево();
	Элементы.СтраницыВыгрузки.ТекущаяСтраница = Элементы.СтраницаЧтоВыгружаем;
	ПоказатьПредупреждение(, ТекстИтога);

КонецПроцедуры

&НаСервере
Функция УКДКПрошлымПриходамНаСервере()

	ТолькоУКД = Истина;
	СохранитьНастройку("ТолькоУКД", ТолькоУКД);
	ПрочитатьНаСервере();

	Данные = ?(ЗначениеЗаполнено(АдресДанных), ПолучитьИзВременногоХранилища(АдресДанных), Неопределено);
	Если Данные = Неопределено Тогда
		Возврат Информация;
	КонецЕсли;

	УПДЦепочки = Новый Соответствие;
	Для Каждого Элемент Из Данные Цикл
		Если Элемент.Вид = "УПД" Тогда
			УПДЦепочки.Вставить(Элемент.Описание.КлючЦепочки, Элемент.Описание);
		КонецЕсли;
	КонецЦикла;

	Нужные = Новый Соответствие;
	СоСсылкой = 0;
	ПоНомеру = 0;
	ВБП = 0;
	СОшибкой = 0;
	НовыеЦепочки = 0;
	Для Каждого Элемент Из Данные Цикл
		Описание = Элемент.Описание;
		Если Элемент.Вид <> "УКД" Тогда
			Продолжить;
		КонецЕсли;
		УПД = УПДЦепочки.Получить(Описание.КлючЦепочки);
		ПрошлыйПриход = ЗначениеЗаполнено(ЗначениеПоля(Описание, "ПоступлениеБП"))
			ИЛИ УПД = Неопределено
			ИЛИ УПД.Выгружена
			ИЛИ ЕстьВБП(УПД);
		Если НЕ ПрошлыйПриход Тогда
			НовыеЦепочки = НовыеЦепочки + 1;
			Продолжить;
		КонецЕсли;
		Если ЕстьВБП(Описание) Тогда
			ВБП = ВБП + 1;
		ИначеЕсли Описание.Ошибка ИЛИ Элемент.Данные = Неопределено Тогда
			СОшибкой = СОшибкой + 1;
		Иначе
			Нужные.Вставить(Элемент.Идентификатор, Истина);
			Если ЗначениеЗаполнено(ЗначениеПоля(Описание, "ПоступлениеБП")) Тогда
				СоСсылкой = СоСсылкой + 1;
			Иначе
				ПоНомеру = ПоНомеру + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Дерево = РеквизитФормыВЗначение("Накладные");
	Для Каждого СтрокаДерева Из Дерево.Строки.НайтиСтроки(Новый Структура("Уровень", 1), Истина) Цикл
		СтрокаДерева.Отметка = Нужные.Получить(СтрокаДерева.Идентификатор) <> Неопределено;
	КонецЦикла;
	Для Каждого Группа Из Дерево.Строки.НайтиСтроки(Новый Структура("Уровень", 0), Ложь) Цикл
		Группа.Отметка = Группа.Строки.НайтиСтроки(Новый Структура("Уровень, Отметка", 1, Истина), Ложь).Количество() > 0;
	КонецЦикла;
	ЗначениеВРеквизитФормы(Дерево, "Накладные");

	Текст = СтрШаблон(НСтр("ru = 'УКД к прошлым приходам отмечено: %1 (со ссылкой на поступление БП по сверке - %2, БП найдёт поступление по ид / номеру УПД и проверит привязку - %3). Не отмечены: уже есть в БП - %4, с ошибкой - %5, УКД новых цепочек (УПД ещё не выгружалась) - %6. Включено «Без УПД (только УКД)» - УПД в файл не пойдут.'"),
		Нужные.Количество(), СоСсылкой, ПоНомеру, ВБП, СОшибкой, НовыеЦепочки);
	Если НЕ ЗначениеЗаполнено(АдресПриходовБП) Тогда
		Текст = Текст + Символы.ПС + НСтр("ru = 'Сверка с БП не загружена: что уже есть в БП, проверит только БП. Надёжнее - сначала «Приходы из БП...» за этот период.'");
	КонецЕсли;
	Текст = Текст + Символы.ПС + НСтр("ru = 'Проверьте отметки и нажмите «Выгрузить в папку».'");
	Информация = Текст + Символы.ПС + Информация;

	Возврат Текст;

КонецФункции

// ПОВТОРНАЯ ОТПРАВКА «ЗЕЛЁНЫХ» («Есть в БП» по файлу приходов): файл БП мог
// устареть - документ в БП пометили на удаление, нужен новый. С подтверждением
// идентификатор добавляется в ПовторноВБП, и такой документ отмечается и уходит.
// Дубля нет: БП перед созданием ищет НЕпомеченный документ по идентификатору
// ЭДО и номеру. Надёжнее - выгрузить приходы из БП заново и загрузить.

&НаКлиенте
Функция ЭтоПовторнаяОтправка(Идентификатор)

	Возврат СтрНайти(ПовторноВБП, ";" + ВРег(СокрЛП(Идентификатор)) + ";") > 0;

КонецФункции

&НаКлиенте
Процедура ЗапроситьПовторнуюОтправку(Таблица, ИдентификаторСтроки, Идентификатор, ДокументБП)

	ПараметрыВопроса = Новый Структура("Таблица, ИдентификаторСтроки, Идентификатор", Таблица, ИдентификаторСтроки, Идентификатор);
	ПоказатьВопрос(Новый ОписаниеОповещения("ПовторнаяОтправкаОтвет", ЭтотОбъект, ПараметрыВопроса),
		СтрШаблон(НСтр("ru = 'По файлу приходов БП документ уже есть: %1.
			|Если в БП его пометили на удаление и нужен новый - отправить повторно?
			|Дубля не будет: БП создаст документ, только если непомеченного с этим идентификатором и номером нет.
			|(Надёжнее - выгрузить приходы из БП заново и загрузить их здесь.)'"), ДокументБП),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПовторнаяОтправкаОтвет(Ответ, ПараметрыВопроса) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПовторноВБП) Тогда
		ПовторноВБП = ";";
	КонецЕсли;
	ПовторноВБП = ПовторноВБП + ВРег(СокрЛП(ПараметрыВопроса.Идентификатор)) + ";";
	Если ПараметрыВопроса.Таблица = "Накладные" Тогда
		СтрокаДерева = Накладные.НайтиПоИдентификатору(ПараметрыВопроса.ИдентификаторСтроки);
	Иначе
		СтрокаДерева = СборкаДокументов.НайтиПоИдентификатору(ПараметрыВопроса.ИдентификаторСтроки);
	КонецЕсли;
	Если СтрокаДерева <> Неопределено Тогда
		СтрокаДерева.Отметка = Истина;
	КонецЕсли;

КонецПроцедуры

#Область СборкаУКДУПД

// Вкладка «Сборка УКД / УПД»: строка - один документ (УКД или УПД) за период
// по контрагенту; результат проверки - есть в БП (по «Приходам из БП»), не
// выгружалась / выгружалась, отправится ли. «Отправить в Бух» - ровно
// отмеченные, одним файлом; что есть в БП, не уходит (дублей нет).

&НаКлиенте
Процедура СборкаСобрать(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СборкаПериодС) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите начало периода сборки.'"));
		Возврат;
	КонецЕсли;
	СборкаТолькоИд = "";
	НачатьСборку("Сборка");

КонецПроцедуры

&НаСервере
Процедура СборкаСобратьНаСервере()

	ПрименитьПрочитанноеСборки(ОбъектДляЧтения().ПрочитатьДокументы(СборкаПериодС, СборкаПериодПо, БезПроверкиПодписи, Истина));

КонецПроцедуры

// Прочитанное для «Сборки» (здесь или в фоне) - отметки «есть в БП» и таблица.
&НаСервере
Процедура ПрименитьПрочитанноеСборки(Результат)

	Если НЕ Результат.Успех Тогда
		ИнформацияСборки = Результат.Ошибка;
		СборкаДокументов.Очистить();
		Возврат;
	КонецЕсли;

	Сверка = Неопределено;
	Если ЗначениеЗаполнено(АдресПриходовБП) Тогда
		Сверка = ПолучитьИзВременногоХранилища(АдресПриходовБП);
	КонецЕсли;
	ОбъектДляЧтения().ОтметитьЕстьВБП(Результат.Документы, Сверка);

	Если ЗначениеЗаполнено(АдресСборки) Тогда
		УдалитьИзВременногоХранилища(АдресСборки);
	КонецЕсли;
	АдресСборки = ПоместитьВоВременноеХранилище(Результат.Документы, УникальныйИдентификатор);
	ЗаполнитьСборку(Результат.Документы, Новый Соответствие);

	Если Результат.Пояснения.Количество() > 0 Тогда
		ИнформацияСборки = ИнформацияСборки + Символы.ПС + СтрСоединить(Результат.Пояснения, Символы.ПС);
	КонецЕсли;

КонецПроцедуры

// Таблица сборки по прочитанным документам с отбором (контрагент, вид, номер,
// только «нет в БП»), строки - в пределах периода сборки. Отмеченные - по ид.
&НаСервере
Процедура ЗаполнитьСборку(Документы, Отмеченные)

	СборкаДокументов.Очистить();
	Отбор = ВРег(СокрЛП(СборкаКонтрагент));
	ОтборИНН = "";
	ЭлементСписка = Элементы.СборкаКонтрагент.СписокВыбора.НайтиПоЗначению(СборкаКонтрагент);
	Если ЭлементСписка <> Неопределено Тогда
		Представление = СокрЛП(ЭлементСписка.Представление);
		Начало = СтрНайти(Представление, "(", НаправлениеПоиска.СКонца);
		Если Начало > 0 И Прав(Представление, 1) = ")" Тогда
			ОтборИНН = СокрЛП(Сред(Представление, Начало + 1, СтрДлина(Представление) - Начало - 1));
		КонецЕсли;
	КонецЕсли;
	Номер = ВРег(СтрЗаменить(СокрЛП(СборкаНомер), " ", ""));
	ДатаС = НачалоДня(СборкаПериодС);
	ДатаПо = ?(ЗначениеЗаполнено(СборкаПериодПо), КонецДня(СборкаПериодПо), '39991231235959');
	ЕстьСверка = ЗначениеЗаполнено(АдресПриходовБП);
	Приходные = ПриходныеПоУПД(Документы);

	Всего = 0;
	ВБП = 0;
	КОтправке = 0;
	СОшибкой = 0;
	НеПроверено = 0;
	// «Найти УКД к приходам»: только найденные УКД
	ТолькоИд = Неопределено;
	Если ЗначениеЗаполнено(СборкаТолькоИд) Тогда
		ТолькоИд = Новый Соответствие;
		Для Каждого Ид Из СтрРазделить(СборкаТолькоИд, ";", Ложь) Цикл
			ТолькоИд.Вставить(ВРег(СокрЛП(Ид)), Истина);
		КонецЦикла;
	КонецЕсли;
	Для Каждого Элемент Из Документы Цикл

		Описание = Элемент.Описание;
		Если Описание.Дата < ДатаС ИЛИ Описание.Дата > ДатаПо Тогда
			Продолжить;
		КонецЕсли;
		Если СборкаВид = "УКД" И Элемент.Вид <> "УКД" ИЛИ СборкаВид = "УПД" И Элемент.Вид <> "УПД" Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Отбор) И СтрНайти(ВРег(Описание.Контрагент), Отбор) = 0 И СтрНайти(ВРег(Описание.ИНН), Отбор) = 0
			И НЕ (ЗначениеЗаполнено(ОтборИНН) И СокрЛП(Описание.ИНН) = ОтборИНН) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Номер) И СтрНайти(ВРег(СтрЗаменить(Описание.Номер, " ", "")), Номер) = 0
			И СтрНайти(ВРег(СтрЗаменить(Описание.Цепочка, " ", "")), Номер) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ТолькоИд <> Неопределено И ТолькоИд.Получить(ВРег(Элемент.Идентификатор)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЕстьВБПДокумент = ЕстьВБП(Описание);
		Если СборкаТолькоНет И ЕстьВБПДокумент Тогда
			Продолжить;
		КонецЕсли;

		СтрокаСборки = СборкаДокументов.Добавить();
		СтрокаСборки.Вид = Элемент.Вид;
		СтрокаСборки.Номер = Описание.Номер;
		СтрокаСборки.Дата = Описание.Дата;
		СтрокаСборки.Контрагент = Описание.Контрагент;
		СтрокаСборки.ИНН = Описание.ИНН;
		СтрокаСборки.Сумма = ?(Элемент.Вид = "УКД", Описание.Сумма - Описание.СуммаДо, Описание.Сумма);
		СтрокаСборки.Основание = ?(Элемент.Вид = "УКД", Описание.Цепочка, "");
		СтрокаСборки.Подписан = Описание.Подписан;
		СтрокаСборки.Выгружена = Описание.Выгружена;
		СтрокаСборки.ВБП = ЕстьВБПДокумент;
		СтрокаСборки.ДокументБП = ЗначениеПоля(Описание, "ДокументБП");
		СтрокаСборки.Проверка = Описание.Проверка;
		СтрокаСборки.Идентификатор = Элемент.Идентификатор;
		СтрокаСборки.ДокументУТ = Приходные.Получить(ВРег(ИдентификаторУПДЭлемента(Элемент)));
		Всего = Всего + 1;

		Если ЕстьВБПДокумент Тогда
			СтрокаСборки.Результат = НСтр("ru = 'Есть в БП: '") + СтрокаСборки.ДокументБП + НСтр("ru = ' - не отправляется'");
			СтрокаСборки.Итог = 3;
			ВБП = ВБП + 1;
		ИначеЕсли Описание.Ошибка ИЛИ Элемент.Данные = Неопределено Тогда
			СтрокаСборки.Результат = НСтр("ru = 'Проверьте (уйдёт, решит БП): '") + КраткаяПричинаУТ(Описание.Проверка);
			СтрокаСборки.Итог = 2;
			СОшибкой = СОшибкой + 1;
		ИначеЕсли ВнеФайлаБП(Описание) Тогда
			СтрокаСборки.Результат = НСтр("ru = 'В файле БП этого контрагента нет - не проверено (к отправке не отмечается)'");
			СтрокаСборки.Итог = 1;
			НеПроверено = НеПроверено + 1;
		ИначеЕсли ЕстьСверка Тогда
			СтрокаСборки.Результат = НСтр("ru = 'Нет в БП - отправить'")
				+ ?(Элемент.Вид = "УКД" И ЗначениеЗаполнено(ЗначениеПоля(Описание, "ПоступлениеБП")),
					НСтр("ru = '; в БП - '") + СтрокаСборки.ДокументБП, "")
				+ ?(Описание.Выгружена, НСтр("ru = ' (уже выгружалась, но в БП не создана)'"), "");
			СтрокаСборки.Итог = ?(Описание.Внимание, 1, 0);
			КОтправке = КОтправке + 1;
		Иначе
			СтрокаСборки.Результат = ?(Описание.Выгружена,
				НСтр("ru = 'Выгружалась; есть ли в БП - не проверено (загрузите «Приходы из БП»)'"),
				НСтр("ru = 'Не выгружалась - отправить; в БП не проверено (загрузите «Приходы из БП»)'"));
			СтрокаСборки.Итог = ?(Описание.Выгружена, 3, ?(Описание.Внимание, 1, 0));
			Если НЕ Описание.Выгружена Тогда
				КОтправке = КОтправке + 1;
			КонецЕсли;
		КонецЕсли;
		// УКД: изменение со знаком - первым (в «Сумме» оно же числом)
		Если Элемент.Вид = "УКД" Тогда
			СтрокаСборки.Результат = ТекстЗнакаИзменения(СтрокаСборки.Сумма) + ". " + СтрокаСборки.Результат;
		КонецЕсли;
		// Из УТ уходит всё, что собрано; проверки - в БП (15.10.2026)
		СтрокаСборки.МожноОтправить = Элемент.Данные <> Неопределено;
		СтрокаСборки.Сверено = ЕстьСверка И НЕ ВнеФайлаБП(Описание);
		СтрокаСборки.Отметка = Отмеченные.Получить(Элемент.Идентификатор) <> Неопределено;

	КонецЦикла;

	ИнформацияСборки = СтрШаблон(
		НСтр("ru = 'Собрано: %1 (УКД и УПД за %2 - %3). Есть в БП: %4, к отправке: %5, не отправятся: %6.%7%8'"),
		Всего, Формат(СборкаПериодС, "ДЛФ=D"), ?(ЗначениеЗаполнено(СборкаПериодПо), Формат(СборкаПериодПо, "ДЛФ=D"), НСтр("ru = 'сегодня'")),
		ВБП, КОтправке, СОшибкой,
		?(НеПроверено = 0, "", СтрШаблон(НСтр("ru = ' Не проверено (контрагентов нет в файле БП - он выгружен с отбором): %1.'"), НеПроверено)),
		?(ЕстьСверка, "", " " + НСтр("ru = 'Что уже есть в БП, не проверено - загрузите «Приходы из БП» (вкладка «Приходы из БП»).'")));

КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьСборку()

	ДокументыСборки = ?(ЗначениеЗаполнено(АдресСборки), ПолучитьИзВременногоХранилища(АдресСборки), Неопределено);
	Если ДокументыСборки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Отмеченные = Новый Соответствие;
	Для Каждого СтрокаСборки Из СборкаДокументов Цикл
		Если СтрокаСборки.Отметка Тогда
			Отмеченные.Вставить(СтрокаСборки.Идентификатор, Истина);
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьСборку(ДокументыСборки, Отмеченные);

КонецПроцедуры

&НаКлиенте
Процедура СборкаОтборПриИзменении(Элемент)

	ПерезаполнитьСборку();

КонецПроцедуры

&НаКлиенте
Процедура СборкаОчиститьОтбор(Команда)

	СборкаКонтрагент = "";
	СборкаВид = "Все";
	СборкаНомер = "";
	СборкаТолькоНет = Ложь;
	СборкаТолькоИд = "";
	ПерезаполнитьСборку();

КонецПроцедуры

&НаКлиенте
Процедура СборкаОтметитьКОтправке(Команда)

	Для Каждого СтрокаСборки Из СборкаДокументов Цикл
		// Из УТ уходит всё ещё не выгруженное, проверки - в БП
		СтрокаСборки.Отметка = СтрокаСборки.МожноОтправить И НЕ СтрокаСборки.Выгружена;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СборкаСнятьОтметки(Команда)

	Для Каждого СтрокаСборки Из СборкаДокументов Цикл
		СтрокаСборки.Отметка = Ложь;
	КонецЦикла;

КонецПроцедуры

// Есть в БП или не соберётся - не отмечается
&НаКлиенте
Процедура СборкаДокументовОтметкаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.СборкаДокументов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ НЕ ТекущиеДанные.Отметка Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.Итог = 2 И НЕ ТекущиеДанные.ВБП Тогда
		ТекущиеДанные.Отметка = Ложь;
		ПоказатьОповещениеПользователя(НСтр("ru = 'Не отправляется'"), , ТекущиеДанные.Результат);
	ИначеЕсли ТекущиеДанные.ВБП И НЕ ЭтоПовторнаяОтправка(ТекущиеДанные.Идентификатор) Тогда
		ТекущиеДанные.Отметка = Ложь;
		ЗапроситьПовторнуюОтправку("СборкаДокументов", ТекущиеДанные.ПолучитьИдентификатор(), ТекущиеДанные.Идентификатор,
			ТекущиеДанные.ДокументБП);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СборкаДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ДанныеСтроки = СборкаДокументов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки <> Неопределено И ЗначениеЗаполнено(ДанныеСтроки.ДокументУТ) И Поле <> Элементы.СборкаДокументовОтметка Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, ДанныеСтроки.ДокументУТ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СборкаОтправить(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Папка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите папку обмена с БП.'"));
		Возврат;
	КонецЕсли;
	Отмечено = 0;
	Для Каждого СтрокаСборки Из СборкаДокументов Цикл
		Если СтрокаСборки.Отметка Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте строки (или «Отметить к отправке»).'"));
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("СборкаОтправитьЗавершение", ЭтотОбъект),
		СтрШаблон(НСтр("ru = 'Отправить в БП отмеченные документы (%1) одним файлом в папку %2? Уходят ровно отмеченные, цепочка не добавляется; что есть в БП - не уйдёт.'"), Отмечено, Папка),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура СборкаОтправитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Пишем файл...'"));
	Текст = СборкаОтправитьНаСервере();
	Состояние();
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

&НаСервере
Функция СборкаОтправитьНаСервере()

	ДокументыСборки = ?(ЗначениеЗаполнено(АдресСборки), ПолучитьИзВременногоХранилища(АдресСборки), Неопределено);
	Если ДокументыСборки = Неопределено Тогда
		Возврат НСтр("ru = 'Данные устарели - нажмите «Собрать».'");
	КонецЕсли;
	Отмеченные = Новый Соответствие;
	Для Каждого СтрокаСборки Из СборкаДокументов Цикл
		Если СтрокаСборки.Отметка Тогда
			Отмеченные.Вставить(СтрокаСборки.Идентификатор, Истина);
		КонецЕсли;
	КонецЦикла;

	НакладныеКОтправке = Новый Массив;
	КорректировкиКОтправке = Новый Массив;
	Пропущено = 0;
	Для Каждого Элемент Из ДокументыСборки Цикл
		Если Отмеченные.Получить(Элемент.Идентификатор) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Из УТ уходит всё, что собрано (проверки - в БП); нет данных - нечего
		Если Элемент.Данные = Неопределено Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Если Элемент.Вид = "УКД" Тогда
			КорректировкиКОтправке.Добавить(Элемент.Данные);
		Иначе
			НакладныеКОтправке.Добавить(Элемент.Данные);
		КонецЕсли;
	КонецЦикла;
	Если НакладныеКОтправке.Количество() + КорректировкиКОтправке.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Отправлять нечего: отмеченные уже есть в БП или не собираются.'");
	КонецЕсли;

	Результат = ОбъектДляЧтения().ВыгрузитьВПапку(Папка, НакладныеКОтправке, КорректировкиКОтправке, СборкаПериодС, СборкаПериодПо);
	Если НЕ Результат.Успех Тогда
		Возврат Результат.Ошибка;
	КонецЕсли;
	СохранитьНастройку("Папка", СокрЛП(Папка));

	Выгружены = Новый Соответствие;
	Для Каждого Идентификатор Из Результат.Выгружены Цикл
		Выгружены.Вставить(Идентификатор, Истина);
	КонецЦикла;
	Для Каждого Элемент Из ДокументыСборки Цикл
		Если Выгружены.Получить(Элемент.Идентификатор) <> Неопределено Тогда
			Элемент.Описание.Выгружена = Истина;
		КонецЕсли;
	КонецЦикла;
	ПоместитьВоВременноеХранилище(ДокументыСборки, АдресСборки);
	Для Каждого СтрокаСборки Из СборкаДокументов Цикл
		Если Выгружены.Получить(СтрокаСборки.Идентификатор) <> Неопределено Тогда
			СтрокаСборки.Отметка = Ложь;
			СтрокаСборки.Выгружена = Истина;
			СтрокаСборки.Результат = НСтр("ru = 'Отправлено: '") + Результат.ИмяФайла;
			СтрокаСборки.Итог = 3;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон(НСтр("ru = 'Отправлено УПД: %1, УКД: %2 (не ушло - есть в БП или с ошибкой: %3). Файл: %4. Дальше - в БП: «Прочитать», вкладка «Приём УКД и УПД».'"),
		Результат.Накладных, Результат.Корректировок, Пропущено, Результат.ПутьКФайлу) + ТекстЗамечанийУКД(Результат);

КонецФункции

// Исходные XML-файлы УКД из СБИС - в подпапку УКД_XML папки обмена, для
// штатной загрузки ЭДО в БП (ВыгрузкаБух, «Штатная загрузка УКД…»). Берутся
// отмеченные строки УКД «Сборки», а если отмеченных нет - все УКД таблицы.
&НаКлиенте
Процедура СборкаXMLУКД(Команда)

	Если НЕ ЗначениеЗаполнено(Папка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите папку обмена с БП.'"));
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Скачиваем файлы УКД из СБИС...'"));
	Текст = СборкаXMLУКДНаСервере();
	Состояние();
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

&НаСервере
Функция СборкаXMLУКДНаСервере()

	ЕстьОтметки = Ложь;
	Для Каждого СтрокаСборки Из СборкаДокументов Цикл
		Если СтрокаСборки.Отметка И СтрокаСборки.Вид = "УКД" Тогда
			ЕстьОтметки = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Идентификаторы = Новый Массив;
	Для Каждого СтрокаСборки Из СборкаДокументов Цикл
		Если СтрокаСборки.Вид <> "УКД" ИЛИ ЕстьОтметки И НЕ СтрокаСборки.Отметка Тогда
			Продолжить;
		КонецЕсли;
		Если Идентификаторы.Найти(СтрокаСборки.Идентификатор) = Неопределено Тогда
			Идентификаторы.Добавить(СтрокаСборки.Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат НСтр("ru = 'УКД в таблице нет - нажмите «Собрать» (вид «Все» или «УКД»).'");
	КонецЕсли;

	Итог = ОбъектДляЧтения().ВыгрузитьФайлыУКД(Папка, Идентификаторы);
	СохранитьНастройку("Папка", СокрЛП(Папка));

	Текст = СтрШаблон(НСтр("ru = 'Файлы УКД (%1 - %2): записано %3 из %4 в %5. В БП: «Штатная загрузка УКД…» - выберите эти файлы.'"),
		?(ЕстьОтметки, НСтр("ru = 'отмеченные'"), НСтр("ru = 'все УКД таблицы'")), Идентификаторы.Количество(),
		Итог.Записано, Идентификаторы.Количество(), Итог.Каталог);
	Если Итог.Ошибки.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + НСтр("ru = 'Не записаны:'") + Символы.ПС + СтрСоединить(Итог.Ошибки, Символы.ПС);
	КонецЕсли;

	Возврат Текст;

КонецФункции

#КонецОбласти

// «Отметить к отправке» на «Приходах из БП»: отметка у поступлений, к которым
// есть новые УКД из УТ, которые можно отправить («Можно отправить»).
&НаКлиенте
Процедура ПриходыОтметитьКОтправке(Команда)

	Отмечено = 0;
	Для Каждого СтрокаПриходов Из ПриходыБП Цикл
		СтрокаПриходов.Отметка = СтрокаПриходов.МожноОтправить И ЗначениеЗаполнено(СтрокаПриходов.ИдентификаторыУКД);
		Если СтрокаПриходов.Отметка Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отправлять нечего: ни к одному поступлению БП нет новых подписанных УКД из УТ (см. «Что отправить»).'"));
	КонецЕсли;

КонецПроцедуры

// «Отправить отмеченные в Бух»: УКД отмеченных поступлений (те, что «можно
// отправить») собираются на «Сборке» по идентификаторам и сразу уходят одним
// файлом в папку обмена (как «Отправить в Бух» на «Сборке»). УПД, которых в БП
// нет, здесь не отправляются - они не в этой таблице: «Собрать к отправке».
&НаКлиенте
Процедура ПриходыОтправитьОтмеченные(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Папка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите папку обмена с БП.'"));
		Возврат;
	КонецЕсли;
	Отмечено = 0;
	Для Каждого СтрокаПриходов Из ПриходыБП Цикл
		Если СтрокаПриходов.Отметка Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте поступления (или «Отметить к отправке»).'"));
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПриходыОтправитьОтмеченныеЗавершение", ЭтотОбъект),
		СтрШаблон(НСтр("ru = 'Отправить в БП новые УКД к отмеченным поступлениям (%1) одним файлом в папку %2? Уходят только подписанные и без ошибок; что есть в БП - не уйдёт.'"), Отмечено, Папка),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура ПриходыОтправитьОтмеченныеЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Собираем УКД и пишем файл...'"));
	Текст = ПриходыОтправитьОтмеченныеНаСервере();
	Состояние();
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

&НаСервере
Функция ПриходыОтправитьОтмеченныеНаСервере()

	Идентификаторы = Новый Массив;
	ДатаС = '39991231';
	ДатаПо = '00010101';
	Для Каждого СтрокаПриходов Из ПриходыБП Цикл
		Если НЕ СтрокаПриходов.Отметка Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Идентификатор Из СтрРазделить(СтрокаПриходов.ИдентификаторыУКД, ";", Ложь) Цикл
			Если Идентификаторы.Найти(Идентификатор) = Неопределено Тогда
				Идентификаторы.Добавить(Идентификатор);
			КонецЕсли;
		КонецЦикла;
		Если ЗначениеЗаполнено(СтрокаПриходов.ДатаУКДС) Тогда
			ДатаС = Мин(ДатаС, НачалоДня(СтрокаПриходов.ДатаУКДС));
			ДатаПо = Макс(ДатаПо, НачалоДня(СтрокаПриходов.ДатаУКДПо));
		КонецЕсли;
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат НСтр("ru = 'У отмеченных поступлений нет новых УКД, которые можно отправить.'");
	КонецЕсли;
	Если ДатаС > ДатаПо Тогда
		ДатаС = ?(ЗначениеЗаполнено(ПриходыОтправкаС), ПриходыОтправкаС, ПериодС);
		ДатаПо = ?(ЗначениеЗаполнено(ПриходыОтправкаПо), ПриходыОтправкаПо, ПериодПо);
	КонецЕсли;

	// Сборка ровно этих УКД (как «Найти УКД к приходам»), отметка и отправка
	СборкаПериодС = ДатаС;
	СборкаПериодПо = ДатаПо;
	СборкаКонтрагент = "";
	СборкаВид = "УКД";
	СборкаНомер = "";
	СборкаТолькоНет = Истина;
	СборкаТолькоИд = СтрСоединить(Идентификаторы, ";");
	СборкаСобратьНаСервере();

	Отмечено = 0;
	Для Каждого СтрокаСборки Из СборкаДокументов Цикл
		СтрокаСборки.Отметка = СтрокаСборки.МожноОтправить;
		Если СтрокаСборки.Отметка Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Отмечено = 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'УКД найдено %1, но ни одну нельзя отправить (не подписана, ошибка, уже в БП) - см. «Сборку».'"),
			Идентификаторы.Количество());
	КонецЕсли;

	Текст = СборкаОтправитьНаСервере();
	Для Каждого СтрокаПриходов Из ПриходыБП Цикл
		СтрокаПриходов.Отметка = Ложь;
	КонецЦикла;

	Возврат СтрШаблон(НСтр("ru = 'УКД к отмеченным поступлениям: %1, отправлено: %2. %3'"),
		Идентификаторы.Количество(), Отмечено, Текст)
		+ Символы.ПС + НСтр("ru = 'После создания в БП выгрузите приходы заново и загрузите «Приходы из БП...» - таблица обновится.'");

КонецФункции

// «Собрать к отправке» на «Приходах из БП»: сборка УКД и УПД за период и по
// контрагенту отбора отправки, только то, чего нет в БП (сверено с файлом
// приходов), отмечено всё, что можно отправить; открывается «Сборка».
&НаКлиенте
Процедура ПриходыСобратьКОтправке(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(АдресПриходовБП) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала «Приходы из БП...» - без файла БП не сверить, что уже есть в БП.'"));
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПриходыОтправкаС) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите начало периода отправки.'"));
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Собираем, что можно отправить...'"));
	Текст = ПриходыСобратьКОтправкеНаСервере();
	Состояние();
	Элементы.СтраницыВыгрузки.ТекущаяСтраница = Элементы.СтраницаСборка;
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

&НаСервере
Функция ПриходыСобратьКОтправкеНаСервере()

	СборкаПериодС = ПриходыОтправкаС;
	СборкаПериодПо = ПриходыОтправкаПо;
	СборкаКонтрагент = ПриходыОтправкаКонтрагент;
	СборкаВид = "Все";
	СборкаНомер = "";
	СборкаТолькоНет = Истина;
	СборкаТолькоИд = "";
	СборкаСобратьНаСервере();

	Отмечено = 0;
	Нельзя = 0;
	Для Каждого СтрокаСборки Из СборкаДокументов Цикл
		СтрокаСборки.Отметка = СтрокаСборки.МожноОтправить;
		Если СтрокаСборки.МожноОтправить Тогда
			Отмечено = Отмечено + 1;
		Иначе
			Нельзя = Нельзя + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон(НСтр("ru = 'Сверено с БП. Нет в БП и можно отправить - отмечено: %1; нельзя (не подписан, ошибка) - %2, причина в «Результате проверки». Проверьте отметки на «Сборке» и нажмите «Отправить в БП».'"),
		Отмечено, Нельзя);

КонецФункции

// «Найти УКД к приходам»: все УКД УТ к поступлениям файла БП, которых в БП
// нет (любой даты, см. НайтиУКДНетВБП), по контрагенту отбора отправки -
// собираются на «Сборке» (период - по датам этих УКД, в таблице - только они),
// отмечено всё, что можно отправить.
&НаКлиенте
Процедура ПриходыНайтиУКД(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(АдресПриходовБП) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала «Приходы из БП...».'"));
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Ищем УКД к приходам БП...'"));
	Текст = ПриходыНайтиУКДНаСервере();
	Состояние();
	Если ЗначениеЗаполнено(СборкаТолькоИд) Тогда
		Элементы.СтраницыВыгрузки.ТекущаяСтраница = Элементы.СтраницаСборка;
	КонецЕсли;
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

&НаСервере
Функция ПриходыНайтиУКДНаСервере()

	Сверка = ПолучитьИзВременногоХранилища(АдресПриходовБП);
	Если Сверка = Неопределено ИЛИ НЕ Сверка.Свойство("СписокУКДНетВБП") Тогда
		Возврат НСтр("ru = 'Загрузите «Приходы из БП» заново (обработка обновлена).'");
	КонецЕсли;

	Отбор = ВРег(СокрЛП(ПриходыОтправкаКонтрагент));
	ОтборИНН = "";
	ЭлементСписка = Элементы.ПриходыОтправкаКонтрагент.СписокВыбора.НайтиПоЗначению(ПриходыОтправкаКонтрагент);
	Если ЭлементСписка <> Неопределено Тогда
		Представление = СокрЛП(ЭлементСписка.Представление);
		Начало = СтрНайти(Представление, "(", НаправлениеПоиска.СКонца);
		Если Начало > 0 И Прав(Представление, 1) = ")" Тогда
			ОтборИНН = СокрЛП(Сред(Представление, Начало + 1, СтрДлина(Представление) - Начало - 1));
		КонецЕсли;
	КонецЕсли;

	Идентификаторы = Новый Массив;
	ДатаС = '39991231';
	ДатаПо = '00010101';
	Для Каждого Найденная Из Сверка.СписокУКДНетВБП Цикл
		Если ЗначениеЗаполнено(Отбор) И СтрНайти(ВРег(Найденная.ИНН), Отбор) = 0
			И НЕ (ЗначениеЗаполнено(ОтборИНН) И Найденная.ИНН = ОтборИНН) Тогда
			// по наименованию: у поступления файла
			Подходит = Ложь;
			Для Каждого Поступление Из Сверка.Поступления Цикл
				Если Поступление.УИД = Найденная.ПоступлениеУИД И СтрНайти(ВРег(Поступление.Контрагент), Отбор) > 0 Тогда
					Подходит = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ Подходит Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Идентификаторы.Добавить(Найденная.Идентификатор);
		ДатаС = Мин(ДатаС, НачалоДня(Найденная.Дата));
		ДатаПо = Макс(ДатаПо, НачалоДня(Найденная.Дата));
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		СборкаТолькоИд = "";
		Возврат НСтр("ru = 'УКД к приходам БП, которых в БП нет, не найдено (с учётом отбора по контрагенту).'");
	КонецЕсли;

	СборкаПериодС = ДатаС;
	СборкаПериодПо = ДатаПо;
	СборкаКонтрагент = ПриходыОтправкаКонтрагент;
	СборкаВид = "УКД";
	СборкаНомер = "";
	СборкаТолькоНет = Истина;
	СборкаТолькоИд = СтрСоединить(Идентификаторы, ";");
	СборкаСобратьНаСервере();

	Собрано = 0;
	Можно = 0;
	Для Каждого СтрокаСборки Из СборкаДокументов Цикл
		Собрано = Собрано + 1;
		СтрокаСборки.Отметка = СтрокаСборки.МожноОтправить;
		Если СтрокаСборки.МожноОтправить Тогда
			Можно = Можно + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон(НСтр("ru = 'УКД к приходам БП, которых в БП нет: найдено %1, на «Сборке» %2 (не собрались - %3: не разобраны / нет данных), можно отправить и отмечено: %4. Период сборки %5 - %6. Проверьте и «Отправить в БП».'"),
		Идентификаторы.Количество(), Собрано, Идентификаторы.Количество() - Собрано, Можно,
		Формат(ДатаС, "ДЛФ=D"), Формат(ДатаПо, "ДЛФ=D"));

КонецФункции

#Область СборкаВФоне

// «Показать», «Приходы из БП» и «Собрать»: тяжёлая часть (СобратьВФоне
// объекта) - в фоновом задании БСП (ДлительныеОперации, обработка
// подключается из .epf, ключ задания - на пользователя), форма раз в 2 с
// показывает ход над вкладками; «Остановить сборку», лимит «Лимит, мин» (0 -
// без лимита); пока идёт - кнопки чтения и отправки недоступны. «Собирать в
// фоне» снята или фон не запустился - как раньше, сразу (причина - в итоге).
// Как тест приёма и сверки в настройках ЭДО (ЭАрМ_ТестУпаковок).

// Вид - «Показать», «ПриходыБП», «Сборка»; для «ПриходыБП» - адрес файла во
// временном хранилище, его имя и строка в начало итога.
&НаКлиенте
Процедура НачатьСборку(Вид, АдресФайла = "", ИмяФайла = "", Префикс = "")

	Если НЕ СобиратьВФоне Тогда
		Состояние(ТекстВидаСборки(Вид) + "...");
		ТекстИтога = СобратьСразуНаСервере(Вид, АдресФайла, ИмяФайла);
		Состояние();
		ПослеСборки(Вид, Префикс + ТекстИтога);
		Возврат;
	КонецЕсли;

	Ответ = ЗапуститьСборкуНаСервере(Вид, АдресФайла, ИмяФайла);
	Если Ответ.УжеИдёт Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ОстановитьДругуюСборкуОтвет", ЭтотОбъект),
			Ответ.Текст + Символы.ПС + НСтр("ru = 'Остановить её?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		Возврат;
	КонецЕсли;
	Если НЕ Ответ.Запущено Тогда
		// Фон не запустился - собрано сразу, причина - в итоге
		ПослеСборки(Вид, Префикс + Ответ.ТекстИтога);
		Возврат;
	КонецЕсли;

	ФоноваяСборка = Новый Структура("Вид, Ид, Адрес, ИмяФайла, Префикс, Начало, Ход",
		Вид, Ответ.Ид, Ответ.Адрес, ИмяФайла, Префикс, ТекущаяУниверсальнаяДатаВМиллисекундах(), "");
	Если Ответ.Статус <> "Выполняется" Тогда
		// БСП выполнил сразу (файловая база с активными заданиями) или ошибка запуска
		ЗавершитьФоновуюСборку(Ответ.Статус, Ответ.Ошибка);
		Возврат;
	КонецЕсли;

	ПоказатьХодСборки(Истина);
	ПодключитьОбработчикОжидания("ПроверитьСборку", 2, Ложь);

КонецПроцедуры

// Раз в 2 с: состояние задания и ход; лимит - снять.
&НаКлиенте
Процедура ПроверитьСборку()

	Если ФоноваяСборка = Неопределено Тогда
		ОтключитьОбработчикОжидания("ПроверитьСборку");
		Возврат;
	КонецЕсли;

	СостояниеЗадания = СостояниеСборки(ФоноваяСборка.Ид);
	Если ЗначениеЗаполнено(СостояниеЗадания.Ход) Тогда
		ФоноваяСборка.Ход = СостояниеЗадания.Ход;
	КонецЕсли;
	Если СостояниеЗадания.Статус <> "Выполняется" Тогда
		ЗавершитьФоновуюСборку(СостояниеЗадания.Статус, СостояниеЗадания.Ошибка);
		Возврат;
	КонецЕсли;

	Секунд = Цел((ТекущаяУниверсальнаяДатаВМиллисекундах() - ФоноваяСборка.Начало) / 1000);
	Лимит = ?(ЛимитСборкиМинут > 0, ЛимитСборкиМинут * 60, 0);
	Если Лимит > 0 И Секунд >= Лимит Тогда
		ОтменитьСборкуНаСервере(ФоноваяСборка.Ид);
		ЗавершитьФоновуюСборку("Отменено", "",
			СтрШаблон(НСтр("ru = 'снята по лимиту %1 мин (поле «Лимит, мин», 0 - без лимита)'"), ЛимитСборкиМинут));
		Возврат;
	КонецЕсли;

	ХодСборки = СтрШаблон(НСтр("ru = '%1: идёт %2 с%3. Сейчас: %4'"),
		ТекстВидаСборки(ФоноваяСборка.Вид), Секунд,
		?(Лимит > 0, СтрШаблон(НСтр("ru = ', будет снята через %1 с'"), Макс(Лимит - Секунд, 0)), ""),
		?(ЗначениеЗаполнено(ФоноваяСборка.Ход), ФоноваяСборка.Ход, НСтр("ru = 'запуск'")));

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьСборку(Команда)

	Если ФоноваяСборка = Неопределено Тогда
		ПоказатьХодСборки(Ложь);
		Возврат;
	КонецЕсли;

	ОтменитьСборкуНаСервере(ФоноваяСборка.Ид);
	ЗавершитьФоновуюСборку("Отменено", "", НСтр("ru = 'остановлена кнопкой «Остановить сборку»'"));

КонецПроцедуры

// Конец фоновой сборки: «Выполнено» - результат в таблицы формы; иначе -
// причина и последний ход в «Информацию» вкладки и предупреждением.
&НаКлиенте
Процедура ЗавершитьФоновуюСборку(Статус, ТекстОшибки, Причина = "")

	ОтключитьОбработчикОжидания("ПроверитьСборку");
	Завершённая = ФоноваяСборка;
	ФоноваяСборка = Неопределено;
	ПоказатьХодСборки(Ложь);
	Если Статус <> "Выполнено" Тогда
		ПодготовкаПослеЧтения = Ложь;
	КонецЕсли;
	Если Завершённая = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Секунд = Цел((ТекущаяУниверсальнаяДатаВМиллисекундах() - Завершённая.Начало) / 1000);

	Если Статус = "Выполнено" Тогда
		ТекстИтога = ПрименитьСборкуНаСервере(Завершённая.Вид, Завершённая.Адрес, Завершённая.ИмяФайла);
		ПослеСборки(Завершённая.Вид, Завершённая.Префикс + ТекстИтога);
		ПоказатьОповещениеПользователя(ТекстВидаСборки(Завершённая.Вид), ,
			СтрШаблон(НСтр("ru = 'готово за %1 с'"), Секунд));
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Причина) Тогда
		Причина = ?(Статус = "Отменено", НСтр("ru = 'остановлена'"), НСтр("ru = 'не выполнена: '") + ТекстОшибки);
	КонецЕсли;
	Текст = СтрШаблон(НСтр("ru = '%1 - %2 (через %3 с). Последний ход: %4. Таблицы - как до сборки.'"),
		ТекстВидаСборки(Завершённая.Вид), Причина, Секунд,
		?(ЗначениеЗаполнено(Завершённая.Ход), Завершённая.Ход, НСтр("ru = 'нет'")));
	Если Завершённая.Вид = "ПриходыБП" Тогда
		ИнформацияПриходыБП = Текст;
	ИначеЕсли Завершённая.Вид = "Сборка" Тогда
		ИнформацияСборки = Текст;
	Иначе
		Информация = Текст;
	КонецЕсли;
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

// После сборки (в фоне или сразу): дерево, вкладка, итог «Приходов из БП».
&НаКлиенте
Процедура ПослеСборки(Вид, ТекстИтога)

	Если Вид = "ПриходыБП" Тогда
		РазвернутьДерево();
		Элементы.СтраницыВыгрузки.ТекущаяСтраница = Элементы.СтраницаПриходыБП;
		ПоказатьПредупреждение(, ТекстИтога);
	ИначеЕсли Вид = "Показать" Тогда
		РазвернутьДерево();
		Если ПодготовкаПослеЧтения = Истина Тогда
			ПодготовкаПослеЧтения = Ложь;
			ТекстПодготовки = ПодготовитьНаСервере();
			РазвернутьДерево();
			Элементы.СтраницыВыгрузки.ТекущаяСтраница = Элементы.СтраницаДействияУКД;
			ПоказатьПредупреждение(, ТекстПодготовки);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Строка хода над вкладками и кнопки, которые на время сборки недоступны
// (чтение, отправка, выгрузка: их данные сборка заменит).
&НаКлиенте
Процедура ПоказатьХодСборки(Идёт)

	Элементы.ГруппаХодСборки.Видимость = Идёт;
	Если Идёт Тогда
		ХодСборки = ТекстВидаСборки(ФоноваяСборка.Вид) + НСтр("ru = ': запуск...'");
	КонецЕсли;
	ИменаКнопок = "ПоказатьУПДКнопка,ВыгрузитьКнопка,ПриходыИзБПКнопка,ПриходыБПЗагрузитьКнопка,"
		+ "ПриходыИзБПВыбратьФайлКнопка,ПриходыБПВыбратьФайлКнопка,УКДКПрошлымПриходамКнопка,"
		+ "СборкаСобратьКнопка,СборкаОтправитьКнопка,ПриходыОтправитьОтмеченныеКнопка,"
		+ "ПриходыСобратьКОтправкеКнопка,ПриходыНайтиУКДКнопка,АктСобратьВВыгрузкуКнопка,"
		+ "ЗагрузитьАктКнопка,ПриходыБПСброситьКнопка,ПодготовитьКОтправкеКнопка,ДействияВыгрузитьКнопка,"
		+ "ПоискНайтиКнопка,ПоискОтправитьКнопка";
	Для Каждого ИмяКнопки Из СтрРазделить(ИменаКнопок, ",") Цикл
		Кнопка = Элементы.Найти(ИмяКнопки);
		Если Кнопка <> Неопределено Тогда
			Кнопка.Доступность = НЕ Идёт;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Идёт фоновая сборка - предупреждение и Истина (команду не выполнять).
&НаКлиенте
Функция СборкаИдёт()

	Если ФоноваяСборка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Идёт %1 в фоне - дождитесь окончания (ход - над вкладками) или нажмите «Остановить сборку».'"),
		НРег(ТекстВидаСборки(ФоноваяСборка.Вид))));

	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ТекстВидаСборки(Вид)

	Если Вид = "ПриходыБП" Тогда
		Возврат НСтр("ru = 'Сверка «Приходы из БП»'");
	ИначеЕсли Вид = "Сборка" Тогда
		Возврат НСтр("ru = 'Сборка («Собрать»)'");
	КонецЕсли;

	Возврат НСтр("ru = 'Чтение УПД и УКД («Показать»)'");

КонецФункции

// Ответ на «сборка уже идёт (другая форма) - остановить?».
&НаКлиенте
Процедура ОстановитьДругуюСборкуОтвет(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ОстановитьСборкуПоКлючуНаСервере());

КонецПроцедуры

// Запуск сборки в фоне. Структура: Запущено, УжеИдёт (сборка с тем же ключом
// идёт - Текст), Ид, Адрес, Статус, Ошибка - задания; не запущено - собрано
// здесь же, ТекстИтога - итог (для «ПриходыБП») и причина.
&НаСервере
Функция ЗапуститьСборкуНаСервере(Знач Вид, Знач АдресФайла, Знач ИмяФайла)

	Ответ = Новый Структура("Запущено, УжеИдёт, Ид, Адрес, Статус, Ошибка, Текст, ТекстИтога",
		Ложь, Ложь, Неопределено, "", "", "", "", "");
	ТекстУжеИдёт = НСтр("ru = 'Сборка этого пользователя уже идёт в фоне (другая форма обработки или не закрытая прошлая).'");

	ФайлБП = Неопределено;
	Если Вид = "ПриходыБП" Тогда
		ФайлБП = ПолучитьИзВременногоХранилища(АдресФайла);
		УдалитьИзВременногоХранилища(АдресФайла);
		Если ТипЗнч(ФайлБП) <> Тип("ДвоичныеДанные") Тогда
			Ответ.ТекстИтога = НСтр("ru = 'Файл не получен - выберите его ещё раз.'");
			Возврат Ответ;
		КонецЕсли;
	КонецЕсли;

	Ключ = КлючСборки();
	Если ЕстьАктивнаяСборка(Ключ) Тогда
		Ответ.УжеИдёт = Истина;
		Ответ.Текст = ТекстУжеИдёт;
		Возврат Ответ;
	КонецЕсли;

	Обработка = РеквизитФормыВЗначение("Объект");
	Попытка
		ОписаниеОбработки = ВнешняяОбработкаДляФона(Обработка);
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Сборка УПД и УКД для БП (ВыгрузкаИзУт)'");
		ПараметрыВыполнения.КлючФоновогоЗадания = Ключ;
		ПараметрыВыполнения.ОжидатьЗавершение = 0;
		ПараметрыВыполнения.ВнешнийОтчетОбработка = ОписаниеОбработки;
		Операция = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			ИмяОбработкиДляФона(Обработка) + ".МодульОбъекта.СобратьВФоне",
			ПараметрыСборки(Вид, ФайлБП));
		Ответ.Запущено = Истина;
		Ответ.Ид = Операция.ИдентификаторЗадания;
		Ответ.Адрес = Операция.АдресРезультата;
		Ответ.Статус = Операция.Статус;
		Если Операция.Статус = "Ошибка" Тогда
			Ответ.Ошибка = ЗначениеПоля(Операция, "КраткоеПредставлениеОшибки");
		КонецЕсли;
		ЗаписьЖурналаРегистрации("ОбменУТ.ВыгрузкаВБух", УровеньЖурналаРегистрации.Информация, , ,
			"Сборка в фоне запущена: " + Вид);
		Возврат Ответ;
	Исключение
		Причина = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если СтрНайти(НРег(Причина), "ключа уже выполняется") > 0 Тогда
		Ответ.УжеИдёт = Истина;
		Ответ.Текст = ТекстУжеИдёт;
		Возврат Ответ;
	КонецЕсли;

	// Фон недоступен - как раньше, сразу
	ЗаписьЖурналаРегистрации("ОбменУТ.ВыгрузкаВБух", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Сборка не в фоне: " + Причина);
	ТекстПричины = НСтр("ru = '(собрано не в фоне: '") + Причина + ")";
	Если Вид = "ПриходыБП" Тогда
		Ответ.ТекстИтога = ПриходыБПСразу(ФайлБП, ИмяФайла) + Символы.ПС + ТекстПричины;
	ИначеЕсли Вид = "Сборка" Тогда
		СборкаСобратьНаСервере();
		ИнформацияСборки = ИнформацияСборки + Символы.ПС + ТекстПричины;
	Иначе
		ПрочитатьНаСервере();
		Информация = Информация + Символы.ПС + ТекстПричины;
	КонецЕсли;

	Возврат Ответ;

КонецФункции

// «Собирать в фоне» снята - как до фона.
&НаСервере
Функция СобратьСразуНаСервере(Знач Вид, Знач АдресФайла, Знач ИмяФайла)

	Если Вид = "ПриходыБП" Тогда
		Возврат ЗагрузитьПриходыБПНаСервере(АдресФайла, ИмяФайла);
	ИначеЕсли Вид = "Сборка" Тогда
		СборкаСобратьНаСервере();
	Иначе
		ПрочитатьНаСервере();
	КонецЕсли;

	Возврат "";

КонецФункции

// Параметры СобратьВФоне объекта - с формы.
&НаСервере
Функция ПараметрыСборки(Вид, ФайлБП = Неопределено)

	ПараметрыЧтения = Новый Структура("Вид, ПапкаОбмена, СверятьУКДСФайлом, ОтправлятьБезДоговора, ПериодС, ПериодПо,
		|БезПроверкиПодписи, СтарыеУКД, ФайлБП, ЕстьПрочитанные",
		Вид, СокрЛП(Папка), СверятьУКДСФайлом, ОтправлятьБезДоговора, ПериодС, ПериодПо,
		БезПроверкиПодписи, СтарыеУКД ИЛИ ТолькоУКД, ФайлБП, Ложь);
	Если Вид = "Сборка" Тогда
		ПараметрыЧтения.ПериодС = СборкаПериодС;
		ПараметрыЧтения.ПериодПо = СборкаПериодПо;
		ПараметрыЧтения.СтарыеУКД = Истина;
	ИначеЕсли Вид = "ПриходыБП" Тогда
		ПараметрыЧтения.ЕстьПрочитанные = ЗначениеЗаполнено(АдресДанных)
			И ПолучитьИзВременногоХранилища(АдресДанных) <> Неопределено;
	КонецЕсли;

	Возврат ПараметрыЧтения;

КонецФункции

// Результат фоновой сборки - в таблицы формы; возвращает итог (для «ПриходыБП»).
&НаСервере
Функция ПрименитьСборкуНаСервере(Знач Вид, Знач Адрес, Знач ИмяФайла)

	Итог = Неопределено;
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		Итог = ПолучитьИзВременногоХранилища(Адрес);
		УдалитьИзВременногоХранилища(Адрес);
	КонецЕсли;
	Если ТипЗнч(Итог) <> Тип("Структура") Тогда
		Текст = НСтр("ru = 'Результат сборки не получен - повторите (или снимите «Собирать в фоне»).'");
		Если Вид = "ПриходыБП" Тогда
			ИнформацияПриходыБП = Текст;
		ИначеЕсли Вид = "Сборка" Тогда
			ИнформацияСборки = Текст;
		Иначе
			Информация = Текст;
		КонецЕсли;
		Возврат Текст;
	КонецЕсли;

	Если Вид = "ПриходыБП" Тогда
		Возврат ПрименитьПриходыБПСборки(Итог, ИмяФайла);
	ИначеЕсли Вид = "Сборка" Тогда
		ПрименитьПрочитанноеСборки(Итог.Прочитано);
	Иначе
		ПрименитьПрочитанное(Итог.Прочитано);
	КонецЕсли;

	Возврат "";

КонецФункции

// Статус задания (как ДлительныеОперации.ЗаданиеВыполнено с расширенным
// результатом) и последний ход (СообщитьХод объекта).
&НаСервереБезКонтекста
Функция СостояниеСборки(Знач Ид)

	Ответ = Новый Структура("Статус, Ошибка, Ход", "Выполняется", "", "");
	Попытка
		Операция = ДлительныеОперации.ЗаданиеВыполнено(Ид, Истина);
		Ответ.Статус = Операция.Статус;
		Если ТипЗнч(Операция.ИнформацияОбОшибке) = Тип("ИнформацияОбОшибке") Тогда
			Ответ.Ошибка = КраткоеПредставлениеОшибки(Операция.ИнформацияОбОшибке);
		КонецЕсли;
		Прогресс = ДлительныеОперации.ПрочитатьПрогресс(Ид);
		Если ТипЗнч(Прогресс) = Тип("Структура") И Прогресс.Свойство("Текст") Тогда
			Ответ.Ход = Строка(Прогресс.Текст);
		КонецЕсли;
	Исключение
		Ответ.Статус = "Ошибка";
		Ответ.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Ответ;

КонецФункции

&НаСервереБезКонтекста
Процедура ОтменитьСборкуНаСервере(Знач Ид)

	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ДлительныеОперации.ОтменитьВыполнениеЗадания(Ид);
		ЗаписьЖурналаРегистрации("ОбменУТ.ВыгрузкаВБух", УровеньЖурналаРегистрации.Информация, , ,
			"Сборка в фоне остановлена");
	Исключение
		ЗаписьЖурналаРегистрации("ОбменУТ.ВыгрузкаВБух", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Сборка в фоне не остановлена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Ключ фонового задания сборки: одна сборка на пользователя.
&НаСервереБезКонтекста
Функция КлючСборки()

	Возврат "ВыгрузкаИзУт.Сборка." + ИмяПользователя();

КонецФункции

&НаСервереБезКонтекста
Функция ЕстьАктивнаяСборка(Ключ)

	Попытка
		Задания = ФоновыеЗадания.ПолучитьФоновыеЗадания(
			Новый Структура("Ключ, Состояние", Ключ, СостояниеФоновогоЗадания.Активно));
	Исключение
		// Нет права смотреть задания - повторный запуск отсечёт ключ задания
		ЗаписьЖурналаРегистрации("ОбменУТ.ВыгрузкаВБух", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Активные сборки не проверены: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Возврат Задания.Количество() > 0;

КонецФункции

// Остановить сборку этого пользователя, запущенную из другой формы.
&НаСервереБезКонтекста
Функция ОстановитьСборкуПоКлючуНаСервере()

	Попытка
		Задания = ФоновыеЗадания.ПолучитьФоновыеЗадания(
			Новый Структура("Ключ, Состояние", КлючСборки(), СостояниеФоновогоЗадания.Активно));
		Для Каждого Задание Из Задания Цикл
			Задание.Отменить();
		КонецЦикла;
	Исключение
		Возврат НСтр("ru = 'Сборка не остановлена: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ЗаписьЖурналаРегистрации("ОбменУТ.ВыгрузкаВБух", УровеньЖурналаРегистрации.Информация, , ,
		"Остановлена сборка из другой формы, заданий: " + Задания.Количество());

	Возврат ?(Задания.Количество() > 0,
		НСтр("ru = 'Прежняя сборка остановлена - нажмите команду ещё раз.'"),
		НСтр("ru = 'Активной сборки уже нет - нажмите команду ещё раз.'"));

КонецФункции

#КонецОбласти

#Область ПоискУПДУКД

// Вкладка «Поиск УПД / УКД» (16.10.2026): конкретная УПД или УКД - по номеру
// (часть номера) или идентификатору СБИС, контрагент - по желанию; в реестрах УТ
// за 2 года, вне периода «Показать». Найденный документ - с цепочкой (УПД и
// её УКД). «Отправить в Бух» - отмеченные одним файлом; проверки - в БП.

&НаКлиенте
Процедура ПоискНайти(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;
	Если СтрДлина(СокрЛП(ПоискНомер)) < 2 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите номер УПД / УКД (хотя бы 2 символа) или идентификатор СБИС.'"));
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Ищем УПД / УКД в реестрах УТ...'"));
	ПоискНайтиНаСервере();
	Состояние();

КонецПроцедуры

&НаСервере
Процедура ПоискНайтиНаСервере()

	ПоискДокументы.Очистить();
	Обработка = ОбъектДляЧтения();
	Результат = Обработка.НайтиДокументыПоНомеру(ПоискНомер, ПоискКонтрагент, БезПроверкиПодписи);
	Если НЕ Результат.Успех Тогда
		ИнформацияПоиска = Результат.Ошибка;
		Возврат;
	КонецЕсли;

	// Сверка с файлом приходов БП (если загружен) - «есть в БП» справочно
	Сверка = Неопределено;
	Если ЗначениеЗаполнено(АдресПриходовБП) Тогда
		Сверка = ПолучитьИзВременногоХранилища(АдресПриходовБП);
	КонецЕсли;
	Обработка.ОтметитьЕстьВБП(Результат.Документы, Сверка);

	Если ЗначениеЗаполнено(АдресПоиска) Тогда
		УдалитьИзВременногоХранилища(АдресПоиска);
	КонецЕсли;
	АдресПоиска = ПоместитьВоВременноеХранилище(Результат.Документы, УникальныйИдентификатор);

	Для Каждого Элемент Из Результат.Документы Цикл
		Описание = Элемент.Описание;
		СтрокаПоиска = ПоискДокументы.Добавить();
		СтрокаПоиска.Вид = Элемент.Вид;
		СтрокаПоиска.Номер = Описание.Номер;
		СтрокаПоиска.Дата = Описание.Дата;
		СтрокаПоиска.Контрагент = Описание.Контрагент;
		СтрокаПоиска.Сумма = ?(Элемент.Вид = "УКД", Описание.Сумма - Описание.СуммаДо, Описание.Сумма);
		СтрокаПоиска.Цепочка = Описание.Цепочка;
		СтрокаПоиска.Идентификатор = Элемент.Идентификатор;
		Найден = Результат.Найденные.Получить(ВРег(СокрЛП(Элемент.Идентификатор))) <> Неопределено;
		// Из УТ уходит всё ещё не выгруженное, проверки - в БП
		СтрокаПоиска.Отметка = НЕ Описание.Выгружена И Элемент.Данные <> Неопределено;
		Состояния = Новый Массив;
		Состояния.Добавить(?(Найден, НСтр("ru = 'найден'"), НСтр("ru = 'в цепочке найденного'")));
		Если Элемент.Вид = "УКД" Тогда
			Состояния.Добавить(ТекстЗнакаИзменения(СтрокаПоиска.Сумма));
		КонецЕсли;
		Если Описание.Выгружена Тогда
			Состояния.Добавить(НСтр("ru = 'уже выгружался'"));
		КонецЕсли;
		Если ЕстьВБП(Описание) Тогда
			Состояния.Добавить(НСтр("ru = 'есть в БП: '") + Описание.ДокументБП + НСтр("ru = ' (уйдёт - БП второй раз не создаст)'"));
		КонецЕсли;
		Если Элемент.Данные = Неопределено Тогда
			Состояния.Добавить(НСтр("ru = 'не собран - не уйдёт: '") + КраткаяПричинаУТ(Описание.Проверка));
		ИначеЕсли Описание.Ошибка Тогда
			Состояния.Добавить(НСтр("ru = 'проверьте (уйдёт, решит БП): '") + КраткаяПричинаУТ(Описание.Проверка));
		КонецЕсли;
		СтрокаПоиска.Результат = СтрСоединить(Состояния, "; ");
		СтрокаПоиска.Итог = ?(Элемент.Данные = Неопределено, 2,
			?(Описание.Выгружена ИЛИ ЕстьВБП(Описание), 3, ?(Описание.Ошибка ИЛИ Описание.Внимание, 1, 0)));
	КонецЦикла;

	ИнформацияПоиска = СтрШаблон(НСтр("ru = 'Найдено в реестрах УТ: %1; документов с цепочками: %2. Отметьте нужные и «Отправить в БП».'"),
		Результат.Найдено.Количество(), Результат.Документы.Количество())
		+ ?(Результат.Пояснения.Количество() = 0, "", Символы.ПС + СтрСоединить(Результат.Пояснения, Символы.ПС));

КонецПроцедуры

&НаКлиенте
Процедура ПоискОтправить(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Папка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите папку обмена с БП.'"));
		Возврат;
	КонецЕсли;
	Отмечено = 0;
	Для Каждого СтрокаПоиска Из ПоискДокументы Цикл
		Если СтрокаПоиска.Отметка Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте документы для отправки.'"));
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПоискОтправитьЗавершение", ЭтотОбъект),
		СтрШаблон(НСтр("ru = 'Отправить в БП отмеченные документы (%1) одним файлом в папку %2? Проверки - в БП при создании.'"), Отмечено, Папка),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура ПоискОтправитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Пишем файл...'"));
	Текст = ПоискОтправитьНаСервере();
	Состояние();
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

&НаСервере
Функция ПоискОтправитьНаСервере()

	Найденные = ?(ЗначениеЗаполнено(АдресПоиска), ПолучитьИзВременногоХранилища(АдресПоиска), Неопределено);
	Если Найденные = Неопределено Тогда
		Возврат НСтр("ru = 'Данные устарели - нажмите «Найти».'");
	КонецЕсли;
	Отмеченные = Новый Соответствие;
	Для Каждого СтрокаПоиска Из ПоискДокументы Цикл
		Если СтрокаПоиска.Отметка Тогда
			Отмеченные.Вставить(СтрокаПоиска.Идентификатор, Истина);
		КонецЕсли;
	КонецЦикла;

	НакладныеКОтправке = Новый Массив;
	КорректировкиКОтправке = Новый Массив;
	Пропущено = 0;
	ДатаС = '00010101';
	ДатаПо = '00010101';
	Для Каждого Элемент Из Найденные Цикл
		Если Отмеченные.Получить(Элемент.Идентификатор) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Элемент.Данные = Неопределено Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Если Элемент.Вид = "УКД" Тогда
			КорректировкиКОтправке.Добавить(Элемент.Данные);
		Иначе
			НакладныеКОтправке.Добавить(Элемент.Данные);
		КонецЕсли;
		Если ЗначениеЗаполнено(Элемент.Описание.Дата) Тогда
			ДатаС = ?(ЗначениеЗаполнено(ДатаС), Мин(ДатаС, Элемент.Описание.Дата), Элемент.Описание.Дата);
			ДатаПо = Макс(ДатаПо, Элемент.Описание.Дата);
		КонецЕсли;
	КонецЦикла;
	Если НакладныеКОтправке.Количество() + КорректировкиКОтправке.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Отправлять нечего: отмеченные не собраны.'");
	КонецЕсли;

	Результат = ОбъектДляЧтения().ВыгрузитьВПапку(Папка, НакладныеКОтправке, КорректировкиКОтправке, ДатаС, ДатаПо);
	Если НЕ Результат.Успех Тогда
		Возврат Результат.Ошибка;
	КонецЕсли;
	СохранитьНастройку("Папка", СокрЛП(Папка));

	Выгружены = Новый Соответствие;
	Для Каждого Идентификатор Из Результат.Выгружены Цикл
		Выгружены.Вставить(Идентификатор, Истина);
	КонецЦикла;
	Для Каждого Элемент Из Найденные Цикл
		Если Выгружены.Получить(Элемент.Идентификатор) <> Неопределено Тогда
			Элемент.Описание.Выгружена = Истина;
		КонецЕсли;
	КонецЦикла;
	ПоместитьВоВременноеХранилище(Найденные, АдресПоиска);
	Для Каждого СтрокаПоиска Из ПоискДокументы Цикл
		Если Выгружены.Получить(СтрокаПоиска.Идентификатор) <> Неопределено Тогда
			СтрокаПоиска.Отметка = Ложь;
			СтрокаПоиска.Результат = НСтр("ru = 'Отправлено: '") + Результат.ИмяФайла;
			СтрокаПоиска.Итог = 3;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон(НСтр("ru = 'Отправлено УПД: %1, УКД: %2 (не собраны - не ушли: %3). Файл: %4. Дальше - в БП: «Прочитать», проверки и «Создать».'"),
		Результат.Накладных, Результат.Корректировок, Пропущено, Результат.ПутьКФайлу) + ТекстЗамечанийУКД(Результат);

КонецФункции

#КонецОбласти

#Область ПриходыИзБП

// Вкладка «Приходы из БП»: файл ПоступленияБП_*.json (ВыгрузкаБух в БП,
// «Выгрузить приходы для УТ»). Поступлениям и корректировкам БП ищется пара в
// реестрах УТ (СопоставитьПоступленияБП), документы УТ читаются за период
// файла, то, что уже есть в БП, в дереве «Что выгружаем» не отмечается и в
// файл не уходит (ОтметитьЕстьВБП); УКД к поступлению БП уходит со ссылкой на
// него - БП вносит её именно туда и проверяет привязку. В базу ничего не пишется.

// «Приходы из БП»: последний файл ПоступленияБП_*.json из подпапки
// ПоступленияБП папки обмена (папку видит сервер) - без диалога; файла нет или
// папка не видна - выбор файла, как раньше.
&НаКлиенте
Процедура ПриходыИзБП(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Папка) Тогда
		ПриходыИзБПВыбратьФайл(Команда);
		Возврат;
	КонецЕсли;
	ФайлПриходов = ПоследнийФайлПриходовБП();
	Если ФайлПриходов = Неопределено Тогда
		ПриходыИзБПВыбратьФайл(Команда);
		Возврат;
	КонецЕсли;

	НачатьСборку("ПриходыБП", ФайлПриходов.Адрес, ФайлПриходов.ИмяФайла, ФайлПриходов.Текст);

КонецПроцедуры

// Последний (по времени изменения) ПоступленияБП_*.json в <папка>\ПоступленияБП
// - во временное хранилище, загрузка как из диалога. Структура (Адрес,
// ИмяФайла, Текст - строка в начало итога); нет файла - Неопределено (тогда
// диалог).
&НаСервере
Функция ПоследнийФайлПриходовБП()

	Каталог = СокрЛП(Папка);
	Если Прав(Каталог, 1) <> "\" И Прав(Каталог, 1) <> "/" Тогда
		Каталог = Каталог + ПолучитьРазделительПути();
	КонецЕсли;
	Каталог = Каталог + "ПоступленияБП";
	Попытка
		Файлы = НайтиФайлы(Каталог, "ПоступленияБП_*.json", Ложь);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Последний = Неопределено;
	Для Каждого Файл Из Файлы Цикл
		Если Последний = Неопределено ИЛИ Файл.ПолучитьВремяИзменения() > Последний.ПолучитьВремяИзменения() Тогда
			Последний = Файл;
		КонецЕсли;
	КонецЦикла;
	Если Последний = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(Последний.ПолноеИмя), УникальныйИдентификатор);

	Возврат Новый Структура("Адрес, ИмяФайла, Текст", Адрес, Последний.ПолноеИмя,
		СтрШаблон(НСтр("ru = 'Файл приходов БП: %1 (изменён %2). Другой - «Приходы из БП (выбрать файл)…».'"),
			Последний.Имя, Формат(Последний.ПолучитьВремяИзменения(), "ДЛФ=DT")) + Символы.ПС);

КонецФункции

// Выбор файла приходов БП вручную (как было до 15.10.2026).
&НаКлиенте
Процедура ПриходыИзБПВыбратьФайл(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Файл приходов БП (подпапка ПоступленияБП папки обмена)'");
	ПараметрыДиалога.Фильтр = НСтр("ru = 'Приходы БП (*.json)|*.json'");
	ПараметрыДиалога.МножественныйВыбор = Ложь;

	НачатьПомещениеФайлаНаСервер(Новый ОписаниеОповещения("ПриходыИзБПФайлПомещен", ЭтотОбъект), , , ,
		ПараметрыДиалога, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПриходыИзБПФайлПомещен(ОписаниеФайла, ДополнительныеПараметры) Экспорт

	Если ОписаниеФайла = Неопределено ИЛИ ОписаниеФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;
	Адрес = ОписаниеФайла.Адрес;
	ВыбранноеИмяФайла = ОписаниеФайла.СсылкаНаФайл.Имя;

	НачатьСборку("ПриходыБП", Адрес, ВыбранноеИмяФайла);

КонецПроцедуры

// Объект обработки для чтения / выгрузки: папка обмена (кэш файлов УКД) и
// сверка УКД с файлом СБИС при чтении - с формы.
&НаСервере
Функция ОбъектДляЧтения()

	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ПапкаОбмена = СокрЛП(Папка);
	Обработка.СверятьУКДСФайломПриЧтении = СверятьУКДСФайлом;
	Обработка.ОтправлятьБезДоговора = ОтправлятьБезДоговора;

	Возврат Обработка;

КонецФункции

// «Отправлять без договора»: запоминается; УПД без договора помечаются при
// чтении - перечитать («Показать» / «Собрать» / «Приходы из БП»).
&НаКлиенте
Процедура ОтправлятьБезДоговораПриИзменении(Элемент)

	СохранитьНастройкуБезДоговора(ОтправлятьБезДоговора);
	ПоказатьПредупреждение(, ?(ОтправлятьБезДоговора,
		НСтр("ru = 'УПД без договора поставщика в УТ будут уходить в БП: договор там подберётся или создастся основной, срока оплаты нет, комментарий документа пустой (в БП комментарий - только дата платежа и черта). Нажмите «Показать» (на «Сборке» - «Собрать»), чтобы перечитать.'"),
		НСтр("ru = 'УПД без договора снова не отправляются. Нажмите «Показать» (на «Сборке» - «Собрать»), чтобы перечитать.'")));

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкуБезДоговора(Значение)

	СохранитьНастройку("ОтправлятьБезДоговора", Значение);

КонецПроцедуры

// Замечания сверки выгружаемых УКД с файлом СБИС (ВыгрузитьВПапку) - текстом.
&НаСервереБезКонтекста
Функция ТекстЗамечанийУКД(Результат)

	Если НЕ Результат.Свойство("ЗамечанияУКД") ИЛИ Результат.ЗамечанияУКД.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Символы.ПС + НСтр("ru = 'Сверка выгруженных УКД с файлом СБИС (изменение взято по файлу):'") + Символы.ПС
		+ СтрСоединить(Результат.ЗамечанияУКД, Символы.ПС);

КонецФункции

&НаСервере
Функция ЗагрузитьПриходыБПНаСервере(Знач Адрес, Знач ИмяФайла)

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	УдалитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Возврат НСтр("ru = 'Файл не получен - выберите его ещё раз.'");
	КонецЕсли;

	Возврат ПриходыБПСразу(ДвоичныеДанные, ИмяФайла);

КонецФункции

// «Приходы из БП» не в фоне: сверка и документы УТ (СобратьВФоне) здесь же.
&НаСервере
Функция ПриходыБПСразу(ДвоичныеДанные, ИмяФайла)

	Возврат ПрименитьПриходыБПСборки(ОбъектДляЧтения().СобратьВФоне(ПараметрыСборки("ПриходыБП", ДвоичныеДанные)), ИмяФайла);

КонецФункции

// Результат сборки «ПриходыБП» (СобратьВФоне - здесь или в фоне) - в форму:
// сверка, период, документы УТ, таблицы. Возвращает итог для предупреждения.
&НаСервере
Функция ПрименитьПриходыБПСборки(Итог, ИмяФайла)

	НачалоЗагрузки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Сверка = Итог.Сверка;
	Если НЕ Итог.Успех Тогда
		ИнформацияПриходыБП = Итог.Ошибка;
		Возврат Итог.Ошибка;
	КонецЕсли;
	ФайлСверки = Новый Файл(ИмяФайла);
	Сверка.Вставить("Файл", ФайлСверки.Имя);
	Если ЗначениеЗаполнено(Сверка.ПериодС) Тогда
		ПриходыОтправкаС = НачалоДня(Сверка.ПериодС);
		ПриходыОтправкаПо = ?(ЗначениеЗаполнено(Сверка.ПериодПо), НачалоДня(Сверка.ПериодПо), '00010101');
	КонецЕсли;
	АдресПриходовБП = ПоместитьВоВременноеХранилище(Сверка, УникальныйИдентификатор);

	// Документы УТ - за период файла БП (так в таблицу попадут УПД периода и
	// цепочки УКД к их поступлениям); период файла внутри уже прочитанного -
	// не перечитывались (решает СобратьВФоне)
	ТекстПериода = "";
	Если Итог.ВнутриПрочитанного Тогда
		ТекстПериода = СтрШаблон(НСтр("ru = 'Период файла БП %1 - %2 внутри уже прочитанного периода УТ - документы УТ не перечитывались.'"),
			Формат(ПриходыОтправкаС, "ДЛФ=D"), Формат(ПриходыОтправкаПо, "ДЛФ=D")) + Символы.ПС;
	ИначеЕсли Итог.ПериодИзменён Тогда
		ПериодС = Итог.ПериодС;
		ПериодПо = Итог.ПериодПо;
		СохранитьНастройку("ПериодС", ПериодС);
		СохранитьНастройку("ПериодПо", ПериодПо);
		ТекстПериода = СтрШаблон(НСтр("ru = 'Период УТ - как у файла БП: %1 - %2, документы УТ прочитаны заново.'"),
			Формат(ПериодС, "ДЛФ=D"), Формат(ПериодПо, "ДЛФ=D")) + Символы.ПС;
		АдресДанных = "";
	КонецЕсли;

	Если Итог.Прочитано <> Неопределено Тогда
		ПрименитьПрочитанное(Итог.Прочитано);
	Иначе
		Данные = Неопределено;
		Если ЗначениеЗаполнено(АдресДанных) Тогда
			Данные = ПолучитьИзВременногоХранилища(АдресДанных);
		КонецЕсли;
		Если Данные = Неопределено Тогда
			// Прочитанное устарело, пока шла сверка - читаем здесь
			ПрочитатьНаСервере();
		Иначе
			ПрименитьПриходыБП(Данные);
			ПоместитьВоВременноеХранилище(Данные, АдресДанных);
			ЗаполнитьТаблицуБезСбоя(Данные);
		КонецЕсли;
	КонецЕсли;

	Подсказка = "";
	Если НЕ СтарыеУКД И НЕ ТолькоУКД Тогда
		Подсказка = Символы.ПС + НСтр("ru = 'Непривязанные и старые УКД к этим поступлениям - галочкой «Старые УКД» и «Показать».'");
	КонецЕсли;
	ТекстЗамераЗагрузки = СтрШаблон(НСтр("ru = 'Замер «Приходы из БП»: сборка %1 с, таблицы формы %2 с. Сверка с файлом: %3'"),
		Формат(Итог.Секунд, "ЧДЦ=1; ЧН=0"),
		Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗагрузки) / 1000, "ЧДЦ=1; ЧН=0"),
		ЗначениеПоля(Сверка, "Замер"));
	ИнформацияПриходыБП = ИнформацияПриходыБП + Символы.ПС + ТекстЗамераЗагрузки;

	Возврат ТекстПериода + ИнформацияПриходыБП + Подсказка;

КонецФункции

&НаКлиенте
Процедура СброситьПриходыБП(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;

	СброситьПриходыБПНаСервере();
	РазвернутьДерево();

КонецПроцедуры

&НаСервере
Процедура СброситьПриходыБПНаСервере()

	Если ЗначениеЗаполнено(АдресПриходовБП) Тогда
		УдалитьИзВременногоХранилища(АдресПриходовБП);
	КонецЕсли;
	АдресПриходовБП = "";

	Данные = Неопределено;
	Если ЗначениеЗаполнено(АдресДанных) Тогда
		Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	КонецЕсли;
	Если Данные = Неопределено Тогда
		ПрименитьПриходыБП(Новый Массив);
		Возврат;
	КонецЕсли;

	ПрименитьПриходыБП(Данные);
	ПоместитьВоВременноеХранилище(Данные, АдресДанных);
	ЗаполнитьТаблицуБезСбоя(Данные);

КонецПроцедуры

// Сверка с файлом поступлений БП (если загружен): отметки «есть в БП» на
// документах (в самих данных - их же берёт выгрузка) и таблица «Приходы из
// БП». Файла нет - отметки снимаются.
&НаСервере
Процедура ПрименитьПриходыБП(Документы)

	Сверка = Неопределено;
	Если ЗначениеЗаполнено(АдресПриходовБП) Тогда
		Сверка = ПолучитьИзВременногоХранилища(АдресПриходовБП);
	КонецЕсли;

	РеквизитФормыВЗначение("Объект").ОтметитьЕстьВБП(Документы, Сверка);
	ЗаполнитьПриходыБП(Документы, Сверка);

КонецПроцедуры

// Таблица «Приходы из БП»: поступление, под ним его корректировки; у
// поступления - сколько новых УКД из УТ (в БП их нет) уйдёт к нему.
&НаСервере
Процедура ЗаполнитьПриходыБП(Документы, Сверка)

	Таблица = РеквизитФормыВЗначение("ПриходыБП");
	Таблица.Очистить();

	Если Сверка = Неопределено Тогда
		ЗначениеВРеквизитФормы(Таблица, "ПриходыБП");
		ОчиститьСвязиПриходов();
		ИнформацияПриходыБП = НСтр("ru = 'Сверка с БП без дублей: в БП (обработка ВыгрузкаБух) - «Выгрузить приходы для УТ» за период, здесь - «Приходы из БП...» и файл из подпапки ПоступленияБП папки обмена. УТ найдёт поступлениям и корректировкам БП пары в реестрах УПД / УКД и выгрузит в БП только то, чего там нет: УПД с поступлением в БП не уходит, УКД к нему уходит со ссылкой на поступление.'");
		Возврат;
	КонецЕсли;

	// Новые УКД из УТ (в БП их нет) по поступлению БП
	НовыхУКД = Новый Соответствие;
	НовыеУКДПоПоступлению = Новый Соответствие;
	УКДКПоступлению = Новый Соответствие;
	Для Каждого Элемент Из Документы Цикл
		Описание = Элемент.Описание;
		КлючПоступления = ВРег(ЗначениеПоля(Описание, "ПоступлениеБП"));
		Если Элемент.Вид = "УКД" И ЗначениеЗаполнено(КлючПоступления) И НЕ ЕстьВБП(Описание) Тогда
			Было = НовыхУКД.Получить(КлючПоступления);
			НовыхУКД.Вставить(КлючПоступления, ?(Было = Неопределено, 0, Было) + 1);
			// Что отправить к этому поступлению: номер, можно ли, почему нет
			Список = УКДКПоступлению.Получить(КлючПоступления);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				УКДКПоступлению.Вставить(КлючПоступления, Список);
			КонецЕсли;
			Можно = НЕ Описание.Ошибка И Элемент.Данные <> Неопределено И (Описание.Подписан ИЛИ БезПроверкиПодписи);
			Список.Добавить(Новый Структура("Номер, Можно, Причина, Идентификатор, Дата", Описание.Номер, Можно,
				?(Можно, "", ?(НЕ Описание.Подписан, НСтр("ru = 'не подписана'"), КраткаяПричинаУТ(Описание.Проверка))),
				Элемент.Идентификатор, ЗначениеПоля(Описание, "Дата")));
		КонецЕсли;
	КонецЦикла;

	КорректировкиПоступления = Новый Соответствие;
	Для Каждого Корректировка Из Сверка.Корректировки Цикл
		КлючПоступления = ВРег(Корректировка.ПоступлениеУИД);
		Список = КорректировкиПоступления.Получить(КлючПоступления);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			КорректировкиПоступления.Вставить(КлючПоступления, Список);
		КонецЕсли;
		Список.Добавить(Корректировка);
	КонецЦикла;

	Идентификаторы = Новый Массив;
	Для Каждого Поступление Из Сверка.Поступления Цикл
		Если ЗначениеЗаполнено(Поступление.ИдентификаторУТ) Тогда
			Идентификаторы.Добавить(Поступление.ИдентификаторУТ);
		КонецЕсли;
	КонецЦикла;
	Приходные = ПриходныеПоИдентификаторам(Идентификаторы);
	// Поступлениям без пары в УТ - приходная Далиона по входящему номеру
	ПриходныеПоНомеру = ПриходныеПоВходящимНомерам(Сверка.Поступления);

	СПарой = 0;
	БезПары = 0;
	Проверить = 0;
	КорректировокСПарой = 0;
	КорректировокБезПары = 0;
	ВсегоНовыхУКД = 0;
	ПроблемСФ = 0;
	// Отбор «Контрагент» формы (часть наименования или ИНН; из списка - и по ИНН)
	ОтборКонтрагента = ВРег(СокрЛП(Контрагент));
	ОтборИНН = ИННВыбранногоКонтрагента(Контрагент);
	Скрыто = 0;
	Для Каждого Поступление Из Сверка.Поступления Цикл
		Если ЗначениеЗаполнено(ОтборКонтрагента)
			И СтрНайти(ВРег(Поступление.Контрагент), ОтборКонтрагента) = 0
			И СтрНайти(ВРег(Поступление.КонтрагентИНН), ОтборКонтрагента) = 0
			И НЕ (ЗначениеЗаполнено(ОтборИНН) И СокрЛП(Поступление.КонтрагентИНН) = ОтборИНН) Тогда
			Скрыто = Скрыто + 1;
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ЗначениеПоля(Поступление, "ПроверкаСФ")) И НЕ СтрНачинаетсяС(ЗначениеПоля(Поступление, "ПроверкаСФ"), "СФ ОК") Тогда
			ПроблемСФ = ПроблемСФ + 1;
		КонецЕсли;

		СтрокаТаблицы = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Поступление);
		СтрокаТаблицы.ДокументУТ = Приходные.Получить(ВРег(Поступление.ИдентификаторУТ));
		ПриходнаяПоНомеру = Неопределено;
		Если НЕ ЗначениеЗаполнено(Поступление.ИдентификаторУТ) Тогда
			ПриходнаяПоНомеру = ПриходныеПоНомеру.Получить(ВРег(Поступление.УИД));
			Если ПриходнаяПоНомеру <> Неопределено Тогда
				СтрокаТаблицы.ДокументУТ = ПриходнаяПоНомеру;
				СтрокаТаблицы.Статус = СокрЛП(СтрокаТаблицы.Статус + НСтр("ru = '; УПД в УТ нет, но есть приходная Далиона по входящему номеру - бумажная или УПД не загружена из СБИС'"));
			КонецЕсли;
		КонецЕсли;
		Новых = НовыхУКД.Получить(ВРег(Поступление.УИД));
		СтрокаТаблицы.НовыхУКД = ?(Новых = Неопределено, 0, Новых);
		// Что отправить: УПД уже в БП (пара), новые УКД - можно / нельзя и почему.
		// Из реестра - УКД любой даты (НайтиУКДНетВБП), ошибки - у прочитанных
		СписокУКД = УКДКПоступлению.Получить(ВРег(Поступление.УИД));
		Если Сверка.Свойство("УКДНетВБП") Тогда
			Найденные = Сверка.УКДНетВБП.Получить(ВРег(Поступление.УИД));
			Если Найденные <> Неопределено Тогда
				Уже = Новый Соответствие;
				Если СписокУКД = Неопределено Тогда
					СписокУКД = Новый Массив;
				КонецЕсли;
				Для Каждого ОписаниеУКД Из СписокУКД Цикл
					Уже.Вставить(ВРег(ОписаниеУКД.Номер), Истина);
				КонецЦикла;
				Для Каждого Найденная Из Найденные Цикл
					Если Уже.Получить(ВРег(Найденная.Номер)) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Уже.Вставить(ВРег(Найденная.Номер), Истина);
					Можно = Найденная.Подписана ИЛИ БезПроверкиПодписи;
					СписокУКД.Добавить(Новый Структура("Номер, Можно, Причина, Идентификатор, Дата",
						Найденная.Номер + НСтр("ru = ' (вне прочитанного периода - «Найти УКД к приходам»)'"), Можно,
						?(Можно, "", НСтр("ru = 'не подписана'")), Найденная.Идентификатор, Найденная.Дата));
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		Если СписокУКД <> Неопределено Тогда
			СтрокаТаблицы.НовыхУКД = Макс(СтрокаТаблицы.НовыхУКД, СписокУКД.Количество());
		КонецЕсли;
		Части = Новый Массив;
		Нельзя = Новый Массив;
		Если СписокУКД <> Неопределено Тогда
			Для Каждого ОписаниеУКД Из СписокУКД Цикл
				Если ОписаниеУКД.Можно Тогда
					Части.Добавить(НСтр("ru = 'УКД № '") + ОписаниеУКД.Номер);
				Иначе
					Нельзя.Добавить(НСтр("ru = 'УКД № '") + ОписаниеУКД.Номер + " - " + ОписаниеУКД.Причина);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		СтрокаТаблицы.МожноОтправить = Части.Количество() > 0;
		// Что уйдёт по «Отправить отмеченные»: идентификаторы УКД, которые можно отправить, и их даты
		ИдентификаторыКОтправке = Новый Массив;
		Если СписокУКД <> Неопределено Тогда
			Для Каждого ОписаниеУКД Из СписокУКД Цикл
				Если НЕ ОписаниеУКД.Можно ИЛИ НЕ ЗначениеЗаполнено(ОписаниеУКД.Идентификатор) Тогда
					Продолжить;
				КонецЕсли;
				ИдентификаторыКОтправке.Добавить(ОписаниеУКД.Идентификатор);
				Если ТипЗнч(ОписаниеУКД.Дата) = Тип("Дата") И ЗначениеЗаполнено(ОписаниеУКД.Дата) Тогда
					СтрокаТаблицы.ДатаУКДС = ?(ЗначениеЗаполнено(СтрокаТаблицы.ДатаУКДС),
						Мин(СтрокаТаблицы.ДатаУКДС, ОписаниеУКД.Дата), ОписаниеУКД.Дата);
					СтрокаТаблицы.ДатаУКДПо = Макс(СтрокаТаблицы.ДатаУКДПо, ОписаниеУКД.Дата);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		СтрокаТаблицы.ИдентификаторыУКД = СтрСоединить(ИдентификаторыКОтправке, ";");
		Если СписокУКД <> Неопределено Тогда
			НовыеУКДПоПоступлению.Вставить(ВРег(Поступление.УИД), СписокУКД);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Поступление.ИдентификаторУТ) Тогда
			СтрокаТаблицы.ЧтоОтправить = ?(ПриходнаяПоНомеру = Неопределено,
				НСтр("ru = 'Нечего: пары в УТ нет (бумажный или другой поставщик)'"),
				НСтр("ru = 'Нечего: УПД в УТ нет, приходная Далиона есть по номеру'"));
		ИначеЕсли Части.Количество() + Нельзя.Количество() = 0 Тогда
			СтрокаТаблицы.ЧтоОтправить = НСтр("ru = 'Нечего: УПД и её УКД уже в БП'");
		Иначе
			СтрокаТаблицы.ЧтоОтправить = ?(Части.Количество() > 0, НСтр("ru = 'Отправить: '") + СтрСоединить(Части, ", "), "")
				+ ?(Нельзя.Количество() > 0, ?(Части.Количество() > 0, "; ", "") + НСтр("ru = 'Нельзя: '") + СтрСоединить(Нельзя, "; "), "");
		КонецЕсли;
		Если СтрокаТаблицы.НовыхУКД > 0 Тогда
			ВсегоНовыхУКД = ВсегоНовыхУКД + СтрокаТаблицы.НовыхУКД;
			СтрокаТаблицы.Статус = СтрокаТаблицы.Статус + СтрШаблон(
				НСтр("ru = '; новых УКД из УТ (в БП нет): %1 - уйдут к этому поступлению'"), СтрокаТаблицы.НовыхУКД);
			Если СтрокаТаблицы.Итог = 3 Тогда
				СтрокаТаблицы.Итог = 0;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Поступление.ИдентификаторУТ) Тогда
			СПарой = СПарой + 1;
		Иначе
			БезПары = БезПары + 1;
		КонецЕсли;
		Если Поступление.Итог = 1 Тогда
			Проверить = Проверить + 1;
		КонецЕсли;

		Список = КорректировкиПоступления.Получить(ВРег(Поступление.УИД));
		Если Список = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Корректировка Из Список Цикл
			СтрокаТаблицы = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Корректировка);
			СтрокаТаблицы.Вид = СтрШаблон(НСтр("ru = '   корректировка %1'"), Корректировка.Уровень);
			СтрокаТаблицы.ЧтоОтправить = ?(ЗначениеЗаполнено(Корректировка.ИдентификаторУТ),
				НСтр("ru = 'Нечего: УКД уже в БП'"), НСтр("ru = 'Нечего: пары УКД в УТ нет'"));
			Если ЗначениеЗаполнено(Корректировка.ИдентификаторУТ) Тогда
				КорректировокСПарой = КорректировокСПарой + 1;
			Иначе
				КорректировокБезПары = КорректировокБезПары + 1;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	// Счета-фактуры поставщиков за период без поступления / корректировки в файле
	СФБезДокумента = Новый Массив;
	Если Сверка.Свойство("СФБезДокумента") Тогда
		СФБезДокумента = Сверка.СФБезДокумента;
	КонецЕсли;
	Для Каждого СчетФактура Из СФБезДокумента Цикл
		Если ЗначениеЗаполнено(ОтборКонтрагента)
			И СтрНайти(ВРег(СчетФактура.Контрагент), ОтборКонтрагента) = 0
			И СтрНайти(ВРег(СчетФактура.ИНН), ОтборКонтрагента) = 0
			И НЕ (ЗначениеЗаполнено(ОтборИНН) И СокрЛП(СчетФактура.ИНН) = ОтборИНН) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Вид = НСтр("ru = 'Счёт-фактура'");
		СтрокаТаблицы.Представление = СчетФактура.Представление;
		СтрокаТаблицы.Дата = СчетФактура.Дата;
		СтрокаТаблицы.ВходящийНомер = СчетФактура.Номер;
		СтрокаТаблицы.ВходящаяДата = СчетФактура.Дата;
		СтрокаТаблицы.Контрагент = СчетФактура.Контрагент;
		СтрокаТаблицы.КонтрагентИНН = СчетФактура.ИНН;
		СтрокаТаблицы.Сумма = СчетФактура.Сумма;
		СтрокаТаблицы.Проведен = СчетФактура.Проведен;
		СтрокаТаблицы.Статус = НСтр("ru = 'Счёт-фактура поставщика за период, документа к нему в файле нет (услуги, другой документ, СФ без поступления?)'");
		СтрокаТаблицы.ПроверкаСФ = СтрШаблон(НСтр("ru = 'НДС %1, в книге покупок %2'"),
			Формат(СчетФактура.НДС, "ЧДЦ=2; ЧН=0,00"), Формат(СчетФактура.НДСВКнигеПокупок, "ЧДЦ=2; ЧН=0,00"));
		СтрокаТаблицы.Итог = 1;
	КонецЦикла;

	ЗначениеВРеквизитФормы(Таблица, "ПриходыБП");
	ЗаполнитьСвязиПриходовБП(Таблица, НовыеУКДПоПоступлению);

	ТекстСФ = "";
	Если Сверка.Свойство("ЕстьСчетаФактуры") И Сверка.ЕстьСчетаФактуры Тогда
		ТекстСФ = " " + СтрШаблон(НСтр("ru = 'Журнал СФ и книга покупок: поступлений с замечаниями по СФ %1, СФ без документа в файле %2 (колонка «Проверка СФ»).'"),
			ПроблемСФ, СФБезДокумента.Количество());
	Иначе
		ТекстСФ = " " + НСтр("ru = 'В файле нет блока счетов-фактур - выгрузите приходы из БП заново (обработка от 14.10), тогда проверятся журнал СФ и книга покупок.'");
	КонецЕсли;

	ИнформацияПриходыБП = СтрШаблон(
		НСтр("ru = 'Файл БП %1 (сформирован %2, период %3 - %4%5): поступлений %6 - пара в УТ у %7, без пары %8, проверить %9.'"),
		ЗначениеПоля(Сверка, "Файл"), Формат(Сверка.Сформирован, "ДЛФ=DT"),
		Формат(Сверка.ПериодС, "ДЛФ=D"), Формат(Сверка.ПериодПо, "ДЛФ=D"),
		?(ЗначениеЗаполнено(Сверка.ОтборКонтрагент), НСтр("ru = ', контрагент '") + Сверка.ОтборКонтрагент, ""),
		Сверка.Поступления.Количество(), СПарой, БезПары, Проверить)
		+ " " + СтрШаблон(
		НСтр("ru = 'Корректировок %1 - пара у %2, без пары %3. Новых УКД из УТ к поступлениям БП: %4. Что уже есть в БП, на вкладке «Выгрузка в БП» не отмечено и не выгружается («Есть в БП»). Двойной щелчок по строке - её цепочка там, по «Документ УТ» - приходная Далиона.'"),
		Сверка.Корректировки.Количество(), КорректировокСПарой, КорректировокБезПары, ВсегоНовыхУКД);
	ИнформацияПриходыБП = ИнформацияПриходыБП + ТекстСФ;
	Если Скрыто > 0 Тогда
		ИнформацияПриходыБП = ИнформацияПриходыБП + " " + СтрШаблон(
			НСтр("ru = 'Отбор по контрагенту «%1»: скрыто поступлений %2 (выгрузку это не меняет - что есть в БП, не уйдёт).'"),
			СокрЛП(Контрагент), Скрыто);
	КонецЕсли;

КонецПроцедуры

// Двойной щелчок: «Документ УТ» - приходная Далиона; иначе цепочка пары в
// дереве «Что выгружаем» (поиск по номеру).
// Вкладка «Связи приходов»: дерево по таблице «Приходы из БП». Строка верхнего
// уровня - поступление БП (или счёт-фактура без документа) и сводка: есть ли
// УПД в УТ, приходная Далиона (и сходится ли сумма), корректировки БП с парами
// УКД, новые УКД из УТ, которых в БП нет. Под ней - эти документы по одному.
// Итог (подсветка): 3 - всё на месте, 1 - чего-то нет / проверьте, 2 - ошибка.
// Полное дерево хранится во временном хранилище, «Только где чего-то нет»
// показывает строки с Итог <> 3.
//
// Параметры:
//   Таблица - ТаблицаЗначений - заполненная «Приходы из БП»
//   НовыеУКД - Соответствие - ВРег(УИД поступления): Массив (Номер, Можно, Причина, Идентификатор, Дата)
//
&НаСервере
Процедура ЗаполнитьСвязиПриходовБП(Таблица, НовыеУКД)

	Полное = РеквизитФормыВЗначение("СвязиПриходовБП");
	Полное.Строки.Очистить();

	// Суммы приходных Далиона
	Приходные = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.ДокументУТ) И Приходные.Найти(СтрокаТаблицы.ДокументУТ) = Неопределено Тогда
			Приходные.Добавить(СтрокаТаблицы.ДокументУТ);
		КонецЕсли;
	КонецЦикла;
	СуммыПриходных = СуммыПриходныхДалиона(Приходные);

	Всего = 0;
	ВсёНаМесте = 0;
	БезУПД = 0;
	БезПриходной = 0;
	СуммаНеСошлась = 0;
	КорректировокБезПары = 0;
	УКДКОтправке = 0;
	Узел = Неопределено;
	// Новые УКД добавляются в конце узла - после корректировок БП, которые
	// идут в таблице следом за поступлением: так видна цепочка по порядку
	НовыеУКДУзлов = Новый Соответствие;

	Для Каждого СтрокаТаблицы Из Таблица Цикл

		ЭтоКорректировка = СтрНайти(СтрокаТаблицы.Вид, "корректировка") > 0;
		Если ЭтоКорректировка И Узел <> Неопределено Тогда
			СтрокаКорр = Узел.Строки.Добавить();
			СтрокаКорр.Вид = НСтр("ru = 'Корректировка БП'") + " " + СокрЛП(СтрЗаменить(СтрокаТаблицы.Вид, "корректировка", ""));
			СтрокаКорр.Документ = СтрокаТаблицы.Представление;
			СтрокаКорр.Дата = СтрокаТаблицы.Дата;
			СтрокаКорр.Сумма = СтрокаТаблицы.Сумма;
			СтрокаКорр.НомерУТ = СтрокаТаблицы.НомерУТ;
			СтрокаКорр.ЕстьВБух = Истина;
			СтрокаКорр.ПорядокВЦепочке = Узел.Строки.Количество() - 2;
			Если ЗначениеЗаполнено(СтрокаТаблицы.ПараУТ) Тогда
				СтрокаКорр.Состояние = НСтр("ru = 'УКД в УТ: '") + СтрокаТаблицы.ПараУТ + " - " + СтрокаТаблицы.КакНайдено;
				СтрокаКорр.Итог = ?(СтрокаТаблицы.Итог = 0, 3, СтрокаТаблицы.Итог);
			Иначе
				СтрокаКорр.Состояние = НСтр("ru = 'УКД в УТ нет: '") + СтрокаТаблицы.Статус;
				СтрокаКорр.Итог = 1;
				КорректировокБезПары = КорректировокБезПары + 1;
			КонецЕсли;
			Если СтрНайти(СтрокаТаблицы.Статус, "ПРОВЕРЬТЕ") > 0 Тогда
				СтрокаКорр.Состояние = СтрокаКорр.Состояние + "; " + СтрокаТаблицы.Статус;
				СтрокаКорр.Итог = 1;
			КонецЕсли;
			УхудшитьИтог(Узел, СтрокаКорр.Итог);
			Узел.Корректировки = СтрШаблон(НСтр("ru = '%1 (пара УКД у %2)'"), Узел.Строки.Количество() - 2 - УКДУзла(Узел),
				КорректировокСПаройУзла(Узел));
			Продолжить;
		КонецЕсли;

		Всего = Всего + 1;
		Узел = Полное.Строки.Добавить();
		Узел.Вид = ?(СтрНайти(СтрокаТаблицы.Вид, "Счёт") > 0, СтрокаТаблицы.Вид, НСтр("ru = 'Поступление БП'"));
		Узел.Документ = СтрШаблон(НСтр("ru = '%1 (вх. № %2), %3'"), СтрокаТаблицы.Представление,
			СтрокаТаблицы.ВходящийНомер, СтрокаТаблицы.Контрагент);
		Узел.Дата = СтрокаТаблицы.Дата;
		Узел.Сумма = СтрокаТаблицы.Сумма;
		Узел.НомерУТ = СтрокаТаблицы.НомерУТ;
		Узел.ЕстьВБух = Истина;
		Узел.Итог = 3;
		Узел.Корректировки = "0";
		Узел.НовыеУКД = "0";
		Если НЕ СтрокаТаблицы.Проведен Тогда
			Узел.Состояние = НСтр("ru = 'в БП не проведено; '");
			Узел.Итог = 1;
		КонецЕсли;
		Если СтрокаТаблицы.Итог = 2 Тогда
			Узел.Итог = 2;
		КонецЕсли;

		Если Узел.Вид <> НСтр("ru = 'Поступление БП'") Тогда
			// Счёт-фактура без документа в файле
			Узел.Документ = СтрокаТаблицы.Представление + ", " + СтрокаТаблицы.Контрагент;
			Узел.УПДвУТ = "-";
			Узел.ПриходнаяДалион = "-";
			Узел.Состояние = СтрокаТаблицы.Статус;
			Узел.Итог = 1;
			Продолжить;
		КонецЕсли;

		// УПД в УТ
		СтрокаУПД = Узел.Строки.Добавить();
		СтрокаУПД.Вид = НСтр("ru = 'УПД в УТ'");
		СтрокаУПД.НомерУТ = СтрокаТаблицы.НомерУТ;
		// Поступление по ней в БП есть (строка из файла приходов БП)
		СтрокаУПД.ЕстьВБух = Истина;
		Если ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторУТ) Тогда
			Узел.УПДвУТ = НСтр("ru = 'Есть: '") + СтрокаТаблицы.ПараУТ;
			СтрокаУПД.Документ = СтрокаТаблицы.ПараУТ;
			СтрокаУПД.Состояние = СтрокаТаблицы.КакНайдено
				+ ?(СтрокаТаблицы.ПодписанУТ, НСтр("ru = '; подписана'"), НСтр("ru = '; не подписана'"));
			СтрокаУПД.Итог = 3;
			Если СтрНайти(СтрокаТаблицы.Статус, "ПРОВЕРЬТЕ") > 0 Тогда
				СтрокаУПД.Состояние = СтрокаУПД.Состояние + "; " + Сред(СтрокаТаблицы.Статус, СтрНайти(СтрокаТаблицы.Статус, "ПРОВЕРЬТЕ"));
				СтрокаУПД.Итог = 1;
			КонецЕсли;
		Иначе
			БезУПД = БезУПД + 1;
			Узел.УПДвУТ = НСтр("ru = 'Нет'");
			СтрокаУПД.Документ = НСтр("ru = 'нет'");
			СтрокаУПД.Состояние = СтрокаТаблицы.Статус;
			СтрокаУПД.Итог = 1;
		КонецЕсли;
		УхудшитьИтог(Узел, СтрокаУПД.Итог);

		// Приходная Далиона
		СтрокаПриходной = Узел.Строки.Добавить();
		СтрокаПриходной.Вид = НСтр("ru = 'Приходная Далиона'");
		Если ЗначениеЗаполнено(СтрокаТаблицы.ДокументУТ) Тогда
			СтрокаПриходной.Ссылка = СтрокаТаблицы.ДокументУТ;
			СтрокаПриходной.Документ = Строка(СтрокаТаблицы.ДокументУТ);
			СуммаПриходной = СуммыПриходных.Получить(СтрокаТаблицы.ДокументУТ);
			СтрокаПриходной.Сумма = ?(СуммаПриходной = Неопределено, 0, СуммаПриходной);
			Если СуммаПриходной = Неопределено ИЛИ СуммаПриходной = 0 Тогда
				СтрокаПриходной.Состояние = НСтр("ru = 'есть; сумма приходной не заполнена'");
				СтрокаПриходной.Итог = 3;
				Узел.ПриходнаяДалион = НСтр("ru = 'Есть'");
			ИначеЕсли Макс(СуммаПриходной - СтрокаТаблицы.Сумма, СтрокаТаблицы.Сумма - СуммаПриходной) < 0.01 Тогда
				СтрокаПриходной.Состояние = НСтр("ru = 'есть; сумма сходится с поступлением'");
				СтрокаПриходной.Итог = 3;
				Узел.ПриходнаяДалион = НСтр("ru = 'Есть, сумма сходится'");
			Иначе
				СуммаНеСошлась = СуммаНеСошлась + 1;
				СтрокаПриходной.Состояние = СтрШаблон(НСтр("ru = 'есть; сумма приходной %1, поступления %2 (разница %3) - часть товара не принята или были УКД'"),
					ФорматСуммы(СуммаПриходной), ФорматСуммы(СтрокаТаблицы.Сумма), ФорматСуммы(СуммаПриходной - СтрокаТаблицы.Сумма));
				СтрокаПриходной.Итог = 1;
				Узел.ПриходнаяДалион = НСтр("ru = 'Есть, сумма НЕ сходится'");
			КонецЕсли;
		Иначе
			БезПриходной = БезПриходной + 1;
			Узел.ПриходнаяДалион = НСтр("ru = 'Нет'");
			СтрокаПриходной.Документ = НСтр("ru = 'нет'");
			СтрокаПриходной.Состояние = НСтр("ru = 'в УТ нет приходной Далиона ни по УПД, ни по входящему номеру'");
			СтрокаПриходной.Итог = 1;
		КонецЕсли;
		УхудшитьИтог(Узел, СтрокаПриходной.Итог);

		// Новые УКД из УТ (в БП их нет) - в конец узла, после корректировок БП
		СписокУКД = НовыеУКД.Получить(ВРег(СтрокаТаблицы.УИД));
		Если СписокУКД <> Неопределено И СписокУКД.Количество() > 0 Тогда
			НовыеУКДУзлов.Вставить(Узел, СписокУКД);
			Узел.НовыеУКД = Формат(СписокУКД.Количество(), "ЧН=0; ЧГ=0");
			УхудшитьИтог(Узел, 1);
		КонецЕсли;

		Узел.Состояние = Узел.Состояние + СтрокаТаблицы.ЧтоОтправить;

	КонецЦикла;

	// Новые УКД - по дате, после корректировок БП: «Есть в Бух» нет,
	// «Отправить» - у тех, что можно отправить
	Для Каждого КлючЗначение Из НовыеУКДУзлов Цикл
		Узел = КлючЗначение.Ключ;
		Упорядоченные = Новый ТаблицаЗначений;
		Упорядоченные.Колонки.Добавить("Описание");
		Упорядоченные.Колонки.Добавить("Дата");
		Для Каждого ОписаниеУКД Из КлючЗначение.Значение Цикл
			СтрокаПорядка = Упорядоченные.Добавить();
			СтрокаПорядка.Описание = ОписаниеУКД;
			СтрокаПорядка.Дата = ?(ТипЗнч(ОписаниеУКД.Дата) = Тип("Дата"), ОписаниеУКД.Дата, '00010101');
		КонецЦикла;
		Упорядоченные.Сортировать("Дата");
		Порядок = Узел.Строки.Количество() - 2;
		Для Каждого СтрокаПорядка Из Упорядоченные Цикл
			ОписаниеУКД = СтрокаПорядка.Описание;
			Порядок = Порядок + 1;
			СтрокаУКД = Узел.Строки.Добавить();
			СтрокаУКД.Вид = НСтр("ru = 'УКД из УТ (в БП нет)'");
			СтрокаУКД.Документ = НСтр("ru = 'УКД № '") + ОписаниеУКД.Номер;
			СтрокаУКД.Дата = СтрокаПорядка.Дата;
			СтрокаУКД.Состояние = ?(ОписаниеУКД.Можно, НСтр("ru = 'можно отправить в БП'"),
				НСтр("ru = 'нельзя отправить: '") + ОписаниеУКД.Причина);
			СтрокаУКД.Итог = 1;
			СтрокаУКД.ЕстьВБух = Ложь;
			СтрокаУКД.МожноОтправить = ОписаниеУКД.Можно;
			СтрокаУКД.Отправить = ОписаниеУКД.Можно;
			СтрокаУКД.Идентификатор = ОписаниеУКД.Идентификатор;
			СтрокаУКД.ПорядокВЦепочке = Порядок;
			Если ОписаниеУКД.Можно Тогда
				УКДКОтправке = УКДКОтправке + 1;
				Узел.Отправить = Истина;
				Узел.МожноОтправить = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Узел Из Полное.Строки Цикл
		Если Узел.Итог = 3 Тогда
			ВсёНаМесте = ВсёНаМесте + 1;
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(АдресСвязейПриходов) Тогда
		ПоместитьВоВременноеХранилище(Полное, АдресСвязейПриходов);
	Иначе
		АдресСвязейПриходов = ПоместитьВоВременноеХранилище(Полное, УникальныйИдентификатор);
	КонецЕсли;

	ИнформацияСвязейПриходов = СтрШаблон(
		НСтр("ru = 'Строк: %1, всё на месте (зелёные): %2. Нет УПД в УТ: %3, нет приходной Далиона: %4, сумма приходной не сходится: %5. Корректировок БП без УКД в УТ: %6. Новых УКД из УТ можно отправить: %7.'"),
		Всего, ВсёНаМесте, БезУПД, БезПриходной, СуммаНеСошлась, КорректировокБезПары, УКДКОтправке)
		+ " " + НСтр("ru = 'Цепочка по порядку: поступление, корректировки БП («Есть в БП»), новые УКД из УТ (нет в БП). «Отправить» - новые УКД, которые можно отправить; «Отправить цепочку в БП» - отмеченные одним файлом (по порядку). Двойной щелчок: приходная - открыть, УПД / УКД - цепочка в «Что выгружаем».'");

	ВывестиСвязиПриходов();

КонецПроцедуры

// «Отправить» в «Связях приходов»: у поступления - все новые УКД его цепочки,
// у УКД - она одна; нельзя отправить (не подписана, ошибка) или уже в Бух -
// отметка не ставится.
&НаКлиенте
Процедура СвязиПриходовБПОтправитьПриИзменении(Элемент)

	ТекущиеДанные = Элементы.СвязиПриходовБП.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ТекущиеДанные.МожноОтправить Тогда
		ТекущиеДанные.Отправить = Ложь;
		ПоказатьПредупреждение(, ?(ТекущиеДанные.ЕстьВБух И НЕ ЗначениеЗаполнено(ТекущиеДанные.Идентификатор)
			И ТекущиеДанные.ПолучитьЭлементы().Количество() = 0,
			НСтр("ru = 'Это уже есть в БП - отправлять не нужно.'"),
			НСтр("ru = 'Отправлять нечего: новых УКД, которые можно отправить, здесь нет (см. «Состояние»).'")));
		Возврат;
	КонецЕсли;
	Для Каждого Подчиненная Из ТекущиеДанные.ПолучитьЭлементы() Цикл
		Если Подчиненная.МожноОтправить Тогда
			Подчиненная.Отправить = ТекущиеДанные.Отправить;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// «Отправить цепочку в Бух»: отмеченные новые УКД всех цепочек (по порядку
// цепочки) - сборкой ровно этих УКД и одним файлом, как «Отправить отмеченные
// в Бух» на «Приходах из БП». Что есть в Бух, не уходит; БП создаёт УКД по
// порядку цепочки после своих корректировок.
&НаКлиенте
Процедура СвязиОтправитьЦепочку(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Папка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите папку обмена с БП.'"));
		Возврат;
	КонецЕсли;

	Идентификаторы = Новый Массив;
	ДатаС = '39991231';
	ДатаПо = '00010101';
	Для Каждого Узел Из СвязиПриходовБП.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаУКД Из Узел.ПолучитьЭлементы() Цикл
			Если СтрокаУКД.Отправить И СтрокаУКД.МожноОтправить И ЗначениеЗаполнено(СтрокаУКД.Идентификатор)
				И Идентификаторы.Найти(СтрокаУКД.Идентификатор) = Неопределено Тогда
				Идентификаторы.Добавить(СтрокаУКД.Идентификатор);
				Если ЗначениеЗаполнено(СтрокаУКД.Дата) Тогда
					ДатаС = Мин(ДатаС, НачалоДня(СтрокаУКД.Дата));
					ДатаПо = Макс(ДатаПо, КонецДня(СтрокаУКД.Дата));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте «Отправить» у поступления (все его новые УКД) или у отдельных УКД.'"));
		Возврат;
	КонецЕсли;

	ПараметрыОтправки = Новый Структура("Идентификаторы, ДатаС, ДатаПо", Идентификаторы, ДатаС, ДатаПо);
	ПоказатьВопрос(Новый ОписаниеОповещения("СвязиОтправитьЦепочкуЗавершение", ЭтотОбъект, ПараметрыОтправки),
		СтрШаблон(НСтр("ru = 'Отправить в БП новые УКД цепочек: %1 одним файлом в папку %2? Что есть в БП - не уйдёт.'"),
			Идентификаторы.Количество(), Папка), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура СвязиОтправитьЦепочкуЗавершение(Ответ, ПараметрыОтправки) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Собираем УКД цепочек и пишем файл...'"));
	Текст = СвязиОтправитьЦепочкуНаСервере(ПараметрыОтправки.Идентификаторы, ПараметрыОтправки.ДатаС, ПараметрыОтправки.ДатаПо);
	Состояние();
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

&НаСервере
Функция СвязиОтправитьЦепочкуНаСервере(Знач Идентификаторы, Знач ДатаС, Знач ДатаПо)

	Если ДатаС > ДатаПо Тогда
		ДатаС = ?(ЗначениеЗаполнено(ПриходыОтправкаС), ПриходыОтправкаС, ПериодС);
		ДатаПо = ?(ЗначениеЗаполнено(ПриходыОтправкаПо), ПриходыОтправкаПо, ПериодПо);
	КонецЕсли;

	// Сборка ровно этих УКД, отметка и отправка (как «Отправить отмеченные в Бух»)
	СборкаПериодС = ДатаС;
	СборкаПериодПо = ДатаПо;
	СборкаКонтрагент = "";
	СборкаВид = "УКД";
	СборкаНомер = "";
	СборкаТолькоНет = Истина;
	СборкаТолькоИд = СтрСоединить(Идентификаторы, ";");
	СборкаСобратьНаСервере();

	Отмечено = 0;
	Для Каждого СтрокаСборки Из СборкаДокументов Цикл
		СтрокаСборки.Отметка = СтрокаСборки.МожноОтправить;
		Если СтрокаСборки.Отметка Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Отмечено = 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'УКД отмечено %1, но ни одну нельзя отправить (не подписана, ошибка, уже в БП) - см. «Сборку».'"),
			Идентификаторы.Количество());
	КонецЕсли;

	Текст = СборкаОтправитьНаСервере();

	// Отправленные - в дереве: «отправлено, ждём ответ Бух», отметка снята
	Отправленные = Новый Соответствие;
	Для Каждого СтрокаСборки Из СборкаДокументов Цикл
		Если СтрокаСборки.Отметка Тогда
			Отправленные.Вставить(СтрокаСборки.Идентификатор, Истина);
		КонецЕсли;
	КонецЦикла;
	Дерево = РеквизитФормыВЗначение("СвязиПриходовБП");
	Для Каждого Узел Из Дерево.Строки Цикл
		Для Каждого СтрокаУКД Из Узел.Строки Цикл
			Если ЗначениеЗаполнено(СтрокаУКД.Идентификатор) И Идентификаторы.Найти(СтрокаУКД.Идентификатор) <> Неопределено Тогда
				СтрокаУКД.Отправить = Ложь;
				СтрокаУКД.Состояние = НСтр("ru = 'отправлено в БП - ждём создания; затем «Выгрузить приходы для УТ» в БП и «Приходы из БП...» здесь'");
			КонецЕсли;
		КонецЦикла;
		Узел.Отправить = Ложь;
	КонецЦикла;
	ЗначениеВРеквизитФормы(Дерево, "СвязиПриходовБП");

	Возврат СтрШаблон(НСтр("ru = 'Новых УКД цепочек: %1, отправлено: %2. %3'"), Идентификаторы.Количество(), Отмечено, Текст)
		+ Символы.ПС + НСтр("ru = 'После создания в БП выгрузите приходы заново и загрузите «Приходы из БП...» - цепочки обновятся (УКД станут «Есть в БП»).'");

КонецФункции

// ============================================================================
// Вкладка «Реестр» (как в БП): вверху цепочка на строку - УПД и её УКД с
// итогом, отметка «отправить всю цепочку»; внизу - документы выбранной
// цепочки: подписан, выгружен, есть в Бух (по файлу приходов БП и ответу
// Бухгалтерии), замечания, отметка «отправить». «Отправить отмеченные» /
// «Отправить строку» - только отмеченное одним файлом. Настройки - отдельной
// формой, прежние вкладки и флажки - по «Подробно» (16.10.2026).
// ============================================================================

&НаСервере
Процедура ЗаполнитьРеестрУТ(Документы)

	ОтветыБух = ОтветыБухгалтерииРеестра(Документы);

	Цепочки = Новый Массив;
	ПоКлючу = Новый Соответствие;
	Для Каждого Элемент Из Документы Цикл
		Описание = Элемент.Описание;
		Ключ = ?(ЗначениеЗаполнено(Описание.КлючЦепочки), Описание.КлючЦепочки, ВРег(Элемент.Идентификатор));
		Цепочка = ПоКлючу.Получить(Ключ);
		Если Цепочка = Неопределено Тогда
			// Поиск - наименования и ИНН документов цепочки, Номера - их номера:
			// по ним «Реестр» отбирается полями «Контрагент» и «Номер» шапки
			Цепочка = Новый Структура("Ключ, Контрагент, НомерУПД, ДатаУПД, Документы, Поиск, Номера", Ключ,
				Описание.Контрагент, "", '00010101', Новый Массив, "|", "|");
			ПоКлючу.Вставить(Ключ, Цепочка);
			Цепочки.Добавить(Цепочка);
		КонецЕсли;

		Цепочка.Поиск = Цепочка.Поиск + ВРег(СокрЛП(Описание.Контрагент)) + "|" + СокрЛП(Описание.ИНН) + "|";
		Цепочка.Номера = Цепочка.Номера + НомерДляПоиска(Описание.Номер) + "|";

		Ответ = ОтветыБух.Получить(ВРег(СокрЛП(Элемент.Идентификатор)));
		ЕстьВБух = ЕстьВБП(Описание) ИЛИ Ответ <> Неопределено И Ответ.ОтправленоВБух;
		ДокументБух = ?(ЗначениеЗаполнено(ЗначениеПоля(Описание, "ДокументБП")), ЗначениеПоля(Описание, "ДокументБП"),
			?(Ответ = Неопределено, "", Ответ.ДокументБух));
		ЭтоУКД = Элемент.Вид = "УКД";
		СуммаДо = ?(ЭтоУКД, Описание.СуммаДо, 0);
		Цепочка.Документы.Добавить(Новый Структура(
			"Идентификатор, Вид, Представление, Порядок, СуммаДо, Изменение, СуммаПосле, Подписан, Выгружен,
			|ЕстьВБух, ДокументБух, Замечания, МожноОтправить, Ошибка, ПроведенВБух",
			Элемент.Идентификатор, Элемент.Вид,
			СтрШаблон("%1 № %2 от %3", Элемент.Вид, Описание.Номер, Формат(Описание.Дата, "ДЛФ=D")),
			?(ЭтоУКД, Описание.ПорядокВЦепочке, 0),
			СуммаДо, Описание.Сумма - СуммаДо, Описание.Сумма,
			Описание.Подписан, Описание.Выгружена, ЕстьВБух, Строка(ДокументБух),
			?(Описание.Ошибка ИЛИ Описание.Внимание, Описание.Проверка, ""),
			Элемент.Данные <> Неопределено, Описание.Ошибка, ЗначениеПоля(Описание, "ПроведенВБП") = Истина));
		Если НЕ ЭтоУКД Тогда
			Цепочка.НомерУПД = Описание.Номер;
			Цепочка.ДатаУПД = Описание.Дата;
		ИначеЕсли НЕ ЗначениеЗаполнено(Цепочка.НомерУПД) Тогда
			Цепочка.НомерУПД = ЗначениеПоля(Описание, "Основание");
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(АдресРеестраУТ) Тогда
		ПоместитьВоВременноеХранилище(Цепочки, АдресРеестраУТ);
	Иначе
		АдресРеестраУТ = ПоместитьВоВременноеХранилище(Цепочки, УникальныйИдентификатор);
	КонецЕсли;
	ОтмеченныеДокументыУТ.Очистить();
	СоставЦепочкиУТ.ПолучитьЭлементы().Очистить();

	// Выпадающий список поставщиков - из прочитанного; выбранного больше нет - все
	Поставщики = Новый СписокЗначений;
	Для Каждого Цепочка Из Цепочки Цикл
		Если ЗначениеЗаполнено(Цепочка.Контрагент) И Поставщики.НайтиПоЗначению(Цепочка.Контрагент) = Неопределено Тогда
			Поставщики.Добавить(Цепочка.Контрагент);
		КонецЕсли;
	КонецЦикла;
	Поставщики.СортироватьПоЗначению();
	СписокПоставщиков = Элементы.ОтборПоставщикРеестрПоле.СписокВыбора;
	СписокПоставщиков.Очистить();
	СписокПоставщиков.Добавить("", НСтр("ru = '(все поставщики)'"));
	Для Каждого ЭлементСписка Из Поставщики Цикл
		СписокПоставщиков.Добавить(ЭлементСписка.Значение);
	КонецЦикла;
	Если ЗначениеЗаполнено(ОтборПоставщикРеестр) И Поставщики.НайтиПоЗначению(ОтборПоставщикРеестр) = Неопределено Тогда
		ОтборПоставщикРеестр = "";
	КонецЕсли;

	ВывестиРеестрУТ();

КонецПроцедуры

// Таблица реестра из прочитанных цепочек: строка - УПД (у старой УПД, к
// которой УКД в периоде, - пометка «УПД раньше периода»), отбор - поставщик из
// выпадающего списка, пусто - все за период.
&НаСервере
Процедура ВывестиРеестрУТ()

	РеестрУТ.Очистить();
	Цепочки = ?(ЗначениеЗаполнено(АдресРеестраУТ), ПолучитьИзВременногоХранилища(АдресРеестраУТ), Неопределено);
	Если ТипЗнч(Цепочки) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	// Поиск шапки («Контрагент» - часть наименования или ИНН, «Номер») - тоже
	// отбор реестра (16.10.2026: раньше обновлялось только старое дерево)
	ОтборПоиск = ВРег(СокрЛП(Контрагент));
	ОтборИНН = ИННВыбранногоКонтрагента(Контрагент);
	НомерОтбор = НомерДляПоиска(НомерУПД);

	Для Каждого Цепочка Из Цепочки Цикл
		Если ЗначениеЗаполнено(ОтборПоставщикРеестр) И Цепочка.Контрагент <> ОтборПоставщикРеестр Тогда
			Продолжить;
		КонецЕсли;
		Поиск = ?(Цепочка.Свойство("Поиск"), Цепочка.Поиск, "|" + ВРег(Цепочка.Контрагент) + "|");
		Если ЗначениеЗаполнено(ОтборИНН) Тогда
			Если СтрНайти(Поиск, "|" + ОтборИНН + "|") = 0 И СтрНайти(Поиск, ОтборПоиск) = 0 Тогда
				Продолжить;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(ОтборПоиск) И СтрНайти(Поиск, ОтборПоиск) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(НомерОтбор) И Цепочка.Свойство("Номера")
			И СтрНайти(Цепочка.Номера + НомерДляПоиска(Цепочка.НомерУПД) + "|", НомерОтбор) = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРеестра = РеестрУТ.Добавить();
		СтрокаРеестра.Ключ = Цепочка.Ключ;
		СтрокаРеестра.Контрагент = Цепочка.Контрагент;
		СтрокаРеестра.НомерУПД = Цепочка.НомерУПД;
		СтрокаРеестра.ДатаУПД = Цепочка.ДатаУПД;
		СтрокаРеестра.УПДРаньшеПериода = ЗначениеЗаполнено(Цепочка.ДатаУПД) И ЗначениеЗаполнено(ПериодС)
			И Цепочка.ДатаУПД < НачалоДня(ПериодС);
		Итог = 0;
		Проведено = 0;
		Для Каждого Док Из Цепочка.Документы Цикл
			Если Док.Вид = "УКД" Тогда
				СтрокаРеестра.УКД = СтрокаРеестра.УКД + 1;
				Итог = Итог + Док.Изменение;
			Иначе
				СтрокаРеестра.СуммаУПД = Док.СуммаПосле;
				Итог = Итог + Док.СуммаПосле;
			КонецЕсли;
			Если Док.ЕстьВБух Тогда
				СтрокаРеестра.ВБух = СтрокаРеестра.ВБух + 1;
				Если Док.ПроведенВБух Тогда
					Проведено = Проведено + 1;
				КонецЕсли;
			КонецЕсли;
			Если Док.Выгружен Тогда
				СтрокаРеестра.Выгружено = СтрокаРеестра.Выгружено + 1;
			КонецЕсли;
			Если Док.МожноОтправить И НЕ Док.ЕстьВБух Тогда
				СтрокаРеестра.КОтправке = СтрокаРеестра.КОтправке + 1;
			КонецЕсли;
			Если ЗначениеЗаполнено(Док.Замечания) Тогда
				СтрокаРеестра.Замечаний = СтрокаРеестра.Замечаний + 1;
			КонецЕсли;
		КонецЦикла;
		СтрокаРеестра.СуммаИтог = Итог;
		Всего = Цепочка.Документы.Количество();

		// Бух: есть / нет / частично; проведён (по файлу приходов БП)
		Если СтрокаРеестра.ВБух = 0 Тогда
			СтрокаРеестра.ВБухСостояние = НСтр("ru = 'нет в БП'");
		ИначеЕсли СтрокаРеестра.ВБух = Всего Тогда
			СтрокаРеестра.ВБухСостояние = ?(Проведено = Всего, НСтр("ru = 'есть, проведён'"),
				?(Проведено = 0, НСтр("ru = 'есть, не проведён'"), СтрШаблон(НСтр("ru = 'есть, проведено %1 из %2'"), Проведено, Всего)));
		Иначе
			СтрокаРеестра.ВБухСостояние = СтрШаблон(НСтр("ru = 'в БП %1 из %2, проведено %3'"), СтрокаРеестра.ВБух, Всего, Проведено);
		КонецЕсли;

		Если СтрокаРеестра.ВБух = Всего Тогда
			СтрокаРеестра.Статус = НСтр("ru = 'Всё есть в БП'");
		ИначеЕсли СтрокаРеестра.КОтправке > 0 Тогда
			СтрокаРеестра.Статус = СтрШаблон(НСтр("ru = 'Нет в БП: %1 из %2 - можно отправить %3%4'"),
				Всего - СтрокаРеестра.ВБух, Всего, СтрокаРеестра.КОтправке,
				?(СтрокаРеестра.Выгружено > 0, СтрШаблон(НСтр("ru = ' (выгружалось %1 - ждём ответ БП)'"), СтрокаРеестра.Выгружено), ""));
		Иначе
			СтрокаРеестра.Статус = НСтр("ru = 'Нет в БП, но отправить нечего - см. замечания'");
		КонецЕсли;
		Если СтрокаРеестра.УПДРаньшеПериода Тогда
			СтрокаРеестра.Статус = НСтр("ru = 'УПД раньше периода, УКД в периоде. '") + СтрокаРеестра.Статус;
		КонецЕсли;
	КонецЦикла;

	ПодсказкаРеестрУТ = СтрШаблон(
		НСтр("ru = 'УПД: %1%2. Отметка вверху - все документы цепочки, которых нет в БП; внизу - отдельный документ. «Отправить отмеченные» / «Отправить строку» - только отмеченное, одним файлом. Проверки - в БП.'"),
		РеестрУТ.Количество(), ?(ЗначениеЗаполнено(ОтборПоставщикРеестр), НСтр("ru = ', поставщик: '") + ОтборПоставщикРеестр,
			?(ЗначениеЗаполнено(ОтборПоиск), НСтр("ru = ', контрагент: '") + СокрЛП(Контрагент), НСтр("ru = ' (все поставщики за период)'")))
			+ ?(ЗначениеЗаполнено(НомерОтбор), НСтр("ru = ', номер: '") + СокрЛП(НомерУПД), ""))
		+ ?(ЗначениеЗаполнено(ПропущеныУПД), Символы.ПС + ПропущеныУПД, "");

КонецПроцедуры

&НаКлиенте
Процедура ОтборПоставщикРеестрПриИзменении(Элемент)

	ВывестиРеестрУТ();
	СоставЦепочкиУТ.ПолучитьЭлементы().Очистить();

КонецПроцедуры

// Ответы Бухгалтерии в реестрах УПД / УКД (поля расширения ОтправленоВБух,
// ДокументБух; нет полей - пусто).
&НаСервере
Функция ОтветыБухгалтерииРеестра(Документы)

	Результат = Новый Соответствие;
	Идентификаторы = Новый Массив;
	Для Каждого Элемент Из Документы Цикл
		Идентификаторы.Добавить(СокрЛП(Элемент.Идентификатор));
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого ИмяРегистра Из СтрРазделить("ЭАрМ_УПД_Входящий,ЭАрМ_УКД_Входящий", ",") Цикл
		МетаРегистр = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
		Если МетаРегистр = Неопределено ИЛИ МетаРегистр.Ресурсы.Найти("ОтправленоВБух") = Неопределено
			ИЛИ МетаРегистр.Ресурсы.Найти("ДокументБух") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(СтрШаблон(
			"ВЫБРАТЬ
			|	Р.ИдентификаторСБИС КАК Идентификатор,
			|	Р.ОтправленоВБух КАК ОтправленоВБух,
			|	Р.ДокументБух КАК ДокументБух
			|ИЗ
			|	РегистрСведений.%1 КАК Р
			|ГДЕ
			|	Р.ИдентификаторСБИС В (&Идентификаторы)", ИмяРегистра));
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС));
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(ВРег(СокрЛП(Выборка.Идентификатор)),
				Новый Структура("ОтправленоВБух, ДокументБух", Выборка.ОтправленоВБух, СокрЛП(Выборка.ДокументБух)));
		КонецЦикла;
	Исключение
		Информация = НСтр("ru = 'Ответы БП из реестров не прочитаны: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура РеестрУТПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьСоставЦепочкиУТ", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСоставЦепочкиУТ()

	ТекущиеДанные = Элементы.РеестрУТ.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		СоставЦепочкиУТ.ПолучитьЭлементы().Очистить();
		Возврат;
	КонецЕсли;
	ЗаполнитьСоставЦепочкиУТ(ТекущиеДанные.Ключ);
	Для Каждого Корень Из СоставЦепочкиУТ.ПолучитьЭлементы() Цикл
		Элементы.СоставЦепочкиУТ.Развернуть(Корень.ПолучитьИдентификатор(), Истина);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ЦепочкаРеестраУТ(Ключ)

	Цепочки = ?(ЗначениеЗаполнено(АдресРеестраУТ), ПолучитьИзВременногоХранилища(АдресРеестраУТ), Неопределено);
	Если ТипЗнч(Цепочки) = Тип("Массив") Тогда
		Для Каждого Цепочка Из Цепочки Цикл
			Если Цепочка.Ключ = Ключ Тогда
				Возврат Цепочка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервере
Процедура ЗаполнитьСоставЦепочкиУТ(Знач Ключ)

	ДеревоСоставаУТ = РеквизитФормыВЗначение("СоставЦепочкиУТ");
	ДеревоСоставаУТ.Строки.Очистить();
	Цепочка = ЦепочкаРеестраУТ(Ключ);
	Если Цепочка <> Неопределено Тогда
		// УПД - корнем, УКД - под ней по порядку цепочки; УПД нет в выгрузке -
		// корень «УПД № … (в выгрузке нет)»
		Корень = Неопределено;
		Для Каждого Док Из Цепочка.Документы Цикл
			Если Док.Вид <> "УКД" Тогда
				Корень = ДеревоСоставаУТ.Строки.Добавить();
				ЗаполнитьСтрокуСоставаУТ(Корень, Док);
			КонецЕсли;
		КонецЦикла;
		Если Корень = Неопределено Тогда
			Корень = ДеревоСоставаУТ.Строки.Добавить();
			Корень.Вид = "УПД";
			Корень.Документ = СтрШаблон(НСтр("ru = 'УПД № %1 (в выгрузке нет - не подписана, не в периоде или уже в БП)'"), Цепочка.НомерУПД);
		КонецЕсли;
		УКДЦепочки = Новый ТаблицаЗначений;
		УКДЦепочки.Колонки.Добавить("Док");
		УКДЦепочки.Колонки.Добавить("Порядок");
		Для Каждого Док Из Цепочка.Документы Цикл
			Если Док.Вид = "УКД" Тогда
				СтрокаУКД = УКДЦепочки.Добавить();
				СтрокаУКД.Док = Док;
				СтрокаУКД.Порядок = ?(ТипЗнч(Док.Порядок) = Тип("Число"), Док.Порядок, 0);
			КонецЕсли;
		КонецЦикла;
		УКДЦепочки.Сортировать("Порядок");
		Для Каждого СтрокаУКД Из УКДЦепочки Цикл
			ЗаполнитьСтрокуСоставаУТ(Корень.Строки.Добавить(), СтрокаУКД.Док);
		КонецЦикла;
	КонецЕсли;
	ЗначениеВРеквизитФормы(ДеревоСоставаУТ, "СоставЦепочкиУТ");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуСоставаУТ(СтрокаДерева, Док)

	СтрокаДерева.Идентификатор = Док.Идентификатор;
	СтрокаДерева.Вид = Док.Вид;
	СтрокаДерева.Документ = Док.Представление;
	СтрокаДерева.СуммаДо = Док.СуммаДо;
	СтрокаДерева.Изменение = Док.Изменение;
	СтрокаДерева.СуммаПосле = Док.СуммаПосле;
	СтрокаДерева.Подписан = Док.Подписан;
	СтрокаДерева.Выгружен = Док.Выгружен;
	СтрокаДерева.ЕстьВБух = Док.ЕстьВБух;
	СтрокаДерева.ПроведенВБух = Док.ПроведенВБух;
	СтрокаДерева.ДокументБух = Док.ДокументБух;
	СтрокаДерева.Замечания = Док.Замечания;
	СтрокаДерева.МожноОтправить = Док.МожноОтправить И НЕ Док.ЕстьВБух;
	СтрокаДерева.Отметка = ОтмеченныеДокументыУТ.НайтиПоЗначению(Док.Идентификатор) <> Неопределено;
	Если Док.ЕстьВБух Тогда
		СтрокаДерева.ЧтоСделать = НСтр("ru = 'есть в БП - не отправляется'");
	ИначеЕсли НЕ Док.МожноОтправить Тогда
		СтрокаДерева.ЧтоСделать = НСтр("ru = 'не собран - отправить нельзя: '") + Док.Замечания;
	ИначеЕсли Док.Выгружен Тогда
		СтрокаДерева.ЧтоСделать = НСтр("ru = 'выгружался, в БП ещё нет - можно отправить повторно'");
	Иначе
		СтрокаДерева.ЧтоСделать = НСтр("ru = 'нет в БП - отправить'");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоставЦепочкиУТОтметкаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.СоставЦепочкиУТ.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ТекущиеДанные.МожноОтправить Тогда
		ТекущиеДанные.Отметка = Ложь;
		ПоказатьПредупреждение(, НСтр("ru = 'Отправлять нечего: '") + ТекущиеДанные.ЧтоСделать);
		Возврат;
	КонецЕсли;
	Найденный = ОтмеченныеДокументыУТ.НайтиПоЗначению(ТекущиеДанные.Идентификатор);
	Если ТекущиеДанные.Отметка И Найденный = Неопределено Тогда
		ОтмеченныеДокументыУТ.Добавить(ТекущиеДанные.Идентификатор, ТекущиеДанные.Документ);
	ИначеЕсли НЕ ТекущиеДанные.Отметка И Найденный <> Неопределено Тогда
		ОтмеченныеДокументыУТ.Удалить(Найденный);
	КонецЕсли;

КонецПроцедуры

// «Отметить к отправке»: вверху отмечаются все цепочки таблицы (с учётом
// отбора), где есть документы, которых нет в Бух и которые ещё не уходили;
// остальные - снимаются. Уже отправленные без ответа Бух, не собранные и
// цепочки, где УКД некуда привязать (УПД нет ни в Бух, ни к отправке), - не
// отмечаются, а считаются в итоге.
&НаКлиенте
Процедура РеестрУТОтметитьНужное(Команда)

	Если РеестрУТ.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Таблица пуста - сначала «Показать» за период.'"));
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ОтметитьКОтправкеВРеестре());

КонецПроцедуры

&НаСервере
Функция ОтметитьКОтправкеВРеестре()

	Цепочки = ?(ЗначениеЗаполнено(АдресРеестраУТ), ПолучитьИзВременногоХранилища(АдресРеестраУТ), Неопределено);
	ПоКлючу = Новый Соответствие;
	Если ТипЗнч(Цепочки) = Тип("Массив") Тогда
		Для Каждого Цепочка Из Цепочки Цикл
			ПоКлючу.Вставить(Цепочка.Ключ, Цепочка);
		КонецЦикла;
	КонецЕсли;

	Отмечено = 0;
	Документов = 0;
	ЦепочекЖдут = 0;
	ДокументовЖдут = 0;
	НеСобрано = 0;
	БезУПД = Новый Массив;
	Для Каждого СтрокаРеестра Из РеестрУТ Цикл
		СтрокаРеестра.Отметка = Ложь;
		Цепочка = ПоКлючу.Получить(СтрокаРеестра.Ключ);
		Если Цепочка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Новых = 0;
		Ждут = 0;
		УКДкОтправке = 0;
		УПДЕсть = Ложь;
		Для Каждого Док Из Цепочка.Документы Цикл
			Если Док.ЕстьВБух Тогда
				Если Док.Вид <> "УКД" Тогда
					УПДЕсть = Истина;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если НЕ Док.МожноОтправить Тогда
				НеСобрано = НеСобрано + 1;
				Продолжить;
			КонецЕсли;
			Если Док.Вид <> "УКД" Тогда
				УПДЕсть = Истина;
			КонецЕсли;
			Если Док.Выгружен Тогда
				Ждут = Ждут + 1;
			Иначе
				Новых = Новых + 1;
				Если Док.Вид = "УКД" Тогда
					УКДкОтправке = УКДкОтправке + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Новых > 0 Тогда
			СтрокаРеестра.Отметка = Истина;
			Отмечено = Отмечено + 1;
			// С цепочкой уходит и выгружавшееся без ответа - Бух второй раз не создаёт
			Документов = Документов + Новых + Ждут;
			Если УКДкОтправке > 0 И НЕ УПДЕсть И БезУПД.Количество() < 5 Тогда
				БезУПД.Добавить(СтрШаблон("%1 (%2)", СтрокаРеестра.НомерУПД, СтрокаРеестра.Контрагент));
			КонецЕсли;
		ИначеЕсли Ждут > 0 Тогда
			ЦепочекЖдут = ЦепочекЖдут + 1;
			ДокументовЖдут = ДокументовЖдут + Ждут;
		КонецЕсли;
	КонецЦикла;

	Строки = Новый Массив;
	Если Отмечено = 0 Тогда
		Строки.Добавить(НСтр("ru = 'Новых к отправке нет: всё, что собрано, есть в БП или уже отправлялось.'"));
	Иначе
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Отмечено цепочек: %1 из %2 (документов к отправке: %3). Дальше - «Отправить отмеченные».'"),
			Отмечено, РеестрУТ.Количество(), Документов));
	КонецЕсли;
	Если ЦепочекЖдут > 0 Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Не отмечено - уже отправлялось, документа в БП пока нет: цепочек %1 (документов %2). Сначала «Прочитать ответы БП» / «Номера из БП»; переотправить - отметить вручную.'"),
			ЦепочекЖдут, ДокументовЖдут));
	КонецЕсли;
	Если НеСобрано > 0 Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Не уйдут - не собраны в УТ (ошибка в «Замечаниях» внизу): %1.'"), НеСобрано));
	КонецЕсли;
	Если ЗначениеЗаполнено(ПропущеныУПД) Тогда
		Строки.Добавить(ПропущеныУПД);
	КонецЕсли;
	Если БезУПД.Количество() > 0 Тогда
		Строки.Добавить(НСтр("ru = 'Проверьте: УКД без УПД - исходной УПД нет ни в БП, ни к отправке, БП корректировку не создаст: '")
			+ СтрСоединить(БезУПД, ", "));
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборПоставщикРеестр) ИЛИ ЗначениеЗаполнено(Контрагент) ИЛИ ЗначениеЗаполнено(НомерУПД) Тогда
		Строки.Добавить(НСтр("ru = 'Учтены только строки по отбору (поставщик / контрагент / номер).'"));
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиенте
Процедура РеестрУТОтправитьОтмеченные(Команда)

	КлючиЦепочек = Новый Массив;
	Для Каждого СтрокаРеестра Из РеестрУТ Цикл
		Если СтрокаРеестра.Отметка Тогда
			КлючиЦепочек.Добавить(СтрокаРеестра.Ключ);
		КонецЕсли;
	КонецЦикла;
	Идентификаторы = ИдентификаторыКОтправкеУТ(КлючиЦепочек, ОтмеченныеДокументыУТ.ВыгрузитьЗначения());
	Если Идентификаторы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте цепочку вверху или документ внизу (только то, чего нет в БП).'"));
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("РеестрУТОтправитьЗавершение", ЭтотОбъект, Идентификаторы),
		СтрШаблон(НСтр("ru = 'Отправить в БП отмеченные документы: %1 - одним файлом в папку %2?'"), Идентификаторы.Количество(), Папка),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура РеестрУТОтправитьСтроку(Команда)

	ТекущиеДанные = Элементы.СоставЦепочкиУТ.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ НЕ ТекущиеДанные.МожноОтправить Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Встаньте внизу на документ, которого нет в БП.'"));
		Возврат;
	КонецЕсли;
	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(ТекущиеДанные.Идентификатор);
	ПоказатьВопрос(Новый ОписаниеОповещения("РеестрУТОтправитьЗавершение", ЭтотОбъект, Идентификаторы),
		СтрШаблон(НСтр("ru = 'Отправить в БП только: %1?'"), ТекущиеДанные.Документ), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура РеестрУТОтправитьЗавершение(Ответ, Идентификаторы) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Папка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите папку обмена («Настройки…»).'"));
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, РеестрУТОтправитьНаСервере(Идентификаторы));
	ПоказатьСоставЦепочкиУТ();

КонецПроцедуры

&НаСервере
Функция ИдентификаторыКОтправкеУТ(Знач КлючиЦепочек, Знач Отмеченные)

	Результат = Новый Массив;
	Для Каждого Идентификатор Из Отмеченные Цикл
		Если Результат.Найти(Идентификатор) = Неопределено Тогда
			Результат.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ключ Из КлючиЦепочек Цикл
		Цепочка = ЦепочкаРеестраУТ(Ключ);
		Если Цепочка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Док Из Цепочка.Документы Цикл
			Если Док.МожноОтправить И НЕ Док.ЕстьВБух И Результат.Найти(Док.Идентификатор) = Неопределено Тогда
				Результат.Добавить(Док.Идентификатор);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Отправка ровно этих документов (в порядке данных: УПД, затем УКД цепочки)
// одним файлом; итог коротко - что ушло.
&НаСервере
Функция РеестрУТОтправитьНаСервере(Знач Идентификаторы)

	Данные = ?(ЗначениеЗаполнено(АдресДанных), ПолучитьИзВременногоХранилища(АдресДанных), Неопределено);
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат НСтр("ru = 'Данные устарели - нажмите «Показать» и повторите.'");
	КонецЕсли;

	Нужные = Новый Соответствие;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Нужные.Вставить(Идентификатор, Истина);
	КонецЦикла;
	НакладныеКОтправке = Новый Массив;
	КорректировкиКОтправке = Новый Массив;
	Ушли = Новый Массив;
	Для Каждого Элемент Из Данные Цикл
		Если Нужные.Получить(Элемент.Идентификатор) = Неопределено ИЛИ Элемент.Данные = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Элемент.Вид = "УКД" Тогда
			КорректировкиКОтправке.Добавить(Элемент.Данные);
		Иначе
			НакладныеКОтправке.Добавить(Элемент.Данные);
		КонецЕсли;
		Ушли.Добавить(СтрШаблон("%1 № %2", Элемент.Вид, Элемент.Описание.Номер));
	КонецЦикла;
	Если Ушли.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Отправлять нечего: отмеченные документы не собраны - нажмите «Показать».'");
	КонецЕсли;

	Результат = ОбъектДляЧтения().ВыгрузитьВПапку(Папка, НакладныеКОтправке, КорректировкиКОтправке, ПериодС, ПериодПо);
	Если НЕ Результат.Успех Тогда
		Возврат Результат.Ошибка;
	КонецЕсли;

	Выгружены = Новый Соответствие;
	Для Каждого Идентификатор Из Результат.Выгружены Цикл
		Выгружены.Вставить(Идентификатор, Истина);
	КонецЦикла;
	Для Каждого Элемент Из Данные Цикл
		Если Выгружены.Получить(Элемент.Идентификатор) <> Неопределено Тогда
			Элемент.Описание.Выгружена = Истина;
		КонецЕсли;
	КонецЦикла;
	ПоместитьВоВременноеХранилище(Данные, АдресДанных);
	ЗаполнитьРеестрУТ(Данные);

	Возврат СтрШаблон(НСтр("ru = 'Отправлено в БП файлом %1: %2. Ответ БП - «Прочитать ответы БП».'"),
		Результат.ИмяФайла, СтрСоединить(Ушли, ", "));

КонецФункции

// Настройки (папка, флажки чтения и отправки) - отдельной формой.
&НаКлиенте
Процедура НастройкиУТ(Команда)

	ОткрытьФорму(ИмяФормыНастроекУТ(), , ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("НастройкиУТЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервере
Функция ИмяФормыНастроекУТ()

	Возврат РеквизитФормыВЗначение("Объект").Метаданные().ПолноеИмя() + ".Форма.ФормаНастроек";

КонецФункции

&НаКлиенте
Процедура НастройкиУТЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Истина Тогда
		ПрочитатьНастройкиУТНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПрочитатьНастройкиУТНаСервере()

	Папка = ЗагрузитьНастройку("Папка", "");
	Если НЕ ЗначениеЗаполнено(Папка) Тогда
		Папка = РеквизитФормыВЗначение("Объект").ПапкаИзНастроекУТ();
	КонецЕсли;
	ТолькоНеВыгруженные = ЗагрузитьНастройку("ТолькоНеВыгруженные", Истина);
	СУКД = ЗагрузитьНастройку("СУКД", Истина);
	БезПроверкиПодписи = ЗагрузитьНастройку("БезПроверкиПодписи", Ложь);
	СтарыеУКД = ЗагрузитьНастройку("СтарыеУКД", Ложь);
	ОтправлятьБезДоговора = ЗагрузитьНастройку("ОтправлятьБезДоговора", Ложь);
	ТолькоУКД = ЗагрузитьНастройку("ТолькоУКД", Ложь);
	СобиратьВФоне = ЗагрузитьНастройку("СобиратьВФоне", Истина);
	ЛимитСборкиМинут = ЗагрузитьНастройку("ЛимитСборкиМинут", 15);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПодробноУТПриИзменении(Элемент)

	УстановитьВидимостьПодробноУТ();
	СохранитьНастройку("ПоказатьПодробно", ПоказатьПодробноУТ);

КонецПроцедуры

// Без «Подробно» - «Реестр», период, контрагент, номер и основные кнопки;
// с ним - все прежние вкладки, флажки и кнопки.
&НаСервере
Процедура УстановитьВидимостьПодробноУТ()

	Для Каждого Имя Из СтрРазделить("Папка,ТолькоНеВыгруженные,СУКД,СверятьУКДСФайлом,ОтправлятьБезДоговора,СобиратьВФоне,БезПроверкиПодписи,ТолькоУКД,СтарыеУКД,ЛимитСборкиМинут,ОтметитьВсеКнопка,СнятьОтметкиКнопка,ВыгрузитьКнопка,ПриходыИзБПВыбратьФайлКнопка,УКДКПрошлымПриходамКнопка,СтраницаЧтоВыгружаем,СтраницаСборка,СтраницаПриходыБП,СтраницаСвязиПриходов,СтраницаСверкаПоАкту,СтраницаДействияУКД,СтраницаПоискУПДУКД", ",") Цикл
		ЭлементФормы = Элементы.Найти(Имя);
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.Видимость = ПоказатьПодробноУТ;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// ============================================================================
// «Номера из Бух» (16.10.2026): лёгкий файл НомераБП_*.json из БП («Выгрузить
// номера для УТ») - последний в подпапке ПоступленияБП папки обмена. По нему
// у прочитанных («Показать») УПД и УКД - «есть в Бух» / «проведён» / сумма
// Бух; цепочки, где чего-то нет, отмечаются к отправке («грузить по этому
// списку»). Отметки можно поправить вручную и «Отправить отмеченные».
// ============================================================================

&НаКлиенте
Процедура НомераИзБух(Команда)

	Если НЕ ЗначениеЗаполнено(АдресДанных) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала «Показать» за период - потом «Номера из БП».'"));
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, НомераИзБухНаСервере());
	Элементы.СтраницыВыгрузки.ТекущаяСтраница = Элементы.СтраницаРеестрУТ;

КонецПроцедуры

&НаСервере
Функция НомераИзБухНаСервере()

	Каталог = СокрЛП(Папка) + ПолучитьРазделительПутиСервера() + "ПоступленияБП";
	Файлы = НайтиФайлы(Каталог, "НомераБП_*.json", Ложь);
	Если Файлы.Количество() = 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'В %1 нет файла НомераБП_*.json - в БП нажмите «Выгрузить номера для УТ».'"), Каталог);
	КонецЕсли;
	Последний = Файлы[0];
	Для Каждого Файл Из Файлы Цикл
		Если Файл.Имя > Последний.Имя Тогда
			Последний = Файл;
		КонецЕсли;
	КонецЦикла;

	Попытка
		Чтение = Новый ЧтениеТекста(Последний.ПолноеИмя, КодировкаТекста.UTF8);
		ТекстJSON = Чтение.Прочитать();
		Чтение.Закрыть();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстJSON);
		НомераБух = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат СтрШаблон(НСтр("ru = 'Файл %1 не прочитан: %2'"), Последний.Имя, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если ЗначениеЗаполнено(АдресНомеровБух) Тогда
		ПоместитьВоВременноеХранилище(НомераБух, АдресНомеровБух);
	Иначе
		АдресНомеровБух = ПоместитьВоВременноеХранилище(НомераБух, УникальныйИдентификатор);
	КонецЕсли;
	ФайлНомеровБух = Последний.Имя;

	Итог = ПрименитьНомераБух();
	Итог.Отмечено = ОтметитьНедостающееВРеестре();

	Возврат СтрШаблон(НСтр("ru = 'Номера из БП: %1 (период %2 - %3; УПД %4, УКД %5). Сведено: УПД в БП %6, УКД в БП %7, сумма отличается у %8. Отмечено к отправке цепочек: %9 - отметки можно поправить, затем «Отправить отмеченные».'"),
		Последний.Имя, ЗначениеПоля(НомераБух, "ПериодС"), ЗначениеПоля(НомераБух, "ПериодПо"),
		Итог.УПДвФайле, Итог.УКДвФайле, Итог.УПД, Итог.УКД, Итог.Суммы,
		Формат(Итог.Отмечено, "ЧН=0; ЧГ=0"));

КонецФункции

// Сводит номера из Бух с прочитанными документами (АдресДанных): по
// идентификатору ЭДО, иначе по ИНН и номеру без пробелов; ставит в описание
// ВБП, ПроведенВБП, ДокументБП (с суммой Бух), обновляет «Реестр».
&НаСервере
Функция ПрименитьНомераБух()

	Итог = Новый Структура("УПДвФайле, УКДвФайле, УПД, УКД, Суммы, Отмечено", 0, 0, 0, 0, 0, 0);
	НомераБух = ?(ЗначениеЗаполнено(АдресНомеровБух), ПолучитьИзВременногоХранилища(АдресНомеровБух), Неопределено);
	Данные = ?(ЗначениеЗаполнено(АдресДанных), ПолучитьИзВременногоХранилища(АдресДанных), Неопределено);
	Если НомераБух = Неопределено ИЛИ ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат Итог;
	КонецЕсли;

	ИндексУПД = Новый Соответствие;
	ИндексУКД = Новый Соответствие;
	СписокУПД = ЗначениеПоля(НомераБух, "УПД");
	СписокУКД = ЗначениеПоля(НомераБух, "УКД");
	Если ТипЗнч(СписокУПД) = Тип("Массив") Тогда
		Итог.УПДвФайле = СписокУПД.Количество();
		Для Каждого Запись Из СписокУПД Цикл
			ДобавитьВИндексНомеров(ИндексУПД, Запись);
		КонецЦикла;
	КонецЕсли;
	Если ТипЗнч(СписокУКД) = Тип("Массив") Тогда
		Итог.УКДвФайле = СписокУКД.Количество();
		Для Каждого Запись Из СписокУКД Цикл
			ДобавитьВИндексНомеров(ИндексУКД, Запись);
		КонецЦикла;
	КонецЕсли;

	Для Каждого Элемент Из Данные Цикл
		Описание = Элемент.Описание;
		Индекс = ?(Элемент.Вид = "УКД", ИндексУКД, ИндексУПД);
		Запись = Индекс.Получить("ИД|" + ВРег(СокрЛП(Элемент.Идентификатор)));
		Как = НСтр("ru = 'по идентификатору ЭДО'");
		Если Запись = Неопределено Тогда
			Запись = Индекс.Получить(СокрЛП(Описание.ИНН) + "|" + НомерБезПробеловУТ(Описание.Номер));
			Как = НСтр("ru = 'по ИНН и номеру'");
		КонецЕсли;
		Если Запись = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Описание.Вставить("ВБП", Истина);
		Описание.Вставить("ПроведенВБП", ЗначениеПоля(Запись, "Проведен") = Истина);
		Описание.Вставить("КакВБП", НСтр("ru = 'номера из БП, '") + Как);
		СуммаБух = ?(Элемент.Вид = "УКД", ЗначениеПоля(Запись, "Изменение"), ЗначениеПоля(Запись, "Сумма"));
		СуммаБух = ?(ТипЗнч(СуммаБух) = Тип("Число"), СуммаБух, 0);
		СуммаУТ = ?(Элемент.Вид = "УКД", Описание.Сумма - Описание.СуммаДо, Описание.Сумма);
		ТекстСуммы = "";
		Если Макс(СуммаБух - СуммаУТ, СуммаУТ - СуммаБух) >= 1 Тогда
			// УКД: в Бух знак изменения может быть другим - сравниваем по модулю
			Если НЕ (Элемент.Вид = "УКД" И Макс(СуммаБух + СуммаУТ, -СуммаБух - СуммаУТ) < 1) Тогда
				ТекстСуммы = СтрШаблон(НСтр("ru = '; СУММА В БП %1, в УТ %2'"), Формат(СуммаБух, "ЧДЦ=2; ЧН=0"), Формат(СуммаУТ, "ЧДЦ=2; ЧН=0"));
				Итог.Суммы = Итог.Суммы + 1;
			КонецЕсли;
		КонецЕсли;
		Описание.Вставить("ДокументБП", СтрШаблон(НСтр("ru = '%1 № %2 от %3, %4%5%6'"),
			?(Элемент.Вид = "УКД", НСтр("ru = 'Корректировка'"), НСтр("ru = 'Поступление'")),
			ЗначениеПоля(Запись, "Номер"), ЗначениеПоля(Запись, "Дата"), Формат(СуммаБух, "ЧДЦ=2; ЧН=0"),
			?(ЗначениеПоля(Запись, "Проведен") = Истина, НСтр("ru = ', проведён'"), НСтр("ru = ', НЕ проведён'")), ТекстСуммы));
		Если Элемент.Вид = "УКД" Тогда
			Итог.УКД = Итог.УКД + 1;
		Иначе
			Итог.УПД = Итог.УПД + 1;
		КонецЕсли;
	КонецЦикла;

	ПоместитьВоВременноеХранилище(Данные, АдресДанных);
	ЗаполнитьРеестрУТ(Данные);

	Возврат Итог;

КонецФункции

&НаСервере
Процедура ДобавитьВИндексНомеров(Индекс, Запись)

	Для Каждого Ид Из СтрРазделить(Строка(ЗначениеПоля(Запись, "ИдЭДО")), ";", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Ид)) Тогда
			Индекс.Вставить("ИД|" + ВРег(СокрЛП(Ид)), Запись);
		КонецЕсли;
	КонецЦикла;
	Номер = НомерБезПробеловУТ(Строка(ЗначениеПоля(Запись, "Номер")));
	Если ЗначениеЗаполнено(Номер) Тогда
		Индекс.Вставить(СокрЛП(Строка(ЗначениеПоля(Запись, "ИНН"))) + "|" + Номер, Запись);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НомерБезПробеловУТ(Знач Номер)

	Возврат ВРег(СтрЗаменить(СтрЗаменить(СокрЛП(Номер), " ", ""), Символы.НПП, ""));

КонецФункции

// «Грузить по списку»: вверху отмечаются цепочки, где есть что отправить
// (чего нет в Бух). Отметки можно поправить вручную.
&НаСервере
Функция ОтметитьНедостающееВРеестре()

	Отмечено = 0;
	Для Каждого СтрокаРеестра Из РеестрУТ Цикл
		СтрокаРеестра.Отметка = СтрокаРеестра.КОтправке > 0;
		Если СтрокаРеестра.Отметка Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Отмечено;

КонецФункции

// Связи приходов из кэша - все или «Только где чего-то нет» (Итог <> 3).
&НаСервере
Процедура ВывестиСвязиПриходов()

	Дерево = РеквизитФормыВЗначение("СвязиПриходовБП");
	Дерево.Строки.Очистить();
	Полное = ?(ЗначениеЗаполнено(АдресСвязейПриходов), ПолучитьИзВременногоХранилища(АдресСвязейПриходов), Неопределено);
	Если ТипЗнч(Полное) = Тип("ДеревоЗначений") Тогда
		Для Каждого Узел Из Полное.Строки Цикл
			Если ТолькоПроблемыСвязей И Узел.Итог = 3 Тогда
				Продолжить;
			КонецЕсли;
			НовыйУзел = Дерево.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйУзел, Узел);
			Для Каждого Подчиненная Из Узел.Строки Цикл
				ЗаполнитьЗначенияСвойств(НовыйУзел.Строки.Добавить(), Подчиненная);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	ЗначениеВРеквизитФормы(Дерево, "СвязиПриходовБП");

КонецПроцедуры

&НаСервере
Процедура ОчиститьСвязиПриходов()

	Если ЗначениеЗаполнено(АдресСвязейПриходов) Тогда
		УдалитьИзВременногоХранилища(АдресСвязейПриходов);
	КонецЕсли;
	АдресСвязейПриходов = "";
	ИнформацияСвязейПриходов = НСтр("ru = 'Загрузите «Приходы из БП...» - здесь появятся поступления БП и привязанные к ним УПД, приходные Далиона, корректировки и УКД.'");
	ВывестиСвязиПриходов();

КонецПроцедуры

// Итог узла - худший из итогов: 2 (ошибка) хуже 1 (проверьте) хуже 3 (на месте).
&НаСервере
Процедура УхудшитьИтог(Узел, Итог)

	Если Итог = 2 ИЛИ Итог = 1 И Узел.Итог <> 2 Тогда
		Узел.Итог = Итог;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция УКДУзла(Узел)

	Количество = 0;
	Для Каждого Подчиненная Из Узел.Строки Цикл
		Если СтрНачинаетсяС(Подчиненная.Вид, НСтр("ru = 'УКД из УТ'")) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Количество;

КонецФункции

&НаСервере
Функция КорректировокСПаройУзла(Узел)

	Количество = 0;
	Для Каждого Подчиненная Из Узел.Строки Цикл
		Если СтрНачинаетсяС(Подчиненная.Вид, НСтр("ru = 'Корректировка БП'")) И СтрНачинаетсяС(Подчиненная.Состояние, НСтр("ru = 'УКД в УТ: '")) Тогда
			Количество = Количество + 1;
		КонецЕсли;
