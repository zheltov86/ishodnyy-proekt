#КонецОбласти

#Область СверкаПоАкту

// Вкладка «Сверка по акту» (внутри «Выгрузки в Бухгалтерию»): акт сверки
// поставщика (Excel / MXL) или файл «Приходы из БП» - строками в дерево;
// «Найти документы» - каждой строке документы УТ всеми способами
// (СопоставитьАкт модуля объекта): УПД, УКД, ЭТрН, приходная Далиона, заказ,
// что уже в БП. «Собрать в выгрузку» - отмеченные к переносу документы
// отмечаются в дереве «Что выгружаем». В базу ничего не пишется.
//
// Уровень строки: 0 - строка акта (или документ УТ без строки в акте), 1 -
// найденный документ УТ.

&НаКлиенте
Процедура ЗагрузитьАкт(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Акт сверки поставщика или файл «Приходы из БП»'");
	ПараметрыДиалога.Фильтр = НСтр("ru = 'Акт сверки (*.xlsx;*.xls;*.mxl;*.ods;*.json)|*.xlsx;*.xls;*.mxl;*.ods;*.json|Все файлы (*.*)|*.*'");
	ПараметрыДиалога.МножественныйВыбор = Ложь;

	НачатьПомещениеФайлаНаСервер(Новый ОписаниеОповещения("АктФайлПомещен", ЭтотОбъект), , , ,
		ПараметрыДиалога, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура АктФайлПомещен(ОписаниеФайла, ДополнительныеПараметры) Экспорт

	Если ОписаниеФайла = Неопределено ИЛИ ОписаниеФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;
	Адрес = ОписаниеФайла.Адрес;
	ВыбранноеИмяФайла = ОписаниеФайла.СсылкаНаФайл.Имя;

	Состояние(НСтр("ru = 'Читаем акт и ищем документы в УТ...'"));
	ТекстИтога = ЗагрузитьАктНаСервере(Адрес, ВыбранноеИмяФайла);
	Состояние();

	РазвернутьАкт();
	Элементы.СтраницыВыгрузки.ТекущаяСтраница = Элементы.СтраницаСверкаПоАкту;
	ПоказатьПредупреждение(, ТекстИтога);

КонецПроцедуры

&НаСервере
Функция ЗагрузитьАктНаСервере(Знач Адрес, Знач ИмяФайла)

	Файл = Новый Файл(ИмяФайла);
	Если НРег(Файл.Расширение) = ".json" Тогда
		// Файл «Приходы из БП»: сторона БП строками акта
		Текст = ЗагрузитьПриходыБПНаСервере(Адрес, ИмяФайла);
		Если НЕ ЗначениеЗаполнено(АдресПриходовБП) Тогда
			Возврат Текст;
		КонецЕсли;
		ЗаполнитьАктИзСверкиБП();
		АктФайл = Файл.Имя;
		Возврат НайтиДокументыАктаНаСервере();
	КонецЕсли;

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	УдалитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Возврат НСтр("ru = 'Файл не получен - выберите его ещё раз.'");
	КонецЕсли;

	Акт = РеквизитФормыВЗначение("Объект").РазобратьАктПоставщика(ДвоичныеДанные, ИмяФайла);
	Если НЕ Акт.Успех Тогда
		ИнформацияАкта = Акт.Ошибка;
		Возврат Акт.Ошибка;
	КонецЕсли;

	АктФайл = Файл.Имя;
	АктИНН = ?(ЗначениеЗаполнено(Акт.ИНН), Акт.ИНН, ИННИзОтбораКонтрагента());
	АктСальдоНачало = Акт.СальдоНачало;
	АктСальдоКонец = Акт.СальдоКонец;
	Если ЗначениеЗаполнено(Акт.ПериодС) Тогда
		ПериодС = НачалоДня(Акт.ПериодС);
		ПериодПо = ?(ЗначениеЗаполнено(Акт.ПериодПо), НачалоДня(Акт.ПериодПо), '00010101');
		СохранитьНастройку("ПериодС", ПериодС);
		СохранитьНастройку("ПериодПо", ПериодПо);
	КонецЕсли;
	Если ЗначениеЗаполнено(Акт.ИНН) Тогда
		Контрагент = Акт.ИНН;
		СохранитьНастройку("Контрагент", Контрагент);
	КонецЕсли;

	Дерево = РеквизитФормыВЗначение("АктСверки");
	Дерево.Строки.Очистить();
	Для Каждого СтрокаАкта Из Акт.Строки Цикл
		СтрокаАкта.ИНН = АктИНН;
		СтрокаАкта.Ключ = РеквизитФормыВЗначение("Объект").КлючСтрокиАкта(СтрокаАкта);
		СтрокаДерева = Дерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаАкта, , "Кандидаты, Найденные");
		СтрокаДерева.Уровень = 0;
	КонецЦикла;
	ЗначениеВРеквизитФормы(Дерево, "АктСверки");

	Предупреждения = "";
	Если Акт.Предупреждения.Количество() > 0 Тогда
		Предупреждения = Символы.ПС + НСтр("ru = 'Акт: '") + СтрСоединить(Акт.Предупреждения, "; ") + ".";
	КонецЕсли;

	Возврат НайтиДокументыАктаНаСервере() + Предупреждения;

КонецФункции

// ИНН из отбора «Контрагент»: выбран из списка - ИНН представления, введён
// вручную - если это цифры.
&НаСервере
Функция ИННИзОтбораКонтрагента()

	ИНН = ИННВыбранногоКонтрагента(Контрагент);
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		Текст = СокрЛП(Контрагент);
		ЦифрыТолько = ЗначениеЗаполнено(Текст);
		Для Позиция = 1 По СтрДлина(Текст) Цикл
			Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
				ЦифрыТолько = Ложь;
			КонецЕсли;
		КонецЦикла;
		ИНН = ?(ЦифрыТолько, Текст, "");
	КонецЕсли;

	Возврат ИНН;

КонецФункции

// Строки акта из сверки приходов с БП: поступления и корректировки БП
// (сторона «БП»). Строки поставщика, если уже загружены, остаются.
&НаСервере
Процедура ЗаполнитьАктИзСверкиБП()

	Сверка = ПолучитьИзВременногоХранилища(АдресПриходовБП);
	Если Сверка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Обработка = РеквизитФормыВЗначение("Объект");

	Дерево = РеквизитФормыВЗначение("АктСверки");
	Для Каждого СтрокаДерева Из Дерево.Строки.НайтиСтроки(Новый Структура("Уровень, Сторона", 0, "БП")) Цикл
		Дерево.Строки.Удалить(СтрокаДерева);
	КонецЦикла;
	Для Каждого СтрокаДерева Из Дерево.Строки.НайтиСтроки(Новый Структура("Уровень, Сторона", 0, "УТ")) Цикл
		Дерево.Строки.Удалить(СтрокаДерева);
	КонецЦикла;

	Для Каждого Поступление Из Сверка.Поступления Цикл
		СтрокаАкта = Обработка.НоваяСтрокаАкта();
		СтрокаАкта.Сторона = "БП";
		СтрокаАкта.Вид = "УПД";
		СтрокаАкта.Документ = Поступление.Представление;
		СтрокаАкта.Номер = ?(ЗначениеЗаполнено(Поступление.ВходящийНомер), Поступление.ВходящийНомер, Поступление.НомерСФ);
		СтрокаАкта.Дата = ?(ЗначениеЗаполнено(Поступление.ВходящаяДата), Поступление.ВходящаяДата,
			?(ЗначениеЗаполнено(Поступление.ДатаСФ), Поступление.ДатаСФ, Поступление.Дата));
		СтрокаАкта.Кредит = Поступление.Сумма;
		СтрокаАкта.Сумма = Поступление.Сумма;
		СтрокаАкта.ИНН = Поступление.КонтрагентИНН;
		СтрокаАкта.ПоступлениеБПУИД = Поступление.УИД;
		СтрокаАкта.Разобрано = ЗначениеЗаполнено(СтрокаАкта.Номер);
		СтрокаАкта.Ключ = "БП|" + ВРег(Поступление.УИД);
		СтрокаДерева = Дерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаАкта, , "Кандидаты, Найденные");
		СтрокаДерева.Уровень = 0;
	КонецЦикла;
	Для Каждого Корректировка Из Сверка.Корректировки Цикл
		СтрокаАкта = Обработка.НоваяСтрокаАкта();
		СтрокаАкта.Сторона = "БП";
		СтрокаАкта.Вид = "УКД";
		СтрокаАкта.Документ = Корректировка.Представление;
		СтрокаАкта.Номер = ?(ЗначениеЗаполнено(Корректировка.ВходящийНомер), Корректировка.ВходящийНомер, Корректировка.НомерСФ);
		СтрокаАкта.Дата = ?(ЗначениеЗаполнено(Корректировка.ВходящаяДата), Корректировка.ВходящаяДата, Корректировка.Дата);
		СтрокаАкта.Сумма = Корректировка.Сумма;
		СтрокаАкта.ИНН = Корректировка.КонтрагентИНН;
		СтрокаАкта.ПоступлениеБПУИД = Корректировка.УИД;
		СтрокаАкта.Разобрано = ЗначениеЗаполнено(СтрокаАкта.Номер);
		СтрокаАкта.Ключ = "БП|" + ВРег(Корректировка.УИД);
		СтрокаДерева = Дерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаАкта, , "Кандидаты, Найденные");
		СтрокаДерева.Уровень = 0;
	КонецЦикла;
	ЗначениеВРеквизитФормы(Дерево, "АктСверки");

	Если НЕ ЗначениеЗаполнено(АктИНН) И Сверка.Поступления.Количество() > 0 Тогда
		АктИНН = Сверка.Поступления[0].КонтрагентИНН;
	КонецЕсли;

КонецПроцедуры

// Без акта: все документы поставщика за период (отбор «Контрагент») - как
// «В УТ есть, в акте нет», с тем, что уже в БП по «Приходам из БП».
&НаКлиенте
Процедура АктСобратьПоПоставщику(Команда)

	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите поставщика в отборе «Контрагент» (из списка или ИНН).'"));
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПериодС) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите начало периода.'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Собираем документы поставщика...'"));
	ТекстИтога = АктСобратьПоПоставщикуНаСервере();
	Состояние();

	РазвернутьАкт();
	ПоказатьПредупреждение(, ТекстИтога);

КонецПроцедуры

&НаСервере
Функция АктСобратьПоПоставщикуНаСервере()

	ИНН = ИННИзОтбораКонтрагента();
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		Возврат НСтр("ru = 'ИНН поставщика не определён: выберите контрагента из списка или введите ИНН.'");
	КонецЕсли;
	АктИНН = ИНН;
	АктФайл = "";
	АктСальдоНачало = 0;
	АктСальдоКонец = 0;

	Дерево = РеквизитФормыВЗначение("АктСверки");
	Дерево.Строки.Очистить();
	ЗначениеВРеквизитФормы(Дерево, "АктСверки");
	Если ЗначениеЗаполнено(АдресПриходовБП) Тогда
		ЗаполнитьАктИзСверкиБП();
	КонецЕсли;

	Возврат НайтиДокументыАктаНаСервере();

КонецФункции

&НаКлиенте
Процедура АктНайтиДокументы(Команда)

	Состояние(НСтр("ru = 'Ищем документы в УТ...'"));
	ТекстИтога = НайтиДокументыАктаНаСервере();
	Состояние();

	РазвернутьАкт();
	ПоказатьПредупреждение(, ТекстИтога);

КонецПроцедуры

// Строки акта (уровень 0, стороны «Поставщик» и «БП» - с правками в таблице) ->
// документы УТ за период -> сопоставление -> дерево заново.
&НаСервере
Функция НайтиДокументыАктаНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Дерево = РеквизитФормыВЗначение("АктСверки");

	Строки = Новый Массив;
	ИННы = Новый Массив;
	Если ЗначениеЗаполнено(АктИНН) Тогда
		ИННы.Добавить(СокрЛП(АктИНН));
	КонецЕсли;
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		Если СтрокаДерева.Уровень <> 0 ИЛИ СтрокаДерева.Сторона = "УТ" Тогда
			Продолжить;
		КонецЕсли;
		СтрокаАкта = Обработка.НоваяСтрокаАкта();
		ЗаполнитьЗначенияСвойств(СтрокаАкта, СтрокаДерева, , "Кандидаты, Найденные");
		// Правки в таблице: номер, дата, суммы
		СтрокаАкта.Номер = СокрЛП(СтрокаАкта.Номер);
		СтрокаАкта.Сумма = ?(СтрокаАкта.Сторона = "Поставщик", Макс(СтрокаАкта.Дебет, СтрокаАкта.Кредит), СтрокаАкта.Сумма);
		Если НЕ ЗначениеЗаполнено(СтрокаАкта.ИНН) Тогда
			СтрокаАкта.ИНН = АктИНН;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаАкта.Вид) Тогда
			СтрокаАкта.Вид = ?(СтрокаАкта.Дебет > 0, "УПД", "Оплата");
		КонецЕсли;
		СтрокаАкта.Разобрано = СтрокаАкта.Вид = "Оплата"
			ИЛИ ЗначениеЗаполнено(СтрокаАкта.Номер) И ЗначениеЗаполнено(СтрокаАкта.Дата);
		Если СтрокаАкта.Сторона = "Поставщик" Тогда
			СтрокаАкта.Ключ = Обработка.КлючСтрокиАкта(СтрокаАкта);
		КонецЕсли;
		// Прежний результат - заново
		СтрокаАкта.ВидУТ = "";
		СтрокаАкта.ИдентификаторУТ = "";
		СтрокаАкта.НомерУТ = "";
		СтрокаАкта.ДатаУТ = '00010101';
		СтрокаАкта.СуммаУТ = 0;
		СтрокаАкта.ДокументУТ = Неопределено;
		СтрокаАкта.КакНайдено = "";
		СтрокаАкта.Уверенность = "";
		СтрокаАкта.Разница = 0;
		СтрокаАкта.Статус = "";
		СтрокаАкта.Действие = "";
		СтрокаАкта.Итог = 0;
		СтрокаАкта.Отметка = Ложь;
		Строки.Добавить(СтрокаАкта);
		Если ЗначениеЗаполнено(СтрокаАкта.ИНН) И ИННы.Найти(СокрЛП(СтрокаАкта.ИНН)) = Неопределено Тогда
			ИННы.Добавить(СокрЛП(СтрокаАкта.ИНН));
		КонецЕсли;
	КонецЦикла;

	Если ИННы.Количество() = 0 Тогда
		ИнформацияАкта = НСтр("ru = 'Не известен ИНН поставщика: его нет ни в акте, ни в отборе «Контрагент».'");
		Возврат ИнформацияАкта;
	КонецЕсли;

	Сверка = Неопределено;
	Если ЗначениеЗаполнено(АдресПриходовБП) Тогда
		Сверка = ПолучитьИзВременногоХранилища(АдресПриходовБП);
	КонецЕсли;

	Попытка
		ДокументыУТ = Обработка.ДокументыПоставщикаЗаПериод(ИННы, ПериодС, ПериодПо);
		Результат = Обработка.СопоставитьАкт(Строки, ДокументыУТ, Сверка, ЗагрузитьНастройку("РучныеПарыАкта", Новый Соответствие),
			ПериодС, ПериодПо);
	Исключение
		ИнформацияАкта = НСтр("ru = 'Сверка по акту не выполнена: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ОбменУТ.ВыгрузкаВБух", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ИнформацияАкта;
	КонецПопытки;

	Дерево.Строки.Очистить();
	Для Каждого СтрокаАкта Из Строки Цикл
		ДобавитьСтрокуАктаВДерево(Дерево, СтрокаАкта);
	КонецЦикла;
	Для Каждого СтрокаАкта Из Результат.НеВАкте Цикл
		ДобавитьСтрокуАктаВДерево(Дерево, СтрокаАкта);
	КонецЦикла;
	ЗначениеВРеквизитФормы(Дерево, "АктСверки");

	Итоги = Результат.Итоги;
	ТекстСтатусов = Новый Массив;
	Для Каждого КлючЗначение Из Итоги.Статусы Цикл
		ТекстСтатусов.Добавить(КлючЗначение.Ключ + " - " + Формат(КлючЗначение.Значение, "ЧГ=0"));
	КонецЦикла;
	ИнформацияАкта = СтрШаблон(
		НСтр("ru = '%1Поставщик ИНН %2, период %3 - %4. Строк акта: %5, документов УТ без строки в акте: %6. Оборот по акту (поставки) %7, по УТ (УПД с учётом УКД) %8%9. К переносу в БП отмечено: %10. '"),
		?(ЗначениеЗаполнено(АктФайл), НСтр("ru = 'Файл '") + АктФайл + ". ", ""),
		СтрСоединить(ИННы, ", "), Формат(ПериодС, "ДЛФ=D"), Формат(ПериодПо, "ДЛФ=D"),
		Строки.Количество(), Результат.НеВАкте.Количество(),
		Формат(Итоги.ОборотАкта, "ЧДЦ=2; ЧН=0,00"), Формат(Итоги.ОборотУТ, "ЧДЦ=2; ЧН=0,00"),
		?(АктСальдоНачало <> 0 ИЛИ АктСальдоКонец <> 0,
			СтрШаблон(НСтр("ru = '; сальдо по акту: начало %1, конец %2 (+ мы должны)'"),
				Формат(АктСальдоНачало, "ЧДЦ=2; ЧН=0,00"), Формат(АктСальдоКонец, "ЧДЦ=2; ЧН=0,00")), ""),
		Итоги.КПереносу)
		+ ?(Сверка = Неопределено, НСтр("ru = 'Что уже есть в БП, не проверялось - загрузите «Приходы из БП» (файл из ВыгрузкаБух).'"),
			НСтр("ru = 'Сверено с «Приходами из БП».'"))
		+ Символы.ПС + НСтр("ru = 'Статусы: '") + СтрСоединить(ТекстСтатусов, "; ");

	Возврат ИнформацияАкта;

КонецФункции

&НаСервере
Процедура ДобавитьСтрокуАктаВДерево(Дерево, СтрокаАкта)

	СтрокаДерева = Дерево.Строки.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаАкта, , "Кандидаты, Найденные");
	СтрокаДерева.Уровень = 0;
	// Кандидаты - текстом для «Выбрать пару…»: Вид|Ид|Представление (как)
	Части = Новый Массив;
	Для Каждого Кандидат Из СтрокаАкта.Кандидаты Цикл
		Части.Добавить(Кандидат.КлючДокумента + "|" + Кандидат.Элемент.Представление + " (" + Кандидат.Как + ")");
	КонецЦикла;
	СтрокаДерева.Кандидаты = СтрСоединить(Части, Символы.ПС);

	Для Каждого Найденный Из СтрокаАкта.Найденные Цикл
		Подчиненная = СтрокаДерева.Строки.Добавить();
		Подчиненная.Уровень = 1;
		Подчиненная.Сторона = НСтр("ru = 'УТ'");
		Подчиненная.Вид = Найденный.Вид;
		Подчиненная.Документ = Найденный.Представление;
		Подчиненная.ВидУТ = Найденный.Вид;
		Подчиненная.ИдентификаторУТ = Найденный.Идентификатор;
		Подчиненная.НомерУТ = Найденный.Номер;
		Подчиненная.ДатаУТ = Найденный.Дата;
		Подчиненная.СуммаУТ = Найденный.Сумма;
		Подчиненная.ДокументУТ = ?(Найденный.Ссылка = NULL, Неопределено, Найденный.Ссылка);
		Подчиненная.КакНайдено = Найденный.КакНайдено;
		Подчиненная.Уверенность = Найденный.Уверенность;
		Подчиненная.Разница = ?(Найденный.Сумма = 0 ИЛИ Найденный.Вид = "ЭТрН", 0, СтрокаАкта.Сумма - Найденный.Сумма);
		Подчиненная.Ключ = СтрокаАкта.Ключ;
		Подчиненная.ИНН = СтрокаАкта.ИНН;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьАкт()

	Для Каждого СтрокаДерева Из АктСверки.ПолучитьЭлементы() Цикл
		Элементы.АктСверки.Развернуть(СтрокаДерева.ПолучитьИдентификатор(), Истина);
	КонецЦикла;

КонецПроцедуры

// Пара вручную: из кандидатов текущей строки; выбор запоминается по ключу
// строки (ИНН, номер, дата, сумма) и действует при следующих поисках.
&НаКлиенте
Процедура АктВыбратьПару(Команда)

	ТекущиеДанные = Элементы.АктСверки.ТекущиеДанные;
	Пока ТекущиеДанные <> Неопределено И ТекущиеДанные.Уровень > 0 Цикл
		ТекущиеДанные = ТекущиеДанные.ПолучитьРодителя();
	КонецЦикла;
	Если ТекущиеДанные = Неопределено ИЛИ ТекущиеДанные.Сторона = "УТ" Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Встаньте на строку акта.'"));
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Кандидаты) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'У этой строки нет кандидатов в УТ. Поправьте номер или дату и нажмите «Найти документы».'"));
		Возврат;
	КонецЕсли;

	Список = Новый СписокЗначений;
	Для Каждого Часть Из СтрРазделить(ТекущиеДанные.Кандидаты, Символы.ПС, Ложь) Цикл
		Поля = СтрРазделить(Часть, "|");
		Если Поля.Количество() >= 3 Тогда
			Список.Добавить(Поля[0] + "|" + Поля[1], Поля[2]);
		КонецЕсли;
	КонецЦикла;
	Список.Добавить("", НСтр("ru = '<без пары: снять ручной выбор>'"));

	ПоказатьВыборИзМеню(Новый ОписаниеОповещения("АктПараВыбрана", ЭтотОбъект, ТекущиеДанные.Ключ), Список);

КонецПроцедуры

&НаКлиенте
Процедура АктПараВыбрана(Выбранный, Ключ) Экспорт

	Если Выбранный = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗапомнитьПаруАкта(Ключ, Выбранный.Значение);
	Состояние(НСтр("ru = 'Пара выбрана, ищем заново...'"));
	НайтиДокументыАктаНаСервере();
	Состояние();
	РазвернутьАкт();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗапомнитьПаруАкта(Ключ, Значение)

	Пары = ЗагрузитьНастройку("РучныеПарыАкта", Новый Соответствие);
	Если ТипЗнч(Пары) <> Тип("Соответствие") Тогда
		Пары = Новый Соответствие;
	КонецЕсли;
	Если ЗначениеЗаполнено(Значение) Тогда
		Пары.Вставить(Ключ, Значение);
	Иначе
		Пары.Удалить(Ключ);
	КонецЕсли;
	СохранитьНастройку("РучныеПарыАкта", Пары);

КонецПроцедуры

// Отмеченные к переносу строки -> документы УТ читаются за нужный период и
// отмечаются в дереве «Что выгружаем»; дальше - обычная «Выгрузить в папку».
&НаКлиенте
Процедура АктСобратьВВыгрузку(Команда)

	Если СборкаИдёт() Тогда
		Возврат;
	КонецЕсли;

	Отмечено = 0;
	Для Каждого СтрокаДерева Из АктСверки.ПолучитьЭлементы() Цикл
		Если СтрокаДерева.Отметка И ЗначениеЗаполнено(СтрокаДерева.ИдентификаторУТ) Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте строки к переносу (колонка «В выгрузку»): отмечаются сами строки «ПЕРЕНЕСТИ» и «ВОЗВРАТ».'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Собираем документы в выгрузку...'"));
	ТекстИтога = АктСобратьВВыгрузкуНаСервере();
	Состояние();

	РазвернутьДерево();
	Элементы.СтраницыВыгрузки.ТекущаяСтраница = Элементы.СтраницаЧтоВыгружаем;
	ПоказатьПредупреждение(, ТекстИтога);

КонецПроцедуры

&НаСервере
Функция АктСобратьВВыгрузкуНаСервере()

	Нужные = Новый Соответствие;
	ЕстьУКД = Ложь;
	ДатаМин = ПериодС;
	ДатаМакс = ?(ЗначениеЗаполнено(ПериодПо), ПериодПо, НачалоДня(ТекущаяДатаСеанса()));
	Дерево = РеквизитФормыВЗначение("АктСверки");
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		Если СтрокаДерева.Уровень <> 0 ИЛИ НЕ СтрокаДерева.Отметка ИЛИ НЕ ЗначениеЗаполнено(СтрокаДерева.ИдентификаторУТ) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаДерева.ВидУТ <> "УПД" И СтрокаДерева.ВидУТ <> "УКД" Тогда
			Продолжить;
		КонецЕсли;
		Нужные.Вставить(ВРег(СокрЛП(СтрокаДерева.ИдентификаторУТ)), СтрокаДерева.Документ);
		ЕстьУКД = ЕстьУКД ИЛИ СтрокаДерева.ВидУТ = "УКД";
		Если ЗначениеЗаполнено(СтрокаДерева.ДатаУТ) Тогда
			ДатаМин = ?(ЗначениеЗаполнено(ДатаМин), Мин(ДатаМин, НачалоДня(СтрокаДерева.ДатаУТ)), НачалоДня(СтрокаДерева.ДатаУТ));
			ДатаМакс = Макс(ДатаМакс, НачалоДня(СтрокаДерева.ДатаУТ));
		КонецЕсли;
	КонецЦикла;
	Если Нужные.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Среди отмеченных нет УПД и УКД из УТ (приходные Далиона без УПД в БП не переносятся).'");
	КонецЕсли;

	// Период чтения - чтобы попали все нужные; выгруженные показываем, старые УКД собираем
	ПериодС = ДатаМин;
	ПериодПо = ?(ДатаМакс >= НачалоДня(ТекущаяДатаСеанса()), '00010101', ДатаМакс);
	ТолькоНеВыгруженные = Ложь;
	Если ЕстьУКД Тогда
		СтарыеУКД = Истина;
	КонецЕсли;
	СохранитьНастройку("ПериодС", ПериодС);
	СохранитьНастройку("ПериодПо", ПериодПо);
	СохранитьНастройку("ТолькоНеВыгруженные", ТолькоНеВыгруженные);
	СохранитьНастройку("СтарыеУКД", СтарыеУКД);
	ПрочитатьНаСервере();

	ДеревоВыгрузки = РеквизитФормыВЗначение("Накладные");
	Найдено = 0;
	ВБП = 0;
	СОшибкой = 0;
	Для Каждого СтрокаДерева Из ДеревоВыгрузки.Строки.НайтиСтроки(Новый Структура("Уровень", 1), Истина) Цикл
		Ключ = ВРег(СокрЛП(СтрокаДерева.Идентификатор));
		Если Нужные.Получить(Ключ) = Неопределено Тогда
			СтрокаДерева.Отметка = Ложь;
			Продолжить;
		КонецЕсли;
		Найдено = Найдено + 1;
		Нужные.Удалить(Ключ);
		Если СтрокаДерева.ВБП Тогда
			ВБП = ВБП + 1;
			СтрокаДерева.Отметка = Ложь;
		ИначеЕсли СтрокаДерева.Итог = 2 Тогда
			СОшибкой = СОшибкой + 1;
			СтрокаДерева.Отметка = Ложь;
		Иначе
			СтрокаДерева.Отметка = Истина;
		КонецЕсли;
	КонецЦикла;
	ЗначениеВРеквизитФормы(ДеревоВыгрузки, "Накладные");

	НеНайдены = Новый Массив;
	Для Каждого КлючЗначение Из Нужные Цикл
		НеНайдены.Добавить(КлючЗначение.Значение);
	КонецЦикла;

	Текст = СтрШаблон(НСтр("ru = 'В дереве «Что выгружаем» отмечено документов: %1 (из них уже есть в БП - %2, с ошибкой - %3; они не отмечены). Период чтения %4 - %5. Проверьте отметки и нажмите «Выгрузить в папку».'"),
		Найдено - ВБП - СОшибкой, ВБП, СОшибкой, Формат(ПериодС, "ДЛФ=D"), ?(ЗначениеЗаполнено(ПериодПо), Формат(ПериодПо, "ДЛФ=D"), НСтр("ru = 'сегодня'")));
	Если НеНайдены.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрШаблон(НСтр("ru = 'Не попали в выгрузку (не подписаны, закрыты, заменены или не в выгрузке УТ): %1 - %2'"),
			НеНайдены.Количество(), СтрСоединить(НеНайдены, "; "));
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Двойной щелчок: приходная Далиона или заказ - открыть; УПД / УКД - цепочка в
// «Что выгружаем» (поиск по номеру).
&НаКлиенте
Процедура АктСверкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ДанныеСтроки = АктСверки.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле = Элементы.АктСверкиОтметка ИЛИ Поле = Элементы.АктСверкиНомер ИЛИ Поле = Элементы.АктСверкиДата
		ИЛИ Поле = Элементы.АктСверкиДебет ИЛИ Поле = Элементы.АктСверкиКредит Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;

	Если ЗначениеЗаполнено(ДанныеСтроки.ДокументУТ) Тогда
		ПоказатьЗначение(, ДанныеСтроки.ДокументУТ);
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.НомерУТ) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'У строки нет документа УТ.'"));
		Возврат;
	КонецЕсли;

	НомерУПД = ДанныеСтроки.НомерУТ;
	Если ЗначениеЗаполнено(АдресДанных) Тогда
		ЗаполнитьТаблицуНаСервере();
		РазвернутьДерево();
	Иначе
		ПрочитатьНаСервере();
		РазвернутьДерево();
	КонецЕсли;
	Элементы.СтраницыВыгрузки.ТекущаяСтраница = Элементы.СтраницаЧтоВыгружаем;

КонецПроцедуры

// Отметка «В выгрузку» - только у строк акта с документом УТ
&НаКлиенте
Процедура АктСверкиОтметкаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.АктСверки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.Уровень <> 0 ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторУТ)
		ИЛИ ТекущиеДанные.ВидУТ <> "УПД" И ТекущиеДанные.ВидУТ <> "УКД" Тогда
		ТекущиеДанные.Отметка = Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ЗапросДанныхДалиона

// Вкладка «Запрос данных Далиона»: запрос -> «Прочитать ответы» (пакеты
// разбираются и пишутся в базу УТ) -> «Что пришло» (просмотр) -> «Создать
// номенклатуру» (отмеченные карточки в справочник). Логика - в модуле объекта
// (ОтправитьЗапросДалиона и далее).

&НаСервере
Процедура ПриСозданииЗапросаДалиона()

	Обработка = РеквизитФормыВЗначение("Объект");
	Отмеченные = ЗагрузитьНастройку("ДалионТипы", Неопределено);
	Для Каждого Описание Из Обработка.ТипыДанныхДалиона() Цикл
		СтрокаТипа = ТипыДалиона.Добавить();
		СтрокаТипа.Тип = Описание.Тип;
		СтрокаТипа.Представление = Описание.Представление;
		СтрокаТипа.Отметка = ?(ТипЗнч(Отмеченные) = Тип("Массив"),
			Отмеченные.Найти(Описание.Тип) <> Неопределено, Описание.Тип = "Номенклатура");
	КонецЦикла;
	ДалионДобавлятьСпорные = ЗагрузитьНастройку("ДалионДобавлятьСпорные", Истина);
	ПапкаДалиона = ЗагрузитьНастройку("ПапкаДалиона", "");
	ПапкаПоУмолчанию = Обработка.ПапкаОбменаДалионаПоУмолчанию();
	Если НЕ ЗначениеЗаполнено(ПапкаДалиона)
		ИЛИ СтрНайти(ПапкаДалиона, "ОбменУТ_БУХ") > 0
		ИЛИ СтрНайти(ПапкаДалиона, "ПроектСупер_8") > 0 Тогда
		ПапкаДалиона = ПапкаПоУмолчанию;
		СохранитьНастройку("ПапкаДалиона", ПапкаДалиона);
	КонецЕсли;

	ДалионИнформация = НСтр("ru = 'Укажите папку обмена с Далионом, отметьте, что запросить, и нажмите «Запросить у Далиона». Когда Далион ответит - «Прочитать ответы», затем «Что пришло».'");
	// Состояние 1С:Номенклатура (подписка видна только на запросе карточек - тогда
	// при «Создать номенклатуру» будет сообщение «нет подписки»)
	Состояние = Обработка.СостояниеСервисаНоменклатуры();
	ДалионИнформация = ДалионИнформация + Символы.ПС + Состояние.Текст
		+ ?(Состояние.Доступен, НСтр("ru = ' (без подписки - в пределах бесплатного лимита карточек)'"),
			НСтр("ru = ' - карточки будут создаваться только по данным Далиона'"));

	ЗаполнитьСписокПоставщиков();
	ЗаполнитьЗапросыДалионаНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПапкаДалионаПриИзменении(Элемент)

	СохранитьНастройку("ПапкаДалиона", СокрЛП(ПапкаДалиона));

КонецПроцедуры

&НаКлиенте
Процедура ПапкаДалионаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Каталог = ПапкаДалиона;
	Диалог.Заголовок = НСтр("ru = 'Папка обмена с Далионом'");
	Диалог.Показать(Новый ОписаниеОповещения("ПапкаДалионаВыборЗавершение", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ПапкаДалионаВыборЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено ИЛИ ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПапкаДалиона = ВыбранныеФайлы[0];
	СохранитьНастройку("ПапкаДалиона", ПапкаДалиона);

КонецПроцедуры

&НаКлиенте
Процедура ДалионЗапросить(Команда)

	ДалионИнформация = ДалионЗапроситьНаСервере();

КонецПроцедуры

&НаСервере
Функция ДалионЗапроситьНаСервере()

	Типы = Новый Массив;
	Для Каждого СтрокаТипа Из ТипыДалиона Цикл
		Если СтрокаТипа.Отметка Тогда
			Типы.Добавить(СтрокаТипа.Тип);
		КонецЕсли;
	КонецЦикла;

	// Выбран поставщик - запрос только по нему: контрагент - он, спорные - его
	// штрихкоды (см. ОтправитьЗапросДалиона)
	Отбор = Новый Структура("ПериодС, ПериодПо, Штрихкоды, ИНН, Номера, ДобавлятьСпорные, Папка, Поставщик",
		ДалионПериодС, ДалионПериодПо, Новый Массив, Новый Массив, Новый Массив, ДалионДобавлятьСпорные,
		СокрЛП(ПапкаДалиона), СокрЛП(ДалионПоставщик));
	СохранитьНастройку("ПапкаДалиона", СокрЛП(ПапкаДалиона));
	СохранитьНастройку("ДалионДобавлятьСпорные", ДалионДобавлятьСпорные);
	// Штрихкоды - из таблицы отбора: отмеченные; не отмечено ни одного - все
	// строки таблицы (иначе запрос ушёл бы без штрихкодов и Далион прислал бы
	// весь справочник)
	Для Каждого СтрокаШтрихкода Из ДалионШтрихкоды Цикл
		Если СтрокаШтрихкода.Отметка И ЗначениеЗаполнено(СтрокаШтрихкода.Штрихкод) Тогда
			Отбор.Штрихкоды.Добавить(СокрЛП(СтрокаШтрихкода.Штрихкод));
		КонецЕсли;
	КонецЦикла;
	Если Отбор.Штрихкоды.Количество() = 0 Тогда
		Для Каждого СтрокаШтрихкода Из ДалионШтрихкоды Цикл
			Если ЗначениеЗаполнено(СтрокаШтрихкода.Штрихкод) Тогда
				Отбор.Штрихкоды.Добавить(СокрЛП(СтрокаШтрихкода.Штрихкод));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого СтрокаКонтрагента Из ДалионКонтрагенты Цикл
		Если СтрокаКонтрагента.Отметка Тогда
			Отбор.ИНН.Добавить(СтрокаКонтрагента.ИНН);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаНомера Из ДалионНомера Цикл
		Отбор.Номера.Добавить(СтрокаНомера.Номер);
	КонецЦикла;

	Итог = РеквизитФормыВЗначение("Объект").ОтправитьЗапросДалиона(Типы, Отбор);
	Если Итог.Успех Тогда
		ДалионПоследнийЗапрос = Итог.ИдентификаторЗапроса;
		СохранитьНастройку("ДалионТипы", Типы);
	КонецЕсли;
	ЗаполнитьЗапросыДалионаНаСервере();

	Возврат Итог.Текст;

КонецФункции

&НаКлиенте
Процедура ДалионБезШтрихкода(Команда)

	ДалионИнформация = ДалионБезШтрихкодаНаСервере();

КонецПроцедуры

&НаСервере
Функция ДалионБезШтрихкодаНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Имена = Обработка.НаименованияБезШтрихкода();
	Если Имена.Количество() = 0 Тогда
		Возврат "В УТ нет номенклатуры без штрихкодов.";
	КонецЕсли;

	Типы = Новый Массив;
	Типы.Добавить("Номенклатура");
	Отбор = Новый Структура("Наименования, Папка", Имена, СокрЛП(ПапкаДалиона));
	СохранитьНастройку("ПапкаДалиона", СокрЛП(ПапкаДалиона));
	Итог = Обработка.ОтправитьЗапросДалиона(Типы, Отбор);
	Если Итог.Успех Тогда
		ДалионПоследнийЗапрос = Итог.ИдентификаторЗапроса;
	КонецЕсли;
	ЗаполнитьЗапросыДалионаНаСервере();
	Возврат Итог.Текст;

КонецФункции

&НаКлиенте
Процедура ДалионЗаписатьШтрихкоды(Команда)

	Отмечено = 0;
	Для Каждого СтрокаКарточки Из ДалионНоменклатура Цикл
		Если СтрокаКарточки.Отметка И ЗначениеЗаполнено(СтрокаКарточки.Упаковки) Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте строки ответа, в которых есть штрихкоды Далиона.'"));
		Возврат;
	КонецЕсли;

	ДалионИнформация = ДалионЗаписатьШтрихкодыНаСервере();
	ПоказатьПредупреждение(, ДалионИнформация);

КонецПроцедуры

&НаСервере
Функция ДалионЗаписатьШтрихкодыНаСервере()

	Строки = Новый Массив;
	Для Каждого СтрокаКарточки Из ДалионНоменклатура Цикл
		Если СтрокаКарточки.Отметка И ЗначениеЗаполнено(СтрокаКарточки.Упаковки) Тогда
			Строки.Добавить(Новый Структура("Наименование, Упаковки",
				СтрокаКарточки.Наименование, СтрокаКарточки.Упаковки));
		КонецЕсли;
	КонецЦикла;

	Возврат РеквизитФормыВЗначение("Объект").ЗаписатьШтрихкодыОтвета(Строки);

КонецФункции

// Чтение ответов Далиона - в фоне (ДлительныеОперации БСП): форма не
// блокируется, по окончании таблицы заполняются сами. Фон недоступен (старая
// БСП, нет файла обработки) - читается сразу, как раньше.
&НаКлиенте
Процедура ДалионПрочитатьОтветы(Команда)

	Если ДалионЧтениеИдёт Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Ответы Далиона уже читаются в фоне - дождитесь окончания.'"));
		Возврат;
	КонецЕсли;

	ДлительнаяОперация = ЗапуститьЧтениеОтветовДалиона();
	Если ДлительнаяОперация = Неопределено Тогда
		// Прочитано сразу (фон недоступен)
		ПослеЧтенияОтветовДалиона();
		Возврат;
	КонецЕсли;

	ДалионЧтениеИдёт = Истина;
	ДалионИнформация = НСтр("ru = 'Читаем ответы Далиона в фоне (FTP и папки обмена) - можно работать дальше, таблицы заполнятся сами.'");
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация,
		Новый ОписаниеОповещения("ЧтениеОтветовДалионаЗавершено", ЭтотОбъект), ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура ЧтениеОтветовДалионаЗавершено(Результат, ДополнительныеПараметры) Экспорт

	ДалионЧтениеИдёт = Ложь;
	Если Результат = Неопределено Тогда
		ДалионИнформация = НСтр("ru = 'Чтение ответов Далиона прервано.'");
		Возврат;
	КонецЕсли;
	Если Результат.Статус = "Ошибка" Тогда
		ДалионИнформация = НСтр("ru = 'Ответы Далиона не прочитаны: '") + Результат.КраткоеПредставлениеОшибки;
		Возврат;
	КонецЕсли;

	ДалионИнформация = ПрименитьОтветыДалиона(Результат.АдресРезультата);
	ПослеЧтенияОтветовДалиона();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЧтенияОтветовДалиона()

	Если ДалионНоменклатура.Количество() > 0 Тогда
		Элементы.ДалионСтраницы.ТекущаяСтраница = Элементы.ДалионСтраницаНоменклатура;
	ИначеЕсли ДалионПришло.Количество() > 0 Тогда
		Элементы.ДалионСтраницы.ТекущаяСтраница = Элементы.ДалионСтраницаПришло;
	КонецЕсли;

КонецПроцедуры

// Длительная операция чтения (см. ДлительныеОперации.ВыполнитьФункцию) или
// Неопределено - фон недоступен, ответы уже прочитаны здесь же и разложены по
// таблицам.
&НаСервере
Функция ЗапуститьЧтениеОтветовДалиона()

	СохранитьНастройку("ПапкаДалиона", СокрЛП(ПапкаДалиона));
	Обработка = РеквизитФормыВЗначение("Объект");

	Попытка
		ОписаниеОбработки = ВнешняяОбработкаДляФона(Обработка);
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Чтение ответов Далиона (ВыгрузкаИзУт)'");
		ПараметрыВыполнения.ВнешнийОтчетОбработка = ОписаниеОбработки;
		Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			ИмяОбработкиДляФона(Обработка) + ".МодульОбъекта.ПрочитатьОтветыДалиона",
			СокрЛП(ПапкаДалиона), 7);
	Исключение
		// Фон недоступен - как раньше, сразу
		ПричинаБезФона = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ОбменУТ.ЗапросДалиона", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Чтение ответов Далиона не в фоне: " + ПричинаБезФона);
	КонецПопытки;

	Итог = Обработка.ПрочитатьОтветыДалиона(СокрЛП(ПапкаДалиона), 7);
	Если Итог.Успех Тогда
		ЗаполнитьТаблицыОтветов(Итог);
	КонецЕсли;
	ДалионИнформация = Итог.Текст + Символы.ПС + НСтр("ru = '(прочитано не в фоне: '") + ПричинаБезФона + ")";

	Возврат Неопределено;

КонецФункции

// Внешняя обработка для фонового задания БСП (ПараметрыВыполнения.ВнешнийОтчетОбработка):
// новая БСП - НовоеОписаниеВнешнегоОтчетаОбработки (поле Данные); старая (УТ
// 11.5, БСП 3.1 - этой функции нет, «Метод объекта не обнаружен») - двоичные
// данные .epf, их она принимает сама.
&НаСервере
Функция ВнешняяОбработкаДляФона(Обработка)

	// Обработка расширения (ЭАрМ_ВыгрузкаВБух) - не внешняя: подключать нечего
	Если НЕ ЭтоВнешняяОбработка(Обработка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДанныеОбработки = ДвоичныеДанныеОбработки(Обработка);
	Попытка
		Описание = ДлительныеОперации.НовоеОписаниеВнешнегоОтчетаОбработки();
	Исключение
		// Старая БСП - описание не нужно
		Возврат ДанныеОбработки;
	КонецПопытки;
	Описание.Данные = ДанныеОбработки;

	Возврат Описание;

КонецФункции

// Внешняя (.epf, ВыгрузкаИзУт) или обработка расширения (ЭАрМ_ВыгрузкаВБух -
// та же форма в расширении УТ, 16.10.2026).
&НаСервере
Функция ЭтоВнешняяОбработка(Обработка)

	Возврат СтрНачинаетсяС(Обработка.Метаданные().ПолноеИмя(), "ВнешняяОбработка");

КонецФункции

// Имя для фонового задания БСП: «ВнешняяОбработка.Имя» или «Обработка.Имя».
&НаСервере
Функция ИмяОбработкиДляФона(Обработка)

	Возврат ?(ЭтоВнешняяОбработка(Обработка), "ВнешняяОбработка.", "Обработка.") + Обработка.Метаданные().Имя;

КонецФункции

// Двоичные данные файла этой обработки - для подключения в фоновом задании.
&НаСервере
Функция ДвоичныеДанныеОбработки(Обработка)

	ИмяФайла = Обработка.ИспользуемоеИмяФайла;
	Если ЭтоАдресВременногоХранилища(ИмяФайла) Тогда
		Возврат ПолучитьИзВременногоХранилища(ИмяФайла);
	КонецЕсли;

	Возврат Новый ДвоичныеДанные(ИмяФайла);

КонецФункции

// Результат фонового чтения - в таблицы формы; возвращает текст для «Информации».
&НаСервере
Функция ПрименитьОтветыДалиона(АдресРезультата)

	Итог = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Итог) <> Тип("Структура") Тогда
		Возврат НСтр("ru = 'Результат чтения ответов Далиона не получен - нажмите «Прочитать ответы» ещё раз.'");
	КонецЕсли;
	Если Итог.Успех Тогда
		ЗаполнитьТаблицыОтветов(Итог);
	КонецЕсли;

	Возврат Итог.Текст;

КонецФункции

&НаСервере
Функция ДалионПрочитатьОтветыНаСервере()

	СохранитьНастройку("ПапкаДалиона", СокрЛП(ПапкаДалиона));
	Итог = РеквизитФормыВЗначение("Объект").ПрочитатьОтветыДалиона(СокрЛП(ПапкаДалиона), 7);
	Если НЕ Итог.Успех Тогда
		Возврат Итог.Текст;
	КонецЕсли;

	ЗаполнитьТаблицыОтветов(Итог);
	Возврат Итог.Текст;

КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицыОтветов(Итог)

	ДалионПришло.Очистить();
	Для Каждого Описание Из Итог.Пакеты Цикл
		ЗаполнитьЗначенияСвойств(ДалионПришло.Добавить(), Описание);
	КонецЦикла;

	ДалионНоменклатура.Очистить();
	Обработка = РеквизитФормыВЗначение("Объект");
	Набор = ШтрихкодыОтбора();
	Скрыто = 0;
	Для Каждого Карточка Из Итог.Карточки Цикл
		Если НЕ КарточкаИзОтбора(Карточка, Набор, Обработка) Тогда
			Скрыто = Скрыто + 1;
			Продолжить;
		КонецЕсли;
		СтрокаКарточки = ДалионНоменклатура.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаКарточки, Карточка);
		СтрокаКарточки.Отметка = Ложь;
	КонецЦикла;
	Если Скрыто > 0 Тогда
		Итог.Текст = Итог.Текст + Символы.ПС + СтрШаблон(
			НСтр("ru = 'Скрыто карточек не из таблицы отбора штрихкодов: %1 (Далион прислал больше, чем просили; очистите таблицу отбора, чтобы видеть все).'"), Скрыто);
	КонецЕсли;
	ПодставитьВидыПоКатегории();

КонецПроцедуры

&НаКлиенте
Процедура ДалионОбновитьЗапросы(Команда)

	ЗаполнитьЗапросыДалионаНаСервере();

КонецПроцедуры

// Что пришло: по выбранному на вкладке «Запросы» запросу, иначе по последнему
// отправленному из этой формы, иначе всё за 3 дня.
//
&НаКлиенте
Процедура ДалионЧтоПришло(Команда)

	ЗаполнитьЧтоПришлоНаСервере(ВыбранныйЗапросДалиона());
	Элементы.ДалионСтраницы.ТекущаяСтраница = Элементы.ДалионСтраницаНоменклатура;

КонецПроцедуры

&НаКлиенте
Функция ВыбранныйЗапросДалиона()

	Если Элементы.ДалионСтраницы.ТекущаяСтраница = Элементы.ДалионСтраницаЗапросы Тогда
		ТекущийЗапрос = Элементы.ДалионЗапросы.ТекущиеДанные;
		Если ТекущийЗапрос <> Неопределено И ЗначениеЗаполнено(ТекущийЗапрос.ИдентификаторЗапроса) Тогда
			Возврат ТекущийЗапрос.ИдентификаторЗапроса;
		КонецЕсли;
	КонецЕсли;

	Возврат ДалионПоследнийЗапрос;

КонецФункции

&НаКлиенте
Процедура ДалионСоздатьНоменклатуру(Команда)

	Если ДалионНоменклатура.Количество() = 0 Тогда
		ЗаполнитьЧтоПришлоНаСервере(ВыбранныйЗапросДалиона());
		Элементы.ДалионСтраницы.ТекущаяСтраница = Элементы.ДалионСтраницаНоменклатура;
		ПоказатьПредупреждение(, НСтр("ru = 'Проверьте, что пришло от Далиона, отметьте нужные карточки и нажмите «Создать номенклатуру» ещё раз.'"));
		Возврат;
	КонецЕсли;

	Отмечено = 0;
	Для Каждого СтрокаКарточки Из ДалионНоменклатура Цикл
		Если СтрокаКарточки.Отметка Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не отмечено ни одной карточки.'"));
		Возврат;
	КонецЕсли;

	СВидом = 0;
	Для Каждого СтрокаКарточки Из ДалионНоменклатура Цикл
		Если СтрокаКарточки.Отметка И ЗначениеЗаполнено(СтрокаКарточки.ВидУИД) Тогда
			СВидом = СВидом + 1;
		КонецЕсли;
	КонецЦикла;
	Если СВидом = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'У отмеченных карточек не выбран вид номенклатуры. Они остаются в таблице.'"));
		Возврат;
	КонецЕсли;

	Текст = ДалионСоздатьИзТаблицыНаСервере();
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

// Проверка отмеченных карточек в 1С:Номенклатура: категория сервиса, ТН ВЭД и
// вид номенклатуры (подставляется, если вид не выбран). Карточки сервиса не
// загружаются. В фоне; фон недоступен - сразу.
&НаКлиенте
Процедура ДалионПроверитьВСервисе(Команда)

	Если ДалионЧтениеИдёт Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Идёт фоновая операция - дождитесь окончания.'"));
		Возврат;
	КонецЕсли;

	Отмечено = 0;
	Для Каждого СтрокаКарточки Из ДалионНоменклатура Цикл
		Если СтрокаКарточки.Отметка И ЗначениеЗаполнено(СтрокаКарточки.Штрихкод) Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте карточки со штрихкодом штуки. Для первой проверки отметьте одну - и посмотрите на портале 1С:ИТС, изменился ли остаток бесплатного лимита.'"));
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("ДалионПроверитьВСервисеПодтверждение", ЭтотОбъект),
		СтрШаблон(НСтр("ru = 'Проверить в 1С:Номенклатура штрихкодов: %1?
			|Ищется карточка по штрихкоду и её основные данные (категория, ТН ВЭД, единица) - карточки не загружаются и не создаются.
			|Расходует ли это бесплатный лимит - проверьте на одной карточке.'"), Отмечено),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ДалионПроверитьВСервисеПодтверждение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ДлительнаяОперация = ЗапуститьПроверкуВСервисе();
	Если ДлительнаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДалионЧтениеИдёт = Истина;
	ДалионИнформация = НСтр("ru = 'Проверяем в 1С:Номенклатура в фоне - таблица заполнится сама.'");
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация,
		Новый ОписаниеОповещения("ПроверкаВСервисеЗавершена", ЭтотОбъект), ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаВСервисеЗавершена(Результат, ДополнительныеПараметры) Экспорт

	ДалионЧтениеИдёт = Ложь;
	Если Результат = Неопределено Тогда
		ДалионИнформация = НСтр("ru = 'Проверка в 1С:Номенклатура прервана.'");
		Возврат;
	КонецЕсли;
	Если Результат.Статус = "Ошибка" Тогда
		ДалионИнформация = НСтр("ru = '1С:Номенклатура: проверка не выполнена - '") + Результат.КраткоеПредставлениеОшибки;
		Возврат;
	КонецЕсли;

	ДалионИнформация = ПрименитьПроверкуВСервисе(Результат.АдресРезультата);
	ПоказатьПредупреждение(, ДалионИнформация);

КонецПроцедуры

&НаСервере
Функция СтрокиДляПроверкиВСервисе()

	Строки = Новый Массив;
	Для Каждого СтрокаКарточки Из ДалионНоменклатура Цикл
		Если СтрокаКарточки.Отметка И ЗначениеЗаполнено(СтрокаКарточки.Штрихкод) Тогда
			Строки.Добавить(Новый Структура("Штрихкод, Наименование", СтрокаКарточки.Штрихкод, СтрокаКарточки.Наименование));
		КонецЕсли;
	КонецЦикла;

	Возврат Строки;

КонецФункции

// Длительная операция проверки или Неопределено - выполнено сразу (фон недоступен).
&НаСервере
Функция ЗапуститьПроверкуВСервисе()

	Обработка = РеквизитФормыВЗначение("Объект");
	Строки = СтрокиДляПроверкиВСервисе();

	Попытка
		ОписаниеОбработки = ВнешняяОбработкаДляФона(Обработка);
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Проверка в 1С:Номенклатура (ВыгрузкаИзУт)'");
		ПараметрыВыполнения.ВнешнийОтчетОбработка = ОписаниеОбработки;
		Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			ИмяОбработкиДляФона(Обработка) + ".МодульОбъекта.ПроверитьВСервисеНоменклатуры", Строки);
	Исключение
		ПричинаБезФона = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Итог = Обработка.ПроверитьВСервисеНоменклатуры(Строки);
	ДалионИнформация = ПрименитьИтогПроверкиВСервисе(Итог) + Символы.ПС
		+ НСтр("ru = '(проверено не в фоне: '") + ПричинаБезФона + ")";

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ПрименитьПроверкуВСервисе(АдресРезультата)

	Итог = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Итог) <> Тип("Структура") Тогда
		Возврат НСтр("ru = 'Результат проверки не получен - нажмите «Проверить в 1С:Номенклатура» ещё раз.'");
	КонецЕсли;

	Возврат ПрименитьИтогПроверкиВСервисе(Итог);

КонецФункции

// Результат проверки - в строки таблицы по штрихкоду: категория сервиса и ТН ВЭД,
// откуда вид; вид подставляется, только если в строке он ещё не выбран.
&НаСервере
Функция ПрименитьИтогПроверкиВСервисе(Итог)

	Если НЕ Итог.Успех Тогда
		Возврат Итог.Текст;
	КонецЕсли;

	Подставлено = 0;
	Для Каждого Описание Из Итог.Строки Цикл
		Для Каждого СтрокаКарточки Из ДалионНоменклатура.НайтиСтроки(Новый Структура("Штрихкод", Описание.Штрихкод)) Цикл
			Если НЕ Описание.Найдено Тогда
				СтрокаКарточки.КатегорияСервиса = Описание.Ошибка;
				Продолжить;
			КонецЕсли;
			Части = Новый Массив;
			Если ЗначениеЗаполнено(Описание.Категория) Тогда
				Части.Добавить(Описание.Категория);
			КонецЕсли;
			Если ЗначениеЗаполнено(Описание.ТНВЭД) Тогда
				Части.Добавить("ТН ВЭД " + Описание.ТНВЭД);
			КонецЕсли;
			Если ЗначениеЗаполнено(Описание.ТоварнаяГруппа) Тогда
				Части.Добавить("группа " + Описание.ТоварнаяГруппа);
			КонецЕсли;
			Если ЗначениеЗаполнено(Описание.Единица) Тогда
				Части.Добавить("ед. " + Описание.Единица);
			КонецЕсли;
			Если ЗначениеЗаполнено(Описание.Ошибка) Тогда
				Части.Добавить(Описание.Ошибка);
			КонецЕсли;
			СтрокаКарточки.КатегорияСервиса = СтрСоединить(Части, "; ");
			СтрокаКарточки.ВидИсточник = Описание.ВидИсточник;
			Если ЗначениеЗаполнено(Описание.ВидУИД) И НЕ ЗначениеЗаполнено(СтрокаКарточки.ВидУИД) Тогда
				СтрокаКарточки.ВидУИД = Описание.ВидУИД;
				СтрокаКарточки.Вид = Описание.Вид;
				Подставлено = Подставлено + 1;
			КонецЕсли;
			Если ЗначениеЗаполнено(Описание.КатегорияУТ) И НЕ ЗначениеЗаполнено(СтрокаКарточки.Категория) Тогда
				СтрокаКарточки.Категория = Описание.КатегорияУТ;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Итог.Текст + Символы.ПС + СтрШаблон(
		НСтр("ru = 'Вид подставлен в строки без вида: %1 (выбранный вручную не менялся). Проверьте колонку «Вид определён по».'"),
		Подставлено);

КонецФункции

&НаКлиенте
Процедура ДалионОтметитьВсе(Команда)

	Для Каждого СтрокаКарточки Из ДалионНоменклатура Цикл
		СтрокаКарточки.Отметка = Истина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДалионНоменклатураВидНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущаяСтрока = Элементы.ДалионНоменклатура.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыВыбора = Новый Структура("РежимВыбора, ЗакрыватьПриВыборе", Истина, Истина);
	ОткрытьФорму("Справочник.ВидыНоменклатуры.ФормаВыбора", ПараметрыВыбора, ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ДалионВидВыбран", ЭтотОбъект, ТекущаяСтрока),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ДалионВидВыбран(ВыбранноеЗначение, ИдентификаторСтроки) Экспорт

	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;

	Описание = ОписаниеВидаНоменклатурыНаСервере(ВыбранноеЗначение);
	Если Описание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Описание.ЭтоГруппа Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите вид номенклатуры, а не группу видов'"));
		Возврат;
	КонецЕсли;

	СтрокаКарточки = ДалионНоменклатура.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаКарточки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаКарточки.Вид = Описание.Представление;
	СтрокаКарточки.ВидУИД = Описание.УИД;

КонецПроцедуры

&НаКлиенте
Процедура ДалионНоменклатураВидОчистка(Элемент, СтандартнаяОбработка)

	СтрокаКарточки = Элементы.ДалионНоменклатура.ТекущиеДанные;
	Если СтрокаКарточки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаКарточки.Вид = "";
	СтрокаКарточки.ВидУИД = "";

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОписаниеВидаНоменклатурыНаСервере(Ссылка)

	Возврат ЭАрМ_КатегорииТоваров.ОписаниеСсылки(Ссылка);

КонецФункции

&НаСервере
Функция ДалионСоздатьИзТаблицыНаСервере()

	Карточки = Новый Массив;
	ВидыТоваров = Новый Массив;
	Ожидают = 0;
	Для Каждого СтрокаКарточки Из ДалионНоменклатура Цикл
		Если НЕ СтрокаКарточки.Отметка Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаКарточки.ВидУИД) Тогда
			Ожидают = Ожидают + 1;
			Продолжить;
		КонецЕсли;
		// Упаковки («коэф|код;...») - все штрихкоды карточки с коэффициентами:
		// штука - на карточку, коробки - упаковками со своими штрихкодами
		// Единица - единица хранения из карточки Далиона (если вид и поставки её не дали)
		Карточки.Добавить(Новый Структура("Наименование, Штрихкод, Штрихкоды, Упаковки, Единица, Категория",
			СтрокаКарточки.Наименование, СтрокаКарточки.Штрихкод,
			СтрокаКарточки.Штрихкоды, СтрокаКарточки.Упаковки, СтрокаКарточки.Единица, СтрокаКарточки.Категория));
		ВидыТоваров.Добавить(Новый Структура("Штрихкод, ВидУИД", СтрокаКарточки.Штрихкод, СтрокаКарточки.ВидУИД));
	КонецЦикла;

	Обработка = РеквизитФормыВЗначение("Объект");
	Текст = Обработка.СоздатьНоменклатуру(Карточки, ВидыТоваров);
	Если Ожидают > 0 Тогда
		Текст = Текст + Символы.ПС + СтрШаблон(
			"Ожидают выбора вида и остаются в таблице: %1", Ожидают);
	КонецЕсли;

	Для Каждого СтрокаКарточки Из ДалионНоменклатура Цикл
		Если НЕ СтрокаКарточки.Отметка ИЛИ НЕ ЗначениеЗаполнено(СтрокаКарточки.ВидУИД) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			УжеЕсть = ЭАрМ_КатегорииТоваров.ЕстьКарточкаУТПоШтрихкодам(Обработка.ЧистыеШтрихкодыКарточки(
				Новый Структура("Штрихкод, Штрихкоды, Упаковки",
					СтрокаКарточки.Штрихкод, СтрокаКарточки.Штрихкоды, СтрокаКарточки.Упаковки)));
		Исключение
			УжеЕсть = Ложь;
		КонецПопытки;
		Если УжеЕсть Тогда
			СтрокаКарточки.ЕстьВУТ = Истина;
			СтрокаКарточки.Отметка = Ложь;
		КонецЕсли;
	КонецЦикла;
	ДалионИнформация = Текст;

	Возврат Текст;

КонецФункции

&НаКлиенте
Процедура ДалионШтрихкодыБезПары(Команда)

	ДалионЗаполнитьШтрихкодыНаСервере(Истина);

КонецПроцедуры

&НаКлиенте
Процедура ДалионШтрихкодыБезКарточки(Команда)

	ДалионЗаполнитьШтрихкодыНаСервере(Ложь);

КонецПроцедуры

// Спорные позиции списком - посмотреть, что перезапросится, и снять лишнее
// (флажок «Перезапрашивать спорные» добавляет их к запросу и без этого).
//
&НаКлиенте
Процедура ДалионШтрихкодыСпорные(Команда)

	ДалионЗаполнитьШтрихкодыНаСервере(Неопределено);

КонецПроцедуры

// Параметры:
//   БезПары - Булево - Истина: без пары, Ложь: без карточки Далиона,
//             Неопределено: спорные позиции
//
&НаСервере
Процедура ДалионЗаполнитьШтрихкодыНаСервере(БезПары)

	Обработка = РеквизитФормыВЗначение("Объект");
	Если БезПары = Неопределено Тогда
		Описания = Обработка.ШтрихкодыСпорные();
	ИначеЕсли БезПары Тогда
		Описания = Обработка.ШтрихкодыБезПары();
	Иначе
		Описания = Обработка.ШтрихкодыБезКарточкиДалиона();
	КонецЕсли;

	ДалионШтрихкоды.Очистить();
	Для Каждого Описание Из Описания Цикл
		СтрокаШтрихкода = ДалионШтрихкоды.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаШтрихкода, Описание);
		СтрокаШтрихкода.Отметка = Истина;
	КонецЦикла;

	// Штрихкоды уходят только с «Номенклатурой»
	Если Описания.Количество() > 0 Тогда
		Для Каждого СтрокаТипа Из ТипыДалиона.НайтиСтроки(Новый Структура("Тип", "Номенклатура")) Цикл
			СтрокаТипа.Отметка = Истина;
		КонецЦикла;
	КонецЕсли;

	ДалионИнформация = СтрШаблон(НСтр("ru = 'Штрихкодов в отборе: %1.'"), Описания.Количество());

КонецПроцедуры

&НаКлиенте
Процедура ДалионПоставщики(Команда)

	ДалионПоставщикиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ДалионПоставщикиНаСервере()

	Для Каждого Описание Из РеквизитФормыВЗначение("Объект").ПоставщикиУПД(30) Цикл
		Если ДалионКонтрагенты.НайтиСтроки(Новый Структура("ИНН", Описание.ИНН)).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ДалионКонтрагенты.Добавить(), Описание);
	КонецЦикла;

	ДалионИнформация = НСтр("ru = 'Поставщики УПД за 30 дней добавлены без отметки - отметьте нужных.'");

КонецПроцедуры

// Номенклатура выбранного поставщика из регистра штрихкодов: проверка «есть в УТ»,
// затем строки в таблицу штрихкодов запроса. Отмечены только те, кого в УТ нет.
//
&НаКлиенте
Процедура ДалионНоменклатураПоставщика(Команда)

	ДалионИнформация = ДалионНоменклатураПоставщикаНаСервере();

КонецПроцедуры

&НаСервере
Функция ДалионНоменклатураПоставщикаНаСервере()

	Если НЕ ЗначениеЗаполнено(ДалионПоставщик) Тогда
		Возврат НСтр("ru = 'Выберите поставщика.'");
	КонецЕсли;

	ИННПоставщика = СокрЛП(ДалионПоставщик);
	ИНН = Новый Массив;
	ИНН.Добавить(ИННПоставщика);

	Описания = РеквизитФормыВЗначение("Объект").НоменклатураПоставщикаДляЗапроса(ИНН);

	ДалионШтрихкоды.Очистить();
	ЕстьВУТ = 0;
	НетВУТ = 0;
	Для Каждого Описание Из Описания Цикл
		СтрокаШтрихкода = ДалионШтрихкоды.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаШтрихкода, Описание);
		Если Описание.ЕстьВУТ Тогда
			ЕстьВУТ = ЕстьВУТ + 1;
		ИначеЕсли ЗначениеЗаполнено(Описание.Штрихкод) Тогда
			НетВУТ = НетВУТ + 1;
		КонецЕсли;
	КонецЦикла;

	Если НетВУТ > 0 Тогда
		Для Каждого СтрокаТипа Из ТипыДалиона.НайтиСтроки(Новый Структура("Тип", "Номенклатура")) Цикл
			СтрокаТипа.Отметка = Истина;
		КонецЦикла;
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = 'Номенклатура поставщика %1: %2. В УТ уже есть %3, нет в УТ %4 - они отмечены и уйдут в запрос.'"),
		ИННПоставщика, Описания.Количество(), ЕстьВУТ, НетВУТ);

КонецФункции

&НаСервере
Процедура ЗаполнитьСписокПоставщиков()

	Элементы.ДалионПоставщик.РежимВыбораИзСписка = Истина;
	Элементы.ДалионПоставщик.АвтоМаксимальнаяШирина = Ложь;
	Элементы.ДалионПоставщик.МаксимальнаяШирина = 40;
	Элементы.ДалионПоставщик.СписокВыбора.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШК.ИННПоставщика КАК ИНН,
	|	МАКСИМУМ(ШК.Поставщик) КАК Наименование
	|ИЗ
	|	РегистрСведений.ЭАрМ_ШтрихкодыПоставщиков КАК ШК
	|ГДЕ
	|	ШК.ИННПоставщика <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	ШК.ИННПоставщика
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		ЗаписьЖурналаРегистрации("ОбменУТ.ЗапросДалиона", УровеньЖурналаРегистрации.Ошибка, , ,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		ИНН = СокрЛП(Выборка.ИНН);
		Наименование = СокрЛП(Выборка.Наименование);
		Если НЕ ЗначениеЗаполнено(Наименование) Тогда
			Наименование = ИНН;
		КонецЕсли;
		Элементы.ДалионПоставщик.СписокВыбора.Добавить(ИНН, Наименование + " (" + ИНН + ")");
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗапросыДалионаНаСервере()

	Попытка
		ЗначениеВРеквизитФормы(РеквизитФормыВЗначение("Объект").ЗапросыДалиона(), "ДалионЗапросы");
	Исключение
		// Нет регистров ЭАрМ - вкладка остаётся пустой, причина в журнале
		ЗаписьЖурналаРегистрации("ОбменУТ.ЗапросДалиона", УровеньЖурналаРегистрации.Ошибка, , ,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЧтоПришлоНаСервере(ИдентификаторЗапроса)

	Обработка = РеквизитФормыВЗначение("Объект");

	ДалионПришло.Очистить();
	Для Каждого Описание Из Обработка.ЧтоПришло(ИдентификаторЗапроса) Цикл
		ЗаполнитьЗначенияСвойств(ДалионПришло.Добавить(), Описание);
	КонецЦикла;

	ДалионНоменклатура.Очистить();
	НетВУТ = 0;
	Набор = ШтрихкодыОтбора();
	Скрыто = 0;
	Для Каждого Карточка Из Обработка.КарточкиНоменклатуры(ИдентификаторЗапроса) Цикл
		// Далион прислал больше, чем просили (весь справочник) - только из отбора
		Если НЕ КарточкаИзОтбора(Карточка, Набор, Обработка) Тогда
			Скрыто = Скрыто + 1;
			Продолжить;
		КонецЕсли;
		СтрокаКарточки = ДалионНоменклатура.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаКарточки, Карточка);
		// Отмечено то, что можно создать: товара в УТ нет и есть штрихкод
		СтрокаКарточки.Отметка = НЕ Карточка.ЕстьВУТ И ЗначениеЗаполнено(Карточка.Штрихкод);
		Если НЕ Карточка.ЕстьВУТ Тогда
			НетВУТ = НетВУТ + 1;
		КонецЕсли;
	КонецЦикла;

	ДалионИнформация = СтрШаблон(
		НСтр("ru = 'Пришло от Далиона (%1): пакетов %2, карточек номенклатуры %3, из них нет в УТ %4.'"),
		?(ЗначениеЗаполнено(ИдентификаторЗапроса), "запрос " + ИдентификаторЗапроса, "за 3 дня"),
		ДалионПришло.Количество(), ДалионНоменклатура.Количество(), НетВУТ)
		+ ?(Скрыто > 0, СтрШаблон(НСтр("ru = ' Скрыто не из таблицы отбора штрихкодов: %1.'"), Скрыто), "");
	ПодставитьВидыПоКатегории();

КонецПроцедуры

// Штрихкоды таблицы отбора (ДалионШтрихкоды) - по ним просили номенклатуру.
// Пустая таблица - отбора нет (Неопределено).
&НаСервере
Функция ШтрихкодыОтбора()

	Если ДалионШтрихкоды.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Набор = Новый Соответствие;
	Для Каждого СтрокаШтрихкода Из ДалионШтрихкоды Цикл
		Код = СокрЛП(СтрокаШтрихкода.Штрихкод);
		Если СтрДлина(Код) = 14 И СтрНачинаетсяС(Код, "0") Тогда
			Код = Сред(Код, 2);
		КонецЕсли;
		Если ЗначениеЗаполнено(Код) Тогда
			Набор.Вставить(Код, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат ?(Набор.Количество() = 0, Неопределено, Набор);

КонецФункции

// Карточка Далиона - из отбора: хоть один её штрихкод (штуки или упаковки) есть
// в таблице отбора. Отбора нет - любая.
&НаСервере
Функция КарточкаИзОтбора(Карточка, Набор, Обработка)

	Если Набор = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Описание = Новый Структура("Штрихкод, Штрихкоды, Упаковки", "", "", "");
	ЗаполнитьЗначенияСвойств(Описание, Карточка);
	Для Каждого Код Из СтрРазделить(Обработка.ЧистыеШтрихкодыКарточки(Описание), ";", Ложь) Цикл
		Если Набор.Получить(Код) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервере
Процедура ПодставитьВидыПоКатегории()

	Для Каждого СтрокаКарточки Из ДалионНоменклатура Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаКарточки.Категория) Тогда
			Попытка
				СтрокаКарточки.Категория = ЭАрМ_КатегорииТоваров.КатегорияТовара(СтрокаКарточки.Наименование);
			Исключение
			КонецПопытки;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаКарточки.ВидУИД) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Вид = ЭАрМ_КатегорииТоваров.ВидКатегорииПоУмолчанию(СтрокаКарточки.Категория);
		Исключение
			Продолжить;
		КонецПопытки;
		СтрокаКарточки.Вид = Вид.Представление;
		СтрокаКарточки.ВидУИД = Вид.УИД;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
