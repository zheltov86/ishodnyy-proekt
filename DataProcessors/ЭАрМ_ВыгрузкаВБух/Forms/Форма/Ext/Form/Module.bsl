// Короткая причина, почему документ не выгрузится (полный текст - в «Проверке»).
&НаСервереБезКонтекста
Функция КраткаяПричинаУТ(Проверка)

	Т = НРег(Проверка);
	Правила = Новый Массив;
	Правила.Добавить("«до» не получено|Нет «до»: файл УКД из СБИС не прочитан");
	Правила.Добавить("неподписанная укд|Раньше в цепочке неподписанная УКД");
	Правила.Добавить("не подписана|УКД не подписана");
	Правила.Добавить("строки нет в упд|Позиции УКД нет в УПД");
	Правила.Добавить("«до» в файле укд нет|Позиции нет в файле УКД");
	Правила.Добавить("строк укд в регистре|Нет строк УКД в УТ");
	Правила.Добавить("исходной упд нет в реестре|Нет УПД в реестре (включите «Старые УКД»)");
	Правила.Добавить("не выгружается (не подписана|УПД не выгружается и не уходила в Бух");
	Правила.Добавить("нет даты платежа|Нет договора / срока оплаты в УТ");
	Правила.Добавить("договор|Договор");
	Для Каждого Правило Из Правила Цикл
		Части = СтрРазделить(Правило, "|");
		Если СтрНайти(Т, Части[0]) > 0 Тогда
			Возврат Части[1];
		КонецЕсли;
	КонецЦикла;

	Возврат Лев(Проверка, 80);

КонецФункции

// Итог документа в дереве: 2 - в БП не создастся (ошибка), 1 - есть замечания.
&НаСервереБезКонтекста
Функция ИтогОписания(Описание)

	Если Описание.Ошибка Тогда
		Возврат 2;
	ИначеЕсли Описание.Свойство("Внимание") И Описание.Внимание = Истина Тогда
		Возврат 1;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Итог групп цепочек - худший из документов внутри (2 - ошибка, 1 - внимание,
// 3 - выгружена); строки документов не трогаются.
&НаСервереБезКонтекста
Функция ПроставитьИтогГрупп(Строки)

	Худший = 0;
	Для Каждого СтрокаДерева Из Строки Цикл
		Итог = СтрокаДерева.Итог;
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			Подчиненные = ПроставитьИтогГрупп(СтрокаДерева.Строки);
			Если СтрокаДерева.Уровень = 0 Тогда
				Итог = Подчиненные;
				СтрокаДерева.Итог = Итог;
			КонецЕсли;
		КонецЕсли;
		Если Итог = 2 ИЛИ Итог = 1 И Худший <> 2 ИЛИ Итог = 3 И Худший = 0 Тогда
			Худший = Итог;
		КонецЕсли;
	КонецЦикла;

	Возврат Худший;

КонецФункции

// Подсветка строк: дерево «Что выгружаем» - по «Итогу»; таблицы Далиона - по
// своим полям (ошибка пакета, нет ответа, нет штрихкода, товара нет в УТ).
// Красный - ошибка, жёлтый - проверьте, зелёный - выгружена.
&НаСервере
Процедура НастроитьПодсветку()

	Красный = Новый Цвет(255, 214, 214);
	Желтый = Новый Цвет(255, 242, 196);
	Зеленый = Новый Цвет(218, 245, 218);
	Равно = ВидСравненияКомпоновкиДанных.Равно;

	ДобавитьПодсветку("Накладные", Красный, "Накладные.Итог", Равно, 2);
	ДобавитьПодсветку("Накладные", Желтый, "Накладные.Итог", Равно, 1);
	ДобавитьПодсветку("Накладные", Зеленый, "Накладные.Итог", Равно, 3);

	ДобавитьПодсветку("ПриходыБП", Красный, "ПриходыБП.Итог", Равно, 2);
	ДобавитьПодсветку("ПриходыБП", Желтый, "ПриходыБП.Итог", Равно, 1);
	ДобавитьПодсветку("ПриходыБП", Зеленый, "ПриходыБП.Итог", Равно, 3);

	ДобавитьПодсветку("СборкаДокументов", Красный, "СборкаДокументов.Итог", Равно, 2);
	ДобавитьПодсветку("СборкаДокументов", Желтый, "СборкаДокументов.Итог", Равно, 1);
	ДобавитьПодсветку("СборкаДокументов", Зеленый, "СборкаДокументов.Итог", Равно, 3);

	ДобавитьПодсветку("АктСверки", Красный, "АктСверки.Итог", Равно, 2);
	ДобавитьПодсветку("АктСверки", Желтый, "АктСверки.Итог", Равно, 1);
	ДобавитьПодсветку("АктСверки", Зеленый, "АктСверки.Итог", Равно, 3);

	ДобавитьПодсветку("СвязиПриходовБП", Красный, "СвязиПриходовБП.Итог", Равно, 2);
	ДобавитьПодсветку("СвязиПриходовБП", Желтый, "СвязиПриходовБП.Итог", Равно, 1);
	ДобавитьПодсветку("СвязиПриходовБП", Зеленый, "СвязиПриходовБП.Итог", Равно, 3);

	ДобавитьПодсветку("ДействияУКД", Красный, "ДействияУКД.Итог", Равно, 2);

	ДобавитьПодсветку("ПоискДокументы", Красный, "ПоискДокументы.Итог", Равно, 2);
	ДобавитьПодсветку("ПоискДокументы", Желтый, "ПоискДокументы.Итог", Равно, 1);
	ДобавитьПодсветку("ПоискДокументы", Зеленый, "ПоискДокументы.Итог", Равно, 3);
	ДобавитьПодсветку("ДействияУКД", Зеленый, "ДействияУКД.Итог", Равно, 3);

	ДобавитьПодсветку("ДалионПришло", Красный, "ДалионПришло.ТекстОшибки", ВидСравненияКомпоновкиДанных.Заполнено);
	ДобавитьПодсветку("ДалионЗапросы", Красный, "ДалионЗапросы.Статус", ВидСравненияКомпоновкиДанных.Содержит, "шибк");
	ДобавитьПодсветку("ДалионЗапросы", Желтый, "ДалионЗапросы.Получено", ВидСравненияКомпоновкиДанных.НеЗаполнено,
		, "ДалионЗапросы.Статус", ВидСравненияКомпоновкиДанных.НеСодержит, "шибк");
	ДобавитьПодсветку("ДалионНоменклатура", Красный, "ДалионНоменклатура.Штрихкод", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ДобавитьПодсветку("ДалионНоменклатура", Желтый, "ДалионНоменклатура.ЕстьВУТ", Равно, Ложь,
		"ДалионНоменклатура.Штрихкод", ВидСравненияКомпоновкиДанных.Заполнено);

КонецПроцедуры

// Элемент условного оформления: фон строки таблицы по одному или двум
// условиям (оба должны выполняться).
&НаСервере
Процедура ДобавитьПодсветку(ИмяТаблицы, ЦветФона, Поле1, Вид1, Значение1 = Неопределено,
	Поле2 = "", Вид2 = Неопределено, Значение2 = Неопределено)

	Элемент = УсловноеОформление.Элементы.Добавить();

	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Поле1);
	Отбор.ВидСравнения = Вид1;
	Отбор.ПравоеЗначение = Значение1;

	Если ЗначениеЗаполнено(Поле2) Тогда
		Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Поле2);
		Отбор.ВидСравнения = Вид2;
		Отбор.ПравоеЗначение = Значение2;
	КонецЕсли;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	ОформляемоеПоле = Элемент.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы);

