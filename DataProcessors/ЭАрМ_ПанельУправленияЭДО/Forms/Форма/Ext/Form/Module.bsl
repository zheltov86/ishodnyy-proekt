
#Область ОписаниеПеременных

// Слепок состояния регистра ожидаемых подтверждений на момент последнего
// чтения журнала. Живёт на клиенте, пока открыта форма: отдельный реквизит
// формы ради него заводить незачем.
&НаКлиенте
Перем ПоследняяМеткаЖурнала;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТестовыйРежим = Ложь;
	ЗагрузитьЖурналИзРегистра();
КонецПроцедуры

// Журнал наполняют регламентное задание и подписки - то есть сервер, без
// участия этого сеанса. Оповестить форму оттуда нечем: ОповеститьОбИзменении
// живёт на клиенте, а фоновое задание до клиента не дотягивается. Поэтому
// форма сама раз в 15 секунд спрашивает сервер, изменилось ли что-нибудь.
//
// Спрашивает дёшево: один агрегатный запрос без выборки строк. Таблица
// журнала перечитывается, только если слепок изменился, - в тихие часы
// по сети не уходит ничего, кроме короткой строки.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПоследняяМеткаЖурнала = МеткаЖурналаНаСервере();
	ПодключитьОбработчикОжидания("Подключаемый_ОбновитьЖурнал", 15);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьЖурнал()

	ПоследняяМеткаЖурнала = ОбновитьЖурналЕслиИзменилсяНаСервере(ПоследняяМеткаЖурнала);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьНастройки(Команда)
	ЗаписатьБазовыеНастройкиНаСервере();
	// Регистр настроек убран из раздела: форма открывается отсюда, поверх панели
	ОткрытьФорму("РегистрСведений.ЭАрМ_НастройкиЭДО.Форма.ФормаНастроек", , ЭтаФорма, , , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

// Настройки ЕГАИС открываются поверх панели, как и настройки ЭДО.
//
&НаКлиенте
Процедура НастройкиЕГАИС(Команда)
	ОткрытьФорму("Обработка.ЭАрМ_ПанельУправленияЭДО.Форма.ФормаНастроекЕГАИС", , ЭтаФорма, , , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

// Функциональная опция «Очередь отправки в СБИС» и её настройки - поверх панели.
//
&НаКлиенте
Процедура НастройкиОчередиОтправки(Команда)
	ОткрытьФорму("Обработка.ЭАрМ_ПанельУправленияЭДО.Форма.ФормаНастроекОчереди", , ЭтаФорма, , , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьАлкогольУПД(Команда)
	Состояние(НСтр("ru = 'Алкоголь ЕГАИС: пересчёт строк УПД...'"));
	ПересчитатьАлкогольУПДНаСервере();
	Состояние();
КонецПроцедуры

&НаКлиенте
Процедура ТестироватьМеханизм(Команда)
	ТестироватьМеханизмНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанные(Команда)

	Состояние(НСтр("ru = 'Обновление реестров из СБИС...'"));
	ПолучитьДанныеНаСервере();
	Состояние();

КонецПроцедуры

&НаКлиенте
Процедура ТестироватьЭТрН(Команда)
	ЗаписатьВсеНастройкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТестироватьЗаказПокупателя(Команда)
	ТестироватьЗаказПокупателяНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьОжидаемыеВПапку(Команда)
	ОтправитьОжидаемыеВПапкуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ИмитироватьРегламентноеЗадание(Команда)
	ЧитатьПапкуОбменаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьТестовыйОтвет(Команда)
	СоздатьТестовыйОтветНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЖурнал(Команда)
	ПоследняяМеткаЖурнала = ПеречитатьЖурналНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРегистрЭДО(Команда)
	ОткрытьФорму("РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.ФормаСписка");
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайл(Команда)
	ОткрытьФормуВыбораФайла();
КонецПроцедуры

&НаКлиенте
Процедура ИмитироватьСобытиеСтатуса(Команда)
	ИмитироватьСобытиеСтатусаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВсе(Команда)

	// Спрашиваем не только "да/нет": настройки чистить нужно далеко не всегда,
	// а восстанавливать их потом руками
	ВариантыОтвета = Новый СписокЗначений;
	ВариантыОтвета.Добавить("Данные",  НСтр("ru = 'Очистить данные'"));
	ВариантыОтвета.Добавить("Всё",     НСтр("ru = 'Очистить всё, включая настройки'"));
	ВариантыОтвета.Добавить("Отмена",  НСтр("ru = 'Отмена'"));

	ТекстВопроса = НСтр("ru = 'Очистить регистры ЭДО расширения?
		|
		|Реестр ЭТрН, товары ЭТрН, входящие УПД, ожидаемые подтверждения
		|и журнал обмена будут удалены без возможности восстановления.
		|
		|Файлы в папках обмена (выгрузка и ответы, вместе с вложенными
		|каталогами) тоже будут удалены, сами папки останутся.
		|
		|В корень папки выгрузки будет записан системный JSON с Очистить = Истина,
		|чтобы АРМ_ТестЭдо тоже сбросил свои регистры.
		|
		|Состояния ЭДО основной конфигурации не затрагиваются.'");

	ОписаниеОповещения = Новый ОписаниеОповещения("ОчиститьВсеЗавершение", ЭтотОбъект);

	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, ВариантыОтвета, ,
		"Отмена", НСтр("ru = 'Очистка регистров ЭДО'"));

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВсеЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = Неопределено ИЛИ Ответ = "Отмена" Тогда
		Возврат;
	КонецЕсли;

	ТекстИтога = ОчиститьВсеНаСервере(Ответ = "Всё");

	ЗагрузитьЖурналИзРегистра();
	ПоказатьПредупреждение(, ТекстИтога, 15, "АРМ ЭДО");

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТехническуюИнформацию(Команда)

	// В отличие от "Очистить всё" удаляются только старые служебные записи,
	// поэтому достаточно выбрать глубину хранения
	ВариантыОтвета = Новый СписокЗначений;
	ВариантыОтвета.Добавить(30,  НСтр("ru = 'Старше 30 дней'"));
	ВариантыОтвета.Добавить(90,  НСтр("ru = 'Старше 90 дней'"));
	ВариантыОтвета.Добавить(180, НСтр("ru = 'Старше 180 дней'"));
	ВариантыОтвета.Добавить("Отмена", НСтр("ru = 'Отмена'"));

	ТекстВопроса = НСтр("ru = 'Удалить старые записи технических регистров?
		|
		|Журнал обмена ЭДО, запросы Далион и обработанные пакеты Далион
		|старше выбранного срока будут удалены без возможности восстановления.
		|
		|Реестры документов, товары, цепочка закупки и настройки
		|не затрагиваются.'");

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОчиститьТехническуюИнформациюЗавершение", ЭтотОбъект);

	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, ВариантыОтвета, ,
		"Отмена", НСтр("ru = 'Очистка технической информации'"));

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТехническуюИнформациюЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = Неопределено ИЛИ Ответ = "Отмена" Тогда
		Возврат;
	КонецЕсли;

	ТекстИтога = ОчиститьТехническуюИнформациюНаСервере(Ответ);

	ЗагрузитьЖурналИзРегистра();
	ПоказатьПредупреждение(, ТекстИтога, 15, "АРМ ЭДО");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ОчиститьВсеНаСервере(ВключаяНастройки)

	Попытка
		Возврат ЭАрМ_ПанельУправленияЭДОСервер.ОчиститьРегистрыЭДО(ВключаяНастройки).Результат;
	Исключение
		Возврат СтрШаблон(НСтр("ru = 'Ошибка очистки: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

&НаСервере
Функция ОчиститьТехническуюИнформациюНаСервере(ГлубинаДней)

	Попытка
		Возврат ЭАрМ_ПанельУправленияЭДОСервер.ОчиститьТехническуюИнформацию(ГлубинаДней).Результат;
	Исключение
		Возврат СтрШаблон(НСтр("ru = 'Ошибка очистки: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

// Обмен с Далионом по уже загруженным регистрам.
//
// В СБИС не ходит: сопоставление состава -> JSON -> отправка в базу 2 ->
// разбор её ответов. Данные для этого кладёт в регистры "Получить данные"
// либо задание ЭАрМ_ОбновлениеРеестровЭДО.
//
&НаСервере
Процедура ТестироватьМеханизмНаСервере()

	ЖурналОтправок.Очистить();

	Попытка
		Итоги = ЭАрМ_РегламентныйОбменЭДО.ВыполнитьОбмен();
	Исключение
		ДобавитьСтрокуЖурнала("<Обмен ЭДО>", "", "Ошибка", ТекущаяДатаСеанса(), "",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ПрименитьВизуализациюСтатусов();
		Возврат;
	КонецПопытки;

	ПоказатьИтогиОбмена(Итоги);

КонецПроцедуры

// Наполнение регистров из СБИС - единственное место, откуда идут запросы.
//
// Сначала реестр ЭТрН вместе с документами и их грузом, следом реестр УПД
// с товарами. Порядок важен: сопоставление ищет УПД по номеру ЭТрН.
//
&НаСервере
Процедура ПолучитьДанныеНаСервере()

	ЖурналОтправок.Очистить();

	Попытка
		Итоги = ЭАрМ_РегламентныйОбменЭДО.ОбновитьРеестры();
	Исключение
		ДобавитьСтрокуЖурнала("<Получение данных>", "", "Ошибка", ТекущаяДатаСеанса(), "",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ПрименитьВизуализациюСтатусов();
		Возврат;
	КонецПопытки;

	ПоказатьИтогиОбмена(Итоги);

КонецПроцедуры

// Выкладывает результат сеанса обмена в журнал формы.
//
// Параметры:
//   Итоги - Структура - см. ЭАрМ_РегламентныйОбменЭДО.ВыполнитьОбмен
//
&НаСервере
Процедура ПоказатьИтогиОбмена(Итоги)

	Если НЕ Итоги.Успех Тогда
		ДобавитьСтрокуЖурнала("<Обмен ЭДО>", "", "Ошибка", ТекущаяДатаСеанса(), "",
			?(ЗначениеЗаполнено(Итоги.Ошибка), Итоги.Ошибка,
				НСтр("ru = 'Сеанс обмена не состоялся'")));
	КонецЕсли;

	Для Каждого Сообщение Из Итоги.Сообщения Цикл
		ДобавитьСтрокуЖурнала("<Обмен ЭДО>", "", "Проверен",
			ТекущаяДатаСеанса(), "", Сообщение);
	КонецЦикла;

	ДобавитьСтрокуЖурнала("<Обмен ЭДО>", "", ?(Итоги.Успех, "Проверен", "Ошибка"),
		ТекущаяДатаСеанса(), "",
		СтрШаблон(НСтр("ru = 'ЭТрН: %1, УПД: %2, выгружено в базу 2: %3, ошибок выгрузки: %4'"),
			Итоги.ЗагруженоЭТрН, Итоги.ЗагруженоУПД, Итоги.Выгружено, Итоги.ОшибокВыгрузки));

	ПрименитьВизуализациюСтатусов();

КонецПроцедуры

// Кнопка "Все настройки": пишет в регистр ВСЕ статичные настройки,
// перетирая то, что там было.
//
&НаСервере
Процедура ЗаписатьВсеНастройкиНаСервере()

	ЖурналОтправок.Очистить();

	Попытка
		Записанные = ЭАрМ_НастройкиСервер.ЗаписатьВсеНастройки();
	Исключение
		ДобавитьСтрокуЖурнала("<Все настройки>", "", "Ошибка", ТекущаяДатаСеанса(), "",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ПрименитьВизуализациюСтатусов();
		Возврат;
	КонецПопытки;

	// В журнал выводится только ключ: значения настроек на экран не выносим
	Для Каждого Настройка Из Записанные Цикл
		ДобавитьСтрокуЖурнала(Настройка.Ключ, "", "Записано", ТекущаяДатаСеанса(), "",
			"РегистрСведений.ЭАрМ_НастройкиЭДО");
	КонецЦикла;

	ДобавитьСтрокуЖурнала("<Все настройки>", "", "Проверен", ТекущаяДатаСеанса(), "",
		СтрШаблон(НСтр("ru = 'Записано настроек: %1. Папка обмена: %2'"),
			Записанные.Количество(),
			ЭАрМ_НастройкиСервер.ПолучитьНастройку("ПапкаОбмена")));

	ПрименитьВизуализациюСтатусов();

КонецПроцедуры

// Пересчёт колонки «Алкоголь» у всех строк УПД (ЭАрМ_АлкогольЕГАИС).
//
&НаСервере
Процедура ПересчитатьАлкогольУПДНаСервере()

	ЖурналОтправок.Очистить();

	Попытка
		Итог = ЭАрМ_АлкогольЕГАИС.ПересчитатьАлкогольТоваровУПД();
	Исключение
		ДобавитьСтрокуЖурнала("<Алкоголь ЕГАИС>", "", "Ошибка", ТекущаяДатаСеанса(),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "");
		ПрименитьВизуализациюСтатусов();
		Возврат;
	КонецПопытки;

	ДобавитьСтрокуЖурнала("<Алкоголь ЕГАИС>", "", "Проверен", ТекущаяДатаСеанса(),
		СтрШаблон(НСтр("ru = 'УПД: %1, строк: %2, алкоголь: %3, возможно алкоголь: %4, изменено строк: %5'"),
			Итог.Документов, Итог.Строк, Итог.Алкоголь, Итог.Возможно, Итог.Изменено),
		"ЭАрМ_ТоварыЭТрН.Алкоголь");

	ПрименитьВизуализациюСтатусов();

КонецПроцедуры

&НаСервере
Процедура ТестироватьЗаказПокупателяНаСервере()
	СообщитьОбОтключённомКонтуре("Тестовый сценарий заказа покупателя");
КонецПроцедуры

// Записывает статичный набор базовых настроек в регистр ЭАрМ_НастройкиЭДО:
// ключи СБИС, транспорт, папки обмена, параметры FTP. Отдельной формы
// настроек нет - значения заданы в ЭАрМ_НастройкиСервер.
//
&НаСервере
Процедура ЗаписатьБазовыеНастройкиНаСервере()

	ЖурналОтправок.Очистить();

	Попытка
		ЭАрМ_НастройкиСервер.ИнициализироватьНастройкиСБИС();
	Исключение
		ДобавитьСтрокуЖурнала("<Настройки ЭДО>", "", "Ошибка", ТекущаяДатаСеанса(), "",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ПрименитьВизуализациюСтатусов();
		Возврат;
	КонецПопытки;

	Проверка = ЭАрМ_НастройкиСервер.ПроверитьЗаполнениеНастроекСБИС();

	ДобавитьСтрокуЖурнала("<Настройки ЭДО>", "",
		?(Проверка.Успех, "Проверен", "Ошибка"), ТекущаяДатаСеанса(), "",
		?(Проверка.Успех,
			НСтр("ru = 'Базовые настройки записаны, ключи СБИС заполнены'"),
			Проверка.Ошибка));

	ПрименитьВизуализациюСтатусов();

КонецПроцедуры

// Тестовый контур отключён: документы берутся только из СБИС.
//
&НаСервере
Процедура СообщитьОбОтключённомКонтуре(ИмяСценария)

	ЖурналОтправок.Очистить();
	ДобавитьСтрокуЖурнала(ИмяСценария, "", "Отключено", ТекущаяДатаСеанса(), "",
		НСтр("ru = 'Тестовый контур отключён. Документы получаются только из СБИС —
			|кнопка «Получить ЭДО из СБИС».'"));
	ПрименитьВизуализациюСтатусов();

КонецПроцедуры

&НаСервере
Процедура ОтправитьОжидаемыеВПапкуНаСервере()
	ЖурналОтправок.Очистить();
	Результат = ЭАрМ_ПанельУправленияЭДОСервер.ОтправитьОжидаемыеВПапку();
	Для Каждого СтрокаЖурнала Из Результат.ЖурналОтправок Цикл
		НоваяСтрока = ЖурналОтправок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЖурнала);
	КонецЦикла;
	ПрименитьВизуализациюСтатусов();
КонецПроцедуры

// Кнопка "Получить": читаем папку обмена и дальше по логике.
//
// ЭАрМ_ОбработкаПодтвержденийЭДО.ЭАрМ_Вызов - та же точка входа, что у
// регламентного задания ЭАрМ_ПроверкаПапкиОбмена: разбирает response_*.json
// из папки обмена, применяет подтверждения базы 2, переотправляет
// неудачные отправки и обрабатывает входящие ЭТрН из регистра.
//
&НаСервере
Процедура ЧитатьПапкуОбменаНаСервере()

	ЖурналОтправок.Очистить();

	ПапкаОбмена = ЭАрМ_НастройкиСервер.ПолучитьНастройку("ПапкаОбмена");

	Если НЕ ЗначениеЗаполнено(ПапкаОбмена) Тогда
		ДобавитьСтрокуЖурнала("<Папка обмена>", "", "Ошибка", ТекущаяДатаСеанса(), "",
			НСтр("ru = 'Папка обмена не задана. Нажмите «Все настройки»'"));
		ПрименитьВизуализациюСтатусов();
		Возврат;
	КонецЕсли;

	БылоФайлов = ОтветныхФайловВПапке(ПапкаОбмена);

	Попытка
		ЭАрМ_ОбработкаПодтвержденийЭДО.ЭАрМ_Вызов();
	Исключение
		ДобавитьСтрокуЖурнала("<Папка обмена>", "", "Ошибка", ТекущаяДатаСеанса(),
			ПапкаОбмена, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ПрименитьВизуализациюСтатусов();
		Возврат;
	КонецПопытки;

	СталоФайлов = ОтветныхФайловВПапке(ПапкаОбмена);

	ДобавитьСтрокуЖурнала("<Папка обмена>", "", "Проверен", ТекущаяДатаСеанса(),
		ПапкаОбмена,
		СтрШаблон(НСтр("ru = 'Найдено ответов: %1, разобрано: %2'"),
			БылоФайлов, Макс(БылоФайлов - СталоФайлов, 0)));

	ЗагрузитьЖурналИзРегистраВДополнение();

	ПрименитьВизуализациюСтатусов();

КонецПроцедуры

// Считает необработанные ответы базы 2, лежащие в папке обмена.
//
&НаСервере
Функция ОтветныхФайловВПапке(ПапкаОбмена)

	Каталог = Новый Файл(ПапкаОбмена);
	Если НЕ Каталог.Существует() Тогда
		Возврат 0;
	КонецЕсли;

	Возврат НайтиФайлы(ПапкаОбмена, "response_*.json").Количество();

КонецФункции

// Дописывает в журнал текущее состояние ожидаемых подтверждений,
// не затирая строки, добавленные вызывающим кодом.
//
&НаСервере
Процедура ЗагрузитьЖурналИзРегистраВДополнение()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	Т.ЭлектронныйДокумент КАК Документ,
	|	Т.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
	|	Т.Статус КАК Статус,
	|	Т.ДатаОтправки КАК ДатаОтправки,
	|	Т.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.ДатаОтправки УБЫВ";

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		ДобавитьСтрокуЖурнала(Строка(Выборка.Документ), Выборка.ИдентификаторЗапроса,
			Строка(Выборка.Статус), Выборка.ДатаОтправки, Выборка.Комментарий, "");
	КонецЦикла;

КонецПроцедуры

// Раньше подкладывала ответ "от базы 2" вместо настоящего. Теперь забирает
// то, что база 2 действительно прислала.
//
&НаСервере
Процедура СоздатьТестовыйОтветНаСервере()

	ЖурналОтправок.Очистить();

	Попытка
		Разобрано = ЭАрМ_РегламентныйОбменЭДО.ЗабратьОтветыДалион();
	Исключение
		ДобавитьСтрокуЖурнала("<Ответы базы 2>", "", "Ошибка", ТекущаяДатаСеанса(), "",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ПрименитьВизуализациюСтатусов();
		Возврат;
	КонецПопытки;

	ДобавитьСтрокуЖурнала("<Ответы базы 2>", "", "Проверен", ТекущаяДатаСеанса(), "",
		СтрШаблон(НСтр("ru = 'Ответов разобрано: %1'"), Разобрано));

	ПрименитьВизуализациюСтатусов();

КонецПроцедуры

// Перечитывает журнал, если состояние регистра изменилось с прошлого раза.
//
// Параметры:
//   ПредыдущаяМетка - Строка - слепок, полученный в прошлый раз
//
// Возвращаемое значение:
//   Строка - текущий слепок
//
&НаСервере
Функция ОбновитьЖурналЕслиИзменилсяНаСервере(Знач ПредыдущаяМетка)

	Метка = МеткаЖурнала();

	Если Метка <> ПредыдущаяМетка Тогда
		ЗагрузитьЖурналИзРегистра();
		ПоказатьВремяОбновления();
	КонецЕсли;

	Возврат Метка;

КонецФункции

// Безусловное чтение журнала - для кнопки.
//
&НаСервере
Функция ПеречитатьЖурналНаСервере()

	ЗагрузитьЖурналИзРегистра();
	ПоказатьВремяОбновления();

	Возврат МеткаЖурнала();

КонецФункции

&НаСервере
Функция МеткаЖурналаНаСервере()

	Возврат МеткаЖурнала();

КонецФункции

// Слепок состояния регистра ожидаемых подтверждений.
//
// Одного количества записей мало: статус меняется у уже существующей строки,
// и по количеству этого не видно. Поэтому считаем количество и последнюю дату
// в разрезе статусов - изменение любого из трёх меняет строку слепка.
//
// Возвращаемое значение:
//   Строка
//
&НаСервере
Функция МеткаЖурнала()

	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Статус КАК Статус,
		|	КОЛИЧЕСТВО(*) КАК Всего,
		|	МАКСИМУМ(Т.ДатаОтправки) КАК Последняя
		|ИЗ
		|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т.Статус
		|УПОРЯДОЧИТЬ ПО
		|	Статус";

		Части = Новый Массив;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Части.Добавить(СтрШаблон("%1:%2:%3",
				Строка(Выборка.Статус), Выборка.Всего,
				Формат(Выборка.Последняя, "ДФ=yyyyMMddHHmmss")));
		КонецЦикла;

		Возврат СтрСоединить(Части, ";");

	Исключение
		// Слепок не должен мешать работе формы. Возвращаем постоянную
		// заглушку, а не пустую строку: пустая отличалась бы от предыдущего
		// слепка и заставляла перечитывать журнал на каждом такте.
		Возврат "?";
	КонецПопытки;

КонецФункции

&НаСервере
Процедура ПоказатьВремяОбновления()

	Заголовок = СтрШаблон(
		НСтр("ru = 'Панель управления ЭДО (журнал обновлён %1)'"),
		Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss"));

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЖурналИзРегистра()

	ЖурналОтправок.Очистить();
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.ЭлектронныйДокумент КАК Документ,
		|	Т.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
		|	Т.Статус КАК Статус,
		|	Т.ДатаОтправки КАК ДатаОтправки,
		|	Т.Комментарий КАК Комментарий
		|ИЗ
		|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаОтправки УБЫВ";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ЖурналОтправок.Добавить();
			НоваяСтрока.Документ = Строка(Выборка.Документ);
			НоваяСтрока.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
			НоваяСтрока.Статус = Строка(Выборка.Статус);
			НоваяСтрока.ДатаОтправки = Выборка.ДатаОтправки;
			НоваяСтрока.Комментарий = Выборка.Комментарий;
		КонецЦикла;
	Исключение
	КонецПопытки;
	ПрименитьВизуализациюСтатусов();

КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуЖурнала(Документ, ИдентификаторЗапроса, Статус, Дата, Комментарий, Результат)
	НоваяСтрока = ЖурналОтправок.Добавить();
	НоваяСтрока.Документ = Документ;
	НоваяСтрока.ИдентификаторЗапроса = ИдентификаторЗапроса;
	НоваяСтрока.Статус = Статус;
	НоваяСтрока.ДатаОтправки = Дата;
	НоваяСтрока.Комментарий = Комментарий;
	НоваяСтрока.Результат = Результат;
КонецПроцедуры

&НаСервере
Процедура ПрименитьВизуализациюСтатусов()
	Для Каждого СтрокаЖурнала Из ЖурналОтправок Цикл
		Статус = НРег(СокрЛП(СтрокаЖурнала.Статус));
		Если Статус = "ожидает" Тогда
			СтрокаЖурнала.Статус = "⏳ Ожидает";
		ИначеЕсли Статус = "подтверждено" Тогда
			СтрокаЖурнала.Статус = "✅ Подтверждено";
		ИначеЕсли Статус = "отклонено" Тогда
			СтрокаЖурнала.Статус = "❌ Отклонено";
		ИначеЕсли Статус = "создан" Тогда
			СтрокаЖурнала.Статус = "🆕 Создан";
		ИначеЕсли Статус = "ошибка" Тогда
			СтрокаЖурнала.Статус = "⚠️ Ошибка";
		ИначеЕсли Статус = "проверен" Тогда
			СтрокаЖурнала.Статус = "🔍 Проверен";
		ИначеЕсли Статус = "отправленвпапку" Тогда
			СтрокаЖурнала.Статус = "📁 Отправлен в папку";
		ИначеЕсли Статус = "регламентновыполнено" Тогда
			СтрокаЖурнала.Статус = "⏰ Регл. задание OK";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ИмитироватьСобытиеСтатусаНаСервере()
	СообщитьОбОтключённомКонтуре("Имитация события изменения статуса");
КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайлНаСервере(Знач ПутьКФайлу)
	ЖурналОтправок.Очистить();
	Результат = ЭАрМ_ПанельУправленияЭДОСервер.ПрочитатьФайлВТаблицуЗначений(ПутьКФайлу);
	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		НоваяСтрока = ЖурналОтправок.Добавить();
		НоваяСтрока.Документ = "Ошибка";
		НоваяСтрока.Комментарий = Результат.Ошибка;
		НоваяСтрока.Результат = Результат.Ошибка;
		Возврат;
	КонецЕсли;
	// Отображаем данные из таблицы в журнале
	Для Каждого СтрокаТЗ Из Результат.Таблица Цикл
		НоваяСтрока = ЖурналОтправок.Добавить();
		НоваяСтрока.Документ = СтрокаТЗ.Представление;
		НоваяСтрока.ИдентификаторЗапроса = ?(СтрокаТЗ.Колонки.Найти("ИдентификаторЗапроса") <> Неопределено, СтрокаТЗ.ИдентификаторЗапроса, "");
		НоваяСтрока.Статус = "Прочитано";
		НоваяСтрока.Комментарий = СтрШаблон("Строк: %1", Результат.КоличествоСтрок);
		НоваяСтрока.Результат = "Файл прочитан успешно";
	КонецЦикла;
	ПрименитьВизуализациюСтатусов();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораФайла()
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "JSON файлы (*.json)|*.json";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Заголовок = "Выберите JSON-файл для чтения";

	Если Диалог.Выбрать() Тогда
		ПрочитатьФайлНаСервере(Диалог.ПолноеИмяФайла);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
