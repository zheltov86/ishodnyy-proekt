////////////////////////////////////////////////////////////////////////////////
// Настройки очереди отправки в СБИС (функциональная опция ЭАрМ_ОчередьОтправкиСБИС).
//
// Флажок «Очередь отправки в СБИС» - это функциональная опция: константа
// ЭАрМ_ИспользоватьОчередьОтправкиСБИС, синхронная с настройкой «Автоотправка»
// (её же ставят флажки форм очереди и реестра УПД). Включена - регламентное
// задание ЭАрМ_ОтправкаОчередиСБИС каждые N минут сверяет цепочки, ставит
// сошедшиеся УПД и УКД в очередь и отправляет их в СБИС с подписью на сервере,
// без открытых форм. Выключена - задание выключено, кнопки серверной отправки
// в форме очереди скрыты.
//
// «Где подписывать»: Клиент - подписывает открытая форма очереди или реестра УПД
// ключом своего компьютера, задание только сверяет и ставит в очередь; Сервер -
// подписывает задание ключом на сервере 1С, формы не подписывают.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПрочитатьНастройки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ВключенаПриИзменении(Элемент)

	УстановитьДоступность();

КонецПроцедуры

&НаКлиенте
Процедура МестоПодписиПриИзменении(Элемент)

	УстановитьДоступность();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	Если ЗаписатьНастройки() Тогда
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	Если ЗаписатьНастройки() Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Очередь отправки в СБИС'"), ,
			НСтр("ru = 'Настройки записаны'"));
	КонецЕсли;

КонецПроцедуры

// Пароль контейнера ключа подписанта отправки - для подписи на сервере.
// Пустая строка удаляет сохранённый пароль.
//
&НаКлиенте
Процедура ПарольКлючаНаСервере(Команда)

	Если НЕ ЗначениеЗаполнено(Подписант) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала выберите подписанта отправки.'"));
		Возврат;
	КонецЕсли;

	ПоказатьВводСтроки(Новый ОписаниеОповещения("ПарольКлючаВведён", ЭтотОбъект), "",
		СтрШаблон(НСтр("ru = 'Пароль ключа подписанта %1 на сервере (пусто - удалить)'"), Подписант),
		, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПарольКлючаВведён(Пароль, ДополнительныеПараметры) Экспорт

	Если Пароль = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЭАрМ_ПанельУправленияЭДОСервер.ЗаписатьПарольКлючаНаСервере(Подписант, Пароль);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ОбновитьСостояние();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Пароль ключа'"), ,
		?(ПустаяСтрока(Пароль), НСтр("ru = 'Пароль удалён'"), НСтр("ru = 'Пароль сохранён на сервере'")));

КонецПроцедуры

// Записывает настройки (криптопровайдер мог поменяться) и показывает, может
// ли сервер 1С подписывать.
//
&НаКлиенте
Процедура ПроверитьПодписьНаСервере(Команда)

	Если НЕ ЗаписатьНастройки() Тогда
		Возврат;
	КонецЕсли;

	ПоказатьПредупреждение(, Элементы.СостояниеНадпись.Заголовок);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитатьНастройки()

	Настройки = ЭАрМ_ПанельУправленияЭДОСервер.НастройкиОчередиОтправки();

	Включена  = Настройки.Включена;
	Подписант = Настройки.Подписант;
	Интервал  = Настройки.Интервал;
	Модуль    = Настройки.Модуль;
	Путь      = Настройки.Путь;
	ТипПровайдера = Настройки.Тип;
	МестоПодписи = Настройки.Место;

	СписокМест = Элементы.МестоПодписи.СписокВыбора;
	СписокМест.Очистить();
	СписокМест.Добавить("Клиент", НСтр("ru = 'На клиенте (открытая форма, ключ компьютера пользователя)'"));
	СписокМест.Добавить("Сервер", НСтр("ru = 'На сервере 1С (регламент, без открытых форм)'"));

	СписокПодписантов = Элементы.Подписант.СписокВыбора;
	СписокПодписантов.Очистить();
	Для Каждого ОписаниеПодписанта Из Настройки.Подписанты Цикл
		СписокПодписантов.Добавить(ОписаниеПодписанта.Номер, ОписаниеПодписанта.Представление);
	КонецЦикла;

	СписокИнтервалов = Элементы.Интервал.СписокВыбора;
	СписокИнтервалов.Очистить();
	Для Каждого Минуты Из СтрРазделить("1,2,3,5,10,15,30,60", ",") Цикл
		СписокИнтервалов.Добавить(Число(Минуты), Минуты + " " + НСтр("ru = 'мин'"));
	КонецЦикла;
	Если СписокИнтервалов.НайтиПоЗначению(Интервал) = Неопределено Тогда
		СписокИнтервалов.Добавить(Интервал, Формат(Интервал, "ЧГ=0") + " " + НСтр("ru = 'мин'"));
	КонецЕсли;

	Элементы.СерверНадпись.Заголовок = СтрШаблон(
		НСтр("ru = 'Подписывает сервер 1С: компьютер %1, пользователь службы 1С. На нём нужен КриптоПро CSP с серверной лицензией, контейнер ключа и сертификат подписанта в «Личные».'"),
		Настройки.ИмяСервера);

	ПоказатьСостояние(Настройки);

	// Доступность - здесь, а не через УстановитьДоступность: та клиентская
	Элементы.ГруппаОтправка.Доступность = Включена;
	Элементы.ГруппаКриптопровайдер.Доступность = Включена И МестоПодписи = "Сервер";
	Элементы.ГруппаКнопки.Доступность = МестоПодписи = "Сервер";

КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояние()

	ПоказатьСостояние(ЭАрМ_ПанельУправленияЭДОСервер.СостояниеОтправкиОчереди());

КонецПроцедуры

&НаСервере
Процедура ПоказатьСостояние(Настройки)

	Элементы.СостояниеНадпись.Заголовок = Настройки.Пояснение;
	Элементы.СостояниеНадпись.ЦветТекста = ?(Настройки.Норма, WebЦвета.Зеленый, WebЦвета.Красный);

КонецПроцедуры

// Флажок и «Где подписывать» на клиенте; при чтении настроек на сервере то же
// делает ПрочитатьНастройки сама.
//
&НаКлиенте
Процедура УстановитьДоступность()

	Элементы.ГруппаОтправка.Доступность = Включена;
	// Криптопровайдер, пароль и проверка нужны только при подписи на сервере
	Элементы.ГруппаКриптопровайдер.Доступность = Включена И МестоПодписи = "Сервер";
	Элементы.ГруппаКнопки.Доступность = МестоПодписи = "Сервер";

КонецПроцедуры

// Возвращаемое значение:
//   Булево - записано
//
&НаКлиенте
Функция ЗаписатьНастройки()

	Если Включена И НЕ ЗначениеЗаполнено(Подписант) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите подписанта отправки: от его имени очередь уходит в СБИС.'"));
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ЗаписатьНастройкиНаСервере(ИмяКомпьютера());
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	// Функциональная опция поменялась - формы перечитывают видимость команд
	ОбновитьИнтерфейс();
	Оповестить("ЭАрМ_НастройкиОчередиОтправки");

	Возврат Истина;

КонецФункции

&НаСервере
Процедура ЗаписатьНастройкиНаСервере(Компьютер)

	Настройки = Новый Структура("Включена, Подписант, Интервал, Модуль, Путь, Тип, Место, Компьютер",
		Включена, Подписант, ?(ЗначениеЗаполнено(Интервал), Интервал, 5), Модуль, Путь, ТипПровайдера,
		?(ЗначениеЗаполнено(МестоПодписи), МестоПодписи, "Клиент"), Компьютер);
	ЭАрМ_ПанельУправленияЭДОСервер.ЗаписатьНастройкиОчередиОтправки(Настройки);

	ОбновитьПовторноИспользуемыеЗначения();
	ПрочитатьНастройки();

КонецПроцедуры

#КонецОбласти
