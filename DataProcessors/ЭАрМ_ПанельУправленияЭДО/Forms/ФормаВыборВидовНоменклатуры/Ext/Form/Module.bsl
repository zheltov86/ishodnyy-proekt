////////////////////////////////////////////////////////////////////////////////
// Выбор видов номенклатуры для товаров, по которым создаётся номенклатура УТ.
//
// Параметры формы: Товары - Массив из Структура (Наименование, Штрихкод, Категория).
// Результат закрытия: Массив из Структура (Штрихкод, ВидУИД) в порядке списка;
// Неопределено, если окно закрыли без создания.
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Для Каждого Товар Из Параметры.Товары Цикл
		Строка = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Товар);
		Если ЗначениеЗаполнено(Строка.ВидУИД) Тогда
			Строка.Вид = ПредставлениеВидаПоУИД(Строка.ВидУИД);
			Если НЕ ЗначениеЗаполнено(Строка.Вид) Тогда
				Строка.ВидУИД = "";
			КонецЕсли;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Строка.ВидУИД) Тогда
			Вид = ЭАрМ_КатегорииТоваров.ВидКатегорииПоУмолчанию(Строка.Категория);
			Строка.Вид    = Вид.Представление;
			Строка.ВидУИД = Вид.УИД;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Представление вида номенклатуры по УИД; пусто, если УИД не разрешился или это группа.
&НаСервереБезКонтекста
Функция ПредставлениеВидаПоУИД(УИД)

	Попытка
		Ссылка = Справочники.ВидыНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
	Исключение
		Возврат "";
	КонецПопытки;
	Описание = ЭАрМ_КатегорииТоваров.ОписаниеСсылки(Ссылка);
	Если Описание = Неопределено ИЛИ Описание.ЭтоГруппа Тогда
		Возврат "";
	КонецЕсли;
	Возврат Описание.Представление;

КонецФункции

&НаКлиенте
Процедура Создать(Команда)

	Результат = Новый Массив;
	Для Каждого Строка Из Товары Цикл
		Если НЕ ЗначениеЗаполнено(Строка.ВидУИД) Тогда
			ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Не выбран вид номенклатуры для товара «%1»'"), Строка.Наименование));
			Возврат;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Штрихкод, ВидУИД", Строка.Штрихкод, Строка.ВидУИД));
	КонецЦикла;

	Закрыть(Результат);

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьКоВсем(Команда)

	ВыбратьВид(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыВидНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьВид(Элементы.Товары.ТекущаяСтрока);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыВидОчистка(Элемент, СтандартнаяОбработка)

	Строка = Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	Если Строка <> Неопределено Тогда
		Строка.Вид    = "";
		Строка.ВидУИД = "";
	КонецЕсли;

КонецПроцедуры

// Открывает выбор вида; ИдентификаторСтроки - Неопределено: вид получат все товары.
//
&НаКлиенте
Процедура ВыбратьВид(ИдентификаторСтроки)

	ПараметрыВыбора = Новый Структура("РежимВыбора, ЗакрыватьПриВыборе", Истина, Истина);
	ОткрытьФорму("Справочник.ВидыНоменклатуры.ФормаВыбора", ПараметрыВыбора, ЭтаФорма, , , ,
		Новый ОписаниеОповещения("ВыбратьВидЗавершение", ЭтотОбъект, ИдентификаторСтроки),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВидЗавершение(ВыбранноеЗначение, ИдентификаторСтроки) Экспорт

	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;

	Описание = ОписаниеВидаНаСервере(ВыбранноеЗначение);
	Если Описание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Описание.ЭтоГруппа Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите вид номенклатуры, а не группу видов'"));
		Возврат;
	КонецЕсли;

	Если ИдентификаторСтроки = Неопределено Тогда
		Для Каждого Строка Из Товары Цикл
			Строка.Вид    = Описание.Представление;
			Строка.ВидУИД = Описание.УИД;
		КонецЦикла;
	Иначе
		Строка = Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если Строка <> Неопределено Тогда
			Строка.Вид    = Описание.Представление;
			Строка.ВидУИД = Описание.УИД;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОписаниеВидаНаСервере(Ссылка)

	Возврат ЭАрМ_КатегорииТоваров.ОписаниеСсылки(Ссылка);

КонецФункции
