&НаКлиенте
Процедура ВыбратьСсылку(ИмяФормы, ИмяТаблицы, ИдентификаторСтроки, ИмяПоля)

	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Контекст = Новый Структура("ИмяТаблицы, ИдентификаторСтроки, ИмяПоля",
		ИмяТаблицы, ИдентификаторСтроки, ИмяПоля);
	ОткрытьФорму(ИмяФормы, Новый Структура("РежимВыбора, ЗакрыватьПриВыборе", Истина, Истина), ЭтаФорма, , , ,
		Новый ОписаниеОповещения("ВыбратьСсылкуЗавершение", ЭтотОбъект, Контекст),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСсылкуЗавершение(ВыбранноеЗначение, Контекст) Экспорт

	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	Описание = ОписаниеСсылкиНаСервере(ВыбранноеЗначение);
	Если Описание = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НужнаГруппа = СтрНайти(Контекст.ИмяПоля, "Группа") > 0;
	Если НужнаГруппа И НЕ Описание.ЭтоГруппа Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите группу номенклатуры, а не элемент'"));
		Возврат;
	ИначеЕсли НЕ НужнаГруппа И Описание.ЭтоГруппа Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите вид номенклатуры, а не группу видов'"));
		Возврат;
	КонецЕсли;

	СтрокаДанных = ЭтаФорма[Контекст.ИмяТаблицы].НайтиПоИдентификатору(Контекст.ИдентификаторСтроки);
	Если СтрокаДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Контекст.ИмяТаблицы = "НоменклатураКатегорий" И НЕ ЗначениеЗаполнено(СтрокаДанных.НоменклатураУИД) Тогда
		// Строка категории: новое значение - всей её номенклатуре
		Для Каждого СтрокаНоменклатуры Из СтрокаДанных.ПолучитьЭлементы() Цикл
			Если ЗначениеЗаполнено(СтрокаНоменклатуры.НоменклатураУИД) Тогда
				УстановитьЗначениеПоля(СтрокаНоменклатуры, Контекст.ИмяПоля, Описание, Истина);
			КонецЕсли;
		КонецЦикла;
		СтрокаДанных.Пометка = Истина;
		Возврат;
	КонецЕсли;

	УстановитьЗначениеПоля(СтрокаДанных, Контекст.ИмяПоля, Описание,
		Контекст.ИмяТаблицы = "НоменклатураКатегорий");

КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеПоля(СтрокаДанных, ИмяПоля, Описание, Отметить)

	СтрокаДанных[ИмяПоля] = Описание.Представление;
	СтрокаДанных[ИмяПоля + "УИД"] = Описание.УИД;
	Если Отметить Тогда
		СтрокаДанных.Пометка = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоле(ИмяТаблицы, ИдентификаторСтроки, ИмяПоля)

	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаДанных = ЭтаФорма[ИмяТаблицы].НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаДанных <> Неопределено Тогда
		СтрокаДанных[ИмяПоля] = "";
		СтрокаДанных[ИмяПоля + "УИД"] = "";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоНоменклатуры()

	Для Каждого СтрокаКатегории Из НоменклатураКатегорий.ПолучитьЭлементы() Цикл
		Если СтрокаКатегории.Пометка Тогда
			Элементы.НоменклатураКатегорий.Развернуть(СтрокаКатегории.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОписаниеСсылкиНаСервере(Ссылка)

	Возврат ЭАрМ_КатегорииТоваров.ОписаниеСсылки(Ссылка);

КонецФункции

// Заполняет таблицу категорий и дерево номенклатуры из реестра товаров.
//
// Параметры:
//   СохранитьКатегории - Булево - сначала сохранить выбранные виды и группы категорий
//
&НаСервере
Процедура ЗаполнитьВидыНоменклатурыНаСервере(СохранитьКатегории)

	Попытка
		Если СохранитьКатегории Тогда
			СохранитьВидыКатегорийНаСервере();
		КонецЕсли;
		Данные = ЭАрМ_КатегорииТоваров.ДанныеВидовНоменклатуры(ТолькоСверенные);
	Исключение
		Результат = СтрШаблон(НСтр("ru = 'Ошибка заполнения видов номенклатуры: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	КатегорииТоваров.Загрузить(Данные.Категории);

	Дерево = РеквизитФормыВЗначение("НоменклатураКатегорий");
	Дерево.Строки.Очистить();
	Для Каждого Категория Из Данные.Категории Цикл
		Строки = Данные.Номенклатура.НайтиСтроки(Новый Структура("Категория", Категория.Категория));
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		УзелКатегории = Дерево.Строки.Добавить();
		УзелКатегории.Категория    = Категория.Категория;
		УзелКатегории.Наименование = СтрШаблон("%1 (строк реестра: %2, номенклатур УТ: %3)",
			Категория.Представление, Категория.Строк, Категория.Номенклатур);
		УзелКатегории.ВидНовый     = Категория.ВидНоменклатуры;
		УзелКатегории.ГруппаНовая  = Категория.Группа;
		Для Каждого СтрокаНоменклатуры Из Строки Цикл
			Узел = УзелКатегории.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(Узел, СтрокаНоменклатуры);
			УзелКатегории.Пометка = УзелКатегории.Пометка ИЛИ Узел.Пометка;
		КонецЦикла;
	КонецЦикла;
	ЗначениеВРеквизитФормы(Дерево, "НоменклатураКатегорий");

	КОтметке = Данные.Номенклатура.НайтиСтроки(Новый Структура("Пометка", Истина)).Количество();
	НетВУТ = Данные.Номенклатура.НайтиСтроки(Новый Структура("НоменклатураУИД", "")).Количество();
	Результат = СтрШаблон(НСтр("ru = 'Товаров реестра: %1, нет в УТ по штрихкоду: %2, предложено сменить вид или группу: %3'"),
		Данные.Номенклатура.Количество(), НетВУТ, КОтметке);
	Результат = Результат + Символы.ПС + ЭАрМ_КатегорииТоваров.СостояниеСервисаНоменклатуры().Текст;

КонецПроцедуры

&НаСервере
Процедура СохранитьВидыКатегорийНаСервере()

	Строки = Новый Массив;
	Для Каждого СтрокаКатегории Из КатегорииТоваров Цикл
		Строки.Добавить(Новый Структура("Категория, ВидНоменклатурыУИД, ГруппаУИД",
			СтрокаКатегории.Категория, СтрокаКатегории.ВидНоменклатурыУИД, СтрокаКатегории.ГруппаУИД));
	КонецЦикла;
	Если Строки.Количество() > 0 Тогда
		ЭАрМ_КатегорииТоваров.СохранитьВидыКатегорий(Строки);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПересчитатьКатегорииНаСервере()

	Попытка
		Итог = ЭАрМ_КатегорииТоваров.ПересчитатьКатегорииРеестра();
	Исключение
		Результат = СтрШаблон(НСтр("ru = 'Ошибка пересчёта категорий: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Части = Новый Массив;
	Для Каждого Описание Из ЭАрМ_КатегорииТоваров.Категории() Цикл
		Количество = Итог.ПоКатегориям.Получить(Описание.Код);
		Если Количество <> Неопределено Тогда
			Части.Добавить(Описание.Представление + ": " + Количество);
		КонецЕсли;
	КонецЦикла;

	ЗаполнитьВидыНоменклатурыНаСервере(Ложь);
	Результат = СтрШаблон(НСтр("ru = 'Цепочек: %1, строк: %2, изменено: %3
		|%4'"), Итог.Цепочек, Итог.Строк, Итог.Изменено, СтрСоединить(Части, ", "));

КонецПроцедуры

&НаСервере
Процедура ПрименитьВидыИГруппыНаСервере()

	Строки = Новый Массив;
	Для Каждого СтрокаКатегории Из НоменклатураКатегорий.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаНоменклатуры Из СтрокаКатегории.ПолучитьЭлементы() Цикл
			Если СтрокаНоменклатуры.Пометка И ЗначениеЗаполнено(СтрокаНоменклатуры.НоменклатураУИД)
				И (ЗначениеЗаполнено(СтрокаНоменклатуры.ВидНовыйУИД)
					ИЛИ ЗначениеЗаполнено(СтрокаНоменклатуры.ГруппаНоваяУИД)) Тогда
				Строки.Добавить(Новый Структура("НоменклатураУИД, ВидНовыйУИД, ГруппаНоваяУИД",
					СтрокаНоменклатуры.НоменклатураУИД, СтрокаНоменклатуры.ВидНовыйУИД,
					СтрокаНоменклатуры.ГруппаНоваяУИД));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		Результат = НСтр("ru = 'Нет отмеченной номенклатуры с новым видом или группой'");
		Возврат;
	КонецЕсли;

	Попытка
		Итог = ЭАрМ_КатегорииТоваров.ПрименитьВидыИГруппы(Строки);
	Исключение
		Результат = СтрШаблон(НСтр("ru = 'Ошибка записи номенклатуры: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ЗаполнитьВидыНоменклатурыНаСервере(Ложь);

	Тексты = Новый Массив;
	Тексты.Добавить(СтрШаблон(НСтр("ru = 'Отмечено: %1, записано: %2, ошибок: %3'"),
		Строки.Количество(), Итог.Изменено, Итог.Ошибок));
	Для Каждого Сообщение Из Итог.Сообщения Цикл
		Тексты.Добавить("• " + Сообщение);
	КонецЦикла;
	Результат = СтрСоединить(Тексты, Символы.ПС);

КонецПроцедуры

#КонецОбласти

#Область СервисНоменклатуры

&НаКлиенте
Процедура ОтметитьОтсутствующие(Команда)

	Для Каждого СтрокаКатегории Из НоменклатураКатегорий.ПолучитьЭлементы() Цикл
		ЕстьОтмеченные = Ложь;
		Для Каждого СтрокаНоменклатуры Из СтрокаКатегории.ПолучитьЭлементы() Цикл
			СтрокаНоменклатуры.Пометка = НЕ ЗначениеЗаполнено(СтрокаНоменклатуры.НоменклатураУИД)
				И ЗначениеЗаполнено(СтрокаНоменклатуры.Штрихкод);
			ЕстьОтмеченные = ЕстьОтмеченные ИЛИ СтрокаНоменклатуры.Пометка;
		КонецЦикла;
		СтрокаКатегории.Пометка = ЕстьОтмеченные;
	КонецЦикла;
	РазвернутьДеревоНоменклатуры();

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзСервиса(Команда)

	Состояние(НСтр("ru = '1С:Номенклатура: поиск по штрихкодам...'"));
	СоздатьНедостающуюНаСервере(Ложь);
	Состояние();
	РазвернутьДеревоНоменклатуры();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНедостающую(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("СоздатьНедостающуюЗавершение", ЭтотОбъект),
		НСтр("ru = 'Создать номенклатуру УТ для отмеченных товаров, которых нет в УТ?
		|
		|Сначала штрихкод ищется в 1С:Номенклатура (если сервис подключён), не найденное
		|создаётся по виду номенклатуры и группе категории (таблица выше) с наименованием
		|из реестра и штрихкодом. Перед созданием откроется окно выбора видов номенклатуры
		|для каждого товара. Карточка пишется только если заполнены обязательные реквизиты.'"),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНедостающуюЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	// Перед переносом - окно с видами номенклатуры для каждого переносимого товара
	Товары = ТоварыКСозданию();
	Если Товары.Количество() = 0 Тогда
		СоздатьНедостающуюНаСервере(Истина);
		РазвернутьДеревоНоменклатуры();
		ПоказатьИтогСоздания();
		Возврат;
	КонецЕсли;

	ОткрытьФорму("Обработка.ЭАрМ_ПанельУправленияЭДО.Форма.ФормаВыборВидовНоменклатуры",
		Новый Структура("Товары", Товары), ЭтаФорма, , , ,
		Новый ОписаниеОповещения("СоздатьНедостающуюВидыВыбраны", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНедостающуюВидыВыбраны(ВидыТоваров, ДополнительныеПараметры) Экспорт

	// Окно закрыли без «Создать номенклатуру»
	Если ВидыТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Создание номенклатуры...'"));
	СоздатьНедостающуюНаСервере(Истина, ВидыТоваров);
	Состояние();
	РазвернутьДеревоНоменклатуры();
	ПоказатьИтогСоздания();

КонецПроцедуры

