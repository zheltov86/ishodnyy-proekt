// Упаковки у номенклатуры УТ из дерева: отмеченной, а если отметок нет - у всей
// с карточкой и штрихкодом.
//
&НаСервере
Процедура ОбновитьУпаковкиНаСервере(ТолькоПроверка)

	Кандидаты = Новый Массив;
	ЕстьОтмеченные = Ложь;
	Для Каждого СтрокаКатегории Из НоменклатураКатегорий.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаНоменклатуры Из СтрокаКатегории.ПолучитьЭлементы() Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаНоменклатуры.НоменклатураУИД)
				ИЛИ НЕ ЗначениеЗаполнено(СтрокаНоменклатуры.Штрихкод) Тогда
				Продолжить;
			КонецЕсли;
			ЕстьОтмеченные = ЕстьОтмеченные ИЛИ СтрокаНоменклатуры.Пометка;
			Кандидаты.Добавить(Новый Структура("НоменклатураУИД, Штрихкод, Наименование, Пометка",
				СтрокаНоменклатуры.НоменклатураУИД, СтрокаНоменклатуры.Штрихкод,
				СтрокаНоменклатуры.Наименование, СтрокаНоменклатуры.Пометка));
		КонецЦикла;
	КонецЦикла;

	Товары = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если НЕ ЕстьОтмеченные ИЛИ Кандидат.Пометка Тогда
			Товары.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;

	Если Товары.Количество() = 0 Тогда
		Результат = НСтр("ru = 'Нет номенклатуры УТ со штрихкодом в дереве - нажмите «Заполнить»'");
		Возврат;
	КонецЕсли;

	Попытка
		Итог = ЭАрМ_УпаковкиНоменклатуры.ОбновитьУпаковкиНоменклатуры(Товары, ТолькоПроверка);
	Исключение
		Результат = СтрШаблон(НСтр("ru = 'Ошибка: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Тексты = Новый Массив;
	Тексты.Добавить(СтрШаблон(НСтр("ru = '%1: проверено %2, упаковки в приходе нет %3, сходится %4, %5 %6, расхождений %7, пропущено %8, ошибок %9'"),
		?(ТолькоПроверка, НСтр("ru = 'Проверка упаковок'"), НСтр("ru = 'Обновление упаковок'")),
		Итог.Проверено, Итог.БезУпаковки, Итог.Совпало,
		?(ТолькоПроверка, НСтр("ru = 'нужно добавить'"), НСтр("ru = 'обновлено'")),
		?(ТолькоПроверка, Итог.ТребуетОбновления, Итог.Обновлено),
		Итог.Расхождений, Итог.Пропущено, Итог.Ошибок));
	Для Каждого Сообщение Из Итог.Сообщения Цикл
		Тексты.Добавить("• " + Сообщение);
	КонецЦикла;
	Результат = СтрСоединить(Тексты, Символы.ПС);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСервисНоменклатуры(Команда)

	ОткрытьФормуУТ("Обработка.РаботаСНоменклатурой.Форма");

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСопоставлениеСервиса(Команда)

	Ссылки = НоменклатураУТДляСопоставленияСервиса();
	Если Ссылки.Количество() = 0 Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'В дереве нет номенклатуры УТ для сопоставления.
			|Отметьте строки с карточкой УТ. Если отметок нет — возьмутся все строки, у которых карточка уже есть.
			|Пустую форму сопоставления открывать нельзя: после поиска соответствий УТ падает.'"));
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Номенклатура", Ссылки);
	ПараметрыФормы.Вставить("НоменклатураДляСопоставления", Ссылки);
	ПараметрыФормы.Вставить("СсылкиНаНоменклатуру", Ссылки);

	Попытка
		ОткрытьФорму("Обработка.РаботаСНоменклатурой.Форма.СопоставлениеНоменклатуры",
			ПараметрыФормы, ЭтаФорма, , , , ,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Исключение
		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru = 'Не удалось открыть сопоставление 1С:Номенклатура:
			|%1'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

// Карточки УТ из дерева категорий: отмеченные, а если отметок нет — все с УИД.
//
&НаСервере
Функция НоменклатураУТДляСопоставленияСервиса()

	УИДы = Новый Массив;
	ЕстьОтмеченные = Ложь;
	Для Каждого СтрокаКатегории Из НоменклатураКатегорий.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаНоменклатуры Из СтрокаКатегории.ПолучитьЭлементы() Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаНоменклатуры.НоменклатураУИД) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаНоменклатуры.Пометка Тогда
				ЕстьОтмеченные = Истина;
			КонецЕсли;
			УИДы.Добавить(Новый Структура("УИД, Пометка",
				СтрокаНоменклатуры.НоменклатураУИД, СтрокаНоменклатуры.Пометка));
		КонецЦикла;
	КонецЦикла;

	Кандидаты = Новый Массив;
	Для Каждого Описание Из УИДы Цикл
		Если ЕстьОтмеченные И НЕ Описание.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Кандидаты.Добавить(Справочники.Номенклатура.ПолучитьСсылку(
				Новый УникальныйИдентификатор(Описание.УИД)));
		Исключение
		КонецПопытки;
	КонецЦикла;

	Если Кандидаты.Количество() = 0 Тогда
		Возврат Кандидаты;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В (&Ссылки)
	|	И НЕ Номенклатура.ЭтоГруппа";
	Запрос.УстановитьПараметр("Ссылки", Кандидаты);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Отмеченные товары без номенклатуры УТ: что переносится (Наименование, Штрихкод, Категория).
//
&НаСервере
Функция ТоварыКСозданию()

	Товары = Новый Массив;
	Для Каждого СтрокаКатегории Из НоменклатураКатегорий.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаНоменклатуры Из СтрокаКатегории.ПолучитьЭлементы() Цикл
			Если СтрокаНоменклатуры.Пометка И НЕ ЗначениеЗаполнено(СтрокаНоменклатуры.НоменклатураУИД) Тогда
				Товары.Добавить(Новый Структура("Штрихкод, Категория, Наименование",
					СтрокаНоменклатуры.Штрихкод, СтрокаНоменклатуры.Категория, СтрокаНоменклатуры.Наименование));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Товары;

КонецФункции

// Отмеченные товары без номенклатуры УТ - в 1С:Номенклатура и, если нужно,
// создание по виду и группе категории.
//
// Параметры:
//   СоздаватьСамим - Булево
//   ВидыТоваров    - Массив из Структура (Штрихкод, ВидУИД) - виды, выбранные в окне
//                    переноса; Неопределено - вид берётся из настроек категории
//
&НаСервере
Процедура СоздатьНедостающуюНаСервере(СоздаватьСамим, ВидыТоваров = Неопределено)

	СохранитьВидыКатегорийНаСервере();

	Товары = ТоварыКСозданию();

	// Виды, выбранные человеком: по штрихкоду товара
	Если ТипЗнч(ВидыТоваров) = Тип("Массив") Тогда
		ВидыПоШтрихкоду = Новый Соответствие;
		Для Каждого ВидТовара Из ВидыТоваров Цикл
			ВидыПоШтрихкоду.Вставить(ВидТовара.Штрихкод, ВидТовара.ВидУИД);
		КонецЦикла;
		Для Каждого Товар Из Товары Цикл
			ВидУИД = ВидыПоШтрихкоду.Получить(Товар.Штрихкод);
			Если ВидУИД <> Неопределено Тогда
				Товар.Вставить("ВидУИД", ВидУИД);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Товары.Количество() = 0 Тогда
		Результат = НСтр("ru = 'Нет отмеченных товаров без номенклатуры УТ - «Отметить отсутствующие в УТ»'");
		Возврат;
	КонецЕсли;

	Попытка
		Итог = ЭАрМ_КатегорииТоваров.СоздатьНедостающуюНоменклатуру(Товары, Истина, СоздаватьСамим);
	Исключение
		Результат = СтрШаблон(НСтр("ru = 'Ошибка: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ЗаполнитьВидыНоменклатурыНаСервере(Ложь);

	Тексты = Новый Массив;
	Тексты.Добавить(СтрШаблон(НСтр("ru = 'Товаров: %1, отправлено в 1С:Номенклатура: %2, загружено из сервиса: %3, создано по категории: %4, не найдено: %5, ошибок: %6'"),
		Товары.Количество(), Итог.Отправлено, Итог.ИзСервиса, Итог.Создано, Итог.НеНайдено, Итог.Ошибок));
	Для Каждого Сообщение Из Итог.Сообщения Цикл
		Тексты.Добавить("• " + Сообщение);
	КонецЦикла;
	Результат = СтрСоединить(Тексты, Символы.ПС);

КонецПроцедуры

#КонецОбласти

#Область ЧестныйЗнак

&НаКлиенте
Процедура ПеренестиКодыМаркировки(Команда)

	Состояние(НСтр("ru = 'Перенос кодов маркировки в регистр...'"));
	ПеренестиКодыМаркировкиНаСервере();
	Состояние();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьGTIN(Команда)

	Состояние(НСтр("ru = 'Проверка GTIN и номенклатуры...'"));
	ПривязатьGTINНаСервере(Истина);
	Состояние();

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьGTIN(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("ЗаписатьGTINЗавершение", ЭтотОбъект),
		НСтр("ru = 'Записать GTIN из марок Честного знака в штрихкоды номенклатуры УТ?
		|
		|Номенклатура берётся по штрихкоду строки УПД; GTIN, занятый другой номенклатурой,
		|не перезаписывается. Сначала посмотрите «Проверить GTIN и номенклатуру».'"),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьGTINЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ПривязатьGTINНаСервере(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура НайтиКод(Команда)

	Если НЕ ЗначениеЗаполнено(КодДляПоиска) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите или отсканируйте код маркировки'"));
		Возврат;
	КонецЕсли;
	НайтиКодНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПеренестиКодыМаркировкиНаСервере()

	Попытка
		Итог = ЭАрМ_ЧестныйЗнак.ПеренестиВсеКоды();
		РезультатЧЗ = СтрШаблон(НСтр("ru = 'Документов: %1, кодов в регистре: %2, ошибок: %3.
			|Коды прихода Далиона попадают в регистр при пересверке цепочки (реестр товаров - «Обновить реестр»).'"),
			Итог.Документов, Итог.Кодов, Итог.Ошибок);
	Исключение
		РезультатЧЗ = СтрШаблон(НСтр("ru = 'Ошибка переноса кодов: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ПривязатьGTINНаСервере(ТолькоПроверка)

	Попытка
		Итог = ЭАрМ_ЧестныйЗнак.ПривязатьGTINКНоменклатуре(ТолькоПроверка);
	Исключение
		РезультатЧЗ = СтрШаблон(НСтр("ru = 'Ошибка: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Тексты = Новый Массив;
	Тексты.Добавить(СтрШаблон(НСтр("ru = '%1 GTIN из марок: %2, уже в номенклатуре: %3, добавлено: %4'"),
		?(ТолькоПроверка, НСтр("ru = 'Проверка.'"), НСтр("ru = 'Запись.'")),
		Итог.Линий, Итог.ЕстьУже, Итог.Добавлено));
	Если Итог.Линий = 0 Тогда
		Тексты.Добавить(НСтр("ru = 'Нет кодов Честного знака в регистре - сначала «Перенести коды в регистр»'"));
	КонецЕсли;
	Для Каждого Замечание Из Итог.Замечания Цикл
		Тексты.Добавить("• " + Замечание);
	КонецЦикла;
	РезультатЧЗ = СтрСоединить(Тексты, Символы.ПС);

КонецПроцедуры

&НаСервере
Процедура НайтиКодНаСервере()

	Попытка
		Найдено = ЭАрМ_ЧестныйЗнак.ДокументыПоКоду(КодДляПоиска);
		Разбор = ЭАрМ_КодыМаркировки.РазобратьКод(КодДляПоиска);
	Исключение
		РезультатЧЗ = СтрШаблон(НСтр("ru = 'Ошибка поиска: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Тексты = Новый Массив;
	Тексты.Добавить(Разбор.Описание);
	Если Найдено.Количество() = 0 Тогда
		Тексты.Добавить(НСтр("ru = 'В регистре кодов маркировки не найден'"));
	КонецЕсли;
	Для Каждого НайденнаяСтрока Из Найдено Цикл
		Тексты.Добавить(СтрШаблон("• %1, документ %2, позиция %3: %4",
			НайденнаяСтрока.Источник, НайденнаяСтрока.ИдентификаторДокумента, НайденнаяСтрока.НомерПозиции, НайденнаяСтрока.Наименование));
	КонецЦикла;
	РезультатЧЗ = СтрСоединить(Тексты, Символы.ПС);

КонецПроцедуры

#КонецОбласти
