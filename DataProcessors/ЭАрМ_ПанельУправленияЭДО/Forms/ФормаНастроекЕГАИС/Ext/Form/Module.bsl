////////////////////////////////////////////////////////////////////////////////
// Настройки ЕГАИС: что нужно для подключения, настройки определения алкоголя
// в реестре УПД и команды заполнения данных; вкладка «Виды номенклатуры» -
// категории товаров реестра и смена вида и группы номенклатуры УТ. Открывается из панели управления
// ЭДО поверх окна (блокирует окно владельца).
//
// Настройки хранятся в ЭАрМ_НастройкиЭДО (раздел «ЕГАИС», см.
// ЭАрМ_НастройкиСервер.ОписаниеНастроек). Вид номенклатуры хранится УИДом -
// в расширении нет заимствованного справочника видов номенклатуры.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьПоляИзНастроек();
	ОбновитьСостояние();
	ПорядокПодключения = ТекстПорядкаПодключения();
	ТолькоСверенные = Истина;
	ЗаполнитьВидыНоменклатурыНаСервере(Ложь);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ВидНоменклатурыАлкогольНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьВидНоменклатуры("Алкоголь");

КонецПроцедуры

&НаКлиенте
Процедура ВидНоменклатурыАлкогольОчистка(Элемент, СтандартнаяОбработка)

	ЕГАИС_ВидНоменклатурыАлкоголь = "";
	ВидНоменклатурыАлкоголь = "";

КонецПроцедуры

&НаКлиенте
Процедура ВидНоменклатурыПивоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьВидНоменклатуры("Пиво");

КонецПроцедуры

&НаКлиенте
Процедура ВидНоменклатурыПивоОчистка(Элемент, СтандартнаяОбработка)

	ЕГАИС_ВидНоменклатурыПиво = "";
	ВидНоменклатурыПиво = "";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	ЗаписатьНаСервере();
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	ЗаписатьНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Настройки ЕГАИС сохранены'"));

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключение(Команда)

	ЗаписатьНаСервере();
	Состояние(НСтр("ru = 'Проверка подключения ЕГАИС...'"));
	ОбновитьСостояние();
	Состояние();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлассификаторВидов(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьКлассификаторВидовЗавершение", ЭтотОбъект),
		НСтр("ru = 'Заполнить классификатор видов алкогольной продукции ЕГАИС?
		|
		|«Да» - добавить недостающие виды, записи из сервиса классификаторов 1С не трогать.
		|«Нет» - перезаписать все виды статичными данными.'"),
		РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлассификаторВидовЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Отмена ИЛИ Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Заполнение классификатора видов...'"));
	ЗаполнитьКлассификаторВидовНаСервере(Ответ = КодВозвратаДиалога.Нет);
	Состояние();

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьАлкогольУПД(Команда)

	ЗаписатьНаСервере();
	Состояние(НСтр("ru = 'Пересчёт алкоголя в строках УПД...'"));
	ПересчитатьАлкогольУПДНаСервере();
	Состояние();

КонецПроцедуры

&НаКлиенте
Процедура ДозаполнитьНоменклатуру(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("ДозаполнитьНоменклатуруЗавершение", ЭтотОбъект),
		НСтр("ru = 'Дозаполнить алкогольную номенклатуру УТ?
		|
		|Номенклатуре с особенностью учёта «Алкогольная продукция» / «Пиво» по наименованию
		|заполняются только пустые реквизиты: вид алкогольной продукции, крепость, объём (дал);
		|ставится признак «Подакцизный товар». Элементы записываются.'"),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ДозаполнитьНоменклатуруЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьНаСервере();
	Состояние(НСтр("ru = 'Дозаполнение номенклатуры...'"));
	ДозаполнитьНоменклатуруНаСервере();
	Состояние();

КонецПроцедуры

