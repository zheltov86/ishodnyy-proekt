КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИзДалионаЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Обновление номенклатуры из Далиона...'"));
	ОбновитьИзДалионаНаСервере();
	Состояние();
	РазвернутьДеревоНоменклатуры();
	ПоказатьИтогСоздания();

КонецПроцедуры

&НаСервере
Процедура ОбновитьИзДалионаНаСервере()

	Товары = Новый Массив;
	Для Каждого СтрокаКатегории Из НоменклатураКатегорий.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаНоменклатуры Из СтрокаКатегории.ПолучитьЭлементы() Цикл
			Если СтрокаНоменклатуры.Пометка И ЗначениеЗаполнено(СтрокаНоменклатуры.НоменклатураУИД)
				И ЗначениеЗаполнено(СтрокаНоменклатуры.Штрихкод) Тогда
				Товары.Добавить(Новый Структура("НоменклатураУИД, Штрихкод",
					СтрокаНоменклатуры.НоменклатураУИД, СтрокаНоменклатуры.Штрихкод));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Товары.Количество() = 0 Тогда
		Результат = НСтр("ru = 'Нет отмеченной номенклатуры УТ со штрихкодом'");
		Возврат;
	КонецЕсли;

	Попытка
		Итог = ЭАрМ_КатегорииТоваров.ОбновитьИзДалиона(Товары);
	Исключение
		Результат = СтрШаблон(НСтр("ru = 'Ошибка: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ЗаполнитьВидыНоменклатурыНаСервере(Ложь);

	Тексты = Новый Массив;
	Тексты.Добавить(СтрШаблон(НСтр("ru = 'Отмечено: %1, обновлено: %2, нет в Далионе: %3, ошибок: %4'"),
		Товары.Количество(), Итог.Обновлено, Итог.БезДалиона, Итог.Ошибок));
	Для Каждого Сообщение Из Итог.Сообщения Цикл
		Тексты.Добавить("• " + Сообщение);
	КонецЦикла;
	Результат = СтрСоединить(Тексты, Символы.ПС);

КонецПроцедуры

// Итог создания номенклатуры - сразу на экран. Поле «Результат» лежит на другой
// вкладке («Данные»), и со вкладки видов номенклатуры итога не было видно:
// казалось, что ничего не произошло.
//
&НаКлиенте
