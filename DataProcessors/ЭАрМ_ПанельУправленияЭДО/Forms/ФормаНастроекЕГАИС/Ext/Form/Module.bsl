КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ТекстПорядкаПодключения()

	Шаги = Новый Массив;
	Шаги.Добавить("1. Установить УТМ (универсальный транспортный модуль ФС РАР) на компьютер с ключом (Рутокен ЭЦП 2.0 / JaCarta), на котором КЭП и RSA-ключ ЕГАИС. УТМ должен открываться в браузере: http://адрес:8080.");
	Шаги.Добавить("2. В УТ включить учёт алкогольной продукции (ЕГАИС) - кнопка «Настройки ЕГАИС в УТ».");
	Шаги.Добавить("3. «Настройки обмена с УТМ»: ФСРАР ИД организации, адрес и порт УТМ.");
	Шаги.Добавить("4. «Классификатор организаций ЕГАИС»: своя организация по ФСРАР ИД, отметка соответствия организации УТ.");
	Шаги.Добавить("5. Виды номенклатуры с особенностью учёта «Алкогольная продукция» и «Пиво».");
	Шаги.Добавить("6. Вкладка «Заполнение данных»: классификатор видов продукции, алкоголь в УПД, номенклатура УТ.");
	Шаги.Добавить("7. Сопоставление номенклатуры с алкокодами приходит из ТТН ЕГАИС (обмен с УТМ).");
	Возврат СтрСоединить(Шаги, Символы.ПС);

КонецФункции

// Формы УТ открываются поверх этой формы, как и она сама поверх панели.
//
&НаКлиенте
Процедура ОткрытьФормуУТ(ИмяФормы)

	Попытка
		ОткрытьФорму(ИмяФормы, , ЭтаФорма, , , , ,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Исключение
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Не удалось открыть «%1»:
			|%2'"), ИмяФормы, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВидНоменклатуры(Назначение)

	ПараметрыВыбора = Новый Структура("РежимВыбора, ЗакрыватьПриВыборе", Истина, Истина);
	ОткрытьФорму("Справочник.ВидыНоменклатуры.ФормаВыбора", ПараметрыВыбора, ЭтаФорма, , , ,
		Новый ОписаниеОповещения("ВыбратьВидНоменклатурыЗавершение", ЭтотОбъект, Назначение),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВидНоменклатурыЗавершение(ВыбранноеЗначение, Назначение) Экспорт

	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	УстановитьВидНоменклатурыНаСервере(ВыбранноеЗначение, Назначение);

КонецПроцедуры

&НаСервере
Процедура УстановитьВидНоменклатурыНаСервере(ВидНоменклатуры, Назначение)

	Если ТипЗнч(ВидНоменклатуры) <> Тип("СправочникСсылка.ВидыНоменклатуры") Тогда
		Возврат;
	КонецЕсли;

	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидНоменклатуры, "ЭтоГруппа") = Истина Тогда
		Результат = НСтр("ru = 'Выбрана группа видов номенклатуры - выберите вид'");
		Возврат;
	КонецЕсли;

	УИД = Строка(ВидНоменклатуры.УникальныйИдентификатор());
	Если Назначение = "Пиво" Тогда
		ЕГАИС_ВидНоменклатурыПиво = УИД;
		ВидНоменклатурыПиво = Строка(ВидНоменклатуры);
	Иначе
		ЕГАИС_ВидНоменклатурыАлкоголь = УИД;
		ВидНоменклатурыАлкоголь = Строка(ВидНоменклатуры);
	КонецЕсли;

	Особенность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидНоменклатуры, "ОсобенностьУчета");
	Результат = СтрШаблон(НСтр("ru = 'Вид номенклатуры «%1», особенность учёта «%2»'"),
		ВидНоменклатуры, Особенность);

КонецПроцедуры

// Раскладывает сохранённые настройки ЕГАИС по реквизитам формы.
//
&НаСервере
Процедура ЗаполнитьПоляИзНастроек()

	Настройки = ЭАрМ_НастройкиСервер.ПолучитьВсеНастройки();
	Для Каждого Ключ Из КлючиНастроек() Цикл
		Значение = Неопределено;
		Если Настройки.Свойство(Ключ, Значение) И Значение <> Неопределено Тогда
			ЭтаФорма[Ключ] = Значение;
		КонецЕсли;
	КонецЦикла;

	ВидНоменклатурыАлкоголь = Строка(ЭАрМ_АлкогольЕГАИС.ВидНоменклатурыИзНастроек(Ложь));
	ВидНоменклатурыПиво     = Строка(ЭАрМ_АлкогольЕГАИС.ВидНоменклатурыИзНастроек(Истина));

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()

	Сохраняемые = Новый Структура;
	Для Каждого Ключ Из КлючиНастроек() Цикл
		Значение = ЭтаФорма[Ключ];
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			Значение = СокрЛП(Значение);
		КонецЕсли;
		Сохраняемые.Вставить(Ключ, Значение);
	КонецЦикла;
	ЭАрМ_НастройкиСервер.СохранитьВсеНастройки(Сохраняемые);
	СохранитьВидыКатегорийНаСервере();

КонецПроцедуры

&НаСервере
Функция КлючиНастроек()

	Возврат СтрРазделить("ЕГАИС_ОпределятьАлкоголь,ЕГАИС_УчитыватьНаименование,ЕГАИС_ЗаписыватьСоответствие,"
		+ "ЕГАИС_ВидНоменклатурыАлкоголь,ЕГАИС_ВидНоменклатурыПиво,ЕГАИС_НоменклатурыЗаПроход,ЕГАИС_СверкаПоНазванию", ",");

КонецФункции

&НаСервере
Процедура ОбновитьСостояние()

	Попытка
		Проверка = ЭАрМ_АлкогольЕГАИС.СостояниеПодключенияЕГАИС();
		СостояниеЕГАИС = Проверка.Текст;
	Исключение
		СостояниеЕГАИС = СтрШаблон(НСтр("ru = 'Проверка не выполнена: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКлассификаторВидовНаСервере(Перезаписывать)

	Попытка
		Итог = ЭАрМ_АлкогольЕГАИС.ЗаполнитьКлассификаторВидов(Перезаписывать);
		ЭАрМ_НастройкиСервер.СохранитьНастройку("ЕГАИС_ДатаКлассификатора",
			Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'"));
		Результат = СтрШаблон(НСтр("ru = 'Классификатор видов ЕГАИС: добавлено %1, обновлено %2, пропущено (уже были) %3'"),
			Итог.Добавлено, Итог.Обновлено, Итог.Пропущено);
	Исключение
		Результат = СтрШаблон(НСтр("ru = 'Ошибка заполнения классификатора: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ОбновитьСостояние();

КонецПроцедуры

&НаСервере
Процедура ПересчитатьАлкогольУПДНаСервере()

	Попытка
		Итог = ЭАрМ_АлкогольЕГАИС.ПересчитатьАлкогольТоваровУПД();
		Результат = СтрШаблон(НСтр("ru = 'УПД: %1, строк: %2, алкоголь: %3, возможно алкоголь: %4, изменено строк: %5'"),
			Итог.Документов, Итог.Строк, Итог.Алкоголь, Итог.Возможно, Итог.Изменено);
	Исключение
		Результат = СтрШаблон(НСтр("ru = 'Ошибка пересчёта: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ОбновитьСостояние();

КонецПроцедуры

&НаСервере
Процедура ДозаполнитьНоменклатуруНаСервере()

	Попытка
		Итог = ЭАрМ_АлкогольЕГАИС.ДозаполнитьНоменклатуруУТ();
		Строки = Новый Массив;
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Проверено: %1, записано: %2, ошибок: %3'"),
			Итог.Проверено, Итог.Заполнено, Итог.Ошибок));
		Если Итог.Замечания.Количество() > 0 Тогда
			Строки.Добавить(НСтр("ru = 'Осталось заполнить вручную (первые 50):'"));
			Для Каждого Замечание Из Итог.Замечания Цикл
				Строки.Добавить("• " + Замечание);
			КонецЦикла;
		КонецЕсли;
		Результат = СтрСоединить(Строки, Символы.ПС);
	Исключение
		Результат = СтрШаблон(НСтр("ru = 'Ошибка дозаполнения: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ОбновитьСостояние();

КонецПроцедуры

#КонецОбласти

#Область ВидыНоменклатуры

// Вкладка «Виды номенклатуры»: категории товаров реестра (алкоголь, пиво,
// молочная, фрукты, овощи, прочее) с видом номенклатуры и группой по
// умолчанию, ниже - номенклатура УТ по категориям, где вид или группу можно
// сменить. Ссылки хранятся УИДами (ЭАрМ_КатегорииТоваров).

&НаКлиенте
Процедура ЗаполнитьВидыНоменклатуры(Команда)

	Состояние(НСтр("ru = 'Категории и номенклатура реестра товаров...'"));
	ЗаполнитьВидыНоменклатурыНаСервере(Истина);
	Состояние();
	РазвернутьДеревоНоменклатуры();

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьКатегории(Команда)

	Состояние(НСтр("ru = 'Пересчёт категорий реестра товаров...'"));
	ПересчитатьКатегорииНаСервере();
	Состояние();
	РазвернутьДеревоНоменклатуры();

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьВидыИГруппы(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("ПрименитьВидыИГруппыЗавершение", ЭтотОбъект),
		НСтр("ru = 'Записать отмеченной номенклатуре УТ новый вид номенклатуры и группу?
		|
		|При смене вида УТ перезаполняет реквизиты по новому виду и может отказать,
		|если вид сменить нельзя (например, по номенклатуре уже есть движения с сериями).'"),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьВидыИГруппыЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Запись видов и групп номенклатуры...'"));
	ПрименитьВидыИГруппыНаСервере();
	Состояние();
	РазвернутьДеревоНоменклатуры();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для Каждого СтрокаКатегории Из НоменклатураКатегорий.ПолучитьЭлементы() Цикл
		ЕстьОтмеченные = Ложь;
		Для Каждого СтрокаНоменклатуры Из СтрокаКатегории.ПолучитьЭлементы() Цикл
			СтрокаНоменклатуры.Пометка = ЗначениеЗаполнено(СтрокаНоменклатуры.НоменклатураУИД)
				И (ЗначениеЗаполнено(СтрокаНоменклатуры.ВидНовыйУИД)
					ИЛИ ЗначениеЗаполнено(СтрокаНоменклатуры.ГруппаНоваяУИД));
			ЕстьОтмеченные = ЕстьОтмеченные ИЛИ СтрокаНоменклатуры.Пометка;
		КонецЦикла;
		СтрокаКатегории.Пометка = ЕстьОтмеченные;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)

	Для Каждого СтрокаКатегории Из НоменклатураКатегорий.ПолучитьЭлементы() Цикл
		СтрокаКатегории.Пометка = Ложь;
		Для Каждого СтрокаНоменклатуры Из СтрокаКатегории.ПолучитьЭлементы() Цикл
			СтрокаНоменклатуры.Пометка = Ложь;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура НоменклатураКатегорийПометкаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.НоменклатураКатегорий.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Отметка категории отмечает все её строки
	Для Каждого СтрокаНоменклатуры Из ТекущиеДанные.ПолучитьЭлементы() Цикл
		СтрокаНоменклатуры.Пометка = ТекущиеДанные.Пометка;
	КонецЦикла;

