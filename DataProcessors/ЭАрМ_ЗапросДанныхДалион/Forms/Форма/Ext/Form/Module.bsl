////////////////////////////////////////////////////////////////////////////////
// Форма запроса данных Далиона. Кнопки вызывают серверные модули
// (ServerCall=false), статусы читаются из регистров.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Номенклатуру у Далиона не запрашиваем: выгрузка справочника целиком
	// (тысячи пакетов по 5 карточек) забивала очередь обработки, и приходные
	// часами ждали. Штрихкоды приходят со строками заказов и приходных
	Если НЕ ЗапрашиватьКонтрагентов И НЕ ЗапрашиватьДоговоры
		И НЕ ЗапрашиватьКассы И НЕ ЗапрашиватьЗаказы И НЕ ЗапрашиватьПоступления Тогда
		ЗапрашиватьКонтрагентов = Истина;
		ЗапрашиватьНоменклатуру = Ложь;
		ЗапрашиватьДоговоры     = Истина;
		ЗапрашиватьКассы        = Истина;
		ЗапрашиватьЗаказы       = Истина;
		ЗапрашиватьПоступления  = Истина;
	КонецЕсли;

	ЗаполнитьСтатусыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапроситьДанные(Команда)

	Результат = ЗапроситьДанныеНаСервере();
	ПоказатьПредупреждение(, Результат);

КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьПапку(Команда)

	Результат = ПрочитатьПапкуНаСервере();
	ПоказатьПредупреждение(, Результат);

КонецПроцедуры

&НаКлиенте
Процедура ПереобработатьПриходные(Команда)

	Результат = ПереобработатьПриходныеНаСервере();
	ПоказатьПредупреждение(, Результат);

КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьПломбы(Команда)

	ИдентификаторУПД = "";
	ТекущаяСтрока = Элементы.Цепочки.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		ИдентификаторУПД = ТекущаяСтрока.ИдентификаторУПД;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИдентификаторУПД) Тогда
		ПоказатьПредупреждение(,
			"Выберите строку цепочки с УПД или откройте реестр УПД и нажмите «Установить пломбу (тест)».");
		Возврат;
	КонецЕсли;

	Результат = ЗапроситьПломбуПоУПДНаСервере(ИдентификаторУПД);
	ПоказатьПредупреждение(, Результат);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусы(Команда)

	ЗаполнитьСтатусыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗапроситьДанныеНаСервере()

	Объекты = Новый Массив;
	Если ЗапрашиватьКонтрагентов Тогда
		Объекты.Добавить("Контрагент");
	КонецЕсли;
	// «Номенклатура» в запрос не кладётся (см. ПриСозданииНаСервере);
	// ЭАрМ_ЗапросыДалион её тоже отсекает
	Если ЗапрашиватьДоговоры Тогда
		Объекты.Добавить("ДоговорКонтрагента");
	КонецЕсли;
	Если ЗапрашиватьКассы Тогда
		Объекты.Добавить("Касса");
	КонецЕсли;
	Если ЗапрашиватьЗаказы Тогда
		Объекты.Добавить("ЗаказПоставщику");
	КонецЕсли;
	Если ЗапрашиватьПоступления Тогда
		Объекты.Добавить("ПриходнаяНакладная");
	КонецЕсли;

	Если ЗначениеЗаполнено(ПериодС) И ЗначениеЗаполнено(ПериодПо) И ПериодС > ПериодПо Тогда
		Возврат "Дата «Период с» позже даты «по»";
	КонецЕсли;

	// Даты выбраны - уходят dateFrom/dateTo, иначе период из ЭАрМ_НастройкиСервер.ПериодЗапросаДалионаДней()
	ПараметрыЗапроса = Новый Структура;
	Если ЗначениеЗаполнено(ПериодС) ИЛИ ЗначениеЗаполнено(ПериодПо) Тогда
		// Далион одну dateTo без dateFrom читает как один день - начало задаём сами
		ДатаС  = ?(ЗначениеЗаполнено(ПериодС), НачалоДня(ПериодС), НачалоДня(ПериодПо - ЭАрМ_НастройкиСервер.ПериодЗапросаДалионаДней() * 86400));
		ДатаПо = ?(ЗначениеЗаполнено(ПериодПо), КонецДня(ПериодПо), КонецДня(ТекущаяДатаСеанса()));
		ПараметрыЗапроса.Вставить("dateFrom", ДатаС);
		ПараметрыЗапроса.Вставить("dateTo", ДатаПо);
		ТекстПериода = СтрШаблон("период %1 - %2", Формат(ДатаС, "ДЛФ=D"), Формат(ДатаПо, "ДЛФ=D"));
	Иначе
		ПараметрыЗапроса.Вставить("periodDays", ЭАрМ_НастройкиСервер.ПериодЗапросаДалионаДней());
		ТекстПериода = СтрШаблон("период %1 дн.", ЭАрМ_НастройкиСервер.ПериодЗапросаДалионаДней());
	КонецЕсли;

	Отправка = ЭАрМ_ЗапросыДалион.ОтправитьЗапросДанных(Объекты, ПараметрыЗапроса);
	ЗаполнитьСтатусыНаСервере();

	Если Отправка.Успех Тогда
		Результат = СтрШаблон(
			"Запрос записан в папку incoming (%1, %2). Файл: %3. Регламент Далиона прочитает его и выгрузит выбранные объекты в result.",
			СтрСоединить(Объекты, ", "), ТекстПериода, Отправка.ИмяФайла);
	Иначе
		Результат = "Запрос не отправлен: " + Отправка.Ошибка;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПрочитатьПапкуНаСервере()

	// Итог прохода, а не постоянная надпись: «прочитана, разложены» показывалось,
	// даже когда проход не запускался или пакеты падали с ошибкой
	Итог = ЭАрМ_ПриемПакетовДалион.ВыполнитьВручную();
	ЗаполнитьСтатусыНаСервере();

	Возврат Итог;

КонецФункции

// Файлы папки принимаются заново (дубли и устаревшие тоже), пакеты заказов
// и приходных за «Период с/по» (пусто - все) снова ставятся в очередь
// обработки и проходят связь с УПД и сверку.
//
&НаСервере
Функция ПереобработатьПриходныеНаСервере()

	Итог = ЭАрМ_ПриемПакетовДалион.ВыполнитьВручную(Истина, ПериодС, ПериодПо);
	ЗаполнитьСтатусыНаСервере();

	Возврат Итог;

КонецФункции

&НаСервере
Функция ЗапроситьПломбуПоУПДНаСервере(ИдентификаторУПД)

	Ответ = ЭАрМ_ЦепочкаЗакупки.ЗапроситьПломбуПоУПД(ИдентификаторУПД);
	ЗаполнитьСтатусыНаСервере();
	Возврат Ответ.Сообщение;

КонецФункции

&НаСервере
Процедура ЗаполнитьСтатусыНаСервере()

	Снимок = ЭАрМ_ЗапросыДалион.СнимокСтатусов();
	ЗначениеВРеквизитФормы(Снимок.Запросы, "Запросы");
	ЗначениеВРеквизитФормы(Снимок.Пакеты,  "Пакеты");
	ЗначениеВРеквизитФормы(Снимок.Цепочки, "Цепочки");

КонецПроцедуры

#КонецОбласти
