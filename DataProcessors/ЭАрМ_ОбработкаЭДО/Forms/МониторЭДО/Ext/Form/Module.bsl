////////////////////////////////////////////////////////////////////////////////
// Монитор ЭДО - форма обработки ЭАрМ_ОбработкаЭДО.
//
// Обработка заменяет форму реестра УПД. Требование 1: табличная часть УПД
// хранит весь список УПД как в форме реестра - те же колонки, тот же
// порядок строк, свежие документы сверху.
//
// Список читает общий модуль ЭАрМ_ОбработкаЭДО одним запросом, а запуск
// уходит в фоновое задание БСП (ДлительныеОперации) без окна ожидания:
// форма открывается сразу, таблица заполняется, когда запрос готов.
// Кнопка «Обновить» перечитывает список тем же фоном.
//
// Список обновляется сам, когда меняется реестр УПД:
//   - раз в минуту реестр молча сверяется с загруженным списком по признаку
//     (ЭАрМ_ОбработкаЭДО.ПризнакРеестраУПД), и при изменении таблица
//     перечитывается - так подхватываются правки из любых сеансов, включая
//     регламентное задание;
//   - мгновенно по оповещению «ЭАрМ_УПД_Обновление» - его посылает код,
//     изменивший реестр в этом же сеансе: Оповестить("ЭАрМ_УПД_Обновление").
////////////////////////////////////////////////////////////////////////////////

#Область ПеременныеФормы

// Булево - заполнение списка УПД ещё идёт. Пока оно не закончилось,
// новый запуск не делаем: иначе одно и то же ждало бы в нескольких заданиях.
//
&НаКлиенте
Перем ИдётЗаполнение;

// Строка - признак данных реестра УПД на момент загрузки списка
// (ЭАрМ_ОбработкаЭДО.ПризнакТаблицыУПД). Пока реестр не изменился,
// периодическая проверка таблицу не перечитывает.
//
&НаКлиенте
Перем ПризнакДанныхРеестра;

#КонецОбласти

#Область ОбработчикиФормы

// Запускает первое заполнение табличной части УПД.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ЗаполнитьСписокУПД();

	// Авто-обновление: раз в минуту реестр молча сверяется с загруженным
	// списком, и при изменении таблица перечитывается тем же фоном
	ПодключитьОбработчикОжидания("ПроверитьОбновлениеРеестра", 60);

КонецПроцедуры

// Отключает периодическую сверку реестра, чтобы она не работала
// с закрытой формой.
//
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("ПроверитьОбновлениеРеестра");

КонецПроцедуры

// Мгновенно перечитывает список по оповещению «ЭАрМ_УПД_Обновление».
// Оповещение посылает код, изменивший реестр в этом же сеансе:
// Оповестить("ЭАрМ_УПД_Обновление"). Правки из других сеансов
// подхватывает периодическая сверка (см. ПроверитьОбновлениеРеестра).
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ЭАрМ_УПД_Обновление" Тогда
		ЗаполнитьСписокУПД();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Перечитывает весь список УПД из регистра в табличную часть.
//
&НаКлиенте
Процедура ОбновитьРеестрУПД(Команда)

	ЗаполнитьСписокУПД();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает реестр УПД фоновым заданием и молча кладёт готовый список
// в табличную часть УПД, когда запрос готов.
//
&НаКлиенте
Процедура ЗаполнитьСписокУПД()

	Если ИдётЗаполнение = Истина Тогда
		Возврат;
	КонецЕсли;

	Запуск = ЗапуститьЗаполнениеНаСервере(УникальныйИдентификатор);
	Если ЗначениеЗаполнено(Запуск.Ошибка) Тогда
		СообщитьПользователю(Запуск.Ошибка);
		Возврат;
	КонецЕсли;

	ИдётЗаполнение = Истина;

	// Тихий фон: без окна ожидания пользователь работает с формой,
	// таблица заполнится сама
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Ложь;
	ПараметрыОжидания.ВыводитьСообщения = Ложь;

	Попытка
		ДлительныеОперацииКлиент.ОжидатьЗавершение(Запуск.Операция,
			Новый ОписаниеОповещения("ЗаполнениеУПДЗавершено", ЭтотОбъект),
			ПараметрыОжидания);
	Исключение
		ИдётЗаполнение = Ложь;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Кладёт готовый список УПД в табличную часть.
//
&НаКлиенте
Процедура ЗаполнениеУПДЗавершено(Результат, ДополнительныеПараметры) Экспорт

	ИдётЗаполнение = Ложь;

	Если Результат = Неопределено Тогда
		// Пользователь отменил ожидание - задание при этом уже отменено БСП
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		СообщитьПользователю(СтрШаблон(НСтр("ru = 'Список УПД не загружен: %1'"),
			Результат.КраткоеПредставлениеОшибки));
		Возврат;
	КонецЕсли;

	// Признак запоминается по загруженной таблице: периодическая сверка
	// увидит по нему, что в реестре появилось новое
	ПризнакДанныхРеестра = ЗагрузитьСписокУПДНаСервере(Результат.АдресРезультата);

КонецПроцедуры

// Запускает чтение списка УПД фоновым заданием БСП.
//
// Ключ задания не даёт запустить второе такое же чтение, пока идёт первое
// (например, из другого окна АРМ).
//
// Параметры:
//   ИдентификаторФормы - УникальныйИдентификатор - форма-владелец результата
//
// Возвращаемое значение:
//   Структура:
//     * Операция - Структура, Неопределено - см. ДлительныеОперации.ВыполнитьФункцию
//     * Ошибка   - Строка - текст ошибки запуска, пусто - запущено
//
&НаСервереБезКонтекста
Функция ЗапуститьЗаполнениеНаСервере(ИдентификаторФормы)

	Результат = Новый Структура("Операция, Ошибка", Неопределено, "");

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Заполнение списка УПД'");
	ПараметрыВыполнения.КлючФоновогоЗадания = "ЭАрМ_ЗаполнениеСпискаУПД";
	// Код лежит в расширении: без этого фоновое задание запустится без него
	ПараметрыВыполнения.СРасширениямиБазыДанных = Истина;

	Попытка
		Результат.Операция = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"ЭАрМ_ОбработкаЭДО.ДанныеРеестраУПД");
	Исключение
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Список УПД не запущен: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Загружает готовую таблицу УПД в табличную часть объекта.
//
// Параметры:
//   АдресРезультата - Строка - адрес временного хранилища с ТаблицаЗначений
//
// Возвращаемое значение:
//   Строка, Неопределено - признак данных загруженного списка
//     (ЭАрМ_ОбработкаЭДО.ПризнакТаблицыУПД), Неопределено - список не
//     загружен, признак сверять не с чем
//
&НаСервере
Функция ЗагрузитьСписокУПДНаСервере(АдресРезультата)

	ТаблицаУПД = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(ТаблицаУПД) <> Тип("ТаблицаЗначений") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОбъектОбработка = РеквизитФормыВЗначение("Объект");
	ОбъектОбработка.УПД.Загрузить(ТаблицаУПД);
	ЗначениеВРеквизитФормы(ОбъектОбработка, "Объект");

	Возврат ЭАрМ_ОбработкаЭДО.ПризнакТаблицыУПД(ТаблицаУПД);

КонецФункции

// Периодическая сверка: не изменился ли реестр УПД с момента загрузки
// списка. Пока совпадает - таблицу не трогаем и пользователя не отвлекаем;
// разошлось - перечитываем список тем же фоном.
//
&НаКлиенте
Процедура ПроверитьОбновлениеРеестра()

	Если ИдётЗаполнение = Истина Тогда
		Возврат;
	КонецЕсли;

	Если ПризнакРеестраНаСервере() = ПризнакДанныхРеестра Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьСписокУПД();

КонецПроцедуры

// Признак данных реестра УПД прямо сейчас - см. ЭАрМ_ОбработкаЭДО.
//
// Возвращаемое значение:
//   Строка - MD5-хэш содержимого реестра
//
&НаСервереБезКонтекста
Функция ПризнакРеестраНаСервере()

	Возврат ЭАрМ_ОбработкаЭДО.ПризнакРеестраУПД();

КонецФункции

// Показывает результат пользователю.
//
&НаКлиенте
Процедура СообщитьПользователю(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти