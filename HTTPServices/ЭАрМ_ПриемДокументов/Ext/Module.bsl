
#Область СлужебныеПроцедурыИФункции

// Принимает ЭТРН/УПД через HTTP POST.
//
// URL: POST /api/etrn/accept
// Body (JSON):
//   {
//     "requestId": "UUID",
//     "documentType": "ЭТрН",
//     "data": { ... }
//   }
//
// Response (JSON):
//   {
//     "requestId": "UUID",
//     "approved": true/false,
//     "comment": "..."
//   }
//
Функция etrnPOST(Запрос)

	ЗаписьЖурналаРегистрации("АРМ_Далион.HTTP",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("POST /api/etrn/accept, тело %1 символов", СтрДлина(Запрос.ПолучитьТелоКакСтроку())));

	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		// Проверяем обязательные поля
		Если НЕ ДанныеЗапроса.Свойство("requestId")
			ИЛИ НЕ ДанныеЗапроса.Свойство("documentType") Тогда
			Возврат СформироватьОтвет(400, Новый Структура(
				"requestId, approved, comment", "", Ложь, "Missing required fields: requestId, documentType"));
		КонецЕсли;

		// Формируем данные для обработки
		ДанныеДокумента = Новый Структура;
		ДанныеДокумента.Вставить("ИдентификаторЗапроса", ДанныеЗапроса.requestId);
		ДанныеДокумента.Вставить("ТипДокумента", ДанныеЗапроса.documentType);

		Если ДанныеЗапроса.Свойство("data") Тогда
			Для Каждого КлючЗначение Из ДанныеЗапроса.data Цикл
				ДанныеДокумента.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;
		КонецЕсли;

		// Обрабатываем через бизнес-логику
		Результат = ЭАрМ_ПриемДокументовДалион.ПринятьДокументЧерезHTTP(ДанныеДокумента);

		ЗаписьЖурналаРегистрации("АРМ_Далион.HTTP",
			УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон("approved=%1, %2", Результат.Принято, Результат.Комментарий));

		// Формируем ответ
		ДанныеОтвета = Новый Структура;
		ДанныеОтвета.Вставить("requestId", ДанныеЗапроса.requestId);
		ДанныеОтвета.Вставить("approved", Результат.Принято);
		ДанныеОтвета.Вставить("comment", Результат.Комментарий);

		Возврат СформироватьОтвет(200, ДанныеОтвета);

	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'АРМ_ЭдоОбмен.HTTPСервис.ПриемДокументов'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		Возврат СформироватьОтвет(500, Новый Структура(
			"requestId, approved, comment", "", Ложь, "Internal server error"));
	КонецПопытки;

КонецФункции

// Проверяет статус обработки документа в Далион.
//
// URL: GET /api/etrn/status?requestId=UUID
// Response (JSON): { "requestId": "UUID", "status": "processed/pending/error", "comment": "..." }
//
Функция etrnstatusGET(Запрос)

	ИдентификаторЗапроса = Запрос.ПараметрыЗапроса.Получить("requestId");

	Если НЕ ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		Возврат СформироватьОтвет(400, Новый Структура(
			"requestId, status, comment", "", "error", "Missing parameter requestId"));
	КонецЕсли;

	ЗаписьЖурналаРегистрации("АРМ_Далион.HTTP",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("GET /api/etrn/status?requestId=%1", ИдентификаторЗапроса));

	// Заглушка — реализовать поиск в РС Далион
	ДанныеОтвета = Новый Структура;
	ДанныеОтвета.Вставить("requestId", ИдентификаторЗапроса);
	ДанныеОтвета.Вставить("status", "pending");
	ДанныеОтвета.Вставить("comment", "Обработка не завершена");

	Возврат СформироватьОтвет(200, ДанныеОтвета);

КонецФункции

// Формирует HTTP-ответ с JSON-телом.
//
Функция СформироватьОтвет(КодСостояния, Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	ТелоОтвета = ЗаписьJSON.Закрыть();

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Возврат Ответ;

КонецФункции

#КонецОбласти
