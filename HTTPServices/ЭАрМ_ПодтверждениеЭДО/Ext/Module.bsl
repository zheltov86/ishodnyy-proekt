
#Область СлужебныеПроцедурыИФункции

// Принимает callback от другой базы с результатом подтверждения ЭДО-документа.
//
// Тело запроса (JSON):
//   {
//     "requestId": "UUID",
//     "approved": true/false,
//     "comment": "Комментарий"
//   }
//
// Ответы:
//   200 - обработано успешно
//   400 - неверный формат запроса
//   500 - внутренняя ошибка
//
Функция confirmPOST(Запрос)

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.Callback",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("POST /edoconfirm/confirm, тело %1 символов", СтрДлина(Запрос.ПолучитьТелоКакСтроку())));

	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();

		// Парсим JSON
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		// Проверяем обязательные поля
		Если НЕ ДанныеЗапроса.Свойство("requestId")
			ИЛИ НЕ ДанныеЗапроса.Свойство("approved") Тогда
			Возврат Новый HTTPСервисОтвет(400, "Missing required fields: requestId, approved");
		КонецЕсли;

		ИдентификаторЗапроса = ДанныеЗапроса.requestId;
		Подтверждено = Булево(ДанныеЗапроса.approved);
		Комментарий = ?(ДанныеЗапроса.Свойство("comment"), ДанныеЗапроса.comment, "");

		ЗаписьЖурналаРегистрации("АРМ_ЭДО.Callback",
			УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон("requestId=%1, approved=%2", ИдентификаторЗапроса, Подтверждено));

		// Обрабатываем ответ через бизнес-логику
		ЭАрМ_ОбработкаПодтвержденийЭДО.ОбработатьОтветПодтверждения(
			ИдентификаторЗапроса, Подтверждено, Комментарий);

		Возврат Новый HTTPСервисОтвет(200);

	Исключение
		ИмяСобытия = НСтр("ru = 'АРМ_ЭдоОбмен.HTTPСервис.ПодтверждениеЭДО'",
			ОбщегоНазначения.КодОсновногоЯзыка());
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый HTTPСервисОтвет(500, "Internal server error");
	КонецПопытки;

КонецФункции

#КонецОбласти
